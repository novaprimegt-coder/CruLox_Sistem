 ['price-at-least-30','Pedidos activos sin guía','operations','🚚','Detecta pedidos en proceso que todavía no tienen número de guía.',()=>report('Pedidos activos sin guía','Útil antes del despacho para completar seguimiento y entrega.',orderRows(activeWithoutTracking())),'tracking despacho envio'],
 ['price-at-least-40','Pedidos con entrega incompleta','operations','⚠️','Detecta pedidos que carecen de teléfono, dirección, municipio o departamento.',()=>report('Pedidos con entrega incompleta','Corrige datos antes de preparar o despachar el pedido.',orderRows(incompleteOrders())),'direccion telefono'],
 ['price-at-least-50','Productos agotados','catalog','⛔','Muestra productos con stock cero para reponer, ocultar o revisar.',()=>report('Productos agotados','Productos que no deberían prometer nuevas unidades mientras sigan sin existencia.',productRows(state.products.filter(p=>n(p.stock)<=0))),'sin stock'],
 ['price-at-least-75','Productos con stock bajo','operations','📦','Muestra existencias por debajo del límite configurado para anticipar reposición.',()=>report('Productos con stock bajo',`Límite actual: ${lowLimit()} unidades.`,productRows(state.products.filter(p=>n(p.stock)>0&&n(p.stock)<=lowLimit()))),'reponer bodega'],
 ['price-at-least-100','Productos sin imagen','catalog','🖼️','Detecta productos que no tienen imagen principal publicable.',()=>report('Productos sin imagen','Completa la presentación visual antes de impulsar estos productos.',productRows(state.products.filter(p=>!String(p.image||'').trim()))),'foto multimedia'],
 ['price-at-least-150','Productos sin video','catalog','▶','Detecta productos sin video de presentación cuando quieras enriquecer su ficha.',()=>report('Productos sin video','El video es opcional; esta lista sirve para priorizar contenido multimedia.',productRows(state.products.filter(p=>!String(p.videoUrl||'').trim()))),'multimedia'],
 ['price-at-least-200','Clientes con perfil incompleto','customers','👤','Detecta compradores con datos de contacto o entrega incompletos.',()=>report('Clientes con perfil incompleto','Corrige datos antes de depender de ellos para entrega o soporte.',customerRows(incompleteCustomers())),'contacto direccion'],
 ['price-at-least-250','Promociones próximas a vencer','growth','⌛','Muestra promociones activas que vencerán dentro de 14 días.',()=>report('Promociones próximas a vencer','Decide si renovarlas, reemplazarlas o dejar que finalicen.',promoRows(expiringPromos(14))),'cupon descuento'],
 ['price-at-least-500','Datos críticos a revisar','system','🛡️','Detecta precios, stock o totales inválidos que pueden romper cálculos.',()=>report('Datos críticos a revisar','La lista solo muestra inconsistencias comprobables en los datos actuales.',invalidDataRows()),'integridad error'],
 ['reviews-at-least-0','Exportar inventario CSV','system','⇩','Descarga inventario en CSV compatible con hojas de cálculo y protege contra fórmulas inyectadas.',exportInventoryCsv,'excel spreadsheet'],
 ['reviews-at-least-1','Exportar pedidos CSV','system','⇩','Descarga pedidos con estado, cliente, total y guía en un CSV seguro.',exportOrdersCsv,'excel ordenes'],
 ['reviews-at-least-5','Exportar clientes CSV seguro','system','⇩','Exporta clientes sin hashes de contraseña ni credenciales internas.',exportCustomersSafeCsv,'privacidad'],
