}
@media(max-width:850px){
  .admin-sidebar{padding:4px 8px 5px!important}.admin-brand-row{justify-content:center!important}.admin-brand{width:132px!important;height:29px!important}.admin-brand-meta{display:none!important}
  .admin-nav{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:3px!important}.admin-nav button{min-height:30px!important;padding:4px 3px!important;font-size:.45rem!important}
  .admin-content{padding:6px 9px 26px!important}.admin-top{padding:4px 9px!important}.np-admin-breadcrumb,.np-admin-subnav-wrap{padding-left:9px!important;padding-right:9px!important}
  .np-v10-modules{grid-template-columns:repeat(3,minmax(0,1fr))!important}.np-v10-tool-grid,.np-v110-agent-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}
  .np-v10-module-links,.np-admin-area-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.np-v105-perm-list,.np-v107-custom-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .np-v110-priority-list{grid-template-columns:repeat(3,minmax(0,1fr))!important}.np-v105-perm-groups{grid-template-columns:repeat(3,minmax(0,1fr))!important}
}
@media(max-width:600px){
  .admin-top{min-height:38px!important;align-items:center!important;flex-wrap:nowrap!important}.admin-top h1{font-size:.66rem!important}.admin-top .toolbar{width:auto!important;display:flex!important}.admin-top .btn{min-height:26px!important;padding:3px 6px!important;font-size:.44rem!important}
  .admin-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important}.admin-nav button{min-height:29px!important;font-size:.43rem!important}
  .np-admin-groups{grid-template-columns:repeat(2,minmax(0,1fr))!important}.np-admin-group-card{min-height:86px!important}
  .admin-grid,.np-v10-kpis,.np-v105-kpis,.np-v105-load-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .np-v10-modules{grid-template-columns:repeat(2,minmax(0,1fr))!important}.np-v10-tool-grid,.np-v110-agent-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .np-v10-module-links,.np-admin-area-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.np-v110-priority-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .np-v105-order-layout{grid-template-columns:1fr!important}.np-v105-perm-groups{grid-template-columns:repeat(2,minmax(0,1fr))!important}.np-v105-perm-list,.np-v107-custom-list{grid-template-columns:1fr!important}
  .np-v10-tool-search{width:100%!important}.np-v10-tool-search input{min-width:0!important;flex:1 1 160px!important}.np-v10-tool-search select{flex:1 1 100px!important}
  .np-v107-custom-search{grid-template-columns:30px minmax(0,1fr)!important}.np-v107-custom-search button{min-width:0!important}
