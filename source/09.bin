<script id="np-v112-compact-admin-script">
(function(){
  const VERSION='11.2';
  const overlay=document.getElementById('adminOverlay');
  if(!overlay)return;
  const sync=()=>document.body.classList.toggle('np-v112-admin-open',overlay.classList.contains('open'));
  sync();
  new MutationObserver(sync).observe(overlay,{attributes:true,attributeFilter:['class']});
  window.NP_V112_COMPACT_SELF_TEST={
    version:VERSION,
    adminOverlay:!!overlay,
    compactStyle:!!document.getElementById('np-v112-ultra-compact-admin'),
    toolCount:Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105.length:0
  };
  window.NP_V112_COMPACT_SELF_TEST.ok=window.NP_V112_COMPACT_SELF_TEST.adminOverlay&&window.NP_V112_COMPACT_SELF_TEST.compactStyle&&window.NP_V112_COMPACT_SELF_TEST.toolCount===400;
  document.documentElement.dataset.npV112=window.NP_V112_COMPACT_SELF_TEST.ok?'ok':'review';
  if(!window.NP_V112_COMPACT_SELF_TEST.ok)console.warn('CRULOX v11.2 compact self-test',window.NP_V112_COMPACT_SELF_TEST);
})();
</script>

<style id="np-v115-ac24-style">
/* v11.5 · integración AppCreator24: compartir, imprimir, cámara, micrófono y descargas dinámicas */
.np-ac24-inline{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.np-ac24-mini{min-height:31px!important;padding:6px 9px!important;border-radius:10px!important;border:1px solid rgba(122,196,255,.11)!important;background:#0a1a2a!important;color:#cde4f6!important;font-size:.52rem!important;font-weight:850!important}
.np-ac24-mini.primary{background:linear-gradient(135deg,#10d8ff,#178cff)!important;color:#03111d!important;border-color:transparent!important}
.np-ac24-mini.green{background:rgba(38,214,120,.11)!important;color:#45e699!important;border-color:rgba(38,214,120,.2)!important}
.np-ac24-mini.warn{background:rgba(255,190,68,.09)!important;color:#ffd27b!important;border-color:rgba(255,190,68,.18)!important}
.np-ac24-camera-btn{min-height:29px!important;padding:5px 8px!important;border-radius:9px!important;border:1px solid rgba(0,216,255,.14)!important;background:rgba(0,216,255,.07)!important;color:#3ee2ff!important;font-size:.49rem!important;font-weight:900!important}
.np-ac24-status-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.np-ac24-status{padding:11px;border-radius:14px;background:#071522;border:1px solid rgba(122,196,255,.08);display:flex;justify-content:space-between;gap:8px;align-items:center}
.np-ac24-status span{font-size:.55rem;color:#aac2d7}.np-ac24-status b{font-size:.55rem}.np-ac24-status.ok b{color:#42e699}.np-ac24-status.no b{color:#ff8599}.np-ac24-status.maybe b{color:#ffd175}
.np-ac24-recorder{display:grid;gap:12px}.np-ac24-recorder-state{padding:12px;border-radius:14px;background:#071522;border:1px solid rgba(122,196,255,.08)}
.np-ac24-recorder-state b{display:block;font-size:.72rem;margin-bottom:4px}.np-ac24-recorder-state p{font-size:.55rem!important;color:#91abc2!important;line-height:1.45!important}
.np-ac24-recorder audio{width:100%;min-height:42px}.np-ac24-recorder-actions{display:flex;flex-wrap:wrap;gap:7px}.np-ac24-recorder-actions .btn{min-height:35px!important;padding:7px 11px!important;font-size:.54rem!important;border-radius:11px!important}
#npNativePrintSheet{display:none}
@media print{
  html,body{background:#fff!important;color:#111!important;overflow:visible!important;height:auto!important}
  body.np-native-print>*:not(#npNativePrintSheet){display:none!important}
  body.np-native-print #npNativePrintSheet{display:block!important;position:static!important;width:100%!important;max-width:none!important;padding:18mm!important;background:#fff!important;color:#111!important;font-family:Arial,sans-serif!important}
  #npNativePrintSheet h1{font-size:20pt!important;margin:0 0 6mm!important;color:#111!important}
  #npNativePrintSheet h2{font-size:13pt!important;margin:6mm 0 3mm!important;color:#111!important}
  #npNativePrintSheet p,#npNativePrintSheet td,#npNativePrintSheet th,#npNativePrintSheet li{font-size:9.5pt!important;line-height:1.45!important;color:#111!important}
  #npNativePrintSheet table{width:100%!important;border-collapse:collapse!important;min-width:0!important}
  #npNativePrintSheet th,#npNativePrintSheet td{border:1px solid #bbb!important;padding:6px!important;vertical-align:top!important}
  #npNativePrintSheet .np-print-meta{display:grid!important;grid-template-columns:repeat(2,1fr)!important;gap:5px!important;margin-bottom:5mm!important}
  #npNativePrintSheet .np-print-total{font-size:13pt!important;font-weight:700!important;text-align:right!important;margin-top:5mm!important}
}
@media(max-width:520px){.np-ac24-status-grid{grid-template-columns:1fr}.np-ac24-inline{gap:5px}.np-ac24-mini{font-size:.49rem!important;padding:5px 7px!important}}
</style>
<script id="np-v115-ac24-script">
(function(){
  'use strict';
  const VERSION='11.5-AC24';
  const $id=id=>document.getElementById(id);
  const qsa=(sel,root=document)=>Array.from(root.querySelectorAll(sel));
  const htmlEsc=value=>typeof esc==='function'?esc(String(value??'')):String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const today=()=>new Date().toISOString().slice(0,10);
  const fileNameSafe=s=>String(s||'archivo').replace(/[^a-z0-9._-]+/gi,'-').replace(/-+/g,'-');
  const notify=(m,t='info')=>typeof toast==='function'?toast(m,t):console.log(m);

  function makeBlob(data,mime='application/octet-stream'){
    if(data instanceof Blob)return data;
    return new Blob([data],{type:mime});
  }
  function blobToDataUrl(blob){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result||''));r.onerror=()=>reject(r.error||new Error('No se pudo convertir el archivo'));r.readAsDataURL(blob)})}
  async function dynamicDownload(name,data,mime='application/octet-stream'){
    const blob=makeBlob(data,mime);name=fileNameSafe(name);
    let objectUrl='';
    try{
      objectUrl=URL.createObjectURL(blob);
      const a=document.createElement('a');a.href=objectUrl;a.download=name;a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();a.remove();
      /* AppCreator24 puede entregar el Blob al sistema Android de forma asíncrona: no revocar inmediatamente. */
      setTimeout(()=>{try{URL.revokeObjectURL(objectUrl)}catch(e){}},45000);
      return {ok:true,method:'blob',blob};
    }catch(blobError){
      try{
        const dataUrl=await blobToDataUrl(blob);const a=document.createElement('a');a.href=dataUrl;a.download=name;a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();a.remove();return {ok:true,method:'data-url',blob};
      }catch(dataError){console.error('NovaPrime dynamic download',blobError,dataError);notify('No fue posible descargar el archivo.','error');return {ok:false,error:dataError,blob}}
    }
  }

  /* Sustituye el descargador heredado: todas las exportaciones JSON/CSV existentes heredan la mejora. */
  window.downloadFile=function(name,content,type='application/json'){return dynamicDownload(name,content,type)};

  async function sharePayload(payload,fallbackText=''){
    if(typeof navigator.share!=='function'){
      if(fallbackText&&navigator.clipboard?.writeText){try{await navigator.clipboard.writeText(fallbackText);notify('Compartir nativo no está disponible; el texto se copió.','warn');return true}catch(e){}}
      notify('El menú nativo para compartir no está disponible en este entorno.','warn');return false;
    }
    try{await navigator.share(payload);return true}catch(error){if(error?.name!=='AbortError'){console.warn('NovaPrime share',error);notify('No fue posible abrir el menú para compartir.','warn')}return false}
  }
  async function shareText(title,text,url=''){
    const payload={title:String(title||'CRULOX'),text:String(text||'')};if(url)payload.url=url;return sharePayload(payload,text);
  }
  async function shareBlob(name,data,mime,title='CRULOX',text=''){
    const blob=makeBlob(data,mime);
    if(typeof File!=='function'){notify('Este entorno no permite construir archivos compartibles; se descargará como alternativa.','warn');const result=await dynamicDownload(name,blob,mime);return {...result,sharedFile:false}}
    const file=new File([blob],fileNameSafe(name),{type:blob.type||mime,lastModified:Date.now()});
    if(typeof navigator.share==='function'){
      try{
        if(!navigator.canShare||navigator.canShare({files:[file]})){await navigator.share({title,text,files:[file]});return {ok:true,sharedFile:true,blob}}
        if(text){await navigator.share({title,text});return {ok:true,sharedFile:false,blob}}
      }catch(error){if(error?.name==='AbortError')return {ok:false,cancelled:true,blob};console.warn('NovaPrime file share',error)}
    }
    notify('No se pudo compartir el archivo directamente; se descargará como alternativa.','warn');
    const result=await dynamicDownload(name,blob,mime);return {...result,sharedFile:false};
  }

  function backupData(){return {version:VERSION,exportedAt:new Date().toISOString(),products:state.products,combos:state.combos,faqs:state.faqs,settings:state.settings,users:state.users,orders:state.orders,activity:state.activity}}
  function backupJson(){return JSON.stringify(backupData(),null,2)}
  async function shareBackup(){if(window.npConfirm&&!(await window.npConfirm('Este respaldo restaurable puede incluir hashes de acceso y datos internos. Compártelo únicamente con una persona o dispositivo de confianza. ¿Continuar?')))return {ok:false,cancelled:true};const name=`novaprime-backup-${today()}.json`;const r=await shareBlob(name,backupJson(),'application/json','Respaldo privado CRULOX','Respaldo restaurable privado de CRULOX.');if(r.ok&&r.sharedFile)notify('Respaldo privado enviado al menú de compartir.','success');return r}

  function operationalSummaryText(){
    const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);const low=state.products.filter(p=>Number(p.stock)>0&&Number(p.stock)<=Number(state.settings.lowStock||5)).length;const out=state.products.filter(p=>Number(p.stock)<=0).length;
    return `CRULOX · Resumen operativo\nProductos: ${state.products.length}\nClientes: ${state.users.length}\nPedidos: ${state.orders.length}\nVentas registradas: ${typeof money==='function'?money(sales):sales}\nStock bajo: ${low}\nAgotados: ${out}\nGenerado: ${new Date().toLocaleString('es-GT')}`;
  }
  async function shareOperationalSummary(){return shareText('CRULOX · Resumen operativo',operationalSummaryText())}

  function ensurePrintSheet(){let sheet=$id('npNativePrintSheet');if(!sheet){sheet=document.createElement('section');sheet.id='npNativePrintSheet';document.body.appendChild(sheet)}return sheet}
  function cleanupPrint(){document.body.classList.remove('np-native-print');const sheet=$id('npNativePrintSheet');if(sheet)sheet.innerHTML=''}
  function nativePrint(title,bodyHtml){
    if(typeof window.print!=='function'){notify('La impresión no está disponible en este entorno.','warn');return false}
    const sheet=ensurePrintSheet();sheet.innerHTML=`<h1>${htmlEsc(title)}</h1>${bodyHtml}<p style="margin-top:8mm">Generado por CRULOX · ${htmlEsc(new Date().toLocaleString('es-GT'))}</p>`;document.body.classList.add('np-native-print');
    const after=()=>{cleanupPrint();window.removeEventListener('afterprint',after)};window.addEventListener('afterprint',after,{once:true});
    setTimeout(()=>{try{window.print()}catch(error){console.error(error);cleanupPrint();notify('No fue posible abrir la impresión.','error')}},30);
    setTimeout(()=>{if(document.body.classList.contains('np-native-print'))cleanupPrint()},90000);return true;
  }
  function printOperationalSummary(){
    const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);const pending=state.orders.filter(o=>!['Entregado','Cancelado'].includes(o.status));const low=state.products.filter(p=>Number(p.stock)<=Number(state.settings.lowStock||5));
    return nativePrint('CRULOX · Resumen operativo',`<div class="np-print-meta"><p><b>Productos:</b> ${state.products.length}</p><p><b>Clientes:</b> ${state.users.length}</p><p><b>Pedidos:</b> ${state.orders.length}</p><p><b>Ventas registradas:</b> ${htmlEsc(typeof money==='function'?money(sales):sales)}</p></div><h2>Pedidos pendientes</h2><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Estado</th><th>Total</th></tr></thead><tbody>${pending.slice(0,80).map(o=>`<tr><td>${htmlEsc(o.id)}</td><td>${htmlEsc(o.customer?.fullName||'Cliente')}</td><td>${htmlEsc(o.status||'Nuevo')}</td><td>${htmlEsc(typeof money==='function'?money(o.total):o.total)}</td></tr>`).join('')||'<tr><td colspan="4">Sin pedidos pendientes.</td></tr>'}</tbody></table><h2>Inventario que requiere atención</h2><table><thead><tr><th>Producto</th><th>Stock</th><th>Precio</th></tr></thead><tbody>${low.slice(0,100).map(p=>`<tr><td>${htmlEsc(p.name)}</td><td>${Number(p.stock||0)}</td><td>${htmlEsc(typeof money==='function'?money(p.price):p.price)}</td></tr>`).join('')||'<tr><td colspan="3">Sin alertas de inventario.</td></tr>'}</tbody></table>`)
  }
  function orderById(id){return state.orders.find(o=>String(o.id)===String(id))}
  function orderShareText(o){if(!o)return'';const items=(o.items||[]).map(i=>`• ${i.name} × ${Number(i.qty||1)}${i.price!=null?` · ${typeof money==='function'?money(Number(i.price)*Number(i.qty||1)):Number(i.price)*Number(i.qty||1)}`:''}`).join('\n');return `CRULOX · Pedido ${o.id}\nCliente: ${o.customer?.fullName||'Cliente'}\nEstado: ${o.status||'Nuevo'}\n${items}\nTotal: ${typeof money==='function'?money(o.total):o.total}`}
  function shareOrder(id){const o=orderById(id);if(!o)return notify('Pedido no encontrado.','warn');return shareText(`Pedido ${o.id} · CRULOX`,orderShareText(o))}
  function printOrder(id){const o=orderById(id);if(!o)return notify('Pedido no encontrado.','warn');const rows=(o.items||[]).map(i=>`<tr><td>${htmlEsc(i.name)}</td><td>${Number(i.qty||1)}</td><td>${htmlEsc(typeof money==='function'?money(i.price||0):i.price||0)}</td><td>${htmlEsc(typeof money==='function'?money(Number(i.price||0)*Number(i.qty||1)):Number(i.price||0)*Number(i.qty||1))}</td></tr>`).join('');return nativePrint(`Pedido ${o.id}`,`<div class="np-print-meta"><p><b>Cliente:</b> ${htmlEsc(o.customer?.fullName||'Cliente')}</p><p><b>Estado:</b> ${htmlEsc(o.status||'Nuevo')}</p><p><b>Teléfono:</b> ${htmlEsc(o.customer?.phone||'')}</p><p><b>Fecha:</b> ${htmlEsc(new Date(o.createdAt).toLocaleString('es-GT'))}</p><p><b>Entrega:</b> ${htmlEsc([o.customer?.municipality,o.customer?.department].filter(Boolean).join(', '))}</p><p><b>Guía:</b> ${htmlEsc(o.trackingNumber||'Pendiente')}</p></div><table><thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>${rows||'<tr><td colspan="4">Sin artículos.</td></tr>'}</tbody></table><div class="np-print-total">Total: ${htmlEsc(typeof money==='function'?money(o.total):o.total)}</div>`)}

  function transferCapturedFile(target,file){
    if(!target||!file)return false;
    try{const dt=new DataTransfer();dt.items.add(file);target.files=dt.files;target.dispatchEvent(new Event('change',{bubbles:true}));return true}catch(error){console.warn('No fue posible transferir captura',error);return false}
  }
  function capturePhotoForInput(targetId){
    const target=$id(targetId);if(!target)return notify('No se encontró el campo de imagen.','warn');
    const input=document.createElement('input');input.type='file';input.accept='image/*';input.setAttribute('capture','environment');input.hidden=true;document.body.appendChild(input);
    input.onchange=()=>{const file=input.files?.[0];if(file){if(transferCapturedFile(target,file))notify('Foto capturada y cargada al editor.','success');else notify('La foto fue capturada, pero este navegador no permite transferirla al editor.','warn')}input.remove()};input.oncancel=()=>input.remove();input.click();
  }
  function capturePhotoStandalone(){
    const input=document.createElement('input');input.type='file';input.accept='image/*';input.setAttribute('capture','environment');input.hidden=true;document.body.appendChild(input);
    input.onchange=async()=>{const file=input.files?.[0];input.remove();if(!file)return;const dataUrl=await blobToDataUrl(file);if(!$id('crudModal'))return dynamicDownload(`foto-novaprime-${Date.now()}.${(file.name.split('.').pop()||'jpg')}`,file,file.type||'image/jpeg');$('crudTitle').textContent='Foto capturada';$('crudBody').innerHTML=`<div class="np-ac24-recorder"><img src="${htmlEsc(dataUrl)}" alt="Foto capturada" style="width:100%;max-height:55vh;object-fit:contain;border-radius:16px;background:#04101b"><div class="np-ac24-recorder-actions"><button class="btn btn-primary" id="npAc24SharePhoto">Compartir</button><button class="btn btn-secondary" id="npAc24DownloadPhoto">Descargar</button><button class="btn btn-secondary" data-close="crudModal">Cerrar</button></div></div>`;openModal('crudModal');$id('npAc24SharePhoto').onclick=()=>shareBlob(file.name||`foto-${Date.now()}.jpg`,file,file.type||'image/jpeg','Foto CRULOX','Imagen capturada desde CRULOX.');$id('npAc24DownloadPhoto').onclick=()=>dynamicDownload(file.name||`foto-${Date.now()}.jpg`,file,file.type||'image/jpeg')};input.oncancel=()=>input.remove();input.click();
  }

  let recorderSession=null;
  function recorderMime(){if(typeof MediaRecorder==='undefined')return'';for(const type of ['audio/webm;codecs=opus','audio/webm','audio/mp4']){try{if(!MediaRecorder.isTypeSupported||MediaRecorder.isTypeSupported(type))return type}catch(e){}}return''}
  function stopRecorderTracks(){if(recorderSession?.stream)recorderSession.stream.getTracks().forEach(t=>{try{t.stop()}catch(e){}})}
  function openVoiceRecorder(context='CRULOX'){
    if(!$id('crudModal'))return notify('El grabador no puede abrirse en esta vista.','warn');
    $('crudTitle').textContent='Nota de voz';$('crudBody').innerHTML=`<div class="np-ac24-recorder"><div class="np-ac24-recorder-state"><b id="npAc24RecState">Lista para grabar</b><p id="npAc24RecHelp">La nota es temporal: no se guarda en localStorage. Puedes compartirla o descargarla al terminar.</p></div><audio id="npAc24Audio" controls hidden></audio><div class="np-ac24-recorder-actions"><button class="btn btn-primary" id="npAc24StartRec">🎙 Iniciar</button><button class="btn btn-secondary" id="npAc24StopRec" disabled>Detener</button><button class="btn btn-secondary" id="npAc24ShareRec" disabled>Compartir</button><button class="btn btn-secondary" id="npAc24DownloadRec" disabled>Descargar</button><button class="btn btn-secondary" data-close="crudModal">Cerrar</button></div></div>`;openModal('crudModal');
    recorderSession={stream:null,recorder:null,chunks:[],blob:null,url:'',timer:null,context};
    const start=$id('npAc24StartRec'),stop=$id('npAc24StopRec'),share=$id('npAc24ShareRec'),download=$id('npAc24DownloadRec'),stateEl=$id('npAc24RecState'),audio=$id('npAc24Audio');
    start.onclick=async()=>{if(!navigator.mediaDevices?.getUserMedia||typeof MediaRecorder==='undefined')return notify('Este entorno no expone grabación de micrófono a la página.','warn');try{const stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true},video:false});const mime=recorderMime();const rec=mime?new MediaRecorder(stream,{mimeType:mime}):new MediaRecorder(stream);recorderSession.stream=stream;recorderSession.recorder=rec;recorderSession.chunks=[];rec.ondataavailable=e=>{if(e.data?.size)recorderSession.chunks.push(e.data)};rec.onstop=()=>{clearTimeout(recorderSession.timer);const blob=new Blob(recorderSession.chunks,{type:rec.mimeType||mime||'audio/webm'});recorderSession.blob=blob;if(recorderSession.url)URL.revokeObjectURL(recorderSession.url);recorderSession.url=URL.createObjectURL(blob);audio.src=recorderSession.url;audio.hidden=false;stateEl.textContent=`Grabación lista · ${(blob.size/1024).toFixed(1)} KB`;share.disabled=false;download.disabled=false;start.disabled=false;stop.disabled=true;stopRecorderTracks()};rec.start(500);stateEl.textContent='Grabando… máximo 60 segundos';start.disabled=true;stop.disabled=false;recorderSession.timer=setTimeout(()=>{if(rec.state==='recording')rec.stop()},60000)}catch(error){console.error('Microphone',error);notify('No se pudo acceder al micrófono. Revisa el permiso de la app/sección.','error')}};
    stop.onclick=()=>{const rec=recorderSession?.recorder;if(rec&&rec.state==='recording')rec.stop()};
    share.onclick=()=>{if(!recorderSession?.blob)return;const ext=recorderSession.blob.type.includes('mp4')?'m4a':'webm';shareBlob(`nota-voz-novaprime-${Date.now()}.${ext}`,recorderSession.blob,recorderSession.blob.type,'Nota de voz CRULOX',context)};
    download.onclick=()=>{if(!recorderSession?.blob)return;const ext=recorderSession.blob.type.includes('mp4')?'m4a':'webm';dynamicDownload(`nota-voz-novaprime-${Date.now()}.${ext}`,recorderSession.blob,recorderSession.blob.type)};
  }

  function capabilityData(){
    const fileShare=typeof navigator.share==='function'&&typeof File==='function'&&(!navigator.canShare||(()=>{try{return navigator.canShare({files:[new File(['x'],'x.txt',{type:'text/plain'})]})}catch(e){return false}})());
    return {version:VERSION,userAgent:navigator.userAgent,locationProtocol:location.protocol,blob:typeof Blob==='function',objectUrl:typeof URL?.createObjectURL==='function',dataUrl:typeof FileReader==='function',print:typeof window.print==='function',share:typeof navigator.share==='function',fileShare,cameraApi:!!navigator.mediaDevices?.getUserMedia,microphoneApi:!!navigator.mediaDevices?.getUserMedia,mediaRecorder:typeof MediaRecorder!=='undefined',secureContext:window.isSecureContext===true,generatedAt:new Date().toISOString()};
  }
  function openCompatibilityCenter(){const c=capabilityData();if(!$id('crudModal'))return;const items=[['Blob dinámico',c.blob&&c.objectUrl],['Data URL',c.dataUrl],['window.print()',c.print],['navigator.share()',c.share],['Compartir archivos',c.fileShare],['API cámara/micrófono',c.cameraApi],['MediaRecorder',c.mediaRecorder],['Contexto seguro web',c.secureContext?'ok':'maybe']];$('crudTitle').textContent='Compatibilidad AppCreator24';$('crudBody').innerHTML=`<div><p style="font-size:.58rem;color:#9eb6cb;line-height:1.5">Esta prueba verifica APIs disponibles para el HTML. En AppCreator24, impresión/compartir también dependen de que la opción correspondiente esté activada en la sección Web/HTML.</p><div class="np-ac24-status-grid">${items.map(([label,value])=>{const cls=value===true?'ok':value==='maybe'?'maybe':'no';const text=value===true?'Disponible':value==='maybe'?'Depende del entorno':'No detectado';return `<div class="np-ac24-status ${cls}"><span>${htmlEsc(label)}</span><b>${text}</b></div>`}).join('')}</div><div class="form-actions"><button class="btn btn-primary" id="npAc24TestShare">Probar compartir</button><button class="btn btn-secondary" id="npAc24TestPrint">Probar impresión</button><button class="btn btn-secondary" id="npAc24TestCam">Probar cámara</button><button class="btn btn-secondary" id="npAc24TestMic">Probar micrófono</button><button class="btn btn-secondary" id="npAc24ExportDiag">Descargar diagnóstico</button></div></div>`;openModal('crudModal');$id('npAc24TestShare').onclick=()=>shareOperationalSummary();$id('npAc24TestPrint').onclick=()=>printOperationalSummary();$id('npAc24TestCam').onclick=()=>capturePhotoStandalone();$id('npAc24TestMic').onclick=()=>openVoiceRecorder('Prueba de micrófono CRULOX');$id('npAc24ExportDiag').onclick=()=>dynamicDownload(`novaprime-diagnostico-ac24-${today()}.json`,JSON.stringify(capabilityData(),null,2),'application/json')}

  function enhanceMediaInputs(root=document){
    qsa('.np-media-slot-actions',root).forEach(actions=>{if(actions.dataset.ac24Camera==='1')return;const label=actions.querySelector('label[for]');if(!label)return;const targetId=label.getAttribute('for');if(!$id(targetId))return;actions.dataset.ac24Camera='1';const btn=document.createElement('button');btn.type='button';btn.className='np-ac24-camera-btn';btn.textContent='📷 Cámara';btn.onclick=()=>capturePhotoForInput(targetId);actions.appendChild(btn)});
    qsa('input[type="file"][accept*="image"]',root).forEach(input=>{input.setAttribute('data-ac24-camera-ready','1')});
  }
  function enhanceOrders(root=document){
    qsa('[data-copy-order]',root).forEach(copyBtn=>{const id=copyBtn.dataset.copyOrder;const toolbar=copyBtn.closest('.toolbar');if(!toolbar||qsa('[data-ac24-share-order]',toolbar).some(x=>x.dataset.ac24ShareOrder===id))return;const share=document.createElement('button');share.type='button';share.className='btn btn-secondary btn-sm';share.dataset.ac24ShareOrder=id;share.textContent='Compartir';share.onclick=()=>shareOrder(id);const print=document.createElement('button');print.type='button';print.className='btn btn-secondary btn-sm';print.dataset.ac24PrintOrder=id;print.textContent='Imprimir';print.onclick=()=>printOrder(id);toolbar.insertBefore(share,copyBtn.nextSibling);toolbar.insertBefore(print,share.nextSibling)});
    qsa('[data-chat-order]',root).forEach(btn=>{if(btn.dataset.ac24Longpress)return;btn.dataset.ac24Longpress='1';btn.title='Toca para abrir el seguimiento del pedido.'});
  }
  function enhanceBackup(root=document){const exp=$id('exportBackup');if(!exp||exp.dataset.ac24Enhanced)return;exp.dataset.ac24Enhanced='1';const toolbar=exp.closest('.toolbar');if(!toolbar)return;const share=document.createElement('button');share.type='button';share.id='npAc24ShareBackup';share.className='btn btn-secondary';share.textContent='Compartir respaldo privado';share.onclick=shareBackup;toolbar.appendChild(share);const print=document.createElement('button');print.type='button';print.className='btn btn-secondary';print.textContent='Imprimir resumen';print.onclick=printOperationalSummary;toolbar.appendChild(print);const diag=document.createElement('button');diag.type='button';diag.className='btn btn-secondary';diag.textContent='Compatibilidad móvil';diag.onclick=openCompatibilityCenter;toolbar.appendChild(diag)}
  function enhanceOrderConversation(root=document){const form=$id('npOrderChatForm');if(!form||form.dataset.ac24Voice)return;form.dataset.ac24Voice='1';const submit=form.querySelector('button[type="submit"]');if(!submit)return;const id=String(state.adminTitle||'pedido');const voice=document.createElement('button');voice.type='button';voice.className='btn btn-secondary';voice.textContent='🎙 Nota de voz';voice.onclick=()=>openVoiceRecorder(`Seguimiento ${id}`);submit.insertAdjacentElement('beforebegin',voice)}
  function runEnhancers(root=$id('adminOverlay')||document){enhanceMediaInputs(root);enhanceOrders(root);enhanceBackup(root);enhanceOrderConversation(root)}

  /* Reemplaza diez segmentadores de ticket redundantes por utilidades móviles realmente operativas sin alterar el total de Herramientas. */
  function repurposeTools(){
    const tools=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
    const replacements=[
      ['v111-order-value-1','Compartir resumen operativo','system','↗','Comparte por Android los indicadores principales del negocio.',shareOperationalSummary],
      ['v111-order-value-2','Imprimir resumen operativo','system','🖨️','Abre la impresión del resumen, pedidos pendientes e inventario crítico.',printOperationalSummary],
      ['v111-order-value-3','Compartir respaldo completo','system','📤','Genera el respaldo JSON y lo envía al menú nativo para compartir.',shareBackup],
      ['v111-order-value-4','Descargar respaldo compatible','system','⇩','Descarga el respaldo mediante Blob con fallback Data URL.',()=>dynamicDownload(`novaprime-backup-${today()}.json`,backupJson(),'application/json')],
      ['v111-order-value-5','Centro de compatibilidad móvil','system','📱','Comprueba impresión, compartir, archivos, cámara y micrófono.',openCompatibilityCenter],
      ['v111-order-value-6','Capturar foto con cámara','catalog','📷','Abre la cámara para capturar, revisar, compartir o descargar una imagen.',capturePhotoStandalone],
      ['v111-order-value-7','Grabar nota de voz','operations','🎙️','Graba una nota temporal de hasta 60 segundos para compartir o descargar.',()=>openVoiceRecorder('Nota operativa CRULOX')],
      ['v111-order-value-8','Compartir catálogo JSON','system','📤','Comparte el catálogo completo como archivo JSON.',()=>shareBlob(`novaprime-productos-${today()}.json`,JSON.stringify(state.products,null,2),'application/json','Catálogo CRULOX','Catálogo de productos CRULOX.')],
      ['v111-order-value-9','Imprimir inventario crítico','operations','🖨️','Imprime un resumen del inventario y existencias que requieren atención.',printOperationalSummary],
      ['v111-order-value-10','Exportar diagnóstico móvil','system','🩺','Descarga un diagnóstico JSON de las capacidades disponibles en la WebView.',()=>dynamicDownload(`novaprime-diagnostico-ac24-${today()}.json`,JSON.stringify(capabilityData(),null,2),'application/json')]
    ];
    replacements.forEach(([id,title,group,icon,desc,action])=>{const t=tools.find(x=>x.id===id);if(!t)return;t.title=title;t.group=group;t.icon=icon;t.desc=desc;t.action=action;t.aliases=`appcreator24 android movil nativo ${title}`});
  }

  window.NP_AC24={VERSION,dynamicDownload,shareText,shareBlob,shareBackup,shareOperationalSummary,nativePrint,printOperationalSummary,shareOrder,printOrder,capturePhotoStandalone,openVoiceRecorder,openCompatibilityCenter,capabilityData,stopRecorderTracks,runEnhancers};
  repurposeTools();runEnhancers();
  let enhancerPending=false,enhancerRoots=new Set();const observer=new MutationObserver(muts=>{for(const m of muts)for(const node of m.addedNodes)if(node.nodeType===1)enhancerRoots.add(node);if(enhancerPending||!enhancerRoots.size)return;enhancerPending=true;requestAnimationFrame(()=>{enhancerPending=false;const roots=[...enhancerRoots];enhancerRoots.clear();roots.forEach(root=>runEnhancers(root))})});observer.observe(document.body,{childList:true,subtree:true});
  const baseRender=window.renderAdminSection;if(typeof baseRender==='function'){window.renderAdminSection=function(section){const r=baseRender(section);requestAnimationFrame(()=>runEnhancers());return r}};
  const baseOpen=window.openAdmin;if(typeof baseOpen==='function'){window.openAdmin=function(section='home'){const r=baseOpen(section);requestAnimationFrame(()=>runEnhancers());return r}};
  window.addEventListener('beforeunload',()=>{stopRecorderTracks();if(recorderSession?.url)try{URL.revokeObjectURL(recorderSession.url)}catch(e){}});
})();
</script>

<style id="np-v116-pro-style">
/* =====================================================================
   CRULOX v11.6 · OPERACIÓN PRO + CONSOLIDACIÓN APPcreator24
   ===================================================================== */
#adminOverlay{overflow-x:hidden!important}
#adminOverlay.open{overflow-y:auto!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior:contain!important;touch-action:pan-y pinch-zoom!important}
#adminOverlay .admin-shell{height:auto!important;min-height:100dvh!important}
#adminOverlay .admin-main{min-height:0!important}
#adminOverlay button:focus-visible,#adminOverlay input:focus-visible,#adminOverlay select:focus-visible,#adminOverlay textarea:focus-visible{outline:2px solid rgba(39,221,255,.72)!important;outline-offset:2px!important}
#adminOverlay .np-v10-tool{cursor:pointer!important;min-height:128px!important;padding:10px!important;border-radius:14px!important;content-visibility:auto;contain-intrinsic-size:128px;contain:layout style paint}
#adminOverlay .np-v10-tool-head{gap:5px!important}
#adminOverlay .np-v10-tool b{font-size:.64rem!important;line-height:1.24!important}
#adminOverlay .np-v10-tool p{font-size:.49rem!important;line-height:1.42!important;margin-top:2px!important}
#adminOverlay .np-v10-tool-tag{font-size:.41rem!important;padding:3px 6px!important}
#adminOverlay .np-v116-tool-info{width:25px;height:25px;border-radius:8px;border:1px solid rgba(113,199,255,.11);background:#0a1c2c;color:#7deaff;font-size:.55rem;font-weight:950;display:grid;place-items:center}
#adminOverlay .np-v116-tool-info:hover{background:rgba(0,216,255,.12)}
.np-v116-info-shell{display:grid;gap:10px}
.np-v116-info-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:12px;border-radius:15px;background:#071522;border:1px solid rgba(122,196,255,.08)}
.np-v116-info-head span{display:block;color:#31ddff;font-size:.5rem;font-weight:950;text-transform:uppercase;letter-spacing:.08em}
.np-v116-info-head h3{font-size:.84rem;margin-top:3px}.np-v116-info-rank{min-width:48px;height:38px;border-radius:11px;display:grid;place-items:center;background:rgba(0,216,255,.08);border:1px solid rgba(0,216,255,.14);color:#42e4ff;font-weight:950}
.np-v116-info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.np-v116-info-card{padding:11px;border-radius:14px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-info-card b{display:block;font-size:.57rem;margin-bottom:4px}.np-v116-info-card p{font-size:.52rem!important;line-height:1.5!important;color:#94adc3!important;margin:0!important}
.np-v116-home-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-bottom:10px}.np-v116-now{padding:10px;border-radius:13px;background:#071522;border:1px solid rgba(122,196,255,.075);min-width:0}.np-v116-now small{display:block;color:#7894ad;font-size:.43rem}.np-v116-now strong{display:block;color:#eaf8ff;font-size:.83rem;margin-top:3px}.np-v116-now.warn strong{color:#ffc968}.np-v116-now.bad strong{color:#ff7f95}.np-v116-now.ok strong{color:#42e699}
.np-v116-actions{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}.np-v116-actions button{min-height:29px;padding:5px 9px;border-radius:9px;border:1px solid rgba(122,196,255,.09);background:#091a2a;color:#bad1e4;font-size:.47rem;font-weight:850}.np-v116-actions button.primary{background:rgba(0,216,255,.1);color:#42e4ff;border-color:rgba(0,216,255,.15)}
.np-v116-report{display:grid;gap:10px}.np-v116-report-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.np-v116-report-head h2{font-size:.86rem}.np-v116-report-head p{font-size:.53rem;color:#8ea8bf;line-height:1.45;margin-top:3px}.np-v116-report-list{display:grid;gap:7px}.np-v116-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;align-items:center;padding:10px 11px;border-radius:13px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-row b{display:block;font-size:.61rem}.np-v116-row p{font-size:.49rem!important;color:#829bb2!important;line-height:1.4!important;margin:3px 0 0!important}.np-v116-row aside{font-size:.49rem;color:#42e3ff;text-align:right;max-width:150px}.np-v116-empty{padding:18px;border-radius:15px;border:1px dashed rgba(122,196,255,.12);background:#06121e;text-align:center}.np-v116-empty b{display:block;font-size:.66rem}.np-v116-empty span{display:block;font-size:.51rem;color:#829bb2;margin-top:4px;line-height:1.45}
.np-v116-perm-shell{display:grid;gap:11px}.np-v116-perm-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.np-v116-perm-summary div{padding:10px;border-radius:13px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-perm-summary small{display:block;color:#7894ad;font-size:.43rem}.np-v116-perm-summary b{display:block;color:#42e4ff;font-size:.82rem;margin-top:3px}.np-v116-agent-perm-list{display:grid;gap:7px}.np-v116-agent-perm{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 11px;border-radius:14px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-agent-perm h3{font-size:.64rem}.np-v116-agent-perm p{font-size:.49rem!important;color:#839db5!important;margin:3px 0 0!important}.np-v116-agent-perm-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.np-v116-agent-perm-tags span{padding:3px 6px;border-radius:999px;background:#0a1b2a;color:#a9c2d7;border:1px solid rgba(122,196,255,.06);font-size:.41rem}
.np-v116-perm-editor{display:grid;gap:10px}.np-v116-perm-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 150px auto;gap:7px}.np-v116-perm-toolbar input,.np-v116-perm-toolbar select{min-height:36px!important}.np-v116-module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;max-height:210px;overflow:auto}.np-v116-module-item,.np-v116-tool-item{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:7px;align-items:center;padding:8px;border-radius:11px;background:#071522;border:1px solid rgba(122,196,255,.065)}.np-v116-module-item input,.np-v116-tool-item input{width:15px!important;height:15px!important;min-height:0!important;accent-color:#15d9ff}.np-v116-module-item b,.np-v116-tool-item b{display:block;font-size:.51rem}.np-v116-module-item small,.np-v116-tool-item small{display:block;font-size:.42rem;color:#758fa8;margin-top:2px}.np-v116-module-item em,.np-v116-tool-item em{font-style:normal;color:#42e3ff;font-size:.4rem}.np-v116-tool-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;max-height:45vh;overflow:auto;padding-right:2px}.np-v116-perm-count{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px 10px;border-radius:11px;background:#06131f;border:1px solid rgba(122,196,255,.065);font-size:.48rem;color:#8fa8bf}.np-v116-perm-count b{color:#42e4ff}
.np-v116-assign-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 140px;gap:7px}.np-v116-assignment-list{display:grid;gap:7px}.np-v116-assignment{display:grid;grid-template-columns:minmax(0,1fr) minmax(130px,180px) auto;gap:7px;align-items:center;padding:9px 10px;border-radius:13px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-assignment b{font-size:.58rem}.np-v116-assignment small{display:block;color:#7f98af;font-size:.46rem;margin-top:3px}.np-v116-assignment select{min-height:32px!important;font-size:.5rem!important}.np-v116-assignment button{min-height:31px!important;padding:5px 8px!important;font-size:.47rem!important;border-radius:9px!important}
.np-v116-mobile-center{display:grid;gap:10px}.np-v116-mobile-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.np-v116-mobile-card{padding:11px;border-radius:14px;background:#071522;border:1px solid rgba(122,196,255,.07)}.np-v116-mobile-card b{display:block;font-size:.58rem}.np-v116-mobile-card p{font-size:.48rem!important;color:#839db4!important;line-height:1.42!important;margin:3px 0 8px!important}.np-v116-mobile-card button{width:100%;min-height:30px;border-radius:9px;border:1px solid rgba(0,216,255,.13);background:rgba(0,216,255,.07);color:#48e2ff;font-size:.47rem;font-weight:850}
.np-v116-scrolltop{position:fixed;right:12px;bottom:14px;z-index:2900;width:38px;height:38px;border-radius:50%;border:1px solid rgba(0,216,255,.18);background:#071827;color:#54e6ff;box-shadow:0 10px 25px rgba(0,0,0,.35);display:none;place-items:center;font-weight:950}.np-v116-scrolltop.show{display:grid}
@media(max-width:920px){
 #adminOverlay .admin-shell{display:flex!important;flex-direction:column!important;align-items:stretch!important}
 #adminOverlay .admin-sidebar{display:block!important;flex:none!important;width:100%!important;height:auto!important;min-height:0!important;padding:4px 8px 6px!important;margin:0!important;overflow:visible!important}
 #adminOverlay .admin-brand-row{margin:0 0 4px!important;justify-content:center!important}.admin-brand{width:136px!important;height:30px!important}
 #adminOverlay .admin-nav{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important}.admin-nav button{min-height:36px!important;padding:5px 3px!important;font-size:.47rem!important;border-radius:10px!important;line-height:1.06!important}
 #adminOverlay .admin-main{display:block!important;flex:1 1 auto!important;overflow:visible!important;margin:0!important;padding:0!important}
 #adminOverlay .admin-top{min-height:auto!important;padding:6px 9px!important;margin:0!important}.admin-top h1{font-size:.76rem!important}.admin-top .section-kicker{font-size:.43rem!important}.admin-top .toolbar{gap:5px!important}.admin-top .toolbar .btn{min-height:31px!important;padding:5px 8px!important;font-size:.49rem!important;border-radius:9px!important}
 #adminOverlay .np-admin-breadcrumb{padding:5px 9px 0!important;font-size:.46rem!important}.np-admin-subnav-wrap{padding:4px 9px 0!important}.np-admin-subnav{gap:4px!important;margin:0 0 5px!important;padding-bottom:2px!important}.np-admin-subnav button{min-height:26px!important;padding:4px 7px!important;font-size:.44rem!important;border-radius:8px!important}
 #adminOverlay .admin-content{padding:8px 9px 27px!important;overflow:visible!important}.admin-content>*+*{margin-top:12px!important}
 #adminOverlay .np-v110-priority-strip{padding:10px!important;margin-bottom:10px!important}.np-v110-priority-head{margin-bottom:7px!important}.np-v110-priority-list{gap:5px!important}.np-v110-priority-item{padding:7px!important}.np-v110-priority-item strong{width:28px!important;height:28px!important}.np-v110-priority-item b{font-size:.47rem!important}
 #adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}
 .np-v116-home-strip,.np-v116-perm-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.np-v116-info-grid{grid-template-columns:1fr}.np-v116-mobile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.np-v116-perm-toolbar{grid-template-columns:1fr 120px}.np-v116-perm-toolbar button{grid-column:1/-1}.np-v116-module-grid,.np-v116-tool-list{grid-template-columns:1fr}.np-v116-assignment{grid-template-columns:1fr minmax(120px,1fr)}.np-v116-assignment button{grid-column:2/3}.np-v116-report-head{align-items:stretch;flex-direction:column}
}
@media(max-width:360px){#adminOverlay .admin-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important}#adminOverlay .np-v10-tool-grid{grid-template-columns:1fr!important}.np-v116-mobile-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){#adminOverlay *{scroll-behavior:auto!important}}

#adminOverlay .np-custom-select-trigger{min-height:35px!important;padding:6px 34px 6px 10px!important;border-radius:10px!important;font-size:.58rem!important;line-height:1.15!important}
#adminOverlay .np-custom-select-trigger::after{right:11px!important;font-size:.78rem!important}
#adminOverlay .np-custom-select-menu{top:calc(100% + 4px)!important;max-height:240px!important;padding:4px!important;border-radius:11px!important}
#adminOverlay .np-custom-select-option{padding:7px 9px!important;border-radius:8px!important;font-size:.57rem!important}
</style>
<script id="np-v116-pro-script">
(function(){
'use strict';
const VERSION='11.6-PRO';
const tools=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
const toolById=new Map(tools.map(t=>[t.id,t]));
const team=window.NP_TEAM_API_V105||null;
const ac=window.NP_AC24||null;document.addEventListener('visibilitychange',()=>{if(document.hidden)try{ac?.stopRecorderTracks?.()}catch(e){recordIssue('media-background-stop',e)}});
const byId=id=>document.getElementById(id);
const qsa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const arr=v=>Array.isArray(v)?v:[];
const n=v=>Number.isFinite(Number(v))?Number(v):0;
const normx=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const h=v=>typeof esc==='function'?esc(String(v??'')):String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const cash=v=>typeof money==='function'?money(n(v)):`Q${n(v).toFixed(2)}`;
const lowLimit=()=>Math.max(0,n(state.settings?.lowStock||5));
const notify=(m,t='info')=>typeof toast==='function'?toast(m,t):console.log(m);
const currentAssignments=()=>team?.assignments?.()||{};
const currentAgents=()=>team?.agents?.()||[];
const currentChats=()=>team?.chats?.()||{};
const runtimeIssues=window.NP_V116_RUNTIME_ISSUES=[];
function recordIssue(context,error){const item={context:String(context||'runtime'),message:String(error?.message||error||'Error desconocido'),at:new Date().toISOString()};runtimeIssues.unshift(item);runtimeIssues.splice(30);console.error('NovaPrime v11.6',context,error);return item}
window.addEventListener('error',e=>recordIssue('window.error',e.error||e.message));
window.addEventListener('unhandledrejection',e=>recordIssue('promise',e.reason));

function toolPurpose(t){
 const s=normx(`${t?.title||''} ${t?.desc||''} ${t?.group||''}`);
 if(/pedido|orden|seguimiento|guia|despacho/.test(s))return 'Te ayuda a ejecutar y controlar pedidos para reducir atrasos, pedidos sin responsable o información de entrega incompleta.';
 if(/inventario|stock|agotad|existencia/.test(s))return 'Sirve para decidir reposición, detectar agotados y evitar vender productos sin existencia real.';
 if(/producto|catalog|imagen|video|multimedia/.test(s))return 'Sirve para mantener el catálogo publicable, consistente y con información suficiente para vender.';
 if(/cliente|comprador|usuario/.test(s))return 'Te ayuda a identificar clientes que necesitan seguimiento, corrección de datos o acciones de fidelización.';
 if(/promoc|cupon|descuento/.test(s))return 'Sirve para controlar promociones activas, próximas a vencer o que requieren revisión comercial.';
 if(/agente|permiso|equipo|rol|asigna/.test(s))return 'Sirve para distribuir trabajo y limitar exactamente lo que cada integrante del equipo puede consultar o modificar.';
 if(/respaldo|backup|almacen|integridad|auditor|diagnost/.test(s))return 'Sirve para proteger la información local, detectar inconsistencias y prevenir pérdida de datos.';
 if(/compart|imprim|android|appcreator|camara|microfono|voz/.test(s))return 'Aprovecha capacidades del dispositivo Android para mover información fuera del panel sin procesos manuales innecesarios.';
 if(/analit|reporte|rendimiento/.test(s))return 'Convierte datos existentes en una vista concreta para detectar prioridades y tomar decisiones operativas.';
 return 'Es una utilidad administrativa. Revisa el resultado antes de realizar cambios y úsala solo cuando contribuya a una decisión o tarea concreta.';
}
function toolRisk(t){const s=normx(`${t?.title||''} ${t?.desc||''}`);return /eliminar|borrar|vaciar|limpiar|restaurar|importar|desactivar|optimizar|editar|agregar|crear|guardar|cambiar|ajustar/.test(s)?'Puede modificar datos':'Principalmente consulta o exporta información'}
function openToolInfo(id){const t=tools.find(x=>x.id===id);if(!t||!byId('crudModal'))return;byId('crudTitle').textContent='Ayuda de herramienta';byId('crudBody').innerHTML=`<div class="np-v116-info-shell"><div class="np-v116-info-head"><div><span>${h(t.group||'herramienta')}</span><h3>${h(t.title)}</h3></div><strong class="np-v116-info-rank">#${n(t.rank)||'—'}</strong></div><div class="np-v116-info-grid"><article class="np-v116-info-card"><b>Qué hace</b><p>${h(t.desc||'No hay descripción disponible.')}</p></article><article class="np-v116-info-card"><b>Para qué te ayuda</b><p>${h(toolPurpose(t))}</p></article><article class="np-v116-info-card"><b>Tipo de acción</b><p>${h(toolRisk(t))}</p></article><article class="np-v116-info-card"><b>Cómo encontrarla</b><p>Busca <b>#${n(t.rank)||'—'}</b>, su nombre o palabras relacionadas dentro del centro de herramientas.</p></article></div><div class="form-actions"><button class="btn btn-primary" id="npV116RunInfoTool">Abrir herramienta</button><button class="btn btn-secondary" data-close="crudModal">Cerrar</button></div></div>`;openModal('crudModal');byId('npV116RunInfoTool').onclick=()=>{closeModal('crudModal');safeRunTool(t)};}
function enhanceToolCards(root=document){qsa('[data-v10-tool]',root).forEach(card=>{const id=card.dataset.v10Tool,t=toolById.get(id);if(!t)return;card.setAttribute('role','button');card.setAttribute('tabindex','0');card.setAttribute('aria-label',`${t.title}. Herramienta número ${t.rank}.`);if(!card.dataset.v116Key){card.dataset.v116Key='1';card.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&!e.target.closest('button')){e.preventDefault();safeRunTool(t)}})}const head=card.querySelector('.np-v10-tool-head');if(head&&!head.querySelector('[data-v116-info]')){const b=document.createElement('button');b.type='button';b.className='np-v116-tool-info';b.dataset.v116Info=id;b.setAttribute('aria-label',`Explicar ${t.title}`);b.textContent='?';head.insertBefore(b,head.querySelector('[data-v10-fav]')||null)}})}
document.addEventListener('click',e=>{const b=e.target.closest?.('[data-v116-info]');if(!b)return;e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();openToolInfo(b.dataset.v116Info)},true);

function safeRunTool(t){if(!t||typeof t.action!=='function')return notify('Esta herramienta no tiene una acción disponible.','error');try{const r=t.action();if(r&&typeof r.then==='function')r.catch(err=>{recordIssue(`tool:${t.id}`,err);notify('La herramienta encontró un error. No se confirmó ningún resultado incompleto.','error')});return r}catch(err){recordIssue(`tool:${t.id}`,err);notify('La herramienta encontró un error. No se confirmó ningún resultado incompleto.','error')}}
function wrapToolActions(){tools.forEach(t=>{if(!t||t._np116Wrapped||typeof t.action!=='function')return;const fn=t.action;t._np116Wrapped=true;t._np116RawAction=fn;t.action=function(...args){try{const r=fn.apply(this,args);if(r&&typeof r.then==='function')return r.catch(err=>{recordIssue(`tool:${t.id}`,err);notify(`No se pudo completar: ${t.title}.`,'error');return false});return r}catch(err){recordIssue(`tool:${t.id}`,err);notify(`No se pudo completar: ${t.title}.`,'error');return false}}})}

function report(title,description,rows,empty='No hay elementos que requieran atención.'){state.adminSection='np-v116-report';if(byId('adminTitle'))byId('adminTitle').textContent=title;const data=arr(rows).slice(0,400);byId('adminContent').innerHTML=`<section class="np-v116-report"><header class="np-v116-report-head"><div><h2>${h(title)}</h2><p>${h(description)}</p></div><button class="btn btn-secondary btn-sm" id="npV116BackTools">Herramientas</button></header><div class="np-v116-report-list">${data.length?data.map(r=>`<article class="np-v116-row"><div><b>${h(r.title||'Registro')}</b><p>${h(r.detail||'')}</p></div><aside>${h(r.meta||'')}</aside></article>`).join(''):`<div class="np-v116-empty"><b>${h(empty)}</b><span>No se generaron registros artificiales para llenar la pantalla.</span></div>`}</div></section>`;byId('npV116BackTools').onclick=()=>renderAdminSection('np-toolbox');scrollAdminTop();}
function orderRows(list){return arr(list).map(o=>({title:`${o.id||'Pedido'} · ${o.customer?.fullName||'Cliente'}`,meta:`${o.status||'Nuevo'} · ${cash(o.total)}`,detail:[o.customer?.phone,o.customer?.municipality,o.customer?.department].filter(Boolean).join(' · ')}))}
function productRows(list){return arr(list).map(p=>({title:p.name||'Producto',meta:`Stock ${n(p.stock)} · ${cash(p.price)}`,detail:p.category||'Sin categoría'}))}
function customerRows(list){return arr(list).map(u=>({title:u.fullName||u.username||'Cliente',meta:u.email||'Sin correo',detail:[u.phone,u.municipality,u.department].filter(Boolean).join(' · ')}))}
function promoRows(list){return arr(list).map(p=>({title:p.code||p.name||'Promoción',meta:p.expiresAt?`Vence ${p.expiresAt}`:(p.active===false?'Inactiva':'Sin vencimiento'),detail:`Usos ${n(p.uses)} · Valor ${n(p.value??p.percent??p.discount)}%`}))}
function activeOrders(){return state.orders.filter(o=>!['entregado','cancelado'].includes(normx(o.status)))}
function incompleteOrders(){return state.orders.filter(o=>![o.customer?.fullName,o.customer?.phone,o.customer?.department,o.customer?.municipality,o.customer?.address].every(v=>String(v||'').trim()))}
function invalidDataRows(){const rows=[];state.products.forEach(p=>{if(!p.name||!Number.isFinite(Number(p.price))||n(p.price)<=0||!Number.isFinite(Number(p.stock))||n(p.stock)<0)rows.push({title:p.name||p.id||'Producto',meta:'Producto',detail:'Nombre, precio o stock requiere revisión.'})});state.orders.forEach(o=>{if(!Number.isFinite(Number(o.total))||n(o.total)<0)rows.push({title:o.id||'Pedido',meta:'Pedido',detail:'Total inválido.'})});return rows}
function expiringPromos(days=14){const now=Date.now();return arr(state.promos).filter(p=>{if(p.active===false||!p.expiresAt)return false;const d=(new Date(`${p.expiresAt}T23:59:59`).getTime()-now)/86400000;return d>=0&&d<=days})}
function incompleteCustomers(){return state.users.filter(u=>![u.fullName,u.email,u.phone,u.department,u.municipality,u.address].every(v=>String(v||'').trim()))}
function unassignedOrders(){const a=currentAssignments();return activeOrders().filter(o=>!a[o.id])}
function activeWithoutTracking(){return activeOrders().filter(o=>!['nuevo'].includes(normx(o.status))&&!String(o.trackingNumber||'').trim())}

function csvCell(v){let s=String(v??'');if(/^[=+\-@]/.test(s))s="'"+s;return `"${s.replace(/"/g,'""')}"`}
function csvDownload(name,headers,rows){const text='\ufeff'+[headers,...rows].map(r=>r.map(csvCell).join(',')).join('\n');if(ac?.dynamicDownload)return ac.dynamicDownload(name,text,'text/csv;charset=utf-8');return downloadFile(name,text,'text/csv;charset=utf-8')}
function exportInventoryCsv(){return csvDownload(`novaprime-inventario-${new Date().toISOString().slice(0,10)}.csv`,['ID','Producto','Categoría','Stock','Precio'],state.products.map(p=>[p.id,p.name,p.category,n(p.stock),n(p.price)]))}
function exportOrdersCsv(){return csvDownload(`novaprime-pedidos-${new Date().toISOString().slice(0,10)}.csv`,['Pedido','Cliente','Estado','Total','Teléfono','Municipio','Departamento','Guía'],state.orders.map(o=>[o.id,o.customer?.fullName,o.status,n(o.total),o.customer?.phone,o.customer?.municipality,o.customer?.department,o.trackingNumber]))}
function exportCustomersSafeCsv(){return csvDownload(`novaprime-clientes-seguro-${new Date().toISOString().slice(0,10)}.csv`,['ID','Nombre','Usuario','Correo','Teléfono','Municipio','Departamento'],state.users.map(u=>[u.id,u.fullName,u.username,u.email,u.phone,u.municipality,u.department]))}
function safeOperationalExport(){const strip=x=>{if(!x||typeof x!=='object')return x;const y={...x};delete y.passwordHash;delete y.password;delete y.passwordSalt;return y};return {version:VERSION,type:'operational-safe-export',exportedAt:new Date().toISOString(),products:state.products,combos:state.combos,faqs:state.faqs,settings:state.settings,users:state.users.map(strip),orders:state.orders,promos:arr(state.promos),agents:currentAgents().map(strip),assignments:currentAssignments(),orderChats:currentChats()}}
async function downloadSafeExport(){const text=JSON.stringify(safeOperationalExport(),null,2);return ac?.dynamicDownload?ac.dynamicDownload(`novaprime-exportacion-segura-${new Date().toISOString().slice(0,10)}.json`,text,'application/json'):downloadFile('novaprime-exportacion-segura.json',text,'application/json')}
async function shareSafeExport(){const text=JSON.stringify(safeOperationalExport(),null,2);if(ac?.shareBlob)return ac.shareBlob(`novaprime-exportacion-segura-${new Date().toISOString().slice(0,10)}.json`,text,'application/json','CRULOX · Exportación operativa','Exportación sin hashes de contraseñas.');return downloadSafeExport()}
function shareCriticalInventory(){const low=state.products.filter(p=>n(p.stock)<=lowLimit()).sort((a,b)=>n(a.stock)-n(b.stock));const txt=['CRULOX · Inventario crítico',...low.slice(0,100).map(p=>`• ${p.name}: ${n(p.stock)} unidades · ${cash(p.price)}`)].join('\n');return ac?.shareText?ac.shareText('CRULOX · Inventario crítico',txt):navigator.clipboard?.writeText(txt)}
function printOpenOrders(){const rows=activeOrders().slice(0,120).map(o=>`<tr><td>${h(o.id)}</td><td>${h(o.customer?.fullName||'Cliente')}</td><td>${h(o.status||'Nuevo')}</td><td>${h(cash(o.total))}</td></tr>`).join('');return ac?.nativePrint?ac.nativePrint('CRULOX · Pedidos abiertos',`<table><thead><tr><th>Pedido</th><th>Cliente</th><th>Estado</th><th>Total</th></tr></thead><tbody>${rows||'<tr><td colspan="4">Sin pedidos abiertos.</td></tr>'}</tbody></table>`):notify('Impresión no disponible.','warn')}
function printLowStock(){const rows=state.products.filter(p=>n(p.stock)<=lowLimit()).sort((a,b)=>n(a.stock)-n(b.stock)).slice(0,150).map(p=>`<tr><td>${h(p.name)}</td><td>${n(p.stock)}</td><td>${h(cash(p.price))}</td></tr>`).join('');return ac?.nativePrint?ac.nativePrint('CRULOX · Inventario crítico',`<table><thead><tr><th>Producto</th><th>Stock</th><th>Precio</th></tr></thead><tbody>${rows||'<tr><td colspan="3">Sin alertas.</td></tr>'}</tbody></table>`):notify('Impresión no disponible.','warn')}
function shareOpenOrders(){const txt=['CRULOX · Pedidos abiertos',...activeOrders().slice(0,100).map(o=>`• ${o.id} · ${o.customer?.fullName||'Cliente'} · ${o.status||'Nuevo'} · ${cash(o.total)}`)].join('\n');return ac?.shareText?ac.shareText('CRULOX · Pedidos abiertos',txt):navigator.clipboard?.writeText(txt)}
function storageStats(){let bytes=0,keys=[];try{for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i)||'';const v=localStorage.getItem(k)||'';const size=(k.length+v.length)*2;bytes+=size;keys.push({k,size})}}catch(e){}keys.sort((a,b)=>b.size-a.size);return {bytes,keys}}
function dataUrlBytes(src){const s=String(src||'');if(!s.startsWith('data:'))return 0;const p=s.indexOf(',');return p<0?0:Math.round((s.length-p-1)*.75)}
function heavyImageRows(){const rows=[];state.products.forEach(p=>{[['Principal',p.image],['Secundaria',p.image2],...arr(p.images).map((x,i)=>[`Imagen ${i+1}`,x])].forEach(([label,src])=>{const size=dataUrlBytes(src);if(size>180000)rows.push({title:p.name||p.id,meta:`${(size/1024).toFixed(0)} KB`,detail:`${label} almacenada como Data URL.`})})});state.combos.forEach(c=>{const size=dataUrlBytes(c.image);if(size>180000)rows.push({title:c.name||c.id,meta:`${(size/1024).toFixed(0)} KB`,detail:'Imagen del combo almacenada localmente.'})});return rows.sort((a,b)=>parseFloat(b.meta)-parseFloat(a.meta))}
async function optimizeStoredImages(){if(typeof optimizeImageDataUrl!=='function')return notify('El optimizador de imágenes no está disponible.','warn');const heavy=heavyImageRows();if(!heavy.length)return notify('No detecté imágenes antiguas suficientemente pesadas para optimizar.','success');if(window.npConfirm&&!await window.npConfirm(`Se optimizarán imágenes locales pesadas (${heavy.length} referencias detectadas). ¿Continuar?`))return;let changed=0;const opt=async src=>{if(dataUrlBytes(src)<220000)return src;try{const next=await optimizeImageDataUrl(src,{maxWidth:1200,maxHeight:1000,quality:.82});if(next&&next.length<src.length){changed++;return next}}catch(e){recordIssue('image-optimize',e)}return src};for(const p of state.products){p.image=await opt(p.image);if(p.image2)p.image2=await opt(p.image2);if(Array.isArray(p.images))p.images=await Promise.all(p.images.map(opt))}for(const c of state.combos){if(c.image)c.image=await opt(c.image)}write(KEYS.products,state.products);write(KEYS.combos,state.combos);renderStore();notify(`Optimización terminada: ${changed} imágenes reducidas.`,'success')}
function copyDiagnostics(){const d=diagnostics();const text=JSON.stringify(d,null,2);if(navigator.clipboard?.writeText)return navigator.clipboard.writeText(text).then(()=>notify('Diagnóstico copiado.','success'));return ac?.dynamicDownload?.('novaprime-diagnostico.json',text,'application/json')}
function diagnostics(){const st=storageStats();const ids=tools.map(t=>t.id);return {version:VERSION,generatedAt:new Date().toISOString(),tools:{count:tools.length,unique:new Set(ids).size,callable:tools.filter(t=>typeof t.action==='function').length,ranksComplete:tools.every((t,i)=>t.rank===i+1)},data:{products:state.products.length,orders:state.orders.length,users:state.users.length,combos:state.combos.length,invalid:invalidDataRows().length,lowStock:state.products.filter(p=>n(p.stock)>0&&n(p.stock)<=lowLimit()).length,outStock:state.products.filter(p=>n(p.stock)<=0).length,unassigned:unassignedOrders().length},storage:{bytes:st.bytes,approxMB:+(st.bytes/1048576).toFixed(2),heavyImages:heavyImageRows().length},team:{agents:currentAgents().length,active:currentAgents().filter(a=>a.active!==false).length},appCreator:ac?.capabilityData?.()||null,runtimeIssues:runtimeIssues.slice(0,15)}}
function openDiagnostics(){const d=diagnostics();const rows=[{title:'Herramientas',meta:`${d.tools.count}/400`,detail:`${d.tools.unique} IDs únicos · ${d.tools.callable} ejecutables · rangos ${d.tools.ranksComplete?'correctos':'a revisar'}`},{title:'Datos críticos',meta:String(d.data.invalid),detail:`Stock bajo ${d.data.lowStock} · agotados ${d.data.outStock} · pedidos sin asignar ${d.data.unassigned}`},{title:'Almacenamiento local',meta:`${d.storage.approxMB} MB`,detail:`${d.storage.heavyImages} imágenes pesadas detectadas.`},{title:'Errores de ejecución capturados',meta:String(runtimeIssues.length),detail:runtimeIssues[0]?.message||'Sin errores capturados en esta sesión.'}];report('Autodiagnóstico general','Comprueba estructura, datos, almacenamiento y errores capturados durante esta sesión.',rows)}

function replaceTool(id,title,group,icon,desc,fn,aliases=''){const t=tools.find(x=>x.id===id);if(!t)return false;t.title=title;t._np110BaseTitle=title;t.group=group;t.icon=icon;t.desc=desc;t.aliases=aliases;t.action=fn;t._np116Wrapped=false;return true}
function repurposeLowValueTools(){
 const R=[
