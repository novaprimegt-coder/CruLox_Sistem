<script id="jmv354-ui-script">
(()=>{
'use strict';
const D=document;
function refineCheckout354(){
  const form=D.getElementById('checkoutForm');
  if(form){form.noValidate=true;form.setAttribute('novalidate','novalidate')}
  const title=D.querySelector('#checkoutModal .modal-head h2');if(title)title.textContent='Confirmar pedido digital';
  const notice=D.querySelector('#checkoutModal .checkout-safe-notice');
  if(notice)notice.innerHTML='🔒 <strong>Información protegida para este pedido.</strong> Revisa los datos y completa únicamente lo necesario para activar tu servicio.';
  const submit=D.querySelector('#checkoutModal #checkoutForm [type="submit"]');if(submit)submit.textContent='Confirmar y enviar pedido';
}
function refineProductBots354(){
  D.querySelectorAll('[data-support]').forEach(b=>{b.setAttribute('aria-label','Consultar Typebot');b.title='Consultar Typebot'});
  const detail=D.getElementById('detailSupport');if(detail){detail.textContent='Consultar bot';detail.setAttribute('aria-label','Consultar Typebot')}
}
const oldOpenCheckout354=window.openCheckout;
if(typeof oldOpenCheckout354==='function'){
  window.openCheckout=function(){const r=oldOpenCheckout354.apply(this,arguments);setTimeout(refineCheckout354,20);return r};
  try{openCheckout=window.openCheckout}catch(e){}
  const btn=D.getElementById('checkoutBtn');if(btn)btn.onclick=window.openCheckout;
}
const oldOpenDetail354=window.openDetail;
if(typeof oldOpenDetail354==='function'){
  window.openDetail=function(){const r=oldOpenDetail354.apply(this,arguments);setTimeout(refineProductBots354,90);return r};
  try{openDetail=window.openDetail}catch(e){}
}
function init354(){refineCheckout354();refineProductBots354();}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init354,{once:true});else init354();
window.JM_DIGITAL_STORE_V354={VERSION:'3.5.4',refineCheckout:refineCheckout354};
console.info('CRULOX · V3.5.4 UI + Typebot loaded');
})();
</script>


