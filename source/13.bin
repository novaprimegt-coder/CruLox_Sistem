}

/* Notificaciones: borrar individual y borrar visibles */
.jmv34-notif-summary{align-items:flex-start!important}
.jmv353-summary-actions{
  flex:0 0 auto!important;
  display:grid!important;
  gap:6px!important;
  justify-items:end!important;
}
.jmv353-delete-all,
.jmv353-notif-delete{
  min-height:30px!important;
  padding:5px 9px!important;
  border-radius:10px!important;
  border:1px solid rgba(255,97,133,.14)!important;
  background:rgba(255,97,133,.06)!important;
  color:#ff8ea7!important;
  font-size:.52rem!important;
  font-weight:850!important;
}
.jmv353-notif-delete{
  min-height:34px!important;
  padding:6px 10px!important;
  background:rgba(255,255,255,.028)!important;
  border-color:rgba(255,255,255,.06)!important;
  color:#f0a5b5!important;
}
.jmv34-notif-actions .jmv353-notif-delete{flex:0 0 auto!important}
.jmv353-single-actions{
  display:flex!important;
  justify-content:flex-end!important;
  gap:7px!important;
  margin-top:9px!important;
}
@media(max-width:560px){
  .jmv353-summary-actions{justify-items:stretch!important;width:100%!important}
  .jmv34-notif-summary{display:grid!important;grid-template-columns:1fr!important}
}
@media(max-width:760px){
  #detailModal .jmv27-service{padding:9px!important;gap:6px!important}
  #detailModal .jmv2-fact{
    grid-template-columns:20px minmax(66px,84px) minmax(0,1fr)!important;
    padding:7px 8px!important;
    column-gap:7px!important;
  }
  #detailModal .jmv2-fact .jmv27-fact-icon{width:20px!important;height:20px!important;font-size:.52rem!important}
  #detailModal .jmv2-fact small{font-size:.41rem!important}
  #detailModal .jmv2-fact b{font-size:.52rem!important}
  #detailModal .jmv2-requirements{padding:9px 10px!important}
  #detailModal .jmv2-requirements>b{font-size:.53rem!important}
  #detailModal .jmv2-requirements ul{margin-left:26px!important;font-size:.48rem!important}
  #detailModal .jmv2-requirements>div{margin-left:26px!important;font-size:.44rem!important}
}
</style>
<script id="jmv353-detail-notification-script">
(()=>{
'use strict';
const D=document;
const NOTIF_KEY='jm_digital_v23_notifications';
const READ_KEY='jm_digital_v23_notification_reads';
const ORDER_KEY=(typeof KEYS!=='undefined'&&KEYS.orders)?KEYS.orders:'jm_digital_orders';
const esc353=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const read353=(key,fallback)=>{try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):fallback}catch(e){return fallback}};
const write353=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){return false}};
const money353=v=>typeof money==='function'?money(Number(v||0)):`Q${Number(v||0).toFixed(2)}`;
const date353=v=>{try{return new Date(v).toLocaleString('es-GT',{dateStyle:'medium',timeStyle:'short'})}catch(e){return ''}};
const currentUser353=()=>{try{return typeof currentUser==='function'?currentUser():null}catch(e){return null}};
const toast353=(msg,type)=>{try{if(typeof toast==='function')toast(msg,type)}catch(e){}};
const notifications353=()=>{const v=read353(NOTIF_KEY,[]);return Array.isArray(v)?v:[]};
function readScope353(){const session=state?.session;if(session?.role==='admin')return 'admin';const user=currentUser353();return user?.id?`user:${user.id}`:'guest'}
function scopedReadKey353(){return `${READ_KEY}:${readScope353()}`}
const reads353=()=>{const v=read353(scopedReadKey353(),[]);return new Set(Array.isArray(v)?v:[])};
const writeReads353=set=>write353(scopedReadKey353(),[...set]);
function orderIdFromNotification353(n){if(n?.orderId)return String(n.orderId);const text=`${n?.title||''} ${n?.message||''}`;const m=text.match(/\b(?:JM|NP)-[A-Z0-9-]{8,}\b/i);return m?m[0]:''}
function orderById353(id){return (state?.orders||[]).find(o=>String(o.id)===String(id))||null}
function isOrderNotif353(n){return String(n?.type||'').toLowerCase().includes('pedido')||!!orderIdFromNotification353(n)}
function shortMessage353(n){if(isOrderNotif353(n)){const o=orderById353(orderIdFromNotification353(n));if(o?.payment?.receiptDataUrl)return 'Tu comprobante ya fue cargado. Nuestro equipo debe verificar el pago antes de entregar tus accesos.';return 'Tu pedido fue recibido. Realiza el pago y, cuando termines, entra al pedido para subir tu comprobante.'}const msg=String(n?.message||'').replace(/\s+/g,' ').trim();return msg.length>180?`${msg.slice(0,177)}…`:msg}
function visibleNotifications353(){
  const session=state?.session;const user=currentUser353();
  const all=notifications353().filter(n=>{if(session?.role==='admin')return true;if(n.target==='all')return true;return user&&String(n.userId||'')===String(user.id)});
  const read=reads353();
  return all.sort((a,b)=>{const ar=read.has(String(a.id))?1:0,br=read.has(String(b.id))?1:0;if(ar!==br)return ar-br;return Date.parse(b.createdAt||0)-Date.parse(a.createdAt||0)});
}
function updateBadge353(){const badge=D.getElementById('notificationCount');if(!badge)return;const set=reads353();const n=visibleNotifications353().filter(x=>!set.has(String(x.id))).length;badge.textContent=n>99?'99+':String(n);badge.hidden=n===0}
function markRead353(id){const set=reads353();set.add(String(id));writeReads353(set);updateBadge353()}
function markAllRead353(){const set=reads353();visibleNotifications353().forEach(n=>set.add(String(n.id)));writeReads353(set);renderNotificationPanel353();updateBadge353();toast353('Notificaciones marcadas como leídas.','success')}
async function deleteNotification353(id,ask=true){
  const idStr=String(id||''); if(!idStr)return false;
  if(ask){const ok=typeof npConfirm==='function'?await npConfirm('¿Deseas eliminar esta notificación?'):false;if(!ok)return false;}
  const list=notifications353();
  const next=list.filter(n=>String(n.id)!==idStr);
  if(!write353(NOTIF_KEY,next.slice(-300))){toast353('No se pudo eliminar la notificación.','error');return false}
  const set=reads353();set.delete(idStr);writeReads353(set);
  renderNotificationPanel353();updateBadge353();toast353('Notificación eliminada.','success');
  return true;
}
async function clearVisibleNotifications353(){
  const visible=visibleNotifications353(); if(!visible.length){toast353('No hay notificaciones para borrar.','warn');return}
  const ok=typeof npConfirm==='function'?await npConfirm(`¿Deseas eliminar ${visible.length} notificación${visible.length===1?'':'es'}?`):false;if(!ok)return;
  const ids=new Set(visible.map(n=>String(n.id)));
  const next=notifications353().filter(n=>!ids.has(String(n.id)));
  if(!write353(NOTIF_KEY,next.slice(-300))){toast353('No se pudieron borrar las notificaciones.','error');return}
  const set=reads353(); ids.forEach(id=>set.delete(id)); writeReads353(set);
  renderNotificationPanel353(); updateBadge353(); toast353('Notificaciones eliminadas.','success');
}
function orderButtonMarkup353(n,oid,o){return `<div class="jmv34-notif-order-meta"><b>${esc353(oid)}</b><strong>${o?esc353(money353(o.total)):'Pedido'}</strong></div><div class="jmv34-notif-actions"><button class="jmv34-notif-action primary" type="button" data-jmv353-order="${esc353(oid)}" data-jmv353-read="${esc353(n.id)}">Ver pedido y pago</button><button class="jmv353-notif-delete" type="button" data-jmv353-delete="${esc353(n.id)}">Eliminar</button></div>`}
function singleButtonMarkup353(n){return `<div class="jmv353-single-actions"><button class="jmv353-notif-delete" type="button" data-jmv353-delete="${esc353(n.id)}">Eliminar</button></div>`}
function groupMarkup353(list,read){
  return list.map(n=>{const oid=orderIdFromNotification353(n),o=oid?orderById353(oid):null,order=isOrderNotif353(n),unread=!read.has(String(n.id));
    return `<article class="jmv34-notif-card ${unread?'unread':''} ${order?'order':''}" data-jmv353-notif="${esc353(n.id)}"><div class="jmv34-notif-top"><div class="jmv34-notif-icon">${order?'🧾':'🔔'}</div><div class="jmv34-notif-title"><h3>${esc353(n.title||'Notificación')}</h3><time>${esc353(date353(n.createdAt||Date.now()))}</time></div><span class="jmv34-notif-chip">${esc353(n.type||'Aviso')}</span></div><p class="jmv34-notif-message">${esc353(shortMessage353(n))}</p>${order&&oid?orderButtonMarkup353(n,oid,o):singleButtonMarkup353(n)}</article>`;
  }).join('');
}
function renderNotificationPanel353(){
  const box=D.getElementById('notificationItems'); if(!box) return;
  const list=visibleNotifications353(), read=reads353();
  const unread=list.filter(n=>!read.has(String(n.id))), older=list.filter(n=>read.has(String(n.id)));
  box.innerHTML=`<div class="jmv34-notif-summary"><div><b>${unread.length?`${unread.length} notificación${unread.length===1?'':'es'} nueva${unread.length===1?'':'s'}`:'Todo al día'}</b><span>Pedidos, pagos y avisos importantes de tu cuenta.</span></div>${list.length?`<div class="jmv353-summary-actions">${unread.length?'<button class="jmv34-read-all" id="jmv353ReadAll" type="button">Marcar leídas</button>':''}<button class="jmv353-delete-all" id="jmv353DeleteAll" type="button">Eliminar notificaciones</button></div>`:''}</div>${unread.length?`<section class="jmv34-notif-group"><div class="jmv34-notif-group-title">Nuevas</div>${groupMarkup353(unread,read)}</section>`:''}${older.length?`<section class="jmv34-notif-group"><div class="jmv34-notif-group-title">Anteriores</div>${groupMarkup353(older,read)}</section>`:''}${!list.length?'<div class="jmv34-notif-empty">No tienes notificaciones por el momento.</div>':''}`;
  const readAll=D.getElementById('jmv353ReadAll'); if(readAll) readAll.onclick=markAllRead353;
  const delAll=D.getElementById('jmv353DeleteAll'); if(delAll) delAll.onclick=async()=>{await clearVisibleNotifications353()};
  box.querySelectorAll('[data-jmv353-order]').forEach(btn=>btn.onclick=()=>{markRead353(btn.dataset.jmv353Read);try{if(typeof window.JM_DIGITAL_STORE_V34?.openOrder==='function')window.JM_DIGITAL_STORE_V34.openOrder(btn.dataset.jmv353Order)}catch(e){}});
  box.querySelectorAll('[data-jmv353-delete]').forEach(btn=>btn.onclick=async()=>{await deleteNotification353(btn.dataset.jmv353Delete,true)});
}
function noOtherLayer353(){return !D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#jmv21VariantModal.open,#jmNoticeOverlay.open')}
function unlockIfClear353(){requestAnimationFrame(()=>{if(noOtherLayer353())D.body.classList.remove('lock')})}
function closeNotifications353(){D.getElementById('notificationOverlay')?.classList.remove('open');D.getElementById('notificationPanel')?.classList.remove('open');unlockIfClear353()}
function closeStorePanels353(){['drawer','cartPanel','favPanel'].forEach(id=>D.getElementById(id)?.classList.remove('open'));['drawerOverlay','cartOverlay','favOverlay'].forEach(id=>D.getElementById(id)?.classList.remove('open'))}
function openNotifications353(){closeStorePanels353();renderNotificationPanel353();const overlay=D.getElementById('notificationOverlay'),panel=D.getElementById('notificationPanel');if(!overlay||!panel)return;overlay.classList.add('open');panel.classList.add('open');D.body.classList.add('lock')}
function bindNotificationUi353(){const btn=D.getElementById('notificationBtn'),overlay=D.getElementById('notificationOverlay'),close=D.getElementById('notificationClose');if(btn)btn.onclick=openNotifications353;if(overlay)overlay.onclick=e=>{if(e.target===overlay)closeNotifications353()};if(close)close.onclick=closeNotifications353;updateBadge353()}
function refineDetail353(){const service=D.querySelector('#detailModal .jmv27-service');if(!service)return;const sub=service.querySelector('.jmv27-section-head span');if(sub)sub.remove()}
const previousOpenDetail353=window.openDetail;
function openDetail353(id){if(typeof previousOpenDetail353==='function')previousOpenDetail353(id);setTimeout(refineDetail353,34)}
try{window.openDetail=openDetail353;openDetail=openDetail353}catch(e){}
function init353(){bindNotificationUi353();refineDetail353();setInterval(()=>{if(D.hidden)return;updateBadge353();if(D.getElementById('notificationPanel')?.classList.contains('open'))renderNotificationPanel353()},15000)}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init353,{once:true});else init353();
window.JM_DIGITAL_STORE_V34={...(window.JM_DIGITAL_STORE_V34||{}),VERSION:'3.5.0',renderNotificationPanel:renderNotificationPanel353,openNotifications:openNotifications353,closeNotifications:closeNotifications353,deleteNotification:deleteNotification353,clearVisibleNotifications:clearVisibleNotifications353};
window.JM_DIGITAL_STORE_V353={VERSION:'3.5.3',renderNotificationPanel:renderNotificationPanel353,deleteNotification:deleteNotification353,clearVisibleNotifications:clearVisibleNotifications353};
})();
</script>


<!-- JM V3.5.4 · UI refinada: notificaciones, checkout y Typebot por producto -->
<style id="jmv354-ui-style">
/* =========================
   NOTIFICACIONES PREMIUM
   ========================= */
#notificationPanel .panel-content{padding:14px!important}
.jmv34-notif-summary{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:12px!important;
  padding:13px 14px!important;
  border-radius:17px!important;
  border:1px solid rgba(77,209,243,.11)!important;
  background:linear-gradient(135deg,rgba(13,37,55,.94),rgba(7,24,39,.96))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 12px 28px rgba(0,0,0,.12)!important;
}
.jmv34-notif-summary b{font-size:.72rem!important;color:#f2faff!important}
.jmv34-notif-summary span{font-size:.54rem!important;color:#7f99aa!important;line-height:1.4!important}
.jmv353-summary-actions{
  display:flex!important;
  align-items:center!important;
  justify-content:flex-end!important;
  gap:7px!important;
  width:auto!important;
}
.jmv34-read-all,.jmv353-delete-all{
  position:relative!important;
  min-height:35px!important;
  padding:7px 11px!important;
  border-radius:11px!important;
  font-size:.52rem!important;
  font-weight:900!important;
  letter-spacing:.005em!important;
  white-space:nowrap!important;
  transition:transform .16s ease,filter .16s ease,border-color .16s ease!important;
}
.jmv34-read-all{
  border:1px solid rgba(34,223,243,.18)!important;
  background:linear-gradient(135deg,rgba(34,223,243,.10),rgba(34,157,243,.07))!important;
  color:#72e9f8!important;
}
.jmv34-read-all::before{content:'✓';margin-right:5px;font-weight:950!important}
.jmv353-delete-all{
  border:1px solid rgba(255,104,135,.16)!important;
  background:linear-gradient(135deg,rgba(255,75,112,.085),rgba(255,75,112,.035))!important;
  color:#ff9aae!important;
}
.jmv353-delete-all::before{content:'⌫';margin-right:5px;font-weight:950!important}
.jmv34-read-all:active,.jmv353-delete-all:active,.jmv353-notif-delete:active{transform:scale(.98)!important}

.jmv34-notif-card{
  padding:12px!important;
  border-radius:18px!important;
  border-color:rgba(93,207,238,.10)!important;
  background:linear-gradient(180deg,rgba(11,31,48,.96),rgba(7,21,35,.985))!important;
}
.jmv34-notif-card.unread{
  border-color:rgba(34,223,243,.27)!important;
  box-shadow:inset 3px 0 #22dff3,0 10px 24px rgba(0,0,0,.10)!important;
}
.jmv34-notif-icon{background:linear-gradient(145deg,rgba(34,223,243,.10),rgba(34,223,243,.035))!important}
.jmv34-notif-actions{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:7px!important}
.jmv34-notif-action.primary{
  min-height:38px!important;
  border-radius:12px!important;
  background:linear-gradient(110deg,#20ddf1 0%,#16bff7 53%,#208cff 100%)!important;
  color:#03101a!important;
  box-shadow:0 10px 24px rgba(0,184,255,.14)!important;
}
.jmv353-notif-delete{
  min-width:76px!important;
  min-height:38px!important;
  padding:7px 10px!important;
  border-radius:12px!important;
  border:1px solid rgba(255,99,130,.12)!important;
  background:rgba(255,83,119,.045)!important;
  color:#ff9caf!important;
  font-size:.51rem!important;
  font-weight:900!important;
}
.jmv353-notif-delete::before{content:'⌫ ';font-weight:950!important}
.jmv353-single-actions{margin-top:9px!important}

/* =========================
   CHECKOUT / FORMULARIO
   ========================= */
#checkoutModal{padding:12px!important}
#checkoutModal .modal.small{
  width:min(94vw,690px)!important;
  max-width:690px!important;
  max-height:94dvh!important;
  padding:0!important;
  overflow:auto!important;
  border-radius:24px!important;
  border:1px solid rgba(71,203,239,.13)!important;
  background:
    radial-gradient(circle at 100% 0%,rgba(34,223,243,.065),transparent 27%),
    linear-gradient(180deg,#071523 0%,#06111d 100%)!important;
  box-shadow:0 36px 90px rgba(0,0,0,.62),inset 0 1px 0 rgba(255,255,255,.035)!important;
}
#checkoutModal .modal-head{
  position:sticky!important;
  top:0!important;
  z-index:5!important;
  min-height:64px!important;
  padding:14px 16px!important;
  margin:0!important;
  border-bottom:1px solid rgba(86,204,236,.08)!important;
  background:rgba(6,17,29,.94)!important;
  backdrop-filter:blur(16px)!important;
  -webkit-backdrop-filter:blur(16px)!important;
}
#checkoutModal .modal-head h2{font-size:1rem!important;letter-spacing:-.015em!important}
#checkoutModal .modal-head .close-btn{
  width:38px!important;height:38px!important;border-radius:13px!important;
  background:rgba(255,255,255,.025)!important;border:1px solid rgba(255,255,255,.07)!important
}
#checkoutModal .checkout-safe-notice{
  margin:14px 16px 0!important;
  padding:11px 12px!important;
  border-radius:14px!important;
  border:1px solid rgba(54,220,140,.12)!important;
  background:linear-gradient(135deg,rgba(47,216,126,.055),rgba(34,223,243,.03))!important;
  color:#a6bdc9!important;
  font-size:.56rem!important;
  line-height:1.5!important;
}
#checkoutModal .checkout-safe-notice strong{color:#6fe9a4!important}
#checkoutModal #checkoutForm{padding:13px 16px 16px!important}
#checkoutModal #checkoutFields{gap:10px!important}
#checkoutModal .jmv2-checkout-summary{
  position:relative!important;
  padding:13px 14px 13px 48px!important;
  border-radius:16px!important;
  border:1px solid rgba(34,223,243,.10)!important;
  background:linear-gradient(135deg,rgba(34,223,243,.055),rgba(55,104,255,.025))!important;
}
#checkoutModal .jmv2-checkout-summary::before{
  content:'✓';position:absolute!important;left:14px!important;top:14px!important;
  width:24px!important;height:24px!important;border-radius:8px!important;
  display:grid!important;place-items:center!important;
  background:rgba(34,223,243,.08)!important;border:1px solid rgba(34,223,243,.12)!important;color:#5ee7f6!important;font-weight:950!important
}
#checkoutModal .jmv2-checkout-summary h3{font-size:.73rem!important;color:#f1f9ff!important;margin:0 0 4px!important}
#checkoutModal .jmv2-checkout-summary p{font-size:.55rem!important;color:#7892a5!important;line-height:1.45!important}

#checkoutModal .jmv2-order-service{
  padding:13px!important;
  border-radius:17px!important;
  border:1px solid rgba(111,205,235,.09)!important;
  background:linear-gradient(180deg,rgba(10,27,43,.88),rgba(7,21,34,.96))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;
}
#checkoutModal .jmv2-order-service-head{
  margin-bottom:11px!important;padding-bottom:9px!important;border-bottom:1px solid rgba(113,204,235,.065)!important
}
#checkoutModal .jmv2-order-service-head b{font-size:.70rem!important;color:#eff8ff!important}
#checkoutModal .jmv2-order-service-head span{font-size:.52rem!important;color:#718b9f!important}
#checkoutModal .jmv2-order-fields{gap:9px!important}

#checkoutModal .jmv2-payment-box{
  position:relative!important;
  padding:36px 13px 13px!important;
  gap:9px!important;
  border-radius:17px!important;
  border:1px solid rgba(111,205,235,.09)!important;
  background:linear-gradient(180deg,rgba(9,25,40,.90),rgba(6,20,33,.97))!important;
}
#checkoutModal .jmv2-payment-box::before{
  content:'Pago y entrega';position:absolute!important;left:13px!important;top:11px!important;
  color:#dceef7!important;font-size:.58rem!important;font-weight:900!important;letter-spacing:.01em!important
}
#checkoutModal .field{gap:5px!important}
#checkoutModal .field label{
  color:#8ba3b5!important;
  font-size:.52rem!important;
  font-weight:850!important;
  letter-spacing:.01em!important;
}
#checkoutModal .field input,#checkoutModal .field select,#checkoutModal .field textarea{
  width:100%!important;
  min-height:44px!important;
  padding:10px 12px!important;
  border-radius:13px!important;
  border:1px solid rgba(112,190,224,.10)!important;
  background:#071a2a!important;
  color:#edf7fc!important;
  font-size:.62rem!important;
  outline:none!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.015)!important;
  transition:border-color .18s ease,box-shadow .18s ease,background .18s ease!important;
}
#checkoutModal .field input::placeholder,#checkoutModal .field textarea::placeholder{color:#526d82!important;opacity:1!important}
#checkoutModal .field input:focus,#checkoutModal .field select:focus,#checkoutModal .field textarea:focus{
  border-color:rgba(34,223,243,.34)!important;
  background:#081d2e!important;
  box-shadow:0 0 0 3px rgba(34,223,243,.055)!important;
}
#checkoutModal .field input[readonly]{color:#a8bac6!important;background:rgba(255,255,255,.018)!important}
#checkoutModal #coNotes{min-height:100px!important;resize:vertical!important}
#checkoutModal #checkoutForm>.field.full{margin-top:10px!important;padding:12px!important;border:1px solid rgba(111,205,235,.08)!important;border-radius:16px!important;background:rgba(255,255,255,.014)!important}
#checkoutModal #checkoutForm>.form-actions{
  position:sticky!important;bottom:-16px!important;z-index:4!important;
  margin:12px -16px -16px!important;padding:11px 16px max(14px,env(safe-area-inset-bottom))!important;
  background:linear-gradient(180deg,rgba(6,17,29,.10),rgba(6,17,29,.96) 32%)!important;
  backdrop-filter:blur(10px)!important;-webkit-backdrop-filter:blur(10px)!important
}
#checkoutModal #checkoutForm>.form-actions .btn-primary{
  min-height:48px!important;
  border-radius:14px!important;
  border:0!important;
  background:linear-gradient(110deg,#1de0ef 0%,#11c4f5 50%,#237eff 100%)!important;
  color:#03101a!important;
  font-size:.67rem!important;
  font-weight:950!important;
  box-shadow:0 13px 30px rgba(0,177,255,.17)!important;
}
#checkoutModal #checkoutForm>.form-actions .btn-primary::before{content:'✓ ';font-weight:950!important}

/* =========================
   TYPEBOT POR PRODUCTO
   ========================= */
.product-actions .support,#detailModal #detailSupport{position:relative!important}
.product-actions .support{background:linear-gradient(135deg,#19d98d,#08c879)!important;border-color:rgba(40,238,158,.16)!important;color:#04150e!important}
#detailModal #detailSupport{background:linear-gradient(135deg,#19d98d,#08c879)!important;color:#03140d!important}
