}
#detailModal .jmv27-actions #detailFav::before{content:"♡ ";color:#ff7f99!important;font-weight:950!important}
#detailModal .jmv27-actions .btn:disabled{opacity:.45!important;filter:saturate(.5)!important}

@media(max-width:760px){
  #detailModal{padding:6px!important;align-items:flex-end!important}
  #detailModal .modal{
    width:100%!important;
    max-height:96dvh!important;
    padding:9px!important;
    border-radius:20px 20px 10px 10px!important;
  }
  #detailModal .modal-head{min-height:30px!important;margin-bottom:6px!important}
  #detailModal .modal-head .close-btn{width:30px!important;height:30px!important;border-radius:10px!important}
  #detailModal .product-detail.jmv27-detail{
    grid-template-columns:1fr!important;
    gap:10px!important;
  }
  #detailModal .jmv27-detail .product-detail-gallery,
  #detailModal .jmv27-detail>.product-detail-media{position:relative!important;top:auto!important}
  #detailModal .jmv27-detail .product-detail-media{
    aspect-ratio:16/8.6!important;
    border-radius:15px!important;
  }
  #detailModal .jmv27-info{gap:8px!important}
  #detailModal .jmv27-head{padding:0 1px!important}
