  #detailModal .jmv2-fact{min-height:52px!important;padding:7px 8px!important;grid-template-columns:23px minmax(0,1fr)!important;column-gap:6px!important}
  #detailModal .jmv2-fact .jmv27-fact-icon{width:23px!important;height:23px!important;border-radius:7px!important;font-size:.58rem!important}
  #detailModal .jmv2-fact small{font-size:.42rem!important}
