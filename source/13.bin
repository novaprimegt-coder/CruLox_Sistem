  #detailModal .jmv27-head .section-kicker,#detailModal .jmv27-head .stock-detail{min-height:22px!important;padding:4px 8px!important;font-size:.46rem!important}
  #detailModal .jmv27-offer{padding:9px 10px!important;border-radius:13px!important}
