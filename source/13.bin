  .jmv34-notif-actions{grid-template-columns:minmax(0,1fr) 72px!important}
  .jmv353-notif-delete{min-width:72px!important;padding:6px 7px!important;font-size:.48rem!important}
  #checkoutModal{padding:6px!important;align-items:flex-end!important}
  #checkoutModal .modal.small{width:100%!important;max-height:96dvh!important;border-radius:22px 22px 10px 10px!important}
