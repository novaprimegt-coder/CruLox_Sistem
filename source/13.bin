}

/* Acciones */
#detailModal .jmv27-actions{
  display:grid!important;
  grid-template-columns:1.12fr .88fr!important;
  gap:6px!important;
  margin:1px 0 0!important;
}
#detailModal .jmv27-actions .btn{
  min-height:36px!important;
  padding:7px 10px!important;
