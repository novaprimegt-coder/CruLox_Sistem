mentById('drawer')?.classList.remove('open');D.getElementById('drawerOverlay')?.classList.remove('open');D.body.classList.remove('lock');}}catch(e){}}
function enhanceHero24(){
  const hero=D.querySelector('.hero-brand-top');
  if(!hero) return;
  const copy=hero.querySelector('.hero-brand-copy');
  if(!hero.querySelector('img')){
    hero.innerHTML=`<img src="${BRAND_LOGO_FULL}" alt="CRULOX">`;
  }
  applyTransparentLogos24(hero);
}
function enhanceFooterBrand24(){
  const first=D.querySelector('.footer-grid>div:first-child');
  if(!first) return;
  let brand=first.querySelector('.jmv21-footer-brand');
  if(!brand){
    brand=D.createElement('div');
    brand.className='jmv21-footer-brand';
    brand.innerHTML=`<img src="${BRAND_LOGO_FULL}" alt="CRULOX">`;
    first.prepend(brand);
  }
  applyTransparentLogos24(first);
}
function rebuildDrawer24(){
  const drawer=D.getElementById('drawer');
  if(!drawer)return;
  drawer.innerHTML=`
    <div class="drawer-head jmv24-drawer-head">
      <div class="jmv24-drawer-brand"><img class="drawer-logo jmv24-drawer-logo" src="${LOGO24}" alt="CRULOX"></div>
      <button class="close-btn jmv24-drawer-close" id="drawerClose" type="button" aria-label="Cerrar menú">✕</button>
    </div>
    <div class="jmv24-drawer-scroll">
      <section class="jmv24-drawer-block">
        <div class="jmv24-drawer-label">Centro de información</div>
        <nav class="jmv24-drawer-nav" aria-label="Información y seguridad de CruLox">
          <button type="button" class="jmv24-nav-item" data-cru449-topic="pagos" aria-expanded="false" aria-controls="cru449Info"><span class="jmv24-nav-ico">◈</span><span class="jmv24-nav-copy"><b>Pagos seguros</b><small>Verificación, comprobantes y medios autorizados.</small></span></button>
          <button type="button" class="jmv24-nav-item" data-cru449-topic="entregas" aria-expanded="false" aria-controls="cru449Info"><span class="jmv24-nav-ico">✓</span><span class="jmv24-nav-copy"><b>Entregas y activaciones</b><small>Reservas, tiempos y confirmación del servicio.</small></span></button>
          <button type="button" class="jmv24-nav-item" data-cru449-topic="condiciones" aria-expanded="false" aria-controls="cru449Info"><span class="jmv24-nav-ico">↺</span><span class="jmv24-nav-copy"><b>Devoluciones y promociones</b><small>Vigencias, límites y solicitudes de revisión.</small></span></button>
          <button type="button" class="jmv24-nav-item" data-cru449-topic="privacidad" aria-expanded="false" aria-controls="cru449Info"><span class="jmv24-nav-ico">◇</span><span class="jmv24-nav-copy"><b>Privacidad de tus datos</b><small>Qué solicita la tienda y dónde se almacenan.</small></span></button>
          <button type="button" class="jmv24-nav-item" data-cru449-topic="seguridad" aria-expanded="false" aria-controls="cru449Info"><span class="jmv24-nav-ico">✦</span><span class="jmv24-nav-copy"><b>Evita fraudes</b><small>Precauciones al comprar y usar tu cuenta.</small></span></button>
          <button type="button" class="jmv24-nav-item" id="cru449Policies"><span class="jmv24-nav-ico">▤</span><span class="jmv24-nav-copy"><b>Documentos legales completos</b><small>Leer las condiciones de uso y privacidad vigentes.</small></span></button>
        </nav>
        <section class="cru449-info" id="cru449Info" role="region" aria-label="Detalle informativo" hidden>
          <div class="cru449-info-head"><strong id="cru449InfoTitle"></strong><button type="button" id="cru449InfoClose" aria-label="Cerrar información">×</button></div>
          <p id="cru449InfoBody"></p>
        </section>
      </section>
      <p class="jmv24-drawer-note"><b>Protege tus accesos.</b> No compartas contraseñas, PIN bancarios ni códigos de verificación. Revisa siempre los datos antes de pagar.</p>
      <div class="drawer-social jmv24-social-grid" id="drawerSocial" hidden style="display:none!important"></div>
    </div>`;
  applyTransparentLogos24(drawer);
  if(typeof renderSocials==='function'){try{renderSocials()}catch(e){}}
  const closeBtn=D.getElementById('drawerClose');
  if(closeBtn)closeBtn.onclick=closeDrawer24;
  const data={
    pagos:{title:'Pagos seguros',body:'Confirma el método de pago durante tu pedido y utiliza únicamente las cuentas oficiales mostradas por CruLox. Un pedido registrado no implica que el pago haya sido confirmado. No envíes contraseñas bancarias ni PIN. Los comprobantes deben ser auténticos y legibles.'},
    entregas:{title:'Entregas y activaciones',body:'Todos los servicios de CruLox son digitales. El tiempo de entrega, la vigencia y los datos necesarios dependen del producto elegido. Algunas compras quedan pendientes de verificación de pago o disponibilidad antes de entregar el acceso o realizar la activación.'},
    condiciones:{title:'Devoluciones y promociones',body:'Los códigos promocionales dependen de su vigencia, límites, compra mínima y disponibilidad. Los anuncios marcados como ejemplo no son canjeables. Las cancelaciones y devoluciones se evalúan según el servicio, su estado de entrega y la legislación aplicable, sin eliminar los derechos irrenunciables del consumidor.'},
    privacidad:{title:'Privacidad de tus datos',body:'CruLox puede solicitar nombre, usuario, correo, teléfono y otros datos según el formulario, además de información de pedidos, comprobantes y activaciones. Esta versión HTML almacena información en el navegador; no garantiza sincronización entre dispositivos. Puedes consultar las políticas completas para conocer conservación y solicitudes de corrección o eliminación.'},
    seguridad:{title:'Cómo evitar fraudes',body:'Nunca compartas tu contraseña, códigos de verificación ni datos bancarios confidenciales. Usa únicamente los medios y cuentas que CruLox indique durante la compra. No presentes comprobantes alterados. Si detectas una compra no reconocida, informa al soporte de la tienda y conserva tus comprobantes.'}
  };
  const info=D.getElementById('cru449Info');
  const infoTitle=D.getElementById('cru449InfoTitle');
  const infoBody=D.getElementById('cru449InfoBody');
  const btns=Array.from(drawer.querySelectorAll('[data-cru449-topic]'));
  function hideInfo(){info.hidden=true;btns.forEach(b=>b.setAttribute('aria-expanded','false'))}
  btns.forEach(btn=>btn.addEventListener('click',()=>{
    const topic=btn.dataset.cru449Topic;
    if(!data[topic])return;
    if(!info.hidden&&btn.getAttribute('aria-expanded')==='true'){hideInfo();return;}
    infoTitle.textContent=data[topic].title;
    infoBody.textContent=data[topic].body;
    info.hidden=false;
    btns.forEach(b=>b.setAttribute('aria-expanded',b===btn?'true':'false'));
    info.scrollIntoView({block:'nearest',behavior:'auto'});
  }));
  D.getElementById('cru449InfoClose').onclick=hideInfo;
  D.getElementById('cru449Policies').onclick=()=>{
    closeDrawer24();
    if(typeof window.CRULOX_POLICY_V448?.reopen==='function')window.CRULOX_POLICY_V448.reopen();
    else D.getElementById('cru448ReviewBtn')?.click();
  };
}
function init24(){enhanceHero24();enhanceFooterBrand24();rebuildDrawer24();applyTransparentLogos24();}
if(D.readyState==='loading') D.addEventListener('DOMContentLoaded',init24,{once:true}); else init24();
window.JM_DIGITAL_STORE_V24={VERSION:'2.4.0',applyTransparentLogos:applyTransparentLogos24,rebuildDrawer:rebuildDrawer24};
console.info('CRULOX · V2.4 transparent logo and professional drawer loaded');
})();
</script>





<!-- CRULOX V2.6 · refinamiento exclusivo de detalles de producto -->
<style id="jmv26-product-detail-refinement">
/* Alcance exclusivo: modal de detalles de producto. No modifica catálogo, navegación ni lógica. */
#detailModal .modal{
  width:min(860px,100%)!important;
  max-height:94dvh!important;
  overflow:auto!important;
  padding:14px!important;
}
#detailModal .product-detail{
  grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr)!important;
  gap:14px!important;
  align-items:start!important;
  text-align:left!important;
}
#detailModal .product-detail-gallery,
#detailModal .product-detail-media,
#detailModal .product-detail-info{min-width:0!important}
#detailModal .product-detail-media{
  border-radius:16px!important;
  overflow:hidden!important;
  background:rgba(255,255,255,.025)!important;
  border:1px solid rgba(128,211,237,.09)!important;
}
#detailModal .product-detail-media img{
  width:100%!important;
  height:clamp(230px,38vw,330px)!important;
  object-fit:cover!important;
  border-radius:0!important;
}
#detailModal .product-detail-thumbs{gap:6px!important;margin-top:7px!important}
#detailModal .product-detail-thumb{width:54px!important;height:44px!important;border-radius:9px!important}

#detailModal .product-detail-info{
  display:flex!important;
  flex-direction:column!important;
  gap:0!important;
}
#detailModal .product-detail-info>.section-kicker{
  width:max-content!important;
  max-width:100%!important;
  margin:0 0 5px!important;
  padding:4px 7px!important;
  border-radius:999px!important;
  background:rgba(34,223,243,.06)!important;
  border:1px solid rgba(34,223,243,.11)!important;
  color:var(--jmv2-cyan,var(--cyan))!important;
  font-size:.48rem!important;
  line-height:1.15!important;
}
#detailModal .product-detail-info>h2{
  margin:0!important;
  font-size:1.06rem!important;
  line-height:1.18!important;
  letter-spacing:-.015em!important;
}
#detailModal .product-detail-info>.rating{
  margin-top:5px!important;
  font-size:.55rem!important;
  line-height:1.2!important;
}
#detailModal .product-detail-info>.price-row{
  margin:8px 0 5px!important;
  min-height:0!important;
  align-items:center!important;
}
#detailModal .product-detail-info>.price-row .price{font-size:1.16rem!important}
#detailModal .product-detail-info>.price-row .old{font-size:.57rem!important}
#detailModal .product-detail-info>p:not(.stock){
  margin:2px 0 0!important;
  color:var(--sub)!important;
  font-size:.65rem!important;
  line-height:1.5!important;
}
#detailModal .stock-detail{
  align-self:flex-start!important;
  width:auto!important;
  margin:7px 0 0!important;
  padding:4px 8px!important;
  border-radius:999px!important;
  border:1px solid rgba(57,223,124,.12)!important;
  background:rgba(57,223,124,.055)!important;
  font-size:.55rem!important;
  line-height:1.2!important;
}

/* Información clave: compacta, legible y siempre en dos columnas. */
#detailModal .jmv2-digital-facts{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:6px!important;
  margin:10px 0 0!important;
}
#detailModal .jmv2-digital-facts::before{
  content:"Detalles del servicio";
  grid-column:1/-1!important;
  display:block!important;
  margin:0 0 1px!important;
  color:#dcecf5!important;
  font-size:.61rem!important;
  font-weight:900!important;
  letter-spacing:.01em!important;
}
#detailModal .jmv2-fact{
  min-height:52px!important;
  padding:7px 8px!important;
  border-radius:10px!important;
  border:1px solid rgba(128,211,237,.085)!important;
  background:linear-gradient(145deg,rgba(255,255,255,.022),rgba(34,223,243,.018))!important;
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
  text-align:left!important;
}
#detailModal .jmv2-fact small{
  margin:0 0 2px!important;
  color:#6f8797!important;
  font-size:.49rem!important;
  line-height:1.15!important;
}
#detailModal .jmv2-fact b{
  color:#eef8ff!important;
  font-size:.61rem!important;
  line-height:1.22!important;
  font-weight:850!important;
}

/* Datos requeridos: bloque único, compacto y separado del resumen. */
#detailModal .jmv2-requirements{
  margin:8px 0 0!important;
  padding:9px 10px!important;
  border-radius:11px!important;
  border:1px solid rgba(34,223,243,.10)!important;
  background:rgba(34,223,243,.025)!important;
  text-align:left!important;
}
#detailModal .jmv2-requirements>b{
  display:block!important;
  margin:0!important;
  font-size:.60rem!important;
  line-height:1.28!important;
}
#detailModal .jmv2-requirements ul{
  list-style:none!important;
  margin:6px 0 0!important;
  padding:0!important;
  display:grid!important;
  gap:4px!important;
  color:var(--sub)!important;
  font-size:.56rem!important;
  line-height:1.35!important;
}
#detailModal .jmv2-requirements li{
  position:relative!important;
  padding-left:12px!important;
}
#detailModal .jmv2-requirements li::before{
  content:"•";
  position:absolute!important;
  left:1px!important;
  top:0!important;
  color:var(--jmv2-cyan,var(--cyan))!important;
  font-weight:900!important;
}
#detailModal .jmv2-requirements>div{
  margin-top:6px!important;
  padding-top:6px!important;
  border-top:1px solid rgba(128,211,237,.07)!important;
  font-size:.52rem!important;
  line-height:1.35!important;
}

/* Acciones: prioridad clara sin alterar funciones. */
#detailModal .product-detail-info>.form-actions{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:6px!important;
  margin-top:10px!important;
}
#detailModal .product-detail-info>.form-actions .btn{
  min-height:34px!important;
  padding:6px 9px!important;
  border-radius:10px!important;
  font-size:.58rem!important;
  line-height:1.15!important;
}
#detailModal #detailAdd{grid-column:1/-1!important}

@media(max-width:620px){
  #detailModal{padding:7px!important;align-items:flex-end!important}
  #detailModal .modal{
    width:100%!important;
    max-height:96dvh!important;
    padding:10px!important;
    border-radius:18px 18px 12px 12px!important;
  }
  #detailModal .modal-head{margin-bottom:8px!important}
  #detailModal .product-detail{
    grid-template-columns:1fr!important;
    gap:9px!important;
  }
  #detailModal .product-detail-media img{
    height:clamp(165px,46vw,205px)!important;
  }
  #detailModal .product-detail-info>h2{
    font-size:.97rem!important;
    line-height:1.18!important;
  }
  #detailModal .product-detail-info>.price-row .price{font-size:1.08rem!important}
  #detailModal .product-detail-info>p:not(.stock){font-size:.61rem!important;line-height:1.45!important}
  #detailModal .jmv2-digital-facts{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:5px!important;
    margin-top:9px!important;
  }
  #detailModal .jmv2-fact{
    min-height:48px!important;
    padding:6px 7px!important;
  }
  #detailModal .jmv2-fact small{font-size:.46rem!important}
  #detailModal .jmv2-fact b{font-size:.57rem!important}
  #detailModal .jmv2-requirements{padding:8px 9px!important}
  #detailModal .jmv2-requirements>b{font-size:.56rem!important}
  #detailModal .jmv2-requirements ul{font-size:.53rem!important;gap:3px!important}
  #detailModal .product-detail-info>.form-actions .btn{min-height:32px!important;font-size:.55rem!important}
}

@media(max-width:350px){
  #detailModal .jmv2-fact b{font-size:.54rem!important}
  #detailModal .product-detail-info>.form-actions{gap:5px!important}
}
</style>



<!-- CRULOX V2.7 · detalle de producto premium reconstruido sin alterar funciones -->
<style id="jmv27-detail-premium-style">
/* ===== V2.7 · DETALLE DE PRODUCTO PREMIUM ===== */
#detailModal{
  padding:12px!important;
  background:rgba(1,6,12,.86)!important;
  backdrop-filter:blur(16px) saturate(118%)!important;
}
#detailModal .modal{
  width:min(980px,calc(100vw - 24px))!important;
  max-height:94dvh!important;
  padding:12px!important;
  border-radius:24px!important;
  border:1px solid rgba(124,218,245,.12)!important;
  background:
    radial-gradient(circle at 0% 0%,rgba(34,223,243,.055),transparent 28%),
    linear-gradient(180deg,#091522 0%,#07111d 100%)!important;
  box-shadow:0 32px 90px rgba(0,0,0,.72),0 0 0 1px rgba(255,255,255,.018) inset!important;
  scrollbar-width:thin!important;
}
#detailModal .modal-head{
  min-height:34px!important;
  margin:0 0 9px!important;
  padding:0 2px!important;
}
#detailModal .modal-head h2{
  margin:0!important;
  color:#9bb1c1!important;
  font-size:.57rem!important;
  line-height:1!important;
  font-weight:800!important;
  letter-spacing:.14em!important;
  text-transform:uppercase!important;
}
#detailModal .modal-head .close-btn{
  width:32px!important;
  height:32px!important;
  border-radius:11px!important;
  border:1px solid rgba(255,255,255,.08)!important;
  background:rgba(255,255,255,.035)!important;
  color:#dce8ef!important;
  font-size:.72rem!important;
}
#detailModal .modal-head .close-btn:hover{
  border-color:rgba(34,223,243,.22)!important;
  background:rgba(34,223,243,.07)!important;
  color:#fff!important;
}
#detailModal #detailBody{min-width:0!important}
#detailModal .product-detail.jmv27-detail{
  display:grid!important;
  grid-template-columns:minmax(300px,.92fr) minmax(0,1.08fr)!important;
  gap:14px!important;
  align-items:start!important;
}

/* Galería / imagen */
#detailModal .jmv27-detail .product-detail-gallery,
#detailModal .jmv27-detail>.product-detail-media{
  min-width:0!important;
  position:sticky!important;
  top:0!important;
}
#detailModal .jmv27-detail .product-detail-media{
  width:100%!important;
  height:auto!important;
  min-height:0!important;
  aspect-ratio:16/10!important;
  border-radius:18px!important;
  overflow:hidden!important;
  border:1px solid rgba(121,209,236,.10)!important;
  background:
    radial-gradient(circle at 50% 12%,rgba(34,223,243,.06),transparent 36%),
    #06111e!important;
  box-shadow:0 16px 40px rgba(0,0,0,.28)!important;
}
#detailModal .jmv27-detail .product-detail-media img{
  display:block!important;
  width:100%!important;
  height:100%!important;
  min-height:0!important;
  object-fit:cover!important;
  object-position:center!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  filter:none!important;
  box-shadow:none!important;
  transition:transform .3s ease,opacity .2s ease!important;
}
#detailModal .jmv27-detail .product-detail-media:hover img{transform:scale(1.012)!important}
#detailModal .jmv27-detail .product-detail-thumbs{
  display:flex!important;
  gap:6px!important;
  padding:7px 1px 0!important;
  overflow-x:auto!important;
  scrollbar-width:none!important;
}
#detailModal .jmv27-detail .product-detail-thumb{
  flex:0 0 54px!important;
  width:54px!important;
  height:42px!important;
  padding:2px!important;
  border-radius:9px!important;
  border:1px solid rgba(255,255,255,.07)!important;
  background:rgba(255,255,255,.025)!important;
}
#detailModal .jmv27-detail .product-detail-thumb.active{
  border-color:rgba(34,223,243,.62)!important;
  box-shadow:0 0 0 2px rgba(34,223,243,.08)!important;
}
#detailModal .jmv27-detail .product-detail-thumb img{
  width:100%!important;height:100%!important;object-fit:cover!important;border-radius:6px!important
}

/* Columna de información */
#detailModal .jmv27-info{
  min-width:0!important;
  display:grid!important;
  gap:9px!important;
  align-content:start!important;
}
#detailModal .jmv27-head{
  padding:3px 1px 0!important;
}
#detailModal .jmv27-badges{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:8px!important;
  flex-wrap:wrap!important;
  margin-bottom:7px!important;
}
#detailModal .jmv27-head .section-kicker{
  display:inline-flex!important;
  align-items:center!important;
  width:auto!important;
  min-height:24px!important;
  margin:0!important;
  padding:5px 9px!important;
  border-radius:999px!important;
  border:1px solid rgba(34,223,243,.14)!important;
  background:rgba(34,223,243,.055)!important;
  color:#61ddef!important;
  font-size:.49rem!important;
  line-height:1!important;
  font-weight:850!important;
  letter-spacing:.10em!important;
}
#detailModal .jmv27-head .stock-detail{
  display:inline-flex!important;
  align-items:center!important;
  gap:6px!important;
  width:auto!important;
  margin:0!important;
  padding:5px 9px!important;
  border-radius:999px!important;
  border:1px solid rgba(57,223,124,.13)!important;
  background:rgba(57,223,124,.055)!important;
  color:#89efb3!important;
  font-size:.51rem!important;
  line-height:1!important;
  font-weight:850!important;
  text-align:left!important;
}
#detailModal .jmv27-head .stock-detail::before{
  content:"";
  width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 10px currentColor
}
#detailModal .jmv27-head .stock-detail.low{color:#ffd780!important;border-color:rgba(255,196,77,.18)!important;background:rgba(255,196,77,.055)!important}
#detailModal .jmv27-head .stock-detail.out{color:#ff8fa0!important;border-color:rgba(255,94,120,.18)!important;background:rgba(255,94,120,.055)!important}
#detailModal .jmv27-head h2{
  margin:0!important;
  color:#f5fbff!important;
  font-size:clamp(1.04rem,2.5vw,1.42rem)!important;
  line-height:1.14!important;
  font-weight:900!important;
  letter-spacing:-.022em!important;
}
#detailModal .jmv27-head .rating{
  display:flex!important;
  align-items:center!important;
  gap:4px!important;
  margin-top:6px!important;
  color:#ffc44d!important;
  font-size:.56rem!important;
  line-height:1!important;
}
#detailModal .jmv27-head .rating span{color:#70889a!important;font-size:.53rem!important}

/* Precio + descripción en bloque de oferta */
#detailModal .jmv27-offer{
  display:grid!important;
  gap:7px!important;
  padding:11px 12px!important;
  border-radius:15px!important;
  border:1px solid rgba(111,205,235,.085)!important;
  background:linear-gradient(145deg,rgba(255,255,255,.028),rgba(34,223,243,.018))!important;
}
#detailModal .jmv27-offer .price-row{
  display:flex!important;
  align-items:baseline!important;
  justify-content:flex-start!important;
  width:auto!important;
  min-height:0!important;
  margin:0!important;
  gap:7px!important;
  text-align:left!important;
}
#detailModal .jmv27-offer .price-row .price{
  color:#24dff4!important;
  font-size:1.38rem!important;
  line-height:1!important;
  font-weight:950!important;
  letter-spacing:-.035em!important;
