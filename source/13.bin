  #detailModal .jmv2-requirements ul{margin-left:27px!important;font-size:.5rem!important}
  #detailModal .jmv2-requirements>div{margin-left:27px!important;font-size:.46rem!important}
  #detailModal .jmv27-actions .btn{min-height:34px!important;font-size:.53rem!important}
  #detailModal .jmv27-actions #detailAdd{min-height:38px!important}
}
@media(max-width:370px){
  #detailModal .modal{padding:8px!important}
  #detailModal .jmv2-fact{padding:6px 7px!important}
  #detailModal .jmv2-fact b{font-size:.51rem!important}
  #detailModal .jmv27-actions{grid-template-columns:1fr 1fr!important}
}
</style>
<script id="jmv27-detail-premium-script">
(()=>{
'use strict';
const D=document;
const q27=(s,r=D)=>r.querySelector(s);
const qa27=(s,r=D)=>Array.from(r.querySelectorAll(s));
const iconForFact27=label=>{
  const s=String(label||'').toLowerCase();
  if(s.includes('tipo')) return '◇';
  if(s.includes('plataforma')) return '▣';
  if(s.includes('estimada')) return '◷';
  if(s.includes('forma')) return '↯';
  if(s.includes('duración')||s.includes('vigencia')) return '◴';
  if(s.includes('disponibilidad')) return '●';
  return '•';
};
function rebuildDetailV27(id){
  const root=q27('#detailBody .product-detail');
  const info=q27('#detailBody .product-detail-info');
  if(!root||!info)return;
  root.classList.add('jmv27-detail');
  info.classList.add('jmv27-info');

  const kicker=Array.from(info.children).find(el=>el.classList?.contains('section-kicker'));
  const title=Array.from(info.children).find(el=>el.tagName==='H2');
  const rating=Array.from(info.children).find(el=>el.classList?.contains('rating'));
  const price=Array.from(info.children).find(el=>el.classList?.contains('price-row'));
  const description=Array.from(info.children).find(el=>el.tagName==='P'&&!el.classList?.contains('stock'));
  const stock=Array.from(info.children).find(el=>el.classList?.contains('stock'));
  const facts=q27('.jmv2-digital-facts',info);
  const requirements=q27('.jmv2-requirements',info);
  const actions=q27('.form-actions',info);
  if(!title||!price||!actions)return;

  const head=D.createElement('section');
  head.className='jmv27-head';
  const badges=D.createElement('div');
  badges.className='jmv27-badges';
  if(kicker)badges.appendChild(kicker);
  if(stock)badges.appendChild(stock);
  head.appendChild(badges);
  head.appendChild(title);
  if(rating)head.appendChild(rating);

  const offer=D.createElement('section');
  offer.className='jmv27-offer';
  price.removeAttribute('style');
  offer.appendChild(price);
  if(description){description.classList.add('jmv27-description');offer.appendChild(description)}

  const service=D.createElement('section');
  service.className='jmv27-service';
  const serviceHead=D.createElement('div');
  serviceHead.className='jmv27-section-head';
  serviceHead.innerHTML='<h3>Detalles del servicio</h3><span>Información esencial</span>';
  service.appendChild(serviceHead);
  if(facts){
    qa27('.jmv2-fact',facts).forEach(card=>{
      if(!q27('.jmv27-fact-icon',card)){
        const label=q27('small',card)?.textContent||'';
        const icon=D.createElement('i');
        icon.className='jmv27-fact-icon';
        icon.setAttribute('aria-hidden','true');
        icon.textContent=iconForFact27(label);
        card.prepend(icon);
      }
    });
    service.appendChild(facts);
  }

  actions.classList.add('jmv27-actions');
  const nodes=[head,offer,service];
  if(requirements)nodes.push(requirements);
  nodes.push(actions);
  info.replaceChildren(...nodes);
}
const previousOpenDetailV27=window.openDetail;
function openDetailV27(id){
  if(typeof previousOpenDetailV27==='function')previousOpenDetailV27(id);
  window.setTimeout(()=>rebuildDetailV27(id),18);
}
try{window.openDetail=openDetailV27;openDetail=openDetailV27}catch(e){}
window.JM_DIGITAL_STORE_V27={VERSION:'2.7.0',rebuildDetail:rebuildDetailV27};
})();
</script>


<!-- JM V2.7.1 · Notificaciones premium -->
<style id="jmv271-notice-style">
.toastbox{position:fixed;left:14px;right:14px;bottom:18px;display:grid;gap:10px;z-index:2200;pointer-events:none}
.toast{pointer-events:auto;display:flex;align-items:flex-start;gap:12px;padding:13px 15px;border-radius:18px;border:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(12,24,39,.96),rgba(8,18,31,.98));box-shadow:0 16px 34px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.04);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:#edf8ff;font-size:.92rem;line-height:1.45;transform:translateY(0);overflow:hidden;position:relative}
.toast::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:rgba(34,223,243,.95)}
.toast.success::before{background:linear-gradient(180deg,#3ef18e,#1ac86c)}
.toast.warn::before{background:linear-gradient(180deg,#ffd56a,#ffb01e)}
.toast.error::before{background:linear-gradient(180deg,#ff8b8b,#ff4d6d)}
.toast.info::before{background:linear-gradient(180deg,#53ddff,#2ab8ff)}
.toast strong{display:block;font-size:.82rem;line-height:1.1;margin-bottom:2px;color:#fff;font-weight:900;letter-spacing:.02em}
.toast small{display:block;color:#94aac2;font-size:.72rem;margin-top:2px}
.jmv271-toast-icon{width:38px;height:38px;border-radius:14px;flex:0 0 38px;display:grid;place-items:center;background:radial-gradient(circle at 30% 20%,rgba(34,223,243,.2),rgba(34,223,243,.06) 62%,rgba(255,255,255,.02) 100%);border:1px solid rgba(34,223,243,.14);font-size:1rem;color:#24def4;font-weight:900}
.toast.success .jmv271-toast-icon{background:radial-gradient(circle at 30% 20%,rgba(52,221,124,.23),rgba(52,221,124,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(52,221,124,.18);color:#38de83}
.toast.warn .jmv271-toast-icon{background:radial-gradient(circle at 30% 20%,rgba(255,195,74,.22),rgba(255,195,74,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(255,195,74,.18);color:#ffcb54}
.toast.error .jmv271-toast-icon{background:radial-gradient(circle at 30% 20%,rgba(255,103,129,.2),rgba(255,103,129,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(255,103,129,.17);color:#ff7491}
.jmv271-toast-copy{min-width:0;flex:1 1 auto}
.jmv271-toast-close{margin-left:auto;align-self:center;width:32px;height:32px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:#b3c2d3;display:grid;place-items:center;font-size:1rem;cursor:pointer}
.jmv271-toast-close:hover{color:#fff;border-color:rgba(34,223,243,.24)}
#jmNoticeOverlay{position:fixed;inset:0;background:rgba(3,8,15,.66);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:18px;z-index:2600}
#jmNoticeOverlay.open{display:flex}
.jm-notice{width:min(100%,460px);background:linear-gradient(180deg,rgba(8,20,35,.98),rgba(6,16,28,.985));border:1px solid rgba(34,223,243,.16);border-radius:26px;box-shadow:0 26px 70px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.04);overflow:hidden;color:#edf8ff}
.jm-notice-head{display:flex;align-items:flex-start;gap:14px;padding:18px 18px 14px;border-bottom:1px solid rgba(34,223,243,.08)}
.jm-notice-badge{width:48px;height:48px;flex:0 0 48px;border-radius:17px;display:grid;place-items:center;background:radial-gradient(circle at 30% 20%,rgba(34,223,243,.21),rgba(34,223,243,.07) 62%,rgba(255,255,255,.02) 100%);border:1px solid rgba(34,223,243,.17);color:#24def4;font-size:1.15rem;font-weight:900}
.jm-notice.warn .jm-notice-badge{background:radial-gradient(circle at 30% 20%,rgba(255,202,92,.22),rgba(255,202,92,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(255,202,92,.18);color:#ffcd66}
.jm-notice.error .jm-notice-badge{background:radial-gradient(circle at 30% 20%,rgba(255,114,139,.22),rgba(255,114,139,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(255,114,139,.18);color:#ff7691}
.jm-notice.success .jm-notice-badge{background:radial-gradient(circle at 30% 20%,rgba(58,227,132,.22),rgba(58,227,132,.08) 62%,rgba(255,255,255,.02) 100%);border-color:rgba(58,227,132,.18);color:#47e28f}
.jm-notice-headcopy{min-width:0;flex:1 1 auto}
.jm-notice-headcopy h3{margin:2px 0 4px;font-size:1.2rem;line-height:1.15;color:#fff;font-weight:900}
.jm-notice-headcopy p{margin:0;color:#8ea6be;font-size:.82rem;line-height:1.45}
.jm-notice-close{width:40px;height:40px;border-radius:15px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:#c0cedc;display:grid;place-items:center;font-size:1.05rem;cursor:pointer;flex:0 0 40px}
.jm-notice-body{padding:18px 18px 8px;font-size:1rem;line-height:1.62;color:#eef7ff}
.jm-notice-body p{margin:0}
.jm-notice-actions{padding:14px 18px 18px;display:flex;justify-content:flex-end;gap:10px}
.jm-notice-btn{min-height:46px;padding:0 20px;border-radius:16px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:#eff7ff;font-size:.95rem;font-weight:800;cursor:pointer}
.jm-notice-btn.primary{background:linear-gradient(135deg,#26e0f4,#3098ff);border-color:transparent;color:#04101d;box-shadow:0 10px 26px rgba(27,152,255,.25)}
.jm-notice-btn:hover,.jm-notice-close:hover,.jmv271-toast-close:hover{transform:translateY(-1px)}
@media (max-width:560px){
  .jm-notice{border-radius:24px}
  .jm-notice-head{padding:16px 16px 12px}
  .jm-notice-body{padding:16px 16px 6px;font-size:.98rem}
  .jm-notice-actions{padding:12px 16px 16px}
  .jm-notice-btn{flex:1 1 auto}
  .toastbox{left:12px;right:12px;bottom:14px}
  .toast{padding:12px 13px;border-radius:17px;font-size:.88rem}
}
</style>
<script id="jmv271-notice-script">
(()=>{
  const D=document;
  const ICONS={success:'✓',warn:'!',error:'✕',info:'i'};
  const TITLES={success:'Listo',warn:'Atención',error:'Algo salió mal',info:'Aviso'};
  function ensureNotice(){
    let overlay=D.getElementById('jmNoticeOverlay');
    if(overlay) return overlay;
    overlay=D.createElement('div');
    overlay.id='jmNoticeOverlay';
    overlay.innerHTML=`<div class="jm-notice info" role="alertdialog" aria-modal="true" aria-labelledby="jmNoticeTitle" aria-describedby="jmNoticeMessage">
      <div class="jm-notice-head">
        <div class="jm-notice-badge" id="jmNoticeBadge">i</div>
        <div class="jm-notice-headcopy"><h3 id="jmNoticeTitle">Aviso</h3><p id="jmNoticeSubtitle">Mensaje del sistema</p></div>
        <button type="button" class="jm-notice-close" id="jmNoticeClose" aria-label="Cerrar">✕</button>
      </div>
      <div class="jm-notice-body"><p id="jmNoticeMessage"></p></div>
      <div class="jm-notice-actions"><button type="button" class="jm-notice-btn primary" id="jmNoticeOk">Entendido</button></div>
    </div>`;
    D.body.appendChild(overlay);
    const close=()=>overlay.classList.remove('open');
    overlay.addEventListener('click',e=>{if(e.target===overlay) close();});
    overlay.querySelector('#jmNoticeClose').addEventListener('click',close);
    overlay.querySelector('#jmNoticeOk').addEventListener('click',close);
    return overlay;
  }
  function prettyNotice(message,opts={}){
    const overlay=ensureNotice();
    const type=(opts.type||'info');
    const box=overlay.querySelector('.jm-notice');
    box.className=`jm-notice ${type}`;
    overlay.querySelector('#jmNoticeBadge').textContent=opts.icon || ICONS[type] || 'i';
    overlay.querySelector('#jmNoticeTitle').textContent=opts.title || TITLES[type] || 'Aviso';
    overlay.querySelector('#jmNoticeSubtitle').textContent=opts.subtitle || 'Mensaje del sistema';
    overlay.querySelector('#jmNoticeMessage').textContent=String(message||'');
    overlay.querySelector('#jmNoticeOk').textContent=opts.confirmText || 'Entendido';
    overlay.classList.add('open');
    return new Promise(resolve=>{
      const done=()=>{overlay.classList.remove('open');cleanup();resolve(true)};
      const ok=overlay.querySelector('#jmNoticeOk');
      const close=overlay.querySelector('#jmNoticeClose');
      const onOverlay=(e)=>{if(e.target===overlay) done()};
      const onKey=(e)=>{if(e.key==='Escape'||e.key==='Enter') done()};
      function cleanup(){ok.removeEventListener('click',done);close.removeEventListener('click',done);overlay.removeEventListener('click',onOverlay);D.removeEventListener('keydown',onKey,true)}
      ok.addEventListener('click',done,{once:true});
      close.addEventListener('click',done,{once:true});
      overlay.addEventListener('click',onOverlay);
      D.addEventListener('keydown',onKey,true);
      setTimeout(()=>ok.focus(),30);
    });
  }
  function patchToast(){
    if(typeof window.toast!=='function') return;
    const base=window.toast;
    window.toast=function(message,type='info'){
      try{
        const host=(typeof document.getElementById==='function' && document.getElementById('toastbox')) || (()=>{const d=document.createElement('div');d.id='toastbox';d.className='toastbox';document.body.appendChild(d);return d;})();
        const icons={success:'✓',warn:'!',error:'✕',info:'i'};
        const labels={success:'Correcto',warn:'Atención',error:'Error',info:'Aviso'};
        const el=document.createElement('div');
        el.className=`toast ${type}`;
        el.innerHTML=`<div class="jmv271-toast-icon">${icons[type]||'i'}</div><div class="jmv271-toast-copy"><strong>${labels[type]||'Aviso'}</strong><span>${String(message||'')}</span></div><button type="button" class="jmv271-toast-close" aria-label="Cerrar">✕</button>`;
        host.appendChild(el);
        const remove=()=>{el.style.opacity='0';el.style.transform='translateY(8px)';setTimeout(()=>el.remove(),180)};
        el.querySelector('.jmv271-toast-close').addEventListener('click',remove,{once:true});
        setTimeout(remove,3200);
        return el;
      }catch(e){return base(message,type)}
    }
  }
  window.npAlert = function(message,title='Aviso',type='info',subtitle='Mensaje del sistema'){return prettyNotice(message,{title,type,subtitle});};
  window.alert = function(message){ return prettyNotice(message,{title:'Atención',type:'warn',subtitle:'Revisa la información para continuar'}); };
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',patchToast,{once:true}); else patchToast();
})();
</script>


<!-- JM V2.7.2 · Notificaciones top premium -->
<style id="jmv272-notice-style">
#toastbox{display:none!important}
#jmToastViewport{position:fixed!important;left:50%!important;top:max(10px,calc(env(safe-area-inset-top) + 8px))!important;transform:translateX(-50%)!important;width:min(92vw,380px)!important;display:grid!important;gap:10px!important;z-index:2147483200!important;pointer-events:none!important}
.jm-toast-card{pointer-events:auto!important;position:relative!important;display:grid!important;grid-template-columns:40px minmax(0,1fr) auto!important;align-items:start!important;gap:11px!important;padding:12px 12px 12px 13px!important;border-radius:18px!important;border:1px solid rgba(255,255,255,.085)!important;background:linear-gradient(180deg,rgba(10,22,37,.97),rgba(7,16,29,.985))!important;box-shadow:0 18px 46px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.04)!important;backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;overflow:hidden!important;opacity:0!important;transform:translateY(-10px) scale(.985)!important;animation:jmToastEnter .24s ease forwards!important}
.jm-toast-card::before{content:''!important;position:absolute!important;left:0!important;top:0!important;bottom:0!important;width:4px!important;background:linear-gradient(180deg,#53ddff,#2ab8ff)!important}
.jm-toast-card.success::before{background:linear-gradient(180deg,#42ec95,#21c46f)!important}
.jm-toast-card.warn::before{background:linear-gradient(180deg,#ffd56a,#ffb026)!important}
.jm-toast-card.error::before{background:linear-gradient(180deg,#ff909f,#ff5578)!important}
.jm-toast-card.info::before{background:linear-gradient(180deg,#5ae5ff,#30a0ff)!important}
@keyframes jmToastEnter{to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes jmToastExit{to{opacity:0;transform:translateY(-8px) scale(.985)}}
.jm-toast-icon{width:40px!important;height:40px!important;border-radius:14px!important;display:grid!important;place-items:center!important;font-size:1rem!important;font-weight:900!important;color:#dff9ff!important;border:1px solid rgba(255,255,255,.08)!important;background:radial-gradient(circle at 30% 20%,rgba(74,219,255,.2),rgba(74,219,255,.07) 62%,rgba(255,255,255,.02) 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.04)!important}
.jm-toast-card.success .jm-toast-icon{color:#49ea93!important;background:radial-gradient(circle at 30% 20%,rgba(73,234,147,.18),rgba(73,234,147,.07) 62%,rgba(255,255,255,.02) 100%)!important;border-color:rgba(73,234,147,.18)!important}
.jm-toast-card.warn .jm-toast-icon{color:#ffd164!important;background:radial-gradient(circle at 30% 20%,rgba(255,209,100,.18),rgba(255,209,100,.07) 62%,rgba(255,255,255,.02) 100%)!important;border-color:rgba(255,209,100,.18)!important}
.jm-toast-card.error .jm-toast-icon{color:#ff7f9a!important;background:radial-gradient(circle at 30% 20%,rgba(255,127,154,.18),rgba(255,127,154,.07) 62%,rgba(255,255,255,.02) 100%)!important;border-color:rgba(255,127,154,.18)!important}
.jm-toast-copy{min-width:0!important;padding-top:1px!important}
.jm-toast-copy strong{display:block!important;margin:0 0 2px!important;font-size:.93rem!important;line-height:1.1!important;font-weight:900!important;color:#fff!important;letter-spacing:.01em!important}
.jm-toast-copy span{display:block!important;font-size:.82rem!important;line-height:1.42!important;color:#dce8f5!important}
.jm-toast-close{width:30px!important;height:30px!important;border-radius:11px!important;border:1px solid rgba(255,255,255,.07)!important;background:rgba(255,255,255,.03)!important;color:#aebfd1!important;font-size:.95rem!important;display:grid!important;place-items:center!important;cursor:pointer!important;align-self:center!important}
.jm-toast-close:hover{color:#fff!important;border-color:rgba(34,223,243,.22)!important}
#jmNoticeOverlay{z-index:2147483600!important;background:rgba(3,8,16,.55)!important;backdrop-filter:blur(7px)!important;-webkit-backdrop-filter:blur(7px)!important}
#jmNoticeOverlay .jm-notice{width:min(92vw,410px)!important;border-radius:24px!important;border:1px solid rgba(34,223,243,.14)!important;background:linear-gradient(180deg,rgba(8,20,35,.98),rgba(7,16,28,.99))!important;box-shadow:0 22px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.04)!important}
#jmNoticeOverlay .jm-notice-head{padding:15px 15px 12px!important;gap:12px!important}
#jmNoticeOverlay .jm-notice-badge{width:44px!important;height:44px!important;flex-basis:44px!important;border-radius:15px!important;font-size:1rem!important}
#jmNoticeOverlay .jm-notice-headcopy h3{margin:2px 0 3px!important;font-size:1.05rem!important;line-height:1.1!important}
#jmNoticeOverlay .jm-notice-headcopy p{font-size:.78rem!important;line-height:1.35!important}
#jmNoticeOverlay .jm-notice-close{width:38px!important;height:38px!important;border-radius:14px!important}
#jmNoticeOverlay .jm-notice-body{padding:14px 15px 5px!important;font-size:.97rem!important;line-height:1.52!important}
#jmNoticeOverlay .jm-notice-actions{padding:11px 15px 15px!important}
#jmNoticeOverlay .jm-notice-btn{min-height:42px!important;border-radius:14px!important;font-size:.9rem!important;padding:0 16px!important}
@media (max-width:560px){
  #jmToastViewport{width:min(94vw,360px)!important;top:max(8px,calc(env(safe-area-inset-top) + 6px))!important}
  .jm-toast-card{padding:11px 11px 11px 12px!important;border-radius:17px!important;grid-template-columns:38px minmax(0,1fr) 28px!important;gap:10px!important}
  .jm-toast-icon{width:38px!important;height:38px!important;border-radius:13px!important}
  .jm-toast-copy strong{font-size:.88rem!important}
  .jm-toast-copy span{font-size:.79rem!important}
  #jmNoticeOverlay .jm-notice{width:min(92vw,392px)!important}
}
</style>
<script id="jmv272-notice-script">
(()=>{
  const D=document;
  const ICONS={success:'✓',warn:'!',error:'✕',info:'i'};
  const LABELS={success:'Correcto',warn:'Atención',error:'Error',info:'Aviso'};
  function ensureToastViewport(){
    let el=D.getElementById('jmToastViewport');
    if(el) return el;
    el=D.createElement('div');
    el.id='jmToastViewport';
    D.body.appendChild(el);
    return el;
  }
  function dismissToast(card){
    if(!card || card.dataset.closing==='1') return;
    card.dataset.closing='1';
    card.style.animation='jmToastExit .18s ease forwards';
    setTimeout(()=>{try{card.remove()}catch(e){}},180);
  }
  function installTopToast(){
    const impl=function(message,type='info'){
      const host=ensureToastViewport();
      const text=String(message??'').trim();
      if(!text) return null;
      const old=[...host.querySelectorAll('.jm-toast-card')].find(x=>x.dataset.message===text && x.dataset.type===String(type));
      if(old){ clearTimeout(old._timer); old._timer=setTimeout(()=>dismissToast(old),2600); return old; }
      const card=D.createElement('div');
      card.className=`jm-toast-card ${type}`;
      card.dataset.message=text;
      card.dataset.type=String(type);
      card.setAttribute('role','status');
      card.setAttribute('aria-live','polite');
      card.innerHTML=`<div class="jm-toast-icon">${ICONS[type]||'i'}</div><div class="jm-toast-copy"><strong>${LABELS[type]||'Aviso'}</strong><span>${text}</span></div><button type="button" class="jm-toast-close" aria-label="Cerrar">✕</button>`;
      card.querySelector('.jm-toast-close').addEventListener('click',()=>dismissToast(card),{once:true});
      host.appendChild(card);
      card._timer=setTimeout(()=>dismissToast(card),2600);
      return card;
    };
    try{ window.toast=impl; toast=impl; }catch(e){ window.toast=impl; }
  }
  function upgradeNotice(){
    if(typeof window.npAlert!=='function') return;
    const base=window.npAlert;
    const wrapped=function(message,title='Aviso',type='info',subtitle='Mensaje del sistema'){
      const p=base(message,title,type,subtitle);
      const overlay=D.getElementById('jmNoticeOverlay');
      if(overlay){
        overlay.style.zIndex='2147483600';
        const btn=overlay.querySelector('#jmNoticeOk');
        if(btn && type==='success') btn.textContent='Perfecto';
      }
      return p;
    };
    try{ window.npAlert=wrapped; npAlert=wrapped; }catch(e){ window.npAlert=wrapped; }
    const nativeAlert=function(message){ return wrapped(message,'Atención','warn','Revisa la información para continuar'); };
    try{ window.alert=nativeAlert; alert=nativeAlert; }catch(e){ window.alert=nativeAlert; }
  }
  function init(){ installTopToast(); upgradeNotice(); }
  if(D.readyState==='loading') D.addEventListener('DOMContentLoaded',init,{once:true}); else init();
})();
</script>


