</style>
<script id="jmv351-detail-compact-script">
(()=>{
'use strict';
const D=document;
function refineDetailCompact351(){
  const serviceSub=D.querySelector('#detailModal .jmv27-section-head span');
  if(serviceSub) serviceSub.textContent='Resumen rápido';
  const reqTitle=D.querySelector('#detailModal .jmv2-requirements>b');
  if(reqTitle && /Datos que se solicitarán/i.test(reqTitle.textContent)){
    reqTitle.textContent='Datos necesarios para activar el servicio';
  }
}
const previousOpenDetail351=window.openDetail;
function openDetailV351(id){
  if(typeof previousOpenDetail351==='function') previousOpenDetail351(id);
  setTimeout(refineDetailCompact351,40);
}
try{window.openDetail=openDetailV351;openDetail=openDetailV351}catch(e){}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(refineDetailCompact351,40),{once:true});
else setTimeout(refineDetailCompact351,40);
window.JM_DIGITAL_STORE_V351={VERSION:'3.5.1',refineDetailCompact:refineDetailCompact351};
})();
</script>


<!-- JM V3.5.2 · Chatbot específico por producto -->
<style id="jmv352-product-chatbot-style">
.jmv352-bot-field{grid-column:1/-1!important;padding:10px!important;border:1px solid rgba(34,223,243,.11)!important;border-radius:12px!important;background:linear-gradient(135deg,rgba(34,223,243,.035),rgba(255,255,255,.014))!important}
.jmv352-bot-field label{display:flex!important;align-items:center!important;gap:7px!important;color:#dff7fb!important}
.jmv352-bot-field label::before{content:'💬';font-size:.8rem}
.jmv352-bot-field small{display:block;margin-top:5px;color:var(--muted);font-size:.50rem;line-height:1.4}
.jmv352-bot-grid{display:grid;gap:7px;margin-top:9px}
.jmv352-bot-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;align-items:center;padding:9px 10px;border:1px solid var(--jmv2-line);border-radius:11px;background:rgba(255,255,255,.018)}
.jmv352-bot-row h3{margin:0;font-size:.62rem;color:var(--text)}
.jmv352-bot-row p{margin:3px 0 0;font-size:.51rem;color:var(--muted);overflow-wrap:anywhere;line-height:1.35}
.jmv352-bot-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:5px}
.jmv352-bot-status{display:inline-flex;align-items:center;gap:5px;margin-top:5px;padding:3px 7px;border-radius:999px;font-size:.47rem;font-weight:900;border:1px solid rgba(255,181,71,.12);background:rgba(255,181,71,.055);color:#ffd47b}
.jmv352-bot-status.ok{border-color:rgba(57,223,124,.12);background:rgba(57,223,124,.055);color:#8ff0b4}
@media(max-width:620px){.jmv352-bot-row{grid-template-columns:1fr}.jmv352-bot-actions{justify-content:flex-start}.jmv352-bot-actions>*{flex:1 1 120px}}
</style>
<script id="jmv352-product-chatbot-script">
(()=>{
'use strict';
const D=document;
const V='3.5.2';
const $352=id=>D.getElementById(id);
const esc352=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const getProducts352=()=>Array.isArray(globalThis.state?.products)?globalThis.state.products:[];
function botUrl352(raw){
  const value=String(raw||'').trim();
  if(!value)return '';
  try{
    const u=new URL(value);
    if(!['https:','http:'].includes(u.protocol))return '';
    return u.toString();
  }catch(e){return ''}
}
function productById352(id){return getProducts352().find(p=>String(p.id)===String(id))||null}
function productByName352(name){const n=String(name||'').trim().toLowerCase();return getProducts352().find(p=>String(p.name||'').trim().toLowerCase()===n)||null}
function saveProducts352(){
  try{if(typeof write==='function'&&globalThis.KEYS?.products)return write(KEYS.products,state.products)}catch(e){}
  try{localStorage.setItem(globalThis.KEYS?.products||'jm_digital_products',JSON.stringify(state.products));return true}catch(e){return false}
}
function openProductChat352(product){
  if(!product)return false;
  const direct=botUrl352(product.chatbotUrl||product.productBotUrl||'');
  if(direct){
    try{
      const w=window.open(direct,'_blank','noopener,noreferrer');
      if(w){try{w.opener=null}catch(e){};return true}
      location.assign(direct);return true;
    }catch(e){console.warn('Product chatbot',e)}
  }
  try{if(typeof toast==='function')toast('Este producto todavía no tiene un Typebot configurado.','warn')}catch(e){}
  return false;
}

/* El botón verde de cada tarjeta abre exclusivamente el Typebot asignado a ese producto. */
D.addEventListener('click',e=>{
  const b=e.target?.closest?.('[data-support]');
  if(!b)return;
  const p=productById352(b.dataset.support);
  if(!p)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  openProductChat352(p);
},true);

/* El botón "Abrir chat" dentro del detalle usa el mismo chatbot específico. */
const previousOpenDetail352=window.openDetail;
function openDetail352(id){
  const result=typeof previousOpenDetail352==='function'?previousOpenDetail352(id):undefined;
  setTimeout(()=>{
    const p=productById352(id),btn=$352('detailSupport');
    if(btn&&p){btn.textContent='Consultar bot';btn.onclick=e=>{e?.preventDefault?.();openProductChat352(p)}}
  },70);
  return result;
}
try{window.openDetail=openDetail352;openDetail=openDetail352}catch(e){}

/* Añade el enlace del bot al editor definitivo sin alterar los demás campos. */
const previousEditor352=window.openProductEditor||window.JM_DIGITAL_STORE_V2?.openServiceEditor;
function enhanceEditor352(id,existingIds){
  const form=$352('jmv2ServiceForm')||$352('jmServiceForm');
  if(!form||form.querySelector('#jmv352ChatbotUrl'))return;
  const original=id?productById352(id):null;
  const field=D.createElement('div');
  field.className='jmv2-field jmv352-bot-field';
  field.innerHTML=`<label for="jmv352ChatbotUrl">Typebot del producto</label><input id="jmv352ChatbotUrl" type="url" inputmode="url" autocomplete="off" placeholder="https://..." value="${esc352(original?.chatbotUrl||original?.productBotUrl||'')}"><small>Pega aquí la URL pública del Typebot creado específicamente para este producto. El botón verde abrirá directamente ese bot. Si se deja vacío, el botón avisará que el producto todavía no tiene Typebot configurado.</small>`;
  const description=form.querySelector('#jmv2Description,#jmPfDesc');
  const target=description?.closest('.jmv2-field,.jm-field')||description?.parentElement;
  if(target)target.before(field);else form.querySelector('.jmv2-form-grid,.jm-form-grid')?.appendChild(field);
  const oldSubmit=form.onsubmit;
  form.onsubmit=function(e){
    const raw=String($352('jmv352ChatbotUrl')?.value||'').trim();
    const clean=botUrl352(raw);
    if(raw&&!clean){
      e?.preventDefault?.();
      try{if(typeof toast==='function')toast('La URL del Typebot debe ser válida y empezar con http:// o https://.','warn')}catch(_){}
      $352('jmv352ChatbotUrl')?.focus();
      return false;
    }
    if(original)original.chatbotUrl=clean;
    const result=typeof oldSubmit==='function'?oldSubmit.call(this,e):undefined;
    if(!original){
      const created=getProducts352().find(p=>!existingIds.has(String(p.id)));
      if(created){created.chatbotUrl=clean;saveProducts352()}
    }else saveProducts352();
    return result;
  };
}
function openProductEditor352(id=null){
  if(typeof previousEditor352!=='function')return false;
  const existingIds=new Set(getProducts352().map(p=>String(p.id)));
  const result=previousEditor352(id);
  setTimeout(()=>enhanceEditor352(id,existingIds),20);
  return result;
}
if(typeof previousEditor352==='function'){
  try{window.openProductEditor=openProductEditor352;openProductEditor=openProductEditor352}catch(e){}
  try{if(window.JM_DIGITAL_STORE_V2)window.JM_DIGITAL_STORE_V2.openServiceEditor=openProductEditor352}catch(e){}
}

/* También intercepta botones de edición V2 que llaman directamente al editor interno. */
D.addEventListener('click',e=>{
  const b=e.target?.closest?.('[data-v2edit],[data-v2editavail]');
  if(!b)return;
  const id=b.dataset.v2edit||b.dataset.v2editavail;
  setTimeout(()=>enhanceEditor352(id,new Set(getProducts352().map(p=>String(p.id)))),35);
},true);

function botManagementMarkup352(){
  const products=getProducts352().slice().sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'es'));
  return `<section class="jmv2-admin-card" id="jmv352ProductBots"><div class="jmv2-card-head"><div><h2>Typebots por producto</h2><p>Cada servicio abre directamente su propio Typebot, preparado para responder preguntas específicas sobre ese producto.</p></div></div><div class="jmv352-bot-grid">${products.map(p=>{const url=botUrl352(p.chatbotUrl||p.productBotUrl||'');return `<article class="jmv352-bot-row"><div><h3>${esc352(p.name||'Producto')}</h3><p>${url?esc352(url):'Sin Typebot asignado.'}</p><span class="jmv352-bot-status ${url?'ok':''}">${url?'● Typebot configurado':'○ Typebot pendiente'}</span></div><div class="jmv352-bot-actions"><button type="button" class="jmv2-btn" data-jmv352-edit="${esc352(p.id)}">Editar producto</button>${url?`<button type="button" class="jmv2-btn green" data-jmv352-test="${esc352(p.id)}">Probar Typebot</button>`:''}</div></article>`}).join('')||'<div class="jmv2-empty">No hay productos creados.</div>'}</div></section>`;
}
function injectBotManagement352(){
  const content=$352('adminContent');
  if(!content||$352('jmv352ProductBots'))return;
  content.insertAdjacentHTML('beforeend',botManagementMarkup352());
  content.querySelectorAll('[data-jmv352-edit]').forEach(b=>b.onclick=()=>openProductEditor352(b.dataset.jmv352Edit));
  content.querySelectorAll('[data-jmv352-test]').forEach(b=>b.onclick=()=>openProductChat352(productById352(b.dataset.jmv352Test)));
}

/* Amplía la sección Mensajes/Atención con administración de bots por producto. */
const previousRenderAdmin352=window.renderAdminSection;
function renderAdminSection352(section){
  const result=typeof previousRenderAdmin352==='function'?previousRenderAdmin352(section):undefined;
  const s=String(section||'').toLowerCase();
  if(['messages','bots','atencion','atención'].includes(s))setTimeout(injectBotManagement352,25);
  return result;
}
if(typeof previousRenderAdmin352==='function'){
  try{window.renderAdminSection=renderAdminSection352;renderAdminSection=renderAdminSection352}catch(e){}
}

window.JM_DIGITAL_STORE_V352={VERSION:V,openProductChat:openProductChat352,botUrl:botUrl352,injectBotManagement:injectBotManagement352};
console.info('CRULOX · V3.5.2 chatbot por producto loaded');
})();
</script>


<!-- JM V3.5.3 · Detalle compacto final + borrado de notificaciones -->
<style id="jmv353-detail-notification-style">
/* Detalle del producto: quitar línea decorativa y compactar servicio */
