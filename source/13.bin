  #detailModal .jmv27-head h2{font-size:.95rem!important;line-height:1.14!important}
  #detailModal .jmv27-offer .price-row .price{font-size:1.22rem!important}
  #detailModal .jmv27-offer .jmv27-description{font-size:.58rem!important;line-height:1.45!important}
  #detailModal .jmv2-digital-facts{gap:5px!important}
  #detailModal .jmv2-fact{
    min-height:42px!important;
