}

@media (max-width:400px){
  .search{padding-right:34px!important}
  #detailModal .jmv2-fact{
    grid-template-columns:22px 78px minmax(0,1fr)!important;
    padding:7px 7px!important;
  }
  #detailModal .jmv2-fact small{font-size:.44rem!important}
  #detailModal .jmv2-fact b{font-size:.53rem!important}
}
</style>

<script id="jmv31-detail-search-script">
(()=>{
  const D=document;
  const byId=id=>D.getElementById(id);
  function applyPublicSearchRefine(){
    const search=byId('searchInput');
    if(search){
      search.placeholder='Buscar productos';
      search.setAttribute('aria-label','Buscar productos');
    }
  }
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',applyPublicSearchRefine,{once:true});
  else applyPublicSearchRefine();
})();
</script>


