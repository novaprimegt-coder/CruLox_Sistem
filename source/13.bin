<script id="jmv356-products-purchases-script">
(()=>{
'use strict';
const D=document,$356=id=>D.getElementById(id);
const esc356=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeWrite356=(key,value)=>{try{if(typeof write==='function')return write(key,value)!==false;localStorage.setItem(key,JSON.stringify(value));return true}catch(e){return false}};
const notify356=(m,t='info')=>{try{if(typeof toast==='function')toast(m,t)}catch(e){}};
const date356=v=>{if(!v)return '—';try{return new Date(v).toLocaleDateString('es-GT',{day:'2-digit',month:'short',year:'numeric'})}catch(e){return String(v)}};
const dateTime356=v=>{if(!v)return '—';try{return new Date(v).toLocaleString('es-GT',{dateStyle:'medium',timeStyle:'short'})}catch(e){return String(v)}};
const currentUser356=()=>{try{return typeof currentUser==='function'?currentUser():null}catch(e){return null}};
function currentUserOrders356(){const u=currentUser356();if(!u)return[];return (state?.orders||[]).filter(o=>String(o.userId||'')===String(u.id)||String(o.customer?.email||'').trim().toLowerCase()===String(u.email||'').trim().toLowerCase())}
function confirmedPurchases356(){return currentUserOrders356().filter(o=>o?.customerDelivery?.confirmed===true).sort((a,b)=>Date.parse(b.customerDelivery?.confirmedAt||b.updatedAt||0)-Date.parse(a.customerDelivery?.confirmedAt||a.updatedAt||0))}
function itemServiceValue356(item,pattern){const rows=Array.isArray(item?.serviceData)?item.serviceData:[];const found=rows.find(x=>pattern.test(String(x.label||'')));return found?.value||''}
function defaultDestination356(item){return itemServiceValue356(item,/\bid\b|jugador|cuenta|player/i)}
function ensurePublicPurchasesUi356(){
  const hero=D.querySelector('.hero-actions');
  const support=$356('heroSupport');
  if(hero&&support&&!$356('jmMyPurchasesBtn')){
    hero.classList.add('jmv356-hero-actions');
    const b=D.createElement('button');b.type='button';b.id='jmMyPurchasesBtn';b.textContent='Mis compras';
    support.after(b);b.onclick=openMyPurchases356;
  }
  if(!$356('jmMyPurchasesOverlay')){
    const overlay=D.createElement('div');overlay.id='jmMyPurchasesOverlay';
