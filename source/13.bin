<!-- JM V3.1 · Detalle compacto + buscador refinado -->
<style id="jmv31-detail-search-style">
/* ===== Buscador público más limpio y con menos texto ===== */
.search-wrap{
  position:relative!important;
  display:flex!important;
  align-items:center!important;
  min-height:44px!important;
  border-radius:18px!important;
  border:1px solid rgba(119,207,236,.10)!important;
  background:linear-gradient(180deg,rgba(8,17,29,.96),rgba(7,14,24,.98))!important;
  box-shadow:0 10px 28px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.02)!important;
  overflow:hidden!important;
}
.search-wrap::before,
.search-wrap::after{display:none!important;content:none!important}
.search{
  width:100%!important;
  height:44px!important;
  min-height:44px!important;
  padding:0 40px 0 36px!important;
  border:0!important;
  border-radius:18px!important;
  background:transparent!important;
  color:#ecf8ff!important;
  font-size:.76rem!important;
  line-height:1!important;
  box-shadow:none!important;
}
.search::placeholder{
  color:#7f93a8!important;
  opacity:1!important;
  font-size:.72rem!important;
}
.search:focus{
  outline:0!important;
  border:0!important;
  box-shadow:inset 0 0 0 1px rgba(34,223,243,.26), 0 0 0 3px rgba(34,223,243,.045)!important;
}
.search-icon{
  left:14px!important;
  font-size:.8rem!important;
  color:#5fdff3!important;
  opacity:.92!important;
}
.search-clear{
  right:9px!important;
  width:28px!important;
  height:28px!important;
  border-radius:10px!important;
  border:1px solid rgba(255,255,255,.06)!important;
  background:rgba(255,255,255,.03)!important;
  color:#93a7b8!important;
  display:grid!important;
  place-items:center!important;
  font-size:.62rem!important;
}
.search-clear:not(.show){display:none!important}
.search-clear.show{display:grid!important}
.search-clear:hover{color:#fff!important;border-color:rgba(34,223,243,.2)!important}
.suggestions{
  top:calc(100% + 7px)!important;
  padding:6px!important;
  border-radius:14px!important;
  background:rgba(7,15,25,.985)!important;
  border:1px solid rgba(34,223,243,.11)!important;
  box-shadow:0 16px 34px rgba(0,0,0,.32)!important;
}
.suggestion{
  grid-template-columns:34px minmax(0,1fr) auto!important;
  gap:8px!important;
  padding:7px!important;
  border-radius:10px!important;
}
.suggestion img{width:34px!important;height:34px!important;border-radius:8px!important}
.suggestion b{font-size:.66rem!important}
.suggestion small{font-size:.53rem!important}
.suggestion strong{font-size:.61rem!important}

/* ===== Detalle de producto más compacto y elegante ===== */
#detailModal .jmv27-service{
  gap:7px!important;
}
#detailModal .jmv27-section-head{
  padding:0 2px 1px!important;
  margin-top:1px!important;
}
#detailModal .jmv27-section-head h3{
  font-size:.68rem!important;
  letter-spacing:0!important;
}
#detailModal .jmv27-section-head span{
  display:none!important; /* quita texto extra */
}
#detailModal .jmv2-digital-facts{
  grid-template-columns:1fr!important;
  gap:6px!important;
}
#detailModal .jmv2-fact{
  min-height:46px!important;
  padding:8px 10px!important;
  border-radius:14px!important;
  grid-template-columns:26px 92px minmax(0,1fr)!important;
  grid-template-rows:1fr!important;
  align-items:center!important;
  column-gap:9px!important;
  background:linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,.015))!important;
}
#detailModal .jmv2-fact .jmv27-fact-icon{
  grid-row:auto!important;
  width:26px!important;
  height:26px!important;
  border-radius:9px!important;
  font-size:.64rem!important;
}
#detailModal .jmv2-fact small{
  margin:0!important;
  font-size:.50rem!important;
  line-height:1.1!important;
  color:#7990a2!important;
}
#detailModal .jmv2-fact b{
  margin:0!important;
  font-size:.60rem!important;
  line-height:1.18!important;
  color:#eef8ff!important;
  text-align:left!important;
}
#detailModal .jmv2-requirements{
  margin-top:2px!important;
  padding:10px 11px!important;
  border-radius:14px!important;
}
#detailModal .jmv2-requirements>b{
  font-size:.58rem!important;
  line-height:1.28!important;
}
#detailModal .jmv2-requirements>b::before{
  width:20px!important;
  height:20px!important;
  border-radius:7px!important;
  font-size:.56rem!important;
}
#detailModal .jmv2-requirements ul{
  margin-top:6px!important;
  gap:3px!important;
  font-size:.53rem!important;
  line-height:1.32!important;
}
#detailModal .jmv2-requirements li{padding-left:11px!important}
#detailModal .jmv2-requirements>div{
  margin-top:6px!important;
  padding-top:6px!important;
  font-size:.49rem!important;
}
#detailModal .jmv27-actions{
  gap:7px!important;
  margin-top:2px!important;
}
#detailModal .jmv27-actions .btn{
  min-height:38px!important;
  border-radius:13px!important;
}

@media (min-width:761px){
  #detailModal .jmv27-detail,
  #detailModal .product-detail.jmv27-detail{
    grid-template-columns:minmax(250px,300px) minmax(0,1fr)!important;
