}
#detailModal .jmv2-fact:first-child{border-top:0!important}
#detailModal .jmv2-fact::after{display:none!important;content:none!important}
#detailModal .jmv2-fact .jmv27-fact-icon{
  width:22px!important;
  height:22px!important;
  border-radius:7px!important;
  font-size:.56rem!important;
}
#detailModal .jmv2-fact small{
  font-size:.44rem!important;
  line-height:1.08!important;
  color:#7f98a8!important;
}
#detailModal .jmv2-fact b{
  font-size:.56rem!important;
  line-height:1.18!important;
  margin:0!important;
}
#detailModal .jmv2-requirements{
  padding:10px 11px!important;
  border-radius:15px!important;
}
#detailModal .jmv2-requirements>b{
  font-size:.56rem!important;
  line-height:1.28!important;
}
#detailModal .jmv2-requirements>b::before{
  width:20px!important;
  height:20px!important;
  border-radius:7px!important;
  font-size:.54rem!important;
}
#detailModal .jmv2-requirements ul{
