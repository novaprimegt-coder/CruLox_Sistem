}
#detailModal .jmv2-requirements li{position:relative!important;padding-left:11px!important}
#detailModal .jmv2-requirements li::before{content:"•";position:absolute!important;left:0!important;color:#22dff3!important}
#detailModal .jmv2-requirements>div{
