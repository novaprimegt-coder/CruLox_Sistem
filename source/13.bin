  #detailModal .jmv2-requirements>b::before{width:20px!important;height:20px!important;font-size:.56rem!important}
  #detailModal .jmv2-requirements li{font-size:.49rem!important}
  #detailModal .jmv2-requirements>div{font-size:.47rem!important}
}
</style>



<!-- JM V3.3 · Etiquetas, botones y flujo interno de pedido -->
<style id="jmv33-order-flow-style">
/* ===== Etiquetas superiores del detalle ===== */
#detailModal .jmv27-head{
  gap:10px!important;
}
#detailModal .jmv27-badges{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:10px!important;
  width:100%!important;
  margin-bottom:2px!important;
}
#detailModal .jmv27-head .section-kicker,
#detailModal .jmv27-head .stock-detail{
  min-height:30px!important;
  padding:7px 12px!important;
  border-radius:999px!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  font-size:.60rem!important;
  line-height:1!important;
  font-weight:900!important;
  letter-spacing:.07em!important;
  text-transform:uppercase!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
#detailModal .jmv27-head .section-kicker{
  justify-self:start!important;
  border:1px solid rgba(34,223,243,.20)!important;
  background:linear-gradient(180deg, rgba(13,45,66,.92), rgba(8,27,43,.96))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04), 0 10px 22px rgba(0,0,0,.11)!important;
  color:#7cecff!important;
}
#detailModal .jmv27-head .stock-detail{
  justify-self:end!important;
  border:1px solid rgba(58,227,132,.20)!important;
  background:linear-gradient(180deg, rgba(9,52,39,.95), rgba(7,35,27,.98))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.03), 0 10px 22px rgba(0,0,0,.12)!important;
  color:#8ff3b2!important;
}
#detailModal .jmv27-head .stock-detail::before{
  width:9px!important;
  height:9px!important;
  margin-right:7px!important;
  border-radius:50%!important;
  background:currentColor!important;
  box-shadow:0 0 14px currentColor!important;
  opacity:.92!important;
}
#detailModal .jmv27-head .stock-detail.low{
  border-color:rgba(255,198,94,.24)!important;
  background:linear-gradient(180deg, rgba(60,44,9,.95), rgba(43,30,6,.98))!important;
  color:#ffd776!important;
}
#detailModal .jmv27-head .stock-detail.out{
  border-color:rgba(255,111,138,.24)!important;
  background:linear-gradient(180deg, rgba(60,12,26,.95), rgba(38,7,17,.98))!important;
  color:#ff95a9!important;
}

/* ===== Botones inferiores del detalle ===== */
#detailModal .jmv27-actions{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:10px!important;
  align-items:stretch!important;
  margin-top:4px!important;
}
#detailModal .jmv27-actions .btn{
  min-height:48px!important;
  border-radius:16px!important;
  border:1px solid rgba(119,202,238,.12)!important;
  font-size:.80rem!important;
  font-weight:900!important;
  letter-spacing:-.01em!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04), 0 14px 28px rgba(0,0,0,.10)!important;
}
#detailModal .jmv27-actions #detailAdd,
#detailModal .jmv27-actions #detailAddCombo{
  grid-column:1/-1!important;
  min-height:54px!important;
  background:linear-gradient(135deg,#29e3f5 0%,#2a9dff 100%)!important;
  color:#04111d!important;
  border-color:transparent!important;
}
#detailModal .jmv27-actions #detailAdd::before,
#detailModal .jmv27-actions #detailAddCombo::before{
  content:'＋ '!important;
  font-weight:950!important;
}
#detailModal .jmv27-actions #detailSupport,
#detailModal .jmv27-actions #detailSupportCombo{
  background:linear-gradient(180deg, rgba(12,37,57,.96), rgba(9,27,43,.98))!important;
  color:#e9f8ff!important;
}
#detailModal .jmv27-actions #detailSupport::before,
#detailModal .jmv27-actions #detailSupportCombo::before{
  content:'💬 '!important;
  font-weight:950!important;
}
#detailModal .jmv27-actions #detailFav,
#detailModal .jmv27-actions #detailCloseCombo{
  background:linear-gradient(180deg, rgba(14,27,42,.96), rgba(9,18,31,.98))!important;
  color:#f0f7ff!important;
}
#detailModal .jmv27-actions #detailFav::before{
  content:'♡ '!important;
  color:#ff89a1!important;
  font-weight:950!important;
}
#detailModal .jmv27-actions #detailCloseCombo::before{
  content:'↺ '!important;
  font-weight:950!important;
}
#detailModal .jmv27-actions .btn:hover{
  transform:translateY(-1px)!important;
}

@media(max-width:560px){
  #detailModal .jmv27-badges{gap:8px!important}
  #detailModal .jmv27-head .section-kicker,
  #detailModal .jmv27-head .stock-detail{
    min-height:28px!important;
    padding:6px 11px!important;
    font-size:.54rem!important;
  }
  #detailModal .jmv27-actions{gap:8px!important}
  #detailModal .jmv27-actions .btn{min-height:44px!important;font-size:.68rem!important}
  #detailModal .jmv27-actions #detailAdd,
  #detailModal .jmv27-actions #detailAddCombo{min-height:50px!important;font-size:.72rem!important}
}
@media(max-width:390px){
  #detailModal .jmv27-badges{
    grid-template-columns:1fr auto!important;
    gap:7px!important;
  }
  #detailModal .jmv27-head .section-kicker,
  #detailModal .jmv27-head .stock-detail{
    padding:5px 10px!important;
    font-size:.49rem!important;
  }
  #detailModal .jmv27-actions .btn{font-size:.62rem!important}
}
</style>
<script id="jmv33-order-flow-script">
(()=>{
  'use strict';
  const D=document;
  const NOTIF_KEY='jm_digital_v23_notifications';
  const SENT_ORDER_NOTIF_KEY='jm_digital_v33_sent_order_notifications';

  const readJson=(key,fallback)=>{try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):fallback}catch(e){return fallback}};
  const writeJson=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){return false}};
  const moneyFormat=v=>typeof money==='function'?money(Number(v||0)):`Q${Number(v||0).toFixed(2)}`;

  function currentClient(){
    try{return typeof currentUser==='function'?currentUser():null}catch(e){return null}
  }

  function refreshPublicChatLabels(){
    const heroSupport=D.getElementById('heroSupport');
    if(heroSupport) heroSupport.textContent='Abrir chat';
    const footerSupport=D.getElementById('footerSupport');
    if(footerSupport) footerSupport.textContent='💬 Chat interno';
    const footerEmail=D.getElementById('footerEmail');
    if(footerEmail && footerEmail.textContent.includes('WhatsApp')) footerEmail.textContent=footerEmail.textContent.replace('WhatsApp','Chat');

    const miniCards=D.querySelectorAll('.hero-mini>div');
    if(miniCards[1]) miniCards[1].innerHTML='<b>CHAT INTERNO</b><span>Atención dentro del sistema</span>';

    const benefits=D.querySelectorAll('.benefit-grid .benefit');
    if(benefits[3]) benefits[3].innerHTML='<i>💬</i><div><b>Chat interno</b><span>Soporte desde tu cuenta</span></div>';
  }

  function tuneDetailButtons(){
    const supportBtn=D.getElementById('detailSupport');
    if(supportBtn) supportBtn.textContent='Abrir chat';
    const comboSupportBtn=D.getElementById('detailSupportCombo');
    if(comboSupportBtn) comboSupportBtn.textContent='Abrir chat';
    const favBtn=D.getElementById('detailFav');
    if(favBtn && /Guardar favorito/i.test(favBtn.textContent)) favBtn.textContent='Guardar';
    const comboClose=D.getElementById('detailCloseCombo');
    if(comboClose) comboClose.textContent='Seguir viendo';
  }

  function enhanceDetailBadges(){
    const kicker=D.querySelector('#detailModal .jmv27-head .section-kicker');
    if(kicker){
      kicker.textContent=String(kicker.textContent||'').trim() || 'Servicio';
      kicker.title=kicker.textContent;
    }
    const stock=D.querySelector('#detailModal .jmv27-head .stock-detail');
    if(stock){
      let text=String(stock.textContent||'').replace(/\s*·\s*\d+\s+unidades?/i,'').trim();
      if(!text) text='Disponible';
      stock.textContent=text;
      stock.title=text;
    }
  }

  function afterDetailRender(){
    tuneDetailButtons();
    enhanceDetailBadges();
  }

  const previousOpenDetailV33=window.openDetail;
  if(typeof previousOpenDetailV33==='function'){
    window.openDetail=function(id){
      const result=previousOpenDetailV33(id);
      setTimeout(afterDetailRender,32);
      return result;
    };
    try{openDetail=window.openDetail}catch(e){}
  }

  const previousOpenComboDetailV33=window.openComboDetail;
  if(typeof previousOpenComboDetailV33==='function'){
    window.openComboDetail=function(id){
      const result=previousOpenComboDetailV33(id);
      setTimeout(afterDetailRender,32);
      return result;
    };
    try{openComboDetail=window.openComboDetail}catch(e){}
  }

  function buildPaymentNotice(order){
    const itemCount=Array.isArray(order?.items)?order.items.length:0;
    return [
      `Tu pedido ${order?.id||''} ha sido recibido correctamente.${itemCount?` Incluye ${itemCount} producto${itemCount===1?'':'s'}.`:''}`,
      '',
      'Para recibir los beneficios es necesario que realices el pago a cualquiera de nuestras cuentas oficiales.',
      'Después de realizar el pago, sube tu comprobante lo más legible posible para evitar rechazos.',
      'Nuestro equipo verificará la información y luego te entregará tus accesos.',
      '',
      'Cuentas disponibles:',
      '',
      '1. Banco Azteca',
      'No. de cuenta: 0291 0121 7208 10',
      'Titular: José Manuel Cruz López',
      'Tipo de cuenta: Guardadito / Ahorro',
      '',
      '2. Banco Banrural',
      'No. de cuenta: 04913601079212',
      'Titular: José Manuel Cruz López',
      'Tipo de cuenta: Ahorro',
      '',
      `Total de referencia: ${moneyFormat(order?.total||0)}`
    ].join('\n');
  }

  function pushOrderNotification(order){
    const user=currentClient();
    const targetUserId=order?.userId || user?.id || null;
    if(!order || !targetUserId) return false;
    const sent=new Set(Array.isArray(readJson(SENT_ORDER_NOTIF_KEY,[]))?readJson(SENT_ORDER_NOTIF_KEY,[]):[]);
    const token=String(order.id||'');
    if(!token || sent.has(token)) return false;
    const list=Array.isArray(readJson(NOTIF_KEY,[]))?readJson(NOTIF_KEY,[]):[];
    list.push({id:`ntf_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`,target:'user',userId:targetUserId,type:'Pedido',title:'Pedido recibido',orderId:token,message:buildPaymentNotice(order),createdAt:new Date().toISOString()});
    if(!writeJson(NOTIF_KEY,list.slice(-300)))return false;
    sent.add(token);writeJson(SENT_ORDER_NOTIF_KEY,[...sent].slice(-500));return true;
  }

  const previousRegisterOrderV33=window.registerOrder;
  if(typeof previousRegisterOrderV33==='function'){
    window.registerOrder=function(order){
      const result=previousRegisterOrderV33(order);
      try{pushOrderNotification(order)}catch(err){console.warn('No se pudo registrar la notificación automática del pedido.',err)}
      return result;
    };
    try{registerOrder=window.registerOrder}catch(e){}
  }

  const previousSubmitOrderV33=window.submitOrder;
  if(typeof previousSubmitOrderV33==='function'){
    window.submitOrder=async function(e){
      const before=new Set((state?.orders||[]).map(o=>String(o.id||'')));
      const result=await previousSubmitOrderV33(e);
      try{const created=(state?.orders||[]).find(o=>o?.id&&!before.has(String(o.id)));if(created)pushOrderNotification(created)}catch(err){console.warn('No se pudo registrar la notificación automática del pedido.',err)}
      setTimeout(()=>{refreshPublicChatLabels();afterDetailRender()},30);
      return result;
    };
    try{submitOrder=window.submitOrder}catch(e){}
  }
  function bindFinalCheckoutSubmit(){const form=D.getElementById('checkoutForm');if(form&&typeof window.submitOrder==='function')form.onsubmit=window.submitOrder}
  function init(){refreshPublicChatLabels();afterDetailRender();bindFinalCheckoutSubmit()}
  if(D.readyState==='loading') D.addEventListener('DOMContentLoaded',init,{once:true}); else init();
})();
</script>



<!-- JM V3.4 · Notificaciones ordenadas + acceso al pedido + comprobante + desbloqueo seguro -->
<style id="jmv34-notifications-order-style">
/* Evita capas invisibles bloqueando la tienda */
#notificationOverlay:not(.open){opacity:0!important;visibility:hidden!important;pointer-events:none!important}
#notificationPanel:not(.open){visibility:hidden!important;pointer-events:none!important}
#notificationOverlay.open{opacity:1!important;visibility:visible!important;pointer-events:auto!important;z-index:2147482000!important}
#notificationPanel.open{visibility:visible!important;pointer-events:auto!important;z-index:2147482100!important}

#notificationPanel{
  width:min(100%,410px)!important;
  background:linear-gradient(180deg,#071421 0%,#06101b 100%)!important;
  border-left:1px solid rgba(78,208,244,.12)!important;
  box-shadow:-24px 0 70px rgba(0,0,0,.38)!important;
}
#notificationPanel .panel-head{
  min-height:64px!important;
  padding:13px 14px!important;
  border-bottom:1px solid rgba(105,202,234,.08)!important;
  background:rgba(6,16,27,.82)!important;
}
#notificationPanel .panel-head h2{
  margin:0!important;
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
  font-size:1.05rem!important;
  color:#f2f9ff!important;
}
#notificationPanel .panel-head h2::before{
  content:'🔔';
  width:32px!important;
  height:32px!important;
  border-radius:11px!important;
  display:grid!important;
  place-items:center!important;
  background:rgba(34,223,243,.07)!important;
  border:1px solid rgba(34,223,243,.11)!important;
  font-size:.9rem!important;
}
#notificationPanel .panel-head .close-btn{
  width:36px!important;
  height:36px!important;
  border-radius:13px!important;
  background:rgba(255,255,255,.025)!important;
  border:1px solid rgba(255,255,255,.07)!important;
}
#notificationPanel .panel-content{
  padding:12px!important;
  background:
    radial-gradient(circle at 100% 0%,rgba(34,223,243,.045),transparent 25%),
    transparent!important;
}
.jmv34-notif-summary{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:10px!important;
  padding:10px 11px!important;
  margin-bottom:10px!important;
  border-radius:14px!important;
  border:1px solid rgba(99,202,235,.09)!important;
  background:rgba(255,255,255,.018)!important;
}
.jmv34-notif-summary div{min-width:0!important}
.jmv34-notif-summary b{display:block!important;color:#edf8ff!important;font-size:.68rem!important;line-height:1.2!important}
.jmv34-notif-summary span{display:block!important;margin-top:3px!important;color:#7890a3!important;font-size:.55rem!important;line-height:1.3!important}
.jmv34-read-all{
  flex:0 0 auto!important;
  min-height:30px!important;
  padding:5px 9px!important;
  border-radius:10px!important;
  border:1px solid rgba(34,223,243,.11)!important;
  background:rgba(34,223,243,.045)!important;
  color:#76e8f8!important;
  font-size:.52rem!important;
  font-weight:850!important;
}
.jmv34-notif-group{display:grid!important;gap:7px!important;margin-top:10px!important}
.jmv34-notif-group-title{
  padding:0 2px!important;
  color:#6f879a!important;
  font-size:.49rem!important;
  font-weight:900!important;
  letter-spacing:.11em!important;
  text-transform:uppercase!important;
}
.jmv34-notif-card{
  position:relative!important;
  overflow:hidden!important;
  padding:11px!important;
  border-radius:16px!important;
  border:1px solid rgba(113,205,236,.09)!important;
  background:linear-gradient(180deg,rgba(12,29,46,.92),rgba(7,20,34,.97))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.02)!important;
}
.jmv34-notif-card.unread{
  border-color:rgba(34,223,243,.25)!important;
  box-shadow:inset 3px 0 #22dff3, inset 0 1px 0 rgba(255,255,255,.025)!important;
}
.jmv34-notif-card.order{background:linear-gradient(180deg,rgba(11,35,50,.95),rgba(7,22,35,.98))!important}
.jmv34-notif-top{display:grid!important;grid-template-columns:38px minmax(0,1fr) auto!important;align-items:center!important;gap:9px!important}
.jmv34-notif-icon{
  width:38px!important;height:38px!important;border-radius:13px!important;display:grid!important;place-items:center!important;
  background:radial-gradient(circle at 30% 20%,rgba(34,223,243,.17),rgba(34,223,243,.05) 68%,rgba(255,255,255,.02) 100%)!important;
  border:1px solid rgba(34,223,243,.12)!important;color:#69e7f7!important;font-size:.9rem!important
}
.jmv34-notif-title{min-width:0!important}
.jmv34-notif-title h3{margin:0!important;color:#f4fbff!important;font-size:.72rem!important;line-height:1.25!important;font-weight:900!important}
.jmv34-notif-title time{display:block!important;margin-top:3px!important;color:#6d8497!important;font-size:.48rem!important;line-height:1.2!important}
.jmv34-notif-chip{
  justify-self:end!important;padding:4px 7px!important;border-radius:999px!important;border:1px solid rgba(34,223,243,.12)!important;
  background:rgba(34,223,243,.05)!important;color:#62e4f6!important;font-size:.44rem!important;font-weight:900!important;text-transform:uppercase!important
}
.jmv34-notif-message{margin:9px 0 0!important;color:#aebfcb!important;font-size:.58rem!important;line-height:1.46!important}
.jmv34-notif-order-meta{
  display:grid!important;grid-template-columns:1fr auto!important;gap:8px!important;align-items:center!important;
  margin-top:9px!important;padding:8px 9px!important;border-radius:11px!important;background:rgba(255,255,255,.018)!important;border:1px solid rgba(255,255,255,.04)!important
}
.jmv34-notif-order-meta b{font-size:.55rem!important;color:#eaf6ff!important;overflow-wrap:anywhere!important}
.jmv34-notif-order-meta strong{font-size:.60rem!important;color:#32dff4!important}
.jmv34-notif-actions{display:flex!important;gap:7px!important;margin-top:9px!important}
.jmv34-notif-action{
  min-height:34px!important;padding:6px 10px!important;border-radius:11px!important;border:1px solid rgba(255,255,255,.06)!important;
  background:rgba(255,255,255,.025)!important;color:#dceaf4!important;font-size:.55rem!important;font-weight:900!important
}
.jmv34-notif-action.primary{flex:1!important;background:linear-gradient(135deg,#25dff3,#2b9cff)!important;border-color:transparent!important;color:#04111b!important}
.jmv34-notif-empty{padding:34px 16px!important;text-align:center!important;color:#74899b!important;font-size:.62rem!important}

/* Vista del pedido abierta desde la notificación */
.jmv34-order-view{display:grid!important;gap:10px!important}
.jmv34-order-head{
  padding:12px!important;border-radius:17px!important;border:1px solid rgba(34,223,243,.10)!important;
  background:linear-gradient(180deg,rgba(10,31,47,.92),rgba(7,20,34,.98))!important
}
.jmv34-order-head-top{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:10px!important}
.jmv34-order-head small{display:block!important;color:#6f8799!important;font-size:.50rem!important;font-weight:800!important}
.jmv34-order-head h3{margin:3px 0 0!important;color:#f2faff!important;font-size:.78rem!important;line-height:1.25!important;overflow-wrap:anywhere!important}
.jmv34-order-status{padding:5px 8px!important;border-radius:999px!important;border:1px solid rgba(255,195,83,.14)!important;background:rgba(255,195,83,.055)!important;color:#ffd575!important;font-size:.49rem!important;font-weight:900!important;white-space:nowrap!important}
.jmv34-order-total{display:flex!important;align-items:end!important;justify-content:space-between!important;gap:10px!important;margin-top:10px!important;padding-top:9px!important;border-top:1px solid rgba(111,203,234,.08)!important}
.jmv34-order-total span{font-size:.53rem!important;color:#8199aa!important}.jmv34-order-total strong{font-size:1rem!important;color:#2bdff4!important}
.jmv34-order-items,.jmv34-payment-steps,.jmv34-bank-box,.jmv34-receipt-box{
  padding:11px!important;border-radius:16px!important;border:1px solid rgba(112,204,235,.08)!important;background:rgba(255,255,255,.015)!important
}
.jmv34-section-title{display:flex!important;align-items:center!important;gap:7px!important;margin:0 0 8px!important;color:#eaf6ff!important;font-size:.64rem!important;font-weight:900!important}
.jmv34-order-item{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:8px!important;padding:7px 0!important;border-top:1px solid rgba(255,255,255,.04)!important}
.jmv34-order-item:first-of-type{border-top:0!important;padding-top:0!important}
.jmv34-order-item b{font-size:.55rem!important;color:#dceaf4!important;line-height:1.3!important}.jmv34-order-item span{font-size:.55rem!important;color:#2edff3!important;font-weight:850!important}
.jmv34-step{display:grid!important;grid-template-columns:27px minmax(0,1fr)!important;gap:8px!important;padding:7px 0!important}
.jmv34-step-num{width:27px!important;height:27px!important;border-radius:9px!important;display:grid!important;place-items:center!important;background:rgba(34,223,243,.055)!important;border:1px solid rgba(34,223,243,.10)!important;color:#5fe5f6!important;font-size:.54rem!important;font-weight:900!important}
.jmv34-step b{display:block!important;color:#eaf6ff!important;font-size:.56rem!important}.jmv34-step p{margin:2px 0 0!important;color:#8399aa!important;font-size:.51rem!important;line-height:1.38!important}
.jmv34-banks{display:grid!important;grid-template-columns:1fr 1fr!important;gap:7px!important}
.jmv34-bank{
  padding:9px!important;border-radius:13px!important;border:1px solid rgba(34,223,243,.08)!important;background:linear-gradient(180deg,rgba(8,27,42,.85),rgba(6,19,31,.95))!important
}
.jmv34-bank h4{margin:0!important;color:#f0f9ff!important;font-size:.58rem!important}.jmv34-bank p{margin:4px 0 0!important;color:#93a9b8!important;font-size:.50rem!important;line-height:1.42!important;white-space:pre-line!important}
.jmv34-copy-account{margin-top:7px!important;min-height:29px!important;padding:5px 8px!important;border-radius:9px!important;border:1px solid rgba(34,223,243,.10)!important;background:rgba(34,223,243,.04)!important;color:#65e4f5!important;font-size:.48rem!important;font-weight:850!important}
.jmv34-receipt-box{background:linear-gradient(180deg,rgba(12,35,49,.78),rgba(7,20,32,.94))!important}
.jmv34-receipt-note{margin:0 0 8px!important;color:#8ea4b4!important;font-size:.52rem!important;line-height:1.42!important}
.jmv34-file-label{
  display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;min-height:40px!important;padding:8px 10px!important;border-radius:12px!important;
  border:1px dashed rgba(34,223,243,.26)!important;background:rgba(34,223,243,.035)!important;color:#65e4f5!important;font-size:.55rem!important;font-weight:900!important;cursor:pointer!important
}
.jmv34-file-label input{display:none!important}
.jmv34-receipt-current{display:flex!important;align-items:center!important;gap:9px!important;margin-top:8px!important;padding:8px!important;border-radius:12px!important;background:rgba(49,219,126,.04)!important;border:1px solid rgba(49,219,126,.10)!important}
.jmv34-receipt-current img{width:48px!important;height:48px!important;object-fit:cover!important;border-radius:10px!important;border:1px solid rgba(255,255,255,.06)!important}
.jmv34-receipt-current div{min-width:0!important}.jmv34-receipt-current b{display:block!important;color:#b6f2cc!important;font-size:.54rem!important}.jmv34-receipt-current span{display:block!important;margin-top:2px!important;color:#78918a!important;font-size:.47rem!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
.jmv34-order-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:7px!important}
.jmv34-order-actions .btn{min-height:38px!important;border-radius:12px!important;font-size:.55rem!important}
.jmv34-admin-receipt{margin-top:7px!important;padding:8px!important;border-radius:10px!important;background:rgba(34,223,243,.035)!important;border:1px solid rgba(34,223,243,.08)!important;color:#b9ccd7!important;font-size:.50rem!important}
.jmv34-admin-receipt button{margin-left:7px!important;min-height:27px!important;padding:4px 7px!important;border-radius:8px!important;border:1px solid rgba(34,223,243,.11)!important;background:rgba(34,223,243,.045)!important;color:#63e4f5!important;font-size:.47rem!important;font-weight:850!important}

@media(max-width:560px){
  #notificationPanel{width:100%!important}
  .jmv34-banks{grid-template-columns:1fr!important}
  .jmv34-notif-card{padding:10px!important}
  .jmv34-notif-top{grid-template-columns:35px minmax(0,1fr) auto!important;gap:8px!important}
  .jmv34-notif-icon{width:35px!important;height:35px!important;border-radius:12px!important}
  .jmv34-notif-title h3{font-size:.68rem!important}
  .jmv34-notif-message{font-size:.55rem!important}
}
</style>
<script id="jmv34-notifications-order-script">
(()=>{
'use strict';
const D=document;
const NOTIF_KEY='jm_digital_v23_notifications';
const READ_KEY='jm_digital_v23_notification_reads';
const ORDER_KEY=(typeof KEYS!=='undefined'&&KEYS.orders)?KEYS.orders:'jm_digital_orders';
const esc34=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const read34=(key,fallback)=>{try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):fallback}catch(e){return fallback}};
const write34=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){return false}};
const money34=v=>typeof money==='function'?money(Number(v||0)):`Q${Number(v||0).toFixed(2)}`;
const date34=v=>{try{return new Date(v).toLocaleString('es-GT',{dateStyle:'medium',timeStyle:'short'})}catch(e){return ''}};
const currentUser34=()=>{try{return typeof currentUser==='function'?currentUser():null}catch(e){return null}};
const notifications34=()=>{const v=read34(NOTIF_KEY,[]);return Array.isArray(v)?v:[]};
function readScope34(){const session=state?.session;if(session?.role==='admin')return 'admin';const user=currentUser34();return user?.id?`user:${user.id}`:'guest'}
function scopedReadKey34(){return `${READ_KEY}:${readScope34()}`}
const reads34=()=>{const v=read34(scopedReadKey34(),[]);return new Set(Array.isArray(v)?v:[])};
const writeReads34=set=>write34(scopedReadKey34(),[...set]);

function orderIdFromNotification34(n){
  if(n?.orderId)return String(n.orderId);
  const text=`${n?.title||''} ${n?.message||''}`;
  const m=text.match(/\b(?:JM|NP)-[A-Z0-9-]{8,}\b/i);
  return m?m[0]:'';
}
function orderById34(id){return (state?.orders||[]).find(o=>String(o.id)===String(id))||null}
function isOrderNotif34(n){return String(n?.type||'').toLowerCase().includes('pedido')||!!orderIdFromNotification34(n)}
function shortMessage34(n){
  if(isOrderNotif34(n)){
    const o=orderById34(orderIdFromNotification34(n));
    if(o?.payment?.receiptDataUrl)return 'Tu comprobante ya fue cargado. Nuestro equipo debe verificar el pago antes de entregar tus accesos.';
    return 'Tu pedido fue recibido. Realiza el pago y, cuando termines, entra al pedido para subir tu comprobante.';
  }
  const msg=String(n?.message||'').replace(/\s+/g,' ').trim();
  return msg.length>180?`${msg.slice(0,177)}…`:msg;
}
function visibleNotifications34(){
  const session=state?.session;
  const user=currentUser34();
  const all=notifications34().filter(n=>{
    if(session?.role==='admin')return true;
    if(n.target==='all')return true;
    return user&&String(n.userId||'')===String(user.id);
  });
  const read=reads34();
  return all.sort((a,b)=>{
    const ar=read.has(String(a.id))?1:0, br=read.has(String(b.id))?1:0;
    if(ar!==br)return ar-br;
    return Date.parse(b.createdAt||0)-Date.parse(a.createdAt||0);
  });
}
function markRead34(id){const set=reads34();set.add(String(id));writeReads34(set);updateBadge34()}
function markAllRead34(){const set=reads34();visibleNotifications34().forEach(n=>set.add(String(n.id)));writeReads34(set);renderNotificationPanel34();updateBadge34()}
function updateBadge34(){
  const badge=D.getElementById('notificationCount');if(!badge)return;
  const set=reads34();const n=visibleNotifications34().filter(x=>!set.has(String(x.id))).length;
  badge.textContent=n>99?'99+':String(n);badge.hidden=n===0;
}
function groupMarkup34(list,read){
  return list.map(n=>{
    const oid=orderIdFromNotification34(n),o=oid?orderById34(oid):null,order=isOrderNotif34(n),unread=!read.has(String(n.id));
    return `<article class="jmv34-notif-card ${unread?'unread':''} ${order?'order':''}" data-jmv34-notif="${esc34(n.id)}">
      <div class="jmv34-notif-top"><div class="jmv34-notif-icon">${order?'🧾':'🔔'}</div><div class="jmv34-notif-title"><h3>${esc34(n.title||'Notificación')}</h3><time>${esc34(date34(n.createdAt||Date.now()))}</time></div><span class="jmv34-notif-chip">${esc34(n.type||'Aviso')}</span></div>
      <p class="jmv34-notif-message">${esc34(shortMessage34(n))}</p>
      ${order&&oid?`<div class="jmv34-notif-order-meta"><b>${esc34(oid)}</b><strong>${o?esc34(money34(o.total)):'Pedido'}</strong></div><div class="jmv34-notif-actions"><button class="jmv34-notif-action primary" type="button" data-jmv34-order="${esc34(oid)}" data-jmv34-read="${esc34(n.id)}">Ver pedido y pago</button></div>`:''}
    </article>`
  }).join('')
}
function renderNotificationPanel34(){
  const box=D.getElementById('notificationItems');if(!box)return;
  const list=visibleNotifications34(),read=reads34();
  const unread=list.filter(n=>!read.has(String(n.id))),older=list.filter(n=>read.has(String(n.id)));
  box.innerHTML=`<div class="jmv34-notif-summary"><div><b>${unread.length?`${unread.length} notificación${unread.length===1?'':'es'} nueva${unread.length===1?'':'s'}`:'Todo al día'}</b><span>Pedidos, pagos y avisos importantes de tu cuenta.</span></div>${unread.length?'<button class="jmv34-read-all" id="jmv34ReadAll" type="button">Marcar leídas</button>':''}</div>${unread.length?`<section class="jmv34-notif-group"><div class="jmv34-notif-group-title">Nuevas</div>${groupMarkup34(unread,read)}</section>`:''}${older.length?`<section class="jmv34-notif-group"><div class="jmv34-notif-group-title">Anteriores</div>${groupMarkup34(older,read)}</section>`:''}${!list.length?'<div class="jmv34-notif-empty">No tienes notificaciones por el momento.</div>':''}`;
  const readAll=D.getElementById('jmv34ReadAll');if(readAll)readAll.onclick=markAllRead34;
  box.querySelectorAll('[data-jmv34-order]').forEach(btn=>btn.onclick=()=>{markRead34(btn.dataset.jmv34Read);openOrderFromNotification34(btn.dataset.jmv34Order)});
}
function noOtherLayer34(){
  return !D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#jmv21VariantModal.open,#jmNoticeOverlay.open');
}
function unlockIfClear34(){requestAnimationFrame(()=>{if(noOtherLayer34())D.body.classList.remove('lock')})}
function closeNotifications34(){
  D.getElementById('notificationOverlay')?.classList.remove('open');
  D.getElementById('notificationPanel')?.classList.remove('open');
  unlockIfClear34();
}
function closeStorePanels34(){
  ['drawer','cartPanel','favPanel'].forEach(id=>D.getElementById(id)?.classList.remove('open'));
  ['drawerOverlay','cartOverlay','favOverlay'].forEach(id=>D.getElementById(id)?.classList.remove('open'));
}
function openNotifications34(){
  closeStorePanels34();
  renderNotificationPanel34();
  const overlay=D.getElementById('notificationOverlay'),panel=D.getElementById('notificationPanel');
  if(!overlay||!panel)return;
  overlay.classList.add('open');panel.classList.add('open');D.body.classList.add('lock');
}
function bindNotificationUi34(){
  const btn=D.getElementById('notificationBtn'),overlay=D.getElementById('notificationOverlay'),close=D.getElementById('notificationClose');
  if(btn)btn.onclick=openNotifications34;
  if(overlay)overlay.onclick=e=>{if(e.target===overlay)closeNotifications34()};
  if(close)close.onclick=closeNotifications34;
  updateBadge34();
}

function bankMarkup34(){return `<div class="jmv34-banks"><article class="jmv34-bank"><h4>Banco Azteca</h4><p>No. de cuenta: 0291 0121 7208 10\nTitular: José Manuel Cruz López\nTipo: Guardadito / Ahorro</p><button type="button" class="jmv34-copy-account" data-copy-account="02910121720810">Copiar cuenta</button></article><article class="jmv34-bank"><h4>Banco Banrural</h4><p>No. de cuenta: 04913601079212\nTitular: José Manuel Cruz López\nTipo: Ahorro</p><button type="button" class="jmv34-copy-account" data-copy-account="04913601079212">Copiar cuenta</button></article></div>`}
function receiptMarkup34(o){
  const r=o?.payment||{};
  return `<section class="jmv34-receipt-box"><h4 class="jmv34-section-title">📎 Comprobante de pago</h4><p class="jmv34-receipt-note">Cuando realices el pago, sube una fotografía clara y legible del comprobante. El equipo verificará el pago antes de entregar los accesos.</p><label class="jmv34-file-label">${r.receiptDataUrl?'Reemplazar comprobante':'Subir comprobante'}<input id="jmv34ReceiptInput" type="file" accept="image/*"></label>${r.receiptDataUrl?`<div class="jmv34-receipt-current"><img src="${esc34(r.receiptDataUrl)}" alt="Comprobante"><div><b>Comprobante enviado</b><span>${esc34(r.receiptName||'Imagen')} · ${esc34(date34(r.receiptUploadedAt||o.updatedAt))}</span></div></div>`:''}</section>`
}
function canAccessOrder34(o){if(!o)return false;if(state?.session?.role==='admin')return true;const user=currentUser34();if(!user)return false;return String(o.userId||'')===String(user.id)||String(o.customer?.email||'').trim().toLowerCase()===String(user.email||'').trim().toLowerCase()}
function renderOrderDetail34(orderId){
  const o=orderById34(orderId);const body=D.getElementById('accountBody');if(!body)return;
  if(!o){body.innerHTML='<div class="empty">No encontramos este pedido.</div>';return}
  if(!canAccessOrder34(o)){body.innerHTML='<div class="empty">Este pedido no pertenece a tu cuenta.</div>';return}
  body.innerHTML=`<div class="jmv34-order-view"><section class="jmv34-order-head"><div class="jmv34-order-head-top"><div><small>Pedido</small><h3>${esc34(o.id)}</h3></div><span class="jmv34-order-status">${esc34(o.payment?.status||o.status||'Pendiente')}</span></div><div class="jmv34-order-total"><span>${esc34(date34(o.createdAt))}</span><strong>${esc34(money34(o.total))}</strong></div></section><section class="jmv34-order-items"><h4 class="jmv34-section-title">🛍 Productos del pedido</h4>${(o.items||[]).map(i=>`<div class="jmv34-order-item"><b>${esc34(i.name)} × ${Number(i.qty||1)}</b><span>${esc34(money34(Number(i.price||0)*Number(i.qty||1)))}</span></div>`).join('')||'<div class="empty">Sin productos.</div>'}</section><section class="jmv34-payment-steps"><h4 class="jmv34-section-title">✓ Cómo completar tu compra</h4><div class="jmv34-step"><span class="jmv34-step-num">1</span><div><b>Realiza el pago</b><p>Utiliza cualquiera de las cuentas oficiales indicadas abajo.</p></div></div><div class="jmv34-step"><span class="jmv34-step-num">2</span><div><b>Sube tu comprobante</b><p>Procura que nombre, monto, fecha y referencia sean legibles.</p></div></div><div class="jmv34-step"><span class="jmv34-step-num">3</span><div><b>Verificación y entrega</b><p>El equipo revisará el pago y, al confirmarlo, gestionará tus accesos.</p></div></div></section><section class="jmv34-bank-box"><h4 class="jmv34-section-title">🏦 Cuentas disponibles</h4>${bankMarkup34()}</section>${receiptMarkup34(o)}<div class="jmv34-order-actions"><button type="button" class="btn btn-secondary" id="jmv34BackOrders">Mis pedidos</button><button type="button" class="btn btn-secondary" id="jmv34OpenChat">Abrir chat</button></div></div>`;
  body.querySelectorAll('[data-copy-account]').forEach(b=>b.onclick=async()=>{try{await navigator.clipboard.writeText(b.dataset.copyAccount);if(typeof toast==='function')toast('Número de cuenta copiado.','success')}catch(e){if(typeof toast==='function')toast('No se pudo copiar automáticamente.','warn')}});
  const back=D.getElementById('jmv34BackOrders');if(back)back.onclick=()=>{if(typeof renderClientOrders==='function')renderClientOrders();else if(typeof renderAccount==='function')renderAccount()};
  const chat=D.getElementById('jmv34OpenChat');if(chat)chat.onclick=()=>{try{if(typeof openBot==='function')openBot('support',`Hola. Necesito ayuda con mi pedido ${o.id}.`,{Pedido:o.id,Tipo:'Pedido'})}catch(e){}};
  const input=D.getElementById('jmv34ReceiptInput');if(input)input.onchange=()=>uploadReceipt34(o,input.files?.[0]);
}
async function uploadReceipt34(order,file){
  if(!order||!canAccessOrder34(order)){if(typeof toast==='function')toast('No tienes autorización para modificar este pedido.','error');return}
  if(!file)return;
  if(!/^image\//i.test(file.type||'')){if(typeof toast==='function')toast('El comprobante debe ser una imagen.','warn');return}
  if(file.size>6*1024*1024){if(typeof toast==='function')toast('La imagen es demasiado pesada. Usa una de menos de 6 MB.','warn');return}
  let data='';
  try{
    if(typeof optimizeImageFile==='function')data=await optimizeImageFile(file,{maxWidth:1500,maxHeight:1500,quality:.84});
    if(!data)data=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result||''));r.onerror=reject;r.readAsDataURL(file)});
  }catch(e){if(typeof toast==='function')toast('No fue posible procesar el comprobante.','error');return}
  const previousPayment=order.payment?JSON.parse(JSON.stringify(order.payment)):null,previousUpdatedAt=order.updatedAt;
  order.payment=order.payment||{};order.payment.receiptDataUrl=data;order.payment.receiptName=file.name.slice(0,120);order.payment.receiptUploadedAt=new Date().toISOString();order.payment.status='Comprobante enviado';order.updatedAt=new Date().toISOString();
  let orderSaved=false;try{orderSaved=typeof write==='function'?write(ORDER_KEY,state.orders):write34(ORDER_KEY,state.orders)}catch(e){orderSaved=write34(ORDER_KEY,state.orders)}
  if(!orderSaved){if(previousPayment)order.payment=previousPayment;else delete order.payment;order.updatedAt=previousUpdatedAt;if(typeof toast==='function')toast('No fue posible guardar el comprobante. Libera espacio e inténtalo nuevamente.','error');return}
  const user=currentUser34();const list=notifications34();list.push({id:`ntf_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,7)}`,target:'user',userId:order.userId||user?.id||null,type:'Pedido',title:'Comprobante recibido',orderId:order.id,message:`Recibimos el comprobante de tu pedido ${order.id}. Nuestro equipo debe verificar el pago antes de entregar tus accesos.`,createdAt:new Date().toISOString()});if(!write34(NOTIF_KEY,list.slice(-300))&&typeof toast==='function')toast('El comprobante quedó guardado, pero no se pudo registrar la notificación local.','warn');
  updateBadge34();decorateAdminReceipts34();renderOrderDetail34(order.id);if(typeof toast==='function')toast('Comprobante enviado para verificación.','success');
}
function openOrderFromNotification34(orderId){
  closeNotifications34();
  if(state?.session?.role==='admin'){
    try{if(typeof openAdmin==='function')openAdmin('orders');else{D.getElementById('adminOverlay')?.classList.add('open');D.body.classList.add('lock');if(typeof renderAdminSection==='function')renderAdminSection('orders')}}catch(e){}
    return;
  }
  try{if(typeof renderAccount==='function')renderAccount();if(typeof openModal==='function')openModal('accountModal');else{D.getElementById('accountModal')?.classList.add('open');D.body.classList.add('lock')}setTimeout(()=>renderOrderDetail34(orderId),20)}catch(e){console.error(e);unlockIfClear34()}
}
function upgradeOrderNotifications34(){
  const list=notifications34();let changed=false;
  list.forEach(n=>{if(!n.orderId){const id=orderIdFromNotification34(n);if(id){n.orderId=id;changed=true}}});
  if(changed)write34(NOTIF_KEY,list);
}
function decorateAdminReceipts34(){
  const root=D.getElementById('adminContent');if(!root)return;
  const rows=[...root.querySelectorAll('.jmv2-record,.jm-record,.admin-list-item')];
  rows.forEach(row=>{
    const text=row.textContent||'';const o=(state?.orders||[]).find(x=>text.includes(String(x.id)));
    if(!o?.payment?.receiptDataUrl||row.querySelector('.jmv34-admin-receipt'))return;
    const box=D.createElement('div');box.className='jmv34-admin-receipt';box.innerHTML=`Comprobante recibido · ${esc34(date34(o.payment.receiptUploadedAt||o.updatedAt))}<button type="button">Ver comprobante</button>`;
    box.querySelector('button').onclick=()=>openReceiptViewer389(o);
    const target=row.querySelector('div')||row;target.appendChild(box);
  });
}
function openReceiptViewer389(order){
  const src=String(order?.payment?.receiptDataUrl||'').trim();if(!src)return;
  const old=D.getElementById('cc389ReceiptViewer');if(old)old.remove();
  const layer=D.createElement('div');layer.id='cc389ReceiptViewer';layer.className='modal-overlay open';layer.style.zIndex='2147483600';
  layer.innerHTML=`<div style="width:min(96vw,980px);height:min(92vh,820px);display:grid;grid-template-rows:auto minmax(0,1fr);gap:10px;padding:12px;border-radius:20px;background:#06111f;border:1px solid rgba(52,220,255,.18);box-shadow:0 30px 100px rgba(0,0,0,.65)"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><strong style="color:#effaff;font-size:.9rem">Comprobante · ${esc34(order?.id||'Pedido')}</strong><button type="button" id="cc389ReceiptClose" style="width:38px;height:38px;border-radius:12px;border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.04);color:#dffaff;font-size:1.1rem">×</button></div><div style="min-height:0;display:grid;place-items:center;overflow:auto;border-radius:15px;background:#020912"><img src="${esc34(src)}" alt="Comprobante del pedido ${esc34(order?.id||'')}" style="display:block;max-width:100%;max-height:100%;object-fit:contain"></div></div>`;
  D.body.appendChild(layer);D.body.classList.add('lock');
  const close=()=>{layer.remove();if(!D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#jmv21VariantModal.open,#jmNoticeOverlay.open,#cc389ReceiptViewer.open'))D.body.classList.remove('lock')};
  layer.addEventListener('click',e=>{if(e.target===layer)close()});layer.querySelector('#cc389ReceiptClose').onclick=close;
}
function scrubRuntimeLeak389(root=document.body){
  const bad=/(?:adminObs34|JM_DIGITAL_STORE_V34|w\.document\.write|window\.JM_DIGITAL_STORE_V34|const adminContent=D\.getElementById\(['\"]adminContent['\"]\)|decorateAdminReceipts34\(\))/;
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);const doomed=[];let node;
  while(node=walker.nextNode()){const p=node.parentElement;if(!p||/^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE)$/.test(p.tagName))continue;const text=String(node.nodeValue||'');if(bad.test(text))doomed.push(node)}
  doomed.forEach(n=>n.parentNode?.removeChild(n));
}
const adminObs34=new MutationObserver(()=>decorateAdminReceipts34());
function init34(){
  upgradeOrderNotifications34();bindNotificationUi34();decorateAdminReceipts34();
  const adminContent=D.getElementById('adminContent');if(adminContent)adminObs34.observe(adminContent,{childList:true,subtree:true});
  setInterval(()=>{if(D.hidden)return;bindNotificationUi34();if(D.getElementById('adminOverlay')?.classList.contains('open')&&state?.adminSection==='orders')decorateAdminReceipts34()},15000);
}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init34,{once:true});else init34();
window.JM_DIGITAL_STORE_V34={VERSION:'3.5.0',openNotifications:openNotifications34,closeNotifications:closeNotifications34,renderNotificationPanel:renderNotificationPanel34,openOrder:openOrderFromNotification34,renderOrderDetail:renderOrderDetail34};
})();
</script>


<!-- JM V3.4.1 · Ajuste de estabilidad visual e interacción -->
<style id="jmv341-stability-style">
#notificationPanel .jmv23-panel-note{display:none!important}
#notificationPanel.open{transform:translateX(0)!important}
#notificationOverlay.open{display:block!important}
#notificationOverlay:not(.open){display:block!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important}
#notificationPanel:not(.open){pointer-events:none!important}
</style>
<script id="jmv341-stability-script">
(()=>{
  'use strict';
  const D=document;
  function clearStaleLock(){
    const active=D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#jmv21VariantModal.open,#jmNoticeOverlay.open');
    if(!active)D.body.classList.remove('lock');
  }
  function refineNotificationHeader(){
    const h=D.querySelector('#notificationPanel .panel-head h2');
    if(h)h.textContent='Notificaciones';
  }
  function enforceNotificationHandlers(){
    try{
      refineNotificationHeader();
      const api=window.JM_DIGITAL_STORE_V34;
      if(!api)return;
      const btn=D.getElementById('notificationBtn');if(btn)btn.onclick=api.openNotifications;
      const close=D.getElementById('notificationClose');if(close)close.onclick=api.closeNotifications;
      const overlay=D.getElementById('notificationOverlay');if(overlay)overlay.onclick=e=>{if(e.target===overlay)api.closeNotifications()};
    }catch(e){console.warn('Notification handler recovery',e)}
  }
  D.addEventListener('visibilitychange',()=>{if(!D.hidden){clearStaleLock();enforceNotificationHandlers()}});
  window.addEventListener('pageshow',()=>{clearStaleLock();enforceNotificationHandlers()});
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>{clearStaleLock();enforceNotificationHandlers()},{once:true});
  else{clearStaleLock();enforceNotificationHandlers()}
  setTimeout(()=>{clearStaleLock();enforceNotificationHandlers()},120);
})();
</script>

<!-- JM V3.5.0 · Integridad y estabilidad del código actual -->
<script id="jmv350-integrity-selftest">
(()=>{
'use strict';
function run(){const team=window.NP_TEAM_API_V105;const checks={adminEmailConfigured:typeof ADMIN_EMAIL!=='undefined'&&ADMIN_EMAIL==='admin-separado@crulox.invalid',adminHashConfigured:typeof ADMIN_PASSWORD_HASH!=='undefined'&&/^[a-f0-9]{64}$/i.test(ADMIN_PASSWORD_HASH),notificationApi:window.JM_DIGITAL_STORE_V34?.VERSION==='3.5.0',notificationUi:!!document.getElementById('notificationBtn')&&!!document.getElementById('notificationPanel'),noDuplicateDomIds:(()=>{const ids=[...document.querySelectorAll('[id]')].map(x=>x.id);return new Set(ids).size===ids.length})(),stateShape:typeof state==='object'&&Array.isArray(state.products)&&Array.isArray(state.orders)&&Array.isArray(state.users),teamPermissions:!!team&&typeof team.canUseSection==='function'&&typeof team.canUseTool==='function',criticalFunctions:['renderStore','openAdmin','renderAdminSection','submitOrder'].every(n=>typeof globalThis[n]==='function')};const result={version:'3.5.0',checks,ok:Object.values(checks).every(Boolean)};window.JM_DIGITAL_STORE_V350_SELF_TEST=result;document.documentElement.dataset.jmV350=result.ok?'ok':'review';if(result.ok)console.info('CRULOX · V3.5.0 self-test OK',result);else console.warn('CRULOX · V3.5.0 self-test review',result);return result}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(run,180),{once:true});else setTimeout(run,180);
})();
</script>



