/* Tablets */
@media(max-width:1100px) and (min-width:761px){
  #adminOverlay .np-v10-modules,#adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}
}

/* Móvil: todo cabe mejor sin perder controles táctiles */
@media(max-width:760px){
  #adminOverlay .admin-sidebar{padding:4px 6px 5px!important}
  #adminOverlay .admin-brand-row{min-height:35px!important;padding:1px 2px 3px!important}
