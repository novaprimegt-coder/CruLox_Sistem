<script id="np-v124-final-admin-script">
/* v11.24: mejora de panel sin alterar rutas, datos ni herramientas. */
(function(){
  const overlay=document.getElementById('adminOverlay');
  if(!overlay)return;
  overlay.dataset.panelUi='11.24-final';
  const applyA11y=()=>{
    overlay.querySelectorAll('button:not([type])').forEach(b=>b.type='button');
    const title=document.getElementById('adminTitle');
    if(title)title.setAttribute('aria-live','polite');
    const content=document.getElementById('adminContent');
    if(content){content.setAttribute('role','region');content.setAttribute('aria-label','Contenido administrativo')}
  };
  requestAnimationFrame(applyA11y);
  const baseRender=window.renderAdminSection;
  if(typeof baseRender==='function'){
    window.renderAdminSection=function(section){const r=baseRender(section);requestAnimationFrame(applyA11y);return r};
  }
  window.NP_V124_PANEL={VERSION:'11.24',refresh:applyA11y};
})();
</script>


<style id="jm-digital-v1-style">
:root{--jm-bg:#02070d;--jm-panel:#07131f;--jm-card:#0a1a29;--jm-card2:#0d2234;--jm-cyan:#22dff3;--jm-cyan2:#16b8d8;--jm-green:#39df7c;--jm-amber:#ffb547;--jm-red:#ff647c;--jm-text:#f6fbff;--jm-sub:#a9bfd1;--jm-muted:#6f8ba2;--jm-line:rgba(92,220,242,.13)}
body{background:radial-gradient(circle at 9% -8%,rgba(34,223,243,.12),transparent 29%),radial-gradient(circle at 92% 17%,rgba(57,223,124,.055),transparent 24%),linear-gradient(180deg,#02070d,#04101a 45%,#02070d)!important}
.header{background:rgba(2,7,13,.96)!important;border-bottom:1px solid rgba(34,223,243,.1)!important}
.brand{gap:9px!important;width:auto!important;min-width:185px!important;justify-content:flex-start!important}.brand img{width:42px!important;height:42px!important;object-fit:contain!important}.jm-brand-copy{display:flex;flex-direction:column;line-height:1}.jm-brand-copy b{font-size:.78rem;letter-spacing:-.02em}.jm-brand-copy strong{font-size:.9rem;color:var(--jm-cyan);margin-top:3px}.jm-brand-copy small{font-size:.48rem;color:var(--jm-muted);letter-spacing:.1em;margin-top:4px;text-transform:uppercase}
.hero-box{min-height:390px!important;background:radial-gradient(circle at 82% 20%,rgba(34,223,243,.15),transparent 30%),radial-gradient(circle at 68% 88%,rgba(57,223,124,.06),transparent 30%),linear-gradient(135deg,#0b2031,#06121e 55%,#081724)!important;border-color:rgba(34,223,243,.17)!important}.hero-brand-top{display:flex;align-items:center;gap:14px}.hero-brand-top img{width:76px!important;height:76px!important;object-fit:contain!important}.hero-brand-slogan{font-size:.82rem!important;color:#dff9ff!important}.hero-title-line{max-width:760px!important}.hero-title-line strong{color:var(--jm-cyan)!important}.hero p{color:#b9cddd!important}.hero-mini div{background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025))!important;border-color:var(--jm-line)!important}.hero-mini b{color:var(--jm-cyan)!important}
.benefit{border-color:var(--jm-line)!important;background:linear-gradient(145deg,rgba(9,27,41,.95),rgba(5,18,29,.95))!important}.benefit i{background:rgba(34,223,243,.08)!important;color:var(--jm-cyan)!important}
.section-title span,.price{color:var(--jm-cyan)!important}.cat.active{background:linear-gradient(135deg,var(--jm-cyan),#15b8e5)!important;color:#041018!important}.products{grid-template-columns:repeat(auto-fit,minmax(235px,1fr))!important}.product{background:linear-gradient(180deg,#0b1d2d,#071522)!important;border-color:rgba(95,208,234,.12)!important}.product-image{aspect-ratio:4/3!important}.product-body{gap:8px!important}.product-cat{color:#75a9bd!important}.jm-product-meta{display:flex;gap:6px;flex-wrap:wrap}.jm-product-meta span{font-size:.55rem;padding:4px 7px;border-radius:999px;border:1px solid rgba(91,211,236,.11);background:rgba(34,223,243,.045);color:#a8ccda}.jm-product-availability{font-size:.61rem;font-weight:850;color:var(--jm-green)}.jm-product-availability.low{color:var(--jm-amber)}.jm-product-availability.out{color:var(--jm-red)}.product-actions{grid-template-columns:1fr 40px 1fr!important}.product-actions .add{background:linear-gradient(135deg,var(--jm-cyan),#1aa6ee)!important}.product-actions .support{background:linear-gradient(135deg,#35dc79,#1ab961)!important}
.footer{background:radial-gradient(circle at 12% 0%,rgba(34,223,243,.06),transparent 30%),linear-gradient(180deg,#061521,#02070d)!important}.footer-logo{width:84px!important;height:84px!important;object-fit:contain!important}.jm-footer-brand{display:flex;gap:12px;align-items:center;margin-bottom:12px}.jm-footer-brand h3{font-size:1.05rem;margin:0}.jm-footer-brand strong{color:var(--jm-cyan)}
#combos.jm-hidden{display:none!important}
#checkoutModal .notice{background:rgba(34,223,243,.06)!important;border-color:rgba(34,223,243,.13)!important;color:#d9f8ff!important}
/* Panel administrativo digital */
#adminOverlay{background:#02070d!important;color:var(--jm-text)!important}.jm-admin-shell{height:100dvh;display:grid;grid-template-columns:238px minmax(0,1fr);background:#02070d}.jm-admin-side{padding:16px 12px;background:linear-gradient(180deg,#061522,#03101a);border-right:1px solid var(--jm-line);overflow:auto}.jm-admin-brand{display:flex;align-items:center;gap:10px;padding:4px 5px 16px;border-bottom:1px solid var(--jm-line)}.jm-admin-brand img{width:48px;height:48px;object-fit:contain}.jm-admin-brand b{display:block;font-size:.82rem}.jm-admin-brand strong{display:block;color:var(--jm-cyan);font-size:.94rem;margin-top:2px}.jm-admin-brand small{display:block;color:var(--jm-muted);font-size:.58rem;margin-top:4px}.jm-admin-nav{display:grid;gap:5px;margin-top:13px}.jm-admin-nav button{min-height:42px;border:0;border-radius:12px;padding:9px 10px;background:transparent;color:#9ab3c6;text-align:left;font-size:.72rem;font-weight:850;display:flex;align-items:center;gap:9px}.jm-admin-nav button:hover,.jm-admin-nav button.active{background:rgba(34,223,243,.09);color:var(--jm-cyan)}.jm-admin-nav i{font-style:normal;width:22px;text-align:center}.jm-admin-side-note{margin-top:16px;padding:10px;border-radius:13px;border:1px solid rgba(57,223,124,.12);background:rgba(57,223,124,.04);color:#9bc9ac;font-size:.6rem;line-height:1.5}.jm-admin-main{min-width:0;overflow:auto}.jm-admin-top{position:sticky;top:0;z-index:5;min-height:68px;padding:10px 16px;background:rgba(2,7,13,.96);border-bottom:1px solid var(--jm-line);display:flex;align-items:center;justify-content:space-between;gap:10px}.jm-admin-top small{display:block;font-size:.58rem;color:var(--jm-muted);text-transform:uppercase;letter-spacing:.08em}.jm-admin-top h1{font-size:1.05rem;margin-top:3px}.jm-admin-actions{display:flex;gap:7px}.jm-admin-actions button{min-height:36px;padding:7px 11px;border-radius:10px;border:1px solid var(--jm-line);background:rgba(255,255,255,.035);color:var(--jm-text);font-size:.66rem;font-weight:850}.jm-admin-content{padding:18px;max-width:1420px;margin:auto}.jm-admin-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.jm-metric{min-height:102px;padding:14px;border-radius:17px;border:1px solid var(--jm-line);background:linear-gradient(145deg,#0a1b2a,#061421);display:flex;flex-direction:column;justify-content:space-between}.jm-metric small{color:var(--jm-muted);font-size:.62rem}.jm-metric strong{font-size:1.45rem;color:var(--jm-cyan);letter-spacing:-.04em}.jm-metric span{font-size:.56rem;color:#7895a9}.jm-admin-card{margin-top:12px;padding:14px;border-radius:18px;border:1px solid var(--jm-line);background:linear-gradient(145deg,#091a29,#06131f)}.jm-admin-card:first-child{margin-top:0}.jm-admin-card-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:11px}.jm-admin-card-head h2{font-size:.92rem}.jm-admin-card-head p{font-size:.6rem;color:var(--jm-muted);margin-top:3px}.jm-toolbar{display:flex;gap:7px;flex-wrap:wrap}.jm-toolbar input,.jm-toolbar select,.jm-admin-card input,.jm-admin-card select,.jm-admin-card textarea{min-height:38px;border-radius:10px;border:1px solid rgba(117,199,220,.13);background:#071521;color:var(--jm-text);padding:7px 9px;font-size:.68rem;outline:0}.jm-admin-card textarea{min-height:84px;resize:vertical}.jm-toolbar button,.jm-btn{min-height:36px;padding:7px 11px;border-radius:10px;border:1px solid var(--jm-line);background:rgba(255,255,255,.04);color:var(--jm-text);font-size:.65rem;font-weight:850}.jm-btn.primary{background:linear-gradient(135deg,var(--jm-cyan),#17aee2);color:#021017;border:0}.jm-btn.green{background:linear-gradient(135deg,#34db78,#18b85e);color:white;border:0}.jm-btn.red{color:#ff8193;border-color:rgba(255,100,124,.2);background:rgba(255,100,124,.07)}.jm-table-wrap{overflow:auto;border:1px solid var(--jm-line);border-radius:13px}.jm-table{width:100%;border-collapse:collapse;min-width:820px}.jm-table th,.jm-table td{padding:10px;border-bottom:1px solid rgba(110,188,207,.08);font-size:.64rem;text-align:left;vertical-align:middle}.jm-table th{color:#718fa4;background:#06131e;position:sticky;top:0}.jm-table img{width:54px;height:42px;border-radius:8px;object-fit:cover}.jm-status{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:.55rem;font-weight:900;background:rgba(34,223,243,.08);color:var(--jm-cyan)}.jm-status.ok{background:rgba(57,223,124,.08);color:var(--jm-green)}.jm-status.warn{background:rgba(255,181,71,.09);color:var(--jm-amber)}.jm-status.bad{background:rgba(255,100,124,.09);color:var(--jm-red)}.jm-records{display:grid;gap:8px}.jm-record{padding:11px;border-radius:13px;border:1px solid rgba(96,194,217,.1);background:rgba(255,255,255,.025);display:flex;justify-content:space-between;align-items:center;gap:10px}.jm-record h3{font-size:.72rem}.jm-record p{font-size:.59rem;color:var(--jm-muted);margin-top:3px;line-height:1.45}.jm-record aside{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}.jm-empty{padding:28px;text-align:center;color:var(--jm-muted);border:1px dashed var(--jm-line);border-radius:13px}.jm-quick-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.jm-quick{padding:13px;border-radius:16px;border:1px solid var(--jm-line);background:rgba(255,255,255,.025);cursor:pointer}.jm-quick b{display:block;font-size:.72rem}.jm-quick p{font-size:.58rem;color:var(--jm-muted);margin-top:4px}.jm-digital-banner{padding:14px;border-radius:18px;border:1px solid rgba(57,223,124,.14);background:linear-gradient(135deg,rgba(57,223,124,.07),rgba(34,223,243,.04));display:flex;justify-content:space-between;gap:12px;align-items:center}.jm-digital-banner b{font-size:.82rem}.jm-digital-banner p{font-size:.62rem;color:#90b8a0;margin-top:4px}.jm-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.jm-field{display:grid;gap:5px}.jm-field.full{grid-column:1/-1}.jm-field label{font-size:.6rem;color:#9ab4c5;font-weight:800}.jm-form-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}.jm-product-name{display:flex;align-items:center;gap:8px}.jm-order-items{margin-top:5px;color:#9cb8ca;font-size:.58rem}.jm-order-data{margin-top:5px;color:#82b9c8;font-size:.56rem}.jm-admin-menu{display:none}
@media(max-width:980px){.jm-admin-shell{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}.jm-admin-side{padding:8px 10px;overflow-x:auto;overflow-y:hidden;border-right:0;border-bottom:1px solid var(--jm-line)}.jm-admin-brand{display:none}.jm-admin-nav{display:flex;width:max-content;margin:0}.jm-admin-nav button{white-space:nowrap}.jm-admin-side-note{display:none}.jm-admin-main{min-height:0}.jm-admin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.jm-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.brand{min-width:0!important}.jm-brand-copy small{display:none}.jm-brand-copy b{font-size:.67rem}.jm-brand-copy strong{font-size:.74rem}.hero-brand-top img{width:58px!important;height:58px!important}.products{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important}.product-body{padding:9px!important}.jm-product-meta span{font-size:.5rem}.jm-admin-content{padding:10px}.jm-admin-top{padding:8px 10px}.jm-admin-top h1{font-size:.9rem}.jm-admin-grid{gap:7px}.jm-metric{min-height:84px;padding:10px}.jm-metric strong{font-size:1.18rem}.jm-quick-grid{grid-template-columns:1fr 1fr}.jm-form-grid{grid-template-columns:1fr}.jm-field.full{grid-column:auto}.jm-record{align-items:flex-start;flex-direction:column}.jm-record aside{justify-content:flex-start}.jm-admin-card{padding:11px}.jm-admin-card-head{align-items:flex-start;flex-direction:column}.jm-toolbar{width:100%}.jm-toolbar input,.jm-toolbar select{flex:1 1 130px}.jm-digital-banner{align-items:flex-start;flex-direction:column}}
</style>
<script id="jm-digital-v1-script">
(function(){
  'use strict';
  const VERSION='1.0.0';
  const byId=id=>document.getElementById(id);
  const q=(s,r=document)=>r.querySelector(s);
  const qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const html=v=>typeof esc==='function'?esc(String(v??'')):String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const cash=v=>typeof money==='function'?money(Number(v||0)):`Q${Number(v||0).toFixed(2)}`;
  const phoneDigits=v=>String(v||'').replace(/\D/g,'');
  const orderStatuses=['Nuevo','Pago pendiente','Pago confirmado','Preparando acceso','Entregado digital','Completado','Cancelado'];
  const paidStatuses=new Set(['Pago confirmado','Preparando acceso','Entregado digital','Completado','Entregado']);
  const completeStatuses=new Set(['Entregado digital','Completado','Entregado']);
  const typeLabel=p=>p.digitalType||'Servicio digital';
  const deliveryLabel=p=>p.deliveryMode||'Entrega digital';
  const availability=p=>{
    if(p.availabilityMode==='unlimited')return {text:'Disponible',cls:'',admin:'Ilimitado'};
    const n=Number(p.stock||0);if(n<=0)return{text:'Sin disponibilidad',cls:'out',admin:'Agotado'};if(n<=Number(state.settings.lowStock||3))return{text:`${n} cupos disponibles`,cls:'low',admin:`${n} cupos`};return{text:`${n} cupos disponibles`,cls:'',admin:`${n} cupos`};
  };
  function normalizeDigitalProduct(p){
    if(!p)return p;
    p.digitalType=p.digitalType||(/diamant|recarga/i.test(`${p.name} ${p.category}`)?'Recarga digital':/curso/i.test(`${p.name} ${p.category}`)?'Curso digital':'Servicio digital');
    p.platform=p.platform||p.category||'';p.duration=p.duration||'';p.deliveryMode=p.deliveryMode||'Entrega digital';p.requiresData=p.requiresData||'Datos de contacto para coordinar la activación';p.availabilityMode=p.availabilityMode||'limited';
    if(p.availabilityMode==='unlimited'&&Number(p.stock||0)<9999)p.stock=9999;
    return p;
  }
  (state.products||[]).forEach(normalizeDigitalProduct);
  Object.assign(state.settings,{storeName:state.settings.storeName||'CRULOX',slogan:state.settings.slogan||'Plataformas Digitales',whatsappPhone:state.settings.whatsappPhone||'+502 30983655',socialHandle:state.settings.socialHandle||'crulox',paymentMethods:state.settings.paymentMethods||'Banrural, Industrial, Azteca, PayPal, Remesas',activationText:state.settings.activationText||'Activación o entrega digital coordinada',digitalPolicy:state.settings.digitalPolicy||'No realizamos entregas físicas.'});
  try{write(KEYS.products,state.products);write(KEYS.settings,state.settings)}catch(e){}

  function brandMarkup(compact=false){return `<img src="${html(BRAND_LOGO_FULL)}" alt="CRULOX">`}
  function patchPublic(){
    document.title='CRULOX · Servicios digitales';
    q('meta[name="theme-color"]')?.setAttribute('content','#02070d');
    const brand=q('.brand');if(brand){let img=brand.querySelector('img');if(!img){brand.innerHTML=brandMarkup()}else if(img.getAttribute('src')!==BRAND_LOGO_FULL){img.src=BRAND_LOGO_FULL}}
    const drawerLogo=q('.drawer-logo');if(drawerLogo){drawerLogo.src=BRAND_LOGO;drawerLogo.alt='CRULOX';drawerLogo.style.width='82px';drawerLogo.style.height='82px'}
    const heroTop=q('.hero-brand-top');if(heroTop){let img=heroTop.querySelector('img');if(!img){heroTop.innerHTML=`<img src="${html(BRAND_LOGO_FULL)}" alt="CRULOX">`}else if(img.getAttribute('src')!==BRAND_LOGO_FULL){img.src=BRAND_LOGO_FULL}}
    const heroTitle=q('.hero-title-line');if(heroTitle)heroTitle.innerHTML='Elige <span>·</span> Compra <span>·</span> <strong>Recibe digital.</strong>';
    const heroSubtitle=byId('heroSubtitle');if(heroSubtitle)heroSubtitle.textContent=state.settings.subtitle||'Servicios digitales con atención directa y activación coordinada.';
    const minis=qa('.hero-mini>div');[['100% DIGITAL','Sin envíos físicos'],['CHAT INTERNO','Atención dentro del sistema'],['5 MÉTODOS','Pagos disponibles']].forEach((x,i)=>{if(minis[i])minis[i].innerHTML=`<b>${x[0]}</b><span>${x[1]}</span>`});
    const benefits=qa('.benefit-grid .benefit');const bd=[['⚡','Entrega digital','Recibes acceso, recarga o activación'],['✓','Datos claros','Solo pedimos lo necesario'],['🔒','Compra acompañada','Confirmación antes de completar'],['💬','Chat interno','Soporte desde tu cuenta']];bd.forEach((x,i)=>{if(benefits[i])benefits[i].innerHTML=`<i>${x[0]}</i><div><b>${x[1]}</b><span>${x[2]}</span></div>`});
    const cat=q('#catalog .section-head>div');if(cat)cat.innerHTML='<span class="section-kicker">Todo lo que vendemos es digital</span><h2 class="section-title">Servicios <span>disponibles</span></h2>';
    const combo=byId('combos');if(combo){combo.classList.toggle('jm-hidden',!(state.combos||[]).length);const c=combo.querySelector('.section-head>div');if(c)c.innerHTML='<span class="section-kicker">Opciones agrupadas</span><h2 class="section-title">Paquetes <span>digitales</span></h2>'}
    const how=q('#how .section-head>div');if(how)how.innerHTML='<span class="section-kicker">Sin envíos ni direcciones</span><h2 class="section-title">Comprar es <span>simple</span></h2>';
    const steps=qa('#how .step');const sd=[['1','Elige tu servicio','Revisa la plataforma, recarga, curso o acceso que necesitas.'],['2','Confirma tus datos','Indica únicamente los datos necesarios para activar o entregar el servicio.'],['3','Recibe digital','Consulta el estado y recibe tu servicio dentro de CruLox.']];sd.forEach((x,i)=>{if(steps[i])steps[i].innerHTML=`<b>${x[0]}</b><h3>${x[1]}</h3><p>${x[2]}</p>`});
    const search=byId('searchInput');if(search)search.placeholder='Buscar plataformas, diamantes, perfiles o cursos...';
    const cartTitle=q('#cartPanel .panel-head h2');if(cartTitle)cartTitle.textContent='🛒 Pedidos';
    const checkoutBtn=byId('checkoutBtn');if(checkoutBtn)checkoutBtn.textContent='Continuar pedido';
    const detailTitle=q('#detailModal .modal-head h2');if(detailTitle)detailTitle.textContent='Detalle del servicio';
    const accountTitle=q('#accountModal .modal-head h2');if(accountTitle)accountTitle.textContent='Cuenta CRULOX';
    const checkoutTitle=q('#checkoutModal .modal-head h2');if(checkoutTitle)checkoutTitle.textContent='Confirmar pedido digital';
    const notice=q('#checkoutModal .checkout-safe-notice');if(notice)notice.innerHTML='🔒 <strong>Tu información se usa solo para gestionar este pedido digital.</strong> Revisa los datos antes de enviarlo.';
    const notes=byId('coNotes');if(notes)notes.placeholder='Detalles adicionales del servicio (opcional)';
    const footerLogo=q('.footer-logo');if(footerLogo){footerLogo.src=BRAND_LOGO_FULL;footerLogo.alt='CRULOX';}
    const footerSub=byId('footerSubtitle');if(footerSub)footerSub.textContent='Perfiles, suscripciones, recargas, cursos y otros servicios digitales. Sin entregas físicas.';
    const footerEmail=byId('footerEmail');if(footerEmail){footerEmail.textContent=`📱 ${state.settings.whatsappPhone||'+502 30983655'}`;footerEmail.href=`https://wa.me/${phoneDigits(state.settings.whatsappPhone||'+502 30983655')}`}
    const footerSupport=byId('footerSupport');if(footerSupport)footerSupport.textContent='💬 Chat interno';
    const copyright=q('.copyright');if(copyright&&!copyright.classList.contains('cru450-copyright'))copyright.innerHTML='<span>© 2026 CRULOX.</span><span>Servicios 100% digitales · Sin envíos físicos.</span>';
    const heroSupport=byId('heroSupport');if(heroSupport)heroSupport.textContent='Abrir chat';
    qa('.drawer nav a').forEach(a=>{if(a.getAttribute('href')==='#catalog')a.innerHTML='▦ Servicios digitales';if(a.getAttribute('href')==='#combos')a.innerHTML='✦ Paquetes';if(a.getAttribute('href')==='#how')a.innerHTML='✓ Cómo comprar'});
  }

  function jmProductCard(p){
    normalizeDigitalProduct(p);const av=availability(p),fav=state.favorites.includes(p.id),discount=p.oldPrice?Math.max(0,Math.round((1-Number(p.price)/Number(p.oldPrice))*100)):0;
    return `<article class="product" data-product="${html(p.id)}"><div class="product-image"><img src="${html(p.image||BRAND_LOGO)}" alt="${html(p.name)}" loading="lazy" decoding="async">${p.badgeText?`<span class="badge">${html(p.badgeText)}</span>`:''}<button class="fav-btn ${fav?'active':''}" data-fav="${html(p.id)}" aria-label="Favorito">${fav?'♥':'♡'}</button></div><div class="product-body"><span class="product-cat">${html(p.category||'Servicio digital')}</span><h3>${html(p.name)}</h3><div class="jm-product-meta"><span>${html(typeLabel(p))}</span>${p.duration?`<span>${html(p.duration)}</span>`:''}<span>${html(deliveryLabel(p))}</span></div><div class="price-row"><strong class="price">${cash(p.price)}</strong>${p.oldPrice?`<span class="old">${cash(p.oldPrice)}</span>`:''}${discount?`<span class="discount">-${discount}%</span>`:''}</div><span class="jm-product-availability ${av.cls}">${html(av.text)}</span><div class="product-actions"><button class="add" data-add="${html(p.id)}" ${p.availabilityMode!=='unlimited'&&Number(p.stock)<=0?'disabled':''}>Solicitar</button><button class="support" data-support="${html(p.id)}" aria-label="Consultar">💬</button><button class="detail" data-detail="${html(p.id)}">Detalles</button></div></div></article>`;
  }
  try{productCard=jmProductCard;window.productCard=jmProductCard}catch(e){}
  try{stockInfo=function(p){const a=availability(p);return[a.text,a.cls]};window.stockInfo=stockInfo}catch(e){}
  const baseRenderStore=window.renderStore;
  if(typeof baseRenderStore==='function'){window.renderStore=function(){const r=baseRenderStore();patchPublic();return r};try{renderStore=window.renderStore}catch(e){}}

  function digitalAccountFields(){return[{key:'fullName',label:'Nombre completo',required:true,full:true},{key:'username',label:'Usuario',required:true},{key:'email',label:'Correo',type:'email',required:true},{key:'phone',label:'WhatsApp / teléfono',required:true}]}
  try{accountFields=digitalAccountFields;window.accountFields=digitalAccountFields}catch(e){}
  const baseRegister=window.renderRegister;
  if(typeof baseRegister==='function'){window.renderRegister=function(){baseRegister();const label=q('#regConsent')?.closest('label');if(label)label.innerHTML='<input id="regConsent" type="checkbox" style="width:auto;min-height:0"> Acepto que mis datos se utilicen para gestionar pedidos y activaciones digitales.';byId('registerForm').onsubmit=window.handleRegister||handleRegister};try{renderRegister=window.renderRegister}catch(e){}}
  function jmRenderAccount(){
    const user=currentUser();if(!user){byId('accountBody').innerHTML='<div class="tabs"><button class="tab active" data-auth-tab="login">Iniciar sesión</button><button class="tab" data-auth-tab="register">Crear cuenta</button></div><div id="authContent"></div>';qa('[data-auth-tab]',byId('accountBody')).forEach(t=>t.onclick=()=>{qa('.tab',byId('accountBody')).forEach(x=>x.classList.toggle('active',x===t));t.dataset.authTab==='login'?renderLogin():renderRegister()});renderLogin();return}
    byId('accountBody').innerHTML=`<div class="profile-card"><span class="section-kicker">Cuenta digital</span><h3>${html(user.fullName||user.username)}</h3><div class="profile-grid">${[['Usuario',user.username],['Correo',user.email],['WhatsApp / teléfono',user.phone]].map(([a,b])=>`<div class="profile-info"><small>${a}</small><b>${html(b||'—')}</b></div>`).join('')}</div><div class="form-actions"><button class="btn btn-primary" id="editProfile">Editar perfil</button><button class="btn btn-secondary" id="profileOrders">Mis pedidos</button><button class="btn btn-red" id="logoutClient">Cerrar sesión</button></div></div>`;
    byId('editProfile').onclick=()=>renderProfileEditor(user);byId('profileOrders').onclick=renderClientOrders;byId('logoutClient').onclick=()=>{state.session=null;write(KEYS.session,null);renderHeader();jmRenderAccount();toast('Sesión cerrada.','success')};
  }
  try{renderAccount=jmRenderAccount;window.renderAccount=jmRenderAccount}catch(e){}

  function checkoutFieldHtml(label,key,value,full=false){return `<div class="field ${full?'full':''}"><label>${html(label)}</label><input id="co${key}" value="${html(value||'')}" readonly></div>`}
  function jmOpenCheckout(){
    if(!state.cart.length)return toast('Tu pedido está vacío.','warn');const user=currentUser();if(!user){closeAllPanels();renderAccount();openModal('accountModal');toast('Inicia sesión o crea una cuenta para continuar.','warn');return}
    const items=typeof cartDetails==='function'?cartDetails():[];const requirements=[...new Set(items.map(i=>i.requiresData).filter(Boolean))];
    byId('checkoutFields').innerHTML=`${checkoutFieldHtml('Nombre completo','FullName',user.fullName,true)}${checkoutFieldHtml('Correo','Email',user.email)}${checkoutFieldHtml('WhatsApp / teléfono','Phone',user.phone)}<div class="field"><label>Canal preferido</label><select id="coDigitalChannel"><option>WhatsApp</option><option>Correo</option></select></div><div class="field full"><label>Datos necesarios para el servicio</label><textarea id="coServiceData" placeholder="${html(requirements.length?requirements.join(' · '):'Escribe los datos necesarios para activar o entregar el servicio')}"></textarea>${requirements.length?`<small style="color:var(--muted);font-size:.58rem">Este pedido puede requerir: ${html(requirements.join(' · '))}</small>`:''}</div>`;
    const notes=byId('coNotes');if(notes)notes.placeholder='Observaciones adicionales (opcional)';closeAllPanels();openModal('checkoutModal');
  }
  function jmBuildOrder(user,items,notes=''){
    const subtotal=items.reduce((s,i)=>s+Number(i.price||0)*Number(i.qty||0),0);const promoResult=typeof currentPromoResult==='function'?currentPromoResult(subtotal):null;const discount=promoResult?.discount||0;
    return {id:typeof npSecureOrderId==='function'?npSecureOrderId():`JM-${Date.now()}`,schemaVersion:3,businessModel:'digital-only',userId:user.id,customer:{fullName:user.fullName,email:user.email,phone:user.phone},digital:{channel:byId('coDigitalChannel')?.value||'WhatsApp',serviceData:String(byId('coServiceData')?.value||'').trim().slice(0,1200)},items:items.map(i=>({type:'digital',id:i.id,name:i.name,price:Number(i.price),qty:Number(i.qty),category:i.category||'',digitalType:i.digitalType||'',platform:i.platform||'',duration:i.duration||'',deliveryMode:i.deliveryMode||'',requiresData:i.requiresData||''})),subtotal,discount,promotion:promoResult?{code:promoResult.promo.code,type:promoResult.promo.type,value:promoResult.promo.value}:null,total:Math.max(0,subtotal-discount),notes:String(notes||'').trim().slice(0,600),status:'Nuevo',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
  }
  function jmOrderMessage(o){return `🧾 Pedido digital ${o.id} - CRULOX\nCliente: ${o.customer?.fullName||''}\nCorreo: ${o.customer?.email||''}\nWhatsApp: ${o.customer?.phone||''}\nCanal: ${o.digital?.channel||'WhatsApp'}\nServicios:\n${(o.items||[]).map(i=>`• ${i.name} x${i.qty} = ${cash(i.price*i.qty)}`).join('\n')}\nDatos de activación: ${o.digital?.serviceData||'No indicados'}\nTotal: ${cash(o.total)}\nEstado: ${o.status||'Nuevo'}\nNotas: ${o.notes||'Ninguna'}`}
  function jmOrderExtras(o){return {'Pedido ID':o.id,Nombre:o.customer?.fullName||'',Correo:o.customer?.email||'',WhatsApp:o.customer?.phone||'',Canal:o.digital?.channel||'WhatsApp',Servicios:(o.items||[]).map(i=>`${i.name} x${i.qty}`).join(', '),'Datos de activación':o.digital?.serviceData||'',Total:cash(o.total),Notas:o.notes||'Ninguna',Tipo:'Pedido digital',Estado:o.status||'Nuevo'}}
  let sending=false;
  async function jmSubmitOrder(e){
    e?.preventDefault?.();if(sending)return toast('El pedido ya se está procesando.','warn');const user=currentUser();if(!user)return jmOpenCheckout();const items=typeof cartDetails==='function'?cartDetails():[];if(!items.length)return toast('Tu pedido está vacío.','warn');const required=items.some(i=>String(i.requiresData||'').trim());const serviceData=String(byId('coServiceData')?.value||'').trim();if(required&&!serviceData){byId('coServiceData')?.focus();return showModalNotice?showModalNotice('Escribe los datos necesarios para poder activar o entregar el servicio.','warn','checkoutModal'):toast('Completa los datos del servicio.','warn')}
    sending=true;const btn=q('#checkoutForm [type="submit"]');if(btn){btn.disabled=true;btn.textContent='Enviando…'};try{const order=jmBuildOrder(user,items,byId('coNotes')?.value||'');registerOrder(order);if(order.promotion&&typeof findPromo==='function'&&typeof NP_PROMOS_KEY!=='undefined'){const promo=findPromo(order.promotion.code);if(promo){promo.uses=Number(promo.uses||0)+1;write(NP_PROMOS_KEY,state.promos)}}state.cart=[];state.appliedPromoCode='';write(KEYS.cart,state.cart);if(typeof NP_APPLIED_PROMO_KEY!=='undefined')write(NP_APPLIED_PROMO_KEY,'');renderHeader();renderCart();closeModal('checkoutModal');if(byId('coNotes'))byId('coNotes').value='';toast(`Pedido ${order.id} enviado correctamente.`,'success')}catch(err){console.error(err);toast('No fue posible enviar el pedido.','error')}finally{sending=false;if(btn){btn.disabled=false;btn.textContent='Enviar pedido'}}
  }
  try{openCheckout=jmOpenCheckout;window.openCheckout=jmOpenCheckout;buildOrder=jmBuildOrder;window.buildOrder=jmBuildOrder;orderMessage=jmOrderMessage;window.orderMessage=jmOrderMessage;orderExtras=jmOrderExtras;window.orderExtras=jmOrderExtras;submitOrder=jmSubmitOrder;window.submitOrder=jmSubmitOrder}catch(e){}
  if(byId('checkoutBtn'))byId('checkoutBtn').onclick=jmOpenCheckout;if(byId('checkoutForm'))byId('checkoutForm').onsubmit=jmSubmitOrder;

  /* ---------- Administración digital ---------- */
  const adminOverlay=byId('adminOverlay');
  const sectionAlias={dashboard:'home',home:'home',products:'services',inventory:'availability',categories:'services',orders:'orders',users:'clients',promotions:'promotions',bots:'messages',settings:'settings',backup:'settings',activity:'home','np-toolbox':'home'};
  const navItems=[['home','⌂','Inicio'],['services','▦','Servicios'],['availability','◫','Disponibilidad'],['orders','🧾','Pedidos'],['clients','👥','Clientes'],['promotions','🎟','Promociones'],['messages','💬','Atención'],['settings','⚙','Ajustes']];
  function ensureAdminShell(){
    if(!adminOverlay)return null;if(adminOverlay.dataset.jmDigitalShell==='1')return byId('adminContent');adminOverlay.dataset.jmDigitalShell='1';
    adminOverlay.innerHTML=`<div class="jm-admin-shell"><aside class="jm-admin-side"><div class="jm-admin-brand"><img src="${html(BRAND_LOGO)}" alt="CRULOX"><div><b>CRU</b><strong>LOX</strong><small>Panel · Negocio 100% digital</small></div></div><nav class="jm-admin-nav" id="adminNav">${navItems.map(([id,icon,label])=>`<button type="button" data-jm-section="${id}"><i>${icon}</i><span>${label}</span></button>`).join('')}</nav><div class="jm-admin-side-note"><b>Modelo digital</b><br>Perfiles, suscripciones, diamantes, cursos, membresías y otros servicios sin entrega física.</div></aside><main class="jm-admin-main"><header class="jm-admin-top"><div><small>Centro de control</small><h1 id="adminTitle">Inicio</h1></div><div class="jm-admin-actions"><button type="button" id="adminStoreBtn">Ver tienda</button><button type="button" id="adminLogout">Salir</button></div></header><div id="adminBreadcrumb" hidden></div><div id="adminSubnavWrap" hidden></div><section class="jm-admin-content" id="adminContent"></section></main></div>`;
    byId('adminNav').onclick=e=>{const b=e.target.closest('[data-jm-section]');if(b)jmRenderAdmin(b.dataset.jmSection)};byId('adminStoreBtn').onclick=()=>{adminOverlay.classList.remove('open');document.body.classList.remove('lock')};byId('adminLogout').onclick=()=>{state.session=null;write(KEYS.session,null);adminOverlay.classList.remove('open');document.body.classList.remove('lock');renderHeader();toast('Sesión administrativa cerrada.','success')};return byId('adminContent');
  }
  function markAdminNav(section){qa('[data-jm-section]',byId('adminNav')||document).forEach(b=>b.classList.toggle('active',b.dataset.jmSection===section))}
  function metricCard(label,value,sub=''){return `<article class="jm-metric"><small>${html(label)}</small><strong>${html(value)}</strong><span>${html(sub)}</span></article>`}
  function paidRevenue(){return (state.orders||[]).filter(o=>paidStatuses.has(o.status)).reduce((s,o)=>s+Number(o.total||0),0)}
  function pendingOrders(){return (state.orders||[]).filter(o=>!completeStatuses.has(o.status)&&o.status!=='Cancelado').length}
  function lowServices(){return (state.products||[]).filter(p=>p.availabilityMode!=='unlimited'&&Number(p.stock)>0&&Number(p.stock)<=Number(state.settings.lowStock||3)).length}
  function homeAdmin(){
    const services=state.products.length,orders=state.orders.length,clients=state.users.length,completed=state.orders.filter(o=>completeStatuses.has(o.status)).length;
    byId('adminContent').innerHTML=`<section class="jm-digital-banner"><div><b>Negocio configurado como 100% digital</b><p>El panel ya no gestiona envíos, direcciones, empaque ni despacho físico. Todo gira alrededor de activaciones, accesos, recargas, cursos y perfiles.</p></div><span class="jm-status ok">V1 DIGITAL</span></section><div class="jm-admin-grid" style="margin-top:12px">${metricCard('Servicios',services,'catálogo digital')}${metricCard('Pedidos pendientes',pendingOrders(),'requieren atención')}${metricCard('Ingresos confirmados',cash(paidRevenue()),'según estados pagados')}${metricCard('Clientes',clients,'cuentas registradas')}${metricCard('Pedidos totales',orders,'histórico')}${metricCard('Completados',completed,'entrega digital')}${metricCard('Disponibilidad baja',lowServices(),'cupos limitados')}${metricCard('Métodos de pago','5','Banrural · BI · Azteca · PayPal · Remesas')}</div><section class="jm-admin-card"><div class="jm-admin-card-head"><div><h2>Acciones rápidas</h2><p>Lo que realmente necesitas operar el negocio.</p></div></div><div class="jm-quick-grid"><button class="jm-quick" data-quick="services"><b>＋ Nuevo servicio</b><p>Crear plataforma, perfil, recarga o curso.</p></button><button class="jm-quick" data-quick="orders"><b>🧾 Pedidos digitales</b><p>Pago, activación y entrega.</p></button><button class="jm-quick" data-quick="messages"><b>💬 Atención</b><p>Conversaciones con clientes.</p></button><button class="jm-quick" data-quick="availability"><b>◫ Disponibilidad</b><p>Cupos limitados o servicios ilimitados.</p></button></div></section>`;
    qa('[data-quick]',byId('adminContent')).forEach(b=>b.onclick=()=>b.dataset.quick==='services'?openServiceEditor():jmRenderAdmin(b.dataset.quick));
  }
  function serviceRows(list){return list.map(p=>{const av=availability(p);return `<tr><td><div class="jm-product-name"><img src="${html(p.image||BRAND_LOGO)}" alt=""><div><b>${html(p.name)}</b><br><small>${html(typeLabel(p))}</small></div></div></td><td>${html(p.category||'—')}</td><td>${html(p.platform||'—')}</td><td>${cash(p.price)}</td><td><span class="jm-status ${av.cls==='out'?'bad':av.cls==='low'?'warn':'ok'}">${html(av.admin)}</span></td><td>${html(p.duration||'—')}</td><td><div class="jm-toolbar"><button class="jm-btn" data-edit-service="${html(p.id)}">Editar</button><button class="jm-btn" data-copy-service="${html(p.id)}">Duplicar</button><button class="jm-btn red" data-delete-service="${html(p.id)}">Eliminar</button></div></td></tr>`}).join('')}
  function servicesAdmin(){
    byId('adminContent').innerHTML=`<section class="jm-admin-card"><div class="jm-admin-card-head"><div><h2>Servicios digitales</h2><p>Perfiles, plataformas, diamantes, cursos, membresías y cualquier producto sin entrega física.</p></div><div class="jm-toolbar"><input id="jmServiceSearch" placeholder="Buscar servicio"><select id="jmServiceCategory"><option value="all">Todas las categorías</option>${[...new Set(state.products.map(p=>p.category).filter(Boolean))].map(c=>`<option>${html(c)}</option>`).join('')}</select><button class="jm-btn primary" id="jmAddService">Nuevo servicio</button></div></div><div class="jm-table-wrap"><table class="jm-table"><thead><tr><th>Servicio</th><th>Categoría</th><th>Plataforma</th><th>Precio</th><th>Disponibilidad</th><th>Duración</th><th>Acciones</th></tr></thead><tbody id="jmServiceRows"></tbody></table></div></section>`;
    const draw=()=>{const s=String(byId('jmServiceSearch').value||'').toLowerCase(),c=byId('jmServiceCategory').value;const list=state.products.filter(p=>(c==='all'||p.category===c)&&(!s||`${p.name} ${p.category} ${p.platform} ${p.digitalType}`.toLowerCase().includes(s)));byId('jmServiceRows').innerHTML=serviceRows(list)||'<tr><td colspan="7"><div class="jm-empty">No hay servicios.</div></td></tr>';qa('[data-edit-service]',byId('jmServiceRows')).forEach(b=>b.onclick=()=>openServiceEditor(b.dataset.editService));qa('[data-copy-service]',byId('jmServiceRows')).forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.copyService);if(!p)return;state.products.unshift({...JSON.parse(JSON.stringify(p)),id:uid('svc'),name:`${p.name} copia`});write(KEYS.products,state.products);renderStore();draw();toast('Servicio duplicado.','success')});qa('[data-delete-service]',byId('jmServiceRows')).forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>x.id===b.dataset.deleteService);if(!p)return;if(typeof npConfirm==='function'&&!await npConfirm(`¿Eliminar ${p.name}?`))return;state.products=state.products.filter(x=>x.id!==p.id);state.cart=state.cart.filter(x=>x.id!==p.id);state.favorites=state.favorites.filter(x=>x!==p.id);write(KEYS.products,state.products);write(KEYS.cart,state.cart);write(KEYS.favorites,state.favorites);renderStore();draw();toast('Servicio eliminado.','success')})};draw();byId('jmServiceSearch').oninput=draw;byId('jmServiceCategory').onchange=draw;byId('jmAddService').onclick=()=>openServiceEditor();
  }
  function openServiceEditor(id=null){
    const p=id?state.products.find(x=>x.id===id):null;const d=normalizeDigitalProduct(p?{...p}:{name:'',category:'Streaming',digitalType:'Servicio digital',platform:'',duration:'',deliveryMode:'Activación digital',requiresData:'Datos de contacto para coordinar la activación',availabilityMode:'unlimited',stock:9999,price:'',oldPrice:null,image:'',description:'',badgeText:'',featured:true});
    byId('crudTitle').textContent=p?'Editar servicio digital':'Nuevo servicio digital';byId('crudBody').innerHTML=`<form id="jmServiceForm"><div class="jm-form-grid"><div class="jm-field full"><label>Nombre del servicio</label><input id="jmPfName" value="${html(d.name)}" required></div><div class="jm-field"><label>Categoría</label><input id="jmPfCategory" value="${html(d.category)}" placeholder="Streaming, Diamantes, Cursos, Perfiles..." required></div><div class="jm-