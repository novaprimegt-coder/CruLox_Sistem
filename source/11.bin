#adminOverlay .admin-record-title img{width:36px!important;height:34px!important;border-radius:7px!important}
#adminOverlay .admin-record-grid,#adminOverlay .admin-customer-block{gap:4px!important;margin-top:5px!important}
#adminOverlay .admin-record-grid>*,#adminOverlay .admin-customer-block>*{padding:5px 6px!important;border-radius:7px!important}
#adminOverlay .admin-record-grid small,#adminOverlay .admin-customer-block small{font-size:.32rem!important}
#adminOverlay .admin-record-grid b,#adminOverlay .admin-customer-block b{font-size:.40rem!important;margin-top:1px!important}
#adminOverlay .admin-record-description{font-size:.38rem!important;line-height:1.38!important;margin-top:5px!important;padding:6px!important;border-radius:7px!important}
#adminOverlay .admin-record-actions{gap:4px!important;margin-top:6px!important}
#adminOverlay .admin-mini-item{padding:6px 7px!important;border-radius:8px!important}
#adminOverlay .admin-mini-item b{font-size:.42rem!important}
#adminOverlay .admin-mini-item small{font-size:.34rem!important}
#adminOverlay .admin-subheading{font-size:.50rem!important;margin:8px 0 5px!important}

/* Atención/Mensajes: mismo nivel de densidad */
