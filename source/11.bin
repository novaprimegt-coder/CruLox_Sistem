#adminOverlay .np-admin-subnav{
  padding:4px!important;border-radius:12px;background:rgba(6,20,32,.72)!important;border:1px solid rgba(126,207,255,.055)!important;
}
#adminOverlay .np-admin-subnav button{border-radius:9px!important;background:transparent!important;border-color:transparent!important;color:#7893a9!important}
#adminOverlay .np-admin-subnav button.active{background:linear-gradient(145deg,#0a2132,#081927)!important;color:#48e2ff!important;border-color:rgba(39,221,255,.12)!important;box-shadow:0 5px 14px rgba(0,0,0,.12)!important}

/* HOME — bloque principal */
#adminOverlay .np-v126-home-launcher{gap:10px!important;margin-bottom:14px!important}
#adminOverlay .np-v126-home-main{
  min-height:112px!important;padding:16px 17px!important;border-radius:20px!important;
  background:
    radial-gradient(250px 140px at 90% 15%,rgba(38,219,255,.17),transparent 72%),
    linear-gradient(135deg,#0b2638 0%,#071827 54%,#07131e 100%)!important;
  border:1px solid rgba(39,221,255,.22)!important;
  box-shadow:0 16px 36px rgba(0,0,0,.16),inset 0 1px 0 rgba(255,255,255,.035)!important;
}
#adminOverlay .np-v126-home-main:before{
  content:"💬";position:absolute;right:18px;bottom:-23px;font-size:5.4rem;line-height:1;opacity:.045;transform:rotate(-9deg);pointer-events:none;
}
#adminOverlay .np-v126-home-main:after{width:240px!important;height:240px!important;right:-80px!important;top:-110px!important;background:radial-gradient(circle,rgba(39,221,255,.16),transparent 68%)!important}
#adminOverlay .np-v126-home-main small{font-size:.42rem!important;color:#50e6ff!important;letter-spacing:.16em!important}
#adminOverlay .np-v126-home-main h2{font-size:1.01rem!important;letter-spacing:-.035em!important;margin:6px 0 5px!important}
#adminOverlay .np-v126-home-main p{font-size:.49rem!important;color:#9ab1c3!important;max-width:680px}
#adminOverlay .np-v126-home-main button{
  min-height:41px!important;padding:8px 14px!important;border-radius:12px!important;
  background:linear-gradient(135deg,#21e0f7,#198af8)!important;color:#03111b!important;font-weight:950!important;
  box-shadow:0 11px 26px rgba(0,184,255,.20)!important;transition:transform .14s ease,box-shadow .14s ease!important;
}
#adminOverlay .np-v126-home-main button:hover{transform:translateY(-2px);box-shadow:0 15px 31px rgba(0,184,255,.27)!important}
#adminOverlay .np-v126-stat{
  min-height:112px!important;padding:14px!important;border-radius:18px!important;
  background:linear-gradient(150deg,#091b2a,#06131f)!important;border:1px solid rgba(126,207,255,.09)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.022)!important;position:relative!important;overflow:hidden!important;
}
#adminOverlay .np-v126-stat:before{content:"";position:absolute;left:0;top:0;width:100%;height:2px;background:linear-gradient(90deg,var(--np127-cyan),transparent 72%);opacity:.65}
#adminOverlay .np-v126-stat:nth-of-type(3):before{background:linear-gradient(90deg,var(--np127-amber),transparent 72%)}
#adminOverlay .np-v126-stat:nth-of-type(4):before{background:linear-gradient(90deg,var(--np127-indigo),transparent 72%)}
#adminOverlay .np-v126-stat small{font-size:.42rem!important;color:#7f9ab0!important;text-transform:uppercase;letter-spacing:.06em}
#adminOverlay .np-v126-stat b{font-size:1.26rem!important;line-height:1!important;margin-top:7px!important;color:#f2fbff!important;letter-spacing:-.05em}
#adminOverlay .np-v126-stat span{font-size:.40rem!important;color:#667f95!important}

/* Buscador tipo command palette */
#adminOverlay .np-v10-commandbar{
  min-height:55px!important;padding:8px!important;border-radius:17px!important;
  background:linear-gradient(145deg,rgba(9,28,43,.96),rgba(5,17,28,.96))!important;
