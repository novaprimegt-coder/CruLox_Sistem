#adminOverlay .np-v10-module-icon{width:34px!important;height:34px!important;border-radius:10px!important;background:rgba(39,221,255,.08)!important;color:#53e5ff!important;border:1px solid rgba(126,207,255,.06)!important}
#adminOverlay .np-v10-module h3{font-size:.61rem!important;color:#eaf7ff!important}
#adminOverlay .np-v10-module p{font-size:.43rem!important;color:#758fa5!important}
#adminOverlay .np-v10-module-go{color:#42dfff!important;font-weight:900!important}

/* Herramientas */
#adminOverlay .np-v10-tools-head{padding:5px 0 9px!important}
