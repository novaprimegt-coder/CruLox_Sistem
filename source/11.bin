/* Cards, métricas y listas generales */
#adminOverlay .admin-grid{gap:6px!important}
#adminOverlay .metric{padding:8px!important;border-radius:11px!important;min-height:56px!important}
#adminOverlay .metric small{font-size:.39rem!important}
