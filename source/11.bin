<script id="np-v131-executive-ui-script">
(function(){
  const VERSION='11.21';
  const overlay=document.getElementById('adminOverlay');
  if(!overlay)return;
  function refine(){
    overlay.dataset.ui='executive-control';
    overlay.dataset.version=VERSION;
    const kicker=overlay.querySelector('.admin-top .section-kicker');
    if(kicker)kicker.textContent='CENTRO DE CONTROL';
    const secondary=overlay.querySelector('.np-v118-secondary-label');
    if(secondary)secondary.textContent='Operación';
    const homeSection=overlay.querySelector('.np-v10-section-head');
    if(homeSection){
      const h=homeSection.querySelector('h2');
      const p=homeSection.querySelector('p');
      if(h&&/menú principal/i.test(h.textContent))h.textContent='Áreas';
      if(p&&/primero eliges/i.test(p.textContent))p.textContent='Accede a funciones secundarias cuando las necesites.';
    }
    const iconMap={catalog:'▦',messages:'◉',orders:'≡'};
    overlay.querySelectorAll('.np-v118-main3-card').forEach(card=>{
      const icon=card.querySelector('.np-v118-main3-icon');
      if(icon&&iconMap[card.dataset.main3])icon.textContent=iconMap[card.dataset.main3];
    });
    const title=document.getElementById('adminTitle');
    if(title&&title.textContent.trim()==='Administración')title.textContent='Control';
  }
  const content=document.getElementById('adminContent');
  if(content){
    const mo=new MutationObserver(records=>{if(records.some(r=>r.addedNodes&&r.addedNodes.length))requestAnimationFrame(refine)});
    mo.observe(content,{childList:true,subtree:false});
  }
  requestAnimationFrame(refine);
  window.NP_V131_EXECUTIVE={VERSION,refresh:refine};
})();
</script>


<style id="np-v132-purpose-categories-style">
#adminOverlay .np-v132-toolbox{display:grid;gap:8px;min-width:0}
