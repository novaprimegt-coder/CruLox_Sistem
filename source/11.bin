/* El antiguo gran bloque de Mensajes es redundante: conservar solo las métricas pequeñas. */
#adminOverlay .np-v126-home-launcher{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin:0 0 8px!important}
