#adminOverlay .np-v10-tool p{font-size:.34rem!important;line-height:1.28!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important}
#adminOverlay .np-v10-tool-tag{font-size:.31rem!important;padding:2px 5px!important}
