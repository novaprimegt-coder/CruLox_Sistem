  #adminOverlay .admin-top{min-height:42px!important;padding:4px 6px!important}
  #adminOverlay .admin-top h1{font-size:.60rem!important}
  #adminOverlay .admin-top .toolbar .btn,#adminOverlay .admin-top .toolbar>button{min-height:27px!important;padding:3px 5px!important;font-size:.36rem!important}
  #adminOverlay .admin-content{padding:7px 7px 66px!important}
  #adminOverlay .np-v118-main3{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;margin-bottom:6px!important}
  #adminOverlay .np-v118-main3-card{min-height:66px!important;padding:6px 4px!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;text-align:center!important;gap:4px!important;border-radius:11px!important}
  #adminOverlay .np-v118-main3-icon{width:25px!important;height:25px!important;font-size:.62rem!important;flex:0 0 auto!important}
  #adminOverlay .np-v118-main3-card b{font-size:.40rem!important;line-height:1.15!important;align-self:auto!important}
  #adminOverlay .np-v118-main3-card p{display:none!important}
  #adminOverlay .np-v118-secondary-label{font-size:.31rem!important;margin:1px 0 4px!important}
  #adminOverlay .np-v126-home-launcher{gap:4px!important;margin-bottom:6px!important}
  #adminOverlay .np-v126-stat{min-height:48px!important;padding:6px!important;border-radius:9px!important}
  #adminOverlay .np-v126-stat small{font-size:.29rem!important}.np-v126-stat b{font-size:.67rem!important}.np-v126-stat span{font-size:.27rem!important}
  #adminOverlay .np-v10-commandbar{min-height:36px!important;padding:4px!important;border-radius:9px!important}
  #adminOverlay .np-v10-commandbar input,#adminOverlay .np-v10-commandbar .btn{min-height:28px!important}
  #adminOverlay .np-v10-modules{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
