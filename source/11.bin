#adminOverlay .np-v124-compose-row>button{min-width:56px!important;font-size:.39rem!important;border-radius:8px!important}

/* Modo herramienta: pantalla completa, cabecera mínima */
#adminOverlay.np-v126-workspace-mode .admin-top{min-height:45px!important;padding:5px 7px!important}
#adminOverlay.np-v126-workspace-mode .admin-top:before{left:47px!important;top:4px!important;font-size:.27rem!important;letter-spacing:.13em!important}
#adminOverlay.np-v126-workspace-mode .admin-top h1{font-size:.62rem!important;padding-top:6px!important}
#adminOverlay .np-v126-workspace-controls{gap:3px!important}
#adminOverlay .np-v126-workspace-controls button{min-height:28px!important;padding:4px 6px!important;border-radius:8px!important;font-size:.38rem!important}
#adminOverlay .np-v126-workspace-controls button:last-child{width:29px!important}
#adminOverlay.np-v126-workspace-mode .admin-content{padding:7px!important}

/* Dock móvil más pequeño */
#adminOverlay .np-v126-mobile-dock{height:52px!important;left:7px!important;right:7px!important;padding:4px!important;border-radius:15px!important}
#adminOverlay .np-v126-mobile-dock button{border-radius:9px!important;font-size:.32rem!important;gap:1px!important}
