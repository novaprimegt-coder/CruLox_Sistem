dden;display:flex;justify-content:space-between;align-items:center;gap:12px;border-color:rgba(37,220,255,.16)}
#adminOverlay .np-v126-home-main:after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;right:-50px;top:-65px;background:radial-gradient(circle,rgba(35,220,255,.12),transparent 66%);pointer-events:none}
#adminOverlay .np-v126-home-main small{display:block;color:#32ddff;font-size:.39rem;font-weight:950;text-transform:uppercase;letter-spacing:.1em}
#adminOverlay .np-v126-home-main h2{font-size:.82rem;margin:4px 0 3px;line-height:1.15}
#adminOverlay .np-v126-home-main p{font-size:.45rem!important;line-height:1.42!important;color:#7894ab!important;margin:0!important}
#adminOverlay .np-v126-home-main button{position:relative;z-index:1;flex:0 0 auto;min-height:35px;padding:7px 10px;border:0;border-radius:10px;background:linear-gradient(135deg,#1bdcf5,#178ff5);color:#03111b;font-size:.46rem;font-weight:950}
#adminOverlay .np-v126-stat{display:grid;align-content:center;gap:2px}
#adminOverlay .np-v126-stat small{font-size:.38rem;color:#728da5;text-transform:uppercase}.np-v126-stat b{font-size:1rem;color:#eefaff}.np-v126-stat span{font-size:.38rem;color:#638099}
#adminOverlay .np-v10-commandbar{padding:8px!important;border-radius:14px!important;background:#071522!important;border-color:var(--np126-line)!important;box-shadow:none!important}
#adminOverlay .np-v10-search input{min-height:37px!important;border-radius:10px!important;background:#091a29!important}
#adminOverlay .np-v10-section-head{margin:5px 0 7px!important}.np-v10-section-head h2{font-size:.70rem!important}.np-v10-section-head p{font-size:.44rem!important}.np-v10-section-head>span{font-size:.40rem!important}
#adminOverlay .np-v10-modules{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
#adminOverlay .np-v10-module{min-height:108px!important;padding:10px!important;border-radius:14px!important;background:#071522!important;border:1px solid var(--np126-line)!important;box-shadow:none!important;transition:transform .13s,border-color .13s,background .13s!important}
#adminOverlay .np-v10-module:hover{transform:translateY(-1px)!important;background:#081a29!important;border-color:rgba(37,220,255,.18)!important}
#adminOverlay .np-v10-module-icon{width:30px!important;height:30px!important;border-radius:9px!important;background:#0a2031!important}.np-v10-module-count{font-size:.37rem!important}.np-v10-module h3{font-size:.58rem!important;margin-top:5px!important}.np-v10-module p{font-size:.42rem!important;line-height:1.4!important}.np-v10-module-go{font-size:.39rem!important;color:#32ddff!important}
#adminOverlay .np-v116-home-wrap,#adminOverlay .np-v110-priority-strip{display:none!important}
#adminOverlay .np-v10-home-bottom{gap:7px!important}.np-v10-compact-card{border-radius:14px!important;background:#071522!important;border-color:var(--np126-line)!important;box-shadow:none!important;padding:10px!important}
/* Área */
#adminOverlay .np-v10-module-banner{padding:13px!important;border-radius:16px!important;background:#071725!important;border:1px solid var(--np126-line)!important;box-shadow:none!important}.np-v10-module-banner h2{font-size:.76rem!important}.np-v10-module-banner p{font-size:.46rem!important}.np-v10-big-icon{font-size:1.6rem!important}
#adminOverlay .np-v10-module-links{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important}
#adminOverlay .np-v10-module-link{min-height:72px!important;padding:9px!important;border-radius:13px!important;background:#071522!important;border:1px solid var(--np126-line)!important;box-shadow:none!important}.np-v10-module-link i{width:30px!important;height:30px!important;border-radius:9px!important}.np-v10-module-link b{font-size:.53rem!important}.np-v10-module-link small{font-size:.40rem!important;line-height:1.35!important}
/* Herramientas */
#adminOverlay .np-v10-tools-head{align-items:flex-end!important;padding:2px 0 6px!important;margin:0!important}.np-v10-tools-head h2{font-size:.72rem!important}.np-v10-tools-head p{font-size:.44rem!important}.np-v10-tool-search input,.np-v10-tool-search select{height:34px!important;min-height:34px!important;border-radius:10px!important;background:#081827!important;border-color:var(--np126-line)!important;font-size:.45rem!important}
#adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
#adminOverlay .np-v10-tool{min-height:118px!important;padding:9px!important;border-radius:14px!important;background:#071522!important;border:1px solid var(--np126-line)!important;box-shadow:none!important;gap:5px!important;transition:transform .13s,border-color .13s,background .13s!important}
#adminOverlay .np-v10-tool:hover{transform:translateY(-1px)!important;background:#081a29!important;border-color:rgba(37,220,255,.18)!important}
#adminOverlay .np-v10-tool::after{display:none!important}.np-v10-tool-icon{width:29px!important;height:29px!important;border-radius:9px!important}.np-v10-tool b{font-size:.54rem!important}.np-v10-tool p{font-size:.41rem!important;line-height:1.38!important}.np-v10-tool-tag{font-size:.36rem!important}.np-v110-rank{font-size:.36rem!important}
#adminOverlay .np-v10-tool[data-np110-rank="1"]{background:linear-gradient(145deg,#0a2538,#071522)!important;border-color:rgba(37,220,255,.28)!important;box-shadow:inset 3px 0 0 var(--np126-cyan)!important}
#adminOverlay .np-v10-tool[data-np110-rank="1"]::before{display:none!important}
/* Tarjetas genéricas */
#adminOverlay .admin-card,#adminOverlay .metric,#adminOverlay .admin-list-item,#adminOverlay .np-v105-agent-card,#adminOverlay .np-v116-report,#adminOverlay .np-v124-attention,#adminOverlay .np-v124-workspace{box-shadow:none!important;border-color:var(--np126-line)!important}
/* MODO HERRAMIENTA: pantalla completa y sin navegación ajena */
#adminOverlay.np-v126-workspace-mode{overflow:hidden!important}
#adminOverlay.np-v126-workspace-mode .admin-shell{display:block!important;min-height:100dvh!important;height:100dvh!important;overflow:hidden!important}
#adminOverlay.np-v126-workspace-mode .admin-sidebar,#adminOverlay.np-v126-workspace-mode #adminBreadcrumb,#adminOverlay.np-v126-workspace-mode #adminSubnavWrap,#adminOverlay.np-v126-workspace-mode .np-v126-mobile-dock{display:none!important}
#adminOverlay.np-v126-workspace-mode .admin-main{height:100dvh!important;display:grid!important;grid-template-rows:auto minmax(0,1fr)!important;overflow:hidden!important;background:#030a12!important}
#adminOverlay.np-v126-workspace-mode .admin-top{position:relative!important;top:auto!important;min-height:54px!important;padding:7px 10px!important;background:#050f19!important}
#adminOverlay.np-v126-workspace-mode .admin-top>div:first-child{display:flex!important;align-items:center!important;gap:8px!important;flex:1!important;min-width:0!important}
#adminOverlay.np-v126-workspace-mode .admin-top h1{font-size:.78rem!important}
#adminOverlay .np-v126-workspace-controls{display:none;align-items:center;gap:5px}
#adminOverlay.np-v126-workspace-mode .np-v126-workspace-controls{display:flex!important}
#adminOverlay.np-v126-workspace-mode .admin-top .toolbar>*:not(.np-v126-workspace-controls){display:none!important}
#adminOverlay .np-v126-workspace-controls button{min-height:34px!important;padding:6px 9px!important;border-radius:10px!important;border:1px solid var(--np126-line)!important;background:#081827!important;color:#dcecf8!important;font-size:.47rem!important;font-weight:900!important}
#adminOverlay .np-v126-workspace-controls button:last-child{width:35px!important;padding:0!important;color:#ff91a4!important;background:rgba(255,85,114,.055)!important;border-color:rgba(255,85,114,.13)!important}
#adminOverlay.np-v126-workspace-mode .admin-content{max-width:none!important;width:100%!important;height:100%!important;min-height:0!important;padding:10px!important;margin:0!important;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
#adminOverlay.np-v126-workspace-mode .admin-content>section:first-child,#adminOverlay.np-v126-workspace-mode .admin-content>div:first-child{margin-top:0!important}
/* Móvil: navegación compacta, no mosaico gigante */
#adminOverlay .np-v126-mobile-dock{display:none}
@media(max-width:980px){
 #adminOverlay .admin-shell{grid-template-columns:176px minmax(0,1fr)!important}
 #adminOverlay .np-v10-modules,#adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}
 #adminOverlay .np-v10-module-links{grid-template-columns:repeat(2,minmax(0,1fr))!important}
 #adminOverlay .np-v126-home-launcher{grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(100px,.5fr))}.np-v126-stat:last-child{display:none!important}
}
@media(max-width:760px){
 #adminOverlay{padding:0!important}
 #adminOverlay .admin-shell{display:flex!important;flex-direction:column!important;min-height:100dvh!important}
 #adminOverlay .admin-sidebar{position:relative!important;top:auto!important;height:auto!important;min-height:0!important;display:block!important;padding:5px 8px 6px!important;border-right:0!important;border-bottom:1px solid var(--np126-line)!important;overflow:visible!important;background:#050f19!important}
 #adminOverlay .admin-brand-row{justify-content:center!important;min-height:40px!important;padding:0 3px 4px!important;border:0!important}.admin-brand{width:145px!important;height:33px!important}
 #adminOverlay .np-v126-side-primary{display:none!important}
 #adminOverlay .admin-nav{display:flex!important;flex-direction:row!important;gap:4px!important;overflow-x:auto!important;padding:2px 0!important;scrollbar-width:none!important;scroll-snap-type:x proximity}.admin-nav::-webkit-scrollbar{display:none}
 #adminOverlay .admin-nav button{flex:0 0 auto!important;width:auto!important;min-width:74px!important;min-height:32px!important;padding:4px 7px!important;border-radius:9px!important;gap:5px!important;white-space:nowrap!important;font-size:.42rem!important;scroll-snap-align:start}.admin-nav button.active{box-shadow:inset 0 -2px 0 var(--np126-cyan)!important}.admin-nav .np-admin-menu-icon{width:22px!important;height:22px!important;font-size:.50rem!important}
 #adminOverlay .admin-main{flex:1 1 auto!important;min-height:0!important}
 #adminOverlay .admin-top{min-height:50px!important;padding:6px 9px!important}.admin-top h1{font-size:.78rem!important}.admin-top .toolbar{gap:4px!important}.admin-top .toolbar .btn,.admin-top .toolbar>button{min-height:32px!important;padding:5px 8px!important;font-size:.44rem!important}
 #adminOverlay .np-admin-breadcrumb{padding:6px 9px 0!important}.np-admin-subnav-wrap{padding:4px 9px 0!important}.np-admin-subnav button{min-height:27px!important;padding:4px 7px!important}
 #adminOverlay .admin-content{padding:9px 9px 78px!important}
 #adminOverlay .np-v126-home-launcher{grid-template-columns:1fr 1fr!important;gap:6px!important}.np-v126-home-main{grid-column:1/-1;min-height:82px!important}.np-v126-stat{min-height:67px!important;padding:9px!important}.np-v126-stat:last-child{display:grid!important}
 #adminOverlay .np-v10-modules{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}.np-v10-module{min-height:96px!important;padding:9px!important}.np-v10-module p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
 #adminOverlay .np-v10-module-links{grid-template-columns:1fr 1fr!important;gap:6px!important}.np-v10-module-link{min-height:66px!important}
 #adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}.np-v10-tool{min-height:112px!important}.np-v10-tool p{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
 #adminOverlay .np-v126-mobile-dock{position:fixed;z-index:120;left:9px;right:9px;bottom:max(8px,env(safe-area-inset-bottom));height:53px;padding:5px;display:grid;grid-template-columns:repeat(4,1fr);gap:4px;border-radius:16px;background:rgba(6,17,28,.97);border:1px solid rgba(128,202,255,.11);box-shadow:0 18px 45px rgba(0,0,0,.5)}
 #adminOverlay .np-v126-mobile-dock button{border:0;border-radius:11px;background:transparent;color:#7691a8;display:grid;place-items:center;align-content:center;gap:2px;font-size:.36rem;font-weight:900}.np-v126-mobile-dock button i{font-style:normal;font-size:.70rem}.np-v126-mobile-dock button.primary{background:linear-gradient(135deg,#13d8f2,#168ff4);color:#03111b}.np-v126-mobile-dock button.active{background:#0a2031;color:#35ddff}
 #adminOverlay.np-v126-workspace-mode .admin-shell{display:block!important}
 #adminOverlay.np-v126-workspace-mode .admin-top{min-height:52px!important;padding:6px 8px!important}.np-v126-workspace-controls button{min-height:32px!important;padding:5px 8px!important}.np-v126-workspace-controls .np-v126-back-label{display:none!important}
 #adminOverlay.np-v126-workspace-mode .admin-content{padding:7px!important;padding-bottom:max(12px,env(safe-area-inset-bottom))!important}
}
@media(max-width:430px){
 #adminOverlay .np-v10-tool-grid{grid-template-columns:1fr 1fr!important}.np-v10-tool{min-height:106px!important;padding:8px!important}.np-v10-tool b{font-size:.50rem!important}.np-v10-tool p{font-size:.39rem!important}
 #adminOverlay .np-v10-module{min-height:91px!important}.np-v10-module h3{font-size:.53rem!important}.np-v10-module p{font-size:.39rem!important}
 #adminOverlay .np-v10-module-links{grid-template-columns:1fr!important}
 #adminOverlay .np-v126-home-main h2{font-size:.72rem}.np-v126-home-main p{font-size:.41rem!important}.np-v126-home-main button{font-size:.42rem!important}
}
body.np-v126-admin-workspace .float-stack{display:none!important}
@media(prefers-reduced-motion:reduce){#adminOverlay *{scroll-behavior:auto!important;transition:none!important}}
</style>
<script id="np-v126-admin-redesign-script">
(function(){
  const VERSION='11.16';
  const overlay=document.getElementById('adminOverlay');
  const content=document.getElementById('adminContent');
  const top=document.querySelector('#adminOverlay .admin-top');
  const toolbar=top?.querySelector('.toolbar');
  const sidebar=document.querySelector('#adminOverlay .admin-sidebar');
  const tools=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
  if(!overlay||!content||!top||!toolbar||!sidebar)return;
  const hubSection=s=>s==='home'||s==='dashboard'||s==='np-toolbox'||String(s||'').startsWith('np-group:');
  let workspace=false;
  let origin={section:'home',scrollTop:0,toolQuery:'',toolGroup:'all',toolPurpose:'all'};
  let pendingTool=null;
  let restoring=false;

  function adminScrollTop(){return Math.max(overlay.scrollTop||0,document.querySelector('.admin-main')?.scrollTop||0,content.scrollTop||0)}
  function setAdminScroll(y=0){requestAnimationFrame(()=>{try{overlay.scrollTop=y}catch(e){};try{document.querySelector('.admin-main').scrollTop=y}catch(e){};if(workspace)content.scrollTop=0})}
  function captureOrigin(){
    if(restoring||workspace)return;
    const section=state?.adminSection||'home';
    if(!hubSection(section))return;
    origin={section,scrollTop:adminScrollTop(),toolQuery:document.getElementById('npV10ToolSearch')?.value||'',toolGroup:document.getElementById('npV10ToolGroup')?.value||'all',toolPurpose:document.getElementById('npV132ToolPurpose')?.value||'all'};
  }
  function workspaceTitle(fallback='Herramienta'){
    return document.getElementById('adminTitle')?.textContent?.trim()||pendingTool?.title||fallback;
  }
  function ensureWorkspaceControls(){
    let box=document.getElementById('npV126WorkspaceControls');
    if(box)return box;
    box=document.createElement('div');box.id='npV126WorkspaceControls';box.className='np-v126-workspace-controls';
    box.innerHTML='<button type="button" id="npV126WorkspaceBack" aria-label="Volver"><span>←</span> <span class="np-v126-back-label">Atrás</span></button><button type="button" id="npV126WorkspaceClose" aria-label="Cerrar herramienta">✕</button>';
    toolbar.appendChild(box);
    box.querySelector('#npV126WorkspaceBack').onclick=backToOrigin;
    box.querySelector('#npV126WorkspaceClose').onclick=closeWorkspace;
    return box;
  }
  function enterWorkspace(title){
    if(!overlay.classList.contains('open'))return;
    ensureWorkspaceControls();
    workspace=true;overlay.classList.add('np-v126-workspace-mode');document.body.classList.add('np-v126-admin-workspace');
    if(title&&document.getElementById('adminTitle'))document.getElementById('adminTitle').textContent=title;
    content.scrollTop=0;try{overlay.scrollTop=0}catch(e){}
  }
  function leaveWorkspace(){workspace=false;overlay.classList.remove('np-v126-workspace-mode');document.body.classList.remove('np-v126-admin-workspace');pendingTool=null}
  function restoreToolboxState(){
    if(origin.section!=='np-toolbox')return;
    setTimeout(()=>{
      const q=document.getElementById('npV10ToolSearch'),g=document.getElementById('npV10ToolGroup'),p=document.getElementById('npV132ToolPurpose');
      if(g&&origin.toolGroup&&g.value!==origin.toolGroup){g.value=origin.toolGroup;g.dispatchEvent(new Event('change',{bubbles:true}))}
      if(p&&origin.toolPurpose&&p.value!==origin.toolPurpose){p.value=origin.toolPurpose;p.dispatchEvent(new Event('change',{bubbles:true}))}
      if(q&&origin.toolQuery){q.value=origin.toolQuery;q.dispatchEvent(new Event('input',{bubbles:true}))}
      setTimeout(()=>setAdminScroll(origin.scrollTop),180);
    },30);
  }
  function backToOrigin(){
    leaveWorkspace();restoring=true;
    const target=hubSection(origin.section)?origin.section:'home';
    try{renderAdminSection(target)}catch(e){console.error('v11.16 back',e);try{renderAdminSection('home')}catch(_){}}
    restoring=false;restoreToolboxState();if(target!=='np-toolbox')setTimeout(()=>setAdminScroll(origin.scrollTop),60);
  }
  function closeWorkspace(){leaveWorkspace();restoring=true;try{renderAdminSection('home')}catch(e){console.error(e)}restoring=false;setAdminScroll(0)}

  function unreadStats(){
    try{const rows=JSON.parse(localStorage.getItem('jm_digital_v1_support_chats')||'[]');const active=(Array.isArray(rows)?rows:[]).filter(c=>c&&c.status!=='closed');return {open:active.length,unread:active.reduce((n,c)=>n+(c.messages||[]).filter(m=>m.role==='client'&&!m.readByStaff).length,0),waiting:active.filter(c=>!c.assignedAgentId).length}}catch(e){return {open:0,unread:0,waiting:0}}
  }
  function ensureSidePrimary(){
    let host=document.getElementById('npV126SidePrimary');if(host)return host;
    host=document.createElement('div');host.id='npV126SidePrimary';host.className='np-v126-side-primary';
    host.innerHTML='<button type="button" id="npV126SideMessages"><i>💬</i><span>Mensajes</span><b class="np-v126-side-count" id="npV126SideCount">0</b></button><button type="button" id="npV126SideTools"><i>⌕</i><span>Herramientas</span></button>';
    const row=sidebar.querySelector('.admin-brand-row');(row||sidebar.firstChild)?.insertAdjacentElement?.('afterend',host);if(!row)sidebar.prepend(host);
    host.querySelector('#npV126SideMessages').onclick=()=>renderAdminSection('bots');
    host.querySelector('#npV126SideTools').onclick=()=>renderAdminSection('np-toolbox');
    return host;
  }
  function ensureDock(){
    let dock=document.getElementById('npV126Dock');if(dock)return dock;
    dock=document.createElement('nav');dock.id='npV126Dock';dock.className='np-v126-mobile-dock';dock.setAttribute('aria-label','Accesos rápidos');
    dock.innerHTML='<button data-v126-dock="home"><i>⌂</i><span>Inicio</span></button><button class="primary" data-v126-dock="messages"><i>💬</i><span>Mensajes</span></button><button data-v126-dock="tools"><i>⌘</i><span>Herramientas</span></button><button data-v126-dock="search"><i>⌕</i><span>Buscar</span></button>';
    overlay.appendChild(dock);
    dock.onclick=e=>{const b=e.target.closest('[data-v126-dock]');if(!b)return;const a=b.dataset.v126Dock;if(a==='home')renderAdminSection('home');if(a==='messages')renderAdminSection('bots');if(a==='tools'||a==='search'){renderAdminSection('np-toolbox');if(a==='search')setTimeout(()=>document.getElementById('npV10ToolSearch')?.focus(),40)}};
    return dock;
  }
  function updateFastBadges(){
    const s=unreadStats(),count=s.unread||s.waiting;const badge=document.getElementById('npV126SideCount');if(badge){badge.textContent=String(Math.min(count,99));badge.classList.toggle('show',count>0)}
    const dock=document.getElementById('npV126Dock');dock?.querySelectorAll('button').forEach(x=>x.classList.remove('active'));const active=state?.adminSection==='home'?'home':state?.adminSection==='np-toolbox'?'tools':state?.adminSection==='bots'?'messages':'';dock?.querySelector(`[data-v126-dock="${active}"]`)?.classList.add('active');
  }
  function injectHomeLauncher(){
    if(state?.adminSection!=='home')return;const home=content.querySelector('.np-v10-home');if(!home||home.querySelector('.np-v126-home-launcher'))return;
    const chats=unreadStats();const openOrders=(state.orders||[]).filter(o=>!['Entregado','Cancelado'].includes(o.status)).length;const low=(state.products||[]).filter(p=>Number(p.stock)>0&&Number(p.stock)<=Number(state.settings?.lowStock||5)).length;
    const launcher=document.createElement('section');launcher.className='np-v126-home-launcher';launcher.innerHTML=`<article class="np-v126-home-main"><div><small>Prioridad #1</small><h2>Mensajes y atención</h2><p>${chats.open?`${chats.open} conversaciones abiertas · ${chats.unread} sin leer`:'Bandeja lista para atender consultas de clientes.'}</p></div><button type="button" id="npV126HomeMessages">Abrir mensajes</button></article><article class="np-v126-stat"><small>Pedidos abiertos</small><b>${openOrders}</b><span>operación activa</span></article><article class="np-v126-stat"><small>Stock bajo</small><b>${low}</b><span>requieren revisión</span></article><article class="np-v126-stat"><small>Herramientas</small><b>⌘</b><span>acceso global</span></article>`;
    home.prepend(launcher);launcher.querySelector('#npV126HomeMessages').onclick=()=>renderAdminSection('bots');
  }
  function refreshShell(){ensureSidePrimary();ensureDock();ensureWorkspaceControls();updateFastBadges();injectHomeLauncher()}

  /* Guarda el lugar exacto antes de abrir una función desde una tarjeta. */
  content.addEventListener('pointerdown',e=>{const toolCard=e.target.closest?.('[data-v10-tool]');const sectionLink=e.target.closest?.('[data-v10-section]');if(toolCard){captureOrigin();pendingTool=tools.find(t=>String(t.id)===String(toolCard.dataset.v10Tool))||null}if(sectionLink)captureOrigin()},true);
  content.addEventListener('click',e=>{const toolCard=e.target.closest?.('[data-v10-tool]');if(!toolCard)return;const t=tools.find(x=>String(x.id)===String(toolCard.dataset.v10Tool));setTimeout(()=>{if(document.querySelector('.modal-overlay.open'))return;if(!hubSection(state?.adminSection)||state?.adminSection===origin.section&&content.querySelector('.np-v10-tool-grid')===null)enterWorkspace(workspaceTitle(t?.title||'Herramienta'))},0)},true);

  const baseRender=renderAdminSection;
  renderAdminSection=function(section){
    const target=section==='dashboard'?'home':(section||'home');
    if(hubSection(target)){
      leaveWorkspace();const r=baseRender(target);requestAnimationFrame(refreshShell);return r;
    }
    if(!workspace)captureOrigin();
    const r=baseRender(target);
    requestAnimationFrame(()=>{enterWorkspace(workspaceTitle());refreshShell()});
    return r;
  };
  window.renderAdminSection=renderAdminSection;

  const baseOpen=openAdmin;
  openAdmin=function(section='home'){const r=baseOpen(section);requestAnimationFrame(()=>{if(hubSection(state?.adminSection))leaveWorkspace();refreshShell()});return r};
  window.openAdmin=openAdmin;

  /* Android/teclado: Escape equivale a Atrás cuando una herramienta está abierta. */
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&workspace&&overlay.classList.contains('open')){e.preventDefault();backToOrigin()}},true);
  window.addEventListener('storage',e=>{if(e.key==='jm_digital_v1_support_chats')updateFastBadges()});
  setInterval(()=>{if(!document.hidden&&overlay.classList.contains('open'))updateFastBadges()},8000);
  refreshShell();
  window.NP_V126_ADMIN={VERSION,back:backToOrigin,close:closeWorkspace,enter:enterWorkspace,isWorkspace:()=>workspace,refresh:refreshShell};
})();
</script>


<style id="np-v127-panel-bomba-style">
/* CRULOX v11.17 · Command UI — identidad premium, jerarquía y velocidad */
:root{
  --np127-bg:#02070d;
  --np127-bg2:#03111b;
  --np127-panel:#061522;
  --np127-panel2:#081a2a;
  --np127-card:#071827;
  --np127-card-hi:#0a2032;
  --np127-line:rgba(126,207,255,.11);
  --np127-line-hi:rgba(40,223,255,.28);
  --np127-text:#eef9ff;
  --np127-sub:#9bb2c7;
  --np127-muted:#657f96;
  --np127-cyan:#27ddff;
  --np127-blue:#2a8dff;
  --np127-indigo:#6c6cff;
  --np127-green:#37e6a0;
  --np127-amber:#ffc05b;
  --np127-red:#ff6d86;
}
#adminOverlay{
  background:
    radial-gradient(900px 520px at 92% -12%,rgba(21,143,255,.11),transparent 62%),
    radial-gradient(680px 430px at -8% 34%,rgba(0,220,255,.06),transparent 68%),
    linear-gradient(180deg,var(--np127-bg),#020912 58%,#02070d)!important;
  color:var(--np127-text)!important;
}
#adminOverlay:before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.16;
  background-image:linear-gradient(rgba(85,170,220,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(85,170,220,.035) 1px,transparent 1px);
  background-size:44px 44px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.75),transparent 76%);
}
#adminOverlay .admin-shell,#adminOverlay .admin-main,#adminOverlay .admin-sidebar,#adminOverlay .admin-top,#adminOverlay .admin-content{position:relative;z-index:1}

/* Sidebar escritorio */
#adminOverlay .admin-sidebar{
  background:linear-gradient(180deg,#061522 0%,#04111c 52%,#030d16 100%)!important;
  border-right:1px solid rgba(89,195,255,.09)!important;
  box-shadow:14px 0 38px rgba(0,0,0,.14)!important;
}
#adminOverlay .admin-sidebar:after{
  content:"";position:absolute;top:0;right:-1px;width:1px;height:38%;pointer-events:none;
  background:linear-gradient(180deg,rgba(39,221,255,.65),rgba(42,141,255,.12),transparent);
}
#adminOverlay .admin-brand-row{
  min-height:58px!important;padding:5px 7px 11px!important;border-bottom:1px solid rgba(126,207,255,.07)!important;
}
#adminOverlay .admin-brand{width:174px!important;height:43px!important;filter:drop-shadow(0 7px 16px rgba(0,190,255,.16))}
#adminOverlay .np-v126-side-primary{gap:7px!important;padding:7px 0 8px!important}
#adminOverlay .np-v126-side-primary button{
  min-height:43px!important;border-radius:13px!important;background:linear-gradient(145deg,#081a29,#061521)!important;
  border-color:rgba(126,207,255,.09)!important;color:#cae0f0!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;
}
#adminOverlay .np-v126-side-primary button:first-child{
  background:linear-gradient(135deg,rgba(25,221,248,.20),rgba(31,127,255,.10))!important;
  border-color:rgba(39,221,255,.24)!important;box-shadow:0 8px 24px rgba(0,179,255,.08),inset 0 1px 0 rgba(255,255,255,.045)!important;
}
#adminOverlay .np-v126-side-primary i{background:linear-gradient(145deg,rgba(39,221,255,.12),rgba(40,141,255,.06))!important;color:#62e8ff!important}
#adminOverlay .admin-nav{gap:4px!important;padding-top:6px!important}
#adminOverlay .admin-nav button{
  min-height:38px!important;border-radius:11px!important;color:#7894aa!important;transition:background .16s ease,color .16s ease,border-color .16s ease,transform .16s ease!important;
}
#adminOverlay .admin-nav button:hover{background:rgba(13,39,58,.72)!important;color:#dff3ff!important;transform:translateX(2px)}
#adminOverlay .admin-nav button.active{
  background:linear-gradient(90deg,rgba(29,211,248,.15),rgba(24,118,228,.055))!important;
  border-color:rgba(39,221,255,.15)!important;color:#f0fbff!important;
  box-shadow:inset 3px 0 0 var(--np127-cyan),0 7px 20px rgba(0,179,255,.05)!important;
}
#adminOverlay .admin-nav .np-admin-menu-icon{
  background:linear-gradient(145deg,#0b2031,#081725)!important;border:1px solid rgba(126,207,255,.06)!important;color:#9bc6dd!important;
}
#adminOverlay .admin-nav button.active .np-admin-menu-icon{color:#43e2ff!important;background:rgba(39,221,255,.085)!important;border-color:rgba(39,221,255,.12)!important}

/* Top bar */
#adminOverlay .admin-top{
  min-height:62px!important;padding:8px 16px!important;
  background:linear-gradient(180deg,rgba(4,14,23,.98),rgba(3,10,18,.94))!important;
  border-bottom:1px solid rgba(126,207,255,.085)!important;
  box-shadow:0 12px 28px rgba(0,0,0,.14)!important;
}
#adminOverlay .admin-top:after{
  content:"";position:absolute;left:16px;right:16px;bottom:-1px;height:1px;pointer-events:none;
  background:linear-gradient(90deg,rgba(39,221,255,.35),rgba(42,141,255,.10),transparent 62%);
}
#adminOverlay .admin-top h1{font-size:.91rem!important;font-weight:900!important;letter-spacing:-.025em!important;text-shadow:0 0 18px rgba(39,221,255,.05)}
#adminOverlay .admin-top .toolbar .btn,#adminOverlay .admin-top .toolbar>button{
  min-height:36px!important;padding:7px 11px!important;border-radius:11px!important;border:1px solid rgba(126,207,255,.10)!important;
  background:linear-gradient(145deg,#0a1c2b,#071522)!important;color:#d9eaf6!important;
}
#adminOverlay .admin-top .toolbar .btn:hover,#adminOverlay .admin-top .toolbar>button:hover{border-color:rgba(39,221,255,.24)!important;background:#0b2030!important}
#adminOverlay .admin-top .toolbar .btn-red,#adminOverlay .admin-top .toolbar #adminLogout{color:#ff8da1!important;background:rgba(255,86,113,.07)!important;border-color:rgba(255,86,113,.16)!important}

/* Contenido */
#adminOverlay .admin-content{max-width:1640px!important;padding:15px 17px 82px!important}
#adminOverlay .np-admin-breadcrumb,#adminOverlay .np-admin-subnav-wrap{max-width:1640px!important}
#adminOverlay .np-admin-breadcrumb{color:#658097!important}
