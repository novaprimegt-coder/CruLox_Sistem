}
#adminOverlay .np-v10-tool:before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(39,221,255,.22),transparent);opacity:.35}
#adminOverlay .np-v10-tool:hover{transform:translateY(-2px)!important;border-color:rgba(39,221,255,.20)!important;background:linear-gradient(150deg,#0a2031,#071521 78%)!important;box-shadow:0 12px 28px rgba(0,0,0,.13)!important}
#adminOverlay .np-v10-tool-icon{width:34px!important;height:34px!important;border-radius:10px!important;background:linear-gradient(145deg,rgba(39,221,255,.10),rgba(42,141,255,.05))!important;border:1px solid rgba(39,221,255,.08)!important;color:#50e4ff!important}
#adminOverlay .np-v10-tool b{font-size:.57rem!important;color:#eaf8ff!important}
#adminOverlay .np-v10-tool p{font-size:.42rem!important;color:#748ca1!important}
#adminOverlay .np-v10-tool-tag{background:rgba(39,221,255,.055)!important;border:1px solid rgba(39,221,255,.07)!important;color:#78cfe3!important;border-radius:999px!important;padding:4px 7px!important}
#adminOverlay .np-v110-rank{color:#42e1ff!important;font-weight:950!important}
#adminOverlay .np-v10-tool[data-np110-rank="1"]{
  background:radial-gradient(180px 100px at 100% 0%,rgba(39,221,255,.13),transparent 70%),linear-gradient(145deg,#0a273a,#071521)!important;
  border-color:rgba(39,221,255,.30)!important;box-shadow:inset 3px 0 0 var(--np127-cyan),0 10px 26px rgba(0,179,255,.08)!important;
}

/* Cards / forms / tablas: un mismo lenguaje visual */
#adminOverlay .admin-card,#adminOverlay .metric,#adminOverlay .admin-list-item,#adminOverlay .np-v10-compact-card,#adminOverlay .np-v10-report,#adminOverlay .np-v105-agent-card,#adminOverlay .np-v116-report,#adminOverlay .np-v124-attention,#adminOverlay .np-v124-workspace{
  background:linear-gradient(150deg,#081a29,#06131f)!important;border:1px solid rgba(126,207,255,.085)!important;border-radius:17px!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.017)!important;
}
#adminOverlay input,#adminOverlay textarea,#adminOverlay select{
  background:#071522!important;border-color:rgba(126,207,255,.10)!important;color:#eef8ff!important;
}
#adminOverlay input:focus,#adminOverlay textarea:focus,#adminOverlay select:focus{border-color:rgba(39,221,255,.36)!important;box-shadow:0 0 0 3px rgba(39,221,255,.055)!important;outline:none!important}
#adminOverlay table{background:transparent!important}
#adminOverlay th{background:#071522!important;color:#7e99af!important;border-color:rgba(126,207,255,.065)!important}
#adminOverlay td{border-color:rgba(126,207,255,.055)!important;color:#d5e6f2!important}
#adminOverlay tr:hover td{background:rgba(26,83,115,.055)!important}
#adminOverlay .status{border:1px solid rgba(39,221,255,.08)!important}

/* Workspace fullscreen */
#adminOverlay.np-v126-workspace-mode .admin-main{
  background:radial-gradient(760px 360px at 94% -10%,rgba(24,139,255,.08),transparent 65%),linear-gradient(180deg,#020911,#030b13)!important;
}
#adminOverlay.np-v126-workspace-mode .admin-top{
  min-height:60px!important;padding:8px 12px!important;background:linear-gradient(180deg,#061522,#04101a)!important;
  box-shadow:0 12px 26px rgba(0,0,0,.17)!important;
}
#adminOverlay.np-v126-workspace-mode .admin-top:before{content:"HERRAMIENTA";font-size:.34rem;font-weight:950;letter-spacing:.16em;color:#4bdfff;position:absolute;left:58px;top:7px;opacity:.75}
#adminOverlay.np-v126-workspace-mode .admin-top h1{font-size:.82rem!important;padding-top:7px!important}
#adminOverlay .np-v126-workspace-controls button{
  min-height:37px!important;border-radius:11px!important;background:linear-gradient(145deg,#0a1d2c,#071522)!important;border-color:rgba(126,207,255,.11)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;
}
#adminOverlay .np-v126-workspace-controls #npV126WorkspaceBack{color:#dff5ff!important}
#adminOverlay .np-v126-workspace-controls #npV126WorkspaceBack:hover{border-color:rgba(39,221,255,.25)!important;background:#0a2233!important}
#adminOverlay .np-v126-workspace-controls #npV126WorkspaceClose{background:rgba(255,88,116,.07)!important;border-color:rgba(255,88,116,.16)!important;color:#ff8fa2!important}
#adminOverlay.np-v126-workspace-mode .admin-content{padding:13px!important}
#adminOverlay.np-v126-workspace-mode .admin-content>section:first-child,#adminOverlay.np-v126-workspace-mode .admin-content>div:first-child{animation:np127Rise .18s ease-out both}
@keyframes np127Rise{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

/* Dock móvil — más reconocible y premium */
#adminOverlay .np-v126-mobile-dock{
  height:60px!important;left:10px!important;right:10px!important;padding:6px!important;border-radius:19px!important;
  background:linear-gradient(180deg,rgba(8,25,39,.985),rgba(5,17,28,.985))!important;border:1px solid rgba(126,207,255,.12)!important;
  box-shadow:0 20px 42px rgba(0,0,0,.48),inset 0 1px 0 rgba(255,255,255,.025)!important;
}
#adminOverlay .np-v126-mobile-dock button{border-radius:13px!important;color:#6f8da4!important;font-size:.38rem!important;transition:background .14s ease,color .14s ease,transform .14s ease!important}
#adminOverlay .np-v126-mobile-dock button i{font-size:.74rem!important}
#adminOverlay .np-v126-mobile-dock button.primary{
  background:linear-gradient(135deg,#21e0f8,#218af7)!important;color:#03111b!important;
  box-shadow:0 8px 18px rgba(0,181,255,.20)!important;transform:translateY(-3px)!important;
}
#adminOverlay .np-v126-mobile-dock button.active:not(.primary){background:rgba(39,221,255,.075)!important;color:#4be3ff!important}

@media(max-width:760px){
  #adminOverlay:before{opacity:.09;background-size:36px 36px}
  #adminOverlay .admin-sidebar{background:linear-gradient(180deg,#061522,#04101a)!important;padding:6px 8px 7px!important;box-shadow:0 10px 24px rgba(0,0,0,.17)!important}
  #adminOverlay .admin-brand-row{min-height:45px!important;padding-bottom:5px!important}.admin-brand{width:154px!important;height:35px!important}
  #adminOverlay .admin-nav{gap:5px!important;padding:3px 0!important}
  #adminOverlay .admin-nav button{min-width:80px!important;min-height:35px!important;padding:5px 8px!important;border:1px solid rgba(126,207,255,.055)!important;background:#071522!important;border-radius:10px!important}
  #adminOverlay .admin-nav button.active{background:linear-gradient(145deg,#0a2537,#081725)!important;border-color:rgba(39,221,255,.17)!important;box-shadow:inset 0 -2px 0 var(--np127-cyan)!important}
  #adminOverlay .admin-top{min-height:54px!important;padding:7px 10px!important}
  #adminOverlay .admin-top h1{font-size:.80rem!important}
  #adminOverlay .admin-content{padding:11px 10px 86px!important}
  #adminOverlay .np-v126-home-launcher{gap:8px!important}
  #adminOverlay .np-v126-home-main{min-height:105px!important;padding:14px!important}
  #adminOverlay .np-v126-home-main h2{font-size:.82rem!important}.np-v126-home-main p{font-size:.43rem!important;max-width:230px}
  #adminOverlay .np-v126-home-main button{min-height:37px!important;padding:7px 10px!important;font-size:.43rem!important}
  #adminOverlay .np-v126-stat{min-height:76px!important;padding:10px!important;border-radius:15px!important}
