  min-height:116px!important;padding:12px!important;border-radius:17px!important;
  background:linear-gradient(150deg,#081a29,#06131f 72%)!important;border:1px solid rgba(126,207,255,.085)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;position:relative!important;overflow:hidden!important;
}
#adminOverlay .np-v10-module:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(180px 90px at 100% 0%,rgba(39,221,255,.06),transparent 74%);opacity:0;transition:opacity .18s ease}
#adminOverlay .np-v10-module:hover{transform:translateY(-2px)!important;border-color:rgba(39,221,255,.20)!important;background:linear-gradient(150deg,#0a2031,#071521 72%)!important;box-shadow:0 12px 28px rgba(0,0,0,.14)!important}
#adminOverlay .np-v10-module:hover:before{opacity:1}
#adminOverlay .np-v10-module:nth-child(4n+2) .np-v10-module-icon{color:#a9a5ff!important;background:rgba(108,108,255,.09)!important}
