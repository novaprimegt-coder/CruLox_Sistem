/* Tablas: más densidad */
#adminOverlay .table-wrap{border-radius:9px!important}
#adminOverlay table{min-width:650px!important}
#adminOverlay th,#adminOverlay td{padding:6px 7px!important;font-size:.42rem!important;line-height:1.25!important}
