}
#adminOverlay .np-v10-commandbar input:focus{border-color:rgba(39,221,255,.38)!important;box-shadow:0 0 0 3px rgba(39,221,255,.06)!important}
#adminOverlay .np-v10-commandbar .btn{min-height:39px!important;border-radius:12px!important;background:linear-gradient(135deg,#17d9f5,#218af6)!important;color:#03111a!important;box-shadow:0 8px 20px rgba(0,184,255,.13)!important}

/* Áreas */
#adminOverlay .np-v10-section-head h2{font-size:.76rem!important;letter-spacing:-.02em}
#adminOverlay .np-v10-section-head p{color:#6d879d!important}
#adminOverlay .np-v10-modules{gap:9px!important}
