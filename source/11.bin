#adminOverlay .np-v132-search-label{padding:5px 2px;color:#718aa1;font-size:.41rem}
#adminOverlay .np-v118-tool-progress{min-height:12px!important;margin:0!important}
#adminOverlay .np-v118-tool-progress span{font-size:.38rem!important;color:#607990!important}
@media(max-width:1050px){#adminOverlay .np-v132-category-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:700px){#adminOverlay .np-v132-category-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}#adminOverlay .np-v132-purpose-card{min-height:102px;padding:8px;grid-template-columns:25px minmax(0,1fr);gap:4px 7px}#adminOverlay .np-v132-purpose-icon{width:25px;height:25px;font-size:.65rem}#adminOverlay .np-v132-purpose-copy b{font-size:.50rem}#adminOverlay .np-v132-purpose-copy small{font-size:.37rem}#adminOverlay .np-v132-purpose-copy em{font-size:.33rem}#adminOverlay .np-v132-purpose-head{grid-template-columns:auto 25px minmax(0,1fr)}#adminOverlay .np-v132-purpose-head-icon{width:25px;height:25px}}
@media(max-width:390px){#adminOverlay .np-v132-category-grid{grid-template-columns:1fr 1fr}#adminOverlay .np-v132-purpose-card{min-height:98px}}
</style>


<script id="np-v123-stability-core-script">
/* CRULOX v11.23 · Estabilidad de producción — sin cambios visuales. */
(function(){
  const VERSION='11.23';
  const issues=[];
  const cap=(value,max=700)=>String(value??'').slice(0,max);
  function record(kind,error,extra=''){
    const item={kind,at:new Date().toISOString(),message:cap(error?.message||error||'Error'),extra:cap(extra),stack:cap(error?.stack||'',1200)};
    issues.push(item);if(issues.length>24)issues.shift();
    try{sessionStorage.setItem('np_v123_runtime_issues',JSON.stringify(issues.slice(-24)))}catch(_){}
    return item;
  }
  window.addEventListener('error',event=>record('error',event.error||event.message,`${event.filename||''}:${event.lineno||0}:${event.colno||0}`));
  window.addEventListener('unhandledrejection',event=>record('promise',event.reason||'Promesa rechazada'));

  function checkpoint(){
    try{
      if(typeof write!=='function'||typeof KEYS!=='object'||typeof state!=='object')return false;
      write(KEYS.session,state.session??null);
      if(Array.isArray(state.cart))write(KEYS.cart,state.cart);
      if(Array.isArray(state.favorites))write(KEYS.favorites,state.favorites);
      return true;
    }catch(error){record('checkpoint',error);return false}
  }
  window.addEventListener('pagehide',checkpoint,{capture:false});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)checkpoint()},{passive:true});

  function runSelfTest(){
    const result={version:VERSION,ok:false,checks:{},details:{}};
    try{
      const tools=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
      const toolIds=tools.map(t=>String(t?.id||''));
      const domIds=[...document.querySelectorAll('[id]')].map(el=>el.id).filter(Boolean);
      const duplicateDom=[...new Set(domIds.filter((id,i,a)=>a.indexOf(id)!==i))];
      const arrays=['products','combos','faqs','users','orders','cart','favorites','activity'];
      result.checks.domCore=!!document.getElementById('searchInput')&&!!document.getElementById('toastbox')&&((document.documentElement.dataset.cruzclickApp==='store')||!!document.getElementById('adminContent'));
      result.checks.stateShape=arrays.every(key=>Array.isArray(state?.[key]))&&!!state?.settings&&typeof state.settings==='object';
      result.checks.coreFunctions=['read','write','renderStore','renderAdminSection','openAdmin'].every(name=>typeof globalThis[name]==='function'||(name==='read'&&typeof read==='function')||(name==='write'&&typeof write==='function')||(name==='renderStore'&&typeof renderStore==='function')||(name==='renderAdminSection'&&typeof renderAdminSection==='function')||(name==='openAdmin'&&typeof openAdmin==='function'));
      result.checks.tools400=tools.length===400&&new Set(toolIds).size===400&&tools.every(t=>typeof t?.action==='function');
      result.checks.noDuplicateDomIds=duplicateDom.length===0;
      result.checks.noDemoProducts=!state.products.some(p=>['demo-media-nova-audio','demo-media-nova-tech'].includes(String(p?.id||'')));
      try{sessionStorage.setItem('np_v123_probe','1');result.checks.sessionStorage=sessionStorage.getItem('np_v123_probe')==='1';sessionStorage.removeItem('np_v123_probe')}catch(error){result.checks.sessionStorage=false;record('session-storage',error)}
      result.details.toolCount=tools.length;result.details.uniqueTools=new Set(toolIds).size;result.details.duplicateDomIds=duplicateDom;result.details.runtimeIssues=issues.length;
      result.ok=Object.values(result.checks).every(Boolean);
    }catch(error){record('self-test',error);result.error=cap(error?.message||error)}
    document.documentElement.dataset.npV123=result.ok?'ok':'review';
    window.NP_V123_SELF_TEST=result;
    if(result.ok)console.info('CRULOX v11.23 self-test OK',result);else console.warn('CRULOX v11.23 self-test review',result);
    return result;
  }
  requestAnimationFrame(()=>setTimeout(runSelfTest,120));
  window.NP_V123_STABILITY={VERSION,issues,checkpoint,runSelfTest,record};
})();
</script>


<style id="np-v124-final-admin-style">
/* =====================================================================
   CRULOX v11.24 · PANEL ADMINISTRATIVO DEFINITIVO
   Alcance: SOLO administración. No modifica tienda pública ni lógica.
   Objetivo: jerarquía, legibilidad, densidad útil, tactilidad y WebView.
   ===================================================================== */
#adminOverlay{
  --np124-bg:#05090e;
  --np124-sidebar:#080e14;
  --np124-surface:#0b1219;
  --np124-surface2:#0e171f;
  --np124-surface3:#111c26;
  --np124-line:rgba(156,199,226,.12);
  --np124-line-strong:rgba(156,199,226,.20);
  --np124-text:#f3f8fc;
  --np124-sub:#a1b3c1;
  --np124-muted:#718697;
  --np124-cyan:#33daf4;
  --np124-green:#56e2a8;
  --np124-violet:#94a2ff;
  --np124-amber:#f5c96d;
  --np124-red:#ff7b91;
  background:radial-gradient(700px 360px at 12% -10%,rgba(51,218,244,.055),transparent 68%),var(--np124-bg)!important;
}
#adminOverlay::before{opacity:.09!important;background-size:48px 48px!important}
#adminOverlay .admin-shell{grid-template-columns:172px minmax(0,1fr)!important}
#adminOverlay .admin-sidebar{
  padding:8px!important;background:linear-gradient(180deg,#091018,#070c12)!important;
  border-right:1px solid var(--np124-line)!important;box-shadow:6px 0 22px rgba(0,0,0,.16)!important;
}
#adminOverlay .admin-brand-row{min-height:46px!important;padding:3px 4px 8px!important}
#adminOverlay .admin-brand{width:145px!important;height:34px!important}
#adminOverlay .np-v126-side-primary{gap:5px!important;padding:8px 0!important}
#adminOverlay .np-v126-side-primary button{
  min-height:38px!important;padding:6px 7px!important;border-radius:10px!important;
  font-size:9px!important;line-height:1.15!important;color:#c3d0da!important;
}
#adminOverlay .np-v126-side-primary i{width:25px!important;height:25px!important;border-radius:7px!important;font-size:11px!important}
#adminOverlay .admin-nav{gap:3px!important;padding-top:7px!important}
#adminOverlay .admin-nav button{
  min-height:35px!important;padding:5px 6px!important;border-radius:9px!important;
  font-size:9px!important;line-height:1.15!important;color:#8da0af!important;
}
#adminOverlay .admin-nav .np-admin-menu-icon{width:24px!important;height:24px!important;border-radius:7px!important;font-size:10px!important}
#adminOverlay .admin-nav button.active{color:#f2fbff!important;border-color:rgba(51,218,244,.14)!important;box-shadow:inset 2px 0 0 var(--np124-cyan)!important}

/* Barra superior: compacta, pero legible y estable */
#adminOverlay .admin-top{
  min-height:52px!important;padding:6px 11px!important;background:rgba(7,12,18,.97)!important;
  border-bottom:1px solid var(--np124-line)!important;box-shadow:0 5px 18px rgba(0,0,0,.14)!important;
}
#adminOverlay .admin-top .section-kicker{font-size:7px!important;color:#6e8292!important;letter-spacing:.14em!important}
#adminOverlay .admin-top h1{font-size:13px!important;line-height:1.1!important;color:#f6fbff!important}
#adminOverlay .admin-top .toolbar{gap:5px!important}
#adminOverlay .admin-top .toolbar .btn,#adminOverlay .admin-top .toolbar>button{
  min-height:31px!important;padding:5px 9px!important;border-radius:8px!important;font-size:9px!important;
}
#adminOverlay .admin-content{max-width:1760px!important;padding:10px 11px 70px!important}
#adminOverlay .np-admin-breadcrumb{padding:4px 1px!important;font-size:8px!important}
#adminOverlay .np-admin-subnav-wrap{margin:4px 0 7px!important}
#adminOverlay .np-admin-subnav{padding:3px!important;gap:3px!important;border-radius:9px!important}
#adminOverlay .np-admin-subnav button{min-height:28px!important;padding:4px 7px!important;font-size:8px!important}

/* Inicio: las tres acciones prioritarias dominan, sin ocupar media pantalla */
#adminOverlay .np-v118-main3{gap:8px!important;margin:0 0 9px!important}
#adminOverlay .np-v118-main3-card{
  min-height:86px!important;padding:10px 11px!important;border-radius:13px!important;
  grid-template-columns:34px minmax(0,1fr)!important;column-gap:9px!important;
  background:linear-gradient(145deg,#0d161e,#091017)!important;border-color:var(--np124-line)!important;
  box-shadow:0 8px 20px rgba(0,0,0,.14)!important;
}
#adminOverlay .np-v118-main3-card[data-main3="catalog"]{background:linear-gradient(145deg,rgba(18,38,31,.95),#091017)!important}
#adminOverlay .np-v118-main3-card[data-main3="messages"]{background:linear-gradient(145deg,rgba(10,35,43,.98),#091017)!important;border-color:rgba(51,218,244,.22)!important}
#adminOverlay .np-v118-main3-card[data-main3="orders"]{background:linear-gradient(145deg,rgba(25,27,45,.96),#091017)!important}
#adminOverlay .np-v118-main3-icon{width:34px!important;height:34px!important;border-radius:9px!important;font-size:14px!important}
#adminOverlay .np-v118-main3-card b{font-size:11px!important;line-height:1.15!important}
#adminOverlay .np-v118-main3-card p{font-size:8px!important;line-height:1.32!important;margin-top:4px!important;color:#8499a9!important;white-space:normal!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important}
#adminOverlay .np-v118-secondary-label{margin:2px 0 6px!important;font-size:7px!important;color:#667b8b!important}

/* Indicadores: lectura instantánea */
#adminOverlay .np-v126-home-launcher{gap:6px!important;margin-bottom:8px!important}
#adminOverlay .np-v126-stat{min-height:60px!important;padding:8px 9px!important;border-radius:10px!important;background:#0b1219!important;border-color:var(--np124-line)!important}
#adminOverlay .np-v126-stat small{font-size:7px!important;color:#738797!important}
#adminOverlay .np-v126-stat b{font-size:15px!important;margin-top:4px!important}
#adminOverlay .np-v126-stat span{font-size:7px!important;color:#64798a!important;margin-top:3px!important}

/* Buscador y encabezados */
#adminOverlay .np-v10-commandbar{min-height:42px!important;padding:5px!important;gap:5px!important;border-radius:10px!important;margin-bottom:8px!important}
#adminOverlay .np-v10-commandbar input{min-height:32px!important;padding:0 48px 0 10px!important;font-size:10px!important}
#adminOverlay .np-v10-search kbd{font-size:7px!important}
#adminOverlay .np-v10-commandbar .btn{min-height:32px!important;padding:5px 10px!important;font-size:9px!important}
#adminOverlay .np-v10-section-head{margin:3px 0 7px!important}
#adminOverlay .np-v10-section-head h2{font-size:11px!important}
#adminOverlay .np-v10-section-head p{font-size:8px!important;line-height:1.35!important;color:#718696!important}

/* Áreas: menos columnas para que cada función sea legible */
#adminOverlay .np-v10-modules{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:6px!important}
#adminOverlay .np-v10-module{min-height:84px!important;padding:8px!important;border-radius:10px!important;gap:5px!important;background:#0b1219!important}
#adminOverlay .np-v10-module-icon{width:28px!important;height:28px!important;border-radius:8px!important;font-size:12px!important}
#adminOverlay .np-v10-module-count{font-size:7px!important}
#adminOverlay .np-v10-module h3{font-size:10px!important;line-height:1.18!important}
#adminOverlay .np-v10-module p{font-size:8px!important;line-height:1.32!important;color:#718696!important}
#adminOverlay .np-v10-module-go{font-size:8px!important;color:#7c91a1!important}

/* Favoritos y recientes */
#adminOverlay .np-v10-home-bottom{gap:6px!important;margin-top:3px!important}
#adminOverlay .np-v10-compact-card{padding:8px 9px!important;border-radius:10px!important}
#adminOverlay .np-v10-compact-card h3{font-size:10px!important;margin-bottom:6px!important}
#adminOverlay .np-v10-compact-card p{font-size:8px!important;line-height:1.35!important}
#adminOverlay .np-v10-chip{min-height:25px!important;padding:4px 7px!important;font-size:8px!important}

/* Herramientas: conserva carga progresiva y densidad, recupera lectura */
#adminOverlay .np-v10-tools-head{padding:3px 0 7px!important}
#adminOverlay .np-v10-tools-head h2{font-size:12px!important}
#adminOverlay .np-v10-tools-head p{font-size:8px!important;line-height:1.35!important}
#adminOverlay .np-v10-tool-search{gap:5px!important}
#adminOverlay .np-v10-tool-search input,#adminOverlay .np-v10-tool-search select{min-height:31px!important;height:31px!important;padding:5px 8px!important;font-size:9px!important}
#adminOverlay .np-v118-tool-progress,#adminOverlay .np-v118-tool-progress span{font-size:8px!important}
#adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:6px!important}
#adminOverlay .np-v10-tool{min-height:96px!important;padding:8px!important;border-radius:10px!important;gap:5px!important;background:#0b1219!important}
#adminOverlay .np-v10-tool-icon{width:28px!important;height:28px!important;border-radius:8px!important;font-size:12px!important}
#adminOverlay .np-v10-tool-fav,#adminOverlay .np-v116-tool-info{width:24px!important;height:24px!important;font-size:9px!important}
#adminOverlay .np-v10-tool b{font-size:9px!important;line-height:1.2!important}
#adminOverlay .np-v10-tool p{font-size:8px!important;line-height:1.3!important;color:#708595!important}
#adminOverlay .np-v10-tool-tag{font-size:7px!important}
#adminOverlay .np-v110-rank{min-width:27px!important;height:20px!important;font-size:8px!important}
#adminOverlay .np-v10-tool[data-np110-rank="1"]::before{font-size:7px!important}
#adminOverlay .np-v118-tool-sentinel button{min-height:29px!important;font-size:8px!important}

/* Categorías por propósito v11.22 */
#adminOverlay .np-v132-toolbox{gap:9px!important}
#adminOverlay .np-v132-category-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
#adminOverlay .np-v132-purpose-card{min-height:112px!important;padding:10px!important;border-radius:12px!important;grid-template-columns:30px minmax(0,1fr)!important;gap:6px 9px!important;background:linear-gradient(150deg,#0d1720,#091119)!important}
#adminOverlay .np-v132-purpose-icon{width:30px!important;height:30px!important;border-radius:8px!important;font-size:13px!important}
#adminOverlay .np-v132-purpose-copy b{font-size:10px!important;line-height:1.2!important}
#adminOverlay .np-v132-purpose-copy small{font-size:8px!important;line-height:1.35!important;color:#8196a7!important}
#adminOverlay .np-v132-purpose-copy em{font-size:7px!important;margin-top:6px!important;color:#6e8394!important}
#adminOverlay .np-v132-purpose-go{font-size:8px!important}
#adminOverlay .np-v132-purpose-head{grid-template-columns:auto 30px minmax(0,1fr)!important;gap:9px!important;padding:8px 9px!important}
#adminOverlay .np-v132-purpose-head button{min-height:30px!important;font-size:8px!important}
#adminOverlay .np-v132-purpose-head-icon{width:30px!important;height:30px!important;font-size:12px!important}
#adminOverlay .np-v132-purpose-head b{font-size:10px!important}
#adminOverlay .np-v132-purpose-head small,#adminOverlay .np-v132-search-label{font-size:8px!important}

/* Páginas de área */
#adminOverlay .np-v10-module-page{gap:7px!important}
#adminOverlay .np-v10-module-banner{min-height:82px!important;padding:10px 11px!important;border-radius:11px!important}
#adminOverlay .np-v10-module-banner h2{font-size:12px!important}
#adminOverlay .np-v10-module-banner p{font-size:8px!important;line-height:1.4!important}
#adminOverlay .np-v10-module-links{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important}
#adminOverlay .np-v10-module-link{min-height:54px!important;padding:7px 8px!important}
#adminOverlay .np-v10-module-link i{width:28px!important;height:28px!important;font-size:11px!important}
#adminOverlay .np-v10-module-link b{font-size:9px!important}
#adminOverlay .np-v10-module-link small{font-size:8px!important}

/* Cards, indicadores, listas */
#adminOverlay .admin-grid,#adminOverlay .np-v10-kpis,#adminOverlay .np-v105-kpis{gap:6px!important}
#adminOverlay .metric,#adminOverlay .np-v10-kpi,#adminOverlay .np-v105-kpis>div{min-height:62px!important;padding:8px 9px!important;border-radius:10px!important}
#adminOverlay .metric small,#adminOverlay .np-v10-kpi small,#adminOverlay .np-v105-kpis small{font-size:8px!important}
#adminOverlay .metric strong,#adminOverlay .np-v10-kpi strong,#adminOverlay .np-v105-kpis b{font-size:15px!important;margin-top:4px!important}
#adminOverlay .metric-note,#adminOverlay .np-v10-kpi span{font-size:7px!important}
#adminOverlay .admin-card,#adminOverlay .np-v10-report,#adminOverlay .np-v116-report,#adminOverlay .np-v105-agent-card,#adminOverlay .np-v105-order-summary,#adminOverlay .np-v105-chatbox{margin-top:7px!important;padding:9px!important;border-radius:10px!important}
#adminOverlay .admin-card-head{gap:7px!important;margin-bottom:7px!important;padding-bottom:6px!important}
#adminOverlay .admin-card h2,#adminOverlay .admin-card-head h2{font-size:11px!important}
#adminOverlay .admin-card h3{font-size:10px!important}
#adminOverlay .admin-card-sub{font-size:8px!important;line-height:1.35!important}
#adminOverlay .admin-list-item,#adminOverlay .np-v10-record,#adminOverlay .np-v10-audit{min-height:44px!important;padding:7px 8px!important}
#adminOverlay .admin-list-item h3,#adminOverlay .np-v10-record h3,#adminOverlay .np-v10-audit b{font-size:9px!important}
#adminOverlay .admin-list-item p,#adminOverlay .np-v10-record p,#adminOverlay .np-v10-audit p{font-size:8px!important;line-height:1.35!important}
#adminOverlay .activity-item b{font-size:9px!important}
#adminOverlay .activity-item span{font-size:8px!important}

/* Botones, formularios y estados */
#adminOverlay .btn,#adminOverlay button.btn{min-height:31px!important;padding:5px 8px!important;border-radius:8px!important;font-size:9px!important;line-height:1.15!important}
#adminOverlay .btn-sm{min-height:28px!important;padding:4px 7px!important;font-size:8px!important}
#adminOverlay .toolbar{gap:5px!important}
#adminOverlay input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),#adminOverlay select,#adminOverlay textarea{min-height:32px!important;padding:6px 8px!important;border-radius:8px!important;font-size:10px!important}
#adminOverlay textarea{min-height:66px!important}
#adminOverlay label,#adminOverlay .field label{font-size:8px!important}
#adminOverlay .field{gap:4px!important}
#adminOverlay .form-grid{gap:7px!important}
#adminOverlay .form-actions{gap:5px!important;margin-top:8px!important}
#adminOverlay .status{padding:3px 6px!important;font-size:8px!important}
#adminOverlay .notice{padding:8px 9px!important;border-radius:9px!important;font-size:8px!important;line-height:1.4!important;margin-bottom:8px!important}

/* Tablas: la densidad no debe volver ilegibles los datos */
#adminOverlay .table-wrap{border-radius:9px!important;overscroll-behavior:contain!important}
#adminOverlay table{min-width:720px!important}
#adminOverlay th{font-size:8px!important;letter-spacing:.04em!important}
#adminOverlay td{font-size:9px!important;line-height:1.3!important}
#adminOverlay th,#adminOverlay td{padding:7px 8px!important}
#adminOverlay table img{width:30px!important;height:30px!important}

/* Modo herramienta: máximo espacio útil y controles inequívocos */
#adminOverlay.np-v126-workspace-mode .admin-top{min-height:48px!important;padding:5px 8px!important}
#adminOverlay.np-v126-workspace-mode .admin-top::before{left:49px!important;top:4px!important;font-size:6px!important}
#adminOverlay.np-v126-workspace-mode .admin-top h1{font-size:11px!important;padding-top:7px!important}
#adminOverlay .np-v126-workspace-controls{gap:4px!important}
#adminOverlay .np-v126-workspace-controls button{min-height:31px!important;padding:5px 8px!important;border-radius:8px!important;font-size:8px!important}
#adminOverlay .np-v126-workspace-controls #npV126WorkspaceClose{width:32px!important}
#adminOverlay.np-v126-workspace-mode .admin-content{padding:8px 9px!important}

/* Accesibilidad operativa */
#adminOverlay button:focus-visible,#adminOverlay a:focus-visible,#adminOverlay input:focus-visible,#adminOverlay select:focus-visible,#adminOverlay textarea:focus-visible{
  outline:2px solid rgba(51,218,244,.72)!important;outline-offset:2px!important;
}
#adminOverlay button:disabled,#adminOverlay .btn:disabled{opacity:.46!important;cursor:not-allowed!important;transform:none!important}
#adminOverlay [title]{text-underline-offset:2px}

/* Modales disparados desde administración */
body.np-v112-admin-open .modal-overlay .modal{padding:11px!important;border-radius:12px!important}
body.np-v112-admin-open .modal-head h2{font-size:11px!important}
body.np-v112-admin-open .close-btn{width:30px!important;height:30px!important;font-size:10px!important}
body.np-v112-admin-open .modal-overlay .field label{font-size:8px!important}
body.np-v112-admin-open .modal-overlay .field input,body.np-v112-admin-open .modal-overlay .field select,body.np-v112-admin-open .modal-overlay .field textarea{min-height:32px!important;padding:6px 8px!important;font-size:10px!important}
body.np-v112-admin-open .modal-overlay .field textarea{min-height:68px!important}
body.np-v112-admin-open .modal-overlay .btn{min-height:30px!important;padding:5px 8px!important;font-size:9px!important}

@media(max-width:1180px){
  #adminOverlay .admin-shell{grid-template-columns:162px minmax(0,1fr)!important}
  #adminOverlay .np-v10-modules,#adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}
  #adminOverlay .np-v132-category-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}
}
@media(max-width:760px){
  #adminOverlay::before{display:none!important}
  #adminOverlay .admin-shell{display:block!important}
  #adminOverlay .admin-sidebar{padding:4px 6px 5px!important;box-shadow:0 5px 16px rgba(0,0,0,.12)!important}
  #adminOverlay .admin-brand-row{min-height:35px!important;padding:1px 2px 3px!important}
  #adminOverlay .admin-brand{width:125px!important;height:29px!important}
  #adminOverlay .admin-nav{display:flex!important;gap:4px!important;padding:2px 0!important;overflow-x:auto!important}
  #adminOverlay .admin-nav button{min-width:70px!important;min-height:31px!important;padding:4px 6px!important;font-size:8px!important}
  #adminOverlay .admin-nav .np-admin-menu-icon{width:21px!important;height:21px!important;font-size:9px!important}
  #adminOverlay .admin-top{min-height:43px!important;padding:4px 7px!important;backdrop-filter:none!important}
  #adminOverlay .admin-top h1{font-size:11px!important}
  #adminOverlay .admin-top .section-kicker{font-size:6px!important}
  #adminOverlay .admin-top .toolbar .btn,#adminOverlay .admin-top .toolbar>button{min-height:28px!important;padding:4px 6px!important;font-size:8px!important}
  #adminOverlay .admin-content{padding:7px 8px 62px!important}
  #adminOverlay .np-v118-main3{gap:5px!important;margin-bottom:6px!important}
  #adminOverlay .np-v118-main3-card{min-height:66px!important;padding:6px 5px!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:4px!important;text-align:center!important}
  #adminOverlay .np-v118-main3-icon{width:26px!important;height:26px!important;font-size:11px!important}
  #adminOverlay .np-v118-main3-card b{font-size:8px!important;line-height:1.16!important}
  #adminOverlay .np-v118-main3-card p{display:none!important}
  #adminOverlay .np-v118-secondary-label{font-size:7px!important;margin-bottom:5px!important}
  #adminOverlay .np-v126-home-launcher{gap:4px!important;margin-bottom:6px!important}
  #adminOverlay .np-v126-stat{min-height:49px!important;padding:6px!important}
  #adminOverlay .np-v126-stat small{font-size:6px!important}
  #adminOverlay .np-v126-stat b{font-size:12px!important}
  #adminOverlay .np-v126-stat span{font-size:6px!important}
  #adminOverlay .np-v10-commandbar{min-height:36px!important;padding:3px!important}
  #adminOverlay .np-v10-commandbar input,#adminOverlay .np-v10-commandbar .btn{min-height:29px!important;font-size:9px!important}
  #adminOverlay .np-v10-modules{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .np-v10-module{min-height:72px!important;padding:6px!important}
  #adminOverlay .np-v10-module h3{font-size:9px!important}
  #adminOverlay .np-v10-module p{font-size:7px!important}
  #adminOverlay .np-v10-home-bottom{grid-template-columns:1fr 1fr!important;gap:5px!important}
  #adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .np-v10-tool{min-height:86px!important;padding:6px!important}
  #adminOverlay .np-v10-tool b{font-size:8px!important}
  #adminOverlay .np-v10-tool p{font-size:7px!important}
  #adminOverlay .np-v132-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .np-v132-purpose-card{min-height:104px!important;padding:8px!important;grid-template-columns:26px minmax(0,1fr)!important;gap:5px 7px!important}
  #adminOverlay .np-v132-purpose-icon{width:26px!important;height:26px!important;font-size:11px!important}
  #adminOverlay .np-v132-purpose-copy b{font-size:9px!important}
  #adminOverlay .np-v132-purpose-copy small{font-size:7px!important}
  #adminOverlay .np-v132-purpose-copy em{font-size:6px!important}
  #adminOverlay .np-v132-purpose-go{font-size:7px!important}
  #adminOverlay .np-v10-module-links{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .admin-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .metric,#adminOverlay .np-v10-kpi{min-height:54px!important;padding:7px!important}
  #adminOverlay .admin-card{padding:8px!important}
  #adminOverlay th,#adminOverlay td{padding:6px 7px!important;font-size:8px!important}
  #adminOverlay .np-v126-mobile-dock{height:52px!important;left:7px!important;right:7px!important;padding:4px!important}
  #adminOverlay .np-v126-mobile-dock button{font-size:7px!important}
  #adminOverlay .np-v126-mobile-dock button i{font-size:11px!important}
  #adminOverlay.np-v126-workspace-mode .admin-top{min-height:42px!important;padding:4px 6px!important}
  #adminOverlay.np-v126-workspace-mode .admin-top::before{left:44px!important;top:3px!important;font-size:5px!important}
  #adminOverlay.np-v126-workspace-mode .admin-top h1{font-size:9px!important;padding-top:6px!important}
  #adminOverlay.np-v126-workspace-mode .admin-content{padding:6px!important;padding-bottom:max(10px,env(safe-area-inset-bottom))!important}
}
@media(max-width:390px){
  #adminOverlay .np-v118-main3-card{min-height:62px!important}
  #adminOverlay .np-v118-main3-card b{font-size:7px!important}
