#adminOverlay .np-v132-purpose-head button{min-height:29px;padding:5px 8px;border-radius:9px;border:1px solid rgba(132,204,255,.1);background:rgba(255,255,255,.025);color:#afc5d8;font-size:.43rem;font-weight:850}
#adminOverlay .np-v132-purpose-head-icon{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;background:rgba(25,211,245,.07);font-size:.70rem}
#adminOverlay .np-v132-purpose-head b{display:block;font-size:.55rem}
