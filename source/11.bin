  #adminOverlay .np-v10-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
  #adminOverlay .np-v10-tool{min-height:78px!important;padding:6px!important;border-radius:9px!important}
  #adminOverlay .np-v10-tool-icon{width:24px!important;height:24px!important}
  #adminOverlay .np-v10-tool b{font-size:.40rem!important}.np-v10-tool p{font-size:.31rem!important}
