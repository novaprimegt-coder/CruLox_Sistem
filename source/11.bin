  #adminOverlay .np-v10-commandbar{border-radius:15px!important;padding:7px!important;box-shadow:none!important}
  #adminOverlay .np-v10-module{min-height:103px!important;border-radius:15px!important;padding:10px!important}
  #adminOverlay .np-v10-module:hover,#adminOverlay .np-v10-tool:hover{transform:none!important;box-shadow:none!important}
  #adminOverlay .np-v10-tool{min-height:115px!important;border-radius:15px!important;padding:9px!important}
  #adminOverlay.np-v126-workspace-mode .admin-top{min-height:57px!important;padding:7px 9px!important}
  #adminOverlay.np-v126-workspace-mode .admin-top:before{left:52px!important;top:6px!important;font-size:.31rem!important}
  #adminOverlay.np-v126-workspace-mode .admin-top h1{padding-top:7px!important;font-size:.76rem!important}
  #adminOverlay.np-v126-workspace-mode .admin-content{padding:9px!important;padding-bottom:max(14px,env(safe-area-inset-bottom))!important}
}
@media(max-width:430px){
  #adminOverlay .np-v126-home-main{grid-column:1/-1!important}
  #adminOverlay .np-v126-home-main:before{font-size:4.3rem;right:10px}
  #adminOverlay .np-v10-tool-grid{gap:7px!important}
  #adminOverlay .np-v10-tool{min-height:111px!important}
}
@media(prefers-reduced-motion:reduce){#adminOverlay *{animation:none!important;transition:none!important}}
</style>
<script id="np-v127-panel-bomba-script">
(function(){
  const VERSION='11.17';
  const overlay=document.getElementById('adminOverlay');
  if(!overlay)return;
  function decorate(){
    overlay.dataset.ui='command';
    const launcher=overlay.querySelector('.np-v126-home-launcher');
    if(launcher&&!launcher.dataset.np127){
      launcher.dataset.np127='1';
      const main=launcher.querySelector('.np-v126-home-main');
      if(main){
        main.setAttribute('aria-label','Abrir Mensajes y atención');
        const small=main.querySelector('small');if(small)small.textContent='PRIORIDAD OPERATIVA · #1';
      }
    }
    overlay.querySelectorAll('.np-v10-module').forEach((el,i)=>{if(!el.dataset.np127Index)el.dataset.np127Index=String(i+1)});
    overlay.querySelectorAll('.np-v10-tool').forEach(el=>{if(!el.getAttribute('role'))el.setAttribute('role','button')});
  }
  const baseRefresh=window.NP_V126_ADMIN?.refresh;
  if(typeof baseRefresh==='function'){
    window.NP_V126_ADMIN.refresh=function(){const r=baseRefresh();requestAnimationFrame(decorate);return r};
  }
  const mo=new MutationObserver(records=>{
    let relevant=false;
    for(const r of records){if(r.addedNodes?.length){relevant=true;break}}
    if(relevant)requestAnimationFrame(decorate);
  });
  mo.observe(document.getElementById('adminContent')||overlay,{childList:true,subtree:true});
  decorate();
  window.NP_V127_UI={VERSION,refresh:decorate};
})();
</script>


<style id="np-v118-main3-style">
/* v11.18 · tres accesos principales */
#adminOverlay .np-v118-main3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:0 0 14px}
#adminOverlay .np-v118-main3-card{position:relative;min-height:118px;padding:16px;border-radius:22px;border:1px solid rgba(108,210,255,.14);background:linear-gradient(145deg,rgba(8,29,48,.98),rgba(4,15,28,.98));box-shadow:0 18px 42px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.03);text-align:left;color:#eaf8ff;overflow:hidden;transition:.18s ease}
#adminOverlay .np-v118-main3-card::after{content:"";position:absolute;right:-34px;bottom:-48px;width:150px;height:150px;border-radius:50%;background:radial-gradient(circle,rgba(20,214,255,.18),transparent 70%);pointer-events:none}
#adminOverlay .np-v118-main3-card:hover{transform:translateY(-2px);border-color:rgba(42,220,255,.3);box-shadow:0 22px 50px rgba(0,0,0,.27)}
#adminOverlay .np-v118-main3-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;margin-bottom:12px;background:linear-gradient(145deg,rgba(12,210,255,.14),rgba(43,116,255,.13));border:1px solid rgba(83,205,255,.14);font-size:1.1rem}
#adminOverlay .np-v118-main3-card b{display:block;font-size:.86rem;line-height:1.15;letter-spacing:-.01em}
#adminOverlay .np-v118-main3-card p{margin:6px 0 0;color:#8fa9c2;font-size:.55rem;line-height:1.4;max-width:90%}
#adminOverlay .np-v118-main3-card[data-main3="messages"]{background:linear-gradient(145deg,rgba(0,75,98,.98),rgba(4,27,49,.98));border-color:rgba(30,218,255,.25)}
#adminOverlay .np-v118-main3-card[data-main3="orders"] .np-v118-main3-icon{background:linear-gradient(145deg,rgba(90,119,255,.15),rgba(14,215,255,.09))}
#adminOverlay .np-v118-secondary-label{margin:6px 0 10px;padding-left:2px;color:#6f8ca8;font-size:.49rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
@media(max-width:720px){
  #adminOverlay .np-v118-main3{grid-template-columns:1fr;gap:9px}
  #adminOverlay .np-v118-main3-card{min-height:88px;padding:13px;display:grid;grid-template-columns:40px minmax(0,1fr);column-gap:11px;align-items:center}
  #adminOverlay .np-v118-main3-icon{width:40px;height:40px;margin:0;grid-row:1/3}
  #adminOverlay .np-v118-main3-card b{font-size:.73rem}
  #adminOverlay .np-v118-main3-card p{font-size:.5rem;margin-top:4px;max-width:100%}
}
</style>
<script id="np-v118-main3-script">
(function(){
  function routeMain3(type){
    if(type==='catalog') return renderAdminSection('products');
    if(type==='messages') return renderAdminSection('bots');
    if(type==='orders') return renderAdminSection('orders');
  }
  function injectMain3(){
    if(typeof state==='undefined'||state?.session?.role!=='admin'||state?.adminSection!=='home') return;
    const content=document.getElementById('adminContent');
    if(!content||content.querySelector('.np-v118-main3')) return;
    const wrap=document.createElement('section');
    wrap.className='np-v118-main3';
    wrap.innerHTML=`
      <button type="button" class="np-v118-main3-card" data-main3="catalog"><span class="np-v118-main3-icon">📦</span><b>Catálogo</b><p>Productos, inventario visual, categorías y gestión comercial del catálogo.</p></button>
      <button type="button" class="np-v118-main3-card" data-main3="messages"><span class="np-v118-main3-icon">💬</span><b>Mensajes / Atención al cliente</b><p>Conversaciones, asignaciones, seguimiento y respuesta directa al cliente.</p></button>
      <button type="button" class="np-v118-main3-card" data-main3="orders"><span class="np-v118-main3-icon">🧾</span><b>Pedidos realizados</b><p>Consulta, estado, seguimiento y control de todos los pedidos recibidos.</p></button>`;
    content.prepend(wrap);
    wrap.querySelectorAll('[data-main3]').forEach(btn=>btn.onclick=()=>routeMain3(btn.dataset.main3));
    const secondary=document.createElement('div');
    secondary.className='np-v118-secondary-label';
    secondary.textContent='Otras herramientas y áreas';
    wrap.insertAdjacentElement('afterend',secondary);
  }
  const baseRender=window.renderAdminSection;
  if(typeof baseRender==='function'){
    window.renderAdminSection=function(section){
      const r=baseRender(section);
      requestAnimationFrame(injectMain3);
      return r;
    };
  }
  const baseOpen=window.openAdmin;
  if(typeof baseOpen==='function'){
    window.openAdmin=function(section='home'){
      const r=baseOpen(section);
      requestAnimationFrame(injectMain3);
      return r;
    };
  }
  requestAnimationFrame(injectMain3);
})();
</script>


<style id="np-v119-focus-style">
/* v11.19 · foco operativo: potencia sin ruido numérico */
#adminOverlay .np-v126-home-main .np-v126-stat:last-child b{font-size:1.05rem!important;letter-spacing:.02em!important}
#adminOverlay .np-v126-home-main .np-v126-stat:last-child span{opacity:.8}
#adminOverlay .np-v10-tools-head h2{font-size:1.02rem!important;letter-spacing:-.02em!important}
#adminOverlay .np-v118-tool-progress{opacity:.72!important}
#adminOverlay .np-admin-group-count,#adminOverlay .np-v10-module-count{font-weight:800!important;letter-spacing:.01em!important}
#adminOverlay .np-v118-tool-progress:empty{display:none!important}
</style>
<script id="np-v119-focus-script">
(function(){
  function cleanToolLanguage(root=document){
    const nodes=root.querySelectorAll?.('button,span,p,h1,h2,h3,h4,small,b')||[];
    nodes.forEach(el=>{
      if(el.children.length) return;
      let t=el.textContent||'';
      if(/\b400 herramientas\b/i.test(t)) t=t.replace(/\b400 herramientas\b/gi,'Herramientas');
      if(/\bVer 400\b/i.test(t)) t=t.replace(/\bVer 400\b/gi,'Herramientas');
      if(/#1\s*[–-]\s*#400/i.test(t)) t=t.replace(/#1\s*[–-]\s*#400/gi,'por número');
      if(t!==el.textContent) el.textContent=t;
    });
  }
  const baseOpen=window.openAdmin;
  if(typeof baseOpen==='function') window.openAdmin=function(section='home'){const r=baseOpen(section);requestAnimationFrame(()=>cleanToolLanguage(document.getElementById('adminOverlay')||document));return r};
  const baseRender=window.renderAdminSection;
  if(typeof baseRender==='function') window.renderAdminSection=function(section){const r=baseRender(section);requestAnimationFrame(()=>cleanToolLanguage(document.getElementById('adminOverlay')||document));return r};
  requestAnimationFrame(()=>cleanToolLanguage(document));
})();
</script>


