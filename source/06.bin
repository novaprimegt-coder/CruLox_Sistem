  width:100%!important;
  min-height:66px!important;
  border-radius:999px!important;
  font-size:clamp(1rem,1.9vw,1.16rem)!important;
  font-weight:900!important;
  box-shadow:none!important;
}
.combo-actions .btn-secondary{display:none!important}
@media(max-width:860px){
  .combo{grid-template-columns:minmax(0,49%) minmax(0,51%)!important;min-height:340px}
  .combo-photo{min-height:340px}
  .combo-photo::before{top:20px;height:8px}
  .combo-shot.primary{width:74%;height:68%;left:0;bottom:44px}
  .combo-shot.secondary{width:40%;height:42%;right:5%;bottom:42px}
  .combo-copy{padding:22px 18px 20px!important}
  .combo-copy .section-kicker{margin-bottom:16px!important;padding:9px 16px!important}
  .combo h3{font-size:clamp(1.55rem,5vw,2rem)!important;margin-bottom:12px!important}
  .combo p{font-size:clamp(.82rem,2.45vw,.98rem)!important;margin-bottom:14px!important}
  .combo-products{gap:10px!important;margin-bottom:18px!important}
  .combo-products span{padding:11px 14px!important;font-size:clamp(.78rem,2vw,.92rem)!important;gap:8px!important}
  .combo .price{font-size:clamp(2.35rem,5.5vw,2.8rem)!important}
  .combo .old{font-size:clamp(.98rem,2.6vw,1.1rem)!important}
  .combo-main-actions .btn{min-height:54px!important;font-size:clamp(.88rem,2.4vw,1rem)!important}
}
@media(max-width:480px){
  .combo{grid-template-columns:minmax(0,47%) minmax(0,53%)!important;min-height:310px}
  .combo-photo{min-height:310px}
  .combo-photo::before{left:-18%;top:18px;width:74%}
  .combo-shot.primary{width:78%;height:64%;left:-2%;bottom:40px}
  .combo-shot.secondary{width:43%;height:38%;right:1%;bottom:40px}
  .combo-floor{left:10%;right:10%;bottom:34px;height:22px}
  .combo-copy{padding:18px 14px 16px!important}
  .combo-copy .section-kicker{margin-bottom:14px!important;padding:8px 14px!important;font-size:.74rem!important}
  .combo h3{font-size:clamp(1.34rem,6vw,1.72rem)!important;margin-bottom:10px!important}
  .combo p{font-size:clamp(.74rem,3.2vw,.9rem)!important;line-height:1.48!important;margin-bottom:12px!important}
  .combo-products{gap:8px!important;margin-bottom:15px!important}
  .combo-products span{padding:9px 11px!important;font-size:clamp(.7rem,2.85vw,.84rem)!important;border-radius:18px!important;gap:6px!important}
  .combo .price-row{margin-bottom:16px!important}
  .combo .price{font-size:clamp(2rem,7.2vw,2.45rem)!important}
  .combo .old{font-size:.9rem!important}
  .combo-main-actions .btn{min-height:48px!important;font-size:.9rem!important;padding:0 14px!important}
}
`;
if(!document.getElementById('np-v810-style')){const st=document.createElement('style');st.id='np-v810-style';st.textContent=NP_V810_STYLE;document.head.appendChild(st)}

function comboProductsResolved(combo){
  const ids=Array.isArray(combo?.productIds)?combo.productIds.filter(Boolean):[];
  return ids.map(id=>state.products.find(p=>p.id===id)).filter(Boolean);
}
function comboItemsResolved(combo, products){
  const arr=(Array.isArray(combo?.includes)&&combo.includes.length)?combo.includes:products.map(p=>p.name);
  return arr.filter(Boolean);
}
function comboBadgeResolved(combo){
  if(combo?.badgeText)return combo.badgeText;
  const discount=combo?.oldPrice?Math.round((1-combo.price/combo.oldPrice)*100):0;
  return discount?`AHORRA ${discount}%`:'COMBO NOVA';
}
function comboHeroExact(combo, products){
  const img=(combo?.image||'').trim();
  if(img && img!==BRAND_LOGO){
    return `<div class="combo-photo"><img class="combo-photo-fill" src="${esc(img)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/></div>`;
  }
  const a=products[0]||null;
  const b=products[1]||null;
  return `<div class="combo-photo"><div class="combo-stage"><div class="combo-floor"></div>${a&&b?`<img class="combo-shot primary" src="${esc(a.image)}" alt="${esc(a.name)}" loading="lazy" decoding="async"/><img class="combo-shot secondary" src="${esc(b.image)}" alt="${esc(b.name)}" loading="lazy" decoding="async"/>`:a?`<img class="combo-shot single" src="${esc(a.image)}" alt="${esc(a.name)}" loading="lazy" decoding="async"/>`:`<img class="combo-shot single" src="${esc(BRAND_LOGO)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/>`}</div></div>`;
}
function renderCombos(){
  const grid=$('combosGrid');
  if(!grid)return;
  grid.innerHTML=state.combos.length?state.combos.map(c=>{
    const products=comboProductsResolved(c);
    const items=comboItemsResolved(c,products);
    return `<article class="combo">${comboHeroExact(c,products)}<div class="combo-copy"><span class="section-kicker">${esc(comboBadgeResolved(c))}</span><h3>${esc(c.name)}</h3><p>${esc(c.description||'Combo especial disponible en CRULOX.')}</p><div class="combo-products">${items.map((name,i)=>`<span><i>${i===0?'🎧':'🔊'}</i>${esc(name)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div></div></div></article>`;
  }).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  grid.querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  grid.querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
}


/* v8.11 hero and combos refinement */
const NP_V811_STYLE=`
.hero-copy{display:flex;flex-direction:column;justify-content:center}
.hero-brand-top{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;margin-bottom:14px}
.hero-brand-top img{width:min(100%,500px);height:96px;object-fit:contain;filter:drop-shadow(0 14px 28px rgba(0,0,0,.34))}
