function uid(prefix='id'){return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,8)}`}
function esc(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;')}
function norm(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()}
function money(v){return `${state.settings.currency||'Q'}${Number(v||0).toFixed(2)}`}
function toast(message,type='info'){const el=document.createElement('div');el.className=`toast ${type}`;el.textContent=message;$('toastbox').appendChild(el);setTimeout(()=>el.remove(),3600)}
function persistCore(){write(KEYS.products,state.products);write(KEYS.combos,state.combos);write(KEYS.faqs,state.faqs);write(KEYS.settings,state.settings);write(KEYS.users,state.users);write(KEYS.orders,state.orders);write(KEYS.session,state.session);write(KEYS.cart,state.cart);write(KEYS.favorites,state.favorites);write(KEYS.activity,state.activity)}
function logActivity(action,detail=''){state.activity.unshift({id:uid('act'),action,detail,at:new Date().toISOString()});state.activity=state.activity.slice(0,250);write(KEYS.activity,state.activity)}
function sha256Fallback(ascii){function rightRotate(value,amount){return(value>>>amount)|(value<<(32-amount))}const mathPow=Math.pow,maxWord=mathPow(2,32),lengthProperty='length';let i,j,result='',words=[],asciiBitLength=ascii[lengthProperty]*8;let hash=sha256Fallback.h=sha256Fallback.h||[],k=sha256Fallback.k=sha256Fallback.k||[],primeCounter=k[lengthProperty],isComposite={};for(let candidate=2;primeCounter<64;candidate++){if(!isComposite[candidate]){for(i=0;i<313;i+=candidate)isComposite[i]=candidate;hash[primeCounter]=(mathPow(candidate,.5)*maxWord)|0;k[primeCounter++]=(mathPow(candidate,1/3)*maxWord)|0}}ascii+='\x80';while(ascii[lengthProperty]%64-56)ascii+='\x00';for(i=0;i<ascii[lengthProperty];i++){j=ascii.charCodeAt(i);if(j>>8)return'';words[i>>2]|=j<<((3-i)%4)*8}words[words[lengthProperty]]=((asciiBitLength/maxWord)|0);words[words[lengthProperty]]=asciiBitLength;for(j=0;j<words[lengthProperty];){const w=words.slice(j,j+=16),oldHash=hash;hash=hash.slice(0,8);for(i=0;i<64;i++){const w15=w[i-15],w2=w[i-2],a=hash[0],e=hash[4];const temp1=hash[7]+(rightRotate(e,6)^rightRotate(e,11)^rightRotate(e,25))+((e&hash[5])^((~e)&hash[6]))+k[i]+(w[i]=(i<16)?w[i]:((w[i-16]+(rightRotate(w15,7)^rightRotate(w15,18)^(w15>>>3))+w[i-7]+(rightRotate(w2,17)^rightRotate(w2,19)^(w2>>>10)))|0));const temp2=(rightRotate(a,2)^rightRotate(a,13)^rightRotate(a,22))+((a&hash[1])^(a&hash[2])^(hash[1]&hash[2]));hash=[(temp1+temp2)|0,a,hash[1],hash[2],(hash[3]+temp1)|0,hash[4],hash[5],hash[6]]}for(i=0;i<8;i++)hash[i]=(hash[i]+oldHash[i])|0}for(i=0;i<8;i++)for(j=3;j+1;j--){const b=(hash[i]>>(j*8))&255;result+=(b<16?'0':'')+b.toString(16)}return result}
async function sha256(text){try{if(window.crypto&&window.crypto.subtle){const data=new TextEncoder().encode(String(text));const hash=await window.crypto.subtle.digest('SHA-256',data);return[...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('')}}catch(error){console.warn('Web Crypto no disponible; se usará el respaldo local.',error)}return sha256Fallback(unescape(encodeURIComponent(String(text))))}
function currentUser(){return state.session?.role==='client'?state.users.find(u=>u.id===state.session.userId)||null:null}
function categories(){return [...new Set(state.products.map(p=>p.category).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'))}
function closeAllPanels(){['drawer','cartPanel','favPanel'].forEach(id=>$(id)?.classList.remove('open'));['drawerOverlay','cartOverlay','favOverlay'].forEach(id=>$(id)?.classList.remove('open'));document.body.classList.remove('lock')}
function openPanel(panel,overlay){closeAllPanels();$(overlay).classList.add('open');$(panel).classList.add('open');document.body.classList.add('lock')}
function openModal(id){$(id).classList.add('open');document.body.classList.add('lock')}
function closeModal(id){$(id).classList.remove('open');if(!document.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open'))document.body.classList.remove('lock')}
function applySettings(){document.title=`${state.settings.storeName||'CRULOX'} · Tienda Premium`;if($('heroSubtitle'))$('heroSubtitle').textContent=state.settings.subtitle;if($('footerSubtitle'))$('footerSubtitle').textContent=state.settings.subtitle;if($('footerEmail'))$('footerEmail').textContent=`📧 ${state.settings.email}`;if($('footerEmail'))$('footerEmail').href=`mailto:${state.settings.email}`;if($('shippingBenefit'))$('shippingBenefit').textContent=state.settings.shippingText||'Entrega digital';if($('returnBenefit'))$('returnBenefit').textContent=state.settings.returnText||'Según servicio digital';renderSocials()}
function socialItems(){return [{key:'facebookUrl',label:'Facebook'},{key:'instagramUrl',label:'Instagram'},{key:'tiktokUrl',label:'TikTok'}]}
function renderSocials(){const markup=socialItems().map(x=>`<a class="social-pill" href="${esc(state.settings[x.key]||'#')}" target="_blank" rel="noopener">${x.label}</a>`).join('');$('footerSocial').innerHTML=markup;$('drawerSocial').innerHTML=markup}
function renderHeader(){const user=currentUser();$('profileDot').textContent=state.session?.role==='admin'?'A':user?(user.fullName||user.username||'U').charAt(0).toUpperCase():'P';$('cartCount').textContent=state.cart.reduce((s,i)=>s+Number(i.qty||0),0);$('favCount').textContent=state.favorites.length;const heroProduct=$('heroProductCount');if(heroProduct)heroProduct.textContent=state.products.length;const heroCategory=$('heroCategoryCount');if(heroCategory)heroCategory.textContent=categories().length}
function stockInfo(p){const n=Number(p.stock||0);return n<=0?['Agotado','out']:n<=Number(state.settings.lowStock||5)?['Pocas unidades','low']:['Disponible','']}
function productCard(p){const discount=p.oldPrice?Math.round((1-Number(p.price)/Number(p.oldPrice))*100):0;const [stock,stockClass]=stockInfo(p);const fav=state.favorites.includes(p.id);return `<article class="product" data-product="${esc(p.id)}"><div class="product-image"><img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy" decoding="async"/>${p.badgeText?`<span class="badge">${esc(p.badgeText)}</span>`:''}<button class="fav-btn ${fav?'active':''}" data-fav="${esc(p.id)}" aria-label="Favorito">${fav?'♥':'♡'}</button></div><div class="product-body"><span class="product-cat">${esc(p.category)}</span><h3>${esc(p.name)}</h3><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)})</span></div><div class="price-row"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}${discount?`<span class="discount">-${discount}%</span>`:''}</div><span class="stock ${stockClass}">${stock}</span><div class="product-actions"><button class="add" data-add="${esc(p.id)}" ${Number(p.stock)<=0?'disabled':''}>Añadir</button><button class="support" data-support="${esc(p.id)}" aria-label="WhatsApp">💬</button><button class="detail" data-detail="${esc(p.id)}">Detalles</button></div></div></article>`}
function filteredProducts(){const q=norm(state.query);return state.products.filter(p=>(state.category==='all'||p.category===state.category)&&(!q||norm(`${p.name} ${p.category} ${p.description}`).includes(q)))}
function renderCategories(){const cats=categories(),counts=new Map();state.products.forEach(p=>{if(p.category)counts.set(p.category,(counts.get(p.category)||0)+1)});$('categoryChips').innerHTML=[`<button class="cat ${state.category==='all'?'active':''}" data-cat="all">Todos ${state.products.length}</button>`,...cats.map(c=>`<button class="cat ${state.category===c?'active':''}" data-cat="${esc(c)}">${esc(c)} ${counts.get(c)||0}</button>`)].join('');$('categoryChips').querySelectorAll('[data-cat]').forEach(btn=>btn.onclick=()=>{state.category=btn.dataset.cat;renderCategories();renderProducts()})}
function renderProducts(){const list=filteredProducts();$('productsGrid').innerHTML=list.length?list.map(productCard).join(''):'<div class="empty">No hay productos que coincidan con la búsqueda.</div>';bindProductActions($('productsGrid'))}
function renderCombos(){
  $('combosGrid').innerHTML=state.combos.map(c=>{
    const comboProducts=c.productIds.map(id=>state.products.find(p=>p.id===id)).filter(Boolean);
    const primary=comboProducts[0];
    const secondary=comboProducts[1];
    const names=comboProducts.map(p=>p.name);
    const discount=c.oldPrice?Math.round((1-c.price/c.oldPrice)*100):0;
    return `<article class="combo"><div class="combo-visual"><div class="combo-image-card primary">${primary?`<img src="${esc(primary.image)}" alt="${esc(primary.name)}" loading="lazy" decoding="async"/>`:''}${primary?`<span class="combo-image-label">${esc(primary.name)}</span>`:''}</div><div class="combo-image-card secondary">${secondary?`<img src="${esc(secondary.image)}" alt="${esc(secondary.name)}" loading="lazy" decoding="async"/>`:''}${secondary?`<span class="combo-image-label">${esc(secondary.name)}</span>`:''}</div></div><div class="combo-copy"><span class="section-kicker">AHORRA ${discount}%</span><h3>${esc(c.name)}</h3><p>${esc(c.description)}</p><div class="combo-products">${names.map((n,i)=>`<span><i>${i===0?'◉':'◎'}</i>${esc(n)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong><span class="old">${money(c.oldPrice)}</span></div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div><button class="btn btn-secondary" data-combo-detail="${c.id}">Ver más detalles</button></div></div></article>`;
  }).join('');
  $('combosGrid').querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  $('combosGrid').querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
  $('combosGrid').querySelectorAll('[data-combo-detail]').forEach(b=>b.onclick=()=>openComboDetail(b.dataset.comboDetail));
}
function renderFaqs(){$('faqList').innerHTML=state.faqs.map(f=>`<article class="faq"><button class="faq-q"><span>${esc(f.q)}</span><i>▾</i></button><div class="faq-a">${esc(f.a)}</div></article>`).join('');$('faqList').querySelectorAll('.faq-q').forEach(q=>q.onclick=()=>{const item=q.closest('.faq');const a=item.querySelector('.faq-a');item.classList.toggle('open');a.style.maxHeight=item.classList.contains('open')?`${a.scrollHeight}px`:'0px'})}
function bindProductActions(root=document){root.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>addToCart(b.dataset.add));root.querySelectorAll('[data-fav]').forEach(b=>b.onclick=()=>toggleFavorite(b.dataset.fav));root.querySelectorAll('[data-detail]').forEach(b=>b.onclick=()=>openDetail(b.dataset.detail));root.querySelectorAll('[data-support]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.support);openBot('support',`Hola. Necesito información sobre ${p.name}, precio ${money(p.price)}.`,{Producto:p.name,Precio:money(p.price),Tipo:'Consulta'})})}
function addToCart(id,qty=1){const p=state.products.find(x=>x.id===id);if(!p||Number(p.stock)<=0)return toast('Producto agotado.','warn');const item=state.cart.find(x=>x.id===id);const current=item?item.qty:0;const next=Math.min(current+qty,Number(p.stock));if(item)item.qty=next;else state.cart.push({id:p.id,qty:Math.min(qty,Number(p.stock))});write(KEYS.cart,state.cart);renderHeader();renderCart();toast(`${p.name} añadido al carrito.`,'success')}
function addCombo(combo){if(!combo)return;combo.productIds.forEach(id=>addToCart(id,1));toast(`${combo.name} agregado.`,'success')}
function changeQty(id,delta){const p=state.products.find(x=>x.id===id);const item=state.cart.find(x=>x.id===id);if(!p||!item)return;item.qty=Math.max(0,Math.min(item.qty+delta,Number(p.stock)));if(item.qty===0)state.cart=state.cart.filter(x=>x.id!==id);write(KEYS.cart,state.cart);renderHeader();renderCart()}
function removeCart(id){state.cart=state.cart.filter(x=>x.id!==id);write(KEYS.cart,state.cart);renderHeader();renderCart()}
function cartDetails(){return state.cart.map(i=>{const p=state.products.find(x=>x.id===i.id);return p?{...p,qty:i.qty}:null}).filter(Boolean)}
function renderCart(){const items=cartDetails();$('cartItems').innerHTML=items.length?items.map(i=>`<article class="list-card"><img src="${esc(i.image)}" alt="${esc(i.name)}"/><div><h3>${esc(i.name)}</h3><p>${money(i.price)} · ${stockInfo(i)[0]}</p><div class="list-actions"><div class="qty"><button data-dec="${i.id}">−</button><span>${i.qty}</span><button data-inc="${i.id}">＋</button></div><button class="btn btn-red btn-sm" data-remove-cart="${i.id}">Eliminar</button></div></div><strong>${money(i.price*i.qty)}</strong></article>`).join(''):'<div class="empty">Tu carrito está vacío.</div>';$('cartTotal').textContent=money(items.reduce((s,i)=>s+i.price*i.qty,0));$('cartItems').querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>changeQty(b.dataset.inc,1));$('cartItems').querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>changeQty(b.dataset.dec,-1));$('cartItems').querySelectorAll('[data-remove-cart]').forEach(b=>b.onclick=()=>removeCart(b.dataset.removeCart))}
function toggleFavorite(id){state.favorites=state.favorites.includes(id)?state.favorites.filter(x=>x!==id):[...state.favorites,id];write(KEYS.favorites,state.favorites);renderHeader();renderProducts();renderFavorites()}
function renderFavorites(){const list=state.products.filter(p=>state.favorites.includes(p.id));$('favItems').innerHTML=list.length?list.map(p=>`<article class="list-card"><img src="${esc(p.image)}" alt="${esc(p.name)}"/><div><h3>${esc(p.name)}</h3><p>${esc(p.category)} · ${money(p.price)}</p><div class="list-actions"><button class="btn btn-primary btn-sm" data-fav-add="${p.id}">Añadir</button><button class="btn btn-secondary btn-sm" data-fav-detail="${p.id}">Ver</button><button class="btn btn-red btn-sm" data-fav-remove="${p.id}">Quitar</button></div></div></article>`).join(''):'<div class="empty">Aún no tienes productos favoritos.</div>';$('favItems').querySelectorAll('[data-fav-add]').forEach(b=>b.onclick=()=>addToCart(b.dataset.favAdd));$('favItems').querySelectorAll('[data-fav-detail]').forEach(b=>b.onclick=()=>openDetail(b.dataset.favDetail));$('favItems').querySelectorAll('[data-fav-remove]').forEach(b=>b.onclick=()=>toggleFavorite(b.dataset.favRemove))}
function openDetail(id){const p=state.products.find(x=>x.id===id);if(!p)return;const [stock,stockClass]=stockInfo(p);$('detailBody').innerHTML=`<div class="product-detail"><img src="${esc(p.image)}" alt="${esc(p.name)}"/><div><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row" style="margin:12px 0"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock ${stockClass}" style="margin-top:10px">${stock} · ${Number(p.stock)} unidades</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>Añadir al carrito</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;openModal('detailModal');$('detailAdd').onclick=()=>{addToCart(p.id);closeModal('detailModal')};$('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});$('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)}}
function openComboDetail(id){const c=state.combos.find(x=>x.id===id);if(!c)return;const items=c.productIds.map(pid=>state.products.find(p=>p.id===pid)).filter(Boolean);const primary=items[0];const secondary=items[1];const discount=c.oldPrice?Math.round((1-c.price/c.oldPrice)*100):0;$('detailBody').innerHTML=`<div class="combo-detail"><div class="combo-detail-visual"><div class="combo-detail-stage"><div class="combo-image-card primary">${primary?`<img class="combo-detail-main" src="${esc(primary.image)}" alt="${esc(primary.name)}"/>`:''}${primary?`<span class="combo-image-label">${esc(primary.name)}</span>`:''}</div><div class="combo-image-card secondary">${secondary?`<img class="combo-detail-secondary" src="${esc(secondary.image)}" alt="${esc(secondary.name)}"/>`:''}${secondary?`<span class="combo-image-label">${esc(secondary.name)}</span>`:''}</div></div></div><div><span class="section-kicker">Combo inteligente · Ahorra ${discount}%</span><h2>${esc(c.name)}</h2><div class="price-row" style="margin:12px 0"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><p>${esc(c.description)}</p><div class="combo-detail-items">${items.map(item=>`<div class="combo-detail-item"><img src="${esc(item.image)}" alt="${esc(item.name)}"/><div><h4>${esc(item.name)}</h4><p>${esc(item.category)} · ${money(item.price)}</p></div></div>`).join('')}</div><div class="combo-detail-actions"><button class="btn btn-primary" id="detailAddCombo">🛒 Añadir combo</button><button class="btn btn-green" id="detailSupportCombo">WhatsApp</button><button class="btn btn-secondary" id="detailCloseCombo">Seguir viendo combos</button></div></div></div>`;openModal('detailModal');$('detailAddCombo').onclick=()=>{addCombo(c);closeModal('detailModal')};$('detailSupportCombo').onclick=()=>openBot('support',`Hola. Necesito información detallada sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'});$('detailCloseCombo').onclick=()=>closeModal('detailModal')}
function getSuggestions(q){const n=norm(q);if(!n)return state.products.slice(0,6);return state.products.filter(p=>norm(`${p.name} ${p.category}`).includes(n)).slice(0,7)}
function renderSuggestions(){const list=getSuggestions($('searchInput').value);state.activeSuggestion=-1;$('suggestions').innerHTML=list.length?list.map((p,i)=>`<button class="suggestion" data-suggest="${p.id}" data-index="${i}"><img src="${esc(p.image)}" alt=""/><span><b>${esc(p.name)}</b><small>${esc(p.category)}</small></span><strong>${money(p.price)}</strong></button>`).join(''):'<div class="empty" style="padding:18px">Sin coincidencias.</div>';$('suggestions').classList.add('open');$('searchInput').setAttribute('aria-expanded','true');$('suggestions').querySelectorAll('[data-suggest]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.suggest);$('searchInput').value=p.name;state.query=p.name;$('searchClear').classList.add('show');closeSuggestions();renderProducts();$('catalog').scrollIntoView({behavior:'smooth'})})}
function closeSuggestions(){$('suggestions').classList.remove('open');$('searchInput').setAttribute('aria-expanded','false');state.activeSuggestion=-1}
function activateSuggestion(i){const opts=[...$('suggestions').querySelectorAll('.suggestion')];if(!opts.length)return;state.activeSuggestion=(i+opts.length)%opts.length;opts.forEach((o,j)=>o.classList.toggle('active',j===state.activeSuggestion));opts[state.activeSuggestion].scrollIntoView({block:'nearest'})}
function copyText(text){if(navigator.clipboard?.writeText){navigator.clipboard.writeText(text).catch(()=>fallbackCopy(text));return}fallbackCopy(text)}
function fallbackCopy(text){const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(e){}ta.remove()}
function isWhatsAppUrl(url){return /(^|\.)wa\.me$|whatsapp\.com|api\.whatsapp\.com/i.test((()=>{try{return new URL(url,location.href).hostname}catch(e){return ''}})())}
function buildBotUrl(kind,message,extra={}){const isOrder=kind==='order';const base=isOrder?state.settings.orderBotUrl:state.settings.supportBotUrl;if(!base||base==='#')return '';try{const u=new URL(base,location.href);if(isWhatsAppUrl(base))u.searchParams.set('text',message);else{u.searchParams.set(isOrder?(state.settings.orderVariable||'Pedido'):(state.settings.supportVariable||'Consulta'),message);Object.entries(extra).forEach(([k,v])=>{if(v!==undefined&&v!==null&&String(v)!=='')u.searchParams.set(k,String(v))});if(isOrder)u.searchParams.set(state.settings.orderJsonVariable||'PedidoJSON',JSON.stringify(extra))}u.searchParams.set('Origen','CRULOX');return u.toString()}catch(e){console.warn(e);return ''}}
function openBot(kind,message,extra={}){const url=buildBotUrl(kind,message,extra);copyText(message);if(!url){toast(kind==='order'?'Estamos mejorando el proceso de pedidos para ofrecerte una experiencia más clara y segura.':'Estamos mejorando este canal para brindarte una atención más rápida y personalizada.','warn');return false}const w=window.open(url,'_blank');if(w){try{w.opener=null}catch(e){}}else{toast('El navegador bloqueó la ventana. Se abrirá en esta pestaña.','warn');location.assign(url)}return true}
function renderAccount(){const user=currentUser();if(user){$('accountBody').innerHTML=`<div class="profile-card"><span class="section-kicker">Sesión activa</span><h3>${esc(user.fullName)}</h3><div class="profile-grid">${[['Usuario',user.username],['Correo',user.email],['Teléfono',user.phone],['Departamento',user.department],['Municipio',user.municipality],['Dirección',user.address],['Referencia',user.reference]].map(([a,b])=>`<div class="profile-info"><small>${a}</small><b>${esc(b)}</b></div>`).join('')}</div><div class="form-actions"><button class="btn btn-primary" id="editProfile">Editar perfil</button><button class="btn btn-secondary" id="profileOrders">Mis pedidos</button><button class="btn btn-red" id="logoutClient">Cerrar sesión</button></div></div>`;$('editProfile').onclick=()=>renderProfileEditor(user);$('profileOrders').onclick=renderClientOrders;$('logoutClient').onclick=()=>{state.session=null;write(KEYS.session,null);renderHeader();renderAccount();toast('Sesión cerrada.','success')}}else{$('accountBody').innerHTML=`<div class="tabs"><button class="tab active" data-auth-tab="login">Iniciar sesión</button><button class="tab" data-auth-tab="register">Crear cuenta</button></div><div id="authContent"></div>`;$('accountBody').querySelectorAll('[data-auth-tab]').forEach(t=>t.onclick=()=>{$('accountBody').querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===t));t.dataset.authTab==='login'?renderLogin():renderRegister()});renderLogin()}}
function renderLogin(){$('authContent').innerHTML=`<form id="loginForm"><div class="form-grid"><div class="field full"><label>Usuario o correo</label><input id="loginIdentity" required autocomplete="username"/></div><div class="field full"><label>Contraseña</label><input id="loginPassword" type="password" required autocomplete="current-password"/></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Acceder</button></div></form>`;$('loginForm').onsubmit=handleLogin}
function renderRegister(){$('authContent').innerHTML=`<form id="registerForm"><div class="form-grid">${accountFields().map(f=>fieldHtml(f,'reg')).join('')}<div class="field"><label>Contraseña</label><input id="regPassword" type="password" minlength="8" required/></div><div class="field"><label>Confirmar contraseña</label><input id="regConfirm" type="password" minlength="8" required/></div><div class="field full"><label><input id="regConsent" type="checkbox" required style="width:auto;min-height:0"/> Acepto que mis datos se utilicen para gestionar pedidos y entregas.</label></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Crear cuenta</button></div></form>`;$('registerForm').onsubmit=handleRegister}
function accountFields(){return[{key:'fullName',label:'Nombre completo',required:true},{key:'username',label:'Usuario',required:true},{key:'email',label:'Correo electrónico',type:'email',required:true},{key:'phone',label:'Teléfono',type:'tel',required:true},{key:'department',label:'Departamento',required:true},{key:'municipality',label:'Municipio',required:true},{key:'address',label:'Dirección completa',required:true,full:true},{key:'reference',label:'Referencia de entrega',required:true,full:true}]}
function fieldHtml(f,prefix,value=''){return `<div class="field ${f.full?'full':''}"><label>${f.label}</label><input id="${prefix}${f.key.charAt(0).toUpperCase()+f.key.slice(1)}" type="${f.type||'text'}" value="${esc(value)}" ${f.required?'required':''}/></div>`}
function collectAccount(prefix){const data={};accountFields().forEach(f=>data[f.key]=$(`${prefix}${f.key.charAt(0).toUpperCase()+f.key.slice(1)}`).value.trim());return data}
async function handleRegister(e){e.preventDefault();const data=collectAccount('reg');const password=$('regPassword').value;if(password!==$('regConfirm').value)return toast('Las contraseñas no coinciden.','error');if(state.users.some(u=>norm(u.username)===norm(data.username)||norm(u.email)===norm(data.email)))return toast('El usuario o correo ya está registrado.','error');const user={id:uid('usr'),...data,passwordHash:await sha256(password),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};state.users.push(user);state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};write(KEYS.users,state.users);write(KEYS.session,state.session);logActivity('Cliente registrado',user.email);renderHeader();renderAccount();toast('Cuenta creada correctamente.','success')}
async function handleLogin(e){e.preventDefault();const identity=$('loginIdentity').value.trim();const pass=$('loginPassword').value;const hash=await sha256(pass);if(norm(identity)===norm(ADMIN_EMAIL)&&hash===ADMIN_PASSWORD_HASH){state.session={role:'admin',email:ADMIN_EMAIL,createdAt:new Date().toISOString()};write(KEYS.session,state.session);closeModal('accountModal');openAdmin('dashboard');logActivity('Inicio administrativo',ADMIN_EMAIL);return}const user=state.users.find(u=>norm(u.username)===norm(identity)||norm(u.email)===norm(identity));if(!user||user.passwordHash!==hash)return toast('Credenciales incorrectas.','error');state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};write(KEYS.session,state.session);renderHeader();renderAccount();toast('Sesión iniciada.','success')}
function renderProfileEditor(user){$('accountBody').innerHTML=`<form id="profileForm"><div class="form-grid">${accountFields().map(f=>fieldHtml(f,'edit',user[f.key])).join('')}<div class="field"><label>Nueva contraseña (opcional)</label><input id="editPassword" type="password" minlength="8"/></div><div class="field"><label>Confirmar contraseña</label><input id="editConfirm" type="password" minlength="8"/></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar cambios</button><button class="btn btn-secondary" type="button" id="cancelEditProfile">Cancelar</button></div></form>`;$('cancelEditProfile').onclick=renderAccount;$('profileForm').onsubmit=async e=>{e.preventDefault();const data=collectAccount('edit');if(state.users.some(u=>u.id!==user.id&&(norm(u.username)===norm(data.username)||norm(u.email)===norm(data.email))))return toast('Usuario o correo ya utilizado.','error');const pass=$('editPassword').value;if(pass&&pass!==$('editConfirm').value)return toast('Las contraseñas no coinciden.','error');Object.assign(user,data,{updatedAt:new Date().toISOString()});if(pass)user.passwordHash=await sha256(pass);write(KEYS.users,state.users);renderAccount();renderHeader();toast('Perfil actualizado.','success')}}
function renderClientOrders(){const user=currentUser();const list=state.orders.filter(o=>o.userId===user.id||norm(o.customer?.email)===norm(user.email));$('accountBody').innerHTML=`<div class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Mis pedidos</h2><button class="btn btn-secondary btn-sm" id="backProfile">Volver</button></div><div class="admin-list">${list.length?list.map(o=>`<article class="admin-list-item"><div><h3>${esc(o.id)} · ${money(o.total)}</h3><p>${new Date(o.createdAt).toLocaleString('es-GT')} · ${esc(o.status)}</p></div><span class="status">${esc(o.status)}</span></article>`).join(''):'<div class="empty">Todavía no tienes pedidos registrados.</div>'}</div></div>`;$('backProfile').onclick=renderAccount}
function checkoutField(label,key,value){return `<div class="field ${key==='address'||key==='reference'?'full':''}"><label>${label}</label><input id="co${key.charAt(0).toUpperCase()+key.slice(1)}" value="${esc(value)}" readonly/></div>`}
function openCheckout(){if(!state.cart.length)return toast('Tu carrito está vacío.','warn');const user=currentUser();if(!user){closeAllPanels();renderAccount();openModal('accountModal');toast('Inicia sesión o crea una cuenta antes de enviar el pedido.','warn');return}const map=[['Nombre completo','fullName'],['Correo','email'],['Teléfono','phone'],['Departamento','department'],['Municipio','municipality'],['Dirección','address'],['Referencia','reference']];$('checkoutFields').innerHTML=map.map(([a,k])=>checkoutField(a,k,user[k])).join('');closeAllPanels();openModal('checkoutModal')}
function buildOrder(user,items,notes=''){return{id:`NP-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${Math.random().toString(36).slice(2,7).toUpperCase()}`,userId:user.id,customer:{fullName:user.fullName,email:user.email,phone:user.phone,department:user.department,municipality:user.municipality,address:user.address,reference:user.reference},items:items.map(i=>({id:i.id,name:i.name,price:Number(i.price),qty:Number(i.qty)})),total:items.reduce((s,i)=>s+Number(i.price)*Number(i.qty),0),notes,status:'Nuevo',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()}}
function orderMessage(order){return `📦 Pedido ${order.id} - CRULOX\nNombre: ${order.customer.fullName}\nCorreo: ${order.customer.email}\nTeléfono: ${order.customer.phone}\nDepartamento: ${order.customer.department}\nMunicipio: ${order.customer.municipality}\nDirección: ${order.customer.address}\nReferencia: ${order.customer.reference}\nProductos:\n${order.items.map(i=>`• ${i.name} x${i.qty} = ${money(i.price*i.qty)}`).join('\n')}\nTotal: ${money(order.total)}\nNotas: ${order.notes||'Ninguna'}`}
function orderExtras(order){return{'Pedido ID':order.id,Nombre:order.customer.fullName,Correo:order.customer.email,Telefono:order.customer.phone,Departamento:order.customer.department,Municipio:order.customer.municipality,Direccion:order.customer.address,Referencia:order.customer.reference,Productos:order.items.map(i=>`${i.name} x${i.qty}`).join(', '),Total:money(order.total),Notas:order.notes||'Ninguna',Tipo:'Pedido',Estado:order.status}}
function registerOrder(order){state.orders.unshift(order);write(KEYS.orders,state.orders);logActivity('Pedido registrado',`${order.id} · ${money(order.total)}`);if(state.session?.role==='admin'&&$('adminOverlay').classList.contains('open'))renderAdminSection(state.adminSection)}
function submitOrder(e){e.preventDefault();const user=currentUser();if(!user)return openCheckout();const order=buildOrder(user,cartDetails(),$('coNotes').value.trim());registerOrder(order);state.cart=[];write(KEYS.cart,state.cart);renderHeader();renderCart();closeModal('checkoutModal');$('coNotes').value='';toast(`Pedido ${order.id} enviado correctamente.`,'success')}
function productForm(product=null){const p=product||{id:'',name:'',category:'',price:'',oldPrice:'',stock:0,rating:5,reviews:0,image:'',description:'',badge:'',badgeText:'',featured:false};return `<form id="productForm"><div class="form-grid"><div class="field full"><label>Nombre</label><input id="pfName" value="${esc(p.name)}" required/></div><div class="field"><label>Categoría</label><input id="pfCategory" value="${esc(p.category)}" required/></div><div class="field"><label>Existencias</label><input id="pfStock" type="number" min="0" value="${Number(p.stock||0)}" required/></div><div class="field"><label>Precio</label><input id="pfPrice" type="number" step="0.01" min="0" value="${p.price}" required/></div><div class="field"><label>Precio anterior</label><input id="pfOldPrice" type="number" step="0.01" min="0" value="${p.oldPrice??''}"/></div><div class="field"><label>Calificación</label><input id="pfRating" type="number" step="0.1" min="0" max="5" value="${p.rating}"/></div><div class="field"><label>Reseñas</label><input id="pfReviews" type="number" min="0" value="${p.reviews}"/></div><div class="field full"><label>URL o data URI de imagen</label><input id="pfImage" value="${esc(p.image)}" required/></div><div class="field full"><label>Cargar imagen local</label><input id="pfFile" type="file" accept="image/*"/></div><div class="field"><label>Etiqueta</label><input id="pfBadgeText" value="${esc(p.badgeText||'')}" placeholder="Nuevo, Oferta..."/></div><div class="field"><label>Destacado</label><select id="pfFeatured"><option value="false" ${!p.featured?'selected':''}>No</option><option value="true" ${p.featured?'selected':''}>Sí</option></select></div><div class="field full"><label>Descripción</label><textarea id="pfDescription" required>${esc(p.description)}</textarea></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Guardar producto</button></div></form>`}
function openProductEditor(id=null){const product=id?state.products.find(p=>p.id===id):null;$('crudTitle').textContent=product?'Editar producto':'Agregar producto';$('crudBody').innerHTML=productForm(product);openModal('crudModal');let fileData='';$('pfFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{fileData=await optimizeImageFile(f,{maxWidth:1400,maxHeight:1400,quality:.9});$('pfImage').value=fileData}catch(error){toast('No fue posible procesar la imagen.','error')}};$('productForm').onsubmit=e=>{e.preventDefault();const data={name:$('pfName').value.trim(),category:$('pfCategory').value.trim(),stock:Number($('pfStock').value),price:Number($('pfPrice').value),oldPrice:$('pfOldPrice').value?Number($('pfOldPrice').value):null,rating:Number($('pfRating').value||0),reviews:Number($('pfReviews').value||0),image:fileData||$('pfImage').value.trim(),description:$('pfDescription').value.trim(),badgeText:$('pfBadgeText').value.trim()||null,badge:$('pfBadgeText').value.trim()?'custom':null,featured:$('pfFeatured').value==='true'};if(product)Object.assign(product,data);else state.products.unshift({id:uid('p'),...data});write(KEYS.products,state.products);logActivity(product?'Producto editado':'Producto agregado',data.name);closeModal('crudModal');renderStore();renderAdminSection('products');toast('Producto guardado.','success')}}
function openAdmin(section='dashboard'){if(state.session?.role!=='admin')return;state.adminSection=section;$('adminOverlay').classList.add('open');document.body.classList.add('lock');renderAdminNav();renderAdminSection(section)}
function renderAdminNav(){$('adminNav').querySelectorAll('[data-admin]').forEach(b=>b.classList.toggle('active',b.dataset.admin===state.adminSection))}
function renderAdminSection(section){state.adminSection=section;renderAdminNav();const titles={dashboard:'Resumen',products:'Productos',inventory:'Inventario',categories:'Categorías',faqs:'Preguntas frecuentes',users:'Clientes',orders:'Pedidos',settings:'Tienda',bots:'Atención',backup:'Respaldos',activity:'Actividad'};$('adminTitle').textContent=titles[section]||'Administración';const fn={dashboard:adminDashboard,products:adminProducts,inventory:adminInventory,categories:adminCategories,faqs:adminFaqs,users:adminUsers,orders:adminOrders,settings:adminSettings,bots:adminBots,backup:adminBackup,activity:adminActivity}[section]||adminDashboard;fn()}
function metric(label,value){return `<article class="metric"><small>${label}</small><strong>${value}</strong></article>`}
function adminDashboard(){const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);const low=state.products.filter(p=>p.stock>0&&p.stock<=Number(state.settings.lowStock||5)).length;const out=state.products.filter(p=>p.stock<=0).length;$('adminContent').innerHTML=`<div class="notice"><b>Importante:</b> este panel funciona localmente en el navegador actual. Para producción real se necesita backend, base de datos y autenticación del servidor.</div><div class="admin-grid">${metric('Productos',state.products.length)}${metric('Categorías',categories().length)}${metric('Clientes',state.users.length)}${metric('Pedidos',state.orders.length)}${metric('Ventas registradas',money(sales))}${metric('Stock bajo',low)}${metric('Agotados',out)}${metric('FAQ',state.faqs.length)}</div><div class="admin-two"><section class="admin-card"><div class="admin-card-head"><h2>Acciones rápidas</h2></div><div class="toolbar"><button class="btn btn-primary btn-sm" id="quickAddProduct">Agregar producto</button><button class="btn btn-secondary btn-sm" id="quickOrders">Revisar pedidos</button><button class="btn btn-secondary btn-sm" id="quickBots">Configurar atención</button><button class="btn btn-secondary btn-sm" id="quickBackup">Crear respaldo</button></div></section><section class="admin-card"><div class="admin-card-head"><h2>Estado técnico</h2></div><div class="admin-list"><article class="admin-list-item"><div><h3>Canal de atención</h3><p>${esc(state.settings.supportBotUrl)}</p></div><span class="status ${state.settings.supportBotUrl==='#'?'warn':''}">${state.settings.supportBotUrl==='#'?'Pendiente':'Configurado'}</span></article><article class="admin-list-item"><div><h3>Gestión de pedidos</h3><p>${esc(state.settings.orderBotUrl)}</p></div><span class="status ${state.settings.orderBotUrl==='#'?'warn':''}">${state.settings.orderBotUrl==='#'?'Pendiente':'Configurado'}</span></article></div></section></div>`;$('quickAddProduct').onclick=()=>openProductEditor();$('quickOrders').onclick=()=>renderAdminSection('orders');$('quickBots').onclick=()=>renderAdminSection('bots');$('quickBackup').onclick=exportBackup}
function adminProducts(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Gestión de productos</h2><div class="toolbar"><input id="adminProductSearch" placeholder="Buscar producto"/><button class="btn btn-primary btn-sm" id="adminAddProduct">Agregar producto</button></div></div><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Etiqueta</th><th>Acciones</th></tr></thead><tbody id="adminProductRows"></tbody></table></div></section>`;const renderRows=()=>{const q=norm($('adminProductSearch').value);const list=state.products.filter(p=>!q||norm(`${p.name} ${p.category}`).includes(q));$('adminProductRows').innerHTML=list.map(p=>`<tr><td><div style="display:flex;align-items:center;gap:8px"><img src="${esc(p.image)}" alt=""><b>${esc(p.name)}</b></div></td><td>${esc(p.category)}</td><td>${money(p.price)}</td><td><span class="status ${p.stock<=0?'bad':p.stock<=state.settings.lowStock?'warn':''}">${p.stock}</span></td><td>${esc(p.badgeText||'—')}</td><td><div class="toolbar"><button class="btn btn-secondary btn-sm" data-edit-product="${p.id}">Editar</button><button class="btn btn-secondary btn-sm" data-duplicate-product="${p.id}">Duplicar</button><button class="btn btn-red btn-sm" data-delete-product="${p.id}">Eliminar</button></div></td></tr>`).join('');$('adminProductRows').querySelectorAll('[data-edit-product]').forEach(b=>b.onclick=()=>openProductEditor(b.dataset.editProduct));$('adminProductRows').querySelectorAll('[data-duplicate-product]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.duplicateProduct);state.products.unshift({...clone(p),id:uid('p'),name:`${p.name} copia`});write(KEYS.products,state.products);renderRows();renderStore();logActivity('Producto duplicado',p.name)});$('adminProductRows').querySelectorAll('[data-delete-product]').forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>x.id===b.dataset.deleteProduct);if(!await npConfirm(`Eliminar ${p.name}?`))return;state.products=state.products.filter(x=>x.id!==p.id);state.cart=state.cart.filter(x=>x.id!==p.id);state.favorites=state.favorites.filter(x=>x!==p.id);persistCore();renderRows();renderStore();logActivity('Producto eliminado',p.name)})};renderRows();$('adminProductSearch').oninput=renderRows;$('adminAddProduct').onclick=()=>openProductEditor()}
function adminInventory(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Control de inventario</h2><div class="toolbar"><input id="inventorySearch" placeholder="Buscar"/><select id="inventoryFilter"><option value="all">Todos</option><option value="low">Stock bajo</option><option value="out">Agotados</option></select></div></div><div class="admin-list" id="inventoryList"></div></section>`;const render=()=>{const q=norm($('inventorySearch').value),filter=$('inventoryFilter').value;const list=state.products.filter(p=>(!q||norm(p.name).includes(q))&&(filter==='all'||filter==='low'&&(p.stock>0&&p.stock<=state.settings.lowStock)||filter==='out'&&p.stock<=0));$('inventoryList').innerHTML=list.map(p=>`<article class="admin-list-item"><div><h3>${esc(p.name)}</h3><p>${esc(p.category)} · ${money(p.price)}</p></div><div class="toolbar"><button class="btn btn-secondary btn-sm" data-stock="${p.id}" data-delta="-1">−1</button><span class="status ${p.stock<=0?'bad':p.stock<=state.settings.lowStock?'warn':''}">${p.stock}</span><button class="btn btn-primary btn-sm" data-stock="${p.id}" data-delta="1">+1</button><button class="btn btn-secondary btn-sm" data-set-stock="${p.id}">Definir</button></div></article>`).join('')||'<div class="empty">No hay productos en este filtro.</div>';$('inventoryList').querySelectorAll('[data-stock]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.stock);p.stock=Math.max(0,p.stock+Number(b.dataset.delta));write(KEYS.products,state.products);render();renderStore()});$('inventoryList').querySelectorAll('[data-set-stock]').forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>x.id===b.dataset.setStock);const n=await npPrompt(`Existencias para ${p.name}`,p.stock);if(n===null||isNaN(Number(n)))return;p.stock=Math.max(0,Number(n));write(KEYS.products,state.products);render();renderStore()})};render();$('inventorySearch').oninput=render;$('inventoryFilter').onchange=render}
function adminCategories(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Categorías</h2><button class="btn btn-primary btn-sm" id="addCategory">Agregar categoría</button></div><div class="admin-list" id="categoryAdminList"></div></section>`;const render=()=>{$('categoryAdminList').innerHTML=categories().map(c=>`<article class="admin-list-item"><div><h3>${esc(c)}</h3><p>${state.products.filter(p=>p.category===c).length} productos</p></div><div class="toolbar"><button class="btn btn-secondary btn-sm" data-rename-cat="${esc(c)}">Renombrar</button><button class="btn btn-red btn-sm" data-delete-cat="${esc(c)}">Eliminar</button></div></article>`).join('')||'<div class="empty">No hay categorías.</div>';$('categoryAdminList').querySelectorAll('[data-rename-cat]').forEach(b=>b.onclick=async()=>{const old=b.dataset.renameCat;const next=(await npPrompt('Nuevo nombre',old))?.trim();if(!next||next===old)return;state.products.forEach(p=>{if(p.category===old)p.category=next});write(KEYS.products,state.products);render();renderStore();logActivity('Categoría renombrada',`${old} → ${next}`)});$('categoryAdminList').querySelectorAll('[data-delete-cat]').forEach(b=>b.onclick=()=>{const cat=b.dataset.deleteCat;const count=state.products.filter(p=>p.category===cat).length;if(count)return toast('No puedes eliminar una categoría con productos. Reasigna los productos primero.','warn');render()})};render();$('addCategory').onclick=()=>toast('Las categorías se crean al asignarlas a un producto.','info')}
function adminFaqs(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Preguntas frecuentes</h2><button class="btn btn-primary btn-sm" id="addFaq">Agregar pregunta</button></div><div class="admin-list" id="faqAdminList"></div></section>`;const render=()=>{$('faqAdminList').innerHTML=state.faqs.map(f=>`<article class="admin-list-item"><div><h3>${esc(f.q)}</h3><p>${esc(f.a)}</p></div><div class="toolbar"><button class="btn btn-secondary btn-sm" data-edit-faq="${f.id}">Editar</button><button class="btn btn-red btn-sm" data-delete-faq="${f.id}">Eliminar</button></div></article>`).join('')||'<div class="empty">No hay preguntas.</div>';$('faqAdminList').querySelectorAll('[data-edit-faq]').forEach(b=>b.onclick=()=>openFaqEditor(b.dataset.editFaq));$('faqAdminList').querySelectorAll('[data-delete-faq]').forEach(b=>b.onclick=()=>{state.faqs=state.faqs.filter(x=>x.id!==b.dataset.deleteFaq);write(KEYS.faqs,state.faqs);render();renderFaqs()})};render();$('addFaq').onclick=()=>openFaqEditor()}
function openFaqEditor(id=null){const f=id?state.faqs.find(x=>x.id===id):null;$('crudTitle').textContent=f?'Editar pregunta':'Agregar pregunta';$('crudBody').innerHTML=`<form id="faqForm"><div class="field"><label>Pregunta</label><input id="ffQuestion" value="${esc(f?.q||'')}" required/></div><div class="field" style="margin-top:10px"><label>Respuesta</label><textarea id="ffAnswer" required>${esc(f?.a||'')}</textarea></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Guardar</button></div></form>`;openModal('crudModal');$('faqForm').onsubmit=e=>{e.preventDefault();if(f)Object.assign(f,{q:$('ffQuestion').value.trim(),a:$('ffAnswer').value.trim()});else state.faqs.push({id:uid('f'),q:$('ffQuestion').value.trim(),a:$('ffAnswer').value.trim()});write(KEYS.faqs,state.faqs);closeModal('crudModal');renderFaqs();renderAdminSection('faqs');logActivity(f?'FAQ editada':'FAQ agregada',$('ffQuestion')?.value||'')}}
function adminUsers(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Clientes registrados</h2><button class="btn btn-secondary btn-sm" id="exportUsers">Exportar CSV</button></div><div class="table-wrap"><table><thead><tr><th>Cliente</th><th>Usuario</th><th>Teléfono</th><th>Ubicación</th><th>Registro</th><th>Acciones</th></tr></thead><tbody>${state.users.map(u=>`<tr><td><b>${esc(u.fullName)}</b><br>${esc(u.email)}</td><td>${esc(u.username)}</td><td>${esc(u.phone)}</td><td>${esc(u.municipality)}, ${esc(u.department)}</td><td>${new Date(u.createdAt).toLocaleDateString('es-GT')}</td><td><button class="btn btn-red btn-sm" data-delete-user="${u.id}">Eliminar</button></td></tr>`).join('')}</tbody></table></div></section>`;$('adminContent').querySelectorAll('[data-delete-user]').forEach(b=>b.onclick=async()=>{const u=state.users.find(x=>x.id===b.dataset.deleteUser);if(!await npConfirm(`Eliminar la cuenta de ${u.fullName}?`))return;state.users=state.users.filter(x=>x.id!==u.id);write(KEYS.users,state.users);renderAdminSection('users');logActivity('Cliente eliminado',u.email)});$('exportUsers').onclick=()=>exportCsv('clientes',state.users.map(u=>({nombre:u.fullName,usuario:u.username,correo:u.email,telefono:u.phone,departamento:u.department,municipio:u.municipality,direccion:u.address,referencia:u.reference})))}
function adminOrders(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Pedidos</h2><div class="toolbar"><input id="orderSearch" placeholder="Buscar pedido o cliente"/><select id="orderStatus"><option value="all">Todos los estados</option>${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" id="exportOrders">Exportar CSV</button></div></div><div class="admin-list" id="orderAdminList"></div></section>`;const render=()=>{const q=norm($('orderSearch').value),st=$('orderStatus').value;const list=state.orders.filter(o=>(st==='all'||o.status===st)&&(!q||norm(`${o.id} ${o.customer?.fullName} ${o.customer?.email}`).includes(q)));$('orderAdminList').innerHTML=list.map(o=>`<article class="admin-list-item"><div><h3>${esc(o.id)} · ${esc(o.customer?.fullName||'Cliente')}</h3><p>${new Date(o.createdAt).toLocaleString('es-GT')} · ${o.items.length} artículos · ${money(o.total)}</p></div><div class="toolbar"><select data-order-status="${o.id}">${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" data-copy-order="${o.id}">Copiar</button><button class="btn btn-green btn-sm" data-resend-order="${o.id}">Reenviar</button><button class="btn btn-red btn-sm" data-delete-order="${o.id}">Eliminar</button></div></article>`).join('')||'<div class="empty">No hay pedidos en este filtro.</div>';$('orderAdminList').querySelectorAll('[data-order-status]').forEach(s=>s.onchange=()=>{const o=state.orders.find(x=>x.id===s.dataset.orderStatus);o.status=s.value;o.updatedAt=new Date().toISOString();write(KEYS.orders,state.orders);logActivity('Estado de pedido',`${o.id} → ${o.status}`)});$('orderAdminList').querySelectorAll('[data-copy-order]').forEach(b=>b.onclick=()=>{const o=state.orders.find(x=>x.id===b.dataset.copyOrder);copyText(orderMessage(o));toast('Pedido copiado.','success')});$('orderAdminList').querySelectorAll('[data-resend-order]').forEach(b=>b.onclick=()=>{const o=state.orders.find(x=>x.id===b.dataset.resendOrder);openBot('order',orderMessage(o),orderExtras(o))});$('orderAdminList').querySelectorAll('[data-delete-order]').forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>x.id===b.dataset.deleteOrder);if(!await npConfirm(`Eliminar el pedido ${o.id}?`))return;state.orders=state.orders.filter(x=>x.id!==o.id);write(KEYS.orders,state.orders);render();logActivity('Pedido eliminado',o.id)})};render();$('orderSearch').oninput=render;$('orderStatus').onchange=render;$('exportOrders').onclick=()=>exportCsv('pedidos',state.orders.map(o=>({id:o.id,cliente:o.customer?.fullName,correo:o.customer?.email,telefono:o.customer?.phone,total:o.total,estado:o.status,fecha:o.createdAt,productos:o.items.map(i=>`${i.name} x${i.qty}`).join(' | ')})))}
function adminSettings(){$('adminContent').innerHTML=`<form class="admin-card" style="margin-top:0" id="settingsForm"><div class="admin-card-head"><h2>Identidad y datos de la tienda</h2></div><div class="form-grid"><div class="field"><label>Nombre de tienda</label><input id="setName" value="${esc(state.settings.storeName)}"/></div><div class="field"><label>Correo</label><input id="setEmail" type="email" value="${esc(state.settings.email)}"/></div><div class="field full"><label>Eslogan</label><input id="setSlogan" value="${esc(state.settings.slogan)}"/></div><div class="field full"><label>Descripción</label><textarea id="setSubtitle">${esc(state.settings.subtitle)}</textarea></div><div class="field"><label>Moneda</label><input id="setCurrency" value="${esc(state.settings.currency)}"/></div><div class="field"><label>Límite de stock bajo</label><input id="setLowStock" type="number" min="0" value="${state.settings.lowStock}"/></div><div class="field"><label>Facebook</label><input id="setFacebook" value="${esc(state.settings.facebookUrl)}"/></div><div class="field"><label>Instagram</label><input id="setInstagram" value="${esc(state.settings.instagramUrl)}"/></div><div class="field"><label>TikTok</label><input id="setTiktok" value="${esc(state.settings.tiktokUrl)}"/></div><div class="field"><label>Texto de entrega</label><input id="setShipping" value="${esc(state.settings.shippingText)}"/></div><div class="field"><label>Texto de cambios</label><input id="setReturn" value="${esc(state.settings.returnText)}"/></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar configuración</button></div></form>`;$('settingsForm').onsubmit=e=>{e.preventDefault();Object.assign(state.settings,{storeName:$('setName').value.trim(),email:$('setEmail').value.trim(),slogan:$('setSlogan').value.trim(),subtitle:$('setSubtitle').value.trim(),currency:$('setCurrency').value.trim()||'Q',lowStock:Number($('setLowStock').value||5),facebookUrl:$('setFacebook').value.trim()||'#',instagramUrl:$('setInstagram').value.trim()||'#',tiktokUrl:$('setTiktok').value.trim()||'#',shippingText:$('setShipping').value.trim(),returnText:$('setReturn').value.trim()});write(KEYS.settings,state.settings);applySettings();renderStore();logActivity('Configuración de tienda','Actualizada');toast('Configuración guardada.','success')}}
function botDiagnostic(kind){const msg=kind==='order'?'PRUEBA DE PEDIDO NOVAPRIME GT':'Prueba de consulta CRULOX';const extra=kind==='order'?{'Pedido ID':'NP-PRUEBA',Nombre:'Cliente de prueba',Productos:'Producto x1',Total:money(1),Tipo:'Pedido'}:{Tipo:'Consulta'};return buildBotUrl(kind,msg,extra)}
function adminBots(){$('adminContent').innerHTML=`<div class="admin-two"><form class="admin-card" style="margin-top:0" id="supportBotForm"><div class="admin-card-head"><h2>💬 Canal de atención</h2></div><p style="color:var(--sub);font-size:.68rem;line-height:1.55;margin-bottom:10px">Recibe dudas de productos y soporte general.</p><div class="field"><label>URL pública</label><input id="botSupportUrl" value="${esc(state.settings.supportBotUrl)}"/></div><div class="field" style="margin-top:9px"><label>Nombre exacto de variable</label><input id="botSupportVar" value="${esc(state.settings.supportVariable)}"/></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar</button><button class="btn btn-secondary" type="button" id="testSupport">Probar</button></div></form><form class="admin-card" style="margin-top:0" id="orderBotForm"><div class="admin-card-head"><h2>📦 Gestión de pedidos</h2></div><p style="color:var(--sub);font-size:.68rem;line-height:1.55;margin-bottom:10px">Recibe el pedido completo y variables individuales.</p><div class="field"><label>URL pública</label><input id="botOrderUrl" value="${esc(state.settings.orderBotUrl)}"/></div><div class="field" style="margin-top:9px"><label>Variable del texto completo</label><input id="botOrderVar" value="${esc(state.settings.orderVariable)}"/></div><div class="field" style="margin-top:9px"><label>Variable JSON</label><input id="botOrderJson" value="${esc(state.settings.orderJsonVariable)}"/></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar</button><button class="btn btn-secondary" type="button" id="testOrder">Probar</button></div></form></div><section class="admin-card"><div class="admin-card-head"><h2>Diagnóstico de enlaces</h2></div><div class="admin-list"><article class="admin-list-item"><div><h3>URL de consulta generada</h3><p style="word-break:break-all">${esc(botDiagnostic('support')||'Sin configurar')}</p></div><button class="btn btn-secondary btn-sm" id="copySupportUrl">Copiar</button></article><article class="admin-list-item"><div><h3>URL de pedido generada</h3><p style="word-break:break-all">${esc(botDiagnostic('order')||'Sin configurar')}</p></div><button class="btn btn-secondary btn-sm" id="copyOrderUrl">Copiar</button></article></div><div class="notice" style="margin-top:12px">En el servicio de atención conectado, los nombres de variables deben coincidir exactamente con los configurados aquí. Para enlaces de WhatsApp reales, el sistema utiliza automáticamente el parámetro <b>text</b>.</div></section>`;$('supportBotForm').onsubmit=e=>{e.preventDefault();state.settings.supportBotUrl=$('botSupportUrl').value.trim()||'#';state.settings.supportVariable=$('botSupportVar').value.trim()||'Consulta';write(KEYS.settings,state.settings);renderAdminSection('bots');applySettings();toast('Canal de atención guardado.','success')};$('orderBotForm').onsubmit=e=>{e.preventDefault();state.settings.orderBotUrl=$('botOrderUrl').value.trim()||'#';state.settings.orderVariable=$('botOrderVar').value.trim()||'Pedido';state.settings.orderJsonVariable=$('botOrderJson').value.trim()||'PedidoJSON';write(KEYS.settings,state.settings);renderAdminSection('bots');toast('Gestión de pedidos guardada.','success')};$('testSupport').onclick=()=>openBot('support','Prueba de consulta CRULOX',{Tipo:'Consulta'});$('testOrder').onclick=()=>openBot('order','PRUEBA DE PEDIDO NOVAPRIME GT',{'Pedido ID':'NP-PRUEBA',Nombre:'Cliente de prueba',Productos:'Producto x1',Total:money(1),Tipo:'Pedido'});$('copySupportUrl').onclick=()=>copyText(botDiagnostic('support'));$('copyOrderUrl').onclick=()=>copyText(botDiagnostic('order'))}
function adminBackup(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Respaldos y restauración</h2></div><div class="toolbar"><button class="btn btn-primary" id="exportBackup">Exportar respaldo JSON</button><label class="btn btn-secondary" for="importBackup">Importar respaldo</label><input class="hidden" id="importBackup" type="file" accept="application/json"/><button class="btn btn-secondary" id="exportProducts">Exportar productos CSV</button></div></section><section class="admin-card danger-zone"><div class="admin-card-head"><h2>Zona de restauración</h2></div><p style="color:var(--sub);font-size:.7rem;line-height:1.55">Restaura productos, combos, FAQ y configuración inicial. Los usuarios y pedidos pueden conservarse o eliminarse.</p><div class="form-actions"><button class="btn btn-red" id="resetCatalog">Restaurar catálogo inicial</button><button class="btn btn-red" id="resetEverything">Borrar todos los datos locales</button></div></section>`;$('exportBackup').onclick=exportBackup;$('importBackup').onchange=importBackup;$('exportProducts').onclick=()=>exportCsv('productos',state.products);$('resetCatalog').onclick=async()=>{if(!await npConfirm('¿Restaurar catálogo, combos, FAQ y configuración?'))return;state.products=clone(DEFAULT_PRODUCTS);state.combos=clone(DEFAULT_COMBOS);state.faqs=clone(DEFAULT_FAQS);state.settings=clone(DEFAULT_SETTINGS);persistCore();renderStore();renderAdminSection('dashboard');logActivity('Catálogo restaurado','Valores iniciales')};$('resetEverything').onclick=async()=>{if(!await npConfirm('Esto eliminará cuentas, pedidos, carrito, favoritos y configuración local. ¿Continuar?'))return;Object.values(KEYS).forEach(k=>localStorage.removeItem(k));location.reload()}}
function adminActivity(){$('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Registro de actividad</h2><button class="btn btn-red btn-sm" id="clearActivity">Limpiar</button></div><div class="activity">${state.activity.length?state.activity.map(a=>`<article class="activity-item"><b>${esc(a.action)}</b><span>${esc(a.detail)} · ${new Date(a.at).toLocaleString('es-GT')}</span></article>`).join(''):'<div class="empty">No hay actividad registrada.</div>'}</div></section>`;$('clearActivity').onclick=()=>{state.activity=[];write(KEYS.activity,[]);renderAdminSection('activity')}}
function downloadFile(name,content,type='application/json'){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function exportBackup(){const data={version:5,exportedAt:new Date().toISOString(),products:state.products,combos:state.combos,faqs:state.faqs,settings:state.settings,users:state.users,orders:state.orders,activity:state.activity};downloadFile(`novaprime-backup-${new Date().toISOString().slice(0,10)}.json`,JSON.stringify(data,null,2));logActivity('Respaldo exportado','JSON completo')}
function importBackup(e){const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const d=JSON.parse(reader.result);if(!Array.isArray(d.products)||!Array.isArray(d.faqs))throw new Error('Formato inválido');state.products=d.products;state.combos=Array.isArray(d.combos)?d.combos:[];state.faqs=d.faqs;state.settings={...DEFAULT_SETTINGS,...d.settings};state.users=Array.isArray(d.users)?d.users:state.users;state.orders=Array.isArray(d.orders)?d.orders:state.orders;state.activity=Array.isArray(d.activity)?d.activity:state.activity;persistCore();renderStore();renderAdminSection('dashboard');toast('Respaldo importado.','success')}catch(err){toast('El archivo no es un respaldo válido.','error')}};reader.readAsText(file)}
function exportCsv(name,rows){if(!rows.length)return toast('No hay datos para exportar.','warn');const keys=[...new Set(rows.flatMap(Object.keys))];const quote=v=>`"${String(v??'').replaceAll('"','""')}"`;const csv=[keys.map(quote).join(','),...rows.map(r=>keys.map(k=>quote(typeof r[k]==='object'?JSON.stringify(r[k]):r[k])).join(','))].join('\n');downloadFile(`${name}-${new Date().toISOString().slice(0,10)}.csv`,csv,'text/csv;charset=utf-8')}
const FULL_CATALOG_TEMPLATE_B64='';
function decodeBase64Utf8(value){const bytes=Uint8Array.from(atob(value),c=>c.charCodeAt(0));return new TextDecoder().decode(bytes)}
const FULL_CATALOG_TEMPLATE=decodeBase64Utf8(FULL_CATALOG_TEMPLATE_B64);
function fullCatalogMarkup(){const user=currentUser();const payload={products:state.products,settings:state.settings,user,logo:BRAND_LOGO};const data=JSON.stringify(payload).replace(/</g,'\u003c');return FULL_CATALOG_TEMPLATE.replace('__DATA__',data)}
function openEmbeddedCatalog(markup){const frame=$('fullFrame');$('fullFallback').classList.add('open');document.body.classList.add('lock');frame.removeAttribute('src');frame.srcdoc='';requestAnimationFrame(()=>{try{frame.srcdoc=markup}catch(error){console.warn('srcdoc no disponible; usando document.write.',error);try{const doc=frame.contentWindow.document;doc.open();doc.write(markup);doc.close()}catch(writeError){console.error('No fue posible cargar el catálogo completo.',writeError);$('fullFallback').classList.remove('open');document.body.classList.remove('lock');toast('No fue posible cargar el catálogo completo.','error')}}})}
function openFullCatalog(){openEmbeddedCatalog(fullCatalogMarkup())}
function renderStore(){applySettings();renderHeader();renderCategories();renderProducts();renderCombos();renderFaqs();renderCart();renderFavorites()}
// Global events
$('menuBtn').onclick=()=>openPanel('drawer','drawerOverlay');$('drawerClose').onclick=closeAllPanels;$('drawerOverlay').onclick=closeAllPanels;$('cartBtn').onclick=()=>{renderCart();openPanel('cartPanel','cartOverlay')};$('cartClose').onclick=closeAllPanels;$('cartOverlay').onclick=closeAllPanels;$('favBtn').onclick=()=>{renderFavorites();openPanel('favPanel','favOverlay')};$('favClose').onclick=closeAllPanels;$('favOverlay').onclick=closeAllPanels;$('profileBtn').onclick=()=>{renderAccount();openModal('accountModal')};$('drawerProfile').onclick=()=>{closeAllPanels();renderAccount();openModal('accountModal')};$('drawerFavorites').onclick=()=>{renderFavorites();openPanel('favPanel','favOverlay')};$('drawerCart').onclick=()=>{renderCart();openPanel('cartPanel','cartOverlay')};$('checkoutBtn').onclick=openCheckout;$('checkoutForm').onsubmit=submitOrder;$('heroSupport').onclick=$('footerSupport').onclick=$('floatSupport').onclick=()=>openBot('support','Hola. Necesito ayuda con CRULOX.',{Tipo:'Consulta general'});$('footerProfile').onclick=()=>{renderAccount();openModal('accountModal')};$('searchInput').onfocus=renderSuggestions;let npPublicSearchTimer=0;$('searchInput').oninput=()=>{state.query=$('searchInput').value.trim();$('searchClear').classList.toggle('show',!!state.query);clearTimeout(npPublicSearchTimer);npPublicSearchTimer=setTimeout(()=>{renderProducts();renderSuggestions()},90)};$('searchInput').onkeydown=e=>{const opts=$('suggestions').querySelectorAll('.suggestion');if(e.key==='ArrowDown'){e.preventDefault();if(!$('suggestions').classList.contains('open'))renderSuggestions();activateSuggestion(state.activeSuggestion+1)}else if(e.key==='ArrowUp'){e.preventDefault();activateSuggestion(state.activeSuggestion-1)}else if(e.key==='Enter'&&state.activeSuggestion>=0){e.preventDefault();opts[state.activeSuggestion]?.click()}else if(e.key==='Escape')closeSuggestions()};$('searchClear').onclick=()=>{$('searchInput').value='';state.query='';$('searchClear').classList.remove('show');closeSuggestions();renderProducts()};document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap'))closeSuggestions()});document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>closeModal(b.dataset.close));document.querySelectorAll('.modal-overlay').forEach(m=>m.onclick=e=>{if(e.target===m)closeModal(m.id)});window.addEventListener('scroll',()=>{$('floatTop').classList.toggle('show',scrollY>1450)});$('floatTop').onclick=()=>scrollTo({top:0,behavior:'smooth'});{const adminNavEl=$('adminNav');if(adminNavEl)adminNavEl.onclick=e=>{const b=e.target.closest('[data-admin]');if(b)renderAdminSection(b.dataset.admin)};const adminStoreEl=$('adminStoreBtn');if(adminStoreEl)adminStoreEl.onclick=()=>{$('adminOverlay').classList.remove('open');document.body.classList.remove('lock')};const adminLogoutEl=$('adminLogout');if(adminLogoutEl)adminLogoutEl.onclick=()=>{state.session=null;write(KEYS.session,null);$('adminOverlay').classList.remove('open');document.body.classList.remove('lock');renderHeader();toast('Sesión administrativa cerrada.','success')}};window.addEventListener('message',e=>{if(e.data?.type==='np-close-full'){$('fullFallback').classList.remove('open');$('fullFrame').srcdoc='';document.body.classList.remove('lock')}else if(e.data?.type==='np-request-login'){$('fullFallback').classList.remove('open');renderAccount();openModal('accountModal')}else if(e.data?.type==='np-order'&&e.data.order){registerOrder(e.data.order);toast(`Pedido ${e.data.order.id} registrado desde el catálogo completo.`,'success')}});document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeAllPanels();document.querySelectorAll('.modal-overlay.open').forEach(m=>closeModal(m.id));if($('fullFallback').classList.contains('open')){$('fullFallback').classList.remove('open');$('fullFrame').srcdoc='';document.body.classList.remove('lock')}}});

/* v8.8 store patch: combos independientes + pedidos internos */
const NP_V88_STYLE=`
.combo{padding:0!important;display:grid!important;grid-template-columns:minmax(0,.94fr) minmax(0,1.06fr)!important;gap:0!important;overflow:hidden!important;border-radius:30px!important;background:linear-gradient(160deg,rgba(10,22,38,.98),rgba(8,19,34,.97) 58%,rgba(8,20,36,.99))!important;border:1px solid rgba(78,184,255,.18)!important;box-shadow:0 28px 50px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.03)!important}
.combo-visual.combo-visual-single{position:relative;min-height:350px!important;padding:20px!important;border-radius:30px 0 0 30px!important;background:radial-gradient(circle at 18% 18%,rgba(0,217,255,.18),transparent 30%),radial-gradient(circle at 80% 78%,rgba(58,131,255,.16),transparent 30%),linear-gradient(170deg,#081526,#0c1d33 65%,#091526)!important;display:flex!important;align-items:center!important;justify-content:center!important}
.combo-poster{position:relative;width:100%;height:100%;min-height:310px;border-radius:26px;background:linear-gradient(180deg,rgba(7,18,32,.88),rgba(11,24,42,.96));border:1px solid rgba(75,196,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 20px 36px rgba(0,0,0,.2);overflow:hidden;display:flex;align-items:center;justify-content:center}
.combo-poster::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 18%,rgba(0,217,255,.2),transparent 28%),radial-gradient(circle at 82% 82%,rgba(58,131,255,.18),transparent 28%);pointer-events:none}
.combo-poster img{position:relative;z-index:1;width:100%!important;height:100%!important;object-fit:contain!important;padding:16px!important;filter:drop-shadow(0 18px 34px rgba(0,0,0,.34))}
.combo-copy{padding:24px 24px 22px!important}
.combo .price{font-size:2.12rem!important}
.combo .old{font-size:1rem!important}
.combo-products{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px!important}
.combo-products span{display:inline-flex;align-items:center;gap:7px;padding:8px 11px!important;border-radius:999px;background:rgba(255,255,255,.05)!important;border:1px solid rgba(255,255,255,.06)!important;font-size:.68rem!important;color:#d7e5f7!important}
.combo-actions{display:grid;gap:10px;margin-top:18px!important}.combo-main-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.combo-main-actions .btn,.combo-actions .btn-secondary{width:100%}.combo-actions .btn{min-height:46px!important;font-size:.86rem!important}
.combo-actions .btn-secondary{background:rgba(255,255,255,.05)!important;border:1px solid rgba(170,222,255,.14)!important}
.combo-detail-stage.combo-detail-stage--single{display:flex;align-items:center;justify-content:center;min-height:320px;padding:8px}
.combo-detail-stage.combo-detail-stage--single img{width:100%;height:100%;object-fit:contain;border-radius:22px;background:linear-gradient(180deg,rgba(7,18,32,.88),rgba(11,24,42,.96));border:1px solid rgba(75,196,255,.14);padding:18px;box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 20px 36px rgba(0,0,0,.2)}
.combo-detail-items{display:grid;gap:10px;margin-top:16px}.combo-detail-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)}.combo-detail-item i{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(0,217,255,.12);color:var(--cyan);font-style:normal;font-weight:800}
@media(max-width:760px){.combo{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)!important}.combo-visual.combo-visual-single{min-height:300px!important;padding:14px!important}.combo-poster{min-height:270px}.combo-poster img{padding:12px!important}.combo-copy{padding:16px 14px 16px!important}.combo h3{font-size:1.18rem!important}.combo p{font-size:.78rem!important;line-height:1.58!important}.combo .price{font-size:1.76rem!important}.combo-actions .btn{min-height:42px!important;font-size:.78rem!important}.combo-main-actions{grid-template-columns:1fr!important}}
@media(max-width:420px){.combo{grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr)!important}.combo-visual.combo-visual-single{min-height:280px!important;padding:12px!important}.combo-poster{min-height:246px}.combo h3{font-size:1.06rem!important}.combo p{font-size:.72rem!important}.combo .price{font-size:1.54rem!important}.combo-actions .btn{font-size:.72rem!important;min-height:39px!important}}
`;
if(!document.getElementById('np-v88-style')){const s=document.createElement('style');s.id='np-v88-style';s.textContent=NP_V88_STYLE;document.head.appendChild(s)}

function normalizeComboRecord(combo){
  const linked=Array.isArray(combo?.productIds)?combo.productIds.map(id=>state.products.find(p=>p.id===id)).filter(Boolean):[];
  const includes=Array.isArray(combo?.includes)?combo.includes.filter(Boolean):typeof combo?.includes==='string'?combo.includes.split(',').map(x=>x.trim()).filter(Boolean):linked.map(p=>p.name);
  return {
    id:combo?.id||uid('combo'),
    name:(combo?.name||'Paquete digital').trim(),
    image:(combo?.image||combo?.mainImage||combo?.poster||linked[0]?.image||BRAND_LOGO).trim ? (combo?.image||combo?.mainImage||combo?.poster||linked[0]?.image||BRAND_LOGO).trim() : (combo?.image||combo?.mainImage||combo?.poster||linked[0]?.image||BRAND_LOGO),
    price:Number(combo?.price||0),
    oldPrice:combo?.oldPrice===null||combo?.oldPrice===''||typeof combo?.oldPrice==='undefined'?null:Number(combo.oldPrice),
    description:(combo?.description||combo?.summary||'Combo personalizado disponible en CRULOX.').trim(),
    details:(combo?.details||combo?.longDescription||combo?.description||'').trim(),
    includes:includes.length?includes:['Incluye productos seleccionados'],
    badgeText:(combo?.badgeText||combo?.kicker||'').trim()||null,
    featured:combo?.featured!==false
  };
}
state.combos=(state.combos||[]).map(normalizeComboRecord);
state.cart=(state.cart||[]).map(item=>item&&typeof item==='object'&&('type' in item)?item:{...item,type:'product'});
state.faqs=(state.faqs||[]).map(f=>{
  if(!f||!f.q)return f;
  if(norm(f.q).includes('cuanto tarda el envio'))return {...f,a:'El tiempo de entrega se coordina según tu ubicación y la disponibilidad del producto. Como referencia general, manejamos entregas de 2 a 3 días hábiles.'};
  if(norm(f.q).includes('como confirmo mi pedido'))return {...f,a:'Agrega productos o combos al carrito, inicia sesión, revisa tus datos de entrega y envía el pedido desde la tienda.'};
  if(norm(f.q).includes('como contacto con soporte'))return {...f,a:'Utiliza el botón de WhatsApp para consultas o escribe a . Las compras ya no se envían por WhatsApp.'};
  return f;
});
write(KEYS.combos,state.combos);write(KEYS.cart,state.cart);write(KEYS.faqs,state.faqs);
if($('adminNav')&&!$('adminNav').querySelector('[data-admin="combos"]')){const btn=document.createElement('button');btn.dataset.admin='combos';btn.textContent='🔥 Combos';const ref=$('adminNav').querySelector('[data-admin="categories"]')||null;$('adminNav').insertBefore(btn,ref)}

function cartKey(item){return `${item.type||'product'}::${item.id}`}
function parseCartKey(key){const parts=String(key||'').split('::');return{type:parts[0]==='combo'?'combo':'product',id:parts.slice(1).join('::')}}
function cartEntity(type,id){
  if(type==='combo'){
    const c=state.combos.find(x=>x.id===id);
    return c?{type:'combo',id:c.id,name:c.name,image:c.image,price:Number(c.price||0),description:c.description,stockLabel:'Combo personalizado'}:null;
  }
  const p=state.products.find(x=>x.id===id);
  return p?{...p,type:'product'}:null;
}

function applySettings(){
  document.title=`${state.settings.storeName||'CRULOX'} · Tienda Premium`;
  if($('heroSubtitle'))$('heroSubtitle').textContent=state.settings.subtitle;
  if($('footerSubtitle'))$('footerSubtitle').textContent=state.settings.subtitle;
  if($('footerEmail'))$('footerEmail').textContent=`📧 ${state.settings.email}`;
  if($('footerEmail'))$('footerEmail').href=`mailto:${state.settings.email}`;
  if($('shippingBenefit'))$('shippingBenefit').textContent=state.settings.shippingText||'Entrega digital';
  if($('returnBenefit'))$('returnBenefit').textContent=state.settings.returnText||'Según servicio digital';
  const heroLogo=document.querySelector('.hero-brand-top img');
  if(heroLogo){heroLogo.src=state.settings.heroLogoData||BRAND_LOGO_FULL;heroLogo.alt=state.settings.storeName||'CRULOX'}
  renderSocials();
}

function renderHeader(){
  const user=currentUser();
  $('profileDot').textContent=state.session?.role==='admin'?'A':user?(user.fullName||user.username||'U').charAt(0).toUpperCase():'P';
  $('cartCount').textContent=state.cart.reduce((s,i)=>s+Number(i.qty||0),0);
  $('favCount').textContent=state.favorites.length;
  if($('heroProductCount'))$('heroProductCount').textContent='TOP';
  if($('heroCategoryCount'))$('heroCategoryCount').textContent='MIX';
}

function renderCategories(){
  const cats=categories();
  $('categoryChips').innerHTML=[`<button class="cat ${state.category==='all'?'active':''}" data-cat="all">Todos</button>`,...cats.map(c=>`<button class="cat ${state.category===c?'active':''}" data-cat="${esc(c)}">${esc(c)}</button>`)].join('');
  $('categoryChips').querySelectorAll('[data-cat]').forEach(btn=>btn.onclick=()=>{state.category=btn.dataset.cat;renderCategories();renderProducts()});
}

function comboForm(combo=null){
  const c=combo||{id:'',name:'',price:'',oldPrice:'',image:'',description:'',details:'',includes:['']};
  return `<form id="comboForm"><div class="form-grid"><div class="field full"><label>Nombre del combo</label><input id="cfName" value="${esc(c.name)}" required/></div><div class="field"><label>Precio</label><input id="cfPrice" type="number" step="0.01" min="0" value="${c.price||''}" required/></div><div class="field"><label>Precio anterior</label><input id="cfOldPrice" type="number" step="0.01" min="0" value="${c.oldPrice??''}"/></div><div class="field full"><label>URL o data URI de imagen</label><input id="cfImage" value="${esc(c.image||'')}" required/></div><div class="field full"><label>Cargar imagen local</label><input id="cfFile" type="file" accept="image/*"/></div><div class="field full"><label>Información breve</label><textarea id="cfDescription" required>${esc(c.description||'')}</textarea></div><div class="field full"><label>Detalles ampliados</label><textarea id="cfDetails">${esc(c.details||'')}</textarea></div><div class="field full"><label>Elementos incluidos (separados por coma)</label><input id="cfIncludes" value="${esc((c.includes||[]).join(', '))}" placeholder="Auriculares Nova X1, Altavoz Bluetooth Nova"/></div><div class="field"><label>Etiqueta superior opcional</label><input id="cfBadgeText" value="${esc(c.badgeText||'')}" placeholder="AHORRA 21%"/></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar combo</button><button class="btn btn-secondary" type="button" data-close="crudModal">Cancelar</button></div></form>`;
}

function openComboEditor(id=null){
  const combo=id?state.combos.find(c=>c.id===id):null;
  $('crudTitle').textContent=combo?'Editar combo':'Agregar combo';
  $('crudBody').innerHTML=comboForm(combo);
  openModal('crudModal');
  let fileData='';
  $('cfFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{fileData=await optimizeImageFile(f,{maxWidth:1600,maxHeight:1600,quality:.9});$('cfImage').value=fileData}catch(error){toast('No fue posible procesar la imagen.','error')}};
  $('comboForm').onsubmit=e=>{e.preventDefault();const data=normalizeComboRecord({name:$('cfName').value.trim(),price:Number($('cfPrice').value||0),oldPrice:$('cfOldPrice').value?Number($('cfOldPrice').value):null,image:fileData||$('cfImage').value.trim(),description:$('cfDescription').value.trim(),details:$('cfDetails').value.trim(),includes:$('cfIncludes').value.split(',').map(v=>v.trim()).filter(Boolean),badgeText:$('cfBadgeText').value.trim()||null});if(combo)Object.assign(combo,data);else state.combos.unshift({id:uid('c'),...data});write(KEYS.combos,state.combos);logActivity(combo?'Combo editado':'Combo agregado',data.name);closeModal('crudModal');renderStore();renderAdminSection('combos');toast('Combo guardado.','success')};
}

function adminCombos(){
  $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Gestión de combos</h2><div class="toolbar"><input id="adminComboSearch" placeholder="Buscar combo"/><button class="btn btn-primary btn-sm" id="adminAddCombo">Agregar combo</button></div></div><div class="table-wrap"><table><thead><tr><th>Combo</th><th>Precio</th><th>Incluye</th><th>Etiqueta</th><th>Acciones</th></tr></thead><tbody id="adminComboRows"></tbody></table></div></section>`;
  const renderRows=()=>{const q=norm($('adminComboSearch').value);const list=state.combos.filter(c=>!q||norm(`${c.name} ${c.description} ${(c.includes||[]).join(' ')}`).includes(q));$('adminComboRows').innerHTML=list.map(c=>`<tr><td><div style="display:flex;align-items:center;gap:8px"><img src="${esc(c.image)}" alt=""><b>${esc(c.name)}</b></div></td><td>${money(c.price)}</td><td>${esc((c.includes||[]).join(', ')||'—')}</td><td>${esc(c.badgeText||'—')}</td><td><div class="toolbar"><button class="btn btn-secondary btn-sm" data-edit-combo="${c.id}">Editar</button><button class="btn btn-secondary btn-sm" data-duplicate-combo="${c.id}">Duplicar</button><button class="btn btn-red btn-sm" data-delete-combo="${c.id}">Eliminar</button></div></td></tr>`).join('')||'<tr><td colspan="5">No hay combos en este filtro.</td></tr>';$('adminComboRows').querySelectorAll('[data-edit-combo]').forEach(b=>b.onclick=()=>openComboEditor(b.dataset.editCombo));$('adminComboRows').querySelectorAll('[data-duplicate-combo]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.duplicateCombo);state.combos.unshift({...clone(c),id:uid('c'),name:`${c.name} copia`});write(KEYS.combos,state.combos);renderRows();renderStore();logActivity('Combo duplicado',c.name)});$('adminComboRows').querySelectorAll('[data-delete-combo]').forEach(b=>b.onclick=async()=>{const c=state.combos.find(x=>x.id===b.dataset.deleteCombo);if(!await npConfirm(`Eliminar ${c.name}?`))return;state.combos=state.combos.filter(x=>x.id!==c.id);state.cart=state.cart.filter(x=>!((x.type||'product')==='combo'&&x.id===c.id));persistCore();renderRows();renderStore();logActivity('Combo eliminado',c.name)})};
  renderRows();$('adminComboSearch').oninput=renderRows;$('adminAddCombo').onclick=()=>openComboEditor();
}

function renderAdminSection(section){
  state.adminSection=section;
  renderAdminNav();
  const titles={dashboard:'Resumen',products:'Productos',combos:'Combos',inventory:'Inventario',categories:'Categorías',faqs:'Preguntas frecuentes',users:'Clientes',orders:'Pedidos',settings:'Tienda',bots:'Atención',backup:'Respaldos',activity:'Actividad'};
  $('adminTitle').textContent=titles[section]||'Administración';
  const fn={dashboard:adminDashboard,products:adminProducts,combos:adminCombos,inventory:adminInventory,categories:adminCategories,faqs:adminFaqs,users:adminUsers,orders:adminOrders,settings:adminSettings,bots:adminBots,backup:adminBackup,activity:adminActivity}[section]||adminDashboard;
  fn();
}

function adminDashboard(){
  const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);
  const low=state.products.filter(p=>p.stock>0&&p.stock<=Number(state.settings.lowStock||5)).length;
  const out=state.products.filter(p=>p.stock<=0).length;
  $('adminContent').innerHTML=`<div class="notice"><b>Importante:</b> este panel funciona localmente en el navegador actual. Para producción real se necesita backend, base de datos y autenticación del servidor.</div><div class="admin-grid">${metric('Productos',state.products.length)}${metric('Combos',state.combos.length)}${metric('Categorías',categories().length)}${metric('Clientes',state.users.length)}${metric('Pedidos',state.orders.length)}${metric('Ventas registradas',money(sales))}${metric('Stock bajo',low)}${metric('Agotados',out)}${metric('FAQ',state.faqs.length)}</div><div class="admin-two"><section class="admin-card"><div class="admin-card-head"><h2>Acciones rápidas</h2></div><div class="toolbar"><button class="btn btn-primary btn-sm" id="quickAddProduct">Agregar producto</button><button class="btn btn-secondary btn-sm" id="quickAddCombo">Agregar combo</button><button class="btn btn-secondary btn-sm" id="quickOrders">Revisar pedidos</button><button class="btn btn-secondary btn-sm" id="quickBackup">Crear respaldo</button></div></section><section class="admin-card"><div class="admin-card-head"><h2>Estado técnico</h2></div><div class="admin-list"><article class="admin-list-item"><div><h3>Canal de consultas</h3><p>${esc(state.settings.supportBotUrl)}</p></div><span class="status ${state.settings.supportBotUrl==='#'?'warn':''}">${state.settings.supportBotUrl==='#'?'Pendiente':'Configurado'}</span></article><article class="admin-list-item"><div><h3>Pedidos de tienda</h3><p>Las compras se registran directamente en el panel de administración.</p></div><span class="status">Interno</span></article></div></section></div>`;
  $('quickAddProduct').onclick=()=>openProductEditor();
  $('quickAddCombo').onclick=()=>openComboEditor();
  $('quickOrders').onclick=()=>renderAdminSection('orders');
  $('quickBackup').onclick=exportBackup;
}

function adminSettings(){
  $('adminContent').innerHTML=`<form class="admin-card" style="margin-top:0" id="settingsForm"><div class="admin-card-head"><h2>Identidad y datos de la tienda</h2></div><div class="form-grid"><div class="field"><label>Nombre de tienda</label><input id="setName" value="${esc(state.settings.storeName)}"/></div><div class="field"><label>Correo</label><input id="setEmail" type="email" value="${esc(state.settings.email)}"/></div><div class="field full"><label>Eslogan</label><input id="setSlogan" value="${esc(state.settings.slogan)}"/></div><div class="field full"><label>Descripción</label><textarea id="setSubtitle">${esc(state.settings.subtitle)}</textarea></div><div class="field full"><label>Logo del bloque principal</label><input id="setHeroLogo" value="${esc(state.settings.heroLogoData||BRAND_LOGO)}"/></div><div class="field full"><label>Cargar logo local</label><input id="setHeroLogoFile" type="file" accept="image/*"/></div><div class="field"><label>Moneda</label><input id="setCurrency" value="${esc(state.settings.currency)}"/></div><div class="field"><label>Límite de stock bajo</label><input id="setLowStock" type="number" min="0" value="${state.settings.lowStock}"/></div><div class="field"><label>Facebook</label><input id="setFacebook" value="${esc(state.settings.facebookUrl)}"/></div><div class="field"><label>Instagram</label><input id="setInstagram" value="${esc(state.settings.instagramUrl)}"/></div><div class="field"><label>TikTok</label><input id="setTiktok" value="${esc(state.settings.tiktokUrl)}"/></div><div class="field"><label>Texto de entrega</label><input id="setShipping" value="${esc(state.settings.shippingText)}"/></div><div class="field"><label>Texto de cambios</label><input id="setReturn" value="${esc(state.settings.returnText)}"/></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar configuración</button></div></form>`;
  let heroLogoFile='';
  $('setHeroLogoFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{heroLogoFile=await optimizeImageFile(f,{maxWidth:1000,maxHeight:350,quality:.94});$('setHeroLogo').value=heroLogoFile}catch(error){toast('No fue posible procesar el logo.','error')}};
  $('settingsForm').onsubmit=e=>{e.preventDefault();Object.assign(state.settings,{storeName:$('setName').value.trim(),email:$('setEmail').value.trim(),slogan:$('setSlogan').value.trim(),subtitle:$('setSubtitle').value.trim(),heroLogoData:heroLogoFile||$('setHeroLogo').value.trim()||'',currency:$('setCurrency').value.trim()||'Q',lowStock:Number($('setLowStock').value||5),facebookUrl:$('setFacebook').value.trim()||'#',instagramUrl:$('setInstagram').value.trim()||'#',tiktokUrl:$('setTiktok').value.trim()||'#',shippingText:$('setShipping').value.trim(),returnText:$('setReturn').value.trim()});write(KEYS.settings,state.settings);applySettings();renderStore();logActivity('Configuración de tienda','Actualizada');toast('Configuración guardada.','success')};
}

function adminBots(){
  $('adminContent').innerHTML=`<div class="admin-two"><form class="admin-card" style="margin-top:0" id="supportBotForm"><div class="admin-card-head"><h2>💬 Canal de consultas</h2></div><p style="color:var(--sub);font-size:.68rem;line-height:1.55;margin-bottom:10px">Recibe dudas de productos y soporte general.</p><div class="field"><label>URL pública</label><input id="botSupportUrl" value="${esc(state.settings.supportBotUrl)}"/></div><div class="field" style="margin-top:9px"><label>Nombre exacto de variable</label><input id="botSupportVar" value="${esc(state.settings.supportVariable)}"/></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar</button><button class="btn btn-secondary" type="button" id="testSupport">Probar</button></div></form><section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>📦 Pedidos internos</h2></div><p style="color:var(--sub);font-size:.72rem;line-height:1.65">Las compras ya no se envían por bot ni por WhatsApp. Cada pedido se guarda directamente en la sección <b>Pedidos</b> del panel de administración.</p></section></div>`;
  $('supportBotForm').onsubmit=e=>{e.preventDefault();state.settings.supportBotUrl=$('botSupportUrl').value.trim()||'#';state.settings.supportVariable=$('botSupportVar').value.trim()||'Consulta';write(KEYS.settings,state.settings);renderAdminSection('bots');applySettings();toast('Canal de consultas guardado.','success')};
  $('testSupport').onclick=()=>openBot('support','Prueba de consulta CRULOX',{Tipo:'Consulta'});
}

function addToCart(id,qty=1){
  const p=state.products.find(x=>x.id===id);
  if(!p||Number(p.stock)<=0)return toast('Producto agotado.','warn');
  const item=state.cart.find(x=>(x.type||'product')==='product'&&x.id===id);
  const current=item?item.qty:0;
  const next=Math.min(current+qty,Number(p.stock));
  if(item)item.qty=next; else state.cart.push({type:'product',id:p.id,qty:Math.min(qty,Number(p.stock))});
  write(KEYS.cart,state.cart);renderHeader();renderCart();toast(`${p.name} añadido al carrito.`,'success');
}
function addCombo(combo){
  if(!combo)return;
  const item=state.cart.find(x=>(x.type||'product')==='combo'&&x.id===combo.id);
  if(item)item.qty=Math.min((item.qty||0)+1,99); else state.cart.push({type:'combo',id:combo.id,qty:1});
  write(KEYS.cart,state.cart);renderHeader();renderCart();toast(`${combo.name} añadido al carrito.`,'success');
}
function changeQty(key,delta){
  const {type,id}=parseCartKey(key);const item=state.cart.find(x=>(x.type||'product')===type&&x.id===id);if(!item)return;
  if(type==='combo'){item.qty=Math.max(0,Math.min((item.qty||0)+delta,99));}
  else {const p=state.products.find(x=>x.id===id);if(!p)return;item.qty=Math.max(0,Math.min((item.qty||0)+delta,Number(p.stock)))}
  if(item.qty===0)state.cart=state.cart.filter(x=>!((x.type||'product')===type&&x.id===id));
  write(KEYS.cart,state.cart);renderHeader();renderCart();
}
function removeCart(key){const {type,id}=parseCartKey(key);state.cart=state.cart.filter(x=>!((x.type||'product')===type&&x.id===id));write(KEYS.cart,state.cart);renderHeader();renderCart()}
function cartDetails(){return state.cart.map(i=>{const data=cartEntity((i.type||'product'),i.id);return data?{...data,qty:Number(i.qty||1)}:null}).filter(Boolean)}
function renderCart(){
  const items=cartDetails();
  $('cartItems').innerHTML=items.length?items.map(i=>{const key=cartKey(i);const sub=i.type==='combo'?'Combo personalizado':stockInfo(i)[0];return `<article class="list-card"><img src="${esc(i.image)}" alt="${esc(i.name)}"/><div><h3>${esc(i.name)}</h3><p>${money(i.price)} · ${esc(sub)}</p><div class="list-actions"><div class="qty"><button data-dec="${esc(key)}">−</button><span>${i.qty}</span><button data-inc="${esc(key)}">＋</button></div><button class="btn btn-red btn-sm" data-remove-cart="${esc(key)}">Eliminar</button></div></div><strong>${money(i.price*i.qty)}</strong></article>`}).join(''):'<div class="empty">Tu carrito está vacío.</div>';
  $('cartTotal').textContent=money(items.reduce((s,i)=>s+i.price*i.qty,0));
  $('cartItems').querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>changeQty(b.dataset.inc,1));
  $('cartItems').querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>changeQty(b.dataset.dec,-1));
  $('cartItems').querySelectorAll('[data-remove-cart]').forEach(b=>b.onclick=()=>removeCart(b.dataset.removeCart));
}

function renderCombos(){
  $('combosGrid').innerHTML=state.combos.length?state.combos.map(c=>{const discount=c.oldPrice?Math.round((1-c.price/c.oldPrice)*100):0;const badge=c.badgeText||(discount?`AHORRA ${discount}%`:'COMBO NOVA');return `<article class="combo"><div class="combo-visual combo-visual-single"><div class="combo-poster"><img src="${esc(c.image||BRAND_LOGO)}" alt="${esc(c.name)}" loading="lazy" decoding="async"/></div></div><div class="combo-copy"><span class="section-kicker">${esc(badge)}</span><h3>${esc(c.name)}</h3><p>${esc(c.description)}</p><div class="combo-products">${(c.includes||[]).map((item,index)=>`<span><i>${index===0?'◉':'◎'}</i>${esc(item)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div><button class="btn btn-secondary" data-combo-detail="${c.id}">Ver más detalles</button></div></div></article>`}).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  $('combosGrid').querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  $('combosGrid').querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
  $('combosGrid').querySelectorAll('[data-combo-detail]').forEach(b=>b.onclick=()=>openComboDetail(b.dataset.comboDetail));
}

function openComboDetail(id){
  const c=state.combos.find(x=>x.id===id);if(!c)return;const discount=c.oldPrice?Math.round((1-c.price/c.oldPrice)*100):0;
  $('detailBody').innerHTML=`<div class="combo-detail"><div class="combo-detail-visual"><div class="combo-detail-stage combo-detail-stage--single"><img class="combo-detail-main" src="${esc(c.image||BRAND_LOGO)}" alt="${esc(c.name)}"/></div></div><div><span class="section-kicker">Combo inteligente${discount?` · Ahorra ${discount}%`:''}</span><h2>${esc(c.name)}</h2><div class="price-row" style="margin:12px 0"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><p>${esc(c.details||c.description)}</p><div class="combo-detail-items">${(c.includes||[]).map(item=>`<div class="combo-detail-item"><i>◎</i><div><h4>${esc(item)}</h4><p>Incluido en este combo.</p></div></div>`).join('')}</div><div class="combo-detail-actions"><button class="btn btn-primary" id="detailAddCombo">🛒 Añadir combo</button><button class="btn btn-green" id="detailSupportCombo">WhatsApp</button><button class="btn btn-secondary" id="detailCloseCombo">Seguir viendo combos</button></div></div></div>`;
  openModal('detailModal');
  $('detailAddCombo').onclick=()=>{addCombo(c);closeModal('detailModal')};
  $('detailSupportCombo').onclick=()=>openBot('support',`Hola. Necesito información detallada sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'});
  $('detailCloseCombo').onclick=()=>closeModal('detailModal');
}

function buildOrder(user,items,notes=''){return{id:`NP-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${Math.random().toString(36).slice(2,7).toUpperCase()}`,userId:user.id,customer:{fullName:user.fullName,email:user.email,phone:user.phone,department:user.department,municipality:user.municipality,address:user.address,reference:user.reference},items:items.map(i=>({type:i.type||'product',id:i.id,name:i.name,price:Number(i.price),qty:Number(i.qty)})),total:items.reduce((s,i)=>s+Number(i.price)*Number(i.qty),0),notes,status:'Nuevo',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()}}
function submitOrder(e){e.preventDefault();const user=currentUser();if(!user)return openCheckout();const items=cartDetails();if(!items.length)return toast('Tu carrito está vacío.','warn');const order=buildOrder(user,items,$('coNotes').value.trim());registerOrder(order);state.cart=[];write(KEYS.cart,state.cart);renderHeader();renderCart();closeModal('checkoutModal');$('coNotes').value='';toast(`Pedido ${order.id} enviado correctamente.`,'success')}

function adminOrders(){
  $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Pedidos</h2><div class="toolbar"><input id="orderSearch" placeholder="Buscar pedido o cliente"/><select id="orderStatus"><option value="all">Todos los estados</option>${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" id="exportOrders">Exportar CSV</button></div></div><div class="admin-list" id="orderAdminList"></div></section>`;
  const render=()=>{const q=norm($('orderSearch').value),st=$('orderStatus').value;const list=state.orders.filter(o=>(st==='all'||o.status===st)&&(!q||norm(`${o.id} ${o.customer?.fullName} ${o.customer?.email}`).includes(q)));$('orderAdminList').innerHTML=list.map(o=>`<article class="admin-list-item"><div><h3>${esc(o.id)} · ${esc(o.customer?.fullName||'Cliente')}</h3><p>${new Date(o.createdAt).toLocaleString('es-GT')} · ${o.items.length} artículos · ${money(o.total)}</p><p style="margin-top:6px;color:var(--sub);font-size:.68rem">${esc(o.items.map(i=>`${i.name} x${i.qty}${i.type==='combo'?' · combo':''}`).join(' • '))}</p></div><div class="toolbar"><select data-order-status="${o.id}">${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" data-copy-order="${o.id}">Copiar</button><button class="btn btn-red btn-sm" data-delete-order="${o.id}">Eliminar</button></div></article>`).join('')||'<div class="empty">No hay pedidos en este filtro.</div>';$('orderAdminList').querySelectorAll('[data-order-status]').forEach(s=>s.onchange=()=>{const o=state.orders.find(x=>x.id===s.dataset.orderStatus);o.status=s.value;o.updatedAt=new Date().toISOString();write(KEYS.orders,state.orders);logActivity('Estado de pedido',`${o.id} → ${o.status}`)});$('orderAdminList').querySelectorAll('[data-copy-order]').forEach(b=>b.onclick=()=>{const o=state.orders.find(x=>x.id===b.dataset.copyOrder);copyText(orderMessage(o));toast('Pedido copiado.','success')});$('orderAdminList').querySelectorAll('[data-delete-order]').forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>x.id===b.dataset.deleteOrder);if(!await npConfirm(`Eliminar pedido ${o.id}?`))return;state.orders=state.orders.filter(x=>x.id!==o.id);write(KEYS.orders,state.orders);render();logActivity('Pedido eliminado',o.id)})};
  render();$('orderSearch').oninput=render;$('orderStatus').onchange=render;$('exportOrders').onclick=()=>exportCsv('pedidos.csv',state.orders.map(o=>({id:o.id,cliente:o.customer?.fullName,correo:o.customer?.email,total:o.total,estado:o.status,creado:o.createdAt,items:o.items.map(i=>`${i.name} x${i.qty}`).join(' | ')})));
}


/* v8.9 combos visual patch */
const NP_V89_STYLE=`
.combo{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
  gap:0!important;
  padding:0!important;
  border-radius:32px!important;
  overflow:hidden!important;
  background:linear-gradient(160deg,rgba(9,21,37,.98),rgba(8,20,35,.97) 58%,rgba(8,19,33,.99))!important;
  border:1px solid rgba(84,192,255,.20)!important;
  box-shadow:0 26px 60px rgba(0,0,0,.26), inset 0 1px 0 rgba(255,255,255,.03)!important;
}
.combo-visual{
  position:relative;
  min-height:420px;
  background:radial-gradient(circle at 18% 18%,rgba(0,221,255,.18),transparent 34%),radial-gradient(circle at 78% 82%,rgba(59,129,255,.18),transparent 30%),linear-gradient(165deg,#071322,#09192c 52%,#081526 100%);
  border-right:1px solid rgba(84,192,255,.12);
  overflow:hidden;
}
.combo-visual::before{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(0deg,rgba(0,0,0,.10),rgba(0,0,0,0) 24%),linear-gradient(135deg,rgba(255,255,255,.02),transparent 50%);
  pointer-events:none;
}
.combo-hero-photo,.combo-auto-hero{
  position:absolute;
  inset:0;
  display:flex;
  align-items:stretch;
  justify-content:stretch;
}
.combo-hero-photo img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  display:block;
}
.combo-auto-hero{
  align-items:flex-end;
  justify-content:center;
  padding:22px;
}
.combo-auto-glow{
  position:absolute;
  inset:10% 10% auto 10%;
  height:64%;
  border-radius:34px;
  background:radial-gradient(circle at 50% 20%,rgba(40,231,255,.20),transparent 44%),linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.01));
  border:1px solid rgba(90,202,255,.10);
}
.combo-auto-floor{
  position:absolute;
  left:8%;
  right:8%;
  bottom:28px;
  height:42px;
  border-radius:999px;
  background:radial-gradient(circle at 50% 50%,rgba(26,200,255,.40),rgba(26,200,255,.15) 45%,rgba(26,200,255,0) 70%);
  filter:blur(1px);
}
.combo-product-shot{
  position:absolute;
  display:block;
  object-fit:contain;
  filter:drop-shadow(0 22px 38px rgba(0,0,0,.42));
  z-index:2;
}
.combo-product-shot.primary{left:2%;bottom:18px;width:62%;height:78%;object-position:left bottom;}
.combo-product-shot.secondary{right:1%;bottom:16px;width:44%;height:58%;object-position:right bottom;z-index:3;}
.combo-product-shot.single{left:10%;right:10%;bottom:16px;width:80%;height:76%;object-position:center bottom;}
.combo-copy{
  padding:30px 28px 26px!important;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.combo .section-kicker{display:inline-flex;align-self:flex-start;margin-bottom:14px;padding:10px 18px;border-radius:999px;border:1px solid rgba(81,190,255,.18);background:rgba(8,24,42,.66);font-size:.78rem;letter-spacing:.05em}
.combo h3{font-size:2.05rem!important;line-height:1.05!important;margin:0 0 12px!important}
.combo p{font-size:1rem!important;line-height:1.62!important;margin:0 0 16px!important;color:#d6e4f5!important}
.combo-products{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px!important}
.combo-products span{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:999px;background:rgba(255,255,255,.05)!important;border:1px solid rgba(255,255,255,.07)!important;color:#dce7f8!important;font-size:.84rem!important;line-height:1.2!important}
.combo-products span i{font-style:normal;color:var(--cyan)}
.combo .price-row{display:flex;align-items:flex-end;gap:12px;margin:0 0 20px!important;flex-wrap:wrap}
.combo .price{font-size:3rem!important;line-height:1!important;font-weight:900!important}
.combo .old{font-size:1.25rem!important;opacity:.7!important;text-decoration:line-through!important}
.combo-actions{display:grid;gap:12px;margin-top:4px!important}
.combo-main-actions{display:grid;grid-template-columns:1fr;gap:12px}
.combo-main-actions .btn,.combo-actions .btn-secondary{width:100%;min-height:54px!important;border-radius:18px!important;font-size:1rem!important;font-weight:800!important}
.combo-actions .btn-secondary{background:rgba(255,255,255,.05)!important;border:1px solid rgba(172,223,255,.14)!important}
.combo-detail-stage{position:relative;min-height:380px;background:radial-gradient(circle at 20% 20%,rgba(0,221,255,.16),transparent 34%),radial-gradient(circle at 78% 82%,rgba(59,129,255,.18),transparent 30%),linear-gradient(165deg,#071322,#09192c 52%,#081526 100%);border-radius:30px;overflow:hidden;border:1px solid rgba(84,192,255,.12)}
.combo-detail-stage .combo-hero-photo,.combo-detail-stage .combo-auto-hero{position:absolute;inset:0}
.combo-detail-stage img.combo-detail-main,.combo-detail-stage img.combo-detail-secondary{width:auto;height:auto}
@media(max-width:860px){
  .combo{grid-template-columns:1fr!important}
  .combo-visual{min-height:360px;border-right:0;border-bottom:1px solid rgba(84,192,255,.12)}
  .combo-copy{padding:22px 18px 20px!important}
  .combo h3{font-size:1.7rem!important}
  .combo p{font-size:.92rem!important}
  .combo .price{font-size:2.45rem!important}
  .combo-main-actions{grid-template-columns:1fr!important}
}
@media(max-width:480px){
  .combo-visual{min-height:310px}
  .combo-auto-hero{padding:16px}
  .combo-product-shot.primary{left:1%;width:64%;height:76%}
  .combo-product-shot.secondary{right:0;width:46%;height:56%}
  .combo .section-kicker{font-size:.72rem;padding:8px 14px}
  .combo h3{font-size:1.5rem!important}
  .combo p{font-size:.86rem!important}
  .combo-products span{font-size:.76rem!important;padding:8px 12px}
  .combo .price{font-size:2.15rem!important}
  .combo-main-actions .btn,.combo-actions .btn-secondary{min-height:48px!important;font-size:.92rem!important}
}
`;
if(!document.getElementById('np-v89-style')){const st=document.createElement('style');st.id='np-v89-style';st.textContent=NP_V89_STYLE;document.head.appendChild(st)}

function comboLinkedProducts(combo){
  const ids=Array.isArray(combo?.productIds)?combo.productIds.filter(Boolean):[];
  const byId=ids.map(id=>state.products.find(p=>p.id===id)).filter(Boolean);
  if(byId.length)return byId;
  const includes=Array.isArray(combo?.includes)?combo.includes.filter(Boolean):[];
  const matched=[];
  includes.forEach(name=>{
    const found=state.products.find(p=>norm(p.name)===norm(name)||norm(p.name).includes(norm(name))||norm(name).includes(norm(p.name)));
    if(found && !matched.some(x=>x.id===found.id))matched.push(found);
  });
  return matched;
}
function comboHasCustomHero(combo, linked){
  const img=(combo?.image||'').trim();
  if(!img || img===BRAND_LOGO)return false;
  if(linked.some(p=>p?.image===img))return false;
  return true;
}
function comboBadgeText(combo){
  if(combo?.badgeText)return combo.badgeText;
  const discount=combo?.oldPrice?Math.round((1-combo.price/combo.oldPrice)*100):0;
  return discount?`AHORRA ${discount}%`:'COMBO NOVA';
}
function comboIncludesList(combo, linked){
  const fromCombo=Array.isArray(combo?.includes)?combo.includes.filter(Boolean):[];
  if(fromCombo.length)return fromCombo;
  return linked.map(p=>p.name);
}
function renderComboVisual(combo, linked, detail=false){
  const cls=detail?'combo-detail-stage':'combo-visual';
  if(comboHasCustomHero(combo, linked)){
    return `<div class="${cls}"><div class="combo-hero-photo"><img ${detail?'class="combo-detail-main"':''} src="${esc(combo.image)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/></div></div>`;
  }
  const primary=linked[0]||null;
  const secondary=linked[1]||null;
  return `<div class="${cls}"><div class="combo-auto-hero"><div class="combo-auto-glow"></div><div class="combo-auto-floor"></div>${primary?`<img ${detail?'class="combo-detail-main combo-product-shot primary"':'class="combo-product-shot primary"'} src="${esc(primary.image)}" alt="${esc(primary.name)}" loading="lazy" decoding="async"/>`:''}${secondary?`<img ${detail?'class="combo-detail-secondary combo-product-shot secondary"':'class="combo-product-shot secondary"'} src="${esc(secondary.image)}" alt="${esc(secondary.name)}" loading="lazy" decoding="async"/>`:primary?``:`<img ${detail?'class="combo-detail-main combo-product-shot single"':'class="combo-product-shot single"'} src="${esc(combo.image||BRAND_LOGO)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/>`}</div></div>`;
}

function renderCombos(){
  const grid=$('combosGrid');
  if(!grid)return;
  grid.innerHTML=state.combos.length?state.combos.map(c=>{
    const linked=comboLinkedProducts(c);
    const includes=comboIncludesList(c, linked);
    return `<article class="combo">${renderComboVisual(c, linked, false)}<div class="combo-copy"><span class="section-kicker">${esc(comboBadgeText(c))}</span><h3>${esc(c.name)}</h3><p>${esc(c.description||'Combo personalizado de CRULOX.')}</p><div class="combo-products">${includes.map((name,i)=>`<span><i>${i===0?'◉':'◎'}</i>${esc(name)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div><button class="btn btn-secondary" data-combo-detail="${c.id}">Ver más detalles</button></div></div></article>`;
  }).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  grid.querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  grid.querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
  grid.querySelectorAll('[data-combo-detail]').forEach(b=>b.onclick=()=>openComboDetail(b.dataset.comboDetail));
}

function openComboDetail(id){
  const c=state.combos.find(x=>x.id===id);if(!c)return;
  const linked=comboLinkedProducts(c);
  const includes=comboIncludesList(c, linked);
  const discount=c.oldPrice?Math.round((1-c.price/c.oldPrice)*100):0;
  $('detailBody').innerHTML=`<div class="combo-detail">${renderComboVisual(c, linked, true)}<div><span class="section-kicker">Combo inteligente${discount?` · Ahorra ${discount}%`:''}</span><h2>${esc(c.name)}</h2><div class="price-row" style="margin:12px 0"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><p>${esc(c.details||c.description||'Combo personalizado disponible en CRULOX.')}</p><div class="combo-detail-items">${includes.map(name=>{const p=linked.find(x=>norm(x.name)===norm(name)||norm(x.name).includes(norm(name))||norm(name).includes(norm(x.name)));return `<div class="combo-detail-item">${p?`<img src="${esc(p.image)}" alt="${esc(p.name)}"/>`:`<i>◎</i>`}<div><h4>${esc(name)}</h4><p>${p?`${esc(p.category)} · ${money(p.price)}`:'Incluido en este combo.'}</p></div></div>`}).join('')}</div><div class="combo-detail-actions"><button class="btn btn-primary" id="detailAddCombo">🛒 Añadir combo</button><button class="btn btn-green" id="detailSupportCombo">WhatsApp</button><button class="btn btn-secondary" id="detailCloseCombo">Seguir viendo combos</button></div></div></div>`;
  openModal('detailModal');
  $('detailAddCombo').onclick=()=>{addCombo(c);closeModal('detailModal')};
  $('detailSupportCombo').onclick=()=>openBot('support',`Hola. Necesito información detallada sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'});
  $('detailCloseCombo').onclick=()=>closeModal('detailModal');
}


/* v8.10 combo visual exact patch */
const NP_V810_STYLE=`
#combos .section-head{margin-bottom:16px!important}
#combos .section-title{margin-bottom:0!important}
#combos .grid{display:grid;gap:20px!important}
.combo{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
  gap:0!important;
  padding:0!important;
  border-radius:32px!important;
  overflow:hidden!important;
  background:linear-gradient(90deg,rgba(7,18,31,.985) 0%,rgba(7,18,31,.985) 46%,rgba(10,23,39,.985) 46.1%,rgba(8,21,36,.985) 100%)!important;
  border:1px solid rgba(65,183,255,.26)!important;
  box-shadow:0 22px 50px rgba(0,0,0,.26), inset 0 1px 0 rgba(255,255,255,.04)!important;
  min-height:420px;
}
.combo-photo{
  position:relative;
  min-height:420px;
  background:linear-gradient(180deg,#06111f 0%,#071524 100%);
  overflow:hidden;
  border-right:1px solid rgba(69,186,255,.16);
}
.combo-photo::before{
  content:'';
  position:absolute;
  left:-14%;
  top:26px;
  width:72%;
  height:10px;
  border-radius:999px;
  background:linear-gradient(90deg,rgba(46,175,255,0),rgba(46,175,255,.95),rgba(46,175,255,.08));
  transform:rotate(-37deg);
  box-shadow:0 0 26px rgba(46,175,255,.55);
  opacity:.92;
  z-index:1;
}
.combo-photo::after{
  content:'';
  position:absolute;
  left:9%;
  right:9%;
  bottom:26px;
  height:44px;
  border-radius:999px;
  background:radial-gradient(circle at 50% 50%,rgba(35,203,255,.52),rgba(35,203,255,.18) 44%,rgba(35,203,255,0) 72%);
  z-index:1;
}
.combo-photo img{
  display:block;
  user-select:none;
  -webkit-user-drag:none;
}
.combo-photo-fill{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  z-index:2;
}
.combo-stage{position:absolute;inset:0;z-index:2}
.combo-floor{
  position:absolute;
  left:12%;
  right:12%;
  bottom:44px;
  height:26px;
  border-radius:999px;
  border:2px solid rgba(43,196,255,.86);
  box-shadow:0 0 16px rgba(43,196,255,.30), inset 0 0 12px rgba(43,196,255,.12);
}
.combo-shot{
  position:absolute;
  object-fit:contain;
  filter:drop-shadow(0 24px 36px rgba(0,0,0,.48));
}
.combo-shot.primary{
  left:3%;
  bottom:52px;
  width:70%;
  height:74%;
}
.combo-shot.secondary{
  right:4%;
  bottom:48px;
  width:42%;
  height:48%;
}
.combo-shot.single{
  left:8%;
  right:8%;
  bottom:42px;
  width:84%;
  height:74%;
}
.combo-copy{
  padding:34px 34px 30px!important;
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
}
.combo-copy .section-kicker{
  align-self:flex-start;
  margin:0 0 24px!important;
  padding:12px 20px!important;
  border-radius:999px!important;
  border:1px solid rgba(70,187,255,.20)!important;
  background:rgba(11,23,39,.62)!important;
  color:var(--cyan)!important;
  font-size:clamp(.84rem,1.8vw,.98rem)!important;
  letter-spacing:.06em!important;
  font-weight:800!important;
}
.combo h3{
  font-size:clamp(2.05rem,4vw,2.9rem)!important;
  line-height:1.04!important;
  margin:0 0 18px!important;
  font-weight:900!important;
}
.combo p{
  font-size:clamp(1.02rem,2.1vw,1.28rem)!important;
  line-height:1.55!important;
