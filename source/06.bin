state.faqs=(state.faqs||[]).map(f=>{
  if(!f||!f.q)return f;
  if(norm(f.q).includes('cuanto tarda el envio'))return {...f,a:'El tiempo de entrega se coordina según tu ubicación y la disponibilidad del producto. Como referencia general, manejamos entregas de 2 a 3 días hábiles.'};
  if(norm(f.q).includes('como confirmo mi pedido'))return {...f,a:'Agrega productos o combos al carrito, inicia sesión, revisa tus datos de entrega y envía el pedido desde la tienda.'};
  return f;
});
write(KEYS.faqs,state.faqs);

