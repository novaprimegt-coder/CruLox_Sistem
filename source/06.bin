const CRUZCLICK_BRAND_MIGRATION='cruzclick_brand_v370';
(function migrateCruzClickBrand(){
  try{if(localStorage.getItem(CRUZCLICK_BRAND_MIGRATION)==='1')return}catch(e){}
  const oldName=['JM',' Cruz',' L.',' Digital'].join('');
  const oldHandle=['jm','cruzl','digital'].join('');
  const oldSocial=new Set([
    'https://facebook.com/'+oldHandle,
    'https://instagram.com/'+oldHandle,
    'https://www.tiktok.com/@'+oldHandle
  ]);
  const migrate=value=>{
    if(typeof value==='string'){
      if(oldSocial.has(value))return '';
      return value.split(oldName).join('CRULOX').split(oldHandle).join('cruzclick');
    }
    if(Array.isArray(value))return value.map(migrate);
    if(value&&typeof value==='object'){
      Object.keys(value).forEach(k=>{value[k]=migrate(value[k])});
      return value;
    }
    return value;
  };
  try{
    for(let i=0;i<localStorage.length;i++){
      const key=localStorage.key(i);if(!key)continue;
      const raw=localStorage.getItem(key);if(!raw||(!raw.includes(oldName)&&!raw.includes(oldHandle)))continue;
      try{localStorage.setItem(key,JSON.stringify(migrate(JSON.parse(raw))))}
      catch(e){localStorage.setItem(key,migrate(raw))}
    }
    localStorage.setItem(CRUZCLICK_BRAND_MIGRATION,'1');
  }catch(e){console.warn('CRULOX brand migration',e)}
})();
const $=id=>document.getElementById(id);
const LOGO_PLACEHOLDER='data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';document.querySelectorAll(`img[src="${LOGO_PLACEHOLDER}"]`).forEach(img=>{img.src=BRAND_LOGO});const favicon=document.querySelector('link[rel="icon"]');if(favicon)favicon.href=BRAND_LOGO;
const clone=v=>JSON.parse(JSON.stringify(v));
function read(key,fallback){try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):clone(fallback)}catch(e){console.warn('Storage read',key,e);return clone(fallback)}}
function readArray(key,fallback=[]){const value=read(key,fallback);return Array.isArray(value)?value:clone(fallback)}
function readObject(key,fallback={}){const value=read(key,fallback);return value&&typeof value==='object'&&!Array.isArray(value)?value:clone(fallback)}
function readSession(key){const value=read(key,null);return value===null||(value&&typeof value==='object'&&!Array.isArray(value))?value:null}
function write(key,value){try{localStorage.setItem(key,JSON.stringify(value));try{window.CruzClickFirebase?.queueLocalWrite?.(key,value)}catch(_fb){}return true}catch(e){console.warn('Storage write',key,e);toast('No fue posible guardar los cambios.','error');return false}}
let state={products:readArray(KEYS.products,DEFAULT_PRODUCTS),combos:readArray(KEYS.combos,DEFAULT_COMBOS),faqs:readArray(KEYS.faqs,DEFAULT_FAQS),settings:{...DEFAULT_SETTINGS,...readObject(KEYS.settings,{})},users:readArray(KEYS.users,[]),orders:readArray(KEYS.orders,[]),session:readSession(KEYS.session),cart:readArray(KEYS.cart,[]),favorites:readArray(KEYS.favorites,[]),activity:readArray(KEYS.activity,[]),category:'all',query:'',activeSuggestion:-1,adminSection:'dashboard'};
const CRULOX_BRAND_MIGRATION_KEY='crulox-brand-v1';
(function enforceCruloxBrand(){
  const replaceBrand=value=>{
    if(typeof value==='string'){
      return value
        .replace(/Cruz\s*Click/gi,'CRULOX')
        .replace(/CRULOX/gi,'CRULOX')
        .replace(/CRULOX/gi,'CRULOX')
        .replace(/@crulox/gi,'@crulox')
        .replace(/cruzclick/gi,'crulox');
    }
    if(Array.isArray(value))return value.map(replaceBrand);
    if(value&&typeof value==='object'){Object.keys(value).forEach(k=>{value[k]=replaceBrand(value[k])});return value}
    return value;
  };
  try{
    for(let i=0;i<localStorage.length;i++){
      const key=localStorage.key(i);if(!key)continue;
      const raw=localStorage.getItem(key);
      if(!raw||(!/Cruz\s*Click|CRULOX|CRULOX|cruzclick/i.test(raw)))continue;
      try{localStorage.setItem(key,JSON.stringify(replaceBrand(JSON.parse(raw))))}catch(e){localStorage.setItem(key,replaceBrand(raw))}
    }
  }catch(e){}
  state.settings=replaceBrand(state.settings||{});
  state.settings.storeName='CRULOX';
  state.settings.slogan='Plataformas Digitales';
  state.settings.socialHandle='crulox';
  state.settings.subtitle='Compra digital simple, segura y transparente.\nDe Guatemala al mundo: un marketplace confiable.';
  if(!state.settings.heroLogoData || /Cruz\s*Click|CRULOX|CRULOX|cruzclick/i.test(String(state.settings.heroLogoData||'')) || String(state.settings.heroLogoData||'').startsWith('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAA+gAAAD5')){
    state.settings.heroLogoData=BRAND_LOGO_FULL;
  }
  try{localStorage.setItem(KEYS.settings,JSON.stringify(state.settings));localStorage.setItem(CRULOX_BRAND_MIGRATION_KEY,'1')}catch(e){}
})();
const NP_MEDIA_MIGRATION_KEY='jm_digital_v1_media_optimized';
const LEGACY_BRAND_PREFIX='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAA+gAAAD5';
function isRasterDataUrl(value){return typeof value==='string'&&/^data:image\/(?:png|jpe?g|webp);base64,/i.test(value)}
function readFileAsDataUrl(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||''));reader.onerror=()=>reject(reader.error||new Error('No se pudo leer la imagen'));reader.readAsDataURL(file)})}
function optimizeImageDataUrl(dataUrl,{maxWidth=1400,maxHeight=1400,quality=.9}={}){
  return new Promise(resolve=>{
    if(!isRasterDataUrl(dataUrl)||dataUrl.length<120000){resolve(dataUrl);return}
    const image=new Image();
    image.onload=()=>{
      try{
        const scale=Math.min(1,maxWidth/image.naturalWidth,maxHeight/image.naturalHeight);
        const width=Math.max(1,Math.round(image.naturalWidth*scale));
        const height=Math.max(1,Math.round(image.naturalHeight*scale));
        const canvas=document.createElement('canvas');canvas.width=width;canvas.height=height;
        const ctx=canvas.getContext('2d',{alpha:true});
        if(!ctx){resolve(dataUrl);return}
        ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(image,0,0,width,height);
        let optimized='';
        try{optimized=canvas.toDataURL('image/webp',quality)}catch(error){}
        if(!optimized||optimized==='data:,'){
          try{optimized=canvas.toDataURL('image/jpeg',quality)}catch(error){}
        }
        resolve(optimized&&optimized.length<dataUrl.length?optimized:dataUrl);
        canvas.width=1;canvas.height=1;
      }catch(error){resolve(dataUrl)}
    };
    image.onerror=()=>resolve(dataUrl);
    image.src=dataUrl;
  })
}
async function optimizeImageFile(file,options){const dataUrl=await readFileAsDataUrl(file);return optimizeImageDataUrl(dataUrl,options)}
function migrateLegacyBuiltInLogo(){
  const value=state.settings&&state.settings.heroLogoData;
  if(typeof value==='string'&&value.startsWith(LEGACY_BRAND_PREFIX)){
    state.settings.heroLogoData='';
    try{localStorage.setItem(KEYS.settings,JSON.stringify(state.settings))}catch(error){}
  }
  state.combos=(state.combos||[]).map(combo=>typeof combo.image==='string'&&combo.image.startsWith(LEGACY_BRAND_PREFIX)?{...combo,image:''}:combo);
}
async function migrateHeavyStoredMedia(){
  if(localStorage.getItem(NP_MEDIA_MIGRATION_KEY)==='1')return false;
  let changed=false;
  for(const product of state.products||[]){
    if(isRasterDataUrl(product.image)&&product.image.length>180000){const next=await optimizeImageDataUrl(product.image,{maxWidth:1400,maxHeight:1400,quality:.9});if(next!==product.image){product.image=next;changed=true}}
  }
  for(const combo of state.combos||[]){
    if(isRasterDataUrl(combo.image)&&combo.image.length>180000){const next=await optimizeImageDataUrl(combo.image,{maxWidth:1600,maxHeight:1600,quality:.9});if(next!==combo.image){combo.image=next;changed=true}}
  }
  if(isRasterDataUrl(state.settings.heroLogoData)&&state.settings.heroLogoData.length>120000){const next=await optimizeImageDataUrl(state.settings.heroLogoData,{maxWidth:1000,maxHeight:350,quality:.94});if(next!==state.settings.heroLogoData){state.settings.heroLogoData=next;changed=true}}
  if(changed){write(KEYS.products,state.products);write(KEYS.combos,state.combos);write(KEYS.settings,state.settings)}
  try{localStorage.setItem(NP_MEDIA_MIGRATION_KEY,'1')}catch(error){}
  return changed;
}
