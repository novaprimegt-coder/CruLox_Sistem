function openDetail(id){
  const p=state.products.find(x=>x.id===id);
  if(!p)return;
  const [stock,stockClass]=stockInfo(p);
  $('detailBody').innerHTML=`<div class="product-detail"><img src="${esc(p.image)}" alt="${esc(p.name)}"/><div><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock stock-detail ${stockClass}">${stock}</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>Añadir al carrito</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;
  openModal('detailModal');
  $('detailAdd').onclick=()=>{addToCart(p.id);closeModal('detailModal')};
  $('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});
  $('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)};
}


