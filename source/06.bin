function cleanBuiltInProductImage(src){
  if(typeof src!=='string'||!src.startsWith('data:image/svg+xml')||!/%3Ctext/i.test(src))return src;
  try{
    const comma=src.indexOf(',');
    if(comma<0)return src;
    const prefix=src.slice(0,comma+1);
    let svg=decodeURIComponent(src.slice(comma+1));
    svg=svg.replace(/<text\b[^>]*>[\s\S]*?<\/text>/gi,'');
    return prefix+encodeURIComponent(svg);
  }catch(error){return src}
}
{
  let cleaned=false;
  state.products=state.products.map(product=>{
    const image=cleanBuiltInProductImage(product.image);
    if(image!==product.image)cleaned=true;
    return image===product.image?product:{...product,image};
  });
  /* Limpieza visual en memoria; no fuerza una escritura al abrir la tienda. */
}
