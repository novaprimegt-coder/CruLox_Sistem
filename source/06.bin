function openDetail(id){
  const p=state.products.find(x=>x.id===id);
  if(!p)return;
  const [stock,stockClass]=stockInfo(p);
  $('detailBody').innerHTML=`<div class="product-detail"><div class="product-detail-media"><img src="${esc(p.image)}" alt="${esc(p.name)}" loading="eager" decoding="async"/></div><div class="product-detail-info"><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock stock-detail ${stockClass}">${stock}</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>Añadir al carrito</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;
  openModal('detailModal');
  $('detailAdd').onclick=()=>{addToCart(p.id);closeModal('detailModal')};
  $('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});
  $('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)};
}

function renderCombos(){
  const grid=$('combosGrid');
  if(!grid)return;
  grid.innerHTML=state.combos.length?state.combos.map(c=>{
    const items=(Array.isArray(c.includes)?c.includes:[]).filter(Boolean);
    return `<article class="combo">${comboHeroExact(c)}<div class="combo-copy"><span class="section-kicker">${esc(comboBadgeResolved(c))}</span><h3>${esc(c.name)}</h3><p>${esc(c.description||'Combo especial disponible en CRULOX.')}</p><div class="combo-products">${items.map((name,i)=>`<span><i>${comboItemIcon(name,i)}</i>${esc(name)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div></div></div></article>`;
  }).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  grid.querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  grid.querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
}


