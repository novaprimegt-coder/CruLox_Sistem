.combo .price{font-size:clamp(3.05rem,4.8vw,4rem)!important;line-height:1!important;font-weight:900!important;color:var(--cyan)!important}
.combo .old{font-size:clamp(1.22rem,2vw,1.5rem)!important;line-height:1.1!important;color:rgba(233,242,252,.55)!important;text-decoration:line-through!important}
