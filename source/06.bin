.hero-brand-name{display:block;color:#fff;font-size:clamp(.82rem,2.2vw,1.04rem);font-weight:900;letter-spacing:.03em;line-height:1;text-transform:uppercase}
.hero-tag{margin-bottom:8px}
.hero-art{display:flex;align-items:flex-end;justify-content:center;padding:28px 32px 34px}
.hero-mini{width:100%;max-width:430px;margin-top:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.hero-mini div{padding:16px 10px;border-radius:18px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);text-align:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.03)}
.hero-mini b{font-size:1.05rem;letter-spacing:.02em}
.hero-mini span{font-size:.68rem;line-height:1.35}
.combo-actions{display:grid!important;gap:12px!important}
.combo-main-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:12px!important}
.combo-main-actions .btn,.combo-actions .btn-secondary{width:100%!important}
.combo-actions .btn-secondary{display:block!important;min-height:58px!important;border-radius:999px!important;background:rgba(255,255,255,.05)!important;border:1px solid rgba(170,222,255,.14)!important;color:#eef6ff!important;font-weight:900!important;font-size:clamp(.92rem,2vw,1.05rem)!important}
.combo-actions .btn-secondary:hover{border-color:rgba(82,198,255,.28)!important;background:rgba(255,255,255,.07)!important}
@media(max-width:860px){.hero-art{padding:8px 18px 24px}.hero-brand-top{justify-content:center;margin-bottom:12px}.hero-brand-top img{height:82px}.hero-mini{max-width:none;gap:10px}.hero-mini div{padding:14px 8px}.hero-mini b{font-size:.98rem}.hero-mini span{font-size:.66rem}}
@media(max-width:520px){.hero-brand-top img{height:70px}.hero-copy{padding:20px 16px 8px}.hero-mini{gap:8px}.hero-mini div{padding:12px 8px;border-radius:16px}.hero-mini b{font-size:.92rem}.hero-mini span{font-size:.62rem}.combo-main-actions{grid-template-columns:1fr!important}.combo-actions .btn-secondary,.combo-main-actions .btn{min-height:50px!important;font-size:.9rem!important}}
`;
if(!document.getElementById('np-v811-style')){const st=document.createElement('style');st.id='np-v811-style';st.textContent=NP_V811_STYLE;document.head.appendChild(st)}
function comboProductsResolved(combo){
  const ids=Array.isArray(combo?.productIds)?combo.productIds.filter(Boolean):[];
  return ids.map(id=>state.products.find(p=>p.id===id)).filter(Boolean);
}
function comboItemsResolved(combo, products){
  const arr=(Array.isArray(combo?.includes)&&combo.includes.length)?combo.includes:products.map(p=>p.name);
  return arr.filter(Boolean);
}
function comboBadgeResolved(combo){
  if(combo?.badgeText)return combo.badgeText;
  const discount=combo?.oldPrice?Math.round((1-Number(combo.price||0)/Number(combo.oldPrice||1))*100):0;
  return discount?`AHORRA ${discount}%`:'COMBO NOVA';
}
function comboItemIcon(name,index){
  const n=(name||'').toLowerCase();
  if(n.includes('auricular')||n.includes('buds')||n.includes('head')) return '🎧';
  if(n.includes('altavoz')||n.includes('parlante')||n.includes('speaker')) return '🔊';
  if(n.includes('smartwatch')||n.includes('watch')) return '⌚';
  if(n.includes('cargador')) return '⚡';
  if(n.includes('funda')) return '🛡️';
  return index===0?'◉':'◎';
}
function comboHeroExact(combo, products){
  const a=products[0]||null;
  const b=products[1]||null;
  return `<div class="combo-photo"><div class="combo-stage"><div class="combo-floor"></div>${a&&b?`<img class="combo-shot primary" src="${esc(a.image)}" alt="${esc(a.name)}" loading="lazy" decoding="async"/><img class="combo-shot secondary" src="${esc(b.image)}" alt="${esc(b.name)}" loading="lazy" decoding="async"/>`:a?`<img class="combo-shot single" src="${esc(a.image)}" alt="${esc(a.name)}" loading="lazy" decoding="async"/>`:`<img class="combo-shot single" src="${esc(BRAND_LOGO)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/>`}</div></div>`;
}
function renderCombos(){
  const grid=$('combosGrid');
  if(!grid)return;
  grid.innerHTML=state.combos.length?state.combos.map(c=>{
    const products=comboProductsResolved(c);
    const items=comboItemsResolved(c,products);
    return `<article class="combo">${comboHeroExact(c,products)}<div class="combo-copy"><span class="section-kicker">${esc(comboBadgeResolved(c))}</span><h3>${esc(c.name)}</h3><p>${esc(c.description||'Combo especial disponible en CRULOX.')}</p><div class="combo-products">${items.map((name,i)=>`<span><i>${comboItemIcon(name,i)}</i>${esc(name)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div><button class="btn btn-secondary" data-combo-detail="${c.id}">Detalles</button></div></div></article>`;
  }).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  grid.querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  grid.querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
  grid.querySelectorAll('[data-combo-detail]').forEach(b=>b.onclick=()=>openComboDetail(b.dataset.comboDetail));
}
if(!document.getElementById('np-v811-script')){const s=document.createElement('script');s.id='np-v811-script';s.type='application/json';s.textContent='ok';document.body.appendChild(s)}


/* v8.12: imágenes propias de combos y promociones */
const NP_PROMOS_KEY='jm_digital_v1_promotions';
const NP_APPLIED_PROMO_KEY='jm_digital_v1_applied_promotion';
state.promos=read(NP_PROMOS_KEY,[]);
state.appliedPromoCode=read(NP_APPLIED_PROMO_KEY,'');

const NP_V812_STYLE=`
.combo-photo.combo-photo-custom::before,.combo-photo.combo-photo-custom::after{display:none!important}
.combo-photo.combo-photo-custom{background:#06111f!important}
.combo-photo-custom .combo-photo-fill{inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;padding:0!important;filter:none!important}
.combo-detail-stage.combo-detail-uploaded{display:flex!important;align-items:center!important;justify-content:center!important;min-height:390px!important;padding:0!important;background:#071321!important;overflow:hidden!important}
.combo-detail-uploaded img{width:100%!important;height:100%!important;min-height:390px!important;object-fit:contain!important;object-position:center!important;padding:0!important;background:#071321!important;border:0!important;border-radius:0!important;filter:none!important;box-shadow:none!important}
.promo-box{margin-bottom:14px;padding:13px;border-radius:17px;background:linear-gradient(145deg,rgba(10,32,52,.96),rgba(8,22,39,.96));border:1px solid rgba(0,217,255,.13);box-shadow:inset 0 1px 0 rgba(255,255,255,.03)}
.promo-box label{display:block;margin-bottom:8px;color:#eaf5ff;font-size:.75rem;font-weight:900}
.promo-entry{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
.promo-entry input{width:100%;min-width:0;height:42px;padding:0 12px;border-radius:12px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.045);color:var(--text);outline:0;text-transform:uppercase;font-weight:800;letter-spacing:.04em}
.promo-entry input:focus{border-color:rgba(0,217,255,.38);box-shadow:0 0 0 3px rgba(0,217,255,.08)}
.promo-entry button{height:42px;padding:0 15px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--cyan),#1687ff);color:#031019;font-size:.72rem;font-weight:900}
.promo-feedback{min-height:17px;margin-top:7px;color:var(--muted);font-size:.61rem;line-height:1.45}
.promo-feedback.success{color:var(--green)}
.promo-feedback.error{color:var(--red)}
.subtotal-row{margin-bottom:7px;color:var(--sub);font-size:.75rem}
.discount-row{margin-bottom:8px;color:var(--green);font-size:.78rem}
.discount-row span:last-child{color:var(--green)!important}
.cart-grand-total{padding-top:10px;border-top:1px solid var(--line)}
.promo-admin-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:18px}
.promo-admin-form .full{grid-column:1/-1}
.promo-admin-list{display:grid;gap:10px}
.promo-admin-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:13px;border-radius:16px;background:rgba(255,255,255,.035);border:1px solid var(--line)}
.promo-admin-item h3{font-size:.82rem}.promo-admin-item p{margin-top:4px;color:var(--muted);font-size:.65rem;line-height:1.5}
@media(max-width:520px){.promo-admin-form{grid-template-columns:1fr}.promo-admin-form .full{grid-column:auto}.promo-admin-item{grid-template-columns:1fr}.combo-detail-uploaded img{min-height:280px}.combo-detail-stage.combo-detail-uploaded{min-height:280px}}
`;
if(!document.getElementById('np-v812-style')){const st=document.createElement('style');st.id='np-v812-style';st.textContent=NP_V812_STYLE;document.head.appendChild(st)}

function normalizePromo(promo){
  return {
    id:promo?.id||uid('promo'),
    code:String(promo?.code||'').trim().toUpperCase(),
    description:String(promo?.description||'').trim(),
    type:promo?.type==='fixed'?'fixed':'percent',
    value:Math.max(0,Number(promo?.value||0)),
    minPurchase:Math.max(0,Number(promo?.minPurchase||0)),
    active:promo?.active!==false,
    expiresAt:String(promo?.expiresAt||'').trim(),
    uses:Math.max(0,Number(promo?.uses||0))
  };
}
state.promos=(state.promos||[]).map(normalizePromo).filter(p=>p.code);
write(NP_PROMOS_KEY,state.promos);

function cartSubtotalValue(){return cartDetails().reduce((sum,item)=>sum+Number(item.price||0)*Number(item.qty||0),0)}
function findPromo(code){const normalized=String(code||'').trim().toUpperCase();return state.promos.find(p=>p.code===normalized)||null}
function promoValidation(code,subtotal=cartSubtotalValue()){
  const promo=findPromo(code);
  if(!promo)return{valid:false,message:'El código no existe.'};
  if(!promo.active)return{valid:false,message:'Este código no está activo.'};
  if(promo.expiresAt){const end=new Date(`${promo.expiresAt}T23:59:59`);if(!Number.isNaN(end.getTime())&&Date.now()>end.getTime())return{valid:false,message:'Este código ya venció.'}}
  if(subtotal<Number(promo.minPurchase||0))return{valid:false,message:`Compra mínima requerida: ${money(promo.minPurchase)}.`};
  const raw=promo.type==='fixed'?Number(promo.value):subtotal*(Number(promo.value)/100);
  const discount=Math.max(0,Math.min(subtotal,raw));
  if(discount<=0)return{valid:false,message:'Este código no genera descuento.'};
  return{valid:true,promo,discount,message:`Código ${promo.code} aplicado: ahorras ${money(discount)}.`};
}
function currentPromoResult(subtotal=cartSubtotalValue()){
  if(!state.appliedPromoCode)return null;
  const result=promoValidation(state.appliedPromoCode,subtotal);
  if(!result.valid){state.appliedPromoCode='';write(NP_APPLIED_PROMO_KEY,'');return null}
  return result;
}
function applyPromoFromCart(){
  const input=$('promoCodeInput');if(!input)return;
  const result=promoValidation(input.value,cartSubtotalValue());
  const message=$('promoMessage');
  if(!result.valid){state.appliedPromoCode='';write(NP_APPLIED_PROMO_KEY,'');message.textContent=result.message;message.className='promo-feedback error';renderCart();return}
  state.appliedPromoCode=result.promo.code;write(NP_APPLIED_PROMO_KEY,state.appliedPromoCode);renderCart();toast(result.message,'success');
}

function renderCart(){
  const items=cartDetails();
  $('cartItems').innerHTML=items.length?items.map(i=>{const key=cartKey(i);const sub=i.type==='combo'?'Combo personalizado':stockInfo(i)[0];return `<article class="list-card"><img src="${esc(i.image)}" alt="${esc(i.name)}"/><div><h3>${esc(i.name)}</h3><p>${money(i.price)} · ${esc(sub)}</p><div class="list-actions"><div class="qty"><button data-dec="${esc(key)}">−</button><span>${i.qty}</span><button data-inc="${esc(key)}">＋</button></div><button class="btn btn-red btn-sm" data-remove-cart="${esc(key)}">Eliminar</button></div></div><strong>${money(i.price*i.qty)}</strong></article>`}).join(''):'<div class="empty">Tu carrito está vacío.</div>';
  const subtotal=items.reduce((s,i)=>s+Number(i.price||0)*Number(i.qty||0),0);
  const promoResult=currentPromoResult(subtotal);
  const discount=promoResult?.discount||0;
  const total=Math.max(0,subtotal-discount);
  if($('cartSubtotal'))$('cartSubtotal').textContent=money(subtotal);
  if($('cartDiscount'))$('cartDiscount').textContent=`-${money(discount)}`;
  if($('cartDiscountRow'))$('cartDiscountRow').hidden=!promoResult;
  $('cartTotal').textContent=money(total);
  const input=$('promoCodeInput');if(input)input.value=state.appliedPromoCode||'';
  const message=$('promoMessage');if(message){if(promoResult){message.textContent=promoResult.message;message.className='promo-feedback success'}else{message.textContent='Los códigos activos se aplican antes de enviar el pedido.';message.className='promo-feedback'}}
  const applyBtn=$('promoApplyBtn');if(applyBtn)applyBtn.onclick=applyPromoFromCart;
  if(input)input.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();applyPromoFromCart()}};
  $('cartItems').querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>changeQty(b.dataset.inc,1));
  $('cartItems').querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>changeQty(b.dataset.dec,-1));
  $('cartItems').querySelectorAll('[data-remove-cart]').forEach(b=>b.onclick=()=>removeCart(b.dataset.removeCart));
}

function comboHeroExact(combo){
  const image=String(combo?.image||'').trim()||BRAND_LOGO;
  return `<div class="combo-photo combo-photo-custom"><img class="combo-photo-fill" src="${esc(image)}" alt="${esc(combo.name)}" loading="lazy" decoding="async"/></div>`;
}
function renderCombos(){
  const grid=$('combosGrid');if(!grid)return;
  grid.innerHTML=state.combos.length?state.combos.map(c=>{
    const items=(Array.isArray(c.includes)?c.includes:[]).filter(Boolean);
    return `<article class="combo">${comboHeroExact(c)}<div class="combo-copy"><span class="section-kicker">${esc(comboBadgeResolved(c))}</span><h3>${esc(c.name)}</h3><p>${esc(c.description||'Combo especial disponible en CRULOX.')}</p><div class="combo-products">${items.map((name,i)=>`<span><i>${comboItemIcon(name,i)}</i>${esc(name)}</span>`).join('')}</div><div class="price-row"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><div class="combo-actions"><div class="combo-main-actions"><button class="btn btn-primary" data-combo="${c.id}">🛒 Añadir combo</button><button class="btn btn-green" data-combo-support="${c.id}">WhatsApp</button></div><button class="btn btn-secondary" data-combo-detail="${c.id}">Detalles</button></div></div></article>`;
  }).join(''):'<div class="empty">Aún no hay combos publicados.</div>';
  grid.querySelectorAll('[data-combo]').forEach(b=>b.onclick=()=>addCombo(state.combos.find(c=>c.id===b.dataset.combo)));
  grid.querySelectorAll('[data-combo-support]').forEach(b=>b.onclick=()=>{const c=state.combos.find(x=>x.id===b.dataset.comboSupport);openBot('support',`Hola. Necesito información sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'})});
  grid.querySelectorAll('[data-combo-detail]').forEach(b=>b.onclick=()=>openComboDetail(b.dataset.comboDetail));
}
function openComboDetail(id){
  const c=state.combos.find(x=>x.id===id);if(!c)return;
  const discount=c.oldPrice?Math.round((1-Number(c.price||0)/Number(c.oldPrice||1))*100):0;
  const image=String(c.image||'').trim()||BRAND_LOGO;
  const items=(Array.isArray(c.includes)?c.includes:[]).filter(Boolean);
  $('detailBody').innerHTML=`<div class="combo-detail"><div class="combo-detail-visual"><div class="combo-detail-stage combo-detail-uploaded"><img src="${esc(image)}" alt="${esc(c.name)}"/></div></div><div><span class="section-kicker">Combo${discount?` · Ahorra ${discount}%`:''}</span><h2>${esc(c.name)}</h2><div class="price-row" style="margin:12px 0"><strong class="price">${money(c.price)}</strong>${c.oldPrice?`<span class="old">${money(c.oldPrice)}</span>`:''}</div><p>${esc(c.details||c.description||'Combo disponible en CRULOX.')}</p><div class="combo-detail-items">${items.map((name,i)=>`<div class="combo-detail-item"><i>${comboItemIcon(name,i)}</i><div><h4>${esc(name)}</h4><p>Incluido en este combo.</p></div></div>`).join('')}</div><div class="combo-detail-actions"><button class="btn btn-primary" id="detailAddCombo">🛒 Añadir combo</button><button class="btn btn-green" id="detailSupportCombo">WhatsApp</button><button class="btn btn-secondary" id="detailCloseCombo">Seguir viendo combos</button></div></div></div>`;
  openModal('detailModal');
  $('detailAddCombo').onclick=()=>{addCombo(c);closeModal('detailModal')};
  $('detailSupportCombo').onclick=()=>openBot('support',`Hola. Necesito información detallada sobre el combo ${c.name}, precio ${money(c.price)}.`,{Producto:c.name,Precio:money(c.price),Tipo:'Consulta'});
  $('detailCloseCombo').onclick=()=>closeModal('detailModal');
}

function buildOrder(user,items,notes=''){
  const subtotal=items.reduce((s,i)=>s+Number(i.price||0)*Number(i.qty||0),0);
  const promoResult=currentPromoResult(subtotal);
  const discount=promoResult?.discount||0;
  return {id:`NP-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${Math.random().toString(36).slice(2,7).toUpperCase()}`,userId:user.id,customer:{fullName:user.fullName,email:user.email,phone:user.phone,department:user.department,municipality:user.municipality,address:user.address,reference:user.reference},items:items.map(i=>({type:i.type||'product',id:i.id,name:i.name,price:Number(i.price),qty:Number(i.qty)})),subtotal,discount,promotion:promoResult?{code:promoResult.promo.code,type:promoResult.promo.type,value:promoResult.promo.value}:null,total:Math.max(0,subtotal-discount),notes,status:'Nuevo',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
}
function submitOrder(e){
  e.preventDefault();const user=currentUser();if(!user)return openCheckout();const items=cartDetails();if(!items.length)return toast('Tu carrito está vacío.','warn');
  const order=buildOrder(user,items,$('coNotes').value.trim());registerOrder(order);
  if(order.promotion){const promo=findPromo(order.promotion.code);if(promo){promo.uses=Number(promo.uses||0)+1;write(NP_PROMOS_KEY,state.promos)}}
  state.cart=[];state.appliedPromoCode='';write(KEYS.cart,state.cart);write(NP_APPLIED_PROMO_KEY,'');renderHeader();renderCart();closeModal('checkoutModal');$('coNotes').value='';toast(`Pedido ${order.id} enviado correctamente.`,'success');
}

function adminPromotions(){
  $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Códigos promocionales</h2></div><form id="promoAdminForm" class="promo-admin-form"><div class="field"><label>Código</label><input id="promoAdminCode" maxlength="24" placeholder="NOVA10" required/></div><div class="field"><label>Tipo</label><select id="promoAdminType"><option value="percent">Porcentaje</option><option value="fixed">Monto fijo</option></select></div><div class="field"><label>Valor</label><input id="promoAdminValue" type="number" min="0" step="0.01" required/></div><div class="field"><label>Compra mínima</label><input id="promoAdminMin" type="number" min="0" step="0.01" value="0"/></div><div class="field"><label>Válido hasta</label><input id="promoAdminExpiry" type="date"/></div><div class="field"><label>Estado</label><select id="promoAdminActive"><option value="true">Activo</option><option value="false">Inactivo</option></select></div><div class="field full"><label>Descripción</label><input id="promoAdminDescription" placeholder="10% de descuento en tu compra"/></div><div class="form-actions full"><button class="btn btn-primary" type="submit">Guardar código</button></div></form><div class="promo-admin-list" id="promoAdminList"></div></section>`;
  const renderList=()=>{$('promoAdminList').innerHTML=state.promos.length?state.promos.map(p=>`<article class="promo-admin-item"><div><h3>${esc(p.code)} · ${p.type==='percent'?`${p.value}%`:money(p.value)}</h3><p>${esc(p.description||'Sin descripción')} · Compra mínima: ${money(p.minPurchase)}${p.expiresAt?` · Vence: ${esc(p.expiresAt)}`:''} · Usos: ${Number(p.uses||0)}</p></div><div class="toolbar"><button class="btn btn-secondary btn-sm" data-toggle-promo="${p.id}">${p.active?'Desactivar':'Activar'}</button><button class="btn btn-red btn-sm" data-delete-promo="${p.id}">Eliminar</button></div></article>`).join(''):'<div class="empty">Todavía no hay códigos promocionales.</div>';$('promoAdminList').querySelectorAll('[data-toggle-promo]').forEach(b=>b.onclick=()=>{const p=state.promos.find(x=>x.id===b.dataset.togglePromo);p.active=!p.active;write(NP_PROMOS_KEY,state.promos);renderList();renderCart()});$('promoAdminList').querySelectorAll('[data-delete-promo]').forEach(b=>b.onclick=async()=>{const p=state.promos.find(x=>x.id===b.dataset.deletePromo);if(!await npConfirm(`Eliminar el código ${p.code}?`))return;state.promos=state.promos.filter(x=>x.id!==p.id);if(state.appliedPromoCode===p.code){state.appliedPromoCode='';write(NP_APPLIED_PROMO_KEY,'')}write(NP_PROMOS_KEY,state.promos);renderList();renderCart()})};
  renderList();
  $('promoAdminForm').onsubmit=e=>{e.preventDefault();const code=$('promoAdminCode').value.trim().toUpperCase();const existing=state.promos.find(p=>p.code===code);const data=normalizePromo({id:existing?.id,code,type:$('promoAdminType').value,value:Number($('promoAdminValue').value||0),minPurchase:Number($('promoAdminMin').value||0),expiresAt:$('promoAdminExpiry').value,active:$('promoAdminActive').value==='true',description:$('promoAdminDescription').value.trim(),uses:existing?.uses||0});if(existing)Object.assign(existing,data);else state.promos.unshift(data);write(NP_PROMOS_KEY,state.promos);e.target.reset();$('promoAdminMin').value='0';renderList();toast('Código promocional guardado.','success')};
}
if($('adminNav')&&!$('adminNav').querySelector('[data-admin="promotions"]')){const btn=document.createElement('button');btn.dataset.admin='promotions';btn.textContent='🎟️ Promociones';const ref=$('adminNav').querySelector('[data-admin="orders"]')||null;$('adminNav').insertBefore(btn,ref)}
function renderAdminSection(section){
  state.adminSection=section;renderAdminNav();
  const titles={dashboard:'Resumen',products:'Productos',combos:'Combos',inventory:'Inventario',categories:'Categorías',faqs:'Preguntas frecuentes',users:'Clientes',promotions:'Promociones',orders:'Pedidos',settings:'Tienda',bots:'Atención',backup:'Respaldos',activity:'Actividad'};
  $('adminTitle').textContent=titles[section]||'Administración';
  const fn={dashboard:adminDashboard,products:adminProducts,combos:adminCombos,inventory:adminInventory,categories:adminCategories,faqs:adminFaqs,users:adminUsers,promotions:adminPromotions,orders:adminOrders,settings:adminSettings,bots:adminBots,backup:adminBackup,activity:adminActivity}[section]||adminDashboard;
  fn();
}


