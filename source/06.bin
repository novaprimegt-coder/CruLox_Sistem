  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
  margin-top:8px;
}
.product-media-preview:empty{display:none}
.product-media-preview figure{
  margin:0;
  min-width:0;
  padding:7px;
  border-radius:12px;
  background:rgba(255,255,255,.035);
  border:1px solid rgba(255,255,255,.06);
}
.product-media-preview img{
  display:block;
  width:100%;
  aspect-ratio:4/3;
  object-fit:cover;
  border-radius:9px;
}
.product-media-preview figcaption{
  margin-top:5px;
  color:var(--muted);
  font-size:.56rem;
  text-align:center;
}
.product-video-mini{
  position:fixed;
  left:12px;
  bottom:max(12px,env(safe-area-inset-bottom));
  z-index:3800;
  width:min(238px,calc(100vw - 24px));
  aspect-ratio:16/9;
  overflow:hidden;
  border-radius:18px;
  background:#02060c;
  border:1px solid rgba(0,217,255,.25);
  box-shadow:0 20px 52px rgba(0,0,0,.58);
}
.product-video-mini .product-video-surface,
.product-video-mini video,
.product-video-mini iframe{
  display:block;
  width:100%;
  height:100%;
  border:0;
  object-fit:contain;
  background:#000;
}
.product-video-mini-close,
.product-video-full-close{
  position:absolute;
  z-index:4;
  display:grid;
  place-items:center;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(4,11,21,.90);
  color:#fff;
  font-weight:900;
  box-shadow:0 8px 22px rgba(0,0,0,.32);
}
.product-video-mini-close{
  top:7px;
  right:7px;
  width:31px;
  height:31px;
  border-radius:50%;
  font-size:.78rem;
}
.product-video-expand-hit{
  position:absolute;
  inset:0;
  z-index:3;
  border:0;
  background:linear-gradient(180deg,transparent 46%,rgba(0,0,0,.50));
  color:#fff;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding:12px 42px 10px 12px;
  font-size:.66rem;
  font-weight:900;
  text-shadow:0 2px 8px rgba(0,0,0,.8);
}
.product-video-full{
  position:fixed;
  inset:0;
  z-index:5200;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(0,0,0,.96);
}
.product-video-full-stage{
  width:min(1180px,100%);
  height:min(82vh,720px);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  border-radius:20px;
  background:#000;
  border:1px solid rgba(255,255,255,.10);
}
.product-video-full-stage video,
.product-video-full-stage iframe{
  display:block;
  width:100%;
  height:100%;
  border:0;
  object-fit:contain;
  background:#000;
}
.product-video-full-close{
  top:max(14px,env(safe-area-inset-top));
  right:14px;
  width:46px;
  height:46px;
  border-radius:50%;
  font-size:1.05rem;
}
.product-video-fallback{
  position:absolute;
  left:50%;
  bottom:max(16px,env(safe-area-inset-bottom));
  transform:translateX(-50%);
  z-index:3;
  color:#d9e8f8;
  font-size:.68rem;
  text-decoration:none;
  padding:9px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.10);
}
@media(max-width:560px){
  .product-detail-thumb{width:58px;height:44px}
  .product-video-mini{width:196px;border-radius:15px}
  .product-video-full{padding:10px}
  .product-video-full-stage{height:min(76vh,620px);border-radius:16px}
}
`;
if(!document.getElementById('np-v818-style')){
  const style=document.createElement('style');
  style.id='np-v818-style';
  style.textContent=NP_V818_STYLE;
  document.head.appendChild(style);
}

function normalizeProductMediaRecord(product){
  const candidates=[];
  if(Array.isArray(product?.images))candidates.push(...product.images);
  if(product?.image)candidates.push(product.image);
  if(product?.image2)candidates.push(product.image2);
  const images=[];
  candidates.forEach(value=>{
    const clean=String(value||'').trim();
    if(clean&&!images.includes(clean)&&images.length<2)images.push(clean);
  });
  return {
    ...product,
    image:images[0]||String(product?.image||'').trim(),
    image2:images[1]||'',
    images:images.slice(0,2),
    videoUrl:String(product?.videoUrl||product?.video||'').trim()
  };
}
{
  let mediaSchemaChanged=false;
  state.products=(state.products||[]).map(product=>{
    const normalized=normalizeProductMediaRecord(product);
    if(JSON.stringify(product.images||[])!==JSON.stringify(normalized.images)||String(product.image2||'')!==normalized.image2||String(product.videoUrl||'')!==normalized.videoUrl)mediaSchemaChanged=true;
    return normalized;
  });
  if(mediaSchemaChanged)write(KEYS.products,state.products);
}

/* v11.23 · Producción: no insertar productos de prueba en el catálogo real. */
{
  const legacyDemoIds=new Set(['demo-media-nova-audio','demo-media-nova-tech']);
  const before=Array.isArray(state.products)?state.products.length:0;
  if(before){
    state.products=state.products.filter(product=>!legacyDemoIds.has(String(product?.id||'')));
    if(state.products.length!==before)write(KEYS.products,state.products);
  }
  try{localStorage.removeItem('np_v19_test_products_seeded')}catch(error){}
}

const migrateHeavyStoredMediaV818Base=migrateHeavyStoredMedia;
migrateHeavyStoredMedia=async function(){
  let changed=await migrateHeavyStoredMediaV818Base();
  const migrationKey='np_v18_product_gallery_optimized';
  if(localStorage.getItem(migrationKey)!=='1'){
    for(const product of state.products||[]){
      const source=(Array.isArray(product.images)&&product.images.length?product.images:[product.image,product.image2]).filter(Boolean).slice(0,2);
      const optimized=[];
      for(const image of source){
        if(isRasterDataUrl(image)&&image.length>150000)optimized.push(await optimizeImageDataUrl(image,{maxWidth:1200,maxHeight:900,quality:.86}));
        else optimized.push(image);
      }
      const unique=[...new Set(optimized.filter(Boolean))].slice(0,2);
      if(JSON.stringify(unique)!==JSON.stringify(product.images||[]))changed=true;
      product.images=unique;
      product.image=unique[0]||product.image||'';
      product.image2=unique[1]||'';
    }
    if(changed)write(KEYS.products,state.products);
    try{localStorage.setItem(migrationKey,'1')}catch(error){}
  }
  return changed;
};

function productForm(product=null){
  const p=normalizeProductMediaRecord(product||{id:'',name:'',category:'',price:'',oldPrice:'',stock:0,rating:5,reviews:0,image:'',image2:'',images:[],videoUrl:'',description:'',badge:'',badgeText:'',featured:false});
  return `<form id="productForm"><div class="form-grid"><div class="field full"><label>Nombre</label><input id="pfName" value="${esc(p.name)}" required/></div><div class="field"><label>Categoría</label><input id="pfCategory" value="${esc(p.category)}" required/></div><div class="field"><label>Existencias</label><input id="pfStock" type="number" min="0" value="${Number(p.stock||0)}" required/></div><div class="field"><label>Precio</label><input id="pfPrice" type="number" step="0.01" min="0" value="${p.price}" required/></div><div class="field"><label>Precio anterior</label><input id="pfOldPrice" type="number" step="0.01" min="0" value="${p.oldPrice??''}"/></div><div class="field"><label>Calificación</label><input id="pfRating" type="number" step="0.1" min="0" max="5" value="${p.rating}"/></div><div class="field"><label>Reseñas</label><input id="pfReviews" type="number" min="0" value="${p.reviews}"/></div><div class