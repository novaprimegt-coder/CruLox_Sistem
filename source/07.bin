const NP_PUBLIC_BUILD='9.1.0';
const NP_PBKDF2_ITERATIONS=210000;
const NP_ADMIN_PENDING_MESSAGE='El acceso administrativo seguro se habilitará en la siguiente fase.';
window.NovaPrimeArchitecture=Object.freeze({
  phase:'storefront-complete',
  build:NP_PUBLIC_BUILD,
  publicStorefront:'catalog-and-orders',
  administratorWrites:'panel-only',
  publicDatabaseEdits:false
});

const NP_V90_STYLE=`
:root{--focus:0 0 0 3px rgba(0,217,255,.22),0 0 0 1px rgba(0,217,255,.72)}
html{scroll-padding-top:92px}
body{background:radial-gradient(circle at 8% -5%,rgba(0,217,255,.10),transparent 27%),radial-gradient(circle at 92% 36%,rgba(72,89,255,.07),transparent 28%),linear-gradient(180deg,#050a12 0%,#06101b 52%,#04080f 100%)}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:-1;background-image:linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.01) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent 72%)}
::selection{background:rgba(0,217,255,.28);color:#fff}
button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:none;box-shadow:var(--focus)!important}
button:disabled{cursor:not-allowed;opacity:.52;transform:none!important;filter:saturate(.55)}
.header{border-bottom-color:rgba(0,217,255,.12);box-shadow:0 14px 42px rgba(0,0,0,.42)}
.header-row{max-width:1240px;margin-inline:auto}
.search{transition:border-color .2s,box-shadow .2s,background .2s}.search:focus{background:rgba(255,255,255,.055)}
.hero-box{border-color:rgba(0,217,255,.18);box-shadow:0 28px 72px rgba(0,0,0,.44),inset 0 1px 0 rgba(255,255,255,.035)}
.hero-mini div,.benefit,.product,.combo,.step,.faq,.profile-card,.list-card{box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 14px 34px rgba(0,0,0,.18)}
.section{content-visibility:auto;contain-intrinsic-size:640px;padding-block:22px}
.section-head{margin-bottom:15px}.section-title{letter-spacing:-.025em}.section-kicker{letter-spacing:1.05px}
.category-scroll{overscroll-behavior-inline:contain;scroll-snap-type:x proximity}.cat{scroll-snap-align:start;transition:.18s}.cat:hover{border-color:rgba(0,217,255,.25);color:#eef8ff}.cat.active{box-shadow:0 8px 24px rgba(0,217,255,.18)}
.products{gap:16px}.product{border-color:rgba(255,255,255,.085);transform:translateZ(0)}.product:hover{transform:translateY(-5px);border-color:rgba(0,217,255,.28);box-shadow:0 22px 52px rgba(0,0,0,.38)}
.product-image{aspect-ratio:4/3;height:auto}.product-image img{object-position:center}.product-body{padding:14px}.product-actions button{transition:transform .18s,filter .18s,border-color .18s}.product-actions button:hover{transform:translateY(-1px);filter:brightness(1.06)}
.price{letter-spacing:-.02em}.stock{font-weight:800}.stock.out{font-weight:900}
.btn{position:relative;overflow:hidden;isolation:isolate}.btn::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 25%,rgba(255,255,255,.17),transparent 75%);transform:translateX(-130%);transition:transform .45s;z-index:-1}.btn:hover::after{transform:translateX(130%)}
.modal-overlay{overscroll-behavior:contain}.modal{border-color:rgba(255,255,255,.11);box-shadow:0 36px 100px rgba(0,0,0,.72),inset 0 1px 0 rgba(255,255,255,.04)}
.field input,.field select,.field textarea{transition:border-color .18s,box-shadow .18s,background .18s}.field input:focus,.field select:focus,.field textarea:focus{background:rgba(255,255,255,.06)}
.toast{border-color:rgba(255,255,255,.1);box-shadow:0 18px 44px rgba(0,0,0,.46)}
.footer{border-top-color:rgba(0,217,255,.10);background:linear-gradient(180deg,rgba(8,18,31,.84),#04080f)}
.footer-social{padding-bottom:3px}

@media(max-width:560px){.section{padding-block:18px}.products{gap:10px}.product-body{padding:10px}.hero-box{box-shadow:0 20px 50px rgba(0,0,0,.38)}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.product:hover,.btn:hover,.icon-btn:hover{transform:none!important}}
`;
if(!document.getElementById('np-v90-style')){
  const style=document.createElement('style');style.id='np-v90-style';style.textContent=NP_V90_STYLE;document.head.appendChild(style);
}

function npBytesToHex(bytes){return [...bytes].map(value=>value.toString(16).padStart(2,'0')).join('')}
function npSecureRandomHex(size=18){
  const bytes=new Uint8Array(size);
  if(window.crypto?.getRandomValues)crypto.getRandomValues(bytes);else for(let i=0;i<size;i++)bytes[i]=Math.floor(Math.random()*256);
  return npBytesToHex(bytes);
}
async function npDerivePassword(password,salt,iterations=NP_PBKDF2_ITERATIONS){
  const clean=String(password||'');
  if(window.crypto?.subtle){
    const encoder=new TextEncoder();
    const key=await crypto.subtle.importKey('raw',encoder.encode(clean),'PBKDF2',false,['deriveBits']);
    const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt:encoder.encode(String(salt)),iterations:Number(iterations),hash:'SHA-256'},key,256);
    return npBytesToHex(new Uint8Array(bits));
  }
  return sha256(`${salt}:${clean}:${iterations}`);
}
async function npCreatePasswordRecord(password){
  const salt=npSecureRandomHex(18);
  return {passwordHash:await npDerivePassword(password,salt),passwordSalt:salt,passwordIterations:NP_PBKDF2_ITERATIONS,passwordAlgorithm:'PBKDF2-SHA256'};
}
async function npVerifyUserPassword(user,password){
  if(user?.passwordAlgorithm==='PBKDF2-SHA256'&&user.passwordSalt){
    const candidate=await npDerivePassword(password,user.passwordSalt,user.passwordIterations||NP_PBKDF2_ITERATIONS);
    return candidate===user.passwordHash;
  }
  const legacy=await sha256(password);
  if(legacy!==user?.passwordHash)return false;
  Object.assign(user,await npCreatePasswordRecord(password),{passwordMigratedAt:new Date().toISOString()});
  write(KEYS.users,state.users);
  return true;
}
function npIsSafeExternalUrl(raw,{media=false,image=false}={}){
  const value=String(raw||'').trim();
  if(!value||value==='#')return '';
  if(image&&/^data:image\/(?:png|jpe?g|webp|gif|svg\+xml);/i.test(value))return value;
  if(media&&/^data:video\//i.test(value))return value;
  if(/^blob:/i.test(value))return value;
  try{
    const url=new URL(/^www\./i.test(value)?`https://${value}`:value,location.href);
    if(url.protocol==='https:')return url.toString();
    if((url.protocol==='file:'||url.protocol==='content:')&&url.origin===location.origin)return url.toString();
  }catch(error){}
  return '';
}
function npSecureOrderId(){return `NP-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${npSecureRandomHex(5).toUpperCase()}`}

function buildOrder(user,items,notes=''){
  const subtotal=items.reduce((sum,item)=>sum+Number(item.price||0)*Number(item.qty||0),0);
  const promoResult=currentPromoResult(subtotal);
  const discount=promoResult?.discount||0;
  return {id:npSecureOrderId(),schemaVersion:2,clientBuild:NP_PUBLIC_BUILD,userId:user.id,customer:{fullName:user.fullName,email:user.email,phone:user.phone,department:user.department,municipality:user.municipality,address:user.address,reference:user.reference},items:items.map(item=>({type:item.type||'product',id:item.id,name:item.name,price:Number(item.price),qty:Number(item.qty)})),subtotal,discount,promotion:promoResult?{code:promoResult.promo.code,type:promoResult.promo.type,value:promoResult.promo.value}:null,total:Math.max(0,subtotal-discount),notes:String(notes||'').trim().slice(0,600),status:'Nuevo',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
}
let npOrderSubmissionLocked=false;
async function submitOrder(event){
  event?.preventDefault?.();
  if(npOrderSubmissionLocked)return toast('El pedido ya se está procesando.','warn');
  const user=currentUser();if(!user)return openCheckout();
  purgeUnavailableCart(true);
  const items=cartDetails();if(!items.length)return toast('Tu carrito está vacío.','warn');
  npOrderSubmissionLocked=true;
  const button=$('checkoutForm')?.querySelector('[type="submit"]');if(button){button.disabled=true;button.dataset.originalText=button.textContent;button.textContent='Enviando pedido…'}
  try{
    const order=buildOrder(user,items,$('coNotes')?.value||'');registerOrder(order);
    if(order.promotion){const promo=findPromo(order.promotion.code);if(promo){promo.uses=Number(promo.uses||0)+1;write(NP_PROMOS_KEY,state.promos)}}
    state.cart=[];state.appliedPromoCode='';write(KEYS.cart,state.cart);write(NP_APPLIED_PROMO_KEY,'');renderHeader();renderCart();closeModal('checkoutModal');if($('coNotes'))$('coNotes').value='';toast(`Pedido ${order.id} enviado correctamente.`,'success');
  }catch(error){console.error('Order submission',error);showModalNotice('No fue posible enviar el pedido. Intenta nuevamente.','error','checkoutModal')}
  finally{setTimeout(()=>{npOrderSubmissionLocked=false;if(button){button.disabled=false;button.textContent=button.dataset.originalText||'Enviar pedido'}},900)}
}

async function handleRegister(event){
  event.preventDefault();clearModalNotice();
  const check=accountValidation('reg');if(!check.ok)return focusInvalid(check.input,check.message);
  const password=$('regPassword').value,confirmPassword=$('regConfirm').value;
  if(password.length<10)return focusInvalid($('regPassword'),'La contraseña debe tener al menos 10 caracteres.');
  if(!/[A-Za-z]/.test(password)||!/\d/.test(password))return focusInvalid($('regPassword'),'Incluye al menos una letra y un número en la contraseña.');
  if(password!==confirmPassword)return focusInvalid($('regConfirm'),'Las contraseñas no coinciden.');
  if(!$('regConsent').checked)return focusInvalid($('regConsent'),'Debes aceptar el uso de tus datos para gestionar pedidos y entregas.');
  if(state.users.some(user=>norm(user.username)===norm(check.data.username)||norm(user.email)===norm(check.data.email)))return focusInvalid($('regUsername'),'El usuario o correo ya está registrado.');
  const credentials=await npCreatePasswordRecord(password);
  const user={id:uid('usr'),...check.data,...credentials,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
  state.users.push(user);state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};write(KEYS.users,state.users);write(KEYS.session,state.session);logActivity('Cliente registrado',user.email);renderHeader();renderAccount();toast('Cuenta creada correctamente.','success');
}
async function handleLogin(event){
  event.preventDefault();clearModalNotice();
  const identity=$('loginIdentity').value.trim(),password=$('loginPassword').value;
  if(!identity)return focusInvalid($('loginIdentity'),'Escribe tu usuario o correo electrónico.');
  if(!password)return focusInvalid($('loginPassword'),'Escribe tu contraseña.');
  if(norm(identity)===norm(''))return focusInvalid($('loginIdentity'),NP_ADMIN_PENDING_MESSAGE);
  const user=state.users.find(item=>norm(item.username)===norm(identity)||norm(item.email)===norm(identity));
  if(!user||!await npVerifyUserPassword(user,password))return focusInvalid($('loginPassword'),'El usuario, correo o contraseña no es correcto.');
  state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};write(KEYS.session,state.session);renderHeader();renderAccount();toast('Sesión iniciada.','success');
}
function renderProfileEditor(user){
  $('accountBody').innerHTML=`<form id="profileForm" novalidate><div class="form-grid">${accountFields().map(field=>fieldHtml(field,'edit',user[field.key])).join('')}${passwordFieldMarkup('editPassword','Nueva contraseña (opcional)','new-password',false)}${passwordFieldMarkup('editConfirm','Confirmar contraseña','new-password',false)}</div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar cambios</button><button class="btn btn-secondary" type="button" id="cancelEditProfile">Cancelar</button></div></form>`;
  bindPasswordToggles($('accountBody'));$('cancelEditProfile').onclick=renderAccount;
  $('profileForm').onsubmit=async event=>{
    event.preventDefault();clearModalNotice();const check=accountValidation('edit');if(!check.ok)return focusInvalid(check.input,check.message);
    if(state.users.some(item=>item.id!==user.id&&(norm(item.username)===norm(check.data.username)||norm(item.email)===norm(check.data.email))))return focusInvalid($('editUsername'),'El usuario o correo ya está utilizado.');
    const password=$('editPassword').value,confirmation=$('editConfirm').value;
    if(password&&password.length<10)return focusInvalid($('editPassword'),'La nueva contraseña debe tener al menos 10 caracteres.');
    if(password&&(!/[A-Za-z]/.test(password)||!/\d/.test(password)))return focusInvalid($('editPassword'),'Incluye al menos una letra y un número.');
    if((password||confirmation)&&password!==confirmation)return focusInvalid($('editConfirm'),'Las contraseñas no coinciden.');
    Object.assign(user,check.data,{updatedAt:new Date().toISOString()});if(password)Object.assign(user,await npCreatePasswordRecord(password));
    write(KEYS.users,state.users);renderAccount();renderHeader();toast('Perfil actualizado.','success');
  };
}
function renderSocials(){
  const markup=socialItems().map(item=>{
    const safe=npIsSafeExternalUrl(state.settings[item.key]||'');
    if(item.key==='supportBotUrl')return `<button type="button" class="social-pill" data-social-support>${esc(item.label)}</button>`;
    if(!safe)return `<button type="button" class="social-pill" data-social-maintenance>${esc(item.label)}</button>`;
    return `<a class="social-pill" href="${esc(safe)}" target="_blank" rel="noopener noreferrer">${esc(item.label)}</a>`;
  }).join('');
  ['footerSocial','drawerSocial'].forEach(id=>{const root=$(id);if(!root)return;root.innerHTML=markup;root.querySelectorAll('[data-social-support]').forEach(button=>button.onclick=()=>openBot('support','Hola. Necesito ayuda con CRULOX.',{Tipo:'Consulta general'}));root.querySelectorAll('[data-social-maintenance]').forEach(button=>button.onclick=maintenanceNotice)});
}
function normalizeProductVideoLink(raw){
  let value=String(raw||'').trim();if(!value)return '';if(/^www\./i.test(value))value=`https://${value}`;
  return npIsSafeExternalUrl(value,{media:true});
}
function productVideoMediaMarkup(url,{full=false}={}){
  const clean=normalizeProductVideoLink(url);if(!clean)return '';
  if(isDirectProductVideo(clean))return `<video ${full?'controls autoplay':'autoplay muted loop'} playsinline preload="metadata" controlslist="nodownload noplaybackrate" disablepictureinpicture src="${esc(clean)}"></video>`;
  const embed=npIsSafeExternalUrl(productVideoEmbedUrl(clean),{media:true});if(!embed)return '';
  return `<iframe src="${esc(embed)}" title="Video del producto" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-presentation" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
}
function openBot(kind,message,extra={}){
  const built=buildBotUrl(kind,String(message||'').slice(0,1200),extra);const safe=npIsSafeExternalUrl(built);
  if(!safe){maintenanceNotice();return false}
  try{const opened=window.open(safe,'_blank','noopener,noreferrer');if(opened){try{opened.opener=null}catch(error){};return true}location.assign(safe);return true}catch(error){console.warn('External function',error);maintenanceNotice();return false}
}
const npLegacyOpenAdmin=openAdmin;
openAdmin=function(){toast(NP_ADMIN_PENDING_MESSAGE,'warn');return false};
if(state.session?.role==='admin'){state.session=null;write(KEYS.session,null)}

function npHardenDynamicContent(root=document){
  root.querySelectorAll('a[target="_blank"]').forEach(link=>link.setAttribute('rel','noopener noreferrer'));
  root.querySelectorAll('iframe').forEach(frame=>{frame.setAttribute('referrerpolicy','no-referrer');if(!frame.hasAttribute('sandbox'))frame.setAttribute('sandbox','allow-scripts allow-same-origin allow-presentation')});
  root.querySelectorAll('input:not([maxlength])').forEach(input=>{if(!['number','date','checkbox','file'].includes(input.type))input.maxLength=180});
  root.querySelectorAll('textarea:not([maxlength])').forEach(area=>area.maxLength=1200);
}
let npSecurityFrame=0;
const npSecurityRoots=new Set();
const npSecurityObserver=new MutationObserver(records=>{
  for(const record of records)for(const node of record.addedNodes)if(node.nodeType===1)npSecurityRoots.add(node);
  if(npSecurityFrame||!npSecurityRoots.size)return;
  npSecurityFrame=requestAnimationFrame(()=>{
    npSecurityFrame=0;
    const roots=[...npSecurityRoots];npSecurityRoots.clear();
    const topRoots=roots.filter((root,index)=>!roots.some((other,i)=>i!==index&&other.contains?.(root)));
    topRoots.forEach(root=>npHardenDynamicContent(root));
  });
});
npSecurityObserver.observe(document.documentElement,{childList:true,subtree:true});
npHardenDynamicContent();



/* ========================================================================
   v9.1 · Atención pública y reproductor multimedia refinado
   ======================================================================== */
const NP_VIDEO_WATERMARK=BRAND_LOGO;
const NP_V91_STYLE=`
/* FAQ: respuesta compacta, sin espacio vacío artificial */
.faq-a{display:block;max-height:0;overflow:hidden;padding:0 17px!important;line-height:1.62;transition:max-height .24s ease,padding .24s ease}
.faq.open .faq-a{padding:0 17px 15px!important}

/* Reproductor flotante compacto */
.product-video-mini{
  left:max(12px,env(safe-area-inset-left))!important;
  bottom:max(14px,env(safe-area-inset-bottom))!important;
  width:min(250px,calc(100vw - 24px))!important;
  aspect-ratio:16/9!important;
  border-radius:20px!important;
  border:1px solid rgba(0,217,255,.34)!important;
  background:linear-gradient(145deg,#07111e,#02060c)!important;
  box-shadow:0 24px 70px rgba(0,0,0,.68),0 0 0 1px rgba(255,255,255,.035) inset!important;
}
.np-video-preview{position:relative;width:100%;height:100%;overflow:hidden;border-radius:inherit;background:#02050a}
.np-video-preview video,.np-video-preview iframe{width:100%;height:100%;display:block;border:0;object-fit:cover;background:#000}
.np-video-preview::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.62));pointer-events:none}
.np-video-preview-copy{position:absolute;left:13px;right:46px;bottom:11px;z-index:4;display:grid;gap:2px;text-align:left;pointer-events:none}
.np-video-preview-copy span{font-size:.54rem;letter-spacing:.12em;text-transform:uppercase;color:#8adfff;font-weight:900}
.np-video-preview-copy strong{font-size:.68rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.np-video-preview-play{position:absolute;inset:0;z-index:3;border:0;background:transparent;color:#fff;display:grid;place-items:center}
.np-video-preview-play i{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;font-style:normal;font-size:1rem;background:rgba(3,12,23,.72);border:1px solid rgba(255,255,255,.22);box-shadow:0 12px 28px rgba(0,0,0,.38);backdrop-filter:blur(8px)}
.product-video-mini-close{top:8px!important;right:8px!important;width:32px!important;height:32px!important;background:rgba(2,8,16,.88)!important;border-color:rgba(255,255,255,.18)!important;z-index:7!important}
.np-video-watermark{position:absolute;right:12px;bottom:10px;z-index:5;width:74px;height:auto;opacity:.34;pointer-events:none;filter:drop-shadow(0 3px 8px rgba(0,0,0,.6))}
.product-video-mini .np-video-watermark{right:8px;bottom:8px;width:44px;opacity:.32}

/* Vista completa: proporción estable, sin franjas gigantes */
.product-video-full{padding:max(14px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(14px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))!important;background:rgba(0,3,8,.975)!important;backdrop-filter:blur(14px);align-items:center!important}
.np-video-dialog{width:min(1080px,100%);display:grid;gap:12px}
.np-video-dialog-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 4px}
.np-video-dialog-title{display:flex;align-items:center;gap:11px;min-width:0}
.np-video-dialog-title img{width:42px;height:42px;object-fit:contain;opacity:.95}
.np-video-dialog-title div{min-width:0}
.np-video-dialog-title span{display:block;color:#6fdcff;font-size:.58rem;text-transform:uppercase;letter-spacing:.12em;font-weight:900}
.np-video-dialog-title strong{display:block;color:#fff;font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.product-video-full-close{position:relative!important;top:auto!important;right:auto!important;flex:0 0 auto;width:44px!important;height:44px!important;border-radius:15px!important;background:rgba(255,255,255,.06)!important}
.product-video-full-stage{position:relative!important;width:100%!important;height:auto!important;aspect-ratio:16/9!important;max-height:calc(100vh - 150px)!important;border-radius:24px!important;border:1px solid rgba(0,217,255,.22)!important;background:radial-gradient(circle at 50% 40%,rgba(0,217,255,.07),transparent 48%),#000!important;box-shadow:0 30px 80px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.04)!important}
.product-video-full-stage video,.product-video-full-stage iframe{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;border:0;background:#000}
.np-video-center-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:6;width:76px;height:76px;border-radius:50%;border:1px solid rgba(255,255,255,.26);background:rgba(3,10,20,.74);color:#fff;font-size:1.45rem;display:grid;place-items:center;box-shadow:0 18px 44px rgba(0,0,0,.48);backdrop-filter:blur(10px);transition:.18s}
.np-video-center-play:hover{transform:translate(-50%,-50%) scale(1.04)}
.np-video-center-play.is-playing{opacity:0;pointer-events:none}
.product-video-full.np-video-ui-hidden .np-video-controls,
.product-video-full.np-video-ui-hidden .np-video-center-play{opacity:0;pointer-events:none;transform:translate(-50%,-50%) scale(.96)}
.product-video-full.np-video-ui-hidden .np-video-controls{transform:translateY(8px);}
.np-video-controls{position:absolute;left:12px;right:12px;bottom:12px;z-index:7;display:grid;grid-template-columns:auto auto minmax(80px,1fr) auto auto auto;align-items:center;gap:10px;padding:10px 12px;border-radius:17px;background:linear-gradient(180deg,rgba(4,12,22,.78),rgba(2,7,14,.94));border:1px solid rgba(255,255,255,.10);box-shadow:0 12px 34px rgba(0,0,0,.42);backdrop-filter:blur(13px)}
.np-video-control{width:36px;height:36px;border:0;border-radius:11px;background:rgba(255,255,255,.07);color:#fff;display:grid;place-items:center;font-size:.8rem}
.np-video-time{font-size:.62rem;color:#d8e5f5;font-variant-numeric:tabular-nums;white-space:nowrap}
.np-video-progress{width:100%;height:5px;accent-color:#00d9ff;cursor:pointer}
.np-video-external{color:#dbe9f8;text-decoration:none;font-size:.64rem;padding:9px 12px;border-radius:11px;background:rgba(255,255,255,.07);white-space:nowrap}
.np-video-external-note{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:6;display:flex;align-items:center;gap:8px;padding:9px 13px;border-radius:999px;background:rgba(3,10,20,.82);border:1px solid rgba(255,255,255,.12);color:#dce9f7;font-size:.64rem;backdrop-filter:blur(10px)}
.product-video-fallback{display:none!important}
@media(max-width:620px){
  .product-video-mini{width:210px!important;border-radius:17px!important}
  .product-video-full{padding:8px!important}
  .np-video-dialog{gap:8px}
  .np-video-dialog-title img{width:34px;height:34px}
  .product-video-full-stage{border-radius:18px!important;max-height:calc(100vh - 92px)!important}
  .np-video-controls{left:7px;right:7px;bottom:7px;grid-template-columns:auto auto minmax(52px,1fr) auto auto;gap:6px;padding:7px;border-radius:13px}
  .np-video-controls .np-video-external{display:none}
  .np-video-control{width:32px;height:32px;border-radius:9px}
  .np-video-time{font-size:.56rem}
  .np-video-center-play{width:62px;height:62px}
  .np-video-watermark{width:58px;right:9px;bottom:54px}
}
`;
if(!document.getElementById('np-v91-style')){const style=document.createElement('style');style.id='np-v91-style';style.textContent=NP_V91_STYLE;document.head.appendChild(style)}

function npWarmAttentionNotice(){
  return toast('Estamos mejorando este canal para brindarte una atención más rápida y personalizada.','info');
}
maintenanceNotice=npWarmAttentionNotice;
function openBot(kind,message,extra={}){
  const built=buildBotUrl(kind,String(message||'').slice(0,1200),extra);
  const safe=npIsSafeExternalUrl(built);
  if(!safe){npWarmAttentionNotice();return false}
  try{const opened=window.open(safe,'_blank','noopener,noreferrer');if(opened){try{opened.opener=null}catch(error){};return true}location.assign(safe);return true}catch(error){console.warn('Support channel',error);npWarmAttentionNotice();return false}
}

function npVideoTime(seconds){
  const value=Number.isFinite(seconds)?Math.max(0,seconds):0;
  const minutes=Math.floor(value/60),secs=Math.floor(value%60);
  return `${minutes}:${String(secs).padStart(2,'0')}`;
}
function productVideoMediaMarkup(url,{full=false}={}){
  const clean=normalizeProductVideoLink(url);if(!clean)return '';
  if(isDirectProductVideo(clean))return `<video class="np-video-element" ${full?'':'autoplay muted loop'} playsinline preload="metadata" src="${esc(clean)}"></video>`;
  const embed=npIsSafeExternalUrl(productVideoEmbedUrl(clean),{media:true});if(!embed)return '';
  return `<iframe src="${esc(embed)}" title="Presentación del producto" loading="eager" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-presentation" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
}
function npWatermarkMarkup(){return `<img class="np-video-watermark" src="${NP_VIDEO_WATERMARK}" alt="" aria-hidden="true"/>`}

function createProductVideoMini(){
  removeProductVideoMini();
  if(!activeProductVideo||activeProductVideo.dismissed||!$('detailModal')?.classList.contains('open'))return;
  const product=state.products.find(item=>item.id===activeProductVideo.productId);
  const mini=document.createElement('aside');mini.id='productVideoMini';mini.className='product-video-mini';mini.setAttribute('aria-label','Vista rápida del producto');
  mini.innerHTML=`<div class="np-video-preview">${productVideoMediaMarkup(activeProductVideo.url)}${npWatermarkMarkup()}<button type="button" class="np-video-preview-play" aria-label="Ampliar presentación"><i>▶</i></button><div class="np-video-preview-copy"><span>Vista rápida</span><strong>${esc(product?.name||'Producto CRULOX')}</strong></div></div><button type="button" class="product-video-mini-close" aria-label="Cerrar presentación">✕</button>`;
  document.body.appendChild(mini);
  mini.querySelector('.np-video-preview-play').onclick=()=>openProductVideoFull();
  mini.querySelector('.product-video-mini-close').onclick=e=>{e.stopPropagation();activeProductVideo.dismissed=true;removeProductVideoMini()};
}
function npBindDirectVideoControls(root){
  const video=root.querySelector('video');if(!video)return false;
  const play=root.querySelector('[data-video-play]'),center=root.querySelector('.np-video-center-play'),progress=root.querySelector('[data-video-progress]'),current=root.querySelector('[data-video-current]'),duration=root.querySelector('[data-video-duration]'),mute=root.querySelector('[data-video-mute]'),fullscreen=root.querySelector('[data-video-fullscreen]');
  let hideTimer=null;
  const showControls=()=>{root.classList.remove('np-video-ui-hidden');if(hideTimer){clearTimeout(hideTimer);hideTimer=null}};
  const hideControlsLater=()=>{if(hideTimer)clearTimeout(hideTimer);hideTimer=setTimeout(()=>{if(!video.paused&&!video.ended)root.classList.add('np-video-ui-hidden')},2000)};
  const sync=()=>{const playing=!video.paused&&!video.ended;play.textContent=playing?'❚❚':'▶';center.textContent=playing?'❚❚':'▶';center.classList.toggle('is-playing',playing);current.textContent=npVideoTime(video.currentTime);duration.textContent=npVideoTime(video.duration);progress.value=video.duration?String((video.currentTime/video.duration)*100):'0';mute.textContent=video.muted?'🔇':'🔊';if(playing)hideControlsLater();else showControls()};
  const toggle=()=>{showControls();if(video.paused)video.play().catch(()=>{});else video.pause()};
  play.onclick=toggle;center.onclick=toggle;
  progress.oninput=()=>{showControls();if(video.duration)video.currentTime=(Number(progress.value)/100)*video.duration};
  mute.onclick=()=>{showControls();video.muted=!video.muted;sync()};
  fullscreen.onclick=async()=>{const stage=root.querySelector('.product-video-full-stage');try{if(document.fullscreenElement)await document.exitFullscreen();else if(stage?.requestFullscreen)await stage.requestFullscreen()}catch(error){}};
  root.addEventListener('pointermove',()=>{if(!video.paused&&!video.ended)hideControlsLater();}, {passive:true});
  root.addEventListener('touchstart',()=>{if(!video.paused&&!video.ended)hideControlsLater();}, {passive:true});
  video.addEventListener('loadedmetadata',sync);video.addEventListener('timeupdate',sync);video.addEventListener('play',sync);video.addEventListener('pause',sync);video.addEventListener('ended',()=>{showControls();sync()});sync();
  setTimeout(()=>video.play().catch(()=>{}),60);
  return true;
}
function openProductVideoFull(){
  if(!activeProductVideo)return;
  removeProductVideoMini();removeProductVideoFull();
  const product=state.products.find(item=>item.id===activeProductVideo.productId);
  const direct=isDirectProductVideo(activeProductVideo.url);
  const full=document.createElement('section');full.id='productVideoFull';full.className='product-video-full';full.setAttribute('role','dialog');full.setAttribute('aria-modal','true');full.setAttribute('aria-label','Presentación del producto');
  const controls=direct?`<button class="np-video-control" data-video-play aria-label="Reproducir o pausar">▶</button><span class="np-video-time" data-video-current>0:00</span><input class="np-video-progress" data-video-progress type="range" min="0" max="100" value="0" aria-label="Avance del video"/><span class="np-video-time" data-video-duration>0:00</span><button class="np-video-control" data-video-mute aria-label="Activar o silenciar sonido">🔊</button><button class="np-video-control" data-video-fullscreen aria-label="Pantalla completa">⛶</button>`:`<span class="np-video-time">Reproductor integrado</span><span></span><span></span><a class="np-video-external" href="${esc(activeProductVideo.url)}" target="_blank" rel="noopener noreferrer">Abrir original</a><button class="np-video-control" data-video-fullscreen aria-label="Pantalla completa">⛶</button>`;
  full.innerHTML=`<div class="np-video-dialog"><div class="np-video-dialog-head"><div class="np-video-dialog-title"><img src="${NP_VIDEO_WATERMARK}" alt="CRULOX"/><div><span>CRULOX</span><strong>Plataformas Digitales</strong></div></div><button type="button" class="product-video-full-close" aria-label="Cerrar presentación">✕</button></div><div class="product-video-full-stage">${productVideoMediaMarkup(activeProductVideo.url,{full:true})}${npWatermarkMarkup()}${direct?'<button type="button" class="np-video-center-play" aria-label="Reproducir">▶</button>':''}<div class="np-video-controls">${controls}</div></div></div>`;
  document.body.appendChild(full);
  full.querySelector('.product-video-full-close').onclick=()=>closeProductVideoFull();
  full.onclick=e=>{if(e.target===full)closeProductVideoFull()};
  const fsButton=full.querySelector('[data-video-fullscreen]');
  if(direct)npBindDirectVideoControls(full);else if(fsButton)fsButton.onclick=async()=>{const stage=full.querySelector('.product-video-full-stage');try{if(document.fullscreenElement)await document.exitFullscreen();else if(stage?.requestFullscreen)await stage.requestFullscreen()}catch(error){}};
}


/* ========================================================================
   CRULOX v9.3 · interacción multimedia refinada
   - controles en una sola línea
   - auto-ocultado a 1 segundo
   - toque en video para mostrar controles
   - ventana flotante arrastrable
   - galería de detalle deslizable
   ======================================================================== */
const NP_V93_STYLE=`
/* Controles: una sola línea real incluso en móvil */
.np-video-controls{
  display:flex!important;
  flex-wrap:nowrap!important;
  align-items:center!important;
  gap:7px!important;
  min-width:0!important;
  padding:8px 9px!important;
  overflow:hidden!important;
  transition:opacity .18s ease,transform .18s ease!important;
}
.np-video-controls .np-video-control{flex:0 0 34px!important;width:34px!important;height:34px!important}
.np-video-controls .np-video-time{flex:0 0 auto!important;font-size:.58rem!important}
.np-video-controls .np-video-progress{flex:1 1 auto!important;min-width:42px!important;width:auto!important}
.np-video-controls .np-video-external{flex:0 0 auto!important}
.product-video-full.np-video-ui-hidden .np-video-controls{
  opacity:0!important;
  pointer-events:none!important;
  transform:translateY(9px)!important;
}
.product-video-full.np-video-ui-hidden .np-video-center-play{
  opacity:0!important;
  pointer-events:none!important;
}
.product-video-full-stage{cursor:pointer!important;touch-action:manipulation!important}

/* Mini reproductor arrastrable */
.product-video-mini{
  touch-action:none!important;
  user-select:none!important;
  -webkit-user-select:none!important;
  will-change:left,top!important;
  transition:box-shadow .16s ease,transform .16s ease!important;
}
.product-video-mini.np-dragging{
  box-shadow:0 30px 86px rgba(0,0,0,.78),0 0 0 1px rgba(0,217,255,.16) inset!important;
  transform:scale(1.015)!important;
}
.product-video-mini .np-video-preview{touch-action:none!important}
.product-video-mini .np-video-preview-play{touch-action:none!important}

/* Galería deslizable */
.product-detail-media{
  position:relative!important;
  overflow:hidden!important;
  touch-action:pan-y!important;
  user-select:none!important;
  -webkit-user-select:none!important;
}
.product-detail-media img{
  transition:opacity .16s ease,transform .20s ease!important;
  -webkit-user-drag:none!important;
  user-drag:none!important;
}
.product-detail-media.np-gallery-switching img{opacity:.72!important}
.np-gallery-hint{
  position:absolute;
  left:50%;
  bottom:9px;
  transform:translateX(-50%);
  z-index:3;
  display:flex;
  align-items:center;
  gap:5px;
  padding:5px 9px;
  border-radius:999px;
  color:rgba(235,247,255,.82);
  background:rgba(2,9,17,.58);
  border:1px solid rgba(255,255,255,.08);
  font-size:.52rem;
  letter-spacing:.02em;
  pointer-events:none;
  backdrop-filter:blur(8px);
}
@media(max-width:620px){
  .np-video-controls{left:6px!important;right:6px!important;bottom:6px!important;gap:5px!important;padding:6px!important;border-radius:12px!important}
  .np-video-controls .np-video-control{flex-basis:30px!important;width:30px!important;height:30px!important;font-size:.7rem!important}
  .np-video-controls .np-video-time{font-size:.52rem!important}
  .np-video-controls .np-video-progress{min-width:34px!important;height:4px!important}
}
@media(max-width:390px){
  .np-video-controls{gap:4px!important;padding:5px!important}
  .np-video-controls .np-video-control{flex-basis:28px!important;width:28px!important;height:28px!important}
  .np-video-controls .np-video-time{font-size:.48rem!important}
}
`;
if(!document.getElementById('np-v93-style')){
  const style=document.createElement('style');
  style.id='np-v93-style';
  style.textContent=NP_V93_STYLE;
  document.head.appendChild(style);
}

function npBindDirectVideoControls(root){
  const video=root.querySelector('video');
  if(!video)return false;
  const stage=root.querySelector('.product-video-full-stage');
  const controls=root.querySelector('.np-video-controls');
  const play=root.querySelector('[data-video-play]');
  const center=root.querySelector('.np-video-center-play');
  const progress=root.querySelector('[data-video-progress]');
  const current=root.querySelector('[data-video-current]');
  const duration=root.querySelector('[data-video-duration]');
  const mute=root.querySelector('[data-video-mute]');
  const fullscreen=root.querySelector('[data-video-fullscreen]');
  let hideTimer=null;

  const clearHideTimer=()=>{if(hideTimer){clearTimeout(hideTimer);hideTimer=null}};
  const showControls=(schedule=true)=>{
    clearHideTimer();
    root.classList.remove('np-video-ui-hidden');
    if(schedule&&!video.paused&&!video.ended){
      hideTimer=setTimeout(()=>{
        if(!video.paused&&!video.ended)root.classList.add('np-video-ui-hidden');
      },1000);
    }
  };
  const hideControls=()=>{
    clearHideTimer();
    if(!video.paused&&!video.ended)root.classList.add('np-video-ui-hidden');
  };
  const syncVisuals=()=>{
    const playing=!video.paused&&!video.ended;
    if(play)play.textContent=playing?'❚❚':'▶';
    if(center){center.textContent=playing?'❚❚':'▶';center.classList.toggle('is-playing',playing)}
    if(current)current.textContent=npVideoTime(video.currentTime);
    if(duration)duration.textContent=npVideoTime(video.duration);
    if(progress)progress.value=video.duration?String((video.currentTime/video.duration)*100):'0';
    if(mute)mute.textContent=video.muted?'🔇':'🔊';
  };
  const togglePlayback=()=>{
    showControls(false);
    if(video.paused||video.ended)video.play().catch(()=>{});else video.pause();
  };

  if(play)play.onclick=e=>{e.stopPropagation();togglePlayback()};
  if(center)center.onclick=e=>{e.stopPropagation();togglePlayback()};
  if(progress){
    progress.onpointerdown=e=>{e.stopPropagation();showControls(false)};
    progress.onclick=e=>e.stopPropagation();
    progress.oninput=e=>{e.stopPropagation();showControls(false);if(video.duration)video.currentTime=(Number(progress.value)/100)*video.duration};
    progress.onchange=e=>{e.stopPropagation();showControls(true)};
  }
  if(mute)mute.onclick=e=>{e.stopPropagation();showControls(false);video.muted=!video.muted;syncVisuals();showControls(true)};
  if(fullscreen)fullscreen.onclick=async e=>{e.stopPropagation();showControls(false);try{if(document.fullscreenElement)await document.exitFullscreen();else if(stage?.requestFullscreen)await stage.requestFullscreen()}catch(error){};showControls(true)};
  if(controls)controls.addEventListener('click',e=>e.stopPropagation());

  /* Un toque en la superficie del video siempre recupera los controles. */
  if(stage)stage.addEventListener('click',e=>{
    if(e.target.closest('.np-video-controls,.np-video-center-play'))return;
    showControls(true);
  });

  video.addEventListener('loadedmetadata',()=>{syncVisuals();showControls(video.paused)});
  video.addEventListener('timeupdate',syncVisuals);
  video.addEventListener('play',()=>{syncVisuals();showControls(true)});
  video.addEventListener('pause',()=>{syncVisuals();showControls(false)});
  video.addEventListener('ended',()=>{syncVisuals();showControls(false)});
  video.addEventListener('seeking',()=>showControls(false));
  video.addEventListener('seeked',()=>showControls(true));
  syncVisuals();
  setTimeout(()=>video.play().catch(()=>{}),60);
  return true;
}

function npMakeMiniVideoDraggable(mini){
  if(!mini)return;
  let dragging=false,moved=false,pointerId=null,startX=0,startY=0,startLeft=0,startTop=0;
  const margin=8;
  const clampPosition=(left,top)=>{
    const rect=mini.getBoundingClientRect();
    const maxLeft=Math.max(margin,window.innerWidth-rect.width-margin);
    const maxTop=Math.max(margin,window.innerHeight-rect.height-margin);
    return {left:Math.min(Math.max(margin,left),maxLeft),top:Math.min(Math.max(margin,top),maxTop)};
  };
  const begin=e=>{
    if(e.button!==undefined&&e.button!==0)return;
    if(e.target.closest('.product-video-mini-close'))return;
    const rect=mini.getBoundingClientRect();
    pointerId=e.pointerId;
    startX=e.clientX;startY=e.clientY;startLeft=rect.left;startTop=rect.top;
    dragging=true;moved=false;
    mini.classList.add('np-dragging');
    mini.style.left=`${rect.left}px`;mini.style.top=`${rect.top}px`;mini.style.right='auto';mini.style.bottom='auto';
    try{mini.setPointerCapture(pointerId)}catch(error){}
  };
  const move=e=>{
    if(!dragging||e.pointerId!==pointerId)return;
    const dx=e.clientX-startX,dy=e.clientY-startY;
    if(Math.abs(dx)>4||Math.abs(dy)>4)moved=true;
    const pos=clampPosition(startLeft+dx,startTop+dy);
    mini.style.left=`${pos.left}px`;mini.style.top=`${pos.top}px`;
    if(e.cancelable)e.preventDefault();
  };
  const end=e=>{
    if(!dragging||e.pointerId!==pointerId)return;
    dragging=false;mini.classList.remove('np-dragging');
    try{mini.releasePointerCapture(pointerId)}catch(error){}
    setTimeout(()=>{moved=false},80);
  };
  mini.addEventListener('pointerdown',begin);
  mini.addEventListener('pointermove',move);
  mini.addEventListener('pointerup',end);
  mini.addEventListener('pointercancel',end);
  mini.addEventListener('click',e=>{if(moved){e.preventDefault();e.stopImmediatePropagation()}},true);
  const keepInside=()=>{
    const rect=mini.getBoundingClientRect();
    const pos=clampPosition(rect.left,rect.top);
    mini.style.left=`${pos.left}px`;mini.style.top=`${pos.top}px`;
  };
  window.addEventListener('resize',keepInside,{passive:true});
}

function createProductVideoMini(){
  removeProductVideoMini();
  if(!activeProductVideo||activeProductVideo.dismissed||!$('detailModal')?.classList.contains('open'))return;
  const product=state.products.find(item=>item.id===activeProductVideo.productId);
  const mini=document.createElement('aside');
  mini.id='productVideoMini';
  mini.className='product-video-mini';
  mini.setAttribute('aria-label','Vista rápida del producto');
  mini.innerHTML=`<div class="np-video-preview">${productVideoMediaMarkup(activeProductVideo.url)}${npWatermarkMarkup()}<button type="button" class="np-video-preview-play" aria-label="Ampliar presentación"><i>▶</i></button><div class="np-video-preview-copy"><span>Vista rápida</span><strong>${esc(product?.name||'Producto CRULOX')}</strong></div></div><button type="button" class="product-video-mini-close" aria-label="Cerrar presentación">✕</button>`;
  document.body.appendChild(mini);
  npMakeMiniVideoDraggable(mini);
  mini.querySelector('.np-video-preview-play').onclick=e=>{e.stopPropagation();openProductVideoFull()};
  mini.querySelector('.product-video-mini-close').onclick=e=>{e.stopPropagation();activeProductVideo.dismissed=true;removeProductVideoMini()};
}

function npBindDetailGallerySwipe(images){
  const media=$('detailBody')?.querySelector('.product-detail-media');
  const main=$('detailMainImage');
  if(!media||!main||!Array.isArray(images)||images.length<2)return;
  let index=0,startX=0,startY=0,tracking=false,pointerId=null;
  if(!media.querySelector('.np-gallery-hint')){
    const hint=document.createElement('span');hint.className='np-gallery-hint';hint.textContent='‹ Desliza ›';media.appendChild(hint);
  }
  const applyIndex=next=>{
    index=(next+images.length)%images.length;
    media.classList.add('np-gallery-switching');
    main.src=images[index];
    $('detailBody').querySelectorAll('[data-detail-image]').forEach((item,i)=>item.classList.toggle('active',i===index));
    setTimeout(()=>media.classList.remove('np-gallery-switching'),170);
  };
  $('detailBody').querySelectorAll('[data-detail-image]').forEach((button,i)=>button.onclick=()=>applyIndex(i));
  media.addEventListener('pointerdown',e=>{
    if(e.button!==undefined&&e.button!==0)return;
    pointerId=e.pointerId;startX=e.clientX;startY=e.clientY;tracking=true;
    try{media.setPointerCapture(pointerId)}catch(error){}
  });
  media.addEventListener('pointerup',e=>{
    if(!tracking||e.pointerId!==pointerId)return;
    tracking=false;
    const dx=e.clientX-startX,dy=e.clientY-startY;
    try{media.releasePointerCapture(pointerId)}catch(error){}
    if(Math.abs(dx)>=42&&Math.abs(dx)>Math.abs(dy)*1.15)applyIndex(index+(dx<0?1:-1));
  });
  media.addEventListener('pointercancel',()=>{tracking=false});
}

function openDetail(id){
  closeProductVideoExperience();
  const p=normalizeProductMediaRecord(state.products.find(x=>x.id===id));
  if(!p||!p.id)return;
  const images=(p.images||[]).filter(Boolean).slice(0,2);
  const [stock,stockClass]=stockInfo(p);
  const visual=productDetailVisualMetrics(p.id);
  const visualStyle=`--np-detail-aspect:${visual.ratio};--np-detail-max-width:${visual.maxWidth}px;--np-detail-object-fit:${visual.fit};--np-detail-object-position:${visual.position};--np-detail-transform:${visual.transform};`;
  $('detailBody').innerHTML=`<div class="product-detail"><div class="product-detail-gallery"><div class="product-detail-media" style="${esc(visualStyle)}"><img id="detailMainImage" src="${esc(images[0]||p.image)}" alt="${esc(p.name)}" loading="eager" decoding="async"/></div>${images.length>1?`<div class="product-detail-thumbs">${images.map((src,index)=>`<button type="button" class="product-detail-thumb ${index===0?'active':''}" data-detail-image="${index}" aria-label="Ver imagen ${index+1}"><img src="${esc(src)}" alt=""/></button>`).join('')}</div>`:''}</div><div class="product-detail-info"><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock stock-detail ${stockClass}">${stock}</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>${Number(p.stock)<=0?'No disponible':'Añadir al carrito'}</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;
  openModal('detailModal');
  npBindDetailGallerySwipe(images);
  if($('detailAdd'))$('detailAdd').onclick=()=>{if(Number(p.stock)<=0)return toast('Este producto no está disponible.','warn');addToCart(p.id);closeModal('detailModal')};
  $('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});
  $('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)};
  startProductVideoExperience(p);
}


/* ========================================================================
   v9.4 · Ajustes finales: marca de agua, FAQ y acceso admin local temporal
   ======================================================================== */
const NP_TEMP_ADMIN_KEY='jm_digital_v1_admin_auth';
const NP_TEMP_ADMIN_EMAIL='admin-separado@crulox.invalid';
const NP_TEMP_ADMIN_HASH='9c3b83eb1b39297606a1d599f17c6900f2e9f3df65fee429b5537edbaa91a52b';

/* Acceso administrativo temporal local para la fase de desarrollo. */
try{
  if(!localStorage.getItem(NP_TEMP_ADMIN_KEY)){
    localStorage.setItem(NP_TEMP_ADMIN_KEY,JSON.stringify({
      email:NP_TEMP_ADMIN_EMAIL,
      passwordHash:NP_TEMP_ADMIN_HASH,
      mode:'temporary-local',
      createdAt:new Date().toISOString()
    }));
  }
}catch(error){console.warn('Temporary admin storage unavailable',error)}

/* Restaurar el panel local únicamente para esta fase temporal. */
if(typeof npLegacyOpenAdmin==='function')openAdmin=npLegacyOpenAdmin;

const npPreviousHandleLogin=handleLogin;
handleLogin=async function(e){
  e.preventDefault();
  clearModalNotice?.('accountModal');
  const identity=$('loginIdentity')?.value.trim()||'';
  const pass=$('loginPassword')?.value||'';
  try{
    const temp=JSON.parse(localStorage.getItem(NP_TEMP_ADMIN_KEY)||'null');
    const hash=await sha256(pass);
    if(temp&&norm(identity)===norm(temp.email)&&hash===temp.passwordHash){
      state.session={role:'admin',email:temp.email,temporary:true,createdAt:new Date().toISOString()};
      write(KEYS.session,state.session);
      closeModal('accountModal');
      renderHeader();
      openAdmin('dashboard');
      logActivity('Inicio administrativo temporal',temp.email);
      return;
    }
  }catch(error){console.warn('Temporary admin login',error)}
  return npPreviousHandleLogin.call(this,e);
};

const NP_V94_STYLE=`
/* Marca de agua: discreta, limpia y fuera de los controles */
.np-video-watermark{
  right:16px!important;
  top:14px!important;
  bottom:auto!important;
  width:52px!important;
  max-width:12%!important;
  opacity:.18!important;
  filter:drop-shadow(0 2px 7px rgba(0,0,0,.55))!important;
  pointer-events:none!important;
}
.product-video-mini .np-video-watermark{
  right:10px!important;
  top:10px!important;
  bottom:auto!important;
  width:34px!important;
  max-width:16%!important;
  opacity:.20!important;
}
/* Espacio de respiración real al final de cada respuesta FAQ */
.faq.open .faq-a{padding-bottom:32px!important}
.faq-a::after{content:'';display:block;height:8px}
@media(max-width:620px){
  .np-video-watermark{right:11px!important;top:10px!important;width:44px!important;opacity:.17!important}
  .product-video-mini .np-video-watermark{right:8px!important;top:8px!important;width:30px!important;opacity:.19!important}
  .faq.open .faq-a{padding-bottom:30px!important}
}
`;
if(!document.getElementById('np-v94-style')){
  const style=document.createElement('style');style.id='np-v94-style';style.textContent=NP_V94_STYLE;document.head.appendChild(style);
}

/* Eliminar cualquier distintivo técnico antiguo si quedó guardado por caché. */
document.querySelectorAll('.np-security-status').forEach(node=>node.remove());

(()=>{
  /* V3.7.22 · Arranque fluido: la tienda visible tiene prioridad sobre tareas pesadas. */
  purgeUnavailableCart(false);
  renderStore();
  npHardenDynamicContent();

  const releaseLoader=()=>{
    const loader=$('loader');
    if(!loader)return;
    loader.classList.add('hide');
    loader.style.pointerEvents='none';
    setTimeout(()=>{try{loader.style.display='none'}catch(error){}},220);
  };
  requestAnimationFrame(()=>requestAnimationFrame(releaseLoader));

  const migrateLater=async()=>{
    try{
      const changed=await migrateHeavyStoredMedia();
      if(changed)requestAnimationFrame(()=>renderStore());
    }catch(error){console.warn('Media migration',error)}
  };
  if('requestIdleCallback' in window)requestIdleCallback(()=>migrateLater(),{timeout:1800});
  else setTimeout(migrateLater,900);
})();

window.addEventListener('pagehide',releaseTransientWebViewResources,{capture:true});
document.addEventListener('visibilitychange',()=>{
  if(!document.hidden)return;
  try{closeProductVideoExperience()}catch(error){}
  try{closeSuggestions()}catch(error){}
},{passive:true});



</script>

