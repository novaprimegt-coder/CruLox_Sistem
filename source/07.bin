  .np-dialog-summary{
    display:flex;align-items:flex-start;gap:10px;margin-bottom:13px;padding:11px 12px;border-radius:15px;
    background:rgba(255,255,255,.025);border:1px solid rgba(120,191,245,.08);color:#b7cae0;font-size:.66rem;line-height:1.55
  }
  .np-dialog-summary i{font-style:normal;color:#25ddff}
  body.np-dialog-open{overflow:hidden!important;touch-action:none}
  @media(max-width:560px){
    .np-dialog-layer{place-items:end center;padding:12px 10px max(10px,env(safe-area-inset-bottom))}
    .np-dialog-card{width:100%;border-radius:25px;max-height:88dvh}
    .np-dialog-head{padding:18px 16px 12px;gap:11px}
    .np-dialog-body{padding:2px 16px 16px;max-height:calc(88dvh - 145px)}
    .np-dialog-actions{padding:12px 16px 16px}
    .np-dialog-mark{width:40px;height:40px;flex-basis:40px}
    .np-dialog-title{font-size:1rem}
    .np-dialog-message{font-size:.72rem}
  }
  @media(prefers-reduced-motion:reduce){.np-dialog-layer,.np-dialog-card,.np-dialog-btn{transition:none!important}}
</style>
<script>
/* CRULOX branded dialog system — replaces every native prompt/confirm in admin flows. */
(function(){
  function dialogProfile(message,mode){
    const text=String(message||'').trim();
    const low=text.toLowerCase();
    const destructive=/(eliminar|borrar|vaciar|restaurar|quitar|desactivar|reducir|restar)/i.test(text);
    let icon=destructive?'⚠':'◆';
    let eyebrow=mode==='prompt'?'Edición administrativa':'Confirmación administrativa';
    let title=mode==='prompt'?'Completar información':'Confirmar acción';
    if(/nota interna/i.test(text)){icon='✎';title='Nota interna del cliente';eyebrow='Gestión de cliente'}
    else if(/etiqueta/i.test(text)){icon='🏷';title='Editar etiqueta';eyebrow='Organización'}
    else if(/existencias|stock/i.test(text)){icon='📦';title='Actualizar existencias';eyebrow='Inventario'}
    else if(/porcentaje|precios/i.test(text)){icon='Q';title='Ajuste de precios';eyebrow='Catálogo'}
    else if(/categoría/i.test(text)){icon='🏷';title='Gestión de categoría';eyebrow='Catálogo'}
    else if(/pedido/i.test(text) && destructive){icon='🧾';title='Eliminar pedido';eyebrow='Operación'}
    else if(/cuenta/i.test(text) && destructive){icon='👤';title='Eliminar cliente';eyebrow='Clientes'}
    else if(/código|promoc/i.test(text)){icon='🎟';title=destructive?'Desactivar promoción':'Gestionar promoción';eyebrow='Crecimiento'}
    else if(/notificaci/i.test(text) && destructive){icon='🗑';title=/todas|visibles/i.test(text)?'Eliminar notificaciones':'Eliminar notificación';eyebrow='Confirmación'}
    else if(/respaldo|restaurar/i.test(text)){icon='↺';title='Restauración de datos';eyebrow='Sistema'}
    const notificationDelete=/notificaci/i.test(text)&&destructive;
    return {text,low,destructive,icon,eyebrow,title,notificationDelete};
  }
  function makeDialog(opts){
    return new Promise(resolve=>{
      const previous=document.querySelector('.np-dialog-layer');
      if(previous) previous.remove();
      const profile=dialogProfile(opts.message,opts.mode);
      const layer=document.createElement('div');
      layer.className='np-dialog-layer';
      layer.setAttribute('role','presentation');
      const isTextarea=opts.mode==='prompt' && /(nota|descripción|detalle|observación)/i.test(profile.text);
      const isNumber=opts.mode==='prompt' && /(existencias|stock|porcentaje|unidades|límite)/i.test(profile.text);
      const fieldLabel=isNumber?'Valor':isTextarea?'Información':'Dato';
      const safeText=profile.text.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const inputHtml=opts.mode==='prompt' ? `<div class="np-dialog-field-wrap"><label class="np-dialog-label" for="npDialogValue">${fieldLabel}</label>${isTextarea?`<textarea class="np-dialog-textarea" id="npDialogValue" maxlength="1000"></textarea>`:`<input class="np-dialog-input" id="npDialogValue" ${isNumber?'inputmode="decimal" type="number"':'type="text"'} autocomplete="off" maxlength="160">`}<div class="np-dialog-hint">Revisa la información antes de guardar el cambio.</div><div class="np-dialog-error" id="npDialogError"></div></div>` : '';
      layer.innerHTML=`<section class="np-dialog-card" role="dialog" aria-modal="true" aria-labelledby="npDialogTitle">
        <header class="np-dialog-head"><div class="np-dialog-mark">${profile.icon}</div><div class="np-dialog-headcopy"><div class="np-dialog-eyebrow">${profile.eyebrow}</div><h2 class="np-dialog-title" id="npDialogTitle">${profile.title}</h2></div><button class="np-dialog-close" type="button" aria-label="Cerrar">×</button></header>
        <div class="np-dialog-body">${opts.mode==='confirm'?`<div class="np-dialog-summary"><i>●</i><span>${profile.notificationDelete?'Esta acción no se puede deshacer.':'Revisa la acción antes de continuar.'}</span></div>`:''}<p class="np-dialog-message">${safeText}</p>${inputHtml}</div>
        <footer class="np-dialog-actions"><button class="np-dialog-btn np-dialog-cancel" type="button">Cancelar</button><button class="np-dialog-btn np-dialog-confirm ${profile.destructive?'danger':''}" type="button">${profile.notificationDelete?'Eliminar':profile.destructive?'Confirmar':'Guardar / continuar'}</button></footer>
      </section>`;
      document.body.appendChild(layer);document.body.classList.add('np-dialog-open');
      const closeBtn=layer.querySelector('.np-dialog-close');
      const cancelBtn=layer.querySelector('.np-dialog-cancel');
      const confirmBtn=layer.querySelector('.np-dialog-confirm');
      const input=layer.querySelector('#npDialogValue');
      const error=layer.querySelector('#npDialogError');
      if(input){input.value=opts.defaultValue==null?'':String(opts.defaultValue)}
      let settled=false;
      function finish(value){if(settled)return;settled=true;layer.classList.remove('show');document.body.classList.remove('np-dialog-open');setTimeout(()=>layer.remove(),160);resolve(value)}
      function submit(){
        if(opts.mode==='confirm') return finish(true);
        const value=input?input.value:'';
        if(isNumber && value!=='' && !Number.isFinite(Number(value))){error.textContent='Ingresa un valor numérico válido.';error.classList.add('show');input.focus();return}
        finish(value);
      }
      closeBtn.onclick=()=>finish(opts.mode==='confirm'?false:null);
      cancelBtn.onclick=()=>finish(opts.mode==='confirm'?false:null);
      confirmBtn.onclick=submit;
      layer.addEventListener('mousedown',e=>{if(e.target===layer)finish(opts.mode==='confirm'?false:null)});
      layer.addEventListener('keydown',e=>{
        if(e.key==='Escape'){e.preventDefault();finish(opts.mode==='confirm'?false:null)}
        if(e.key==='Enter' && opts.mode==='confirm'){e.preventDefault();submit()}
        if(e.key==='Enter' && opts.mode==='prompt' && !isTextarea){e.preventDefault();submit()}
        if(e.key==='Enter' && opts.mode==='prompt' && isTextarea && (e.ctrlKey||e.metaKey)){e.preventDefault();submit()}
      });
      requestAnimationFrame(()=>{layer.classList.add('show');setTimeout(()=>input?.focus(),40)});
    });
  }
  window.npPrompt=function(message,defaultValue=''){return makeDialog({mode:'prompt',message,defaultValue})};
  window.npConfirm=function(message){return makeDialog({mode:'confirm',message})};
})();
</script>


<style id="np-v105-admin-style">
/* CRULOX v10.5 — panel compacto, equipo y seguimiento */
.admin-sidebar{height:auto!important;min-height:0!important;padding:8px 12px 10px!important;background:#05111d!important}
.admin-brand-row{padding:4px 4px 5px!important;min-height:0!important}.admin-brand{height:42px!important;width:190px!important}
.admin-nav{grid-template-columns:repeat(4,minmax(116px,1fr))!important;gap:7px!important;padding:5px 0 3px!important;margin:0!important;max-width:none!important;overflow-x:auto!important}
.admin-nav button{min-height:42px!important;border-radius:14px!important;padding:7px 9px!important;font-size:.57rem!important}
.admin-main{background:#020812!important}.admin-top{min-height:58px!important;margin:0!important}.admin-content{padding-top:14px!important;padding-bottom:46px!important}
.np-admin-breadcrumb{padding-top:8px!important}.np-admin-subnav-wrap{padding-top:6px!important;padding-bottom:8px!important}
