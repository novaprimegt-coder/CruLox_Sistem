="field full"><label>Imagen principal por URL o data URI</label><input id="pfImage" value="${esc(p.image)}" placeholder="Opcional si cargarás imágenes desde el dispositivo"/></div><div class="field full"><label>Cargar imágenes desde el dispositivo — máximo 2</label><input id="pfFiles" type="file" accept="image/*" multiple/><p class="product-upload-note">Selecciona una o dos imágenes. Si eliges archivos nuevos, reemplazarán las imágenes actuales del producto.</p><div class="product-media-preview" id="pfMediaPreview"></div></div><div class="field full"><label>Enlace del video emergente</label><input id="pfVideoUrl" value="${esc(p.videoUrl)}" placeholder="https://tu-reproductor.com/video"/><p class="product-upload-note">Acepta enlaces directos de video y enlaces de páginas o reproductores que permitan mostrarse dentro de la aplicación.</p></div><div class="field"><label>Etiqueta</label><input id="pfBadgeText" value="${esc(p.badgeText||'')}" placeholder="Nuevo, Oferta..."/></div><div class="field"><label>Destacado</label><select id="pfFeatured"><option value="false" ${!p.featured?'selected':''}>No</option><option value="true" ${p.featured?'selected':''}>Sí</option></select></div><div class="field full"><label>Descripción</label><textarea id="pfDescription" required>${esc(p.description)}</textarea></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Guardar producto</button></div></form>`;
}

function renderProductEditorPreview(images){
  const preview=$('pfMediaPreview');
  if(!preview)return;
  preview.innerHTML=(images||[]).slice(0,2).map((src,index)=>`<figure><img src="${esc(src)}" alt="Vista previa ${index+1}"/><figcaption>Imagen ${index+1}</figcaption></figure>`).join('');
}

function openProductEditor(id=null){
  const product=id?state.products.find(p=>p.id===id):null;
  const normalized=normalizeProductMediaRecord(product||{});
  $('crudTitle').textContent=product?'Editar producto':'Agregar producto';
  $('crudBody').innerHTML=productForm(product);
  openModal('crudModal');
  let selectedImages=[];
  renderProductEditorPreview(normalized.images);
  $('pfFiles').onchange=async e=>{
    const files=[...e.target.files];
    if(files.length>2){
      e.target.value='';
      selectedImages=[];
      renderProductEditorPreview(normalized.images);
      toast('Solo puedes subir un máximo de 2 imágenes por producto.','warn');
      return;
    }
    if(!files.length){selectedImages=[];renderProductEditorPreview(normalized.images);return}
    try{
      selectedImages=[];
      for(const file of files)selectedImages.push(await optimizeImageFile(file,{maxWidth:1200,maxHeight:900,quality:.86}));
      renderProductEditorPreview(selectedImages);
      if(selectedImages[0])$('pfImage').value=selectedImages[0];
    }catch(error){
      selectedImages=[];
      renderProductEditorPreview(normalized.images);
      toast('No fue posible procesar una de las imágenes.','error');
    }
  };
  $('productForm').onsubmit=e=>{
    e.preventDefault();
    const existingImages=normalized.images.slice(0,2);
    let images=selectedImages.length?selectedImages.slice(0,2):existingImages;
    const typedPrimary=$('pfImage').value.trim();
    if(!selectedImages.length&&typedPrimary){
      images=[typedPrimary,...existingImages.filter(src=>src!==typedPrimary)].slice(0,2);
    }
    images=[...new Set(images.filter(Boolean))].slice(0,2);
    if(!images.length){toast('Debes agregar al menos una imagen al producto.','warn');return}
    const videoUrl=normalizeProductVideoLink($('pfVideoUrl').value);
    if($('pfVideoUrl').value.trim()&&!videoUrl){toast('El enlace del video no es válido.','warn');return}
    const data={
      name:$('pfName').value.trim(),
      category:$('pfCategory').value.trim(),
      stock:Number($('pfStock').value),
      price:Number($('pfPrice').value),
      oldPrice:$('pfOldPrice').value?Number($('pfOldPrice').value):null,
      rating:Number($('pfRating').value||0),
      reviews:Number($('pfReviews').value||0),
      image:images[0],
      image2:images[1]||'',
      images,
      videoUrl,
      description:$('pfDescription').value.trim(),
      badgeText:$('pfBadgeText').value.trim()||null,
      badge:$('pfBadgeText').value.trim()?'custom':null,
      featured:$('pfFeatured').value==='true'
    };
    if(product)Object.assign(product,data);else state.products.unshift({id:uid('p'),...data});
    write(KEYS.products,state.products);
    logActivity(product?'Producto editado':'Producto agregado',data.name);
    closeModal('crudModal');
    renderStore();
    renderAdminSection('products');
    toast('Producto guardado.','success');
  };
}

function normalizeProductVideoLink(raw){
  let value=String(raw||'').trim();
  if(!value)return '';
  if(/^(?:javascript|vbscript):/i.test(value))return '';
  if(/^www\./i.test(value))value=`https://${value}`;
  if(/^data:/i.test(value)&&!/^data:video\//i.test(value))return '';
  return value;
}
function isDirectProductVideo(url){
  const value=String(url||'').toLowerCase();
  return /^data:video\//.test(value)||/^blob:/.test(value)||/\.(?:mp4|webm|ogg|ogv|mov|m4v|m3u8)(?:[?#].*)?$/.test(value);
}
function productVideoEmbedUrl(raw){
  const value=normalizeProductVideoLink(raw);
  if(!value)return '';
  try{
    const url=new URL(value,location.href);
    const host=url.hostname.replace(/^www\./,'').toLowerCase();
    if(host==='youtu.be'){
      const id=url.pathname.split('/').filter(Boolean)[0];
      if(id)return `https://www.youtube.com/embed/${encodeURIComponent(id)}`;
    }
    if(host.endsWith('youtube.com')){
      let id=url.searchParams.get('v');
      if(!id){const parts=url.pathname.split('/').filter(Boolean);const marker=parts.findIndex(part=>['shorts','embed','live'].includes(part));if(marker>=0)id=parts[marker+1]}
      if(id)return `https://www.youtube.com/embed/${encodeURIComponent(id)}`;
    }
    if(host==='vimeo.com'||host.endsWith('.vimeo.com')){
      const id=url.pathname.split('/').filter(Boolean).find(part=>/^\d+$/.test(part));
      if(id)return `https://player.vimeo.com/video/${id}`;
    }
  }catch(error){}
  return value;
}
function productVideoMediaMarkup(url,{full=false}={}){
  const clean=normalizeProductVideoLink(url);
  if(!clean)return '';
  if(isDirectProductVideo(clean))return `<video ${full?'autoplay':'autoplay muted loop'} playsinline preload="metadata" controlslist="nodownload noplaybackrate noremoteplayback" src="${esc(clean)}"></video>`;
  return `<iframe src="${esc(productVideoEmbedUrl(clean))}" title="Video del producto" loading="eager" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
}
function stopMediaInside(root){
  if(!root)return;
  root.querySelectorAll('video').forEach(video=>{try{video.pause();video.removeAttribute('src');video.load()}catch(error){}});
  root.querySelectorAll('iframe').forEach(frame=>{try{frame.src='about:blank'}catch(error){}});
}
let activeProductVideo=null;
function removeProductVideoMini(){const mini=$('productVideoMini');if(mini){stopMediaInside(mini);mini.remove()}}
function removeProductVideoFull(){const full=$('productVideoFull');if(full){stopMediaInside(full);full.remove()}}
function closeProductVideoExperience(){removeProductVideoMini();removeProductVideoFull();activeProductVideo=null}
function createProductVideoMini(){
  removeProductVideoMini();
  if(!activeProductVideo||activeProductVideo.dismissed||!$('detailModal')?.classList.contains('open'))return;
  const mini=document.createElement('aside');
  mini.id='productVideoMini';
  mini.className='product-video-mini';
  mini.setAttribute('aria-label','Video del producto');
  mini.innerHTML=`<div class="product-video-surface">${productVideoMediaMarkup(activeProductVideo.url)}</div><button type="button" class="product-video-expand-hit" aria-label="Ver video en pantalla completa">Toca para ampliar</button><button type="button" class="product-video-mini-close" aria-label="Cerrar video">✕</button>`;
  document.body.appendChild(mini);
  mini.querySelector('.product-video-expand-hit').onclick=()=>openProductVideoFull();
  mini.querySelector('.product-video-mini-close').onclick=e=>{e.stopPropagation();activeProductVideo.dismissed=true;removeProductVideoMini()};
}
function openProductVideoFull(){
  if(!activeProductVideo)return;
  removeProductVideoMini();
  removeProductVideoFull();
  const full=document.createElement('section');
  full.id='productVideoFull';
  full.className='product-video-full';
  full.setAttribute('role','dialog');
  full.setAttribute('aria-modal','true');
  full.setAttribute('aria-label','Video del producto en pantalla completa');
  full.innerHTML=`<div class="product-video-full-stage">${productVideoMediaMarkup(activeProductVideo.url,{full:true})}</div><button type="button" class="product-video-full-close" aria-label="Salir del video">✕</button><a class="product-video-fallback" href="${esc(activeProductVideo.url)}" target="_blank" rel="noopener">Abrir reproductor</a>`;
  document.body.appendChild(full);
  full.querySelector('.product-video-full-close').onclick=()=>closeProductVideoFull();
  full.onclick=e=>{if(e.target===full)closeProductVideoFull()};
}
function closeProductVideoFull(){
  removeProductVideoFull();
  if(activeProductVideo&&!activeProductVideo.dismissed&&$('detailModal')?.classList.contains('open'))createProductVideoMini();
}
function startProductVideoExperience(product){
  closeProductVideoExperience();
  const url=normalizeProductVideoLink(product?.videoUrl);
  if(!url)return;
  activeProductVideo={productId:product.id,url,dismissed:false};
  requestAnimationFrame(()=>createProductVideoMini());
}

function openDetail(id){
  closeProductVideoExperience();
  const p=normalizeProductMediaRecord(state.products.find(x=>x.id===id));
  if(!p||!p.id)return;
  const images=(p.images||[]).filter(Boolean).slice(0,2);
  const [stock,stockClass]=stockInfo(p);
  $('detailBody').innerHTML=`<div class="product-detail"><div class="product-detail-gallery"><div class="product-detail-media"><img id="detailMainImage" src="${esc(images[0]||p.image)}" alt="${esc(p.name)}" loading="eager" decoding="async"/></div>${images.length>1?`<div class="product-detail-thumbs">${images.map((src,index)=>`<button type="button" class="product-detail-thumb ${index===0?'active':''}" data-detail-image="${index}" aria-label="Ver imagen ${index+1}"><img src="${esc(src)}" alt=""/></button>`).join('')}</div>`:''}</div><div class="product-detail-info"><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock stock-detail ${stockClass}">${stock}</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>Añadir al carrito</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;
  openModal('detailModal');
  $('detailBody').querySelectorAll('[data-detail-image]').forEach(button=>button.onclick=()=>{
    const index=Number(button.dataset.detailImage||0);
    $('detailMainImage').src=images[index]||images[0];
    $('detailBody').querySelectorAll('[data-detail-image]').forEach(item=>item.classList.toggle('active',item===button));
  });
  $('detailAdd').onclick=()=>{addToCart(p.id);closeModal('detailModal')};
  $('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});
  $('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)};
  startProductVideoExperience(p);
}

const closeModalV818Base=closeModal;
closeModal=function(id){
  if(id==='detailModal')closeProductVideoExperience();
  return closeModalV818Base(id);
};
const releaseTransientWebViewResourcesV818Base=releaseTransientWebViewResources;
releaseTransientWebViewResources=function(){
  closeProductVideoExperience();
  return releaseTransientWebViewResourcesV818Base();
};
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&$('productVideoFull')){
    e.preventDefault();
    e.stopImmediatePropagation();
    closeProductVideoFull();
  }
},true);


/* v8.20: visual estable, validación visible, mantenimiento y stock automático */
const NP_V820_STYLE=`
.toastbox{
  z-index:7200!important;
  top:max(12px,env(safe-area-inset-top))!important;
  left:50%!important;
  right:auto!important;
  transform:translateX(-50%)!important;
  width:min(390px,calc(100% - 24px))!important;
}
.modal-inline-notice{
  position:sticky;
  top:0;
  z-index:16;
  display:flex;
  align-items:flex-start;
  gap:9px;
  margin:0 0 12px;
  padding:10px 12px;
  border-radius:13px;
  border:1px solid rgba(255,94,120,.30);
  border-left:4px solid var(--red);
  background:rgba(44,13,25,.97);
  color:#ffe7ed;
  box-shadow:0 14px 34px rgba(0,0,0,.30);
  font-size:.7rem;
  line-height:1.45;
}
.modal-inline-notice.success{
  border-color:rgba(33,215,122,.30);
  border-left-color:var(--green);
  background:rgba(8,42,29,.97);
  color:#ddffed;
}
.modal-inline-notice.warn{
  border-color:rgba(255,196,77,.32);
  border-left-color:var(--amber);
  background:rgba(48,36,10,.97);
  color:#fff1c7;
}
.field input.input-error,.field select.input-error,.field textarea.input-error{
  border-color:rgba(255,94,120,.72)!important;
  box-shadow:0 0 0 3px rgba(255,94,120,.10)!important;
}
.password-input-wrap{
  position:relative;
  display:flex;
  align-items:center;
}
.password-input-wrap input{padding-right:48px!important}
.password-toggle{
  position:absolute;
  right:6px;
  top:50%;
  transform:translateY(-50%);
  width:36px;
  height:34px;
  border:0;
  border-radius:10px;
  background:rgba(255,255,255,.055);
  color:var(--sub);
  display:grid;
  place-items:center;
  font-size:.86rem;
}
.password-toggle.active{color:var(--cyan);background:rgba(0,217,255,.10)}
button.social-pill{font:inherit;background:rgba(255,255,255,.028);cursor:pointer}
.product-detail-gallery{
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  min-width:0!important;
}
.product-detail-media{
  width:min(100%,var(--np-detail-max-width,440px))!important;
  aspect-ratio:var(--np-detail-aspect,4 / 3)!important;
  height:auto!important;
  max-height:none!important;
  overflow:hidden!important;
  border-radius:18px!important;
  background:#08101d!important;
  border:1px solid rgba(255,255,255,.06)!important;
}
.product-detail-media img{
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  padding:0!important;
  margin:0!important;
  border-radius:0!important;
  object-fit:var(--np-detail-object-fit,cover)!important;
  object-position:var(--np-detail-object-position,center 38%)!important;
  transform:var(--np-detail-transform,scale(1.12))!important;
  transform-origin:center!important;
}
.product .add:disabled,
.product-detail .btn:disabled{
  opacity:.48!important;
  cursor:not-allowed!important;
  filter:grayscale(.28)!important;
}
@media(max-width:560px){
  .toastbox{top:max(8px,env(safe-area-inset-top))!important}
  .modal-inline-notice{font-size:.67rem}
}
`;
if(!document.getElementById('np-v820-style')){
  const style=document.createElement('style');
  style.id='np-v820-style';
  style.textContent=NP_V820_STYLE;
  document.head.appendChild(style);
}

function toast(message,type='info'){
  const box=$('toastbox');
  if(!box)return null;
  const text=String(message||'').trim();
  const existing=[...box.querySelectorAll('.toast')].find(el=>el.dataset.message===text);
  if(existing){
    clearTimeout(existing._removeTimer);
    existing._removeTimer=setTimeout(()=>existing.remove(),3600);
    return existing;
  }
  const el=document.createElement('div');
  el.className=`toast ${type}`;
  el.dataset.message=text;
  el.textContent=text;
  box.appendChild(el);
  el._removeTimer=setTimeout(()=>el.remove(),3600);
  return el;
}
function showModalNotice(message,type='error',modalId='accountModal'){
  const modal=$(modalId)?.querySelector('.modal');
  if(!modal)return toast(message,type);
  modal.querySelector('.modal-inline-notice')?.remove();
  const notice=document.createElement('div');
  notice.className=`modal-inline-notice ${type}`;
  notice.innerHTML=`<span>${type==='success'?'✓':type==='warn'?'⚠':'!'}</span><span>${esc(message)}</span>`;
  const head=modal.querySelector('.modal-head');
  head?.insertAdjacentElement('afterend',notice);
  clearTimeout(modal._noticeTimer);
  modal._noticeTimer=setTimeout(()=>notice.remove(),5200);
  return notice;
}
function clearModalNotice(modalId='accountModal'){$(modalId)?.querySelector('.modal-inline-notice')?.remove()}
function focusInvalid(input,message,modalId='accountModal'){
  if(input){
    input.classList.add('input-error');
    input.addEventListener('input',()=>input.classList.remove('input-error'),{once:true});
    input.focus({preventScroll:true});
    input.scrollIntoView({behavior:'smooth',block:'center'});
  }
  showModalNotice(message,'error',modalId);
  return false;
}
function passwordFieldMarkup(id,label,autocomplete='new-password',required=true){
  return `<div class="field"><label>${esc(label)}</label><div class="password-input-wrap"><input id="${esc(id)}" type="password" minlength="8" ${required?'required':''} autocomplete="${esc(autocomplete)}"/><button class="password-toggle" type="button" data-password-toggle="${esc(id)}" aria-label="Mostrar contraseña">👁</button></div></div>`;
}
function bindPasswordToggles(root=document){
  root.querySelectorAll('[data-password-toggle]').forEach(button=>{
    button.onclick=()=>{
      const input=$(button.dataset.passwordToggle);
      if(!input)return;
      const visible=input.type==='text';
      input.type=visible?'password':'text';
      button.classList.toggle('active',!visible);
      button.textContent=visible?'👁':'🙈';
      button.setAttribute('aria-label',visible?'Mostrar contraseña':'Ocultar contraseña');
    };
  });
}
function accountValidation(prefix){
  const data=collectAccount(prefix);
  const labels={fullName:'nombre completo',username:'usuario',email:'correo electrónico',phone:'teléfono',department:'departamento',municipality:'municipio',address:'dirección completa',reference:'referencia de entrega'};
  for(const field of accountFields()){
    const input=$(`${prefix}${field.key.charAt(0).toUpperCase()+field.key.slice(1)}`);
    if(!data[field.key])return {ok:false,input,message:`Completa el campo ${labels[field.key]}.`};
  }
  if(data.fullName.length<3)return {ok:false,input:$(`${prefix}FullName`),message:'Escribe un nombre completo válido.'};
  if(data.username.length<3)return {ok:false,input:$(`${prefix}Username`),message:'El usuario debe tener al menos 3 caracteres.'};
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email))return {ok:false,input:$(`${prefix}Email`),message:'Escribe un correo electrónico válido.'};
  const digits=data.phone.replace(/\D/g,'');
  if(digits.length<8||digits.length>15)return {ok:false,input:$(`${prefix}Phone`),message:'Escribe un número de teléfono válido.'};
  return {ok:true,data};
}
function renderLogin(){
  $('authContent').innerHTML=`<form id="loginForm" novalidate><div class="form-grid"><div class="field full"><label>Usuario o correo</label><input id="loginIdentity" required autocomplete="username"/></div><div class="field full"><label>Contraseña</label><div class="password-input-wrap"><input id="loginPassword" type="password" required autocomplete="current-password"/><button class="password-toggle" type="button" data-password-toggle="loginPassword" aria-label="Mostrar contraseña">👁</button></div></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Acceder</button></div></form>`;
  bindPasswordToggles($('authContent'));
  $('loginForm').onsubmit=handleLogin;
}
function renderRegister(){
  $('authContent').innerHTML=`<form id="registerForm" novalidate><div class="form-grid">${accountFields().map(f=>fieldHtml(f,'reg')).join('')}${passwordFieldMarkup('regPassword','Contraseña','new-password',true)}${passwordFieldMarkup('regConfirm','Confirmar contraseña','new-password',true)}<div class="field full"><label><input id="regConsent" type="checkbox" style="width:auto;min-height:0"/> Acepto que mis datos se utilicen para gestionar pedidos y entregas.</label></div></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Crear cuenta</button></div></form>`;
  bindPasswordToggles($('authContent'));
  $('registerForm').onsubmit=handleRegister;
}
async function handleRegister(e){
  e.preventDefault();clearModalNotice();
  const check=accountValidation('reg');
  if(!check.ok)return focusInvalid(check.input,check.message);
  const password=$('regPassword').value;
  const confirmPassword=$('regConfirm').value;
  if(password.length<8)return focusInvalid($('regPassword'),'La contraseña debe tener al menos 8 caracteres.');
  if(password!==confirmPassword)return focusInvalid($('regConfirm'),'Las contraseñas no coinciden.');
  if(!$('regConsent').checked)return focusInvalid($('regConsent'),'Debes aceptar el uso de tus datos para gestionar pedidos y entregas.');
  if(state.users.some(u=>norm(u.username)===norm(check.data.username)||norm(u.email)===norm(check.data.email)))return focusInvalid($('regUsername'),'El usuario o correo ya está registrado.');
  const user={id:uid('usr'),...check.data,passwordHash:await sha256(password),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
  state.users.push(user);state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};
  write(KEYS.users,state.users);write(KEYS.session,state.session);logActivity('Cliente registrado',user.email);renderHeader();renderAccount();toast('Cuenta creada correctamente.','success');
}
async function handleLogin(e){
  e.preventDefault();clearModalNotice();
  const identity=$('loginIdentity').value.trim();
  const pass=$('loginPassword').value;
  if(!identity)return focusInvalid($('loginIdentity'),'Escribe tu usuario o correo electrónico.');
  if(!pass)return focusInvalid($('loginPassword'),'Escribe tu contraseña.');
  const hash=await sha256(pass);
  if(norm(identity)===norm(ADMIN_EMAIL)&&hash===ADMIN_PASSWORD_HASH){state.session={role:'admin',email:ADMIN_EMAIL,createdAt:new Date().toISOString()};write(KEYS.session,state.session);closeModal('accountModal');openAdmin('dashboard');logActivity('Inicio administrativo',ADMIN_EMAIL);return}
  const user=state.users.find(u=>norm(u.username)===norm(identity)||norm(u.email)===norm(identity));
  if(!user||user.passwordHash!==hash)return focusInvalid($('loginPassword'),'El usuario, correo o contraseña no es correcto.');
  state.session={role:'client',userId:user.id,createdAt:new Date().toISOString()};write(KEYS.session,state.session);renderHeader();renderAccount();toast('Sesión iniciada.','success');
}
function renderProfileEditor(user){
  $('accountBody').innerHTML=`<form id="profileForm" novalidate><div class="form-grid">${accountFields().map(f=>fieldHtml(f,'edit',user[f.key])).join('')}${passwordFieldMarkup('editPassword','Nueva contraseña (opcional)','new-password',false)}${passwordFieldMarkup('editConfirm','Confirmar contraseña','new-password',false)}</div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar cambios</button><button class="btn btn-secondary" type="button" id="cancelEditProfile">Cancelar</button></div></form>`;
  bindPasswordToggles($('accountBody'));
  $('cancelEditProfile').onclick=renderAccount;
  $('profileForm').onsubmit=async e=>{
    e.preventDefault();clearModalNotice();
    const check=accountValidation('edit');
    if(!check.ok)return focusInvalid(check.input,check.message);
    if(state.users.some(u=>u.id!==user.id&&(norm(u.username)===norm(check.data.username)||norm(u.email)===norm(check.data.email))))return focusInvalid($('editUsername'),'El usuario o correo ya está utilizado.');
    const pass=$('editPassword').value;
    const confirmPass=$('editConfirm').value;
    if(pass&&pass.length<8)return focusInvalid($('editPassword'),'La nueva contraseña debe tener al menos 8 caracteres.');
    if((pass||confirmPass)&&pass!==confirmPass)return focusInvalid($('editConfirm'),'Las contraseñas no coinciden.');
    Object.assign(user,check.data,{updatedAt:new Date().toISOString()});
    if(pass)user.passwordHash=await sha256(pass);
    write(KEYS.users,state.users);renderAccount();renderHeader();toast('Perfil actualizado.','success');
  };
}
function maintenanceNotice(){return toast('Esta función está en mantenimiento.','warn')}
function renderSocials(){
  const markup=socialItems().map(item=>{
    const url=String(state.settings[item.key]||'#').trim();
    if(item.key==='supportBotUrl')return `<button type="button" class="social-pill" data-social-support>${esc(item.label)}</button>`;
    if(!url||url==='#')return `<button type="button" class="social-pill" data-social-maintenance>${esc(item.label)}</button>`;
    return `<a class="social-pill" href="${esc(url)}" target="_blank" rel="noopener">${esc(item.label)}</a>`;
  }).join('');
  ['footerSocial','drawerSocial'].forEach(id=>{const root=$(id);if(!root)return;root.innerHTML=markup;root.querySelectorAll('[data-social-support]').forEach(button=>button.onclick=()=>openBot('support','Hola. Necesito ayuda con CRULOX.',{Tipo:'Consulta general'}));root.querySelectorAll('[data-social-maintenance]').forEach(button=>button.onclick=maintenanceNotice)});
}
function openBot(kind,message,extra={}){
  const url=buildBotUrl(kind,message,extra);
  if(!url){maintenanceNotice();return false}
  try{
    const w=window.open(url,'_blank');
    if(w){try{w.opener=null}catch(error){};return true}
    location.assign(url);return true;
  }catch(error){console.warn('External function',error);maintenanceNotice();return false}
}
function stockInfo(p){
  const n=Number(p?.stock||0);
  return n<=0?['No disponible','out']:n<=Number(state.settings.lowStock||5)?['Pocas unidades','low']:['Disponible',''];
}
function purgeUnavailableCart(notify=false){
  let changed=false;
  let removed=0;
  const cleaned=[];
  for(const item of state.cart||[]){
    const type=item.type||'product';
    if(type==='combo'){cleaned.push(item);continue}
    const product=state.products.find(p=>p.id===item.id);
    const stock=Number(product?.stock||0);
    if(!product||stock<=0){changed=true;removed++;continue}
    const qty=Math.max(1,Math.min(Number(item.qty||1),stock));
    if(qty!==Number(item.qty||1))changed=true;
    cleaned.push({...item,type:'product',qty});
  }
  if(changed){state.cart=cleaned;write(KEYS.cart,state.cart)}
  if(notify&&removed>0)toast(removed===1?'Se eliminó del carrito un producto que ya no está disponible.':`Se eliminaron ${removed} productos que ya no están disponibles.`,'warn');
  return removed;
}
function addToCart(id,qty=1){
  const p=state.products.find(x=>x.id===id);
  if(!p||Number(p.stock)<=0){purgeUnavailableCart(true);renderHeader();renderCart();return toast('Este producto no está disponible.','warn')}
  const item=state.cart.find(x=>(x.type||'product')==='product'&&x.id===id);
  const current=item?Number(item.qty||0):0;
  const next=Math.min(current+Number(qty||1),Number(p.stock));
  if(item)item.qty=next;else state.cart.push({type:'product',id:p.id,qty:Math.min(Number(qty||1),Number(p.stock))});
  write(KEYS.cart,state.cart);renderHeader();renderCart();toast(`${p.name} añadido al carrito.`,'success');
}
function changeQty(key,delta){
  const {type,id}=parseCartKey(key);
  const item=state.cart.find(x=>(x.type||'product')===type&&x.id===id);
  if(!item)return;
  if(type==='combo')item.qty=Math.max(0,Math.min(Number(item.qty||0)+delta,99));
  else{
    const p=state.products.find(x=>x.id===id);
    if(!p||Number(p.stock)<=0){purgeUnavailableCart(true);renderHeader();renderCart();return}
    item.qty=Math.max(0,Math.min(Number(item.qty||0)+delta,Number(p.stock)));
  }
  if(item.qty===0)state.cart=state.cart.filter(x=>!((x.type||'product')===type&&x.id===id));
  write(KEYS.cart,state.cart);renderHeader();renderCart();
}
function cartDetails(){
  return (state.cart||[]).map(item=>{
    const type=item.type||'product';
    const data=cartEntity(type,item.id);
    if(!data)return null;
    if(type==='product'&&Number(data.stock||0)<=0)return null;
    return {...data,qty:Number(item.qty||1)};
  }).filter(Boolean);
}
function renderCart(){
  purgeUnavailableCart(true);
  const items=cartDetails();
  $('cartItems').innerHTML=items.length?items.map(i=>{const key=cartKey(i);const sub=i.type==='combo'?'Combo personalizado':stockInfo(i)[0];return `<article class="list-card"><img src="${esc(i.image)}" alt="${esc(i.name)}"/><div><h3>${esc(i.name)}</h3><p>${money(i.price)} · ${esc(sub)}</p><div class="list-actions"><div class="qty"><button data-dec="${esc(key)}">−</button><span>${i.qty}</span><button data-inc="${esc(key)}">＋</button></div><button class="btn btn-red btn-sm" data-remove-cart="${esc(key)}">Eliminar</button></div></div><strong>${money(i.price*i.qty)}</strong></article>`}).join(''):'<div class="empty">Tu carrito está vacío.</div>';
  const subtotal=items.reduce((s,i)=>s+Number(i.price||0)*Number(i.qty||0),0);
  const promoResult=currentPromoResult(subtotal);
  const discount=promoResult?.discount||0;
  const total=Math.max(0,subtotal-discount);
  if($('cartSubtotal'))$('cartSubtotal').textContent=money(subtotal);
  if($('cartDiscount'))$('cartDiscount').textContent=`-${money(discount)}`;
  if($('cartDiscountRow'))$('cartDiscountRow').hidden=!promoResult;
  $('cartTotal').textContent=money(total);
  const input=$('promoCodeInput');if(input)input.value=state.appliedPromoCode||'';
  const message=$('promoMessage');if(message){if(promoResult){message.textContent=promoResult.message;message.className='promo-feedback success'}else{message.textContent='Los códigos activos se aplican antes de enviar el pedido.';message.className='promo-feedback'}}
  const applyBtn=$('promoApplyBtn');if(applyBtn)applyBtn.onclick=applyPromoFromCart;
  if(input)input.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();applyPromoFromCart()}};
  $('cartItems').querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>changeQty(b.dataset.inc,1));
  $('cartItems').querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>changeQty(b.dataset.dec,-1));
  $('cartItems').querySelectorAll('[data-remove-cart]').forEach(b=>b.onclick=()=>removeCart(b.dataset.removeCart));
}
function productDetailVisualMetrics(id){
  const card=[...document.querySelectorAll('[data-product]')].find(el=>el.dataset.product===String(id));
  const media=card?.querySelector('.product-image');
  const image=media?.querySelector('img');
  const rect=media?.getBoundingClientRect();
  const style=image?getComputedStyle(image):null;
  const ratio=rect?.width&&rect?.height?Math.max(.65,Math.min(1.8,rect.width/rect.height)):4/3;
  const width=rect?.width||300;
  return {ratio,maxWidth:Math.min(520,Math.max(320,width*1.28)),fit:style?.objectFit||'cover',position:style?.objectPosition||'center 38%',transform:style?.transform&&style.transform!=='none'?style.transform:'scale(1.12)'};
}
function openDetail(id){
  closeProductVideoExperience();
  const p=normalizeProductMediaRecord(state.products.find(x=>x.id===id));
  if(!p||!p.id)return;
  const images=(p.images||[]).filter(Boolean).slice(0,2);
  const [stock,stockClass]=stockInfo(p);
  const visual=productDetailVisualMetrics(p.id);
  const visualStyle=`--np-detail-aspect:${visual.ratio};--np-detail-max-width:${visual.maxWidth}px;--np-detail-object-fit:${visual.fit};--np-detail-object-position:${visual.position};--np-detail-transform:${visual.transform};`;
  $('detailBody').innerHTML=`<div class="product-detail"><div class="product-detail-gallery"><div class="product-detail-media" style="${esc(visualStyle)}"><img id="detailMainImage" src="${esc(images[0]||p.image)}" alt="${esc(p.name)}" loading="eager" decoding="async"/></div>${images.length>1?`<div class="product-detail-thumbs">${images.map((src,index)=>`<button type="button" class="product-detail-thumb ${index===0?'active':''}" data-detail-image="${index}" aria-label="Ver imagen ${index+1}"><img src="${esc(src)}" alt=""/></button>`).join('')}</div>`:''}</div><div class="product-detail-info"><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${Number(p.rating||0).toFixed(1)} <span>(${Number(p.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money(p.price)}</strong>${p.oldPrice?`<span class="old">${money(p.oldPrice)}</span>`:''}</div><p>${esc(p.description)}</p><p class="stock stock-detail ${stockClass}">${stock}</p><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${Number(p.stock)<=0?'disabled':''}>${Number(p.stock)<=0?'No disponible':'Añadir al carrito'}</button><button class="btn btn-green" id="detailSupport">WhatsApp</button><button class="btn btn-secondary" id="detailFav">${state.favorites.includes(p.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;
  openModal('detailModal');
  $('detailBody').querySelectorAll('[data-detail-image]').forEach(button=>button.onclick=()=>{
    const index=Number(button.dataset.detailImage||0);
    $('detailMainImage').src=images[index]||images[0];
    $('detailBody').querySelectorAll('[data-detail-image]').forEach(item=>item.classList.toggle('active',item===button));
  });
  if($('detailAdd'))$('detailAdd').onclick=()=>{if(Number(p.stock)<=0)return toast('Este producto no está disponible.','warn');addToCart(p.id);closeModal('detailModal')};
  $('detailSupport').onclick=()=>openBot('support',`Hola. Necesito información sobre ${p.name}.`,{Producto:p.name,Tipo:'Consulta'});
  $('detailFav').onclick=()=>{toggleFavorite(p.id);openDetail(p.id)};
  startProductVideoExperience(p);
}
function adminInventory(){
  $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0"><div class="admin-card-head"><h2>Control de inventario</h2><div class="toolbar"><input id="inventorySearch" placeholder="Buscar"/><select id="inventoryFilter"><option value="all">Todos</option><option value="low">Pocas unidades</option><option value="out">No disponibles</option></select></div></div><div class="admin-list" id="inventoryList"></div></section>`;
  const render=()=>{
    const q=norm($('inventorySearch').value),filter=$('inventoryFilter').value;
    const list=state.products.filter(p=>(!q||norm(p.name).includes(q))&&(filter==='all'||filter==='low'&&(p.stock>0&&p.stock<=state.settings.lowStock)||filter==='out'&&p.stock<=0));
    $('inventoryList').innerHTML=list.map(p=>{const [label,statusClass]=stockInfo(p);return `<article class="admin-list-item"><div><h3>${esc(p.name)}</h3><p>${esc(p.category)} · ${money(p.price)}</p></div><div class="toolbar"><button class="btn btn-secondary btn-sm" data-stock="${p.id}" data-delta="-1">−1</button><span class="status ${statusClass==='out'?'bad':statusClass==='low'?'warn':''}">${p.stock} · ${esc(label)}</span><button class="btn btn-primary btn-sm" data-stock="${p.id}" data-delta="1">+1</button><button class="btn btn-secondary btn-sm" data-set-stock="${p.id}">Definir</button></div></article>`}).join('')||'<div class="empty">No hay productos en este filtro.</div>';
    $('inventoryList').querySelectorAll('[data-stock]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.stock);p.stock=Math.max(0,Number(p.stock||0)+Number(b.dataset.delta));write(KEYS.products,state.products);purgeUnavailableCart(true);render();renderStore()});
    $('inventoryList').querySelectorAll('[data-set-stock]').forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>x.id===b.dataset.setStock);const n=await npPrompt(`Existencias para ${p.name}`,p.stock);if(n===null||isNaN(Number(n)))return;p.stock=Math.max(0,Number(n));write(KEYS.products,state.products);purgeUnavailableCart(true);render();renderStore()});
  };
  render();$('inventorySearch').oninput=render;$('inventoryFilter').onchange=render;
}
const openCheckoutV820Base=openCheckout;
openCheckout=function(){purgeUnavailableCart(true);renderHeader();renderCart();return openCheckoutV820Base()};
if($('checkoutBtn'))$('checkoutBtn').onclick=openCheckout;
const renderStoreV820Base=renderStore;
renderStore=function(){purgeUnavailableCart(false);return renderStoreV820Base()};
purgeUnavailableCart(false);

/* v8.21: moneda oficial de Guatemala */
state.settings.currency='Q';
write(KEYS.settings,state.settings);


