.np-v105-page{display:grid;gap:15px}.np-v105-pagehead{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:4px 2px 8px;border-bottom:1px solid rgba(126,194,255,.08)}.np-v105-pagehead h2{font-size:1rem;margin:0;color:#eff8ff}.np-v105-pagehead p{font-size:.61rem;color:#7892ac;line-height:1.55;margin-top:4px}.np-v105-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.np-v105-kpis>div{padding:12px 13px;border-radius:15px;background:#071522;border:1px solid rgba(126,194,255,.08)}.np-v105-kpis small{display:block;color:#7893ac;font-size:.52rem}.np-v105-kpis b{display:block;color:#1ad8ff;font-size:1.15rem;margin-top:4px}.np-v105-agent-list{display:grid;gap:9px}.np-v105-agent-card{display:grid;grid-template-columns:44px minmax(0,1fr);gap:11px;padding:13px;border-radius:17px;background:#071522;border:1px solid rgba(126,194,255,.08)}.np-v105-agent-avatar{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(0,216,255,.18),rgba(65,104,255,.17));border:1px solid rgba(0,216,255,.18);font-weight:900;color:#23dcff}.np-v105-agent-main{min-width:0}.np-v105-agent-head{display:flex;justify-content:space-between;gap:10px}.np-v105-agent-head h3{font-size:.72rem}.np-v105-agent-head p,.np-v105-agent-meta{font-size:.52rem;color:#7892ac}.np-v105-agent-meta{display:flex;flex-wrap:wrap;gap:6px 12px;margin-top:7px}.np-v105-agent-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.np-v105-agent-actions button,.np-v105-assignment button,.np-v105-quick button{border:1px solid rgba(126,194,255,.1);background:#0a1a2a;color:#c5d8e9;border-radius:10px;padding:7px 9px;font-size:.52rem;font-weight:800}.np-v105-agent-actions .danger{color:#ff6c86;background:rgba(255,94,120,.07)}.np-v105-agent-actions .warn{color:#ffc95c}.np-v105-agent-actions .success{color:#3ee98f}.np-v105-pill{font-size:.48rem;padding:5px 8px;border-radius:999px;font-weight:850}.np-v105-pill.on{background:rgba(32,224,132,.09);color:#42e99a}.np-v105-pill.off{background:rgba(255,94,120,.09);color:#ff7590}.np-v105-note{margin-top:10px;padding:10px 12px;border-radius:12px;background:rgba(255,192,64,.055);border:1px solid rgba(255,192,64,.12);color:#bcae84;font-size:.53rem;line-height:1.55}.np-v105-pass{display:grid;grid-template-columns:1fr auto;gap:6px}.np-v105-pass button{border:1px solid rgba(126,194,255,.09);background:#0a1a2a;color:#a9c2d9;border-radius:10px;padding:0 12px}.np-v105-perm-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.np-v105-perm-groups label{display:flex;align-items:center;gap:8px;padding:10px;border-radius:12px;background:#071522;border:1px solid rgba(126,194,255,.07);font-size:.57rem}.np-v105-perm-search{display:flex;align-items:center;justify-content:space-between;gap:10px}.np-v105-perm-search input{flex:1;min-height:40px;border-radius:12px;border:1px solid rgba(126,194,255,.09);background:#06131f;color:#e8f4ff;padding:0 12px}.np-v105-perm-search span{font-size:.51rem;color:#7892ac}.np-v105-perm-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;max-height:52vh;overflow:auto;padding-right:4px}.np-v105-perm-tool{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:start;padding:10px;border-radius:12px;background:#071522;border:1px solid rgba(126,194,255,.07)}.np-v105-perm-tool b{display:block;font-size:.57rem}.np-v105-perm-tool small{display:block;font-size:.47rem;color:#6e88a2;margin-top:3px}.np-v105-perm-tool em{font-style:normal;font-size:.45rem;color:#20d8ff}.np-v105-sticky-actions{position:sticky;bottom:8px;display:flex;gap:8px;padding:10px;border-radius:15px;background:rgba(4,12,22,.94);border:1px solid rgba(126,194,255,.08);backdrop-filter:blur(12px)}.np-v105-order-layout{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,1.6fr);gap:12px}.np-v105-order-summary,.np-v105-chatbox{border-radius:17px;background:#071522;border:1px solid rgba(126,194,255,.08);padding:13px}.np-v105-order-summary h3,.np-v105-chat-head h3{font-size:.72rem}.np-v105-order-summary dl{display:grid;gap:8px;margin:12px 0}.np-v105-order-summary dl div{display:grid;gap:2px;padding-bottom:7px;border-bottom:1px solid rgba(126,194,255,.06)}.np-v105-order-summary dt{font-size:.48rem;color:#6f89a4}.np-v105-order-summary dd{font-size:.58rem;color:#d7e7f6}.np-v105-items{display:grid;gap:5px;margin:10px 0}.np-v105-items span{font-size:.51rem;padding:7px 8px;border-radius:9px;background:#091a2a;color:#a9c1d7}.np-v105-chat-head p{font-size:.49rem;color:#6f89a4;margin-top:3px}.np-v105-thread{display:grid;gap:7px;max-height:42vh;overflow:auto;padding:10px 2px}.np-v105-msg{max-width:84%;padding:9px 10px;border-radius:13px}.np-v105-msg.staff{justify-self:end;background:linear-gradient(135deg,rgba(0,212,255,.13),rgba(41,121,255,.1));border:1px solid rgba(0,212,255,.13)}.np-v105-msg.client{justify-self:start;background:#0b1c2c;border:1px solid rgba(126,194,255,.08)}.np-v105-msg>div{display:flex;gap:9px;align-items:center}.np-v105-msg b{font-size:.5rem;color:#dff6ff}.np-v105-msg time{font-size:.43rem;color:#6f88a0}.np-v105-msg p{font-size:.58rem;line-height:1.5;margin-top:4px;white-space:pre-wrap}.np-v105-chat-form{display:grid;gap:8px;padding-top:9px;border-top:1px solid rgba(126,194,255,.07)}.np-v105-quick{display:flex;flex-wrap:wrap;gap:5px}.np-v105-track-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.np-v105-chat-form input,.np-v105-chat-form textarea,.np-v105-search input{width:100%;border:1px solid rgba(126,194,255,.09);background:#06131f;color:#eaf4ff;border-radius:11px;padding:10px 11px;outline:none}.np-v105-chat-form textarea{min-height:88px;resize:vertical}.np-v105-order-inbox{display:grid;gap:7px}.np-v105-inbox-row{width:100%;display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:10px;align-items:center;padding:11px;border-radius:14px;background:#071522;border:1px solid rgba(126,194,255,.07);color:#eaf4ff;text-align:left}.np-v105-inbox-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:#0a1d2f}.np-v105-inbox-row b{display:block;font-size:.61rem}.np-v105-inbox-row small,.np-v105-inbox-row p{display:block;font-size:.48rem;color:#718ba5;margin-top:3px}.np-v105-inbox-row aside{text-align:right}.np-v105-inbox-row aside span{display:block;font-size:.49rem;color:#20d8ff}.np-v105-assignment{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:11px;border-radius:13px;background:#071522;border:1px solid rgba(126,194,255,.07)}.np-v105-assignment b{font-size:.59rem}.np-v105-assignment small{display:block;font-size:.48rem;color:#718ba5;margin-top:3px}.np-v105-assignment>span{font-size:.52rem;color:#20d8ff}.np-v105-timeline{display:grid;gap:3px}.np-v105-timeline article{display:grid;grid-template-columns:34px minmax(0,1fr);gap:9px;padding:9px 0;border-bottom:1px solid rgba(126,194,255,.055)}.np-v105-timeline article>span{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#0a1c2d;color:#20d8ff;font-weight:900}.np-v105-timeline b{font-size:.58rem}.np-v105-timeline p,.np-v105-timeline time{display:block;font-size:.47rem;color:#708aa4;margin-top:2px}.np-v105-load-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.np-v105-load-grid article{padding:13px;border-radius:15px;background:#071522;border:1px solid rgba(126,194,255,.07);text-align:center}.np-v105-load-grid .np-v105-agent-avatar{margin:auto}.np-v105-load-grid h3{font-size:.61rem;margin-top:8px}.np-v105-load-grid p,.np-v105-load-grid small{font-size:.47rem;color:#718ba5}.np-v105-load-grid strong{display:block;font-size:1.35rem;color:#1ad8ff;margin-top:9px}.np-v105-empty{display:grid;gap:4px;padding:22px;border-radius:15px;border:1px dashed rgba(126,194,255,.1);text-align:center;color:#7892ac}.np-v105-empty b{color:#cfe4f6;font-size:.63rem}.np-v105-empty span{font-size:.51rem}.np-v105-denied{min-height:260px;display:grid;place-items:center;align-content:center;gap:9px;text-align:center;padding:30px}.np-v105-denied>span{font-size:2rem}.np-v105-denied h2{font-size:1rem}.np-v105-denied p{max-width:520px;color:#7892ac;font-size:.59rem;line-height:1.6}.np-v105-client-orders{display:grid;gap:9px}.np-v105-client-order{padding:12px;border-radius:14px;background:#071522;border:1px solid rgba(126,194,255,.08)}.np-v105-client-order-head{display:flex;justify-content:space-between;gap:10px}.np-v105-client-order h3{font-size:.66rem}.np-v105-client-order p{font-size:.52rem;color:#7892ac;margin-top:3px}.np-v105-client-chat{display:grid;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid rgba(126,194,255,.07)}.np-v105-client-msg{padding:8px 9px;border-radius:11px;background:#0a1b2a}.np-v105-client-msg b{font-size:.48rem;color:#1edcff}.np-v105-client-msg p{font-size:.55rem;line-height:1.45;margin-top:3px;white-space:pre-wrap}.np-v105-client-reply{display:grid;grid-template-columns:1fr auto;gap:6px}.np-v105-client-reply input{min-width:0;border:1px solid rgba(126,194,255,.09);background:#06131f;color:#eaf4ff;border-radius:10px;padding:9px}.np-v105-client-reply button{border:0;border-radius:10px;background:linear-gradient(135deg,#19dcff,#168cff);color:#03101c;font-weight:900;padding:8px 12px}
.np-v105-order-controls{display:flex;gap:8px;align-items:center;justify-content:flex-end}.np-v105-order-controls select{min-height:38px;border-radius:11px;border:1px solid rgba(126,194,255,.09);background:#06131f;color:#dceeff;padding:0 10px}.np-v105-admin-order{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:12px;border-radius:15px;background:#071522;border:1px solid rgba(126,194,255,.075)}.np-v105-admin-order-main{min-width:0}.np-v105-admin-order-main b{font-size:.62rem}.np-v105-admin-order-main small,.np-v105-admin-order-main p{display:block;font-size:.49rem;color:#718ba5;margin-top:4px}.np-v105-admin-order-main p{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.np-v105-admin-order-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}.np-v105-admin-order-meta span{padding:5px 7px;border-radius:8px;background:#091a2a;color:#91adc7;font-size:.46rem}.np-v105-admin-order-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:6px}.np-v105-admin-order-actions select{min-height:34px;border-radius:9px;border:1px solid rgba(126,194,255,.09);background:#06131f;color:#dceeff;padding:0 7px;font-size:.5rem}.np-v105-admin-order-actions button{border:1px solid rgba(126,194,255,.1);background:#0a1a2a;color:#c5d8e9;border-radius:9px;padding:7px 8px;font-size:.49rem;font-weight:850}.np-v105-admin-order-actions button.primary{background:rgba(0,216,255,.11);color:#22dcff;border-color:rgba(0,216,255,.16)}.np-v105-admin-order-actions button.danger{background:rgba(255,94,120,.07);color:#ff748d;border-color:rgba(255,94,120,.12)}
@media(max-width:850px){.np-v105-kpis,.np-v105-load-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.np-v105-order-layout{grid-template-columns:1fr}.np-v105-perm-groups{grid-template-columns:repeat(2,minmax(0,1fr))}.np-v105-perm-list{grid-template-columns:1fr}}
@media(max-width:700px){.np-v105-admin-order{grid-template-columns:1fr}.np-v105-admin-order-actions{justify-content:flex-start}}
@media(max-width:520px){.np-v105-pagehead{align-items:flex-start;flex-direction:column}.np-v105-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.np-v105-track-row{grid-template-columns:1fr}.np-v105-inbox-row{grid-template-columns:34px minmax(0,1fr)}.np-v105-inbox-row aside{grid-column:2;text-align:left}.np-v105-assignment{grid-template-columns:1fr auto}.np-v105-assignment>span{grid-column:1}.np-v105-client-reply{grid-template-columns:1fr}}
</style>
<script>
/* v10.5 final integration: agent login + customer tracking + compact admin */
(function(){
  const api=window.NP_TEAM_API_V105;if(!api)return;
  const isStaff=()=>['admin','agent'].includes(state.session?.role);
  const latestLogin=handleLogin;
  handleLogin=async function(e){
    e.preventDefault();const identity=$('loginIdentity')?.value.trim()||'',pass=$('loginPassword')?.value||'';
    if(identity&&pass){try{const hash=await sha256(pass);const agent=api.agents().find(a=>a.active!==false&&(norm(a.email)===norm(identity)||norm(a.username)===norm(identity))&&a.passwordHash===hash);if(agent){agent.lastLoginAt=new Date().toISOString();api.saveAgents();state.session={role:'agent',agentId:agent.id,email:agent.email,createdAt:new Date().toISOString()};write(KEYS.session,state.session);closeModal('accountModal');renderHeader();openAdmin('home');toast(`Bienvenido, ${agent.name}.`,'success');return}}catch(error){console.warn('Agent login',error)}}
    return latestLogin.call(this,e);
  };
  openAdmin=function(section='home'){
    if(!isStaff())return;$('adminOverlay').classList.add('open');document.body.classList.add('lock');renderAdminSection(section==='dashboard'?'home':(section||'home'));setTimeout(api.applyNav,0);
  };
  const baseHeader=renderHeader;
  renderHeader=function(){baseHeader();if(state.session?.role==='agent'){const a=api.sessionAgent();$('profileDot').textContent=(a?.name||'A').charAt(0).toUpperCase()}};
  if($('adminStoreBtn'))$('adminStoreBtn').onclick=()=>{$('adminOverlay').classList.remove('open');document.body.classList.remove('lock');renderHeader();toast('Tienda abierta. La sesión del equipo continúa activa.','success')};
  if($('adminLogout'))$('adminLogout').onclick=()=>{state.session=null;write(KEYS.session,null);$('adminOverlay').classList.remove('open');document.body.classList.remove('lock');renderHeader();toast('Sesión cerrada.','success')};
  if($('profileBtn'))$('profileBtn').onclick=()=>{if(isStaff())return openAdmin('home');renderAccount();openModal('accountModal')};
  if($('drawerProfile'))$('drawerProfile').onclick=()=>{closeAllPanels();if(isStaff())return openAdmin('home');renderAccount();openModal('accountModal')};
  adminOrders=function(){
    $('adminContent').innerHTML=`<section class="np-v105-page"><header class="np-v105-pagehead"><div><h2>Pedidos</h2><p>Gestiona estado, responsable y seguimiento desde una sola vista.</p></div><div class="np-v105-search"><input id="orderSearch" placeholder="Buscar pedido o cliente"></div></header><div class="np-v105-order-controls"><select id="orderStatus"><option value="all">Todos los estados</option>${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" id="exportOrders">Exportar CSV</button></div><div class="np-v105-order-inbox" id="orderAdminList"></div></section>`;
    const draw=()=>{const q=norm($('orderSearch').value),st=$('orderStatus').value;const list=state.orders.filter(o=>(st==='all'||o.status===st)&&(!q||norm(`${o.id} ${o.customer?.fullName} ${o.customer?.email} ${o.trackingNumber||''}`).includes(q)));$('orderAdminList').innerHTML=list.map(o=>{const assigned=api.agentById(api.assignments()[o.id]);return `<article class="np-v105-admin-order"><div class="np-v105-admin-order-main"><b>${esc(o.id)} · ${esc(o.customer?.fullName||'Cliente')}</b><small>${new Date(o.createdAt).toLocaleString('es-GT')} · ${safeArr(o.items).length} artículos · ${money(o.total)}</small><p>${esc(safeArr(o.items).map(i=>`${i.name} ×${i.qty}`).join(' • '))}</p><div class="np-v105-admin-order-meta"><span>Responsable: ${esc(assigned?.name||'Sin asignar')}</span>${o.trackingNumber?`<span>Guía: ${esc(o.trackingNumber)}</span>`:''}</div></div><div class="np-v105-admin-order-actions"><select data-order-status="${esc(o.id)}">${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select><button type="button" class="primary" data-follow-order="${esc(o.id)}">Seguimiento</button><button type="button" data-assign-order="${esc(o.id)}">Asignar</button><button type="button" class="danger" data-delete-order="${esc(o.id)}">Eliminar</button></div></article>`}).join('')||'<div class="np-v105-empty"><b>No hay pedidos en este filtro.</b></div>';
      $('orderAdminList').querySelectorAll('[data-order-status]').forEach(s=>s.onchange=()=>{const o=state.orders.find(x=>String(x.id)===String(s.dataset.orderStatus));if(!o)return;const previous=o.status;o.status=s.value;o.updatedAt=new Date().toISOString();write(KEYS.orders,state.orders);logActivity('Estado de pedido',`${o.id} → ${o.status}`);if(previous!==o.status)api.sendOrderMessage(o.id,`Tu pedido cambió de estado a: ${o.status}.`,{kind:'status'});draw()});
      $('orderAdminList').querySelectorAll('[data-follow-order]').forEach(b=>b.onclick=()=>api.renderOrderConversation(b.dataset.followOrder));
      $('orderAdminList').querySelectorAll('[data-assign-order]').forEach(b=>{b.onclick=()=>{api.renderOrderConversation(b.dataset.assignOrder);setTimeout(()=>document.getElementById('npAssignHere')?.click(),30)}});
      $('orderAdminList').querySelectorAll('[data-delete-order]').forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>String(x.id)===String(b.dataset.deleteOrder));if(!o||!await npConfirm(`¿Eliminar el pedido ${o.id}?`))return;state.orders=state.orders.filter(x=>x.id!==o.id);write(KEYS.orders,state.orders);delete api.assignments()[o.id];delete api.chats()[o.id];api.saveChats();draw();logActivity('Pedido eliminado',o.id);toast('Pedido eliminado.','success')});
    };
    $('orderSearch').oninput=draw;$('orderStatus').onchange=draw;$('exportOrders').onclick=()=>exportCsv('pedidos',state.orders.map(o=>({id:o.id,cliente:o.customer?.fullName,correo:o.customer?.email,telefono:o.customer?.phone,estado:o.status,total:o.total,guia:o.trackingNumber||'',responsable:api.agentById(api.assignments()[o.id])?.name||''})));draw();
  };
  renderClientOrders=function(){
    const user=currentUser();if(!user)return renderAccount();const list=state.orders.filter(o=>o.userId===user.id||norm(o.customer?.email)===norm(user.email));
    $('accountBody').innerHTML=`<section class="np-v105-client-orders"><div class="admin-card-head"><div><h2>Mis pedidos</h2><p class="admin-card-sub">Consulta el estado y los mensajes de seguimiento de CRULOX.</p></div><button class="btn btn-secondary btn-sm" id="backProfile">Volver</button></div>${list.length?list.map(o=>{const msgs=api.chatOf(o.id);return `<article class="np-v105-client-order"><div class="np-v105-client-order-head"><div><h3>${esc(o.id)} · ${money(o.total)}</h3><p>${new Date(o.createdAt).toLocaleString('es-GT')} · ${esc(o.status||'Nuevo')}${o.trackingNumber?` · Guía: ${esc(o.trackingNumber)}`:''}</p></div><span class="status">${esc(o.status||'Nuevo')}</span></div><div class="np-v105-client-chat">${msgs.length?msgs.map(m=>`<div class="np-v105-client-msg"><b>${esc(m.senderRole==='client'?'Tú':(m.senderName||'CRULOX'))}</b><p>${esc(m.text)}</p></div>`).join(''):'<div class="np-v105-empty small"><span>Aún no hay mensajes de seguimiento.</span></div>'}<form class="np-v105-client-reply" data-client-reply="${esc(o.id)}"><input placeholder="Responder sobre este pedido…" maxlength="800"><button>Enviar</button></form></div></article>`}).join(''):'<div class="empty">Todavía no tienes pedidos registrados.</div>'}</section>`;
    $('backProfile').onclick=renderAccount;$('accountBody').querySelectorAll('[data-client-reply]').forEach(f=>f.onsubmit=e=>{e.preventDefault();const input=f.querySelector('input'),text=input.value.trim();if(!text)return;const key=f.dataset.clientReply,arr=api.chatOf(key);arr.push({id:uid('msg'),orderId:key,senderRole:'client',senderId:user.id,senderName:user.fullName||user.username||'Cliente',text:text.slice(0,800),kind:'message',createdAt:new Date().toISOString(),readByClient:true});const chats=api.chats();chats[key]=arr;api.saveChats();renderClientOrders();toast('Mensaje enviado al seguimiento.','success')});
  };
  window.addEventListener('storage',e=>{if(e.key==='jm_digital_v1_order_chat'&&$('accountModal')?.classList.contains('open')&&currentUser())try{renderClientOrders()}catch(error){}});
  renderHeader();
  document.documentElement.dataset.npV105='ready';document.documentElement.dataset.npTools=String(window.NP_ADMIN_TOOL_COUNT_V105||0);document.documentElement.dataset.npSelfTest=String(!!window.NP_V105_SELF_TEST?.ok);
  if(isStaff()&&$('adminOverlay').classList.contains('open')){renderAdminSection('home');setTimeout(api.applyNav,0)}
})();
</script>


<script>
/* v9.5: remove duplicated brand text and lock slogan directly under logo name */
(function(){
  const brandCopy=document.querySelector('.hero-brand-copy');
  const heroName=document.querySelector('.hero-brand-name');
  if(heroName) heroName.remove();
  if(brandCopy && !document.getElementById('np-v95-style')){
    const style=document.createElement('style');
    style.id='np-v95-style';
    style.textContent=`
      .hero-brand-top{margin:0 0 14px!important;gap:0!important}
      .hero-brand-top img{margin:0 0 -2px!important}
      .hero-brand-copy{
        width:min(100%,500px)!important;
        display:flex!important;
        flex-direction:column!important;
        align-items:flex-start!important;
        justify-content:flex-start!important;
        padding-left:37.5%!important;
        margin-top:-8px!important;
      }
      .hero-brand-slogan{
        margin-top:0!important;
        transform:none!important;
        white-space:nowrap!important;
      }
      @media(max-width:860px){
        .hero-brand-copy{padding-left:36%!important;margin-top:-7px!important}
      }
      @media(max-width:520px){
        .hero-brand-top img{margin-bottom:-1px!important}
        .hero-brand-copy{width:min(100%,340px)!important;padding-left:34.5%!important;margin-top:-6px!important}
        .hero-brand-slogan{font-size:.49rem!important;padding:4px 9px!important}
      }
    `;
    document.head.appendChild(style);
  }
})();
</script>

<script>
/* v9.6 - mejora visual y estructural del panel administrativo */
(function(){
  if(!document.getElementById('np-admin-v96-style')){
    const style=document.createElement('style');
    style.id='np-admin-v96-style';
    style.textContent=`
      .admin-overlay{background:radial-gradient(circle at top,rgba(0,195,255,.08),transparent 26%),#020812!important}
      .admin-main{background:linear-gradient(180deg,rgba(4,11,20,.97),rgba(3,8,16,.985))}
      .admin-sidebar{
        background:linear-gradient(180deg,#061321 0%,#040c16 100%)!important;
        border-right:1px solid rgba(128,199,255,.08)!important;
        box-shadow:inset -1px 0 0 rgba(255,255,255,.02)
      }
      .admin-brand{width:220px!important;height:58px!important;filter:drop-shadow(0 6px 16px rgba(0,207,255,.18))}
      .admin-nav{gap:7px!important}
      .admin-nav button{
        min-height:44px;border:1px solid transparent!important;border-radius:14px!important;
        background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015))!important;
        color:#d7e6fb!important;font-size:.76rem!important;letter-spacing:.01em;
        box-shadow:0 10px 26px rgba(0,0,0,.14)
      }
      .admin-nav button.active,.admin-nav button:hover{
        color:#04101d!important;background:linear-gradient(135deg,#15d8ff,#1d84ff)!important;
        border-color:rgba(255,255,255,.15)!important;box-shadow:0 16px 38px rgba(0,180,255,.24)!important
      }
      .admin-top{
        min-height:84px!important;padding:16px 20px!important;
        background:linear-gradient(180deg,rgba(5,10,18,.96),rgba(5,10,18,.86))!important;
        border-bottom:1px solid rgba(119,185,255,.08)!important
      }
      .admin-top h1{font-size:1.45rem!important;letter-spacing:-.02em}
      .admin-top .section-kicker{font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:#88a8c9}
      .admin-content{padding:18px!important;max-width:1500px!important}
      .admin-hero{
        position:relative;overflow:hidden;padding:22px;border-radius:26px;
        border:1px solid rgba(110,196,255,.12);
        background:
          radial-gradient(circle at 90% 20%,rgba(0,217,255,.12),transparent 28%),
          radial-gradient(circle at 10% 90%,rgba(78,97,255,.12),transparent 30%),
          linear-gradient(145deg,#0a1b30,#071221 60%,#08182a);
        box-shadow:0 18px 44px rgba(0,0,0,.2)
      }
      .admin-hero::after{
        content:"";position:absolute;inset:auto -60px -70px auto;width:200px;height:200px;border-radius:50%;
        background:radial-gradient(circle,rgba(0,217,255,.18),transparent 68%);pointer-events:none
      }
      .admin-hero-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap}
      .admin-hero-copy{max-width:760px}
      .admin-hero-copy h2{font-size:1.45rem;line-height:1.1;margin:6px 0 10px}
      .admin-hero-copy p{color:#b6c8de;font-size:.76rem;line-height:1.72;max-width:700px}
      .admin-chip-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
      .admin-chip{
        display:inline-flex;align-items:center;gap:7px;padding:9px 12px;border-radius:999px;
        border:1px solid rgba(124,196,255,.12);background:rgba(255,255,255,.04);color:#dbe8f8;
        font-size:.66rem;font-weight:800
      }
      .admin-chip .dot{width:8px;height:8px;border-radius:50%;background:#1ee67a;box-shadow:0 0 0 4px rgba(30,230,122,.15)}
      .admin-chip.warn .dot{background:#ffbf47;box-shadow:0 0 0 4px rgba(255,191,71,.15)}
      .admin-hero-actions{display:grid;grid-template-columns:repeat(2,minmax(140px,1fr));gap:10px;min-width:min(100%,320px)}
      .admin-hero-actions .btn{width:100%;min-height:48px;border-radius:16px!important;font-weight:900}
      .admin-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px!important;margin-top:14px}
      .metric{
        position:relative;overflow:hidden;padding:16px 16px 15px 16px!important;border-radius:22px!important;
        background:linear-gradient(145deg,#0c1f35,#081525)!important;
        border:1px solid rgba(130,198,255,.1)!important;box-shadow:0 12px 30px rgba(0,0,0,.16)
      }
      .metric::before{content:"";position:absolute;inset:0 auto auto 0;width:100%;height:2px;background:linear-gradient(90deg,rgba(0,217,255,.7),transparent)}
      .metric-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
      .metric-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;font-size:1.06rem;color:#dff8ff;background:linear-gradient(135deg,rgba(0,217,255,.2),rgba(71,105,255,.18));border:1px solid rgba(126,200,255,.11)}
      .metric small{display:block;color:#90aac7!important;font-size:.66rem!important;letter-spacing:.02em}
      .metric strong{display:block;color:#18d7ff!important;font-size:1.62rem!important;margin-top:0!important;line-height:1.05}
      .metric-note{display:block;margin-top:6px;color:#6988a8;font-size:.58rem;line-height:1.45}
      .admin-layout{display:grid;grid-template-columns:1.16fr .84fr;gap:14px;margin-top:14px}
      .admin-stack{display:grid;gap:14px}
      .admin-card{
        margin-top:0!important;padding:18px!important;border-radius:24px!important;
        background:linear-gradient(145deg,#0b1b2d,#081524)!important;border:1px solid rgba(122,193,255,.1)!important;
        box-shadow:0 14px 32px rgba(0,0,0,.16)
      }
      .admin-card-head{margin-bottom:14px!important}
      .admin-card h2{font-size:1.06rem!important;letter-spacing:-.01em}
      .admin-card-sub{color:#8ea8c6;font-size:.68rem;line-height:1.65;margin-top:4px}
      .admin-actions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
      .admin-action{
        padding:14px;border-radius:18px;border:1px solid rgba(125,196,255,.1);
        background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));
        color:#e9f3ff;text-align:left;display:grid;gap:6px;min-height:92px
      }
      .admin-action strong{font-size:.84rem}
      .admin-action span{font-size:.64rem;color:#93aac5;line-height:1.55}
      .admin-action:hover{transform:translateY(-1px);border-color:rgba(46,203,255,.18)}
      .admin-mini-list{display:grid;gap:9px}
      .admin-mini-item{
        display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:12px 13px;
        border-radius:16px;border:1px solid rgba(122,193,255,.08);background:rgba(255,255,255,.03)
      }
      .admin-mini-item b{display:block;font-size:.78rem;margin-bottom:4px}
      .admin-mini-item small{display:block;color:#8ea8c6;font-size:.63rem;line-height:1.55}
      .admin-badge{display:inline-flex;align-items:center;justify-content:center;min-width:74px;padding:7px 10px;border-radius:999px;font-size:.58rem;font-weight:900}
      .admin-badge.ok{background:rgba(30,230,122,.12);color:#5dffaf}
      .admin-badge.warn{background:rgba(255,191,71,.12);color:#ffc55d}
      .admin-badge.bad{background:rgba(255,96,131,.12);color:#ff7b9d}
      .admin-simple-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .admin-note{
        padding:13px 14px;border-radius:18px;border:1px solid rgba(253,193,91,.16);
        background:rgba(255,196,77,.06);color:#ffe1a1;font-size:.67rem;line-height:1.65
      }
      .admin-note b{color:#ffd067}
      .admin-activity-preview{display:grid;gap:8px}
      .admin-activity-row{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.05)}
      .admin-activity-row:last-child{border-bottom:0;padding-bottom:0}
      .admin-activity-row b{display:block;font-size:.73rem}
      .admin-activity-row span{display:block;margin-top:3px;color:#8ea8c6;font-size:.61rem;line-height:1.55}
      .admin-inline-buttons{display:flex;gap:8px;flex-wrap:wrap}
      .admin-inline-buttons .btn{border-radius:14px!important}
      .table-wrap{border-radius:18px!important;border-color:rgba(122,193,255,.1)!important}
      th{background:#0c1d31!important}
      .admin-list-item{border-radius:16px!important;background:rgba(255,255,255,.03)!important;border-color:rgba(122,193,255,.08)!important}
      .status{font-size:.6rem!important;padding:6px 9px!important}
      @media(max-width:1100px){
        .admin-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
        .admin-layout{grid-template-columns:1fr}
      }
      @media(max-width:900px){
        .admin-sidebar{padding:10px!important;gap:10px!important}
        .admin-brand{width:170px!important;height:46px!important}
        .admin-nav{display:flex!important;gap:7px!important;padding-bottom:4px!important}
        .admin-nav button{white-space:nowrap;min-height:40px;font-size:.71rem!important;padding:10px 12px!important}
      }
      @media(max-width:680px){
        .admin-top{padding:12px 12px 13px!important;min-height:76px!important}
        .admin-top h1{font-size:1.15rem!important}
        .admin-content{padding:12px!important}
        .admin-hero{padding:16px;border-radius:22px}
        .admin-hero-copy h2{font-size:1.1rem}
        .admin-hero-copy p{font-size:.69rem}
        .admin-hero-actions{grid-template-columns:1fr 1fr;min-width:100%}
        .admin-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px!important}
        .metric{padding:14px 12px!important;border-radius:18px!important}
        .metric strong{font-size:1.35rem!important}
        .metric-icon{width:36px;height:36px;border-radius:12px;font-size:.92rem}
        .admin-card{padding:15px!important;border-radius:20px!important}
        .admin-actions-grid,.admin-simple-grid{grid-template-columns:1fr}
      }
      @media(max-width:460px){
        .admin-top .toolbar{grid-template-columns:1fr 1fr!important}
        .admin-top .toolbar .btn{min-height:42px}
        .admin-hero-actions{grid-template-columns:1fr}
        .admin-grid{grid-template-columns:1fr 1fr}
        .admin-chip{font-size:.6rem;padding:8px 10px}
      }
    `;
    document.head.appendChild(style);
  }

  const metricIcons={
    'Productos':'📦','Combos':'🎁','Categorías':'🏷️','Clientes':'👥','Pedidos':'🧾',
    'Ventas registradas':'💰','Stock bajo':'⚠️','Agotados':'⛔','FAQ':'❓'
  };
  metric=function(label,value){
    const icon=metricIcons[label]||'•';
    const notes={
      'Productos':'Catálogo principal',
      'Combos':'Paquetes publicados',
      'Categorías':'Organización actual',
      'Clientes':'Usuarios registrados',
      'Pedidos':'Solicitudes recibidas',
      'Ventas registradas':'Total acumulado',
      'Stock bajo':'Revisar pronto',
      'Agotados':'Sin existencia',
      'FAQ':'Ayuda al cliente'
    };
    return `<article class="metric"><div class="metric-top"><small>${label}</small><span class="metric-icon">${icon}</span></div><strong>${value}</strong><span class="metric-note">${notes[label]||'Resumen general'}</span></article>`;
  };

  function adminStatusBadge(kind,text){
    return `<span class="admin-badge ${kind}">${text}</span>`;
  }
  function adminQuickAction(id,icon,title,desc,variant){
    return `<button class="admin-action ${variant||''}" id="${id}"><strong>${icon} ${title}</strong><span>${desc}</span></button>`;
  }
  function activityPreview(){
    if(!state.activity.length) return `<div class="admin-note"><b>Sin actividad reciente.</b> Aún no hay movimientos registrados en esta sesión local.</div>`;
    return `<div class="admin-activity-preview">${state.activity.slice(0,4).map(a=>`<article class="admin-activity-row"><b>${esc(a.action)}</b><span>${esc(a.detail)} · ${new Date(a.at).toLocaleString('es-GT')}</span></article>`).join('')}</div>`;
  }
  function stockPreview(){
    const lowLimit=Number(state.settings.lowStock||5);
    const items=state.products.filter(p=>Number(p.stock||0)<=lowLimit).sort((a,b)=>Number(a.stock||0)-Number(b.stock||0)).slice(0,4);
    if(!items.length) return `<div class="admin-note"><b>Todo estable.</b> No hay productos en estado crítico de inventario.</div>`;
    return `<div class="admin-mini-list">${items.map(p=>{
      const stock=Number(p.stock||0);
      const badge=stock<=0?adminStatusBadge('bad','Agotado'):stock<=lowLimit?adminStatusBadge('warn','Bajo'):adminStatusBadge('ok','Estable');
      return `<article class="admin-mini-item"><div><b>${esc(p.name)}</b><small>${esc(p.category||'Sin categoría')} · Stock actual: ${stock}</small></div>${badge}</article>`;
    }).join('')}</div>`;
  }
  function statusCards(){
    const supportReady=state.settings.supportBotUrl && state.settings.supportBotUrl!=='#';
    const orderReady=state.settings.orderBotUrl && state.settings.orderBotUrl!=='#';
    return `<div class="admin-mini-list">
      <article class="admin-mini-item">
        <div><b>Canal de atención</b><small>${supportReady?'Configurado para recibir consultas desde la tienda.':'Aún necesitas definir el enlace principal de atención.'}</small></div>
        ${supportReady?adminStatusBadge('ok','Activo'):adminStatusBadge('warn','Pendiente')}
      </article>
      <article class="admin-mini-item">
        <div><b>Flujo de pedidos</b><small>${orderReady?'Preparado para procesar solicitudes desde el checkout.':'El flujo de pedidos todavía necesita configuración.'}</small></div>
        ${orderReady?adminStatusBadge('ok','Listo'):adminStatusBadge('warn','Revisar')}
      </article>
      <article class="admin-mini-item">
        <div><b>Datos del panel local</b><small>La administración temporal guarda la información en este dispositivo mientras se completa la integración final.</small></div>
        ${adminStatusBadge('ok','Local')}
      </article>
    </div>`;
  }

  adminDashboard=function(){
    const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);
    const lowLimit=Number(state.settings.lowStock||5);
    const low=state.products.filter(p=>Number(p.stock||0)>0&&Number(p.stock||0)<=lowLimit).length;
    const out=state.products.filter(p=>Number(p.stock||0)<=0).length;
    const pendingAttention=(state.settings.supportBotUrl && state.settings.supportBotUrl!=='#')?0:1;
    $('adminContent').innerHTML=`
      <section class="admin-hero">
        <div class="admin-hero-head">
          <div class="admin-hero-copy">
            <small class="section-kicker">Centro de control CRULOX</small>
            <h2>Administra catálogo, pedidos y operación desde una vista mucho más clara.</h2>
            <p>Este panel local te permite revisar el estado general de la tienda, intervenir rápido en productos, monitorear existencias y ordenar la operación mientras se completa la conexión final con la infraestructura definitiva.</p>
            <div class="admin-chip-row">
              <span class="admin-chip"><span class="dot"></span> Panel operativo local activo</span>
              <span class="admin-chip ${pendingAttention?'warn':''}"><span class="dot"></span> Atención ${pendingAttention?'pendiente':'configurada'}</span>
              <span class="admin-chip ${low||out?'warn':''}"><span class="dot"></span> ${low+out} alertas de inventario</span>
            </div>
          </div>
          <div class="admin-hero-actions">
            <button class="btn btn-primary" id="heroAddProduct">Agregar producto</button>
            <button class="btn btn-secondary" id="heroViewOrders">Ver pedidos</button>
            <button class="btn btn-secondary" id="heroOpenInventory">Inventario</button>
            <button class="btn btn-red" id="heroBackup">Crear respaldo</button>
          </div>
        </div>
      </section>

      <div class="admin-grid">
        ${metric('Productos',state.products.length)}
        ${metric('Combos',state.combos.length)}
        ${metric('Categorías',categories().length)}
        ${metric('Clientes',state.users.length)}
        ${metric('Pedidos',state.orders.length)}
        ${metric('Ventas registradas',money(sales))}
        ${metric('Stock bajo',low)}
        ${metric('Agotados',out)}
        ${metric('FAQ',state.faqs.length)}
      </div>

      <div class="admin-layout">
        <div class="admin-stack">
          <section class="admin-card">
            <div class="admin-card-head">
              <div>
                <h2>Acciones rápidas</h2>
                <p class="admin-card-sub">Atajos mejor organizados para las tareas que más vas a usar en el día a día.</p>
              </div>
            </div>
            <div class="admin-actions-grid">
              ${adminQuickAction('quickAddProduct','📦','Agregar producto','Crea un nuevo producto y súbelo al catálogo.')}
              ${adminQuickAction('quickAddCombo','🎁','Agregar combo','Publica un combo con imagen, precio y descripción.')}
              ${adminQuickAction('quickOrders','🧾','Revisar pedidos','Consulta solicitudes recibidas y su estado actual.')}
              ${adminQuickAction('quickBackup','💾','Crear respaldo','Guarda una copia local de seguridad del panel.')}
            </div>
          </section>

          <section class="admin-card">
            <div class="admin-card-head">
              <div>
                <h2>Inventario en atención</h2>
                <p class="admin-card-sub">Productos que requieren revisión por poco stock o por estar agotados.</p>
              </div>
              <div class="admin-inline-buttons">
                <button class="btn btn-secondary btn-sm" id="openInventoryFromCard">Abrir inventario</button>
              </div>
            </div>
            ${stockPreview()}
          </section>
        </div>

        <div class="admin-stack">
          <section class="admin-card">
            <div class="admin-card-head">
              <div>
                <h2>Estado operativo</h2>
                <p class="admin-card-sub">Resumen técnico del funcionamiento actual del área administrativa.</p>
              </div>
            </div>
            ${statusCards()}
            <div class="admin-note" style="margin-top:12px"><b>Nota:</b> esta versión administra temporalmente desde almacenamiento local. La conexión final a base de datos y autenticación se hará después, sin depender de editar datos manualmente fuera del panel.</div>
          </section>

          <section class="admin-card">
            <div class="admin-card-head">
              <div>
                <h2>Actividad reciente</h2>
                <p class="admin-card-sub">Últimos movimientos registrados dentro del entorno administrativo.</p>
              </div>
              <div class="admin-inline-buttons">
                <button class="btn btn-secondary btn-sm" id="openActivityFromCard">Ver todo</button>
              </div>
            </div>
            ${activityPreview()}
          </section>
        </div>
      </div>`;

    $('heroAddProduct').onclick=()=>openProductEditor();
    $('heroViewOrders').onclick=()=>renderAdminSection('orders');
    $('heroOpenInventory').onclick=()=>renderAdminSection('inventory');
    $('heroBackup').onclick=exportBackup;
    $('quickAddProduct').onclick=()=>openProductEditor();
    $('quickAddCombo').onclick=()=>typeof openComboEditor==='function'?openComboEditor():toast('La gestión de combos estará disponible en la siguiente mejora.','info');
    $('quickOrders').onclick=()=>renderAdminSection('orders');
    $('quickBackup').onclick=exportBackup;
    $('openInventoryFromCard').onclick=()=>renderAdminSection('inventory');
    $('openActivityFromCard').onclick=()=>renderAdminSection('activity');
  };
})();
</script>

<script>
/* v9.7 · Tarjetas del resumen convertidas en informes administrativos completos */
(function(){
  const detailStyle=document.createElement('style');
  detailStyle.id='np-admin-v97-style';
  detailStyle.textContent=`
    .metric.metric-clickable{cursor:pointer;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
    .metric.metric-clickable:hover,.metric.metric-clickable:focus-visible{transform:translateY(-2px);border-color:rgba(39,211,255,.34)!important;box-shadow:0 18px 38px rgba(0,174,255,.13)!important;outline:none}
    .metric.metric-clickable::after{content:'Ver detalle →';position:absolute;right:14px;bottom:12px;color:#68dfff;font-size:.55rem;font-weight:900;letter-spacing:.02em;opacity:.72}
    .metric.metric-clickable .metric-note{padding-right:76px}
    .admin-detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:14px}
    .admin-detail-title small{display:block;color:#79a4c8;font-size:.62rem;text-transform:uppercase;letter-spacing:.13em;margin-bottom:4px}
    .admin-detail-title h2{font-size:1.24rem;line-height:1.15;margin:0}
    .admin-detail-title p{margin-top:6px;color:#91aac6;font-size:.67rem;line-height:1.6;max-width:760px}
    .admin-detail-actions{display:flex;gap:8px;flex-wrap:wrap}
    .admin-detail-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0 16px}
    .admin-detail-stat{padding:12px 13px;border-radius:17px;border:1px solid rgba(108,193,255,.1);background:rgba(255,255,255,.025)}
    .admin-detail-stat span{display:block;color:#86a1bd;font-size:.59rem;margin-bottom:5px}
    .admin-detail-stat strong{display:block;color:#20d7ff;font-size:1.05rem}
    .admin-record-list{display:grid;gap:10px}
    .admin-record{padding:14px;border-radius:19px;border:1px solid rgba(110,194,255,.1);background:linear-gradient(145deg,rgba(12,31,52,.96),rgba(7,20,35,.96));box-shadow:0 10px 26px rgba(0,0,0,.12)}
    .admin-record-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
    .admin-record-title{display:flex;gap:10px;align-items:flex-start;min-width:0}
    .admin-record-title img{width:58px;height:58px;object-fit:cover;border-radius:13px;border:1px solid rgba(120,196,255,.12);background:#07111e;flex:0 0 auto}
    .admin-record-title h3{font-size:.84rem;line-height:1.25;margin:0;word-break:break-word}
    .admin-record-title p{color:#8ea8c4;font-size:.61rem;line-height:1.5;margin-top:4px}
    .admin-record-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}
    .admin-fieldbox{padding:10px;border-radius:13px;background:rgba(255,255,255,.026);border:1px solid rgba(255,255,255,.045);min-width:0}
    .admin-fieldbox span{display:block;color:#7896b5;font-size:.53rem;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
    .admin-fieldbox b,.admin-fieldbox p{display:block;color:#e7f2ff;font-size:.65rem;line-height:1.5;margin:0;overflow-wrap:anywhere}
    .admin-record-description{margin-top:10px;padding:11px 12px;border-radius:14px;background:rgba(255,255,255,.022);color:#b7c8db;font-size:.64rem;line-height:1.65}
    .admin-record-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}
    .admin-items{display:grid;gap:7px;margin-top:10px}
    .admin-item-line{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px;align-items:center;padding:9px 10px;border-radius:12px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.04);font-size:.62rem}
    .admin-item-line span{color:#9cb2ca}.admin-item-line b{color:#eaf4ff}
    .admin-customer-block{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
    .admin-empty-detail{padding:28px 16px;text-align:center;color:#89a4c0;font-size:.7rem;border:1px dashed rgba(112,193,255,.14);border-radius:18px}
    .admin-category-bar{height:7px;border-radius:999px;background:rgba(255,255,255,.05);overflow:hidden;margin-top:8px}
    .admin-category-bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#00d9ff,#2684ff)}
    .admin-order-total{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;padding:11px 12px;border-radius:14px;background:rgba(0,217,255,.055);border:1px solid rgba(0,217,255,.11)}
    .admin-order-total strong{color:#18d7ff;font-size:.9rem}
    .admin-subheading{margin:16px 0 9px;font-size:.8rem;color:#eef7ff}
    @media(max-width:900px){.admin-detail-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-record-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:620px){
      .admin-detail-summary{grid-template-columns:repeat(2,minmax(0,1fr))}
      .admin-record-grid,.admin-customer-block{grid-template-columns:1fr 1fr}
      .admin-record-head{flex-direction:column}
      .admin-item-line{grid-template-columns:minmax(0,1fr) auto}
      .admin-item-line .item-total{grid-column:1/-1;text-align:right}
      .admin-detail-actions{width:100%}.admin-detail-actions .btn{flex:1}
    }
    @media(max-width:420px){.admin-record-grid,.admin-customer-block{grid-template-columns:1fr}.admin-detail-stat strong{font-size:.92rem}.admin-record-title img{width:52px;height:52px}}
  `;
  document.head.appendChild(detailStyle);

  const dashboardTargets={
    'Productos':'metric-products','Combos':'metric-combos','Categorías':'metric-categories','Clientes':'metric-users',
    'Pedidos':'metric-orders','Ventas registradas':'metric-sales','Stock bajo':'metric-low-stock','Agotados':'metric-out-stock','FAQ':'metric-faqs'
  };
  const dashboardIcons={
    'Productos':'📦','Combos':'🎁','Categorías':'🏷️','Clientes':'👥','Pedidos':'🧾','Ventas registradas':'💰','Stock bajo':'⚠️','Agotados':'⛔','FAQ':'❓'
  };
  const dashboardNotes={
    'Productos':'Catálogo principal','Combos':'Paquetes publicados','Categorías':'Organización actual','Clientes':'Usuarios registrados','Pedidos':'Solicitudes recibidas','Ventas registradas':'Total acumulado','Stock bajo':'Revisar pronto','Agotados':'Sin existencia','FAQ':'Ayuda al cliente'
  };

  metric=function(label,value){
    const target=dashboardTargets[label]||'';
    return `<article class="metric ${target?'metric-clickable':''}" ${target?`data-metric-target="${target}" role="button" tabindex="0" aria-label="Ver detalle de ${esc(label)}"`:''}><div class="metric-top"><small>${esc(label)}</small><span class="metric-icon">${dashboardIcons[label]||'•'}</span></div><strong>${value}</strong><span class="metric-note">${dashboardNotes[label]||'Resumen general'}</span></article>`;
  };

  function backHeader(title,description,actions=''){
    return `<div class="admin-detail-head"><div class="admin-detail-title"><small>Detalle del resumen</small><h2>${title}</h2><p>${description}</p></div><div class="admin-detail-actions"><button class="btn btn-secondary btn-sm" data-back-dashboard>← Resumen</button>${actions}</div></div>`;
  }
  function bindBack(){document.querySelectorAll('[data-back-dashboard]').forEach(b=>b.onclick=()=>renderAdminSection('dashboard'))}
  function fmtDate(value,withTime=true){if(!value)return '—';const d=new Date(value);if(Number.isNaN(d.getTime()))return String(value);return withTime?d.toLocaleString('es-GT'):d.toLocaleDateString('es-GT')}
  function safeText(v,fallback='—'){return v===undefined||v===null||v===''?fallback:String(v)}
  function orderRevenue(list){return list.reduce((s,o)=>s+Number(o.total||0),0)}
  function itemCount(list){return list.reduce((s,o)=>s+(o.items||[]).reduce((a,i)=>a+Number(i.qty||0),0),0)}
  function summaryStats(stats){return `<div class="admin-detail-summary">${stats.map(s=>`<div class="admin-detail-stat"><span>${esc(s.label)}</span><strong>${s.value}</strong></div>`).join('')}</div>`}
  function field(label,value){return `<div class="admin-fieldbox"><span>${esc(label)}</span><b>${esc(safeText(value))}</b></div>`}

  function adminMetricProducts(){
    const totalStock=state.products.reduce((s,p)=>s+Number(p.stock||0),0);
    const featured=state.products.filter(p=>p.featured).length;
    const low=state.products.filter(p=>Number(p.stock||0)>0&&Number(p.stock||0)<=Number(state.settings.lowStock||5)).length;
    const out=state.products.filter(p=>Number(p.stock||0)<=0).length;
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Productos',`Información completa de los ${state.products.length} productos publicados: contenido, precio, multimedia, inventario, valoración y estado.`,`<button class="btn btn-primary btn-sm" id="detailAddProduct">Agregar producto</button>`)}${summaryStats([{label:'Productos',value:state.products.length},{label:'Stock total',value:totalStock},{label:'Destacados',value:featured},{label:'Alertas',value:low+out}])}<div class="admin-record-list">${state.products.map(p=>{const images=(p.images||[]).filter(Boolean);const status=Number(p.stock||0)<=0?'No disponible':Number(p.stock||0)<=Number(state.settings.lowStock||5)?'Pocas unidades':'Disponible';return `<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><img src="${esc(p.image||images[0]||'')}" alt=""><div><h3>${esc(p.name)}</h3><p>${esc(p.category||'Sin categoría')} · ID: ${esc(p.id)}</p></div></div><span class="admin-badge ${Number(p.stock||0)<=0?'bad':Number(p.stock||0)<=Number(state.settings.lowStock||5)?'warn':'ok'}">${status}</span></div><div class="admin-record-grid">${field('Precio',money(p.price))}${field('Precio anterior',p.oldPrice?money(p.oldPrice):'—')}${field('Stock',p.stock)}${field('Valoración',`${Number(p.rating||0).toFixed(1)} / 5 · ${Number(p.reviews||0)} reseñas`)}${field('Etiqueta',p.badgeText||'—')}${field('Destacado',p.featured?'Sí':'No')}${field('Imágenes',Math.max(1,images.length||1))}${field('Video',p.videoUrl?'Configurado':'No configurado')}</div><div class="admin-record-description"><b>Descripción:</b> ${esc(p.description||'Sin descripción.')}${p.videoUrl?`<br><br><b>Enlace de video:</b> ${esc(p.videoUrl)}`:''}</div><div class="admin-record-actions"><button class="btn btn-primary btn-sm" data-detail-edit-product="${p.id}">Editar</button><button class="btn btn-secondary btn-sm" data-detail-stock-product="${p.id}">Inventario</button></div></article>`}).join('')||'<div class="admin-empty-detail">No hay productos registrados.</div>'}</div></section>`;
    bindBack();$('detailAddProduct').onclick=()=>openProductEditor();$('adminContent').querySelectorAll('[data-detail-edit-product]').forEach(b=>b.onclick=()=>openProductEditor(b.dataset.detailEditProduct));$('adminContent').querySelectorAll('[data-detail-stock-product]').forEach(b=>b.onclick=()=>{renderAdminSection('inventory');setTimeout(()=>{if($('inventorySearch')){$('inventorySearch').value=state.products.find(p=>p.id===b.dataset.detailStockProduct)?.name||'';$('inventorySearch').dispatchEvent(new Event('input'))}},0)})
  }

  function adminMetricCombos(){
    const currentValue=state.combos.reduce((s,c)=>s+Number(c.price||0),0);
    const withOld=state.combos.filter(c=>Number(c.oldPrice||0)>Number(c.price||0)).length;
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Combos',`Detalle de los ${state.combos.length} combos publicados, con precios, contenido incluido, imagen e información comercial.`,`<button class="btn btn-primary btn-sm" id="detailAddCombo">Agregar combo</button>`)}${summaryStats([{label:'Combos',value:state.combos.length},{label:'Con ahorro',value:withOld},{label:'Valor publicado',value:money(currentValue)},{label:'Elementos incluidos',value:state.combos.reduce((s,c)=>s+(c.includes||[]).length,0)}])}<div class="admin-record-list">${state.combos.map(c=>`<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><img src="${esc(c.image||'')}" alt=""><div><h3>${esc(c.name)}</h3><p>ID: ${esc(c.id)}${c.badgeText?` · ${esc(c.badgeText)}`:''}</p></div></div><span class="admin-badge ok">Publicado</span></div><div class="admin-record-grid">${field('Precio',money(c.price))}${field('Precio anterior',c.oldPrice?money(c.oldPrice):'—')}${field('Ahorro',c.oldPrice&&c.oldPrice>c.price?money(c.oldPrice-c.price):'—')}${field('Incluye',(c.includes||[]).length+' elementos')}</div><div class="admin-record-description"><b>Descripción:</b> ${esc(c.description||'Sin descripción.')}<br><br><b>Detalles:</b> ${esc(c.details||'Sin detalles ampliados.')}<br><br><b>Incluye:</b> ${esc((c.includes||[]).join(' · ')||'Sin elementos especificados.')}</div><div class="admin-record-actions"><button class="btn btn-primary btn-sm" data-detail-edit-combo="${c.id}">Editar</button></div></article>`).join('')||'<div class="admin-empty-detail">No hay combos registrados.</div>'}</div></section>`;
    bindBack();$('detailAddCombo').onclick=()=>openComboEditor();$('adminContent').querySelectorAll('[data-detail-edit-combo]').forEach(b=>b.onclick=()=>openComboEditor(b.dataset.detailEditCombo));
  }

  function adminMetricCategories(){
    const cats=categories();const max=Math.max(1,...cats.map(c=>state.products.filter(p=>p.category===c).length));
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Categorías','Organización completa del catálogo por categoría, incluyendo productos, inventario y alertas de disponibilidad.')}${summaryStats([{label:'Categorías',value:cats.length},{label:'Productos asignados',value:state.products.length},{label:'Promedio por categoría',value:cats.length?(state.products.length/cats.length).toFixed(1):'0'},{label:'Sin categoría',value:state.products.filter(p=>!p.category).length}])}<div class="admin-record-list">${cats.map(c=>{const list=state.products.filter(p=>p.category===c);const stock=list.reduce((s,p)=>s+Number(p.stock||0),0);const low=list.filter(p=>p.stock>0&&p.stock<=Number(state.settings.lowStock||5)).length;const out=list.filter(p=>p.stock<=0).length;const prices=list.map(p=>Number(p.price||0));return `<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><div><h3>🏷️ ${esc(c)}</h3><p>${list.length} productos asociados</p></div></div><span class="admin-badge ${out?'bad':low?'warn':'ok'}">${out?`${out} agotados`:low?`${low} bajos`:'Estable'}</span></div><div class="admin-record-grid">${field('Productos',list.length)}${field('Stock total',stock)}${field('Stock bajo',low)}${field('Agotados',out)}${field('Precio mínimo',prices.length?money(Math.min(...prices)):'—')}${field('Precio máximo',prices.length?money(Math.max(...prices)):'—')}</div><div class="admin-category-bar"><i style="width:${Math.max(8,list.length/max*100)}%"></i></div><div class="admin-record-description"><b>Productos:</b> ${esc(list.map(p=>p.name).join(' · ')||'Sin productos.')}</div><div class="admin-record-actions"><button class="btn btn-secondary btn-sm" data-open-category="${esc(c)}">Ver productos</button></div></article>`}).join('')||'<div class="admin-empty-detail">No hay categorías.</div>'}</div></section>`;
    bindBack();$('adminContent').querySelectorAll('[data-open-category]').forEach(b=>b.onclick=()=>{renderAdminSection('products');setTimeout(()=>{if($('adminProductSearch')){$('adminProductSearch').value=b.dataset.openCategory;$('adminProductSearch').dispatchEvent(new Event('input'))}},0)});
  }

  function adminMetricUsers(){
    const orderByUser=id=>state.orders.filter(o=>o.userId===id||o.customer?.email===state.users.find(u=>u.id===id)?.email);
    const totalSpend=state.users.reduce((s,u)=>s+orderRevenue(orderByUser(u.id)),0);
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Clientes','Ficha completa de clientes registrados y su relación con pedidos, entregas y compras. Los datos de contraseña no se muestran por seguridad.')}${summaryStats([{label:'Clientes',value:state.users.length},{label:'Con pedidos',value:state.users.filter(u=>orderByUser(u.id).length).length},{label:'Pedidos asociados',value:state.users.reduce((s,u)=>s+orderByUser(u.id).length,0)},{label:'Valor asociado',value:money(totalSpend)}])}<div class="admin-record-list">${state.users.map(u=>{const orders=orderByUser(u.id);const spent=orderRevenue(orders);return `<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><div><h3>👤 ${esc(u.fullName||u.username||'Cliente')}</h3><p>ID: ${esc(u.id)} · Registro: ${fmtDate(u.createdAt)}</p></div></div><span class="admin-badge ok">Cuenta activa</span></div><div class="admin-customer-block">${field('Usuario',u.username)}${field('Correo',u.email)}${field('Teléfono',u.phone)}${field('Departamento',u.department)}${field('Municipio',u.municipality)}${field('Dirección',u.address)}${field('Referencia',u.reference)}${field('Credencial','Protegida · no visible')}</div><div class="admin-record-grid">${field('Pedidos',orders.length)}${field('Total comprado',money(spent))}${field('Último pedido',orders.length?fmtDate(orders[0].createdAt):'—')}${field('Estado cliente',orders.length?'Con actividad':'Sin pedidos')}</div>${orders.length?`<div class="admin-record-description"><b>Pedidos:</b> ${esc(orders.map(o=>`${o.id} · ${money(o.total)} · ${o.status}`).join(' | '))}</div>`:''}</article>`}).join('')||'<div class="admin-empty-detail">No hay clientes registrados.</div>'}</div></section>`;
    bindBack();
  }

  function orderCard(o){
    const c=o.customer||{};const items=o.items||[];
    return `<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><div><h3>🧾 ${esc(o.id)}</h3><p>${esc(c.fullName||'Cliente')} · ${fmtDate(o.createdAt)}</p></div></div><span class="admin-badge ${o.status==='Cancelado'?'bad':o.status==='Entregado'?'ok':'warn'}">${esc(o.status||'Nuevo')}</span></div><div class="admin-customer-block">${field('Cliente',c.fullName)}${field('Correo',c.email)}${field('Teléfono',c.phone)}${field('Departamento',c.department)}${field('Municipio',c.municipality)}${field('Dirección',c.address)}${field('Referencia',c.reference)}${field('Usuario ID',o.userId)}</div><h3 class="admin-subheading">Productos del pedido</h3><div class="admin-items">${items.map(i=>`<div class="admin-item-line"><div><b>${esc(i.name)}</b><span> · ${esc(i.type||'product')}</span></div><span>${Number(i.qty||0)} × ${money(i.price)}</span><b class="item-total">${money(Number(i.qty||0)*Number(i.price||0))}</b></div>`).join('')||'<div class="admin-empty-detail">Sin artículos.</div>'}</div><div class="admin-record-grid">${field('Subtotal',money(o.subtotal??o.total))}${field('Descuento',money(o.discount||0))}${field('Promoción',o.promotion?.code||'—')}${field('Estado',o.status||'Nuevo')}${field('Creado',fmtDate(o.createdAt))}${field('Actualizado',fmtDate(o.updatedAt))}</div>${o.notes?`<div class="admin-record-description"><b>Notas del cliente:</b> ${esc(o.notes)}</div>`:''}<div class="admin-order-total"><span>Total del pedido</span><strong>${money(o.total)}</strong></div><div class="admin-record-actions"><select data-detail-order-status="${esc(o.id)}">${['Nuevo','Confirmado','Preparando','Enviado','Entregado','Cancelado'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" data-detail-copy-order="${esc(o.id)}">Copiar pedido</button></div></article>`;
  }

  function bindOrderDetailActions(){
    $('adminContent').querySelectorAll('[data-detail-order-status]').forEach(s=>s.onchange=()=>{const o=state.orders.find(x=>x.id===s.dataset.detailOrderStatus);if(!o)return;o.status=s.value;o.updatedAt=new Date().toISOString();write(KEYS.orders,state.orders);logActivity('Estado de pedido',`${o.id} → ${o.status}`);toast('Estado actualizado.','success')});
    $('adminContent').querySelectorAll('[data-detail-copy-order]').forEach(b=>b.onclick=()=>{const o=state.orders.find(x=>x.id===b.dataset.detailCopyOrder);if(o){copyText(orderMessage(o));toast('Pedido copiado.','success')}})
  }

  function adminMetricOrders(){
    const total=orderRevenue(state.orders);const pending=state.orders.filter(o=>!['Entregado','Cancelado'].includes(o.status)).length;const delivered=state.orders.filter(o=>o.status==='Entregado').length;
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Pedidos','Información completa de cada solicitud: cliente, dirección, productos, importes, descuentos, estado, fechas y notas.',`<button class="btn btn-secondary btn-sm" id="detailExportOrders">Exportar CSV</button>`)}${summaryStats([{label:'Pedidos',value:state.orders.length},{label:'En proceso',value:pending},{label:'Entregados',value:delivered},{label:'Total registrado',value:money(total)}])}<div class="admin-record-list">${state.orders.map(orderCard).join('')||'<div class="admin-empty-detail">No hay pedidos registrados.</div>'}</div></section>`;
    bindBack();bindOrderDetailActions();$('detailExportOrders').onclick=()=>exportCsv('pedidos',state.orders.map(o=>({id:o.id,cliente:o.customer?.fullName,correo:o.customer?.email,telefono:o.customer?.phone,total:o.total,estado:o.status,fecha:o.createdAt,productos:(o.items||[]).map(i=>`${i.name} x${i.qty}`).join(' | ')})));
  }

  function adminMetricSales(){
    const orders=state.orders;const total=orderRevenue(orders);const delivered=orders.filter(o=>o.status==='Entregado');const cancelled=orders.filter(o=>o.status==='Cancelado');const avg=orders.length?total/orders.length:0;
    const productMap={};orders.forEach(o=>(o.items||[]).forEach(i=>{const key=i.name||i.id;productMap[key]??={qty:0,revenue:0};productMap[key].qty+=Number(i.qty||0);productMap[key].revenue+=Number(i.qty||0)*Number(i.price||0)}));const top=Object.entries(productMap).sort((a,b)=>b[1].revenue-a[1].revenue).slice(0,8);
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Ventas registradas','Análisis de importes registrados en pedidos, ticket promedio, estados y productos con mayor valor acumulado.')}${summaryStats([{label:'Total registrado',value:money(total)},{label:'Ticket promedio',value:money(avg)},{label:'Entregados',value:delivered.length},{label:'Cancelados',value:cancelled.length}])}<h3 class="admin-subheading">Productos con mayor valor registrado</h3><div class="admin-record-list">${top.map(([name,d],idx)=>`<article class="admin-mini-item"><div><b>#${idx+1} · ${esc(name)}</b><small>${d.qty} unidades registradas</small></div><span class="admin-badge ok">${money(d.revenue)}</span></article>`).join('')||'<div class="admin-empty-detail">Todavía no hay datos de ventas.</div>'}</div><h3 class="admin-subheading">Pedidos que componen el total</h3><div class="admin-record-list">${orders.map(o=>`<article class="admin-record"><div class="admin-record-head"><div><h3>${esc(o.id)}</h3><p>${esc(o.customer?.fullName||'Cliente')} · ${fmtDate(o.createdAt)}</p></div><span class="admin-badge ${o.status==='Cancelado'?'bad':o.status==='Entregado'?'ok':'warn'}">${esc(o.status||'Nuevo')}</span></div><div class="admin-record-grid">${field('Subtotal',money(o.subtotal??o.total))}${field('Descuento',money(o.discount||0))}${field('Total',money(o.total))}${field('Artículos',itemCount([o]))}</div></article>`).join('')||'<div class="admin-empty-detail">No hay pedidos registrados.</div>'}</div></section>`;
    bindBack();
  }

  function adminMetricStock(filter){
    const lowLimit=Number(state.settings.lowStock||5);const isOut=filter==='out';const list=state.products.filter(p=>isOut?Number(p.stock||0)<=0:Number(p.stock||0)>0&&Number(p.stock||0)<=lowLimit);const title=isOut?'Productos agotados':'Productos con stock bajo';
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader(title,isOut?'Productos sin existencias. No pueden agregarse al carrito hasta recuperar inventario.':`Productos con existencias iguales o inferiores al límite configurado (${lowLimit}).`)}${summaryStats([{label:isOut?'Agotados':'Stock bajo',value:list.length},{label:'Unidades totales',value:list.reduce((s,p)=>s+Number(p.stock||0),0)},{label:'Límite de alerta',value:lowLimit},{label:'Valor de inventario',value:money(list.reduce((s,p)=>s+Number(p.stock||0)*Number(p.price||0),0))}])}<div class="admin-record-list">${list.map(p=>`<article class="admin-record"><div class="admin-record-head"><div class="admin-record-title"><img src="${esc(p.image||'')}" alt=""><div><h3>${esc(p.name)}</h3><p>${esc(p.category)} · ${money(p.price)}</p></div></div><span class="admin-badge ${isOut?'bad':'warn'}">${isOut?'Agotado':`${p.stock} unidades`}</span></div><div class="admin-record-grid">${field('Stock actual',p.stock)}${field('Precio',money(p.price))}${field('Valor en stock',money(Number(p.stock||0)*Number(p.price||0)))}${field('Estado',isOut?'No disponible':'Pocas unidades')}</div><div class="admin-record-actions"><button class="btn btn-primary btn-sm" data-stock-set="${p.id}">Definir stock</button><button class="btn btn-secondary btn-sm" data-stock-plus="${p.id}">+1 unidad</button></div></article>`).join('')||`<div class="admin-empty-detail">${isOut?'No hay productos agotados.':'No hay productos con stock bajo.'}</div>`}</div></section>`;
    bindBack();$('adminContent').querySelectorAll('[data-stock-set]').forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>x.id===b.dataset.stockSet);const n=await npPrompt(`Existencias para ${p.name}`,p.stock);if(n===null||isNaN(Number(n)))return;p.stock=Math.max(0,Number(n));write(KEYS.products,state.products);purgeUnavailableCart(true);adminMetricStock(filter);renderStore()});$('adminContent').querySelectorAll('[data-stock-plus]').forEach(b=>b.onclick=()=>{const p=state.products.find(x=>x.id===b.dataset.stockPlus);p.stock=Math.max(0,Number(p.stock||0)+1);write(KEYS.products,state.products);purgeUnavailableCart(true);adminMetricStock(filter);renderStore()});
  }

  function adminMetricFaqs(){
    $('adminContent').innerHTML=`<section class="admin-card" style="margin-top:0">${backHeader('Preguntas frecuentes','Contenido completo de ayuda pública que aparece en la tienda. Puedes revisar, editar o eliminar cada respuesta.',`<button class="btn btn-primary btn-sm" id="detailAddFaq">Agregar pregunta</button>`)}${summaryStats([{label:'Preguntas',value:state.faqs.length},{label:'Publicadas',value:state.faqs.length},{label:'Con respuesta',value:state.faqs.filter(f=>f.a?.trim()).length},{label:'Sin respuesta',value:state.faqs.filter(f=>!f.a?.trim()).length}])}<div class="admin-record-list">${state.faqs.map((f,i)=>`<article class="admin-record"><div class="admin-record-head"><div><h3>${i+1}. ${esc(f.q)}</h3><p>ID: ${esc(f.id)}</p></div><span class="admin-badge ok">Publicada</span></div><div class="admin-record-description"><b>Respuesta completa:</b><br>${esc(f.a||'Sin respuesta.')}</div><div class="admin-record-actions"><button class="btn btn-primary btn-sm" data-detail-edit-faq="${f.id}">Editar</button><button class="btn btn-red btn-sm" data-detail-delete-faq="${f.id}">Eliminar</button></div></article>`).join('')||'<div class="admin-empty-detail">No hay preguntas frecuentes.</div>'}</div></section>`;
    bindBack();$('detailAddFaq').onclick=()=>openFaqEditor();$('adminContent').querySelectorAll('[data-detail-edit-faq]').forEach(b=>b.onclick=()=>openFaqEditor(b.dataset.detailEditFaq));$('adminContent').querySelectorAll('[data-detail-delete-faq]').forEach(b=>b.onclick=async()=>{if(!await npConfirm('¿Eliminar esta pregunta?'))return;state.faqs=state.faqs.filter(f=>f.id!==b.dataset.detailDeleteFaq);write(KEYS.faqs,state.faqs);renderFaqs();adminMetricFaqs()});
  }

  const renderAdminSectionV97Base=renderAdminSection;
  renderAdminSection=function(section){
    const custom={
      'metric-products':()=>adminMetricProducts(),
      'metric-combos':()=>adminMetricCombos(),
      'metric-categories':()=>adminMetricCategories(),
      'metric-users':()=>adminMetricUsers(),
      'metric-orders':()=>adminMetricOrders(),
      'metric-sales':()=>adminMetricSales(),
      'metric-low-stock':()=>adminMetricStock('low'),
      'metric-out-stock':()=>adminMetricStock('out'),
      'metric-faqs':()=>adminMetricFaqs()
    };
    if(custom[section]){
      state.adminSection=section;
      renderAdminNav();
      const titles={'metric-products':'Productos','metric-combos':'Combos','metric-categories':'Categorías','metric-users':'Clientes','metric-orders':'Pedidos','metric-sales':'Ventas','metric-low-stock':'Stock bajo','metric-out-stock':'Agotados','metric-faqs':'FAQ'};
      $('adminTitle').textContent=titles[section]||'Detalle';
      custom[section]();
      return;
    }
    renderAdminSectionV97Base(section);
  };

  const adminDashboardV97Base=adminDashboard;
  adminDashboard=function(){
    adminDashboardV97Base();
    $('adminContent').querySelectorAll('[data-metric-target]').forEach(card=>{
      const open=()=>renderAdminSection(card.dataset.metricTarget);
      card.onclick=open;
      card.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}};
    });
  };
})();
</script>

<script>
/* CRULOX v9.8 — arquitectura administrativa jerárquica */
(function(){
  const ADMIN_GROUPS={
    home:{label:'Inicio',icon:'⌂',desc:'Acceso principal y estado general.',items:[
      {section:'dashboard',icon:'📊',label:'Resumen',desc:'Indicadores clave de toda la tienda.'}
    ]},
    catalog:{label:'Catálogo',icon:'▦',desc:'Todo lo relacionado con lo que vendes.',items:[
      {section:'products',icon:'📦',label:'Productos',desc:'Crear, editar, duplicar y eliminar productos.'},
      {section:'combos',icon:'🎁',label:'Combos',desc:'Administrar paquetes y ofertas combinadas.'},
      {section:'inventory',icon:'📋',label:'Inventario',desc:'Existencias, stock bajo y agotados.'},
      {section:'categories',icon:'🏷️',label:'Categorías',desc:'Organizar el catálogo por categorías.'}
    ]},
    operation:{label:'Operación',icon:'↗',desc:'Pedidos, ventas, promociones y existencias críticas.',items:[
      {section:'orders',icon:'🧾',label:'Pedidos',desc:'Seguimiento completo de solicitudes.'},
      {section:'metric-sales',icon:'💰',label:'Ventas',desc:'Importes registrados y rendimiento.'},
      {section:'promotions',icon:'🎟️',label:'Promociones',desc:'Códigos, descuentos y condiciones.'},
      {section:'metric-low-stock',icon:'⚠️',label:'Stock bajo',desc:'Productos que requieren reposición.'},
      {section:'metric-out-stock',icon:'⛔',label:'Agotados',desc:'Productos sin existencias.'}
    ]},
    customers:{label:'Clientes',icon:'◎',desc:'Usuarios, datos y relación comercial.',items:[
      {section:'users',icon:'👥',label:'Clientes',desc:'Perfiles registrados y pedidos asociados.'}
    ]},
    content:{label:'Contenido',icon:'✦',desc:'Información pública, ayuda e identidad de la tienda.',items:[
      {section:'faqs',icon:'❓',label:'Preguntas frecuentes',desc:'Contenido de ayuda que ve el cliente.'},
      {section:'settings',icon:'🏪',label:'Tienda',desc:'Identidad, textos, redes y configuración comercial.'},
      {section:'bots',icon:'💬',label:'Atención',desc:'Canal de consultas y soporte al cliente.'}
    ]},
    system:{label:'Sistema',icon:'⚙',desc:'Control técnico y continuidad operativa.',items:[
      {section:'backup',icon:'💾',label:'Respaldos',desc:'Exportar, importar y restaurar información.'},
      {section:'activity',icon:'🕘',label:'Actividad',desc:'Historial de acciones administrativas.'}
    ]}
  };

  const SECTION_GROUP={};
  Object.entries(ADMIN_GROUPS).forEach(([g,data])=>data.items.forEach(i=>SECTION_GROUP[i.section]=g));
  Object.assign(SECTION_GROUP,{
    'metric-products':'catalog','metric-combos':'catalog','metric-categories':'catalog',
    'metric-users':'customers','metric-orders':'operation','metric-sales':'operation',
    'metric-low-stock':'operation','metric-out-stock':'operation','metric-faqs':'content'
  });

  const SECTION_TITLES={
    home:'Administración',dashboard:'Resumen',products:'Productos',combos:'Combos',inventory:'Inventario',categories:'Categorías',
    orders:'Pedidos',promotions:'Promociones',users:'Clientes',faqs:'Preguntas frecuentes',settings:'Tienda',bots:'Atención',
    backup:'Respaldos',activity:'Actividad','metric-products':'Productos','metric-combos':'Combos','metric-categories':'Categorías',
    'metric-users':'Clientes','metric-orders':'Pedidos','metric-sales':'Ventas','metric-low-stock':'Stock bajo','metric-out-stock':'Agotados','metric-faqs':'FAQ'
  };

  const css=document.createElement('style');
  css.id='np-admin-v98-style';
  css.textContent=`
    /* Estructura base: una sola columna y navegación jerárquica */
    .admin-overlay{background:#030914!important;color:#edf6ff}
    .admin-shell{display:grid!important;grid-template-columns:1fr!important;height:100%!important;background:#030914!important}
    .admin-sidebar{position:relative!important;top:auto!important;z-index:20!important;width:100%!important;padding:0!important;display:block!important;overflow:visible!important;border:0!important;border-bottom:1px solid rgba(122,193,255,.09)!important;background:linear-gradient(180deg,#071522 0%,#05101b 100%)!important;box-shadow:0 10px 28px rgba(0,0,0,.22)!important}
    .admin-brand-row{display:flex;align-items:center;justify-content:space-between;gap:14px;max-width:1240px;margin:auto;padding:13px 18px 9px}
    .admin-brand{width:205px!important;height:48px!important;margin:0!important;object-fit:contain!important;filter:drop-shadow(0 7px 16px rgba(0,210,255,.16))}
    .admin-brand-meta{display:flex;align-items:center;gap:8px;color:#8098b3;font-size:.62rem;font-weight:800}
    .admin-brand-status{width:8px;height:8px;border-radius:50%;background:#1de27a;box-shadow:0 0 0 4px rgba(29,226,122,.1)}
    .admin-nav{max-width:1240px!important;width:100%!important;margin:auto!important;padding:7px 18px 14px!important;display:grid!important;grid-template-columns:repeat(6,minmax(0,1fr))!important;gap:8px!important}
    .admin-nav button{min-width:0!important;min-height:50px!important;padding:9px 10px!important;border-radius:15px!important;border:1px solid rgba(122,193,255,.075)!important;background:rgba(255,255,255,.025)!important;color:#adc2da!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;text-align:center!important;font-size:.68rem!important;font-weight:850!important;box-shadow:none!important;white-space:nowrap!important}
    .admin-nav button .np-admin-menu-icon{font-size:.88rem;opacity:.9}
    .admin-nav button:hover{border-color:rgba(0,211,255,.16)!important;background:rgba(0,211,255,.05)!important;color:#e8f9ff!important}
    .admin-nav button.active{color:#03101c!important;background:linear-gradient(135deg,#18d8ff,#2789ff)!important;border-color:rgba(255,255,255,.18)!important;box-shadow:0 9px 22px rgba(0,169,255,.2)!important}

    .admin-main{min-width:0!important;overflow:auto!important;background:radial-gradient(circle at 50% -8%,rgba(0,201,255,.055),transparent 30%),#030914!important}
    .admin-top{position:sticky!important;top:0!important;z-index:15!important;min-height:58px!important;padding:8px 18px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;background:rgba(3,9,20,.94)!important;backdrop-filter:blur(18px)!important;border-bottom:1px solid rgba(122,193,255,.07)!important}
    .admin-top .section-kicker{display:none!important}
    .admin-top h1{font-size:.92rem!important;font-weight:850!important;color:#dceaff!important;letter-spacing:0!important}
    .admin-top .toolbar{display:flex!important;gap:7px!important;width:auto!important}
    .admin-top .btn{min-height:34px!important;padding:7px 11px!important;font-size:.58rem!important;border-radius:11px!important;width:auto!important}
    .admin-content{max-width:1240px!important;width:100%!important;margin:0 auto!important;padding:14px 18px 34px!important}

    /* Breadcrumb + segundo nivel */
    .np-admin-breadcrumb{max-width:1240px;margin:0 auto;padding:13px 18px 0;color:#6f89a5;font-size:.58rem;display:flex;align-items:center;gap:7px;white-space:nowrap;overflow:hidden}
    .np-admin-breadcrumb b{color:#bcd1e7;font-weight:850;overflow:hidden;text-overflow:ellipsis}
    .np-admin-subnav-wrap{max-width:1240px;margin:0 auto;padding:10px 18px 2px}
    .np-admin-subnav{display:flex;gap:7px;overflow-x:auto;padding-bottom:7px;scrollbar-width:none}
    .np-admin-subnav::-webkit-scrollbar{display:none}
    .np-admin-subnav button{flex:0 0 auto;min-height:37px;border-radius:12px;border:1px solid rgba(120,191,255,.08);background:#0a1727;color:#9eb7d1;padding:7px 11px;font-size:.61rem;font-weight:850;white-space:nowrap}
    .np-admin-subnav button.active{background:rgba(0,211,255,.1);color:#38ddff;border-color:rgba(0,211,255,.18)}

    /* Tercer nivel: acciones de contexto */
    .np-admin-context{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:0 0 12px;padding:9px;border:1px solid rgba(120,191,255,.07);border-radius:15px;background:rgba(255,255,255,.018)}
    .np-admin-context-label{font-size:.55rem;color:#68839f;font-weight:900;text-transform:uppercase;letter-spacing:.1em;margin-right:2px}
    .np-admin-context button{border:0;border-radius:10px;background:#0b1a2c;color:#b6cbe2;padding:7px 10px;font-size:.57rem;font-weight:850;min-height:32px}
    .np-admin-context button.primary{background:linear-gradient(135deg,#16d7fa,#2587ff);color:#03101c}
    .np-admin-context button.danger{background:rgba(255,87,126,.08);color:#ff819e}

    /* Inicio / directorio */
    .np-admin-home{display:grid;gap:14px}
    .np-admin-welcome{padding:18px 19px;border-radius:21px;border:1px solid rgba(119,193,255,.09);background:linear-gradient(145deg,#0a1a2d,#071421);display:flex;align-items:center;justify-content:space-between;gap:16px}
    .np-admin-welcome h2{font-size:1.03rem;line-height:1.25;margin:0 0 5px}
    .np-admin-welcome p{font-size:.65rem;line-height:1.55;color:#8fa8c3;margin:0;max-width:690px}
    .np-admin-welcome .np-admin-now{flex:0 0 auto;padding:8px 11px;border-radius:999px;background:rgba(30,226,122,.08);border:1px solid rgba(30,226,122,.13);color:#65f1ab;font-size:.58rem;font-weight:900}
    .np-admin-menu-title{display:flex;align-items:end;justify-content:space-between;gap:10px;padding:1px 2px}
    .np-admin-menu-title h3{font-size:.83rem;margin:0}
    .np-admin-menu-title span{color:#6f89a4;font-size:.56rem}
    .np-admin-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .np-admin-group-card{position:relative;overflow:hidden;min-height:142px;padding:15px;border-radius:19px;border:1px solid rgba(121,193,255,.08);background:linear-gradient(145deg,#0a1a2c,#071421);text-align:left;color:#e9f4ff;display:grid;grid-template-rows:auto 1fr auto;gap:9px;box-shadow:0 10px 25px rgba(0,0,0,.12)}
    .np-admin-group-card::after{content:"";position:absolute;width:100px;height:100px;border-radius:50%;right:-42px;top:-45px;background:radial-gradient(circle,rgba(0,211,255,.12),transparent 68%)}
    .np-admin-group-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
    .np-admin-group-icon{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:rgba(0,211,255,.07);border:1px solid rgba(0,211,255,.1);color:#2edcff;font-size:.9rem}
    .np-admin-group-count{font-size:.53rem;color:#6683a0;font-weight:850}
    .np-admin-group-card h4{font-size:.83rem;margin:0 0 4px}
    .np-admin-group-card p{font-size:.59rem;line-height:1.5;color:#8fa8c3;margin:0}
    .np-admin-group-go{font-size:.56rem;font-weight:900;color:#35dfff}
    .np-admin-group-card:hover{transform:translateY(-1px);border-color:rgba(0,211,255,.17);background:linear-gradient(145deg,#0b2034,#071624)}

    /* Landing de cada área */
    .np-admin-area{display:grid;gap:13px}
    .np-admin-area-head{padding:16px 17px;border-radius:19px;border:1px solid rgba(119,193,255,.08);background:#081625}
    .np-admin-area-head h2{font-size:.98rem;margin:0 0 5px}
    .np-admin-area-head p{color:#8ba4bf;font-size:.63rem;line-height:1.55;margin:0}
    .np-admin-area-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    .np-admin-area-link{min-height:100px;padding:13px;border-radius:17px;border:1px solid rgba(121,193,255,.08);background:rgba(255,255,255,.022);color:#e9f4ff;text-align:left;display:grid;grid-template-columns:40px 1fr auto;align-items:center;gap:11px}
    .np-admin-area-link i{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;font-style:normal;background:rgba(0,211,255,.07);font-size:.95rem}
    .np-admin-area-link b{display:block;font-size:.73rem;margin-bottom:4px}
    .np-admin-area-link small{display:block;font-size:.57rem;line-height:1.45;color:#849eb9}
    .np-admin-area-link em{font-style:normal;color:#2fdcff;font-size:.85rem}

    /* Resumen: sin hero gigante */
    .np-admin-summary-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
    .np-admin-summary-head h2{font-size:.9rem;margin:0}
    .np-admin-summary-head p{font-size:.57rem;color:#7893ae;margin-top:3px}
    .admin-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:9px!important;margin-top:0!important}
    .metric{min-height:100px!important;padding:12px!important;border-radius:17px!important;background:linear-gradient(145deg,#0a1b2e,#071522)!important;border:1px solid rgba(120,191,255,.075)!important;box-shadow:none!important;cursor:pointer}
    .metric::before{height:1px!important;opacity:.65}
    .metric-top{margin-bottom:7px!important}
    .metric-icon{width:32px!important;height:32px!important;border-radius:10px!important;font-size:.78rem!important}
    .metric small{font-size:.57rem!important}
    .metric strong{font-size:1.2rem!important}
    .metric-note{font-size:.52rem!important;margin-top:4px!important}
    .np-admin-summary-row{display:grid;grid-template-columns:1.1fr .9fr;gap:10px;margin-top:10px}

    /* Paneles internos */
    .admin-card{padding:14px!important;border-radius:18px!important;background:#081625!important;border:1px solid rgba(120,191,255,.075)!important;box-shadow:none!important}
    .admin-card-head{margin-bottom:10px!important;gap:8px!important;flex-wrap:wrap}
    .admin-card h2{font-size:.84rem!important}
    .admin-card-sub{font-size:.58rem!important;line-height:1.5!important}
    .toolbar{gap:6px!important}
    .toolbar input,.toolbar select{min-height:34px!important;font-size:.6rem!important;border-radius:10px!important;background:#0a1929!important}
    .btn{border-radius:11px!important}
    .btn-sm{min-height:32px!important;padding:6px 9px!important;font-size:.55rem!important}
    .admin-list{gap:7px!important}
    .admin-list-item{padding:10px!important;border-radius:14px!important;background:rgba(255,255,255,.02)!important}
    .admin-list-item h3{font-size:.68rem!important}.admin-list-item p{font-size:.56rem!important}
    .table-wrap{border-radius:14px!important;background:#071421!important}
    th,td{padding:9px!important;font-size:.59rem!important}th{background:#0a192a!important}
    .status{font-size:.52rem!important}
    .notice{font-size:.62rem!important;line-height:1.55!important;border-radius:15px!important;padding:11px!important}

    @media(max-width:900px){
      .admin-brand-row{padding:10px 12px 7px}.admin-brand{width:175px!important;height:42px!important}
      .admin-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important;padding:7px 12px 11px!important;gap:6px!important}
      .admin-nav button{min-height:44px!important;font-size:.62rem!important;border-radius:13px!important}
      .admin-content{padding:11px 12px 28px!important}.admin-top{padding:7px 12px!important;min-height:52px!important}
      .np-admin-breadcrumb{padding:10px 12px 0}.np-admin-subnav-wrap{padding:8px 12px 0}
      .np-admin-groups{grid-template-columns:repeat(2,minmax(0,1fr))}
      .admin-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
      .np-admin-summary-row{grid-template-columns:1fr}
    }
    @media(max-width:560px){
      .admin-brand-meta{display:none}.admin-brand{width:160px!important;height:39px!important}
      .admin-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important}
      .admin-nav button{padding:7px 4px!important;gap:4px!important;font-size:.56rem!important;min-height:42px!important}
      .admin-nav button .np-admin-menu-icon{font-size:.76rem}
      .admin-top h1{font-size:.8rem!important}.admin-top .btn{font-size:.52rem!important;padding:6px 8px!important}
      .np-admin-welcome{padding:14px;align-items:flex-start;flex-direction:column}.np-admin-welcome .np-admin-now{align-self:flex-start}
      .np-admin-groups{grid-template-columns:1fr 1fr;gap:8px}.np-admin-group-card{min-height:132px;padding:12px;border-radius:16px}
      .np-admin-group-card h4{font-size:.73rem}.np-admin-group-card p{font-size:.54rem}
      .np-admin-area-grid{grid-template-columns:1fr}.np-admin-area-link{min-height:86px}
      .np-admin-context{padding:7px;gap:5px}.np-admin-context-label{width:100%}.np-admin-context button{font-size:.53rem;padding:6px 8px;min-height:29px}
      .metric{min-height:92px!important;padding:10px!important}.metric strong{font-size:1.05rem!important}
      .admin-card{padding:11px!important}.admin-card-head .toolbar{width:100%}.admin-card-head .toolbar input,.admin-card-head .toolbar select{flex:1;min-width:0}
    }
    @media(max-width:360px){
      .admin-nav{grid-template-columns:repeat(2,minmax(0,1fr))!important}
      .np-admin-groups{grid-template-columns:1fr}
    }
  `;
  document.head.appendChild(css);

  function ensureAdminChrome(){
    const aside=document.querySelector('.admin-sidebar');
    if(!aside)return;
    if(!aside.querySelector('.admin-brand-row')){
      const brand=aside.querySelector('.admin-brand');
      const row=document.createElement('div');row.className='admin-brand-row';
      brand.parentNode.insertBefore(row,brand);row.appendChild(brand);
      const meta=document.createElement('div');meta.className='admin-brand-meta';meta.innerHTML='<span class="admin-brand-status"></span><span>Administración CRULOX</span>';row.appendChild(meta);
    }
    let breadcrumb=document.getElementById('adminBreadcrumb');
    if(!breadcrumb){breadcrumb=document.createElement('div');breadcrumb.id='adminBreadcrumb';breadcrumb.className='np-admin-breadcrumb';document.querySelector('.admin-main').insertBefore(breadcrumb,document.querySelector('.admin-top').nextSibling)}
    let sub=document.getElementById('adminSubnavWrap');
    if(!sub){sub=document.createElement('div');sub.id='adminSubnavWrap';sub.className='np-admin-subnav-wrap';breadcrumb.insertAdjacentElement('afterend',sub)}
  }

  function currentGroup(section=state.adminSection){const s=String(section||'');if(s.startsWith('group:'))return s.slice(6);return SECTION_GROUP[s]||'home'}
  function renderPrimaryNav(){
    ensureAdminChrome();
    const group=currentGroup();
    $('adminNav').innerHTML=Object.entries(ADMIN_GROUPS).map(([key,g])=>`<button type="button" data-admin-group="${key}" class="${key===group?'active':''}"><span class="np-admin-menu-icon">${g.icon}</span><span>${g.label}</span></button>`).join('');
    $('adminNav').onclick=e=>{const b=e.target.closest('[data-admin-group]');if(!b)return;openAdminGroup(b.dataset.adminGroup)};
  }

  function renderBreadcrumb(section=state.adminSection){
    ensureAdminChrome();
    const g=currentGroup(section),gd=ADMIN_GROUPS[g];
    const title=SECTION_TITLES[section]||gd.label;
    $('adminBreadcrumb').innerHTML=section==='home'?`<span>Panel administrativo</span><span>›</span><b>Inicio</b>`:`<span>Panel administrativo</span><span>›</span><span>${gd.label}</span><span>›</span><b>${title}</b>`;
  }

  function renderSubnav(section=state.adminSection){
    ensureAdminChrome();
    const group=currentGroup(section),data=ADMIN_GROUPS[group];
    if(group==='home'){$('adminSubnavWrap').innerHTML='';return}
    $('adminSubnavWrap').innerHTML=`<nav class="np-admin-subnav">${data.items.map(i=>`<button type="button" data-admin-sub="${i.section}" class="${i.section===section?'active':''}">${i.icon} ${i.label}</button>`).join('')}</nav>`;
    $('adminSubnavWrap').onclick=e=>{const b=e.target.closest('[data-admin-sub]');if(b)renderAdminSection(b.dataset.adminSub)};
  }

  function contextActions(section){
    const map={
      dashboard:[['catalog','Abrir catálogo',''],['orders','Ver pedidos',''],['activity','Actividad','']],
      products:[['add-product','Nuevo producto','primary'],['inventory','Inventario',''],['categories','Categorías','']],
      combos:[['add-combo','Nuevo combo','primary'],['products','Productos','']],
      inventory:[['inventory','Todos','primary'],['metric-low-stock','Stock bajo',''],['metric-out-stock','Agotados','']],
      categories:[['products','Productos',''],['add-product','Nuevo producto','primary']],
      orders:[['orders','Todos','primary'],['metric-sales','Ventas',''],['users','Clientes','']],
      users:[['orders','Pedidos',''],['metric-sales','Ventas','']],
      promotions:[['orders','Pedidos',''],['metric-sales','Ventas','']],
      faqs:[['add-faq','Nueva pregunta','primary'],['settings','Tienda','']],
      settings:[['faqs','FAQ',''],['bots','Atención','']],
      bots:[['settings','Tienda','']],
      backup:[['activity','Actividad','']],
      activity:[['backup','Respaldos','']]
    };
    const actions=map[section]||[];
    if(!actions.length)return '';
    return `<div class="np-admin-context"><span class="np-admin-context-label">Acciones</span>${actions.map(([id,label,kind])=>`<button type="button" class="${kind}" data-admin-action="${id}">${label}</button>`).join('')}</div>`;
  }

  function bindContext(section){
    const host=$('adminContent');if(!host)return;
    const ctx=host.querySelector('.np-admin-context');if(!ctx)return;
    ctx.onclick=e=>{
      const b=e.target.closest('[data-admin-action]');if(!b)return;const a=b.dataset.adminAction;
      if(a==='add-product')return openProductEditor();
      if(a==='add-combo')return openComboEditor();
      if(a==='add-faq')return openFaqEditor();
      if(a==='catalog')return openAdminGroup('catalog');
      renderAdminSection(a);
    };
  }

  function injectContext(section){
    if(section==='home')return;
    const html=contextActions(section);if(!html)return;
    const host=$('adminContent');
    if(host&&!host.querySelector('.np-admin-context'))host.insertAdjacentHTML('afterbegin',html);
    bindContext(section);
  }

  function openAdminGroup(group){
    if(group==='home')return renderAdminSection('home');
    const data=ADMIN_GROUPS[group];if(!data)return renderAdminSection('home');
    state.adminSection=`group:${group}`;
    renderPrimaryNav();renderBreadcrumb(data.items[0]?.section||'home');
    $('adminSubnavWrap').innerHTML='';
    $('adminTitle').textContent=data.label;
    $('adminContent').innerHTML=`<section class="np-admin-area"><header class="np-admin-area-head"><h2>${data.icon} ${data.label}</h2><p>${data.desc}</p></header><div class="np-admin-area-grid">${data.items.map(i=>`<button type="button" class="np-admin-area-link" data-area-section="${i.section}"><i>${i.icon}</i><span><b>${i.label}</b><small>${i.desc}</small></span><em>›</em></button>`).join('')}</div></section>`;
    $('adminContent').onclick=e=>{const b=e.target.closest('[data-area-section]');if(b)renderAdminSection(b.dataset.areaSection)};
  }

  function renderAdminHome(){
    state.adminSection='home';renderPrimaryNav();renderBreadcrumb('home');renderSubnav('home');$('adminTitle').textContent='Administración';
    $('adminContent').innerHTML=`<section class="np-admin-home"><div class="np-admin-welcome"><div><h2>Centro de administración</h2><p>Elige primero el área en la que quieres trabajar. Cada menú contiene únicamente las herramientas relacionadas, para que el panel sea rápido, predecible y fácil de usar.</p></div><span class="np-admin-now">● Sesión administrativa activa</span></div><div class="np-admin-menu-title"><h3>Áreas principales</h3><span>6 áreas organizadas por función</span></div><div class="np-admin-groups">${Object.entries(ADMIN_GROUPS).filter(([k])=>k!=='home').map(([key,g])=>`<button type="button" class="np-admin-group-card" data-home-group="${key}"><div class="np-admin-group-head"><span class="np-admin-group-icon">${g.icon}</span><span class="np-admin-group-count">Abrir</span></div><div><h4>${g.label}</h4><p>${g.desc}</p></div><span class="np-admin-group-go">Abrir área →</span></button>`).join('')}</div></section>`;
    $('adminContent').onclick=e=>{const b=e.target.closest('[data-home-group]');if(b)openAdminGroup(b.dataset.homeGroup)};
  }

  const baseRenderAdminSection=renderAdminSection;
  renderAdminSection=function(section){
    if(section==='home')return renderAdminHome();
    if(String(section).startsWith('group:'))return openAdminGroup(String(section).slice(6));
    baseRenderAdminSection(section);
    renderPrimaryNav();renderBreadcrumb(section);renderSubnav(section);injectContext(section);
    $('adminTitle').textContent=SECTION_TITLES[section]||'Administración';
  };

  renderAdminNav=function(){renderPrimaryNav()};

  const baseAdminDashboard=adminDashboard;
  adminDashboard=function(){
    const sales=state.orders.reduce((s,o)=>s+Number(o.total||0),0);
    const low=state.products.filter(p=>Number(p.stock||0)>0&&Number(p.stock||0)<=Number(state.settings.lowStock||5)).length;
    const out=state.products.filter(p=>Number(p.stock||0)<=0).length;
    $('adminContent').innerHTML=`<div class="np-