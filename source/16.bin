<script id="cruzclick-v392-runtime-navigation">
(()=>{
'use strict';const D=document;D.addEventListener('click',e=>{const r=e.target?.closest?.('.cc390-renewal-row');if(!r)return;e.preventDefault();e.stopPropagation();const oid=r.dataset.renewalOrder||'';if(oid&&typeof dashboardDetail==='function')dashboardDetail('order',oid);},true);window.CRUZCLICK_V392=Object.freeze({version:'3.9.2',panelDetailWindows:true,renewalCenter:true});try{setTimeout(syncRenewalNotifications392,700);setInterval(()=>{if(!document.hidden)syncRenewalNotifications392();},300000)}catch(e){}})();
</script>
