}

@media(max-width:420px){
  #adminOverlay .cc405-sidebar{
    top:5px !important;
    height:calc(100dvh - 10px) !important;
    max-height:calc(100dvh - 10px) !important;
  }
}
</style>

<script id="cruzclick-v407-menu-scroll-guard">
(function(){
  'use strict';

  function prepareMenu(menu){
    if(!menu || menu.dataset.cc407Ready==='1') return;
    menu.dataset.cc407Ready='1';

    /* Evita que el desplazamiento interno "salte" hacia el contenedor exterior */
    menu.addEventListener('wheel', function(e){
      const atTop = menu.scrollTop <= 0;
      const atBottom = Math.ceil(menu.scrollTop + menu.clientHeight) >= menu.scrollHeight;
      if((e.deltaY < 0 && atTop) || (e.deltaY > 0 && atBottom)){
        e.stopPropagation();
      }
    }, {passive:true});
  }

  function boot(){
    document.querySelectorAll('#adminOverlay .cc405-menu').forEach(prepareMenu);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded', boot, {once:true});
  }else{
    boot();
  }

  new MutationObserver(boot).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>






