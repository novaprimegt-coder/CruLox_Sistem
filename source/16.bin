  margin-top:10px;
}
#adminOverlay .cc405-menu{
  padding:10px;
  display:grid;
  gap:8px;
  max-height:calc(100dvh - 160px);
  overflow:auto;
}
#adminOverlay .cc405-menu button,
#adminOverlay .cc405-top-toggle,
#adminOverlay .cc405-module,
#adminOverlay .cc405-line,
#adminOverlay .cc405-modchip,
#adminOverlay .cc405-btn{
  -webkit-tap-highlight-color:transparent;
  touch-action:manipulation;
}
#adminOverlay .cc405-menu button{
  width:100%;
  padding:9px;
  border-radius:18px;
  border:1px solid rgba(117,220,255,.08);
  background:linear-gradient(145deg,rgba(12,31,47,.94),rgba(5,15,25,.98));
  display:grid;
  grid-template-columns:40px minmax(0,1fr);
  gap:8px;
  align-items:center;
  cursor:pointer;
  color:#ebfaff;
  text-align:left;
}
#adminOverlay .cc405-menu button:hover,
#adminOverlay .cc405-menu button:focus-visible,
#adminOverlay .cc405-module:hover,
#adminOverlay .cc405-line:hover,
#adminOverlay .cc405-modchip:hover,
#adminOverlay .cc405-btn:hover,
#adminOverlay .cc405-top-toggle:hover{
  border-color:rgba(0,224,255,.22);
  transform:translateY(-1px);
}
#adminOverlay .cc405-menu b,
#adminOverlay .cc405-module b,
#adminOverlay .cc405-line b,
#adminOverlay .cc405-modchip b{
  display:block;
  color:#f3fbff;
}
#adminOverlay .cc405-menu b{font-size:.53rem;line-height:1.12}
#adminOverlay .cc405-menu .meta{font-size:.39rem;line-height:1.24;margin-top:3px}
#adminOverlay .cc405-ico,
#adminOverlay .cc405-modicon,
#adminOverlay .cc405-chip-ico,
#adminOverlay .cc405-top-toggle .ico,
#adminOverlay .cc405-btn .ico{
  width:40px;height:40px;border-radius:13px;display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.14),rgba(79,120,255,.08));
  border:1px solid rgba(0,224,255,.17);
  color:#79f1ff;
  flex:0 0 auto;
}
#adminOverlay .cc405-ico svg,
#adminOverlay .cc405-modicon svg,
#adminOverlay .cc405-chip-ico svg,
#adminOverlay .cc405-top-toggle .ico svg,
#adminOverlay .cc405-btn .ico svg{
  width:20px;height:20px;display:block;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round;
}
#adminOverlay .cc405-main{
  border-radius:26px;
  overflow:hidden;
  min-width:0;
}
#adminOverlay .cc405-main-head{padding:14px 14px 12px;border-bottom:1px solid rgba(117,220,255,.08)}
#adminOverlay .cc405-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
#adminOverlay .cc405-top-toggle,
#adminOverlay .cc405-btn{
  display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border-radius:16px;
  border:1px solid rgba(117,220,255,.10);background:linear-gradient(145deg,rgba(10,28,43,.95),rgba(6,17,28,.99));
  color:#ebfbff;cursor:pointer;font-weight:800;font-size:.50rem;
}
#adminOverlay .cc405-top-toggle .ico,
#adminOverlay .cc405-btn .ico{width:30px;height:30px;border-radius:11px}
#adminOverlay .cc405-dots{display:inline-flex;gap:6px}
#adminOverlay .cc405-dots i{width:8px;height:8px;border-radius:50%;display:block}
#adminOverlay .cc405-dots i:nth-child(1){background:#ff6474}
#adminOverlay .cc405-dots i:nth-child(2){background:#ffd166}
#adminOverlay .cc405-dots i:nth-child(3){background:#3cdc8c}
#adminOverlay .cc405-main-head h2{font-size:1rem;line-height:1.04}
#adminOverlay .cc405-topstats{margin-top:12px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
#adminOverlay .cc405-stat{min-width:0;padding:10px;border-radius:16px;border:1px solid rgba(117,220,255,.08);background:rgba(255,255,255,.03)}
#adminOverlay .cc405-stat b{display:block;margin-top:4px;font-size:.80rem;line-height:1.02;color:#f4fbff}
#adminOverlay .cc405-stat span{display:block;margin-top:3px;color:#7e9aac;font-size:.42rem;line-height:1.28}
#adminOverlay .cc405-body{padding:14px;display:grid;gap:12px}
#adminOverlay .cc405-section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
#adminOverlay .cc405-modules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
#adminOverlay .cc405-module{
  padding:10px;border-radius:18px;border:1px solid rgba(117,220,255,.08);background:linear-gradient(145deg,rgba(8,23,37,.98),rgba(4,12,21,.99));
  display:grid;grid-template-columns:40px minmax(0,1fr);gap:9px;align-items:center;text-align:left;cursor:pointer
}
#adminOverlay .cc405-module b{font-size:.56rem;line-height:1.12}
#adminOverlay .cc405-panel{padding:12px;border-radius:22px;border:1px solid rgba(117,220,255,.08);background:linear-gradient(145deg,rgba(8,22,35,.98),rgba(4,14,23,.99))}
#adminOverlay .cc405-panel h3{font-size:.78rem;line-height:1.04}
#adminOverlay .cc405-panel .cc405-sub{margin-top:3px;font-size:.45rem;color:#84a0b2}
#adminOverlay .cc405-lines{display:grid;gap:8px;margin-top:10px}
#adminOverlay .cc405-line{padding:9px 10px;border-radius:14px;border:1px solid rgba(117,220,255,.06);background:rgba(255,255,255,.02);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;cursor:pointer}
#adminOverlay .cc405-line b{font-size:.51rem;line-height:1.12}
#adminOverlay .cc405-line em{font-style:normal;color:#7bf0ff;font-size:.43rem;font-weight:900;white-space:nowrap}
#adminOverlay .cc405-chipgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
#adminOverlay .cc405-modchip{padding:9px 10px;border-radius:16px;border:1px solid rgba(117,220,255,.06);background:rgba(255,255,255,.02);display:grid;grid-template-columns:34px minmax(0,1fr);gap:8px;align-items:center;cursor:pointer;text-align:left}
#adminOverlay .cc405-modchip b{font-size:.49rem;line-height:1.13}
#adminOverlay .cc405-grid{display:grid;gap:12px}
#adminOverlay .cc405-fill{width:100%}
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-main{width:100%}
#adminOverlay .cc405-section-stack{display:grid;gap:12px}
@media(max-width:560px){
  #adminOverlay .cc405-index{grid-template-columns:190px minmax(0,1fr);gap:10px}
  #adminOverlay .cc405-index.cc405-sidebar-hidden{grid-template-columns:0 minmax(0,1fr)}
}
@media(max-width:420px){
  #adminOverlay .cc405-main-head,#adminOverlay .cc405-body,#adminOverlay .cc405-panel{padding:10px}
  #adminOverlay .cc405-toolbar{align-items:flex-start;flex-direction:column}
  #adminOverlay .cc405-topstats,#adminOverlay .cc405-modules,#adminOverlay .cc405-chipgrid{grid-template-columns:1fr}
  #adminOverlay .cc405-main-head h2{font-size:.90rem}
  #adminOverlay .cc405-index{grid-template-columns:176px minmax(0,1fr)}
}
</style>
<script id="cruzclick-v405-script">
(function(){
  'use strict';
  const D=document;
  const $=(s,r=D)=>r.querySelector(s);
  const $$=(s,r=D)=>Array.from(r.querySelectorAll(s));
  const esc=v=>String(v??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const overlay=()=>D.getElementById('adminOverlay');
  const storageKey='cruzclick_cc405_sidebar_hidden';
  const short=(t,n)=>{const s=String(t||'').trim(); return s.length>n? s.slice(0,n-1).trim()+'…' : s;};
  const iconToggle='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path><path d="M8 6v12"></path></svg>';
  function stateData(){
    const s=window.state||{};
    return {orders:Array.isArray(s.orders)?s.orders:[],products:Array.isArray(s.products)?s.products:[],users:Array.isArray(s.users)?s.users:[]};
  }
  function moneySafe(v){
    try{ if(typeof window.money==='function') return window.money(v); }catch(e){}
    const n=Number(v||0);
    try{return new Intl.NumberFormat('es-GT',{style:'currency',currency:'GTQ',maximumFractionDigits:2}).format(n)}catch(e){return 'Q'+n.toFixed(2)}
  }
  function getMetrics(){
    const {orders,products,users}=stateData();
    const paid=orders.filter(o=>String(o?.payment?.status||'').toLowerCase().includes('confirm')||String(o?.status||'').toLowerCase().includes('entregado'));
    const pendingPay=orders.filter(o=>String(o?.payment?.status||'').toLowerCase().includes('pend'));
    const delivery=orders.filter(o=>/prepar|entregar|listo/i.test(String(o?.status||'')));
    const renewals=orders.filter(o=>/renov|venc|suscrip|perfil/i.test(JSON.stringify(o||{})));
    return {revenue:moneySafe(paid.reduce((a,o)=>a+Number(o?.total||0),0)),sales:paid.length,clients:users.length,products:products.length,pendingOrders:orders.length,pendingPay:pendingPay.length,delivery:delivery.length,renewals:renewals.length};
  }
  function modulesFromNav(nav){
    return $$('[data-cc378-section]',nav).map(btn=>({id:btn.dataset.cc378Section||'',icon:$('.cc378-nav-icon',btn)?.innerHTML||'',label:($('.cc378-nav-label',btn)?.textContent||'').trim(),lead:($('.cc378-nav-sub',btn)?.textContent||'').trim()})).filter(x=>x.id&&x.label);
  }
  function openSection(id){
    try{ if(window.CRUZCLICK_V388 && typeof window.CRUZCLICK_V388.openModule==='function') return window.CRUZCLICK_V388.openModule(id);}catch(e){}
    try{ if(typeof window.renderAdminSection==='function') return window.renderAdminSection(id);}catch(e){}
    return false;
  }
  function prioritized(modules){
    const order=['panel','sales','orders','payments','delivery','subscriptions','clients','reports'];
    const map=new Map(modules.map(m=>[m.id,m]));
    return order.map(id=>map.get(id)).filter(Boolean);
  }
  function remaining(modules){
    const chosen=new Set(['panel','sales','orders','payments','delivery','subscriptions','clients','reports']);
    return modules.filter(m=>!chosen.has(m.id));
  }
  function isHidden(){
    try{return localStorage.getItem(storageKey)==='1';}catch(e){return false;}
  }
  function setHidden(v){
    try{localStorage.setItem(storageKey,v?'1':'0');}catch(e){}
  }
  function buildIndex(modules){
    const m=getMetrics();
    const mainMods=prioritized(modules);
    const sideButtons=modules.map(mod=>`<button type="button" data-cc405-open="${esc(mod.id)}"><span class="cc405-ico">${mod.icon}</span><span><b>${esc(short(mod.label,18))}</b><span class="meta">${esc(short(mod.lead,42))}</span></span></button>`).join('');
    const quickCards=mainMods.map(mod=>`<button type="button" class="cc405-module" data-cc405-open="${esc(mod.id)}"><span class="cc405-modicon">${mod.icon}</span><span><b>${esc(mod.label)}</b><p>${esc(short(mod.lead,52))}</p></span></button>`).join('');
    const otherMods=remaining(modules).map(mod=>`<button type="button" class="cc405-modchip" data-cc405-open="${esc(mod.id)}"><span class="cc405-chip-ico">${mod.icon}</span><span><b>${esc(mod.label)}</b><span>${esc(short(mod.lead,44))}</span></span></button>`).join('');
    const lines=`
      <button type="button" class="cc405-line" data-cc405-open="orders"><span><b>Pedidos del día</b><span>Compras nuevas y seguimiento.</span></span><em>${esc(String(m.pendingOrders))}</em></button>
      <button type="button" class="cc405-line" data-cc405-open="payments"><span><b>Pagos por validar</b><span>Comprobantes y cobros pendientes.</span></span><em>${esc(String(m.pendingPay))}</em></button>
      <button type="button" class="cc405-line" data-cc405-open="delivery"><span><b>Entregas digitales</b><span>Activaciones listas o en preparación.</span></span><em>${esc(String(m.delivery))}</em></button>
      <button type="button" class="cc405-line" data-cc405-open="subscriptions"><span><b>Renovaciones</b><span>Seguimiento a planes próximos a vencer.</span></span><em>${esc(String(m.renewals))}</em></button>`;
    const control=`
      <div class="cc405-line"><span><b>Ventas y cobros</b><span>Pedidos, pagos, comprobantes e ingresos.</span></span><em>Clave</em></div>
      <div class="cc405-line"><span><b>Activación y entrega</b><span>Datos del cliente, acceso y evidencia de entrega.</span></span><em>Clave</em></div>
      <div class="cc405-line"><span><b>Renovación y retorno</b><span>Vencimientos, reactivaciones y nueva compra.</span></span><em>Clave</em></div>
      <div class="cc405-line"><span><b>Reportes y control</b><span>Visión administrativa, operativa y financiera.</span></span><em>Clave</em></div>`;
    return `<section class="cc405-index${isHidden()?' cc405-sidebar-hidden':''}" aria-label="Índice administrativo desplegable">
      <aside class="cc405-sidebar">
        <div class="cc405-side-top">
          <small class="cc405-kicker">Área de trabajo</small>
          <h2>Índice</h2>
          <p>Ocúltalo cuando necesites que el contenido principal use toda la pantalla.</p>
          <button type="button" class="cc405-btn cc405-side-toggle" data-cc405-toggle="1"><span class="ico">${iconToggle}</span><span>Ocultar índice</span></button>
        </div>
        <nav class="cc405-menu">${sideButtons}</nav>
      </aside>
      <section class="cc405-main">
        <header class="cc405-main-head">
          <div class="cc405-toolbar">
            <button type="button" class="cc405-top-toggle" data-cc405-toggle="1"><span class="ico">${iconToggle}</span><span class="cc405-toggle-label">${isHidden()?'Mostrar índice':'Ocultar índice'}</span></button>
            <span class="cc405-dots"><i></i><i></i><i></i></span>
          </div>
          <small class="cc405-kicker">Modo escritorio</small>
          <h2>Centro de control</h2>
          <p>Ahora el índice puede desplegarse u ocultarse. Cuando está oculto, las herramientas quedan a pantalla completa para trabajar con más espacio.</p>
          <div class="cc405-topstats">
            <div class="cc405-stat"><small>Ventas confirmadas</small><b>${esc(m.revenue)}</b><span>${esc(String(m.sales))} ventas registradas</span></div>
            <div class="cc405-stat"><small>Clientes</small><b>${esc(String(m.clients))}</b><span>base de clientes</span></div>
            <div class="cc405-stat"><small>Productos</small><b>${esc(String(m.products))}</b><span>servicios activos</span></div>
            <div class="cc405-stat"><small>Renovaciones</small><b>${esc(String(m.renewals))}</b><span>detectadas en pedidos</span></div>
          </div>
        </header>
        <div class="cc405-body">
          <section>
            <div class="cc405-section-head"><span class="cc405-section-label">Acceso principal</span></div>
            <div class="cc405-modules">${quickCards}</div>
          </section>
          <div class="cc405-grid">
            <article class="cc405-panel"><small>Operación prioritaria</small><h3>Lo importante primero</h3><p class="cc405-sub">Control rápido de pedidos, pagos, entregas y renovaciones.</p><div class="cc405-lines">${lines}</div></article>
            <article class="cc405-panel"><small>Enfoque real</small><h3>Qué debe controlar el panel</h3><p class="cc405-sub">Menos relleno y más control práctico del negocio digital.</p><div class="cc405-lines">${control}</div></article>
            ${otherMods ? `<article class="cc405-panel"><small>Módulos adicionales</small><h3>Más funciones del sistema</h3><p class="cc405-sub">Disponibles sin estorbar la vista principal.</p><div class="cc405-chipgrid">${otherMods}</div></article>`:''}
          </div>
        </div>
      </section>
    </section>`;
  }
  function applyHiddenState(root,hidden){
    if(!root) return;
    root.classList.toggle('cc405-sidebar-hidden',!!hidden);
    const labels=$$('.cc405-toggle-label',root);
    labels.forEach(el=>el.textContent=hidden?'Mostrar índice':'Ocultar índice');
    const sideBtn=$('.cc405-side-toggle span:last-child',root);
    if(sideBtn) sideBtn.textContent='Ocultar índice';
  }
  function bind(root){
    $$('[data-cc405-open]',root).forEach(btn=>btn.addEventListener('click',()=>openSection(btn.dataset.cc405Open),{passive:true}));
    $$('[data-cc405-toggle]',root).forEach(btn=>btn.addEventListener('click',()=>{
      const wrap=btn.closest('.cc405-index');
      const hidden=!wrap.classList.contains('cc405-sidebar-hidden');
      applyHiddenState(wrap,hidden);
      setHidden(hidden);
    },{passive:true}));
    const menu=$('.cc405-menu',root); if(menu) menu.scrollTop=0;
  }
  function render405(){
    const stage=D.getElementById('cc378Stage');
    const nav=D.getElementById('cc378AdminNav');
    if(!stage||!nav) return;
    const modules=modulesFromNav(nav);
    if(!modules.length) return;
    stage.innerHTML=buildIndex(modules);
    bind(stage);
  }
  const obs=new MutationObserver(()=>{ if(D.getElementById('cc378AdminNav')) requestAnimationFrame(render405); });
  function boot(){ const root=overlay(); if(root) obs.observe(root,{childList:true,subtree:true}); render405(); }
  if(D.readyState==='loading') D.addEventListener('DOMContentLoaded',boot,{once:true}); else boot();
})();
</script>


<style id="cruzclick-v406-index-toggle-fix">
#adminOverlay .cc405-index{
  transition:grid-template-columns .20s ease !important;
}
#adminOverlay .cc405-sidebar{
  min-width:0 !important;
  transition:opacity .16s ease,transform .20s ease,visibility .20s ease !important;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden{
  grid-template-columns:0 minmax(0,1fr) !important;
  gap:0 !important;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-sidebar{
  width:0 !important;
  max-width:0 !important;
  overflow:hidden !important;
  opacity:0 !important;
  visibility:hidden !important;
  transform:translateX(-14px) !important;
  pointer-events:none !important;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-main{
  width:100% !important;
  max-width:none !important;
}
#adminOverlay .cc405-top-toggle{
  position:relative !important;
  z-index:10 !important;
  display:inline-flex !important;
  visibility:visible !important;
  opacity:1 !important;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-top-toggle{
  box-shadow:0 0 0 1px rgba(78,225,255,.16),0 10px 28px rgba(0,0,0,.28) !important;
}
@media(max-width:560px){
  #adminOverlay .cc405-index{
    grid-template-columns:180px minmax(0,1fr) !important;
  }
  #adminOverlay .cc405-index.cc405-sidebar-hidden{
    grid-template-columns:0 minmax(0,1fr) !important;
  }
}
</style>
<script id="cruzclick-v406-toggle-guard">
(function(){
  'use strict';
  const D=document;
  const KEY='cruzclick_cc405_sidebar_hidden';

  function setState(root, hidden){
    if(!root) return;
    root.classList.toggle('cc405-sidebar-hidden', !!hidden);
    root.querySelectorAll('.cc405-toggle-label').forEach(el=>{
      el.textContent = hidden ? 'Mostrar índice' : 'Ocultar índice';
    });
    try{ localStorage.setItem(KEY, hidden ? '1' : '0'); }catch(e){}
  }

  D.addEventListener('click', function(e){
    const btn=e.target.closest?.('[data-cc405-toggle]');
    if(!btn) return;
    const root=btn.closest('.cc405-index');
    if(!root) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    setState(root, !root.classList.contains('cc405-sidebar-hidden'));
  }, true);

  function restore(){
    const root=D.querySelector('#adminOverlay .cc405-index');
    if(!root) return;
    let hidden=false;
    try{ hidden=localStorage.getItem(KEY)==='1'; }catch(e){}
    setState(root, hidden);
  }

  if(D.readyState==='loading'){
    D.addEventListener('DOMContentLoaded', ()=>setTimeout(restore,60), {once:true});
  }else{
    setTimeout(restore,60);
  }

  new MutationObserver(()=>setTimeout(restore,0))
    .observe(D.documentElement,{childList:true,subtree:true});
})();
</script>


<style id="cruzclick-v407-fixed-index">
/* V4.0.7 — El índice no se desplaza; únicamente se desplaza la lista de funciones */
#adminOverlay .cc405-index{
  align-items:start !important;
}

#adminOverlay .cc405-sidebar{
  position:sticky !important;
  top:8px !important;
  height:calc(100dvh - 16px) !important;
  max-height:calc(100dvh - 16px) !important;
  min-height:0 !important;
  display:flex !important;
  flex-direction:column !important;
  overflow:hidden !important;
  align-self:start !important;
  overscroll-behavior:none !important;
  contain:layout paint !important;
}

/* Cabecera del índice totalmente fija dentro del panel lateral */
#adminOverlay .cc405-side-top{
  position:relative !important;
  z-index:3 !important;
  flex:0 0 auto !important;
  min-height:0 !important;
  background:
    radial-gradient(circle at 82% 18%,rgba(0,225,255,.10),transparent 24%),
    linear-gradient(180deg,rgba(10,29,44,.995),rgba(5,16,27,.995)) !important;
  box-shadow:0 8px 20px rgba(0,0,0,.16) !important;
}

/* Solo las funciones pueden subir y bajar */
#adminOverlay .cc405-menu{
  flex:1 1 auto !important;
  min-height:0 !important;
  max-height:none !important;
  overflow-x:hidden !important;
  overflow-y:auto !important;
  padding:10px !important;

  -webkit-overflow-scrolling:touch !important;
  overscroll-behavior-y:contain !important;
  scroll-behavior:smooth !important;
  touch-action:pan-y !important;
  scrollbar-gutter:stable !important;

  scrollbar-width:thin !important;
  scrollbar-color:rgba(83,226,255,.42) rgba(255,255,255,.025) !important;
}

/* Scroll discreto y profesional en navegadores compatibles */
#adminOverlay .cc405-menu::-webkit-scrollbar{
  width:5px !important;
}
#adminOverlay .cc405-menu::-webkit-scrollbar-track{
