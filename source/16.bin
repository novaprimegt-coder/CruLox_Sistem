/* Nada de columnas invisibles ni textos partidos por restricciones heredadas. */
#adminOverlay .cc378-nav button,
#adminOverlay .cc378-nav-label,
#adminOverlay .cc378-nav-sub,
#adminOverlay .cc378-module-head,
#adminOverlay .cc378-module-id{box-sizing:border-box!important;min-width:0!important}

/* Limpieza de posibles restos de código visibles en la tienda. */
body.cc391-clean-runtime-code .cc391-runtime-leak{display:none!important}

@media(max-width:760px){
  #adminOverlay .cc378-nav{gap:12px!important;padding:2px!important}
