4px;color:#45e5fb;font-size:1rem;line-height:1.1}#cc394Modal .result span{display:block;margin-top:5px;color:#9ab0be;font-size:.42rem;line-height:1.45}#cc394Modal .calc{height:40px;border:0;border-radius:12px;background:linear-gradient(135deg,#12cfe8,#36efff);color:#00222b;font-size:.49rem;font-weight:950;cursor:pointer}
