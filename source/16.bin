</style>
<script id="cc394-business-metrics-script">
(()=>{'use strict';
const D=document;
const defs={
 gross:{title:'Margen bruto',short:'Rentabilidad directa',formula:'(Ventas − Costo de ventas) / Ventas × 100',fields:[['sales','Ventas'],['cost','Costo de ventas']],calc:v=>v.sales?((v.sales-v.cost)/v.sales)*100:null,unit:'%'},
 contribution:{title:'Margen de contribución',short:'Aporte después de costos variables',formula:'(Ventas − Costos variables) / Ventas × 100',fields:[['sales','Ventas'],['variable','Costos variables']],calc:v=>v.sales?((v.sales-v.variable)/v.sales)*100:null,unit:'%'},
 breakeven:{title:'Punto de equilibrio',short:'Ventas mínimas para no perder',formula:'Costos fijos / Margen de contribución (decimal)',fields:[['fixed','Costos fijos'],['margin','Margen de contribución (%)']],calc:v=>v.margin?v.fixed/(v.margin/100):null,unit:'Q'},
 net:{title:'Margen neto',short:'Rentabilidad final',formula:'Utilidad neta / Ventas × 100',fields:[['profit','Utilidad neta'],['sales','Ventas']],calc:v=>v.sales?(v.profit/v.sales)*100:null,unit:'%'},
 ticket:{title:'Ticket promedio',short:'Valor medio por venta',formula:'Ventas totales / Número de transacciones',fields:[['sales','Ventas totales'],['transactions','Número de transacciones']],calc:v=>v.transactions?v.sales/v.transactions:null,unit:'Q'},
 cac:{title:'CAC · Costo de adquisición',short:'Costo por nuevo cliente',formula:'Gastos de adquisición / Nuevos clientes adquiridos',fields:[['spend','Gastos de adquisición'],['customers','Nuevos clientes']],calc:v=>v.customers?v.spend/v.customers:null,unit:'Q'},
 ltv:{title:'LTV · Lifetime Value',short:'Valor económico del cliente',formula:'Ticket promedio × Frecuencia de compra × Vida del cliente × Margen de contribución',fields:[['ticket','Ticket promedio'],['frequency','Frecuencia de compra'],['life','Vida promedio del cliente'],['margin','Margen de contribución (%)']],calc:v=>v.ticket*v.frequency*v.life*(v.margin/100),unit:'Q'},
 cashflow:{title:'Flujo de efectivo operativo',short:'Efectivo generado por la operación',formula:'Utilidad neta + Gastos no monetarios ± Partidas no operativas ± Cambios en capital de trabajo',fields:[['profit','Utilidad neta'],['noncash','Gastos no monetarios'],['nonop','Ajuste partidas no operativas'],['working','Cambio en capital de trabajo']],calc:v=>v.profit+v.noncash+v.nonop+v.working,unit:'Q'},
 ccc:{title:'Ciclo de conversión de efectivo',short:'Días para recuperar el dinero operativo',formula:'Días de inventario + Días de cuentas por cobrar − Días de cuentas por pagar',fields:[['inventory','Días de inventario'],['receivable','Días por cobrar'],['payable','Días por pagar']],calc:v=>v.inventory+v.receivable-v.payable,unit:' días'},
 roe:{title:'ROE · Return on Equity',short:'Rentabilidad sobre patrimonio',formula:'Utilidad neta / Patrimonio promedio × 100',fields:[['profit','Utilidad neta'],['equity','Patrimonio promedio']],calc:v=>v.equity?(v.profit/v.equity)*100:null,unit:'%'}
};
const order=['gross','contribution','breakeven','net','ticket','cac','ltv','cashflow','ccc','roe'];
function esc(s){return String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function section(){const el=D.createElement('section');el.className='cc394-metrics';el.id='cc394Metrics';el.innerHTML=`<div class="cc394-head"><div><h3>Indicadores financieros y comerciales</h3><p>10 herramientas para medir rentabilidad, ventas, clientes y liquidez.</p></div><span class="cc394-tag">10 herramientas</span></div><div class="cc394-grid">${order.map((k,i)=>{const d=defs[k];return `<button type="button" class="cc394-tool" data-cc394="${k}"><span class="cc394-icon">${i+1}</span><span><b>${esc(d.title)}</b><small>${esc(d.short)}</small></span><span class="cc394-open">›</span></button>`}).join('')}</div>`;return el}
function inject(){const dash=D.querySelector('#adminOverlay .cc388-dashboard');if(!dash||dash.querySelector('#cc394Metrics'))return;const hero=dash.querySelector('.cc388-hero');const kpis=dash.querySelector('.cc388-kpis');const el=section();if(kpis)kpis.insertAdjacentElement('afterend',el);else if(hero)hero.insertAdjacentElement('afterend',el);else dash.prepend(el)}
function modal(){let m=D.getElementById('cc394Modal');if(m)return m;m=D.createElement('div');m.id='cc394Modal';m.innerHTML='<div class="box" role="dialog" aria-modal="true"><div class="mh"><button class="back" type="button">← Panel General</button><div><h2></h2><p class="sub"></p></div><button class="close" type="button" aria-label="Cerrar">×</button></div><div class="mb"></div></div>';D.body.appendChild(m);m.querySelector('.back').onclick=m.querySelector('.close').onclick=()=>m.classList.remove('open');m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')});return m}
function open(k){const d=defs[k];if(!d)return;const m=modal();m.querySelector('h2').textContent=d.title;m.querySelector('.sub').textContent=d.short;m.querySelector('.mb').innerHTML=`<div class="formula"><b>Fórmula:</b> ${esc(d.formula)}</div><div class="fields">${d.fields.map(([id,l])=>`<label>${esc(l)}<input type="number" inputmode="decimal" step="any" data-f="${id}" placeholder="0.00"></label>`).join('')}</div><button type="button" class="calc">Calcular indicador</button><div class="result"><small>Resultado</small><strong>—</strong><span>Ingresa los datos y pulsa calcular.</span></div>`;m.querySelector('.calc').onclick=()=>{const v={};m.querySelectorAll('[data-f]').forEach(i=>v[i.dataset.f]=Number(i.value)||0);const r=d.calc(v);const strong=m.querySelector('.result strong'),note=m.querySelector('.result span');if(r===null||!Number.isFinite(r)){strong.textContent='No calculable';note.textContent='Revisa los datos: el divisor no puede ser cero.';return}const num=Math.abs(r)>=1000?r.toLocaleString('es-GT',{maximumFractionDigits:2}):r.toLocaleString('es-GT',{maximumFractionDigits:2});strong.textContent=d.unit==='Q'?`Q${num}`:`${num}${d.unit}`;note.textContent='Resultado calculado con los valores ingresados. No modifica registros del sistema.'};m.classList.add('open');m.querySelector('input')?.focus()}
D.addEventListener('click',e=>{const b=e.target.closest?.('[data-cc394]');if(!b)return;e.preventDefault();open(b.dataset.cc394)},true);
const obs=new MutationObserver(inject);const start=()=>{inject();obs.observe(D.body,{childList:true,subtree:true})};if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',start,{once:true});else start();window.CRUZCLICK_V394={version:'3.9.4',businessIndicators:10};
})();
</script>

<style id="cruzclick-v402-grid3-compact">
/* V4.0.2 — navegación de funciones más compacta en 3 columnas */
#adminOverlay .cc378-nav{
  width:min(100%,1160px)!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:8px!important;
  padding:0!important;
  align-items:stretch!important;
}
#adminOverlay .cc378-nav button,
#adminOverlay .cc378-nav button:nth-child(37){
  width:100%!important;
  min-height:96px!important;
  padding:11px 8px!important;
  border-radius:16px!important;
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
  align-items:center!important;
  text-align:center!important;
  gap:6px!important;
  grid-column:auto!important;
  justify-self:stretch!important;
}
#adminOverlay .cc378-nav-icon{
  width:40px!important;
  height:40px!important;
  flex:0 0 40px!important;
  border-radius:13px!important;
  margin:0 auto!important;
  align-self:center!important;
  justify-self:center!important;
  grid-column:auto!important;
  grid-row:auto!important;
}
#adminOverlay .cc378-nav-icon svg{
  width:22px!important;
  height:22px!important;
}
#adminOverlay .cc378-nav-label{
  grid-column:auto!important;
  grid-row:auto!important;
  align-self:center!important;
  margin:0!important;
  font-size:.58rem!important;
  line-height:1.12!important;
  font-weight:900!important;
  max-width:100%!important;
}
#adminOverlay .cc378-nav-sub,
#adminOverlay .cc378-nav-index{
  display:none!important;
}
@media(max-width:620px){
  #adminOverlay .cc378-admin{padding:7px!important}
  #adminOverlay .cc378-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px!important}
  #adminOverlay .cc378-nav button,
  #adminOverlay .cc378-nav button:nth-child(37){
    min-height:88px!important;
    padding:9px 6px!important;
    border-radius:14px!important;
    gap:5px!important;
  }
  #adminOverlay .cc378-nav-icon{width:36px!important;height:36px!important;flex-basis:36px!important;border-radius:12px!important}
  #adminOverlay .cc378-nav-icon svg{width:20px!important;height:20px!important}
  #adminOverlay .cc378-nav-label{font-size:.53rem!important;line-height:1.08!important}
}
@media(max-width:390px){
  #adminOverlay .cc378-nav{gap:6px!important}
  #adminOverlay .cc378-nav button,
  #adminOverlay .cc378-nav button:nth-child(37){min-height:82px!important;padding:8px 5px!important}
  #adminOverlay .cc378-nav-icon{width:34px!important;height:34px!important;flex-basis:34px!important}
  #adminOverlay .cc378-nav-icon svg{width:18px!important;height:18px!important}
  #adminOverlay .cc378-nav-label{font-size:.49rem!important}
}
</style>



<style id="cruzclick-v403-desktop-index-style">
/* V4.0.3 — índice administrativo con apariencia de escritorio */
#adminOverlay .cc403-index{
  display:grid;
  grid-template-columns:150px minmax(0,1fr);
  gap:12px;
  align-items:start;
  width:min(100%,1180px);
  margin:0 auto;
}
#adminOverlay .cc403-side,
#adminOverlay .cc403-work{
  border:1px solid rgba(117,220,255,.11);
  background:linear-gradient(145deg,rgba(8,27,43,.96),rgba(4,15,25,.99));
  box-shadow:0 18px 46px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.03);
}
#adminOverlay .cc403-side{
  border-radius:22px;
  overflow:hidden;
  position:sticky;
  top:0;
}
#adminOverlay .cc403-side-head{
  padding:14px 12px 12px;
  border-bottom:1px solid rgba(117,220,255,.08);
  background:linear-gradient(180deg,rgba(16,40,62,.95),rgba(8,22,35,.95));
}
#adminOverlay .cc403-side-head small,
#adminOverlay .cc403-work-head small,
#adminOverlay .cc403-window-label{
  display:block;
  color:#65e5ff;
  font-size:.43rem;
  font-weight:950;
  letter-spacing:.16em;
  text-transform:uppercase;
}
#adminOverlay .cc403-side-head h2,
#adminOverlay .cc403-work-head h2{
  margin:6px 0 4px;
  color:#f5fbff;
  font-size:.94rem;
  line-height:1.08;
  letter-spacing:-.02em;
}
#adminOverlay .cc403-side-head p,
#adminOverlay .cc403-work-head p,
#adminOverlay .cc403-info p,
#adminOverlay .cc403-desk-card p{
  margin:0;
  color:#7e9db0;
  font-size:.47rem;
  line-height:1.48;
}
#adminOverlay .cc403-side-nav{
  max-height:calc(100dvh - 150px);
  overflow:auto;
  padding:9px;
  display:grid;
  gap:7px;
}
#adminOverlay .cc403-side-btn{
  width:100%;
  min-width:0;
  padding:8px 9px;
  border-radius:14px;
  border:1px solid rgba(117,220,255,.08);
  background:rgba(255,255,255,.02);
  color:#e9f8ff;
  display:grid;
  grid-template-columns:34px minmax(0,1fr);
  gap:8px;
  align-items:center;
  text-align:left;
  cursor:pointer;
  touch-action:manipulation;
  transition:.12s ease;
}
#adminOverlay .cc403-side-btn:hover,
#adminOverlay .cc403-side-btn:focus-visible{
  border-color:rgba(0,225,255,.24);
  background:linear-gradient(145deg,rgba(14,43,66,.95),rgba(6,19,31,.98));
  transform:translateY(-1px);
}
#adminOverlay .cc403-side-ico{
  width:34px;height:34px;border-radius:11px;
  display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.14),rgba(72,111,255,.08));
  border:1px solid rgba(0,224,255,.17);
  color:#7ef0ff;
}
#adminOverlay .cc403-side-ico svg{
  width:20px;height:20px;display:block;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round;
}
#adminOverlay .cc403-side-txt b{
  display:block;
  font-size:.50rem;
  line-height:1.16;
  color:#eefaff;
}
#adminOverlay .cc403-side-txt span{
  display:block;
  margin-top:2px;
  font-size:.39rem;
  line-height:1.28;
  color:#7290a4;
}
#adminOverlay .cc403-work{
  border-radius:24px;
  overflow:hidden;
}
#adminOverlay .cc403-work-head{
  padding:14px 14px 12px;
  border-bottom:1px solid rgba(117,220,255,.08);
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:10px;
  align-items:start;
  background:
    radial-gradient(circle at 88% 16%,rgba(0,225,255,.11),transparent 28%),
    linear-gradient(180deg,rgba(10,31,48,.98),rgba(6,20,32,.97));
}
#adminOverlay .cc403-window-dots{
  display:inline-flex;
  gap:6px;
  margin-bottom:8px;
}
#adminOverlay .cc403-window-dots i{
  width:8px;height:8px;border-radius:50%;display:block;
  background:rgba(255,255,255,.2);
}
#adminOverlay .cc403-window-dots i:nth-child(1){background:#ff6a78}
#adminOverlay .cc403-window-dots i:nth-child(2){background:#ffd166}
#adminOverlay .cc403-window-dots i:nth-child(3){background:#36dd8f}
#adminOverlay .cc403-topstats{
  display:grid;
  grid-template-columns:repeat(2,minmax(86px,1fr));
  gap:7px;
}
#adminOverlay .cc403-topstats div{
  padding:9px 10px;
  border-radius:14px;
  border:1px solid rgba(117,220,255,.08);
  background:rgba(255,255,255,.028);
  min-width:0;
}
#adminOverlay .cc403-topstats small{display:block;color:#75e2f5;font-size:.39rem;letter-spacing:.08em}
#adminOverlay .cc403-topstats b{display:block;margin-top:4px;color:#f2fcff;font-size:.72rem;line-height:1.05}
#adminOverlay .cc403-topstats span{display:block;margin-top:3px;color:#7794a8;font-size:.40rem;line-height:1.25}
#adminOverlay .cc403-work-body{padding:14px;display:grid;gap:12px}
#adminOverlay .cc403-quick-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:9px;
}
#adminOverlay .cc403-desk-card,
#adminOverlay .cc403-info,
#adminOverlay .cc403-list{
  border-radius:18px;
  border:1px solid rgba(117,220,255,.08);
  background:linear-gradient(145deg,rgba(8,24,39,.96),rgba(4,14,24,.99));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025);
}
#adminOverlay .cc403-desk-card{
  padding:12px;
  display:grid;
  grid-template-columns:42px minmax(0,1fr);
  gap:10px;
  text-align:left;
  color:#effaff;
  cursor:pointer;
  touch-action:manipulation;
}
#adminOverlay .cc403-desk-card:hover,
#adminOverlay .cc403-desk-card:focus-visible{
  border-color:rgba(0,224,255,.22);
  transform:translateY(-1px);
}
#adminOverlay .cc403-desk-icon{
  width:42px;height:42px;border-radius:13px;display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.15),rgba(72,111,255,.08));
  border:1px solid rgba(0,224,255,.18);color:#78efff;
}
#adminOverlay .cc403-desk-icon svg{
  width:22px;height:22px;display:block;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round;
}
#adminOverlay .cc403-desk-card b{
  display:block;
  font-size:.60rem;
  line-height:1.15;
  color:#f2fbff;
}
#adminOverlay .cc403-desk-card p{margin-top:4px}
#adminOverlay .cc403-panels{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:10px;
}
#adminOverlay .cc403-info{padding:12px}
#adminOverlay .cc403-info h3,
#adminOverlay .cc403-list h3{
  margin:0 0 8px;
  color:#eefaff;
  font-size:.67rem;
}
#adminOverlay .cc403-mini-list{display:grid;gap:7px}
#adminOverlay .cc403-mini-list button,
#adminOverlay .cc403-mini-list div{
  width:100%;
  text-align:left;
  padding:9px 10px;
  border-radius:12px;
  border:1px solid rgba(117,220,255,.06);
  background:rgba(255,255,255,.018);
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:8px;
  align-items:center;
  color:#eefaff;
}
#adminOverlay .cc403-mini-list button{cursor:pointer;touch-action:manipulation}
#adminOverlay .cc403-mini-list button:hover{border-color:rgba(0,224,255,.18)}
#adminOverlay .cc403-mini-list b{display:block;font-size:.52rem}
#adminOverlay .cc403-mini-list span{display:block;margin-top:2px;color:#7996a9;font-size:.42rem;line-height:1.32}
#adminOverlay .cc403-mini-list em{
  font-style:normal;
  color:#7beefe;
  font-size:.42rem;
  font-weight:900;
  white-space:nowrap;
}
#adminOverlay .cc403-list{padding:12px}
#adminOverlay .cc403-list ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
#adminOverlay .cc403-list li{
  padding:9px 10px;
  border-radius:12px;
  border:1px solid rgba(117,220,255,.06);
  background:rgba(255,255,255,.018);
}
#adminOverlay .cc403-list li b{display:block;color:#effaff;font-size:.51rem}
#adminOverlay .cc403-list li span{display:block;margin-top:2px;color:#7793a6;font-size:.42rem;line-height:1.35}
@media(max-width:760px){
  #adminOverlay .cc403-index{grid-template-columns:128px minmax(0,1fr);gap:9px}
  #adminOverlay .cc403-side-head,#adminOverlay .cc403-work-head,#adminOverlay .cc403-work-body{padding:11px}
  #adminOverlay .cc403-side-nav{padding:7px;max-height:calc(100dvh - 134px)}
  #adminOverlay .cc403-side-btn{grid-template-columns:30px minmax(0,1fr);padding:7px}
  #adminOverlay .cc403-side-ico{width:30px;height:30px;border-radius:10px}
  #adminOverlay .cc403-side-ico svg{width:18px;height:18px}
  #adminOverlay .cc403-side-txt b{font-size:.46rem}
  #adminOverlay .cc403-side-txt span{font-size:.36rem}
  #adminOverlay .cc403-work-head{grid-template-columns:1fr}
  #adminOverlay .cc403-topstats{grid-template-columns:repeat(4,minmax(0,1fr))}
  #adminOverlay .cc403-panels{grid-template-columns:1fr}
}
@media(max-width:480px){
  #adminOverlay .cc403-index{grid-template-columns:118px minmax(0,1fr)}
  #adminOverlay .cc403-side-head h2,#adminOverlay .cc403-work-head h2{font-size:.84rem}
  #adminOverlay .cc403-side-head p,#adminOverlay .cc403-work-head p,#adminOverlay .cc403-info p,#adminOverlay .cc403-desk-card p{font-size:.42rem}
  #adminOverlay .cc403-topstats{grid-template-columns:repeat(2,minmax(0,1fr))}
  #adminOverlay .cc403-quick-grid{grid-template-columns:1fr}
  #adminOverlay .cc403-desk-card{grid-template-columns:38px minmax(0,1fr);padding:10px}
  #adminOverlay .cc403-desk-icon{width:38px;height:38px;border-radius:12px}
  #adminOverlay .cc403-desk-icon svg{width:20px;height:20px}
}
</style>




<style id="cruzclick-v404-index-style">
#adminOverlay .cc404-index{
  display:grid;
  grid-template-columns:94px minmax(0,1fr);
  gap:10px;
  width:min(100%,1180px);
  margin:0 auto;
  align-items:start;
}
#adminOverlay .cc404-sidebar,
#adminOverlay .cc404-main{
  border:1px solid rgba(117,220,255,.10);
  background:linear-gradient(145deg,rgba(6,18,30,.985),rgba(5,13,23,.99));
  box-shadow:0 18px 42px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.025);
}
#adminOverlay .cc404-sidebar{
  border-radius:22px;
  overflow:hidden;
  position:sticky;
  top:0;
}
#adminOverlay .cc404-side-top{
  padding:10px 8px 8px;
  border-bottom:1px solid rgba(117,220,255,.08);
  text-align:center;
  background:linear-gradient(180deg,rgba(13,33,51,.96),rgba(7,20,33,.97));
}
#adminOverlay .cc404-side-kicker,
#adminOverlay .cc404-main-kicker,
#adminOverlay .cc404-section small{
  display:block;
  color:#6fe8fb;
  text-transform:uppercase;
  letter-spacing:.14em;
  font-weight:900;
  font-size:.40rem;
}
#adminOverlay .cc404-side-top h2,
#adminOverlay .cc404-main-head h2,
#adminOverlay .cc404-panel h3{
  margin:4px 0 0;
  color:#f3fbff;
}
#adminOverlay .cc404-side-top h2{font-size:.72rem;line-height:1.02}
#adminOverlay .cc404-side-top p,
#adminOverlay .cc404-main-head p,
#adminOverlay .cc404-module p,
#adminOverlay .cc404-panel p,
#adminOverlay .cc404-line span,
#adminOverlay .cc404-modchip span{
  margin:0;
  color:#7c98ab;
  font-size:.40rem;
  line-height:1.35;
}
#adminOverlay .cc404-menu{
  padding:8px;
  display:grid;
  gap:8px;
  max-height:calc(100dvh - 130px);
  overflow:auto;
}
#adminOverlay .cc404-menu button{
  width:100%;
  padding:8px 6px;
  border-radius:16px;
  border:1px solid rgba(117,220,255,.08);
  background:linear-gradient(145deg,rgba(12,31,47,.94),rgba(5,15,25,.98));
  display:grid;
  gap:5px;
  justify-items:center;
  align-items:center;
  cursor:pointer;
  color:#ebfaff;
  touch-action:manipulation;
}
#adminOverlay .cc404-menu button:hover,
#adminOverlay .cc404-menu button:focus-visible{
  border-color:rgba(0,224,255,.22);
  transform:translateY(-1px);
}
#adminOverlay .cc404-menu-ico{
  width:36px;height:36px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.14),rgba(79,120,255,.08));
  border:1px solid rgba(0,224,255,.17);
  color:#79f1ff;
}
#adminOverlay .cc404-menu-ico svg,
#adminOverlay .cc404-modicon svg,
#adminOverlay .cc404-chip-ico svg{
  width:20px;height:20px;display:block;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round;
}
#adminOverlay .cc404-menu b{
  display:block;
  font-size:.40rem;
  line-height:1.15;
  text-align:center;
  color:#f2fbff;
  max-width:72px;
}
#adminOverlay .cc404-main{
  border-radius:24px;
  overflow:hidden;
}
#adminOverlay .cc404-main-head{
  padding:12px;
  border-bottom:1px solid rgba(117,220,255,.08);
  background:
    radial-gradient(circle at 82% 18%,rgba(0,225,255,.10),transparent 24%),
    linear-gradient(180deg,rgba(10,29,44,.98),rgba(5,16,27,.98));
}
#adminOverlay .cc404-dots{display:inline-flex;gap:6px;margin-bottom:7px}
#adminOverlay .cc404-dots i{width:8px;height:8px;border-radius:50%;display:block}
#adminOverlay .cc404-dots i:nth-child(1){background:#ff6474}
#adminOverlay .cc404-dots i:nth-child(2){background:#ffd166}
#adminOverlay .cc404-dots i:nth-child(3){background:#3cdc8c}
#adminOverlay .cc404-main-head h2{font-size:.96rem;line-height:1.04}
#adminOverlay .cc404-topstats{
  margin-top:10px;
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
#adminOverlay .cc404-stat{
  min-width:0;
  padding:9px 10px;
  border-radius:16px;
  border:1px solid rgba(117,220,255,.08);
  background:rgba(255,255,255,.03);
}
#adminOverlay .cc404-stat b{
  display:block;
  margin-top:4px;
  font-size:.77rem;
  line-height:1.02;
  color:#f4fbff;
}
#adminOverlay .cc404-stat span{display:block;margin-top:3px;color:#7e9aac;font-size:.40rem;line-height:1.28}
#adminOverlay .cc404-body{padding:12px;display:grid;gap:12px}
#adminOverlay .cc404-modules{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
#adminOverlay .cc404-module{
  padding:10px;
  border-radius:18px;
  border:1px solid rgba(117,220,255,.08);
  background:linear-gradient(145deg,rgba(8,23,37,.98),rgba(4,12,21,.99));
  display:grid;
  grid-template-columns:38px minmax(0,1fr);
  gap:9px;
  align-items:center;
  text-align:left;
  cursor:pointer;
  touch-action:manipulation;
}
#adminOverlay .cc404-module:hover,
#adminOverlay .cc404-module:focus-visible{border-color:rgba(0,224,255,.22);transform:translateY(-1px)}
#adminOverlay .cc404-modicon,
#adminOverlay .cc404-chip-ico{
  width:38px;height:38px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.14),rgba(79,120,255,.08));
  border:1px solid rgba(0,224,255,.16);color:#77f1ff;
}
#adminOverlay .cc404-module b{display:block;font-size:.56rem;line-height:1.12;color:#f3fbff}
#adminOverlay .cc404-panel{
  padding:12px;
  border-radius:22px;
  border:1px solid rgba(117,220,255,.08);
  background:linear-gradient(145deg,rgba(8,22,35,.98),rgba(4,14,23,.99));
}
#adminOverlay .cc404-panel h3{font-size:.78rem;line-height:1.04}
#adminOverlay .cc404-panel .cc404-sub{margin-top:3px;font-size:.45rem;color:#84a0b2}
#adminOverlay .cc404-lines{display:grid;gap:8px;margin-top:10px}
#adminOverlay .cc404-line{
  padding:9px 10px;
  border-radius:14px;
  border:1px solid rgba(117,220,255,.06);
  background:rgba(255,255,255,.02);
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:8px;
  align-items:center;
  cursor:pointer;
  touch-action:manipulation;
}
#adminOverlay .cc404-line:hover{border-color:rgba(0,224,255,.18)}
#adminOverlay .cc404-line b{display:block;color:#eefaff;font-size:.50rem;line-height:1.12}
#adminOverlay .cc404-line em{
  font-style:normal;
  color:#7bf0ff;
  font-size:.43rem;
  font-weight:900;
  white-space:nowrap;
}
#adminOverlay .cc404-othermods{display:grid;gap:8px}
#adminOverlay .cc404-chipgrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
  margin-top:10px;
}
#adminOverlay .cc404-modchip{
  padding:9px 10px;
  border-radius:16px;
  border:1px solid rgba(117,220,255,.06);
  background:rgba(255,255,255,.02);
  display:grid;
  grid-template-columns:34px minmax(0,1fr);
  gap:8px;
  align-items:center;
  cursor:pointer;
  touch-action:manipulation;
}
#adminOverlay .cc404-modchip:hover{border-color:rgba(0,224,255,.18)}
#adminOverlay .cc404-modchip b{display:block;color:#effaff;font-size:.49rem;line-height:1.13}
#adminOverlay .cc404-sections{display:grid;gap:12px}
@media(max-width:420px){
  #adminOverlay .cc404-index{grid-template-columns:84px minmax(0,1fr);gap:8px}
  #adminOverlay .cc404-menu{padding:6px;gap:6px}
  #adminOverlay .cc404-menu button{padding:7px 5px;border-radius:14px}
  #adminOverlay .cc404-menu-ico{width:32px;height:32px;border-radius:11px}
  #adminOverlay .cc404-menu-ico svg,#adminOverlay .cc404-modicon svg,#adminOverlay .cc404-chip-ico svg{width:18px;height:18px}
  #adminOverlay .cc404-menu b{font-size:.37rem;max-width:62px}
  #adminOverlay .cc404-main-head,#adminOverlay .cc404-body,#adminOverlay .cc404-panel{padding:10px}
  #adminOverlay .cc404-main-head h2{font-size:.88rem}
  #adminOverlay .cc404-modules,#adminOverlay .cc404-chipgrid{grid-template-columns:1fr}
}
</style>




<style id="cruzclick-v405-style">
#adminOverlay .cc405-index{
  --sidew: 210px;
  display:grid;
  grid-template-columns:var(--sidew) minmax(0,1fr);
  gap:12px;
  width:min(100%,1180px);
  margin:0 auto;
  align-items:start;
  transition:grid-template-columns .22s ease;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden{
  --sidew: 0px;
}
#adminOverlay .cc405-sidebar,
#adminOverlay .cc405-main{
  border:1px solid rgba(117,220,255,.10);
  background:linear-gradient(145deg,rgba(6,18,30,.985),rgba(5,13,23,.99));
  box-shadow:0 18px 42px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.025);
}
#adminOverlay .cc405-sidebar{
  border-radius:24px;
  overflow:hidden;
  position:sticky;
  top:0;
  min-width:0;
  opacity:1;
  transition:opacity .18s ease, transform .18s ease;
}
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-sidebar{
  opacity:0;
  transform:translateX(-10px);
  pointer-events:none;
}
#adminOverlay .cc405-side-top,
#adminOverlay .cc405-main-head{
  background:
    radial-gradient(circle at 82% 18%,rgba(0,225,255,.10),transparent 24%),
    linear-gradient(180deg,rgba(10,29,44,.98),rgba(5,16,27,.98));
}
#adminOverlay .cc405-side-top{
  padding:12px 12px 10px;
  border-bottom:1px solid rgba(117,220,255,.08);
}
#adminOverlay .cc405-kicker,
#adminOverlay .cc405-panel small,
#adminOverlay .cc405-stat small,
#adminOverlay .cc405-section-label{
  display:block;
  color:#6fe8fb;
  text-transform:uppercase;
  letter-spacing:.14em;
  font-weight:900;
  font-size:.41rem;
}
#adminOverlay .cc405-side-top h2,
#adminOverlay .cc405-main-head h2,
#adminOverlay .cc405-panel h3{
  margin:4px 0 0;
