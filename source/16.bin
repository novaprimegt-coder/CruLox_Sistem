<script id="cruzclick-v390-runtime-guard">
(()=>{
  'use strict';
  const D=document;
  const isAdminOpen=()=>!!D.getElementById('adminOverlay')?.classList.contains('open');
  const getStage=()=>D.getElementById('cc378Stage');
  const safeFallback=(message='No se pudo cargar esta vista correctamente.')=>{
    if(!isAdminOpen())return;
    const stage=getStage(); if(!stage)return;
    stage.innerHTML=`<section class="cc378-module-window" role="alert" aria-live="assertive">
      <header class="cc378-module-head">
        <button type="button" class="cc378-back" id="cc390SafeBack" aria-label="Volver a funciones">← <span>Funciones</span></button>
        <div class="cc378-module-id"><span class="cc378-module-icon" aria-hidden="true">!</span><div><h1>Vista protegida</h1><p>El sistema evitó que un error dejara el panel en blanco.</p></div></div>
      </header>
      <div class="cc378-module-body"><div class="cc378-module-placeholder">
        <div class="bigicon" aria-hidden="true">!</div><h2>Contenido no disponible</h2>
        <p>${String(message).replace(/[<>]/g,'')}</p>
        <div class="cc388-module-tools"><div class="cc388-module-tool-card"><h3>Recuperación segura</h3><p>Puedes volver a las 37 funciones sin cerrar el panel.</p></div></div>
      </div></div>
    </section>`;
    D.getElementById('cc390SafeBack')?.addEventListener('click',()=>window.renderAdminV2?.('functions'),{once:true});
  };
  window.addEventListener('error',e=>{
    if(!isAdminOpen())return;
    const target=e?.target;
    if(target && (target.tagName==='IMG'||target.tagName==='LINK'||target.tagName==='SCRIPT'))return;
    safeFallback('Se produjo un error inesperado dentro del panel. La vista fue aislada para evitar que el resto del sistema se rompa.');
  },true);
  window.addEventListener('unhandledrejection',e=>{
    if(!isAdminOpen())return;
    safeFallback('Una operación no pudo completarse. El panel se mantuvo protegido y puedes regresar a las funciones.');
    try{e.preventDefault?.()}catch(_){ }
  },true);
  const clean=()=>{
    const o=D.getElementById('adminOverlay'); if(!o)return;
    o.querySelectorAll('[data-cc378-section]').forEach(b=>{
      const icon=b.querySelector('.cc378-nav-icon');
      if(icon){icon.style.display='grid';icon.style.placeItems='center'}
    });
    const back=D.getElementById('cc388Back');
    if(back){back.style.whiteSpace='nowrap';back.style.wordBreak='keep-all';back.style.width='auto';back.style.minWidth='96px'}
  };
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(clean,120),{once:true});else setTimeout(clean,120);
  new MutationObserver(()=>{try{clean()}catch(_){}}).observe(D.body,{subtree:true,childList:true});
})();
</script>



