<script id="cruzclick-v391-final-hardening-script">
(()=>{
  'use strict';
  const D=document;
  const admin=()=>D.getElementById('adminOverlay');
  const stripNumber=(text)=>String(text||'').replace(/^\s*\d{1,2}\s*[·•-]\s*/,'').trim();
  const genericIcon=`<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="15"/><path d="M24 15v18M17 22h12M17 29h9"/></svg>`;
  function normalizeIcons(root=D){
    const scope=root.querySelectorAll?root:D.querySelectorAll('*');
    scope.forEach?.(el=>{
      if(!el.matches?.('.cc378-nav-icon,.cc378-module-icon,.cc378-module-body .bigicon'))return;
      let svg=el.querySelector('svg');
      if(!svg){el.innerHTML=genericIcon;svg=el.querySelector('svg')}
      if(!svg)return;
      svg.setAttribute('viewBox',svg.getAttribute('viewBox')||'0 0 48 48');
      svg.setAttribute('width','38');svg.setAttribute('height','38');
      svg.setAttribute('fill','none');svg.setAttribute('stroke','#79f4ff');
      svg.setAttribute('stroke-width','2.15');svg.setAttribute('stroke-linecap','round');svg.setAttribute('stroke-linejoin','round');
      svg.style.display='block';svg.style.overflow='visible';svg.style.visibility='visible';svg.style.opacity='1';
      svg.querySelectorAll('*').forEach(shape=>{
        shape.setAttribute('fill','none');shape.setAttribute('stroke','#79f4ff');
        shape.setAttribute('stroke-width','2.15');shape.setAttribute('stroke-linecap','round');shape.setAttribute('stroke-linejoin','round');
        shape.style.visibility='visible';shape.style.opacity='1';
      });
    });
  }
  function cleanHeaders(root=D){
    const o=admin();if(!o)return;
    o.querySelectorAll('.cc378-module-id h1').forEach(h=>{const clean=stripNumber(h.textContent);if(h.textContent!==clean)h.textContent=clean});
    o.querySelectorAll('.cc378-nav-index').forEach(x=>x.remove());
    normalizeIcons(root);
  }
  function looksLikeLeakedCode(text){
    const t=String(text||'').trim();
    if(t.length<90)return false;
    let score=0;
    if(/(?:MutationObserver|addEventListener|querySelector|document\.|window\.|const\s+[A-Za-z_$]|let\s+[A-Za-z_$]|function\s+[A-Za-z_$]|=>|\.onclick\s*=|innerHTML\s*=|getElementById|JSON\.stringify)/.test(t))score++;
    if(/[{}();]{5,}/.test(t))score++;
    if(/(?:adminObs34|JM_DIGITAL_STORE_V34|decorateAdminReceipts34|w\.document\.write|window\.JM_DIGITAL_STORE_V34)/.test(t))score+=3;
    return score>=2;
  }
  function scrubVisibleRuntimeCode(){
    try{
      const walker=D.createTreeWalker(D.body,NodeFilter.SHOW_TEXT);
      const remove=[];let node;
      while(node=walker.nextNode()){
        const p=node.parentElement;
        if(!p||/^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE|TEXTAREA|INPUT|OPTION)$/i.test(p.tagName))continue;
        if(looksLikeLeakedCode(node.nodeValue))remove.push(node);
      }
      remove.forEach(n=>n.parentNode?.removeChild(n));
      D.querySelectorAll('pre.cc391-runtime-leak,code.cc391-runtime-leak').forEach(el=>el.remove());
    }catch(_){ }
  }
  function recoverIfBroken(){
    const o=admin();if(!o?.classList.contains('open'))return;
    const stage=D.getElementById('cc378Stage');if(!stage)return;
    if(!stage.firstElementChild){try{window.CRUZCLICK_V388?.renderFunctions?.()}catch(_){}}
    cleanHeaders(stage);
  }
  function boot(){
    cleanHeaders(D);
    scrubVisibleRuntimeCode();
    recoverIfBroken();
  }
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(boot,80),{once:true});else setTimeout(boot,80);
  new MutationObserver(()=>{try{cleanHeaders(D);scrubVisibleRuntimeCode();recoverIfBroken()}catch(_){}}).observe(D.body,{childList:true,subtree:true});
  setInterval(()=>{if(D.hidden)return;try{cleanHeaders(D);scrubVisibleRuntimeCode();recoverIfBroken()}catch(_){ }},1000);
  // If the V3.9.0 emergency view appears, its return action must always go to the real function grid.
  D.addEventListener('click',e=>{
    const b=e.target?.closest?.('#cc390SafeBack');if(!b)return;
    e.preventDefault();e.stopImmediatePropagation();
    try{window.CRUZCLICK_V388?.renderFunctions?.()}catch(_){ }
  },true);
  window.CRUZCLICK_V391={version:'3.9.1',icons:'hardened',numberBadges:false,runtimeLeakGuard:true};
})();
</script>
<style id="cruzclick-v392-dashboard-details-style">
