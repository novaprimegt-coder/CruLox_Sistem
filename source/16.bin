 #cru435Welcome .cru435-discount{font-size:clamp(5.8rem,22vw,6.65rem)}
 #cru435Welcome .cru435-discount.cru435-fixed{font-size:clamp(2.2rem,9vw,3.9rem)}
 #cru435Welcome .cru435-label{font-size:.51rem;padding:7px 11px}
 #cru435Welcome .cru438-ticket{max-width:246px;margin-top:13px;padding:15px 4px 12px}
 #cru435Welcome .cru435-copy{padding:17px 17px 12px}
 #cru435Welcome .cru435-copy h2{font-size:1.42rem}
 #cru435Welcome .cru435-description,#cru435Welcome.cru436-demo .cru435-description{font-size:.67rem;line-height:1.42}
 #cru435Welcome .cru435-code{font-size:1rem}
 #cru435Welcome .cru435-explore{min-height:45px}
}
@media(max-height:720px) and (max-width:720px){
 #cru435Welcome .cru435-art{min-height:238px;padding:58px 10px 7px}
 #cru435Welcome .cru435-discount{font-size:clamp(5.5rem,18vw,6.3rem)}
 #cru435Welcome .cru438-ticket{margin:9px auto 5px;padding:9px 4px}
 #cru435Welcome .cru435-copy{padding-top:12px;padding-bottom:10px}
 #cru435Welcome .cru435-copy h2{font-size:1.32rem}
}
@media(prefers-reduced-motion:reduce){
 #cru435Welcome,#cru435Welcome .cru435-panel,#cru435Welcome button,#cru435Welcome .cru438-shine,#cru435Welcome .cru435-art::after,#cru435Welcome .cru438-product,#cru435Welcome .cru438-starlight{animation:none!important;transition:none!important}
}

/* CruLox V4.3.9: corrección localizada del bloque informativo que desaparece en ciertos navegadores móviles.
   Mantiene la composición y todos los datos, botones y eventos del anuncio. */
@media(max-width:720px){
 #cru435Welcome{
   /* Evita que el desenfoque de toda la pantalla fuerce una composición gráfica inestable. */
   -webkit-backdrop-filter:none!important;
   backdrop-filter:none!important;
 }
 #cru435Welcome .cru435-panel,
 #cru435Welcome.cru435-open .cru435-panel{
   /* Sin transformación 3D del contenedor desplazable en Android/Chrome. */
   transform:none!important;
   -webkit-transform:none!important;
   contain:none!important;
   isolation:auto!important;
   overflow-x:hidden!important;
   overflow-y:auto!important;
   max-height:calc(100dvh - 16px)!important;
   -webkit-overflow-scrolling:touch;
 }
 #cru435Welcome .cru435-body{
   /* Flujo vertical estable: la información siempre va inmediatamente después del cupón. */
   display:flex!important;
   flex-direction:column!important;
   align-items:stretch!important;
   justify-content:flex-start!important;
   grid-template-columns:none!important;
   grid-template-rows:none!important;
   height:auto!important;
   min-height:0!important;
 }
 #cru435Welcome .cru435-art{
   flex:0 0 auto!important;
   height:296px!important;
   min-height:0!important;
   max-height:none!important;
   contain:none!important;
 }
 #cru435Welcome .cru435-copy{
   /* Blindaje de pintura: sin altura impuesta, capas ocultas ni filtros que tapen el texto. */
   position:relative!important;
   display:flex!important;
   flex:0 0 auto!important;
   flex-direction:column!important;
   justify-content:center!important;
   align-items:flex-start!important;
   width:100%!important;
   height:auto!important;
   min-height:0!important;
   max-height:none!important;
   overflow:visible!important;
   visibility:visible!important;
   opacity:1!important;
   transform:none!important;
   -webkit-transform:none!important;
   filter:none!important;
   content-visibility:visible!important;
   contain:none!important;
   isolation:isolate!important;
   z-index:2!important;
   background:linear-gradient(142deg,#041628,#041121 85%)!important;
 }
 #cru435Welcome .cru435-copy > *{
   visibility:visible!important;
   opacity:1!important;
   content-visibility:visible!important;
   transform:none!important;
   filter:none!important;
 }
 #cru435Welcome .cru438-ticket,
 #cru435Welcome .cru438-product{
   -webkit-backdrop-filter:none!important;
   backdrop-filter:none!important;
 }
 #cru435Welcome .cru435-foot{
   position:relative!important;
   flex:0 0 auto!important;
   z-index:3!important;
 }
}
@media(max-width:375px){
 #cru435Welcome .cru435-art{height:267px!important}
}
@media(max-width:720px) and (max-height:720px){
 #cru435Welcome .cru435-art{height:238px!important}
}
</style>
<style id="cru443-promo-last-override">
#cru435Welcome{-webkit-backdrop-filter:none!important;backdrop-filter:none!important;transition:none!important}
#cru435Welcome .cru435-panel,#cru435Welcome.cru435-open .cru435-panel{transform:none!important;-webkit-transform:none!important;opacity:1!important;transition:none!important;isolation:auto!important;will-change:auto!important}
#cru435Welcome .cru438-shine,#cru435Welcome .cru435-art::after,#cru435Welcome .cru438-starlight,#cru435Welcome .cru438-product{animation:none!important;will-change:auto!important}
#cru435Welcome .cru438-shine{opacity:.45!important}
#cru435Welcome .cru438-ticket,#cru435Welcome .cru438-product,#cru435Welcome .cru435-close{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
#cru435Welcome .cru435-art{contain:none!important}
#cru435Welcome .cru435-copy,#cru435Welcome .cru435-copy > *{opacity:1!important;visibility:visible!important;filter:none!important;content-visibility:visible!important}
#cru435Welcome .cru435-explore::after{display:none!important}
</style>
<div id="cru435Welcome" aria-hidden="true">
 <div class="cru435-panel" role="dialog" aria-modal="true" aria-labelledby="cru435Title" tabindex="-1">
  <div class="cru435-header"><div class="cru435-brand"><span class="cru435-brand-icon" aria-hidden="true">✦</span> CRULOX <span style="font-size:.56rem;color:#82bed3;letter-spacing:.08em">OFERTAS</span></div><button class="cru435-close" id="cru435Close" type="button" aria-label="Cerrar anuncio">×</button></div>
  <div class="cru435-body">
   <div class="cru435-art">
     <div class="cru438-shine" aria-hidden="true"></div>
     <span class="cru438-starlight cru438-star1" aria-hidden="true">✧</span><span class="cru438-starlight cru438-star2" aria-hidden="true">✦</span><span class="cru438-starlight cru438-star3" aria-hidden="true">✧</span>
     <div class="cru438-product a" data-empty="true" aria-hidden="true"><img alt="" decoding="async" /></div>
     <div class="cru438-product b" data-empty="true" aria-hidden="true"><img alt="" decoding="async" /></div>
     <div class="cru438-product c" data-empty="true" aria-hidden="true"><img alt="" decoding="async" /></div>
     <span class="cru438-edgemark" aria-hidden="true">CRULOX · DIGITAL</span>
     <div class="cru435-art-content"><span class="cru435-label">Promoción vigente</span><div class="cru438-ticket"><div id="cru435Discount" class="cru435-discount"></div><div class="cru435-art-sub" id="cru435DiscountCaption"></div></div></div>
    </div>
   <div class="cru435-copy"><span class="cru435-eyebrow">Promoción de bienvenida</span><h2 id="cru435Title">Oferta disponible</h2><p id="cru435Description" class="cru435-description"></p><div class="cru435-conditions"><span id="cru435Minimum" class="cru435-condition"></span><span id="cru435Expiry" class="cru435-condition"></span></div><div class="cru435-code-row"><div class="cru435-code-wrap"><small>Tu código promocional</small><strong id="cru435Code" class="cru435-code"></strong></div><button id="cru435Copy" class="cru435-copy-btn" type="button">Copiar</button></div><div id="cru435Feedback" class="cru435-feedback" aria-live="polite"></div><button id="cru435Explore" class="cru435-explore" type="button">Ver productos</button></div>
  </div>
  <div class="cru435-foot"><span class="cru435-counter" id="cru435Counter"></span><div class="cru435-nav" id="cru435Nav"><button id="cru435Prev" type="button">Anterior</button><button id="cru435Next" type="button">Siguiente</button></div></div>
 </div>
</div>
<script id="cru435-promo-welcome-script">
(()=>{
 'use strict';
 const root=document.getElementById('cru435Welcome');
 if(!root)return;
 const get=id=>document.getElementById(id);
 const nodes={panel:root.querySelector('.cru435-panel'),close:get('cru435Close'),discount:get('cru435Discount'),caption:get('cru435DiscountCaption'),title:get('cru435Title'),description:get('cru435Description'),minimum:get('cru435Minimum'),expiry:get('cru435Expiry'),code:get('cru435Code'),copy:get('cru435Copy'),feedback:get('cru435Feedback'),explore:get('cru435Explore'),counter:get('cru435Counter'),nav:get('cru435Nav'),prev:get('cru435Prev'),next:get('cru435Next'),label:root.querySelector('.cru435-label'),eyebrow:root.querySelector('.cru435-eyebrow'),codeLabel:root.querySelector('.cru435-code-wrap small')};
 // Fallback exclusivamente visual: nunca se agrega a state.promos ni al carrito.
 const EXAMPLE_OFFER=Object.freeze({
   code:'EJEMPLO20',description:'Ejemplo de oferta de bienvenida',type:'percent',
   value:20,minPurchase:0,active:true,expiresAt:'',cru436Demo:true
 });
 let visibleOffers=[],index=0,wasFocused=null,opened=false,entranceShown=false;
 // Miniaturas decorativas extraídas exclusivamente de imágenes reales del catálogo.
 function cru438DecorateProducts(){
   const catalog=window.CruzClickRuntime?.getState?.()?.products || (typeof state!=='undefined'?state.products:[]);
   const imageNodes=Array.from(root.querySelectorAll('.cru438-product'));
   const used=new Set();let count=0;
   for(const p of (Array.isArray(catalog)?catalog:[])){
     const src=typeof p?.image==='string'?p.image.trim():'';
     if(!/^(?:data:image\/(?:png|jpe?g|webp|gif);base64,|https?:\/\/|\.\/|\.\.\/|\/)/i.test(src)||used.has(src))continue;
     used.add(src);
     const card=imageNodes[count++];if(!card)break;
     const img=card.querySelector('img');img.src=src;card.removeAttribute('data-empty');
   }
 }
 function isActive(p){
   if(!p||p.active===false||!String(p.code||'').trim()||!Number.isFinite(Number(p.value))||Number(p.value)<=0)return false;
   if(p.expiresAt){
     const end=new Date(`${p.expiresAt}T23:59:59`);
     if(!Number.isNaN(end.getTime())&&Date.now()>end.getTime())return false;
   }
   return true;
 }
 function getActive(){
   const stored=typeof state!=='undefined'&&Array.isArray(state.promos)?state.promos:[];
   return stored.filter(isActive);
 }
 function showOffer(){
   const p=visibleOffers[index];if(!p)return;
   const demo=p.cru436Demo===true;
   root.classList.toggle('cru436-demo',demo);
   nodes.label.textContent=demo?'Muestra ilustrativa':'Promoción vigente';
   nodes.eyebrow.textContent=demo?'Vista de demostración':'Promoción de bienvenida';
   nodes.codeLabel.textContent=demo?'Código ilustrativo (no válido)':'Tu código promocional';
   nodes.copy.disabled=demo;
   const percent=p.type!=='fixed',value=Number(p.value);
   nodes.discount.classList.toggle('cru435-fixed',!percent);
   nodes.discount.textContent=percent?`${value}%`:typeof money==='function'?money(value):String(value);
   nodes.caption.textContent=percent?'de descuento':'de descuento en tu compra';
   nodes.title.textContent=String(p.description||'Descuento especial disponible').trim();
   nodes.description.textContent=demo?'Este anuncio es únicamente un ejemplo mientras se vincula el panel administrativo. El descuento mostrado no está activo y no puede canjearse.':'Utiliza este código al realizar tu pedido para obtener el descuento indicado.';
   nodes.minimum.hidden=!(Number(p.minPurchase)>0);
   if(!nodes.minimum.hidden)nodes.minimum.textContent=`Compra mínima: ${typeof money==='function'?money(Number(p.minPurchase)):p.minPurchase}`;
   let displayExpiry='';
   if(p.expiresAt){
      const d=new Date(`${p.expiresAt}T23:59:59`);
      if(!Number.isNaN(d.getTime()))displayExpiry=`Válida hasta ${d.toLocaleDateString('es-GT',{day:'numeric',month:'long',year:'numeric'})}`;
   }
   nodes.expiry.hidden=!displayExpiry&&!demo;
   nodes.expiry.textContent=demo?'Sin promoción real activa':displayExpiry;
   nodes.code.textContent=String(p.code).trim().toUpperCase();
   nodes.counter.textContent=demo?'Ejemplo · No canjeable':visibleOffers.length>1?`${index+1} de ${visibleOffers.length} promociones`:'Promoción activa';
   nodes.nav.hidden=visibleOffers.length<2;
   nodes.feedback.textContent='';
   nodes.copy.textContent=demo?'No disponible':'Copiar';
 }
 function close(){
   if(!opened)return;
   opened=false;root.classList.remove('cru435-open');root.setAttribute('aria-hidden','true');document.body.classList.remove('cru435-welcome-open');
   if(wasFocused?.isConnected)wasFocused.focus({preventScroll:true});
 }
 function open(){
   if(entranceShown)return;
   entranceShown=true;
   if(document.querySelector('#adminOverlay.open,.modal-overlay.open,.full-fallback.open'))return;
   visibleOffers=getActive();if(!visibleOffers.length)visibleOffers=[EXAMPLE_OFFER];
   index=0;showOffer();cru438DecorateProducts();wasFocused=document.activeElement;
   root.classList.add('cru435-open');root.setAttribute('aria-hidden','false');document.body.classList.add('cru435-welcome-open');opened=true;
   nodes.close.focus({preventScroll:true});
 }
 function move(delta){index=(index+delta+visibleOffers.length)%visibleOffers.length;showOffer()}
 nodes.close.addEventListener('click',close);
 root.addEventListener('click',e=>{if(e.target===root)close()});
 nodes.prev.addEventListener('click',()=>move(-1));
 nodes.next.addEventListener('click',()=>move(1));
 nodes.explore.addEventListener('click',()=>{close();document.getElementById('catalog')?.scrollIntoView({behavior:window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches?'auto':'smooth',block:'start'})});
 nodes.copy.addEventListener('click',async()=>{
   if(visibleOffers[index]?.cru436Demo)return;
   const code=nodes.code.textContent;let copied=false;
   try{if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(code);copied=true}}catch(_){}
   if(!copied){
     const input=document.createElement('textarea');input.value=code;input.setAttribute('readonly','');input.style.cssText='position:fixed;left:-9999px;top:0;opacity:0';document.body.appendChild(input);input.select();
     try{copied=!!document.execCommand('copy')}catch(_){}input.remove();
   }
   nodes.feedback.textContent=copied?'Código copiado. Úsalo en tu carrito.':'Selecciona y copia el código mostrado para usarlo en tu carrito.';
   nodes.copy.textContent=copied?'Copiado':'Copiar';
 });
 document.addEventListener('keydown',e=>{
   if(!opened)return;
   if(e.key==='Escape'){e.preventDefault();close();return}
   if(e.key!=='Tab')return;
   const focusable=Array.from(nodes.panel.querySelectorAll('button:not([disabled])')).filter(el=>!el.closest('[hidden]'));
   if(!focusable.length)return;
   const first=focusable[0],last=focusable[focusable.length-1];
   if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
   else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}
 });
 let touchX=null;
 nodes.panel.addEventListener('touchstart',e=>{if(e.touches.length===1)touchX=e.touches[0].clientX},{passive:true});
 nodes.panel.addEventListener('touchend',e=>{if(touchX===null||visibleOffers.length<2)return;const diff=e.changedTouches[0].clientX-touchX;touchX=null;if(Math.abs(diff)>65&&Math.abs(diff)<450)move(diff<0?1:-1)},{passive:true});
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',open,{once:true});
 else open();
})();
</script>
<script id="crulox-v440-cardnav-menu-engine">
/* Adaptación directa del motor CardNav (resorte + stagger + efecto rise).
   La vista sigue siendo el menú lateral HTML existente, sin componentes React. */
(()=>{
  'use strict';
  const init=()=>{
    const drawer=document.getElementById('drawer');
    if(!drawer||drawer.dataset.cn440Bound==='1')return;
    drawer.dataset.cn440Bound='1';
    drawer.classList.add('cn440-cardnav');
    const state={p:drawer.classList.contains('open')?1:0,v:0,raf:0,last:0};
    const k=160; // CardNav: 160 * speed^2, speed = 1
    const bounce=.2;
    const stagger=.12;
    const easing=t=>1-(1-t)**3;
    const clamp=(v,min,max)=>Math.min(max,Math.max(min,v));
    const reduced=()=>window.matchMedia?.('(prefers-reduced-motion: reduce)').matches||false;
    let items=[];
    let introPlayed=false;
    const collect=()=>{
      items=Array.from(drawer.querySelectorAll('.jmv24-nav-item'));
    };
    const paint=(target,done)=>{
      const p=clamp(state.p,0,1);
      const left=(state.p-1)*100;
      drawer.style.setProperty('transform',`translate3d(${left.toFixed(4)}%,0,0)`,'important');
      const count=items.length;
      const lag=count>1?Math.min(stagger,.7/(count-1)):0;
      const span=1-lag*(count-1);
      for(let i=0;i<count;i++){
        const card=items[i];
        if(done){
          card.style.removeProperty('transform');
          card.style.removeProperty('opacity');
          card.style.removeProperty('filter');
          continue;
        }
        const local=clamp((p-i*lag)/Math.max(span,.05),0,1);
        const e=easing(local);
        card.style.setProperty('transform',`translateY(${((1-e)*26).toFixed(2)}px) scale(${(.97+.03*e).toFixed(4)})`,'important');
        card.style.opacity=String(e);
      }
    };
    const frame=now=>{
      state.raf=0;
      const target=drawer.classList.contains('open')?1:0;
      if(reduced()){
        state.p=target;state.v=0;
      }else{
        const dt=state.last?Math.min(.05,(now-state.last)/1000):1/60;
        state.last=now;
        const zeta=target?1-.68*bounce:1;
        const steps=Math.ceil(dt/(1/240));
        const h=dt/steps;
        for(let i=0;i<steps;i++){
          state.v+=(-k*(state.p-target)-2*zeta*Math.sqrt(k)*state.v)*h;
          state.p+=state.v*h;
        }
      }
      const done=Math.abs(state.p-target)<.0005&&Math.abs(state.v)<.002;
      if(done){state.p=target;state.v=0}
      paint(target,done);
      if(!done)state.raf=requestAnimationFrame(frame);
    };
    const wake=()=>{
      if(state.raf)return;
      state.last=0;
      state.raf=requestAnimationFrame(frame);
    };
    const revealIntro=()=>{
      if(introPlayed||reduced())return;
      introPlayed=true;
      if(typeof drawer.animate!=='function')return;
      drawer.animate([
        {clipPath:'inset(0 94% 0 0 round 18px)',opacity:0},
        {clipPath:'inset(0 0 0 0 round 18px)',opacity:1}
      ],{duration:820,easing:'cubic-bezier(0.22, 1, 0.36, 1)',fill:'backwards'});
      const header=drawer.querySelector('.drawer-head');
      if(header){
        Array.from(header.children).forEach((child,i)=>{
          child.animate([
            {opacity:0,transform:'translateY(8px)'},
            {opacity:1,transform:'translateY(0)'}
          ],{duration:560,delay:220+i*70,easing:'cubic-bezier(0.22, 1, 0.36, 1)',fill:'backwards'});
        });
      }
    };
    collect();
    paint(drawer.classList.contains('open')?1:0,true);
    // Únicamente observa apertura/cierre del menú, no otros módulos.
    const observer=new MutationObserver(()=>{
      const open=drawer.classList.contains('open');
      if(open){collect();revealIntro()}
      wake();
    });
    observer.observe(drawer,{attributes:true,attributeFilter:['class']});
    window.CRULOX_CARDNAV_V440={version:'4.4.0',refresh:()=>{collect();wake()},get isOpen(){return drawer.classList.contains('open')}};
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
  else init();
})();
</script>

<style id="cru452-search-premium-visual">
/* V4.5.2: visual exclusivo del buscador; motor y navegación permanecen intactos. */
#cru443Search{
  align-items:center;justify-content:center;
  padding:clamp(10px,3vh,32px) 14px;
  background:rgba(1,7,16,.94);
  -webkit-backdrop-filter:none;backdrop-filter:none;
}
#cru443Search .cru443-shell{
  position:relative;isolation:isolate;
  width:min(875px,100%);height:min(790px,calc(100dvh - 32px));max-height:calc(100dvh - 24px);
  border:1px solid rgba(91,211,244,.26);border-radius:26px;
  background:linear-gradient(155deg,#0b2234 0%,#071625 38%,#06111f 100%);
  box-shadow:0 34px 100px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.018) inset;
  overflow:hidden;
}
#cru443Search .cru443-shell::before{
  content:"";position:absolute;top:0;left:10%;right:10%;height:2px;z-index:1;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(59,221,255,.95),transparent);
}
#cru443Search .cru443-top{
  position:relative;min-height:140px;
  align-items:flex-start;gap:12px;
  padding:26px 29px 23px;
  border-bottom:1px solid rgba(117,185,217,.08);
  background:radial-gradient(ellipse at 94% 0%,rgba(0,178,230,.16),transparent 48%),linear-gradient(180deg,rgba(12,40,59,.85),rgba(8,26,43,.08));
}
#cru443Search .cru443-heading{min-width:0;max-width:620px}
#cru443Search .cru443-overline{
  display:inline-flex;align-items:center;gap:8px;
  color:#70d8ec;font-size:.61rem;font-weight:850;letter-spacing:.19em;line-height:1.4;
}
#cru443Search .cru443-live-dot{width:6px;height:6px;flex:0 0 6px;border-radius:50%;background:#19dbf1;box-shadow:0 0 0 4px rgba(12,208,231,.11)}
#cru443Search .cru443-title{
  margin:10px 0 7px;color:#f5fcff;
  font-size:clamp(1.58rem,3.4vw,2.16rem);font-weight:900;letter-spacing:-.05em;line-height:1.09;
}
#cru443Search .cru443-title span{color:#52e0f3}
#cru443Search .cru443-sub{max-width:560px;font-size:.78rem;line-height:1.5;color:#9ebace;margin:0}
#cru443Search .cru443-close{
  display:grid;place-items:center;flex:0 0 42px;width:42px;height:42px;min-height:42px;
  border-radius:13px;border:1px solid rgba(128,206,239,.18);
  background:rgba(128,194,223,.06);color:#bcdde9;box-shadow:none;
  transition:background .16s,border-color .16s,color .16s;
}
#cru443Search .cru443-close:hover,#cru443Search .cru443-close:focus-visible{border-color:rgba(86,215,247,.65);background:rgba(40,177,213,.15);color:#fff;outline:none}
#cru443Search .cru443-search-area{
  flex:0 0 auto;padding:19px 29px 11px;
  background:linear-gradient(180deg,rgba(4,19,34,.2),transparent);
}
#cru443Search .cru443-input-row{
  display:flex;align-items:center;gap:13px;min-height:58px;
  padding:0 17px;margin:0;border-radius:16px;
  background:#061421;border:1px solid rgba(96,183,223,.29);
  box-shadow:0 1px 0 rgba(255,255,255,.025) inset,0 6px 22px rgba(0,0,0,.11);
  transition:border-color .18s ease,box-shadow .18s ease,background .18s ease;
}
#cru443Search .cru443-input-row:focus-within{
  background:#081d2c;border-color:#4cdbf5;
  box-shadow:0 0 0 3px rgba(36,199,242,.11),0 8px 22px rgba(0,0,0,.13);
}
#cru443Search .cru443-input-row svg{flex:0 0 21px;width:21px;height:21px;color:#59d9eb}
#cru443Search #cru443Input{
  display:block;min-width:0;width:100%;height:56px;padding:0;
  border:0!important;border-radius:0!important;outline:none!important;box-shadow:none!important;
  background:transparent!important;color:#f3fbff;font-size:.89rem;line-height:normal;
  -webkit-appearance:none;appearance:none;caret-color:#3adfff;
}
#cru443Search #cru443Input:focus,#cru443Search #cru443Input:focus-visible{outline:0!important;box-shadow:none!important}
#cru443Search #cru443Input::placeholder{color:#7997a9;opacity:1}
#cru443Search #cru443Input::-webkit-search-cancel-button{cursor:pointer}
#cru443Search .cru443-result-head{
  min-height:74px;align-items:center;gap:12px;
  padding:11px 29px 13px;border-bottom:1px solid rgba(110,188,220,.085);
}
#cru443Search .cru443-result-heading{display:flex;flex-direction:column;gap:4px;min-width:0}
#cru443Search .cru443-section-kicker{color:#5d9caf;font-size:.56rem;font-weight:800;letter-spacing:.16em}
#cru443Search .cru443-result-head strong{color:#edf8fc;font-size:.91rem;font-weight:850;letter-spacing:-.025em}
#cru443Search #cru443Count{
  flex:0 0 auto;border:1px solid rgba(102,206,239,.16);border-radius:999px;
  padding:7px 11px;background:rgba(28,108,143,.11);color:#89cde2;
  font-size:.65rem;font-weight:750;white-space:nowrap;
}
#cru443Search #cru443Results{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;
  gap:10px;padding:13px 24px 18px;
  overflow-x:hidden;overflow-y:auto;
  scrollbar-width:thin;scrollbar-color:#226783 transparent;
}
#cru443Search .cru443-result{
  min-width:0;display:grid;grid-template-columns:66px minmax(0,1fr);
  grid-template-rows:auto auto;column-gap:12px;row-gap:0;align-content:center;align-items:center;
  padding:9px;min-height:90px;
  border:1px solid rgba(95,166,208,.12);border-radius:17px;
  background:linear-gradient(125deg,rgba(21,56,75,.67),rgba(8,26,43,.68));
  color:#effaff;box-shadow:inset 0 1px rgba(255,255,255,.025);
  transition:background .17s ease,border-color .17s ease,box-shadow .17s ease,transform .17s ease;
}
#cru443Search .cru443-result:hover,#cru443Search .cru443-result:focus-visible,#cru443Search .cru443-result.cru443-selected{
  border-color:rgba(61,218,244,.65);background:linear-gradient(115deg,rgba(25,83,103,.8),rgba(9,35,56,.92));
  box-shadow:0 0 0 2px rgba(47,206,242,.07),inset 0 1px rgba(255,255,255,.04);
  outline:0;transform:none;
}
#cru443Search .cru443-result img{
  width:66px;height:66px;grid-column:1;grid-row:1 / span 2;
  object-fit:cover;border-radius:12px;background:#081626;
  border:1px solid rgba(255,255,255,.08);
}
#cru443Search .cru443-info{
  grid-column:2;grid-row:1;min-width:0;
  display:flex;flex-direction:column;justify-content:flex-end;align-self:end;gap:4px;
}
#cru443Search .cru443-info b{
  color:#f2faff;font-size:.78rem;font-weight:810;line-height:1.28;letter-spacing:-.01em;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
#cru443Search .cru443-info small{font-size:.62rem;color:#84adc2;line-height:1.25;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
#cru443Search .cru443-price{
  grid-column:2;grid-row:2;justify-self:start;align-self:start;margin-top:5px;
  font-size:.77rem;color:#48e1f6;font-weight:900;line-height:1.1;
}
#cru443Search .cru443-empty{
  grid-column:1 / -1;margin:13px 0;padding:42px 20px;
  border:1px dashed rgba(82,174,206,.25);border-radius:18px;
  background:rgba(8,28,44,.54);color:#a9c6d4;font-size:.81rem;line-height:1.7;
}
#cru443Search .cru443-footer{
  min-height:78px;display:flex;gap:12px;align-items:center;justify-content:space-between;
  padding:14px 29px 16px;border-top:1px solid rgba(83,177,212,.14);
  background:linear-gradient(90deg,rgba(9,29,44,.97),rgba(7,22,37,.98));
}
#cru443Search .cru443-footer small{font-size:.68rem;color:#8caec0;line-height:1.42;max-width:250px}
#cru443Search #cru443All{
  flex:0 0 auto;min-height:46px;padding:10px 23px;
  border:1px solid rgba(142,247,255,.45);border-radius:13px;
  background:linear-gradient(112deg,#63e5f5 0%,#24b7e4 90%);color:#042334;
  font-size:.75rem;font-weight:900;box-shadow:0 8px 22px rgba(5,165,210,.12);
  transition:filter .16s ease,box-shadow .16s ease;
}
#cru443Search #cru443All:not(:disabled):hover,#cru443Search #cru443All:not(:disabled):focus-visible{
  filter:brightness(1.06);box-shadow:0 10px 27px rgba(5,165,210,.22);outline:none;
}
#cru443Search #cru443All:disabled{opacity:.44;filter:grayscale(.35);box-shadow:none}
@media(max-width:700px){
  #cru443Search{padding:max(8px,env(safe-area-inset-top)) 8px max(8px,env(safe-area-inset-bottom));align-items:cent