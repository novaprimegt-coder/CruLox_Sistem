}

/* Cuando el índice se oculta, no ocupa ningún espacio */
#adminOverlay .cc405-index.cc405-sidebar-hidden .cc405-sidebar{
  height:0 !important;
  max-height:0 !important;
  min-height:0 !important;
}

/* En móvil se conserva el comportamiento fijo y el scroll interno */
@media(max-width:560px){
  #adminOverlay .cc405-sidebar{
    top:6px !important;
    height:calc(100dvh - 12px) !important;
    max-height:calc(100dvh - 12px) !important;
  }
