#adminOverlay .cc394-head{display:flex;align-items:end;justify-content:space-between;gap:10px;margin-bottom:11px}#adminOverlay .cc394-head h3{margin:0;color:#f0fbff;font-size:.76rem}#adminOverlay .cc394-head p{margin:4px 0 0;color:#7893a6;font-size:.46rem;line-height:1.45}#adminOverlay .cc394-tag{padding:6px 9px;border-radius:999px;border:1px solid rgba(54,224,255,.13);background:rgba(0,216,255,.05);color:#67e8f7;font-size:.40rem;font-weight:900;white-space:nowrap}
#adminOverlay .cc394-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}#adminOverlay .cc394-tool{position:relative;display:grid;grid-template-columns:38px minmax(0,1fr) auto;align-items:center;gap:9px;min-width:0;padding:10px;border:1px solid rgba(123,201,238,.075);border-radius:15px;background:linear-gradient(145deg,rgba(12,35,53,.82),rgba(5,20,32,.9));color:#edfaff;text-align:left;cursor:pointer;touch-action:manipulation;transition:.15s ease}#adminOverlay .cc394-tool:hover{transform:translateY(-1px);border-color:rgba(75,229,255,.22);box-shadow:0 10px 24px rgba(0,0,0,.18)}#adminOverlay .cc394-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;border:1px solid rgba(67,227,255,.17);background:radial-gradient(circle at 35% 25%,rgba(98,240,255,.16),transparent 60%),rgba(0,215,255,.045);color:#74efff;font-size:.63rem;font-weight:950}#adminOverlay .cc394-tool b{display:block;font-size:.53rem;line-height:1.25;overflow-wrap:anywhere}#adminOverlay .cc394-tool small{display:block;margin-top:3px;color:#718ca0;font-size:.40rem;line-height:1.35}#adminOverlay .cc394-open{color:#31dff8;font-size:.64rem;font-weight:900}
