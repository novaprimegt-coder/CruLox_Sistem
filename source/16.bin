  #adminOverlay .cc378-nav-icon{width:58px!important;height:58px!important;min-width:58px!important;min-height:58px!important;flex-basis:58px!important;border-radius:18px!important}
  #adminOverlay .cc378-nav-icon svg,#adminOverlay .cc378-nav-icon svg *{width:29px!important;height:29px!important}
  #adminOverlay .cc378-nav-label{font-size:.69rem!important;line-height:1.17!important}
  #adminOverlay .cc378-nav-sub{font-size:.44rem!important;line-height:1.38!important;width:94%!important}
