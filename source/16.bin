<script id="cruzclick-store-separation-v420-script">
(function(){
  'use strict';
  document.documentElement.dataset.cruzclickApp='store';
  document.title='CRULOX · Tienda';
  try{localStorage.removeItem('cc_admin_panel_open_v3718')}catch(e){}
  function lockStore(){
    const a=document.getElementById('adminOverlay');
    if(a){a.classList.remove('open');a.removeAttribute('data-cc-owner-auth');a.setAttribute('aria-hidden','true')}
    document.body.classList.remove('lock');
  }
  lockStore();
  new MutationObserver(lockStore).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>


<!-- =========================================================
     CRUZCLICK FIREBASE CONFIG
     Pega aquí EXACTAMENTE la configuración de tu app Web
     desde Firebase Console > Project settings > Your apps.
     Mientras los campos estén vacíos, CRULOX conserva modo local.
     ========================================================= -->
<script id="cruzclick-firebase-config-v420">
window.CRUZCLICK_FIREBASE_CONFIG = Object.freeze({
  apiKey: "",
  authDomain: "",
  projectId: "",
  storageBucket: "",
  messagingSenderId: "",
  appId: "",
  measurementId: ""
});
window.CRUZCLICK_FIREBASE_ROLE = "store";
window.CRUZCLICK_FIREBASE_ADMIN_EMAIL = "novaprime.gt@gmail.com";
window.CRUZCLICK_FIREBASE_COLLECTIONS = Object.freeze({
  products: "products",
  users: "users",
  orders: "orders",
  subscriptions: "subscriptions",
  accountsProfiles: "accountsProfiles",
  payments: "payments",
  notifications: "notifications",
  activity: "activity",
  settings: "systemSettings"
});
</script>

<script id="cruzclick-runtime-bridge-v420">
(function(){
  'use strict';
  try{
    if(!Object.getOwnPropertyDescriptor(window,'state')){
      Object.defineProperty(window,'state',{
        configurable:true,
        enumerable:false,
        get:function(){ try{ return state; }catch(e){ return undefined; } },
        set:function(v){
          try{
            if(v && typeof v==='object' && typeof state==='object') Object.assign(state,v);
          }catch(e){}
        }
      });
    }
  }catch(e){}

  window.CruzClickRuntime = Object.freeze({
    getState:function(){ try{ return state; }catch(e){ return null; } },
    getKeys:function(){ try{ return KEYS; }catch(e){ return {}; } },
    write:function(k,v){ try{ return write(k,v); }catch(e){ return false; } },
    persist:function(){ try{ return persistCore(); }catch(e){ return false; } },
    renderStore:function(){ try{ return renderStore(); }catch(e){} },
    renderHeader:function(){ try{ return renderHeader(); }catch(e){} },
    renderAccount:function(){ try{ return renderAccount(); }catch(e){} },
    closeAccount:function(){ try{ return closeModal('accountModal'); }catch(e){} },
    toast:function(msg,type='info'){
      try{ if(typeof toast==='function') return toast(msg,type); }catch(e){}
      console.log('[CRULOX]',msg);
    }
  });
})();
</script>


<script type="module" id="cruzclick-firebase-adapter-v420">
const ROLE = "store";
const SDK_VERSION = "12.19.0";
const CONFIG = window.CRUZCLICK_FIREBASE_CONFIG || {};
const COLLECTIONS = window.CRUZCLICK_FIREBASE_COLLECTIONS || {};
const ADMIN_EMAIL = String(window.CRUZCLICK_FIREBASE_ADMIN_EMAIL || '').trim().toLowerCase();
const runtime = () => window.CruzClickRuntime || null;

const LOCAL_KEYS = Object.freeze({
  products:'jm_digital_v1_products',
  combos:'jm_digital_v1_bundles',
  faqs:'jm_digital_v1_faqs',
  settings:'jm_digital_v1_settings',
  users:'jm_digital_v1_users',
  orders:'jm_digital_v1_orders',
  session:'jm_digital_v1_session',
  activity:'jm_digital_v1_activity'
});

let sdk = null;
let app = null;
let auth = null;
let db = null;
let storage = null;
let ready = false;
let starting = null;
let suppressLocalWrites = false;
let currentFirebaseUser = null;
const pendingTimers = new Map();
const unsubscribers = [];

function dispatchStatus(status, detail={}){
  window.dispatchEvent(new CustomEvent('cruzclick:firebase-status',{detail:{status,role:ROLE,...detail}}));
}

function configured(){
  const required=['apiKey','authDomain','projectId','storageBucket','messagingSenderId','appId'];
  return required.every(k=>typeof CONFIG[k]==='string' && CONFIG[k].trim().length>4);
}

function clone(value){
  try{ return structuredClone(value); }catch(e){
    try{ return JSON.parse(JSON.stringify(value)); }catch(_){ return value; }
  }
}

function clean(value){
  if(Array.isArray(value)) return value.map(clean);
  if(value && typeof value==='object'){
    const out={};
    for(const [k,v] of Object.entries(value)){
      if(v===undefined) continue;
      out[k]=clean(v);
    }
    return out;
  }
  return value;
}

function safeId(value,fallback='item'){
  return String(value||fallback).replace(/[^a-zA-Z0-9_-]/g,'_').slice(0,160) || fallback;
}

async function loadSdk(){
  if(sdk) return sdk;
  const base=`https://www.gstatic.com/firebasejs/${SDK_VERSION}`;
  const [appMod,authMod,firestoreMod,storageMod] = await Promise.all([
    import(`${base}/firebase-app.js`),
    import(`${base}/firebase-auth.js`),
    import(`${base}/firebase-firestore.js`),
    import(`${base}/firebase-storage.js`)
  ]);
  sdk={...appMod,...authMod,...firestoreMod,...storageMod};
  return sdk;
}

function localSet(key,value){
  suppressLocalWrites=true;
  try{
    localStorage.setItem(key,JSON.stringify(value));
    const rt=runtime();
    const st=rt?.getState?.();
    if(st){
      if(key===LOCAL_KEYS.products) st.products=clone(value);
      else if(key===LOCAL_KEYS.users) st.users=clone(value);
      else if(key===LOCAL_KEYS.orders) st.orders=clone(value);
      else if(key===LOCAL_KEYS.settings) st.settings={...(st.settings||{}),...clone(value)};
      else if(key===LOCAL_KEYS.faqs) st.faqs=clone(value);
      else if(key===LOCAL_KEYS.combos) st.combos=clone(value);
      else if(key===LOCAL_KEYS.activity) st.activity=clone(value);
      else if(key===LOCAL_KEYS.session) st.session=clone(value);
    }
  }finally{
    suppressLocalWrites=false;
  }
  window.dispatchEvent(new CustomEvent('cruzclick:firebase-sync',{detail:{key,role:ROLE}}));
}

function rerenderAfterRemote(){
  const rt=runtime();
  if(!rt) return;
  try{ rt.renderHeader?.(); }catch(e){}
  if(ROLE==='store'){
    try{ rt.renderStore?.(); }catch(e){}
    try{ rt.renderAccount?.(); }catch(e){}
  }
}

async function dataUrlToStorageUrl(dataUrl,path){
  if(!storage || typeof dataUrl!=='string' || !dataUrl.startsWith('data:')) return dataUrl;
  const response=await fetch(dataUrl);
  const blob=await response.blob();
  const objectRef=sdk.ref(storage,path);
  await sdk.uploadBytes(objectRef,blob,{contentType:blob.type||'application/octet-stream'});
  return sdk.getDownloadURL(objectRef);
}

async function cloudSafeProduct(product){
  const p=clean(clone(product||{}));
  const id=safeId(p.id,'product');
  const fields=['image','image2'];
  for(const f of fields){
    if(typeof p[f]==='string' && p[f].startsWith('data:image/')){
      try{ p[f]=await dataUrlToStorageUrl(p[f],`products/${id}/${f}_${Date.now()}`); }catch(e){
        console.warn('Firebase product media upload',e);
        delete p[f];
      }
    }
  }
  if(Array.isArray(p.images)){
    const next=[];
    for(let i=0;i<p.images.length;i++){
      const img=p.images[i];
      if(typeof img==='string' && img.startsWith('data:image/')){
        try{ next.push(await dataUrlToStorageUrl(img,`products/${id}/gallery_${i}_${Date.now()}`)); }
        catch(e){ console.warn('Firebase gallery upload',e); }
      }else if(img) next.push(img);
    }
    p.images=next;
  }
  return p;
}

async function cloudSafeOrder(order){
  const o=clean(clone(order||{}));
  const id=safeId(o.id,'order');
  const receipt=o?.payment?.receiptDataUrl;
  if(typeof receipt==='string' && receipt.startsWith('data:image/')){
    try{
      const url=await dataUrlToStorageUrl(receipt,`receipts/${id}/${Date.now()}_${safeId(o?.payment?.receiptName||'receipt')}`);
      o.payment=o.payment||{};
      o.payment.receiptUrl=url;
      delete o.payment.receiptDataUrl;
    }catch(e){
      console.warn('Firebase receipt upload',e);
      if(o.payment) delete o.payment.receiptDataUrl;
    }
  }
  return o;
}

async function cloudSafeItem(collectionName,item){
  if(collectionName===COLLECTIONS.products) return cloudSafeProduct(item);
  if(collectionName===COLLECTIONS.orders) return cloudSafeOrder(item);
  return clean(clone(item));
}

async function syncArrayCollection(collectionName,array,{allowDelete=false,filter=null}={}){
  if(!ready || !db || !Array.isArray(array)) return false;
  let list=array;
  if(typeof filter==='function') list=array.filter(filter);

  const ids=new Set();
  for(const raw of list){
    const id=safeId(raw?.id || raw?.uid || crypto.randomUUID());
    ids.add(id);
    const payload=await cloudSafeItem(collectionName,{...raw,id});
    payload.updatedAtFirebase=sdk.serverTimestamp();
    await sdk.setDoc(sdk.doc(db,collectionName,id),payload,{merge:true});
  }

  if(allowDelete){
    const snap=await sdk.getDocs(sdk.collection(db,collectionName));
    for(const d of snap.docs){
      if(!ids.has(d.id)) await sdk.deleteDoc(d.ref);
    }
  }
  return true;
}

async function syncSettingsDoc(docId,value){
  if(!ready || !db) return false;
  await sdk.setDoc(
    sdk.doc(db,COLLECTIONS.settings,docId),
    {...clean(clone(value)),updatedAtFirebase:sdk.serverTimestamp()},
    {merge:true}
  );
  return true;
}

function currentLocalUser(){
  const st=runtime()?.getState?.();
  const uid=currentFirebaseUser?.uid;
  if(!st || !uid || !Array.isArray(st.users)) return null;
  return st.users.find(u=>u.id===uid || u.firebaseUid===uid || String(u.email||'').toLowerCase()===String(currentFirebaseUser.email||'').toLowerCase())||null;
}

async function syncKey(key,value){
  if(!ready || suppressLocalWrites) return false;

  if(ROLE==='panel'){
    if(key===LOCAL_KEYS.products) return syncArrayCollection(COLLECTIONS.products,value,{allowDelete:true});
    if(key===LOCAL_KEYS.orders) return syncArrayCollection(COLLECTIONS.orders,value,{allowDelete:true});
    if(key===LOCAL_KEYS.users) return syncArrayCollection(COLLECTIONS.users,value,{allowDelete:false});
    if(key===LOCAL_KEYS.settings) return syncSettingsDoc('store',value);
    if(key===LOCAL_KEYS.faqs) return syncSettingsDoc('faqs',{items:value});
    if(key===LOCAL_KEYS.combos) return syncSettingsDoc('combos',{items:value});
    if(key===LOCAL_KEYS.activity) return syncSettingsDoc('activityMirror',{items:Array.isArray(value)?value.slice(-300):[]});
    return false;
  }

  /* Tienda: nunca escribe catálogo/configuración. Solo cliente y sus pedidos. */
  if(ROLE==='store'){
    if(!currentFirebaseUser) return false;
    if(key===LOCAL_KEYS.users){
      const user=(Array.isArray(value)?value:[]).find(u=>u.id===currentFirebaseUser.uid || String(u.email||'').toLowerCase()===String(currentFirebaseUser.email||'').toLowerCase());
      if(!user) return false;
      return sdk.setDoc(sdk.doc(db,COLLECTIONS.users,currentFirebaseUser.uid),{...clean(clone(user)),id:currentFirebaseUser.uid,firebaseUid:currentFirebaseUser.uid,updatedAtFirebase:sdk.serverTimestamp()},{merge:true});
    }
    if(key===LOCAL_KEYS.orders){
      const uid=currentFirebaseUser.uid;
      return syncArrayCollection(COLLECTIONS.orders,value,{
        allowDelete:false,
        filter:o=>String(o?.userId||o?.firebaseUid||o?.customer?.userId||'')===uid || String(o?.customer?.email||'').toLowerCase()===String(currentFirebaseUser.email||'').toLowerCase()
      });
    }
  }
  return false;
}

function queueLocalWrite(key,value){
  if(!ready || suppressLocalWrites) return false;
  const k=String(key||'');
  clearTimeout(pendingTimers.get(k));
  const snapshot=clone(value);
  pendingTimers.set(k,setTimeout(()=>{
    pendingTimers.delete(k);
    syncKey(k,snapshot).catch(err=>console.warn('Firebase local sync',k,err));
  },650));
  return true;
}

function subscribeCollection(collectionName,localKey){
  const unsub=sdk.onSnapshot(
    sdk.collection(db,collectionName),
    snap=>{
      const rows=snap.docs.map(d=>({id:d.id,...d.data()}));
      localSet(localKey,rows);
      rerenderAfterRemote();
    },
    err=>console.warn('Firebase snapshot',collectionName,err)
  );
  unsubscribers.push(unsub);
}

function subscribeDoc(collectionName,docId,localKey,transform=v=>v){
  const unsub=sdk.onSnapshot(
    sdk.doc(db,collectionName,docId),
    snap=>{
      if(!snap.exists()) return;
      localSet(localKey,transform(snap.data()));
      rerenderAfterRemote();
    },
    err=>console.warn('Firebase document snapshot',docId,err)
  );
  unsubscribers.push(unsub);
}

function startRemoteListeners(){
  subscribeCollection(COLLECTIONS.products,LOCAL_KEYS.products);
  subscribeDoc(COLLECTIONS.settings,'store',LOCAL_KEYS.settings);
  subscribeDoc(COLLECTIONS.settings,'faqs',LOCAL_KEYS.faqs,d=>Array.isArray(d?.items)?d.items:[]);
  subscribeDoc(COLLECTIONS.settings,'combos',LOCAL_KEYS.combos,d=>Array.isArray(d?.items)?d.items:[]);

  if(ROLE==='panel'){
    subscribeCollection(COLLECTIONS.orders,LOCAL_KEYS.orders);
    subscribeCollection(COLLECTIONS.users,LOCAL_KEYS.users);
  }
}

async function loadCurrentFirebaseUserIntoLocal(user){
  if(!user || !db) return;
  const ref=sdk.doc(db,COLLECTIONS.users,user.uid);
  const snap=await sdk.getDoc(ref);
  const data=snap.exists()?snap.data():{};
  const profile={
    id:user.uid,
    firebaseUid:user.uid,
    fullName:data.fullName||user.displayName||data.username||'Cliente',
    username:data.username||String(user.email||'cliente').split('@')[0],
    email:user.email||data.email||'',
    phone:data.phone||'',
    department:data.department||'',
    municipality:data.municipality||'',
    address:data.address||'',
    reference:data.reference||'',
    createdAt:data.createdAt||new Date().toISOString(),
    updatedAt:new Date().toISOString()
  };
  const st=runtime()?.getState?.();
  if(st){
    const list=Array.isArray(st.users)?st.users.slice():[];
    const index=list.findIndex(u=>u.id===user.uid || String(u.email||'').toLowerCase()===String(profile.email||'').toLowerCase());
    if(index>=0) list[index]={...list[index],...profile};
    else list.unshift(profile);
    localSet(LOCAL_KEYS.users,list);
    st.session={role:'client',userId:user.uid,firebaseUid:user.uid,persistent:true,createdAt:new Date().toISOString()};
    localSet(LOCAL_KEYS.session,st.session);
  }
  await sdk.setDoc(ref,{...profile,updatedAtFirebase:sdk.serverTimestamp()},{merge:true});
  rerenderAfterRemote();
}

function installStoreAuthBridge(){
  if(ROLE!=='store') return;

  document.addEventListener('submit',async event=>{
    const form=event.target;
    if(!form || (form.id!=='loginForm' && form.id!=='registerForm')) return;
    if(!configured()) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    try{
      await initialize();
      if(form.id==='loginForm'){
        const email=String(document.getElementById('loginIdentity')?.value||'').trim();
        const password=String(document.getElementById('loginPassword')?.value||'');
        if(!email || !password) throw new Error('Escribe correo y contraseña.');
        const cred=await sdk.signInWithEmailAndPassword(auth,email,password);
        await loadCurrentFirebaseUserIntoLocal(cred.user);
        runtime()?.closeAccount?.();
        runtime()?.toast?.('Sesión iniciada con Firebase.','success');
      }else{
        const email=String(document.getElementById('regEmail')?.value||'').trim();
        const password=String(document.getElementById('regPassword')?.value||'');
        const confirm=String(document.getElementById('regConfirm')?.value||'');
        if(!email || !password) throw new Error('Correo y contraseña son obligatorios.');
        if(password!==confirm) throw new Error('Las contraseñas no coinciden.');
        const cred=await sdk.createUserWithEmailAndPassword(auth,email,password);

        const profile={id:cred.user.uid,firebaseUid:cred.user.uid,email};
        for(const key of ['fullName','username','phone','department','municipality','address','reference']){
          const id='reg'+key.charAt(0).toUpperCase()+key.slice(1);
          profile[key]=String(document.getElementById(id)?.value||'').trim();
        }
        profile.createdAt=new Date().toISOString();
        profile.updatedAt=profile.createdAt;
        await sdk.setDoc(sdk.doc(db,COLLECTIONS.users,cred.user.uid),{...clean(profile),updatedAtFirebase:sdk.serverTimestamp()},{merge:true});
        await loadCurrentFirebaseUserIntoLocal(cred.user);
        runtime()?.closeAccount?.();
        runtime()?.toast?.('Cuenta creada y conectada a Firebase.','success');
      }
    }catch(err){
      console.error('CRULOX Firebase auth',err);
      runtime()?.toast?.(err?.message||'No fue posible autenticar con Firebase.','error');
    }
  },true);

  document.addEventListener('click',event=>{
    const logout=event.target?.closest?.('#logoutClient');
    if(!logout || !configured()) return;
    sdk?.signOut?.(auth).catch(()=>{});
  },true);
}

function installPanelAuthBridge(){
  if(ROLE!=='panel') return;

  document.addEventListener('submit',async event=>{
    const form=event.target;
    if(!form || form.id!=='loginForm' || !configured()) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    const email=String(document.getElementById('loginIdentity')?.value||'').trim().toLowerCase();
    const password=String(document.getElementById('loginPassword')?.value||'');

    if(email!==ADMIN_EMAIL){
      runtime()?.toast?.('Este archivo admite únicamente la cuenta administradora autorizada.','error');
      return;
    }

    try{
      await initialize();
      const cred=await sdk.signInWithEmailAndPassword(auth,email,password);
      if(String(cred.user.email||'').toLowerCase()!==ADMIN_EMAIL) throw new Error('Cuenta administrativa no autorizada.');

      const st=runtime()?.getState?.();
      if(st){
        st.session={
          role:'admin',
          email:ADMIN_EMAIL,
          firebaseUid:cred.user.uid,
          ownerAuthVersion:'cruzclick-owner-v3718',
          persistent:true,
          firebaseAuth:true,
          createdAt:new Date().toISOString()
        };
        runtime()?.write?.(LOCAL_KEYS.session,st.session);
      }

      try{ if(typeof closeModal==='function') closeModal('accountModal'); }catch(e){}
      setTimeout(()=>{
        try{
          if(window.CRUZCLICK_V3718?.openAdmin) window.CRUZCLICK_V3718.openAdmin('home');
          else if(typeof window.openAdmin==='function') window.openAdmin('home');
        }catch(e){ console.error(e); }
      },50);

      runtime()?.toast?.('Panel conectado con Firebase Authentication.','success');
    }catch(err){
      console.error('CRULOX Firebase admin auth',err);
      runtime()?.toast?.('Credenciales administrativas no válidas en Firebase.','error');
    }
  },true);

  document.addEventListener('click',event=>{
    const logout=event.target?.closest?.('#cc378Logout,#adminLogout');
    if(!logout || !configured()) return;
    sdk?.signOut?.(auth).catch(()=>{});
  },true);
}

async function initialize(){
  if(ready) return api;
  if(starting) return starting;

  starting=(async()=>{
    if(!configured()){
      dispatchStatus('not-configured',{message:'Pega la configuración Web de Firebase para activar la conexión.'});
      return api;
    }

    dispatchStatus('connecting');
    await loadSdk();

    app=sdk.initializeApp(CONFIG);
    auth=sdk.getAuth(app);
    db=sdk.getFirestore(app);
    storage=sdk.getStorage(app);

    try{
      await sdk.enableIndexedDbPersistence(db);
    }catch(e){
      /* Puede fallar con varias pestañas o navegadores que no lo soportan. */
      console.info('Firebase offline persistence not enabled:',e?.code||e?.message||e);
    }

    sdk.onAuthStateChanged(auth,async user=>{
      currentFirebaseUser=user||null;

      if(ROLE==='panel' && user && String(user.email||'').toLowerCase()!==ADMIN_EMAIL){
        await sdk.signOut(auth);
        currentFirebaseUser=null;
        dispatchStatus('unauthorized');
        return;
      }

      if(ROLE==='store' && user){
        try{ await loadCurrentFirebaseUserIntoLocal(user); }catch(e){ console.warn(e); }
      }

      dispatchStatus(user?'authenticated':'anonymous',{uid:user?.uid||null,email:user?.email||null});
    });

    ready=true;
    startRemoteListeners();
    dispatchStatus('ready',{projectId:CONFIG.projectId});
    return api;
  })().catch(err=>{
    starting=null;
    ready=false;
    console.error('CRULOX Firebase initialization',err);
    dispatchStatus('error',{message:err?.message||String(err)});
    throw err;
  });

  return starting;
}

async function pushLocalSnapshot(){
  if(ROLE!=='panel') throw new Error('La migración local → Firebase solo está disponible desde el Panel.');
  await initialize();
  const st=runtime()?.getState?.();
  if(!st) throw new Error('No se pudo leer el estado local.');
  await syncArrayCollection(COLLECTIONS.products,st.products||[],{allowDelete:false});
  await syncArrayCollection(COLLECTIONS.orders,st.orders||[],{allowDelete:false});
  await syncArrayCollection(COLLECTIONS.users,st.users||[],{allowDelete:false});
  await syncSettingsDoc('store',st.settings||{});
  await syncSettingsDoc('faqs',{items:st.faqs||[]});
  await syncSettingsDoc('combos',{items:st.combos||[]});
  dispatchStatus('migration-complete');
  return true;
}

async function uploadReceipt(file,orderId){
  await initialize();
  if(!file) throw new Error('Archivo requerido.');
  const id=safeId(orderId,'order');
  const objectRef=sdk.ref(storage,`receipts/${id}/${Date.now()}_${safeId(file.name||'receipt')}`);
  await sdk.uploadBytes(objectRef,file,{contentType:file.type||'application/octet-stream'});
  return sdk.getDownloadURL(objectRef);
}

async function saveProduct(product){
  if(ROLE!=='panel') throw new Error('Operación administrativa no permitida desde la tienda.');
  await initialize();
  const id=safeId(product?.id||crypto.randomUUID(),'product');
  const payload=await cloudSafeProduct({...product,id});
  await sdk.setDoc(sdk.doc(db,COLLECTIONS.products,id),{...payload,updatedAtFirebase:sdk.serverTimestamp()},{merge:true});
  return id;
}

async function updateOrder(orderId,patch){
  if(ROLE!=='panel') throw new Error('Operación administrativa no permitida desde la tienda.');
  await initialize();
  await sdk.setDoc(sdk.doc(db,COLLECTIONS.orders,safeId(orderId,'order')),{...clean(clone(patch)),updatedAtFirebase:sdk.serverTimestamp()},{merge:true});
  return true;
}

async function signOutFirebase(){
  await initialize();
  return sdk.signOut(auth);
}

function readiness(){
  return {
    role:ROLE,
    configured:configured(),
    ready,
    projectId:CONFIG.projectId||'',
    sdkVersion:SDK_VERSION,
    services:['Authentication','Cloud Firestore','Cloud Storage'],
    collections:clone(COLLECTIONS)
  };
}

const api={
  version:'4.2.0',
  role:ROLE,
  configured,
  initialize,
  readiness,
  queueLocalWrite,
  pushLocalSnapshot,
  uploadReceipt,
  saveProduct,
  updateOrder,
  signOut:signOutFirebase,
  get auth(){return auth},
  get db(){return db},
  get storage(){return storage},
  get currentUser(){return currentFirebaseUser},
  get ready(){return ready}
};

window.CruzClickFirebase=api;

installStoreAuthBridge();
installPanelAuthBridge();

if(configured()){
  initialize().catch(()=>{});
}else{
  dispatchStatus('not-configured',{message:'Firebase listo para configurar. Completa CRUZCLICK_FIREBASE_CONFIG.'});
}
</script>


<script id="crulox-store-interaction-stability-v421">
(()=>{
'use strict';
const D=document;
const byId=id=>D.getElementById(id);
const safe=fn=>{try{return fn?.()}catch(error){console.error('CRULOX interaction',error);try{typeof toast==='function'&&toast('No fue posible completar esta acción. Intenta nuevamente.','error')}catch(_){ }return false}};
function closeBasePanels(){safe(()=>{if(typeof closeAllPanels==='function')closeAllPanels();});}
function openMenu(){return safe(()=>{closeBasePanels();if(typeof openPanel==='function')openPanel('drawer','drawerOverlay');else{byId('drawerOverlay')?.classList.add('open');byId('drawer')?.classList.add('open');D.body.classList.add('lock')}})}
function openNotificationsStable(){return safe(()=>{closeBasePanels();const api=window.JM_DIGITAL_STORE_V34||window.JM_DIGITAL_STORE_V23;if(typeof api?.openNotifications==='function')return api.openNotifications();byId('notificationOverlay')?.classList.add('open');byId('notificationPanel')?.classList.add('open');D.body.classList.add('lock')})}
function openProfileStable(){return safe(()=>{closeBasePanels();if(typeof renderAccount==='function')renderAccount();if(typeof openModal==='function')openModal('accountModal');else{byId('accountModal')?.classList.add('open');D.body.classList.add('lock')}})}
function openCartStable(){return safe(()=>{closeBasePanels();if(typeof renderCart==='function')renderCart();if(typeof openPanel==='function')openPanel('cartPanel','cartOverlay');else{byId('cartOverlay')?.classList.add('open');byId('cartPanel')?.classList.add('open');D.body.classList.add('lock')}})}
function openFavoritesStable(){return safe(()=>{closeBasePanels();if(typeof renderFavorites==='function')renderFavorites();if(typeof openPanel==='function')openPanel('favPanel','favOverlay');else{byId('favOverlay')?.classList.add('open');byId('favPanel')?.classList.add('open');D.body.classList.add('lock')}})}
function openSupportStable(message='Hola. Necesito ayuda con CRULOX.',extra={Tipo:'Consulta general'}){return safe(()=>{closeBasePanels();if(typeof window.NP_V117_SUPPORT?.open==='function')return window.NP_V117_SUPPORT.open(message,extra);if(typeof openBot==='function')return openBot('support',message,extra);return false})}
function openPurchasesStable(){return safe(()=>{closeBasePanels();const api=window.JM_DIGITAL_STORE_V356;if(typeof api?.openMyPurchases==='function')return api.openMyPurchases();return openProfileStable()})}
function bind(){
 const menu=byId('menuBtn');if(menu)menu.onclick=openMenu;
 const notif=byId('notificationBtn');if(notif)notif.onclick=openNotificationsStable;
 const profile=byId('profileBtn');if(profile)profile.onclick=openProfileStable;
 const cart=byId('cartBtn');if(cart)cart.onclick=openCartStable;
 const fav=byId('favBtn');if(fav)fav.onclick=openFavoritesStable;
 const purchases=byId('jmMyPurchasesBtn');if(purchases)purchases.onclick=openPurchasesStable;
 const support=byId('heroSupport');if(support)support.onclick=()=>openSupportStable();
 const footerSupport=byId('footerSupport');if(footerSupport)footerSupport.onclick=()=>openSupportStable();
 const floatSupport=byId('floatSupport');if(floatSupport)floatSupport.onclick=()=>openSupportStable();
 const drawerProfile=byId('drawerProfile');if(drawerProfile)drawerProfile.onclick=openProfileStable;
 const drawerCart=byId('drawerCart');if(drawerCart)drawerCart.onclick=openCartStable;
 const drawerFavorites=byId('drawerFavorites');if(drawerFavorites)drawerFavorites.onclick=openFavoritesStable;
 D.querySelectorAll('[data-social-support]').forEach(btn=>btn.onclick=()=>openSupportStable());
}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
requestAnimationFrame(bind);
setTimeout(bind,250);
const observer=new MutationObserver(mutations=>{if(mutations.some(m=>m.addedNodes?.length))bind()});
observer.observe(D.documentElement,{childList:true,subtree:true});
D.addEventListener('keydown',event=>{if(event.key==='Escape'&&byId('npV117Support')?.classList.contains('open'))byId('npV117SupportClose')?.click()},{capture:true});
window.CRULOX_STORE_INTERACTIONS={version:'4.2.1',bind,openMenu,openNotifications:openNotificationsStable,openProfile:openProfileStable,openCart:openCartStable,openFavorites:openFavoritesStable,openSupport:openSupportStable,openPurchases:openPurchasesStable};
})();
</script>


<script id="crulox-public-function-router-v430">
(()=>{
'use strict';
const D=document;
const byId=id=>D.getElementById(id);
const safe=(fn,fallback=false)=>{if(typeof fn!=='function')return fallback;try{return fn()}catch(error){console.error('CRULOX V4.3.0',error);try{typeof toast==='function'&&toast('No fue posible completar esta acción. Intenta nuevamente.','error')}catch(_){}return fallback}};
const stop=event=>{event.preventDefault();event.stopPropagation();event.stopImmediatePropagation()};
const addOpen=id=>byId(id)?.classList.add('open');
const removeOpen=id=>byId(id)?.classList.remove('open');
function unlockIfNothingOpen(){
  const any=D.querySelector('.drawer.open,.side-panel.open,.modal-overlay.open,#npV117Support.open,#jmMyPurchasesOverlay.open');
  D.body.classList.toggle('lock',!!any);
}
function settleLock(){
  const sync=()=>unlockIfNothingOpen();
  queueMicrotask(sync);setTimeout(sync,0);setTimeout(sync,80);
}
function closePublicLayers(){
  ['drawer','cartPanel','favPanel','notificationPanel'].forEach(removeOpen);
  ['drawerOverlay','cartOverlay','favOverlay','notificationOverlay'].forEach(removeOpen);
  D.body.classList.remove('lock');
}
function openSide(panelId,overlayId,renderer){
  closePublicLayers();
  safe(renderer);
  addOpen(overlayId);addOpen(panelId);D.body.classList.add('lock');settleLock();
  return !!byId(panelId)?.classList.contains('open');
}
function openModalStable(modalId,renderer){
  closePublicLayers();
  safe(renderer);
  addOpen(modalId);D.body.classList.add('lock');settleLock();
  return !!byId(modalId)?.classList.contains('open');
}
function openMenu(){return openSide('drawer','drawerOverlay')}
function openNotifications(){
  closePublicLayers();
  let used=false;
  safe(()=>{
    const api=window.JM_DIGITAL_STORE_V34||window.JM_DIGITAL_STORE_V353||window.JM_DIGITAL_STORE_V23;
    if(typeof api?.openNotifications==='function'){api.openNotifications();used=true;return}
    if(typeof window.openNotifications353==='function'){window.openNotifications353();used=true;return}
    if(typeof window.openNotifications23==='function'){window.openNotifications23();used=true;return}
  });
  if(!used){addOpen('notificationOverlay');addOpen('notificationPanel');D.body.classList.add('lock')}
  if(byId('notificationPanel')?.classList.contains('open')){D.body.classList.add('lock');settleLock();}
  return !!byId('notificationPanel')?.classList.contains('open');
}
function openProfile(){
  let owner=false;
  safe(()=>{owner=typeof window.CRUZCLICK_V3718?.ownerSession==='function'&&window.CRUZCLICK_V3718.ownerSession()});
  if(owner&&typeof window.CRUZCLICK_V3718?.openAdmin==='function')return safe(()=>window.CRUZCLICK_V3718.openAdmin('home'));
  return openModalStable('accountModal',()=>{if(typeof renderAccount==='function')renderAccount()});
}
function openCart(){return openSide('cartPanel','cartOverlay',()=>{if(typeof renderCart==='function')renderCart()})}
function openFavorites(){return openSide('favPanel','favOverlay',()=>{if(typeof renderFavorites==='function')renderFavorites()})}
function openSupport(message='Hola. Necesito ayuda con CRULOX.',extra={Tipo:'Consulta general'}){
  closePublicLayers();
  let opened=false;
  safe(()=>{
    if(typeof window.NP_V117_SUPPORT?.open==='function'){window.NP_V117_SUPPORT.open(message,extra);opened=true;return}
    if(typeof window.NP_V119_SUPPORT?.open==='function'){window.NP_V119_SUPPORT.open(message,extra);opened=true;return}
    if(typeof openBot==='function'){opened=openBot('support',message,extra)!==false}
  });
  if(opened&&byId('npV117Support')?.classList.contains('open')){D.body.classList.add('lock');settleLock();}
  return opened;
}
function openPurchases(){
  closePublicLayers();
  let user=null;safe(()=>{if(typeof currentUser==='function')user=currentUser()});
  if(!user){
    openProfile();
    safe(()=>typeof toast==='function'&&toast('Inicia sesión para ver tus compras.','warn'));
    return true;
  }
  let opened=false;
  safe(()=>{
    const api=window.JM_DIGITAL_STORE_V356;
    if(typeof api?.openMyPurchases==='function'){api.openMyPurchases();opened=true;return}
    if(typeof window.openMyPurchases356==='function'){window.openMyPurchases356();opened=true;return}
    if(typeof window.ensurePublicPurchasesUi356==='function')window.ensurePublicPurchasesUi356();
    if(typeof window.renderMyPurchases356==='function')window.renderMyPurchases356();
    const overlay=byId('jmMyPurchasesOverlay');if(overlay){overlay.classList.add('open');D.body.classList.add('lock');settleLock();opened=true}
  });
  return opened||openProfile();
}
function closeModalStable(id){removeOpen(id);unlockIfNothingOpen()}
function productById(id){try{return Array.isArray(state?.products)?state.products.find(p=>String(p.id)===String(id))||null:null}catch(_){return null}}
function openProductSupport(id){const p=productById(id);return openSupport(`Hola. Necesito información sobre ${p?.name||'este servicio'} en CRULOX.`,{Tipo:'Consulta de producto',Producto:p?.name||id||''})}
function addProduct(id){
  return safe(()=>{
    if(typeof addToCart==='function'){addToCart(id);return true}
    if(typeof window.JM_DIGITAL_STORE_V21?.addToCart==='function'){window.JM_DIGITAL_STORE_V21.addToCart(id);return true}
    return false;
  });
}
function openVariant(group){
  return safe(()=>{
    const api=window.JM_DIGITAL_STORE_V22||window.JM_DIGITAL_STORE_V21;
    if(typeof api?.openVariantChooser==='function'){api.openVariantChooser(group);return true}
    if(typeof window.openVariantChooser21==='function'){window.openVariantChooser21(group);return true}
    return false;
  });
}
function openDetailStable(id){return safe(()=>{if(typeof openDetail==='function'){openDetail(id);return true}return false})}
function toggleFavoriteStable(id){return safe(()=>{if(typeof toggleFavorite==='function'){toggleFavorite(id);return true}return false})}
function setCategory(value){
  return safe(()=>{
    if(typeof state!=='undefined')state.category=value||'all';
    if(typeof renderCategories==='function')renderCategories();
    if(typeof renderProducts==='function')renderProducts();
    return true;
  });
}
function toggleFaq(button){
  const item=button.closest('.faq');if(!item)return false;
  const answer=item.querySelector('.faq-a');
  const willOpen=!item.classList.contains('open');
  item.classList.toggle('open',willOpen);
  if(answer)answer.style.maxHeight=willOpen?`${answer.scrollHeight}px`:'0px';
  return true;
}
function route(event){
  const target=event.target?.closest?.('button,a[href]');if(!target)return;

  if(target.id==='menuBtn'){stop(event);openMenu();return}
  if(target.id==='notificationBtn'){stop(event);openNotifications();return}
  if(target.id==='profileBtn'||target.id==='drawerProfile'||target.id==='footerProfile'){stop(event);openProfile();return}
  if(target.id==='cartBtn'||target.id==='drawerCart'){stop(event);openCart();return}
  if(target.id==='favBtn'||target.id==='drawerFavorites'){stop(event);openFavorites();return}
  if(target.id==='heroSupport'||target.id==='footerSupport'||target.id==='floatSupport'||target.hasAttribute('data-social-support')){stop(event);openSupport();return}
  if(target.id==='jmMyPurchasesBtn'){stop(event);openPurchases();return}

  if(target.id==='drawerClose'){stop(event);closePublicLayers();return}
  if(target.id==='cartClose'){stop(event);removeOpen('cartPanel');removeOpen('cartOverlay');unlockIfNothingOpen();return}
  if(target.id==='favClose'){stop(event);removeOpen('favPanel');removeOpen('favOverlay');unlockIfNothingOpen();return}
  if(target.id==='notificationClose'){stop(event);removeOpen('notificationPanel');removeOpen('notificationOverlay');unlockIfNothingOpen();return}
  if(target.hasAttribute('data-close')){stop(event);closeModalStable(target.getAttribute('data-close'));return}

  if(target.matches('#drawer a[href^="#"]')){closePublicLayers();return}
  if(target.hasAttribute('data-cat')){stop(event);setCategory(target.getAttribute('data-cat'));return}
  if(target.classList.contains('faq-q')){stop(event);toggleFaq(target);return}
  if(target.hasAttribute('data-variant-open')){stop(event);openVariant(target.getAttribute('data-variant-open'));return}
  if(target.hasAttribute('data-fav')){stop(event);toggleFavoriteStable(target.getAttribute('data-fav'));return}
  if(target.hasAttribute('data-detail')){stop(event);openDetailStable(target.getAttribute('data-detail'));return}
  if(target.hasAttribute('data-add')){stop(event);addProduct(target.getAttribute('data-add'));return}
  if(target.hasAttribute('data-support')){stop(event);openProductSupport(target.getAttribute('data-support'));return}
  if(target.id==='checkoutBtn'){stop(event);safe(()=>typeof openCheckout==='function'&&openCheckout());return}
  if(target.id==='floatTop'){stop(event);safe(()=>window.scrollTo({top:0,behavior:'smooth'}));return}
}
window.addEventListener('click',route,true);

/* Los overlays cierran al tocar fuera de su panel. */
D.addEventListener('click',event=>{
  const t=event.target;
  if(t===byId('drawerOverlay')){event.preventDefault();closePublicLayers()}
  else if(t===byId('cartOverlay')){event.preventDefault();removeOpen('cartPanel');removeOpen('cartOverlay');unlockIfNothingOpen()}
  else if(t===byId('favOverlay')){event.preventDefault();removeOpen('favPanel');removeOpen('favOverlay');unlockIfNothingOpen()}
  else if(t===byId('notificationOverlay')){event.preventDefault();removeOpen('notificationPanel');removeOpen('notificationOverlay');unlockIfNothingOpen()}
  else if(t?.classList?.contains('modal-overlay')&&t.classList.contains('open')){event.preventDefault();closeModalStable(t.id)}
},true);

D.addEventListener('keydown',event=>{
  if(event.key!=='Escape')return;
  closePublicLayers();
  D.querySelectorAll('.modal-overlay.open').forEach(el=>el.classList.remove('open'));
  byId('npV117Support')?.classList.remove('open');
  byId('jmMyPurchasesOverlay')?.classList.remove('open');
  unlockIfNothingOpen();
},true);

function selfTest(){
  const required=['menuBtn','notificationBtn','profileBtn','cartBtn','favBtn','heroSupport','jmMyPurchasesBtn','drawer','cartPanel','favPanel','accountModal'];
  const result={version:'4.3.0',elements:Object.fromEntries(required.map(id=>[id,!!byId(id)])),functions:{renderCart:typeof renderCart==='function',renderFavorites:typeof renderFavorites==='function',renderAccount:typeof renderAccount==='function',openDetail:typeof openDetail==='function',toggleFavorite:typeof toggleFavorite==='function',addToCart:typeof addToCart==='function'},storage:window.CRULOX_STORAGE_COMPAT||null};
  result.ok=Object.values(result.elements).every(Boolean)&&Object.values(result.functions).every(Boolean);
  window.CRULOX_PUBLIC_FUNCTIONS_TEST=result;
  return result;
}
window.CRULOX_PUBLIC_FUNCTIONS=Object.freeze({version:'4.3.0',openMenu,openNotifications,openProfile,openCart,openFavorites,openSupport,openPurchases,selfTest});
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(selfTest,0),{once:true});else setTimeout(selfTest,0);
})();
</script>

<script id="crulox-orbit-v431">
(()=>{
 'use strict';
 const V='4.3.1';
 const doc=document;
 const root=doc.querySelector('.hero-box');
 const copy=root?.querySelector('.hero-copy');
 const brand=copy?.querySelector('.hero-brand-top');
 if(!root||!copy||!brand)return;
 let stage=brand.closest('.crulox-orbit-stage');
 if(!stage){
   stage=doc.createElement('div');stage.className='crulox-orbit-stage';stage.id='cruloxOrbitHero';
   stage.setAttribute('aria-label','Productos CruLox en órbita alrededor del logotipo');
   brand.before(stage);stage.append(brand);
 }
 let track=stage.querySelector('.crulox-orbit-track');
 if(!track){track=doc.createElement('div');track.className='crulox-orbit-track';track.setAttribute('aria-hidden','true');stage.prepend(track)}
 root.classList.add('crulox-orbit-enabled');
 const motionQuery=window.matchMedia?.('(prefers-reduced-motion: reduce)');
 const st={items:[],products:[],signature:'',phase:0,velocity:1,glide:0,drag:null,last:0,raf:0,
   visible:typeof IntersectionObserver==='undefined',hovered:false,reduced:!!motionQuery?.matches,
   introAt:0,paused:doc.hidden,suppressClickUntil:0,w:0,h:0,rx:0,ry:0,size:0,cx:0,cy:0};
 const angle=-8*Math.PI/180;
 const blockedByOverlay=()=>!!doc.querySelector('#cru435Welcome.cru435-open,#cru443Search.cru443-open');
 const clamp=(v,lo,hi)=>Math.min(hi,Math.max(lo,v));
 const wrap=v=>v-Math.round(v);
 function allProducts(){
   const s=window.CruzClickRuntime?.getState?.() || (typeof state==='object'?state:null);
   return Array.isArray(s?.products)?s.products:[];
 }
 function validImage(url){
   if(typeof url!=='string')return false;
   return /^(?:data:image\/(?:png|jpe?g|webp|gif);base64,|https?:\/\/|\.\/|\.\.\/|\/)/i.test(url.trim());
 }
 function pickProducts(){
   const found=[],images=new Set();
   for(const p of allProducts()){
     if(!p||typeof p!=='object'||!p.id||!validImage(p.image))continue;
     const src=p.image.trim();
     if(images.has(src))continue;
     images.add(src);found.push({id:String(p.id),name:String(p.name||p.platform||'Producto CruLox'),src});
     if(found.length===8)break;
   }
   return found;
 }
 function createItem(product){
   const btn=doc.createElement('button');btn.type='button';btn.className='crulox-orbit-item';
   btn.dataset.orbitProduct=product.id;btn.title=product.name;btn.setAttribute('aria-label','Ver '+product.name);
   const inner=doc.createElement('span');inner.className='crulox-orbit-item-inner';
   const img=doc.createElement('img');img.src=product.src;img.alt=product.name;img.draggable=false;img.decoding='async';
   inner.append(img);
   const caption=doc.createElement('span');caption.className='crulox-orbit-item-name';caption.textContent=product.name;
   btn.append(inner,caption);
   return btn;
 }
 function updateItems(){
   const items=pickProducts();
   const signature=items.map(p=>p.id+'|'+p.src.length+'|'+p.src.slice(0,75)+'|'+p.src.slice(-75)).join('\n');
   if(signature===st.signature)return;
   st.signature=signature;st.products=items;
   for(const item of st.items)item.remove();
   st.items=items.map(p=>createItem(p));
   stage.append(...st.items);
   track.style.display=items.length?'':'none';
   layout();wake();
 }
 function layout(){
   const w=stage.clientWidth,h=stage.clientHeight;
   if(!w||!h)return;
   st.w=w;st.h=h;st.cx=w/2;st.cy=h/2;
   st.size=clamp(w*.087,54,94);
   st.rx=Math.max(0,w/2-st.size*.86-14);
   st.ry=Math.max(0,h*.325-st.size*.10);
   stage.style.setProperty('--cru-orbit-w',`${st.rx*2}px`);
   stage.style.setProperty('--cru-orbit-h',`${st.ry*2}px`);
   for(const item of st.items){item.style.width=st.size+'px';item.style.height=st.size+'px'}
   paint(performance.now());
 }
 function coords(u){
   const t=u*2*Math.PI;
   const x=st.rx*Math.cos(t),y=st.ry*Math.sin(t);
   return [st.cx+x*Math.cos(angle)-y*Math.sin(angle),st.cy+x*Math.sin(angle)+y*Math.cos(angle)];
 }
 function paint(now){
   const n=st.items.length;if(!n||!st.w)return;
   const t=st.introAt?clamp((now-st.introAt)/1300,0,1):1;
   const spread=1-Math.pow(1-t,5);
   const appearance=clamp((now-st.introAt)/450,0,1);
   const depth=0.72;
   for(let i=0;i<n;i++){
     const it=st.items[i];
     let u=st.phase+i/n;
     if(t<1)u=.25+wrap(u-.25)*spread;
     const [x,y]=coords(u);
     const d=clamp((y-st.cy)/(st.ry+15),-1,1),front=(d+1)/2;
     const scale=(1+depth*(.3*front-.45*(1-front)))*(t<1?.7+.3*appearance:1);
     const opacity=(1-depth*.55*(1-front))*(t<1?appearance*appearance*(3-2*appearance):1);
     it.style.transform=`translate3d(${(x-st.size/2).toFixed(2)}px,${(y-st.size/2).toFixed(2)}px,0) scale(${scale.toFixed(4)})`;
     it.style.opacity=String(clamp(opacity,0,1));
     it.style.zIndex=String(it.matches(':hover,:focus-visible')?240:(d>0?110+Math.round(d*80):30+Math.round((d+1)*60)));
   }
 }
 function frame(now){
   st.raf=0;
   if(!st.visible||st.paused||blockedByOverlay())return;
   const dt=st.last?clamp((now-st.last)/1000,0,.08):0;
   st.last=now;
   const target=(st.reduced||st.drag?.active)?0:(st.hovered?.3:1);
   st.velocity+=(target-st.velocity)*(1-Math.exp(-dt/.35));
   if(!st.reduced&&!st.drag?.active)st.phase+=(dt*st.velocity)/40;
   if(!st.drag?.active&&Math.abs(st.glide)>.0003){st.phase+=st.glide*dt;st.glide*=Math.exp(-dt/.7)}
   if(Math.abs(st.phase)>200)st.phase-=Math.trunc(st.phase);
   paint(now);
   const intro=!!st.introAt&&now-st.introAt<1300;
   if((intro||(!st.reduced&&!st.drag?.active)||Math.abs(st.glide)>.0003)&&st.items.length)wake();
 }
 function wake(){if(!st.raf&&st.visible&&!st.paused&&!blockedByOverlay())st.raf=requestAnimationFrame(frame)}
 function pointerPoint(e){const r=stage.getBoundingClientRect();return {x:e.clientX-r.left,y:e.clientY-r.top}}
 function down(e){
   if(e.pointerType==='mouse'&&e.button!==0)return;
   if(e.target.closest('.hero-brand-top'))return;
   const p=pointerPoint(e);st.drag={id:e.pointerId,...p,active:false,lastX:p.x,lastTime:performance.now()};st.glide=0;
 }
 function move(e){
   const d=st.drag;if(!d||e.pointerId!==d.id)return;
   const p=pointerPoint(e),dx=p.x-d.x,dy=p.y-d.y;
   if(!d.active){
     if(Math.abs(dx)<5)return;
     if(Math.abs(dy)>Math.abs(dx)){st.drag=null;return}
     d.active=true;stage.dataset.dragging='';
     try{stage.setPointerCapture(e.pointerId)}catch(_){}
   }
   const diff=p.x-d.lastX;
   st.phase+=diff/Math.max(130,st.rx*5.5);
   const now=performance.now();d.glide=clamp((diff/Math.max(1,now-d.lastTime))*1000/Math.max(130,st.rx*5.5),-2,2);
   d.lastX=p.x;d.lastTime=now;paint(now);wake();
 }
 function up(e){
   const d=st.drag;if(!d||e.pointerId!==d.id)return;
   if(d.active){st.glide=d.glide||0;st.suppressClickUntil=performance.now()+400;delete stage.dataset.dragging;
     try{stage.releasePointerCapture(e.pointerId)}catch(_){}
   }
   st.drag=null;wake();
 }
 function select(e){
   const btn=e.target.closest('.crulox-orbit-item');if(!btn)return;
   if(performance.now()<st.suppressClickUntil){e.preventDefault();e.stopPropagation();return}
   const idx=st.items.indexOf(btn);if(idx<0)return;
   st.phase+=wrap(.25-(st.phase+idx/st.items.length));paint(performance.now());
   try{if(typeof openDetail==='function')openDetail(btn.dataset.orbitProduct);
     else{const card=doc.querySelector('[data-product]');doc.querySelector('#catalog')?.scrollIntoView({behavior:'smooth'});}
   }catch(err){console.warn('CruLox orbit product detail',err)}
 }
 stage.addEventListener('pointerenter',()=>{st.hovered=true;wake()});
 stage.addEventListener('pointerleave',()=>{st.hovered=false;wake()});
 stage.addEventListener('pointerdown',down);
 stage.addEventListener('pointermove',move);
 stage.addEventListener('pointerup',up);
 stage.addEventListener('pointercancel',up);
 stage.addEventListener('lostpointercapture',up);
 stage.addEventListener('click',select);
 stage.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('.crulox-orbit-item')){e.preventDefault();select({target:e.target,preventDefault(){},stopPropagation(){}})}});
 const resize=typeof ResizeObserver==='function'?new ResizeObserver(layout):null;
 resize?.observe(stage);
 if(!resize)window.addEventListener('resize',layout,{passive:true});
 const observer=typeof IntersectionObserver==='function'?new IntersectionObserver(entries=>{st.visible=entries[0]?.isIntersecting??false;if(st.visible){st.last=0;wake()}},{threshold:.03}):null;
 observer?.observe(stage);
 const overlayWatch=typeof MutationObserver==='function'?new MutationObserver(()=>{if(!blockedByOverlay()){st.last=0;wake()}}):null;
 function observeOverlayChanges(){['cru435Welcome','cru443Search'].forEach(id=>{const node=doc.getElementById(id);if(node)overlayWatch?.observe(node,{attributes:true,attributeFilter:['class']})});if(!blockedByOverlay()){st.last=0;wake()}}
 if(doc.readyState==='loading')doc.addEventListener('DOMContentLoaded',observeOverlayChanges,{once:true});else observeOverlayChanges();
 const grid=doc.getElementById('productsGrid');
 if(grid&&typeof MutationObserver==='function')new MutationObserver(()=>updateItems()).observe(grid,{childList:true});
 window.addEventListener('storage',e=>{if(e.key==='jm_digital_v1_products')updateItems()});
 doc.addEventListener('visibilitychange',()=>{st.paused=doc.hidden;if(!st.paused){updateItems();st.last=0;wake()}});
 motionQuery?.addEventListener?.('change',()=>{st.reduced=!!motionQuery.matches;st.last=0;wake()});
 st.introAt=0; // sin arranque agrupado: las imágenes empiezan en su posición definitiva
 updateItems();layout();wake();
 window.CRULOX_ORBIT_V431=Object.freeze({version:V,refresh:updateItems,getVisibleProducts:()=>st.products.map(p=>({id:p.id,name:p.name})),getStatus:()=>({count:st.items.length,visible:st.visible,reducedMotion:st.reduced})});
})();
</script>
<style id="crulox-v432-visual">
/* CruLox V4.3.2 | Ajustes exclusivamente visuales de tienda y botones del hero */
.hero-box.crulox-orbit-enabled{
  border-color:rgba(49,207,245,.23)!important;
  box-shadow:0 25px 76px rgba(0,0,0,.42),inset 0 1px 0 rgba(188,244,255,.06),0 0 42px rgba(0,181,250,.035)!important;
}
.hero-box.crulox-orbit-enabled::before{
  animation:cru432-ambient 13s ease-in-out infinite alternate;
  pointer-events:none;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{
  animation:cru432-logo-halo 6s ease-in-out infinite alternate;
}
/* A los dos controles del hero se les asigna una fila coherente; ninguna acción cambia. */
.hero-box.crulox-orbit-enabled .hero-actions,
.hero-box.crulox-orbit-enabled .hero-actions.jmv356-hero-actions{
  position:relative!important;
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:12px!important;
  align-items:stretch!important;
  justify-content:center!important;
  width:min(100%,610px)!important;
  max-width:610px!important;
  margin:24px auto 0!important;
  padding:2px!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{
  box-sizing:border-box!important;
  position:relative!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  flex:1 1 auto!important;
  gap:10px!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  min-height:61px!important;
  padding:15px 16px!important;
  border-radius:18px!important;
  font-family:inherit!important;
  font-weight:850!important;
  font-size:clamp(.78rem,1.45vw,.94rem)!important;
  line-height:1.2!important;
  letter-spacing:-.01em!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:clip!important;
  cursor:pointer!important;
  -webkit-tap-highlight-color:transparent!important;
  transition:transform .25s cubic-bezier(.2,.75,.26,1),box-shadow .28s ease,border-color .28s ease,filter .28s ease!important;
  animation:cru432-button-intro .68s cubic-bezier(.2,.85,.22,1) backwards;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport{
  color:#e9f9ff!important;
  border:1px solid rgba(117,217,251,.25)!important;
  background:linear-gradient(125deg,rgba(24,54,77,.96),rgba(11,31,49,.96))!important;
  box-shadow:inset 0 1px 0 rgba(208,244,255,.065),0 11px 26px rgba(0,0,0,.18)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{
  color:#03202c!important;
  border:1px solid rgba(94,246,255,.88)!important;
  background:linear-gradient(120deg,#78f3ff 0%,#21dbf3 52%,#15aaf3 100%)!important;
  box-shadow:0 11px 31px rgba(0,198,244,.23),inset 0 1px rgba(255,255,255,.50),inset 0 -2px rgba(4,75,116,.12)!important;
  text-shadow:none!important;
  animation-delay:.11s;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::before,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::before{
  content:""!important;
  display:inline-block!important;
  flex:0 0 23px!important;
  width:23px!important;
  height:23px!important;
  background-size:contain!important;
  background-repeat:no-repeat!important;
  background-position:center!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::before{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2377edff%22%20stroke-width%3D%221.9%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M20%2011.5a8.1%208.1%200%200%201-8.1%208.1%208.3%208.3%200%200%201-3.5-.8L4%2020l1.2-4.2a8.1%208.1%200%201%201%2014.8-4.3Z%22%2F%3E%3Cpath%20d%3D%22M8.5%2011.5h7%22%2F%3E%3C%2Fsvg%3E")!important}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::before{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23032435%22%20stroke-width%3D%221.9%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%203.5h16V21l-3.4-2-3.1%202-3.1-2L7%2021l-3-2V3.5Z%22%2F%3E%3Cpath%20d%3D%22M8%208h8M8%2012h5%22%2F%3E%3Cpath%20d%3D%22m14.5%2015.5%201.4%201.4%202.4-2.5%22%2F%3E%3C%2Fsvg%3E")!important}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::after,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::after{content:none!important;display:none!important;margin-left:0!important;opacity:0!important;transition:none!important;}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover{
  transform:translate3d(0,-3px,0)!important;
  filter:brightness(1.07)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover{
  border-color:rgba(105,235,255,.54)!important;
  box-shadow:inset 0 1px rgba(225,255,255,.1),0 15px 34px rgba(0,0,0,.28),0 0 24px rgba(1,219,255,.08)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover{
  box-shadow:0 16px 39px rgba(0,202,251,.34),inset 0 1px rgba(255,255,255,.6)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover::after,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover::after{
  transform:translate(2px,-2px)!important;opacity:1!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:active,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:active{
  transform:translateY(1px) scale(.985)!important;
  filter:brightness(.98)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:focus-visible,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:focus-visible{
  outline:3px solid #f6fcff!important;outline-offset:4px!important;
}
/* Mejoras visuales de la tienda pública; no afectan panel ni funcionalidad. */
body:not(:has(#adminOverlay.open)) .search-wrap .search:focus-visible{
  border-color:rgba(55,228,254,.7)!important;
  box-shadow:0 0 0 4px rgba(0,216,255,.085),0 12px 36px rgba(0,0,0,.14)!important;
  transition:box-shadow .25s ease,border-color .25s ease!important;
}
.benefits .benefit{
  position:relative;
  overflow:hidden;
  border-color:rgba(101,200,243,.12)!important;
  background:radial-gradient(circle at 4% 5%,rgba(17,211,249,.075),transparent 70%),linear-gradient(145deg,rgba(9,33,48,.95),rgba(5,20,33,.98))!important;
  box-shadow:inset 0 1px rgba(211,255,255,.04),0 13px 29px rgba(0,0,0,.17)!important;
  transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease!important;
}
.benefits .benefit:hover{
  transform:translateY(-3px)!important;
  border-color:rgba(55,215,255,.34)!important;
  box-shadow:0 17px 34px rgba(0,0,0,.26),0 0 20px rgba(0,191,250,.06)!important;
}
.benefits .benefit i{transition:transform .3s cubic-bezier(.2,.75,.3,1),background .3s ease!important}
.benefits .benefit:hover i{transform:translateY(-2px) scale(1.065)!important;background:rgba(0,203,255,.14)!important}
#catalog .product,#combos .combo,#how .step,#faq .faq{
  transition:transform .33s cubic-bezier(.2,.75,.2,1),box-shadow .33s ease,border-color .33s ease!important;
}
#catalog .product:hover,#catalog .product:focus-within{
  transform:translateY(-5px)!important;
  box-shadow:0 22px 48px rgba(0,0,0,.32),0 0 22px rgba(0,210,255,.055)!important;
}
#combos .combo:hover,#how .step:hover,#faq .faq:hover{
  transform:translateY(-3px)!important;
  border-color:rgba(63,206,251,.25)!important;
  box-shadow:0 20px 42px rgba(0,0,0,.26)!important;
}
.category-scroll .cat,.product-actions button,.float-btn{
  transition:transform .25s cubic-bezier(.2,.75,.3,1),background .25s ease,box-shadow .25s ease,border-color .25s ease!important;
}
.category-scroll .cat:hover,.product-actions button:hover:not(:disabled),.float-btn:hover{transform:translateY(-2px)!important}
.category-scroll .cat:focus-visible,.product-actions button:focus-visible,.float-btn:focus-visible{outline:2px solid var(--cyan)!important;outline-offset:3px!important}
/* Apariciones progresivas livianas; solo se activan si el navegador soporta observer. */
.cru432-animate .cru432-reveal{
  opacity:0;
  transform:translate3d(0,17px,0);
  transition:opacity .68s ease,transform .68s cubic-bezier(.18,.74,.2,1)!important;
  transition-delay:var(--cru432-delay,0ms)!important;
}
.cru432-animate .cru432-reveal.cru432-visible{opacity:1;transform:translate3d(0,0,0)}
@keyframes cru432-ambient{
  0%{opacity:.6;transform:translate3d(0,0,0) scale(1)}
  100%{opacity:.95;transform:translate3d(-15px,7px,0) scale(1.08)}
}
@keyframes cru432-logo-halo{
  0%{box-shadow:0 0 0 1px rgba(60,207,251,.11),0 0 0 15px rgba(15,180,225,.025),0 20px 55px rgba(0,0,0,.33),inset 0 0 25px rgba(3,203,255,.035)}
  100%{box-shadow:0 0 0 1px rgba(60,207,251,.23),0 0 0 19px rgba(15,180,225,.05),0 20px 60px rgba(0,0,0,.38),inset 0 0 36px rgba(3,203,255,.085)}
}
@keyframes cru432-button-intro{
