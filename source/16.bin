  #adminOverlay .cc378-nav-icon{width:64px!important;height:64px!important;min-width:64px!important;min-height:64px!important;flex-basis:64px!important;border-radius:20px!important}
  #adminOverlay .cc378-nav-icon svg,#adminOverlay .cc378-nav-icon svg *{width:32px!important;height:32px!important}
  #adminOverlay .cc378-nav-label{font-size:.78rem!important}
  #adminOverlay .cc378-nav-sub{font-size:.50rem!important;line-height:1.42!important}
  #adminOverlay .cc378-nav button:nth-child(37){width:min(70%,430px)!important}
}
@media(max-width:430px){
  #adminOverlay .cc378-nav{gap:9px!important}
