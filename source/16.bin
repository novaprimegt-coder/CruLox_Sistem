  border-radius:999px !important;
}
#adminOverlay .cc405-menu::-webkit-scrollbar-thumb:hover{
  background:linear-gradient(180deg,rgba(96,238,255,.75),rgba(83,142,255,.45)) !important;
}

/* Movimiento visual limpio de las funciones */
#adminOverlay .cc405-menu button{
  flex:none !important;
  transition:
    transform .10s ease,
    border-color .10s ease,
    background .10s ease,
    box-shadow .10s ease !important;
  will-change:transform !important;
}
#adminOverlay .cc405-menu button:active{
