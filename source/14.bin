<!-- CRULOX V3.7.0 · Rebranding integral visible -->
<style id="cruzclick-v370-brand-style">
/* El nuevo recurso es cuadrado; se mantiene completo y sin recorte. */
.brand img,.loader-logo,.drawer-logo,.footer-logo,.admin-brand,
.jmv21-footer-brand img,.jmv24-drawer-logo,.jmv360-brand img,.jmv360-hero-visual img,
.hero-brand-top img{object-fit:contain!important}
</style>
<script id="cruzclick-v370-brand-script">
(()=>{
'use strict';
const D=document;
const NEW_NAME='CRULOX';
const OLD_NAME=['JM',' Cruz',' L.',' Digital'].join('');
const OLD_HANDLE=['jm','cruzl','digital'].join('');
function patchTextNode(node){
  if(node.nodeType===Node.TEXT_NODE){
    if(node.nodeValue&&node.nodeValue.includes(OLD_NAME))node.nodeValue=node.nodeValue.split(OLD_NAME).join(NEW_NAME);
    if(node.nodeValue&&node.nodeValue.includes(OLD_HANDLE))node.nodeValue=node.nodeValue.split(OLD_HANDLE).join('cruzclick');
    return;
  }
  if(node.nodeType!==Node.ELEMENT_NODE)return;
  if(['SCRIPT','STYLE'].includes(node.tagName))return;
  if(node.hasAttribute('alt'))node.setAttribute('alt',String(node.getAttribute('alt')||'').split(OLD_NAME).join(NEW_NAME));
  if(node.hasAttribute('title'))node.setAttribute('title',String(node.getAttribute('title')||'').split(OLD_NAME).join(NEW_NAME));
  [...node.childNodes].forEach(patchTextNode);
}
function patchBrandImage3710(img){
  if(!img||img.nodeType!==1)return;
  const alt=img.getAttribute('alt')||'';
  if(/CRULOX/i.test(alt)||img.classList.contains('loader-logo')||img.classList.contains('drawer-logo')||img.classList.contains('footer-logo')||img.classList.contains('admin-brand')||img.closest('.jmv360-brand,.jmv360-hero-visual,.hero-brand-top,.jmv21-footer-brand,.jmv24-drawer-brand')){
    if(img.getAttribute('src')!==BRAND_LOGO_FULL)img.src=BRAND_LOGO_FULL;
    img.alt=NEW_NAME;
  }
}
function patchBrandRoot3710(root){
  if(!root)return;
  patchTextNode(root);
  if(root.nodeType===1){
    if(root.matches?.('img'))patchBrandImage3710(root);
    root.querySelectorAll?.('img').forEach(patchBrandImage3710);
  }
}
function applyCruzClickBrand(){
  try{
    D.title='CRULOX · Servicios digitales';
    const meta=D.querySelector('meta[name="description"]');
    if(meta)meta.content='CRULOX: perfiles, suscripciones, diamantes, cursos y servicios 100% digitales.';
    const fav=D.querySelector('link[rel="icon"]');if(fav&&fav.getAttribute('href')!==BRAND_LOGO)fav.href=BRAND_LOGO;
    patchBrandRoot3710(D.body);
  }catch(e){console.warn('CRULOX visible brand patch',e)}
}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',applyCruzClickBrand,{once:true});else applyCruzClickBrand();
let brandPatchPending3710=false;
const brandQueue3710=new Set();
const obs=new MutationObserver(records=>{
  for(const record of records){
    for(const node of record.addedNodes||[]){
      if(node.nodeType===1||node.nodeType===3)brandQueue3710.add(node);
    }
  }
  if(brandPatchPending3710||!brandQueue3710.size)return;
  brandPatchPending3710=true;
  requestAnimationFrame(()=>{
    brandPatchPending3710=false;
    const nodes=[...brandQueue3710];brandQueue3710.clear();
    nodes.forEach(patchBrandRoot3710);
  });
});
if(D.body)obs.observe(D.body,{childList:true,subtree:true});
window.addEventListener('pageshow',applyCruzClickBrand);
window.CRUZCLICK_STORE_V370={VERSION:'3.7.0',applyBrand:applyCruzClickBrand};
})();
</script>


<!-- CRULOX V3.7.2 · Símbolo transparente real solo en cabecera y portada -->
<style id="cruzclick-v371-symbol-style">
/* SOLO las dos ubicaciones solicitadas: cabecera pública y portada principal. */
.brand img,
.hero-brand-top img{
  object-fit:contain!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  mix-blend-mode:normal!important;
}
.brand{isolation:isolate!important}
.hero-brand-top{isolation:isolate!important}
.brand img{
  filter:drop-shadow(0 0 8px rgba(34,223,243,.22))!important;
}
.hero-brand-top img{
  filter:drop-shadow(0 10px 22px rgba(34,223,243,.16))!important;
}
</style>
<script id="cruzclick-v371-symbol-script">
(()=>{
'use strict';
const D=document;
const CRUZCLICK_SYMBOL_V371=BRAND_LOGO_FULL;
function applySymbolV371(){
  /* No se toca loader, drawer, footer, panel administrativo ni ninguna otra imagen. */
  const targets=[
    D.querySelector('.header .brand img'),
    D.querySelector('.hero-brand-top img')
  ].filter(Boolean);
  targets.forEach(img=>{
    if(img.src!==CRUZCLICK_SYMBOL_V371)img.src=CRUZCLICK_SYMBOL_V371;
    img.alt='CRULOX';
    img.style.background='transparent';
    img.style.mixBlendMode='normal';
    img.style.boxShadow='none';
  });
}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>requestAnimationFrame(applySymbolV371),{once:true});
else requestAnimationFrame(applySymbolV371);
let symbolPending371=false;
const queueSymbol371=()=>{
  if(symbolPending371)return;
  symbolPending371=true;
  requestAnimationFrame(()=>{symbolPending371=false;applySymbolV371()});
};
const obs=new MutationObserver(queueSymbol371);
[D.querySelector('.header'),D.querySelector('.hero-brand-top')].filter(Boolean).forEach(root=>{
  obs.observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['src']});
});
window.addEventListener('pageshow',applySymbolV371);
window.CRUZCLICK_STORE_V371={VERSION:'3.7.2',applySymbol:applySymbolV371};
})();
</script>


<!-- CRULOX V3.7.3 · Experiencia tipo app: sin selección, guardado directo de imágenes ni zoom -->
<style id="cruzclick-v373-native-style">
/* Mantiene desplazamiento normal, pero elimina gestos web que no aportan a la experiencia de app. */
html,body{
  width:100%;
  min-height:100%;
  overscroll-behavior:none!important;
  -webkit-text-size-adjust:100%!important;
  text-size-adjust:100%!important;
  -webkit-tap-highlight-color:transparent!important;
  touch-action:pan-x pan-y!important;
}
/* El contenido visible no se puede seleccionar ni activar con pulsación larga. */
body,body *{
  -webkit-user-select:none!important;
  user-select:none!important;
  -webkit-touch-callout:none!important;
}
/* Los campos siguen siendo editables; copiar/cortar se bloquea por JS. */
input,textarea,[contenteditable="true"]{
  -webkit-user-select:text!important;
  user-select:text!important;
}
/* Las imágenes no reciben menú contextual ni arrastre/guardado por interacción directa. */
img,picture,svg,canvas{
  -webkit-user-drag:none!important;
  user-drag:none!important;
  -webkit-touch-callout:none!important;
}
img{pointer-events:none!important}
/* Controles conservan respuesta táctil de app sin doble toque de zoom. */
button,a,input,select,textarea,[role="button"]{
  touch-action:manipulation!important;
  -webkit-tap-highlight-color:transparent!important;
}
</style>
<script id="cruzclick-v373-native-script">
(()=>{
'use strict';
const D=document;
const isEditable=(el)=>!!el&&!!el.closest?.('input,textarea,[contenteditable="true"]');
const stop=(e)=>{e.preventDefault();e.stopPropagation();};

/* Sin menú contextual/long-press web en toda la plataforma. */
D.addEventListener('contextmenu',stop,{capture:true});

/* Sin copiar ni cortar contenido de la plataforma. */
D.addEventListener('copy',stop,{capture:true});
D.addEventListener('cut',stop,{capture:true});
D.addEventListener('beforecopy',stop,{capture:true});
D.addEventListener('beforecut',stop,{capture:true});

/* Evita selección de texto fuera de campos que necesitan edición. */
D.addEventListener('selectstart',(e)=>{if(!isEditable(e.target))stop(e)},{capture:true});

/* Ninguna imagen puede arrastrarse desde la interfaz. */
D.addEventListener('dragstart',(e)=>{if(e.target?.closest?.('img,picture,svg,canvas'))stop(e)},{capture:true});
function protectMedia(root=D){
  root.querySelectorAll?.('img').forEach(img=>{
    img.draggable=false;
    img.setAttribute('draggable','false');
    img.setAttribute('oncontextmenu','return false');
  });
}
protectMedia();
let mediaProtectFrame=0;
const mediaProtectRoots=new Set();
const mediaObserver=new MutationObserver(mutations=>{
  for(const mutation of mutations){
    for(const node of mutation.addedNodes){
      if(node.nodeType===1)mediaProtectRoots.add(node);
    }
  }
  if(mediaProtectFrame||!mediaProtectRoots.size)return;
  mediaProtectFrame=requestAnimationFrame(()=>{
    mediaProtectFrame=0;
    const roots=[...mediaProtectRoots];mediaProtectRoots.clear();
    const topRoots=roots.filter((root,index)=>!roots.some((other,i)=>i!==index&&other.contains?.(root)));
    for(const root of topRoots){
      if(root.matches?.('img')){root.draggable=false;root.setAttribute('draggable','false');root.setAttribute('oncontextmenu','return false')}
      protectMedia(root);
    }
  });
});
mediaObserver.observe(D.body||D.documentElement,{childList:true,subtree:true});

/* Bloqueo de pinch zoom y gestos equivalentes. */
['gesturestart','gesturechange','gestureend'].forEach(type=>D.addEventListener(type,stop,{capture:true,passive:false}));
/* V3.8.0: eliminado listener global touchmove no-pasivo; touch-action/meta ya controlan zoom sin bloquear el scroll. */
D.addEventListener('wheel',(e)=>{if(e.ctrlKey||e.metaKey)stop(e)},{capture:true,passive:false});

/* Evita zoom por doble toque fuera de campos editables. */
/* V3.8.0: eliminado bloqueo JS de doble toque para no hacer síncrono cada touchend; touch-action cubre este caso. */

/* Atajos de navegador que contradicen el modo app. No se bloquea pegar ni escribir. */
D.addEventListener('keydown',(e)=>{
  const mod=e.ctrlKey||e.metaKey;
  if(!mod)return;
  const key=String(e.key||'').toLowerCase();
  if(['c','x','s','p','u','+','-','=','0'].includes(key))stop(e);
},{capture:true});

/* Impide enlaces de descarga directa que pudieran agregarse dinámicamente. */
D.addEventListener('click',(e)=>{
  const a=e.target?.closest?.('a[download]');
  if(a)stop(e);
},{capture:true});

window.CRUZCLICK_STORE_V373={VERSION:'3.7.3',protectMedia};
})();
</script>



