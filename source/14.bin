  #adminOverlay .jmv360-nav button i{font-size:.70rem!important}
  #adminOverlay .jmv360-page-head{padding:8px 9px!important;flex-direction:row!important;align-items:center!important}
  #adminOverlay .jmv360-page-head h1{font-size:1rem!important}#adminOverlay .jmv360-page-head p{font-size:.50rem!important}
  #adminOverlay .jmv360-date{width:auto!important;min-width:104px!important;padding:5px 6px!important}
  #adminOverlay .jmv360-date b{font-size:.48rem!important}#adminOverlay .jmv360-date span{font-size:.42rem!important}
  #adminOverlay .jmv360-hero{grid-template-columns:1fr minmax(80px,.38fr)!important;padding:9px!important}
  #adminOverlay .jmv360-hero-copy .accent{font-size:.82rem!important}#adminOverlay .jmv360-hero-copy p{font-size:.47rem!important}
  #adminOverlay .jmv360-hero-badge{position:static!important;transform:none!important;justify-self:start!important;min-width:auto!important;font-size:.42rem!important;padding:4px 6px!important;margin:0!important}
  #adminOverlay .jmv360-hero-visual{justify-items:center!important}#adminOverlay .jmv360-hero-visual img{width:58px!important}#adminOverlay .jmv360-hero-points{font-size:.36rem!important}
  #adminOverlay .jmv360-metrics{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:4px!important}
  #adminOverlay .jmv360-priorities,#adminOverlay .jmv360-access-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:4px!important}
  #adminOverlay .jmv362-follow-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:390px){
  #adminOverlay .jmv360-page-head p{display:none!important}
  #adminOverlay .jmv360-date{min-width:92px!important}
  #adminOverlay .jmv360-hero-copy p{max-width:230px!important}
}
