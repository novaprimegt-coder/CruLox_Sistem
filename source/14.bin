  #adminOverlay .jmv360-brand img{width:30px!important;height:30px!important}
  #adminOverlay .jmv360-brand b{font-size:.64rem!important}#adminOverlay .jmv360-brand span{font-size:.41rem!important}
  #adminOverlay .jmv360-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important;padding:4px!important;gap:4px!important}
