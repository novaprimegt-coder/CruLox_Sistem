#adminOverlay .jmv362-follow-list{gap:4px!important;margin-top:6px!important}
#adminOverlay .jmv362-follow-row{padding:5px 6px!important;border-radius:8px!important;gap:5px!important}
#adminOverlay .jmv362-follow-row b{font-size:.43rem!important;line-height:1.2!important}
#adminOverlay .jmv362-follow-row span{font-size:.37rem!important;line-height:1.22!important}
#adminOverlay .jmv362-wa-btn{min-height:23px!important;padding:0 7px!important;border-radius:7px!important;font-size:.39rem!important}
#adminOverlay .jmv362-empty{padding:8px!important;border-radius:8px!important;font-size:.40rem!important}

