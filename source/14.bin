turn;
  const list=confirmedPurchases356();
  if(!list.length){box.innerHTML='<div class="jmv356-purchases-empty">Todavía no tienes compras confirmadas para mostrar.</div>';return}
  box.innerHTML=list.map(o=>{
    const delivery=o.customerDelivery||{};const savedItems=Array.isArray(delivery.items)?delivery.items:[];
    const items=(o.items||[]).map((item,index)=>{const d=savedItems[index]||{};const recharge=String(item.digitalKind||'').toLowerCase()==='recharge'||/diamant|recarga|free\s*fire|fc\s*point|robux/i.test(`${item.name||''} ${item.digitalType||''}`);return `<section class="jmv356-purchase-item"><h4>${esc356(item.name||'Producto digital')} ×${Number(item.qty||1)}</h4><div class="jmv356-purchase-grid">${recharge?purchaseField356('Cantidad entregada',d.quantity||item.qty):''}${recharge?purchaseField356('ID / cuenta de destino',d.destinationId||defaultDestination356(item)):''}${!recharge?purchaseField356('Fecha de inicio',d.startDate?date356(d.startDate):''):''}${!recharge?purchaseField356('Fecha de corte',d.cutoffDate?date356(d.cutoffDate):''):''}${purchaseField356(recharge?'Detalle de entrega':'Datos de acceso / entrega',d.accessData,true)}${purchaseField356('Información adicional',d.extra,true)}</div></section>`}).join('');
    return `<article class="jmv356-purchase-card"><div class="jmv356-purchase-card-head"><div><h3>${esc356(o.id||'Compra confirmada')}</h3><time>Confirmada ${esc356(dateTime356(delivery.confirmedAt||o.updatedAt))}</time></div><span class="jmv356-confirmed-badge">Confirmada</span></div>${items}</article>`;
  }).join('');
}
function openMyPurchases356(){
  const user=currentUser356();if(!user){try{if(typeof renderAccount==='function')renderAccount();if(typeof openModal==='function')openModal('accountModal')}catch(e){}notify356('Inicia sesión para ver tus compras confirmadas.','warn');return}
  ensurePublicPurchasesUi356();renderMyPurchases356();$356('jmMyPurchasesOverlay')?.classList.add('open');D.body.classList.add('lock');
}
function closeMyPurchases356(){const o=$356('jmMyPurchasesOverlay');if(o)o.classList.remove('open');requestAnimationFrame(()=>{if(!D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#notificationPanel.open,#jmDeliveryOverlay.open'))D.body.classList.remove('lock')})}

function ensureDeliveryModal356(){
  if($356('jmDeliveryOverlay'))return;
  const overlay=D.createElement('div');overlay.id='jmDeliveryOverlay';
  overlay.innerHTML=`<section class="jmv356-delivery-modal" role="dialog" aria-modal="true"><header class="jmv356-delivery-head"><div><small>Entrega al cliente</small><h2 id="jmDeliveryTitle">Datos de compra</h2></div><button class="jmv356-purchases-close" id="jmDeliveryClose" type="button" aria-label="Cerrar">×</button></header><div class="jmv356-delivery-body" id="jmDeliveryBody"></div><div class="jmv356-delivery-actions"><button class="jmv356-delivery-save" id="jmDeliverySave" type="button">Guardar borrador</button><button class="jmv356-delivery-confirm" id="jmDeliveryConfirm" type="button">Confirmar y mostrar al cliente</button></div></section>`;
  D.body.appendChild(overlay);overlay.addEventListener('click',e=>{if(e.target===overlay)closeDeliveryModal356()});$356('jmDeliveryClose').onclick=closeDeliveryModal356;
}
let activeDeliveryOrder356=null;
function deliveryItemForm356(item,index,current={}){
  const recharge=String(item.digitalKind||'').toLowerCase()==='recharge'||/diamant|recarga|free\s*fire|fc\s*point|robux/i.test(`${item.name||''} ${item.digitalType||''}`);
  const destination=current.destinationId||defaultDestination356(item)||'';
  return `<section class="jmv356-delivery-item" data-jm-delivery-item="${index}"><h3>${esc356(item.name||'Producto digital')} ×${Number(item.qty||1)}</h3><div class="jmv356-delivery-grid">${recharge?`<div class="jmv356-delivery-field"><label>Cantidad entregada</label><input data-df="quantity" type="number" min="0" step="1" value="${esc356(current.quantity??item.qty??1)}"></div><div class="jmv356-delivery-field"><label>ID / cuenta de destino</label><input data-df="destinationId" value="${esc356(destination)}"></div>`:`<div class="jmv356-delivery-field"><label>Fecha de inicio</label><input data-df="startDate" type="date" value="${esc356(current.startDate||'')}"></div><div class="jmv356-delivery-field"><label>Fecha de corte</label><input data-df="cutoffDate" type="date" value="${esc356(current.cutoffDate||'')}"></div>`}<div class="jmv356-delivery-field full"><label>${recharge?'Detalle de entrega / referencia':'Datos de acceso / entrega'}</label><textarea data-df="accessData" placeholder="${recharge?'Ej. recarga aplicada correctamente':'Ej. usuario, acceso, enlace, instrucciones o credenciales entregadas'}">${esc356(current.accessData||'')}</textarea></div><div class="jmv356-delivery-field full"><label>Información adicional (opcional)</label><textarea data-df="extra">${esc356(current.extra||'')}</textarea></div></div></section>`;
}
function openDeliveryModal356(order){
  if(!order||state?.session?.role!=='admin')return;
  ensureDeliveryModal356();activeDeliveryOrder356=order;
  const current=order.customerDelivery||{};$356('jmDeliveryTitle').textContent=`Datos para ${order.id}`;
  $356('jmDeliveryBody').innerHTML=`<div class="jmv356-delivery-note">Completa únicamente los datos que el cliente debe ver después de que la compra haya sido confirmada por tu equipo. Guardar como borrador no la mostrará en “Mis compras”.</div>${(order.items||[]).map((item,index)=>deliveryItemForm356(item,index,(current.items||[])[index]||{})).join('')}`;
  $356('jmDeliverySave').onclick=()=>saveDelivery356(false);$356('jmDeliveryConfirm').onclick=()=>saveDelivery356(true);
  $356('jmDeliveryOverlay').classList.add('open');D.body.classList.add('lock');
}
function closeDeliveryModal356(){const o=$356('jmDeliveryOverlay');if(o)o.classList.remove('open');activeDeliveryOrder356=null;requestAnimationFrame(()=>{if(!D.querySelector('.modal-overlay.open,.side-panel.open,.drawer.open,.admin-overlay.open,#notificationPanel.open,#jmMyPurchasesOverlay.open'))D.body.classList.remove('lock')})}
function collectDeliveryItems356(){return [...D.querySelectorAll('#jmDeliveryBody [data-jm-delivery-item]')].map(sec=>{const get=name=>String(sec.querySelector(`[data-df="${name}"]`)?.value||'').trim();return {quantity:get('quantity')?Number(get('quantity')):null,destinationId:get('destinationId'),startDate:get('startDate'),cutoffDate:get('cutoffDate'),accessData:get('accessData').slice(0,1600),extra:get('extra').slice(0,1000)}})}
function saveDelivery356(confirm){
  const o=activeDeliveryOrder356;if(!o||state?.session?.role!=='admin')return;
  const previous=o.customerDelivery?JSON.parse(JSON.stringify(o.customerDelivery)):null;
  const items=collectDeliveryItems356();const current=o.customerDelivery||{};
  o.customerDelivery={...current,items,confirmed:confirm?true:current.confirmed===true,updatedAt:new Date().toISOString(),confirmedAt:confirm?(current.confirmedAt||new Date().toISOString()):(current.confirmedAt||null),confirmedBy:confirm?(state.session.email||'admin'):(current.confirmedBy||null)};
  o.updatedAt=new Date().toISOString();
  const key=(typeof KEYS!=='undefined'&&KEYS.orders)?KEYS.orders:'jm_digital_orders';
  if(!safeWrite356(key,state.orders)){if(previous)o.customerDelivery=previous;else delete o.customerDelivery;notify356('No fue posible guardar los datos de entrega.','error');return}
  notify356(confirm?'Compra confirmada y disponible para el cliente.':'Datos de entrega guardados como borrador.','success');closeDeliveryModal356();setTimeout(decorateAdminOrders356,40);
}
function decorateAdminOrders356(){
  if(state?.session?.role!=='admin')return;
  const root=$356('adminContent');if(!root)return;
  const rows=[...root.querySelectorAll('.jmv2-record,.admin-record,.jm-record,.admin-list-item')];
  rows.forEach(row=>{
    if(row.querySelector('[data-jm-delivery-open]'))return;
    const txt=row.textContent||'';const order=(state.orders||[]).find(o=>txt.includes(String(o.id)));if(!order)return;
    const actions=row.querySelector('aside,.admin-record-actions,.jmv2-toolbar')||row;
    const b=D.createElement('button');b.type='button';b.className='jmv2-btn jmv356-admin-delivery-btn';b.dataset.jmDeliveryOpen=order.id;b.textContent=order.customerDelivery?.confirmed?'Datos cliente ✓':'Datos cliente';
    b.onclick=()=>openDeliveryModal356(order);actions.appendChild(b);
  });
}
const adminObserver356=new MutationObserver(()=>{if(state?.session?.role==='admin'&&state.adminSection==='orders')decorateAdminOrders356()});
function init356(){
  ensurePublicPurchasesUi356();ensureDeliveryModal356();
  const admin=$356('adminContent');if(admin)adminObserver356.observe(admin,{childList:true,subtree:true});
  setInterval(()=>{if(D.hidden)return;if(!D.getElementById('jmMyPurchasesOverlay')||!D.getElementById('jmMyPurchasesBtn'))ensurePublicPurchasesUi356();if(D.getElementById('adminOverlay')?.classList.contains('open')&&state?.session?.role==='admin'&&state.adminSection==='orders')decorateAdminOrders356()},15000);
}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init356,{once:true});else init356();
window.JM_DIGITAL_STORE_V356={VERSION:'3.5.6',openMyPurchases:openMyPurchases356,renderMyPurchases:renderMyPurchases356,openDelivery:openDeliveryModal356};
console.info('CRULOX · V3.5.6 products + confirmed purchases loaded');
})();
</script>


<!-- JM V3.5.7 · Restauración de imágenes verticales en catálogo -->
<style id="jmv357-product-portrait-style">
/* Corrección puntual: el catálogo vuelve a mostrar las imágenes en formato vertical,
   igual que la vista de detalle. No modifica lógica, datos ni acciones. */
.product-image,
.jmv21-variant-card .product-image{
  height:auto!important;
  aspect-ratio:3 / 4!important;
  padding:8px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  overflow:hidden!important;
  border-bottom:1px solid rgba(111,209,238,.07)!important;
  background:
    radial-gradient(circle at 50% 18%,rgba(29,224,255,.12),transparent 48%),
    linear-gradient(180deg,rgba(8,24,38,.985),rgba(6,17,29,.995))!important;
}
.product-image img,
.jmv21-variant-card .product-image img{
  width:100%!important;
  height:100%!important;
  max-width:100%!important;
  max-height:100%!important;
  object-fit:contain!important;
  object-position:center center!important;
  border-radius:14px!important;
  background:rgba(255,255,255,.018)!important;
  transform:none!important;
}
.product:hover .product-image img,
.jmv21-variant-card:hover .product-image img{
  transform:none!important;
}
@media(max-width:560px){
  .product-image,
  .jmv21-variant-card .product-image{
    aspect-ratio:3 / 4!important;
    padding:7px!important;
  }
  .product-image img,
  .jmv21-variant-card .product-image img{
    border-radius:13px!important;
  }
}
</style>


<!-- JM V3.6.0 · Panel administrativo más ordenado y visual -->
<style id="jmv360-admin-panel-style">
.jmv360-admin-shell{
  min-height:100dvh;
  background:
    radial-gradient(circle at 82% 18%, rgba(34,223,243,.09), transparent 28%),
    radial-gradient(circle at 12% 0%, rgba(48,114,255,.10), transparent 22%),
    linear-gradient(180deg, #031019 0%, #04111c 48%, #020b12 100%);
  color:#eef8ff;
  padding:14px;
  display:grid;
  gap:12px;
}
.jmv360-topbar,
.jmv360-nav,
.jmv360-page-head,
.jmv360-card,
.jmv360-bottom-banner{
  border:1px solid rgba(88,191,232,.15);
  background:linear-gradient(180deg, rgba(10,24,38,.90), rgba(6,18,30,.96));
  box-shadow:0 18px 42px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.03);
}
.jmv360-topbar{
  border-radius:22px;
  padding:14px 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
}
.jmv360-brand{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:0;
}
.jmv360-brand img{width:54px;height:54px;object-fit:contain;filter:drop-shadow(0 0 12px rgba(34,223,243,.22))}
.jmv360-brand b{display:block;font-size:1.02rem;line-height:1.1;color:#f6fbff}
.jmv360-brand span{display:block;margin-top:3px;font-size:.66rem;color:#79cdec;line-height:1.25}
.jmv360-top-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.jmv360-action-btn{
  min-height:50px;
  padding:0 18px;
  border-radius:18px;
  border:1px solid rgba(88,191,232,.20);
  background:linear-gradient(180deg, rgba(19,31,49,.88), rgba(10,20,34,.94));
  color:#f0f8ff;
  font-size:.92rem;
  font-weight:900;
  display:inline-flex;
  align-items:center;
  gap:10px;
}
.jmv360-action-btn.primary{
  border-color:rgba(34,223,243,.38);
  box-shadow:inset 0 0 0 1px rgba(34,223,243,.08),0 0 0 2px rgba(34,223,243,.04);
}
.jmv360-action-btn i{font-style:normal;font-size:1.15rem;color:#7ce9f8}
.jmv360-nav{
  border-radius:22px;
  padding:10px;
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  gap:10px;
}
.jmv360-nav button{
  min-height:78px;
  border-radius:18px;
  border:1px solid rgba(88,191,232,.08);
  background:linear-gradient(180deg, rgba(16,25,41,.72), rgba(9,17,29,.92));
  color:#a8bccb;
  display:grid;
  place-items:center;
  gap:6px;
  padding:10px 8px;
  text-align:center;
  font-weight:800;
  font-size:.80rem;
  position:relative;
}
.jmv360-nav button i{font-style:normal;font-size:1.30rem;color:#c5d7e4;line-height:1}
.jmv360-nav button span{display:block;line-height:1.05}
.jmv360-nav button.active,
.jmv360-nav button:hover{
  color:#effcff;
  border-color:rgba(34,223,243,.24);
  background:linear-gradient(180deg, rgba(20,74,94,.70), rgba(8,33,49,.98));
  box-shadow:inset 0 0 0 1px rgba(34,223,243,.14),0 0 18px rgba(34,223,243,.10);
}
.jmv360-nav button.active i,
.jmv360-nav button:hover i{color:#5de9fa}
.jmv360-nav button .jmv360-badge{
  position:absolute;
  top:7px;right:8px;
  min-width:19px;height:19px;padding:0 6px;
  border-radius:999px;
  background:linear-gradient(180deg,#ff5e6e,#ff3d55);
  color:#fff;font-size:.68rem;font-weight:900;
  display:grid;place-items:center;
  box-shadow:0 4px 10px rgba(255,52,90,.25);
}
.jmv360-main{display:grid;gap:14px;min-width:0}
.jmv360-page-head{
  border-radius:24px;
  padding:18px 20px;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
}
.jmv360-page-head small{display:block;color:#8ca6b8;font-size:.77rem;font-weight:900;letter-spacing:.20em;text-transform:uppercase}
.jmv360-page-head h1{margin:4px 0 6px;color:#ffffff;font-size:2.25rem;line-height:1.02;font-weight:1000;letter-spacing:-.03em}
.jmv360-page-head p{margin:0;max-width:550px;color:#a9bdcc;font-size:1rem;line-height:1.28}
.jmv360-date{
  min-width:220px;
  padding:10px 12px;
  border-radius:18px;
  border:1px solid rgba(88,191,232,.12);
  background:rgba(255,255,255,.015);
  color:#dbeaf5;
  display:flex;
  align-items:flex-start;
  justify-content:flex-end;
  gap:10px;
}
.jmv360-date i{font-style:normal;font-size:1.35rem;color:#dce9f5}
.jmv360-date b{display:block;font-size:1rem;line-height:1.2}
.jmv360-date span{display:block;margin-top:2px;color:#a4bac9;font-size:.88rem;line-height:1.25}
.jmv360-home{display:grid;gap:16px}
.jmv360-hero{
  position:relative;
  overflow:hidden;
  border-radius:24px;
  border:1px solid rgba(88,191,232,.18);
  background:
    radial-gradient(circle at 78% 68%, rgba(34,223,243,.14), transparent 22%),
    radial-gradient(circle at 80% 100%, rgba(70,125,255,.12), transparent 30%),
    linear-gradient(100deg, rgba(8,28,43,.94) 0%, rgba(8,28,43,.96) 42%, rgba(4,17,29,.88) 100%);
  box-shadow:0 18px 42px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.03);
  padding:24px;
  display:grid;
  grid-template-columns:1.35fr minmax(210px,.85fr);
  gap:18px;
}
.jmv360-hero::after{
  content:"";
  position:absolute;inset:auto -6% -30% auto;
  width:48%;height:180%;
  background:radial-gradient(circle, rgba(34,223,243,.18) 0%, rgba(34,223,243,.04) 32%, transparent 58%);
  pointer-events:none;
}
.jmv360-hero-copy{position:relative;z-index:1}
.jmv360-hero-copy h2{margin:0;color:#fff;font-size:1.10rem;line-height:1.2;font-weight:1000}
.jmv360-hero-copy .accent{display:block;margin-top:4px;color:#38e8fb;font-size:1.82rem;font-weight:1000;line-height:1.05}
.jmv360-hero-copy p{margin:12px 0 0;max-width:620px;color:#abc0cf;font-size:1rem;line-height:1.5}
.jmv360-hero-badge{
  position:absolute;
  top:18px;left:56%;
  transform:translateX(-50%);
  min-width:118px;
  text-align:center;
  padding:12px 14px;
  border-radius:999px;
  border:1px solid rgba(85,240,128,.24);
  background:linear-gradient(180deg, rgba(16,72,41,.70), rgba(10,50,31,.92));
  color:#92fbad;
  font-size:1rem;
  font-weight:1000;
  line-height:1.1;
}
.jmv360-hero-visual{position:relative;z-index:1;display:grid;align-content:center;justify-items:center;gap:14px}
.jmv360-hero-visual img{width:170px;max-width:100%;object-fit:contain;filter:drop-shadow(0 0 18px rgba(34,223,243,.20))}
.jmv360-hero-points{display:grid;gap:4px;justify-items:start;color:#d8f8ff;font-size:.92rem;font-weight:900;letter-spacing:.02em}
.jmv360-hero-line{width:64px;height:7px;border-radius:999px;background:linear-gradient(90deg,#24dff3,#36b2ff)}
.jmv360-section-head{display:flex;align-items:end;justify-content:space-between;gap:12px}
.jmv360-section-head h3{margin:0;color:#fff;font-size:1.15rem;font-weight:1000;display:flex;align-items:center;gap:10px}
.jmv360-section-head h3 i{font-style:normal;color:#38e8fb;font-size:1.25rem}
.jmv360-section-head p{margin:2px 0 0;color:#9ab2c3;font-size:.92rem;line-height:1.35}
.jmv360-link-btn{
  min-height:48px;
  padding:0 18px;
  border-radius:18px;
  border:1px solid rgba(88,191,232,.18);
  background:linear-gradient(180deg, rgba(13,24,39,.85), rgba(10,18,31,.95));
  color:#ebf9ff;
  font-size:.96rem;
  font-weight:900;
  display:inline-flex;
  align-items:center;
  gap:10px;
}
.jmv360-link-btn i{font-style:normal;color:#9fdaf2;font-size:1.1rem}
.jmv360-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.jmv360-metric{
  border-radius:22px;
  border:1px solid rgba(88,191,232,.14);
  background:linear-gradient(180deg, rgba(9,25,39,.88), rgba(8,20,33,.97));
  box-shadow:0 10px 30px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.025);
  padding:16px;
}
.jmv360-metric-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.jmv360-metric i{font-style:normal;font-size:1.35rem}
.jmv360-metric b{display:block;color:#dfeef8;font-size:1rem;line-height:1.1}
.jmv360-metric strong{display:block;margin-top:6px;color:#33ebfb;font-size:2.15rem;font-weight:1000;line-height:1}
.jmv360-metric span{display:block;margin-top:6px;color:#9cb3c4;font-size:.96rem;line-height:1.2}
.jmv360-priorities,
.jmv360-access-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.jmv360-priority,
.jmv360-access,
.jmv360-bottom-banner{
  border-radius:22px;
  overflow:hidden;
}
.jmv360-priority,
.jmv360-access{
  border:1px solid rgba(88,191,232,.16);
  background:linear-gradient(180deg, rgba(9,23,37,.90), rgba(8,20,34,.98));
  padding:16px;
  color:#fff;
  text-align:left;
  box-shadow:0 12px 32px rgba(0,0,0,.20), inset 0 1px 0 rgba(255,255,255,.02);
}
.jmv360-priority .jmv360-top,
.jmv360-access .jmv360-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.jmv360-priority i,
.jmv360-access i{font-style:normal;font-size:1.55rem}
.jmv360-priority .go,
.jmv360-access .go{color:#e6f5ff;font-size:1.35rem;opacity:.88}
.jmv360-priority b,
.jmv360-access b{display:block;font-size:1.05rem;line-height:1.15;color:#f7fcff}
.jmv360-priority p,
.jmv360-access p{margin:6px 0 0;color:#bdd2df;font-size:.96rem;line-height:1.35}
.jmv360-priority.emerald{background:linear-gradient(180deg, rgba(13,64,61,.86), rgba(8,32,38,.98))}
.jmv360-priority.gold{background:linear-gradient(180deg, rgba(76,58,17,.82), rgba(34,26,9,.98))}
.jmv360-priority.blue{background:linear-gradient(180deg, rgba(15,48,95,.85), rgba(9,23,48,.98))}
.jmv360-priority.violet{background:linear-gradient(180deg, rgba(53,26,109,.84), rgba(23,12,50,.98))}
.jmv360-access.cyan{background:linear-gradient(180deg, rgba(18,116,126,.76), rgba(10,64,73,.98))}
.jmv360-access.sky{background:linear-gradient(180deg, rgba(18,90,165,.78), rgba(11,48,91,.98))}
.jmv360-access.purple{background:linear-gradient(180deg, rgba(108,49,177,.80), rgba(51,19,91,.98))}
.jmv360-access.amber{background:linear-gradient(180deg, rgba(149,93,18,.78), rgba(86,50,7,.98))}
.jmv360-access.teal{background:linear-gradient(180deg, rgba(18,126,140,.76), rgba(10,68,77,.98))}
.jmv360-bottom-banner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  padding:18px 20px;
  background:
    radial-gradient(circle at 78% 50%, rgba(34,223,243,.09), transparent 18%),
    linear-gradient(100deg, rgba(8,25,40,.96), rgba(5,20,33,.92));
}
.jmv360-bottom-banner h3{margin:0;color:#f7fcff;font-size:1.55rem;display:flex;align-items:center;gap:10px}
.jmv360-bottom-banner h3 i{font-style:normal;color:#3be9fb}
.jmv360-bottom-banner p{margin:5px 0 0;color:#a9bfce;font-size:1rem;line-height:1.35}
.jmv360-bottom-banner .jmv360-link-btn{min-width:220px;justify-content:center}

@media(max-width:1180px){
  .jmv360-nav{grid-template-columns:repeat(3,minmax(0,1fr))}
  .jmv360-metrics,.jmv360-priorities,.jmv360-access-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .jmv360-hero{grid-template-columns:1fr;}
  .jmv360-hero-badge{left:auto;right:18px;transform:none}
}
@media(max-width:760px){
  .jmv360-admin-shell{padding:10px;gap:10px}
  .jmv360-topbar{padding:12px;border-radius:18px;align-items:flex-start;flex-direction:column}
  .jmv360-top-actions{width:100%;justify-content:stretch}.jmv360-top-actions .jmv360-action-btn{flex:1 1 140px;justify-content:center;min-height:46px;font-size:.84rem}
  .jmv360-brand img{width:42px;height:42px}.jmv360-brand b{font-size:.88rem}.jmv360-brand span{font-size:.58rem}
  .jmv360-nav{padding:8px;border-radius:18px;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .jmv360-nav button{min-height:68px;border-radius:15px;font-size:.72rem;padding:8px 5px}.jmv360-nav button i{font-size:1.12rem}
  .jmv360-page-head{padding:14px;border-radius:18px;flex-direction:column;align-items:flex-start}
  .jmv360-page-head h1{font-size:1.85rem}.jmv360-page-head p{font-size:.86rem}
  .jmv360-date{min-width:0;width:100%;justify-content:flex-start;border-radius:14px;padding:9px 10px}.jmv360-date b{font-size:.88rem}.jmv360-date span{font-size:.76rem}
  .jmv360-hero{padding:16px;border-radius:18px;gap:14px}.jmv360-hero-copy h2{font-size:.98rem}.jmv360-hero-copy .accent{font-size:1.45rem}.jmv360-hero-copy p{font-size:.88rem;line-height:1.42}.jmv360-hero-badge{position:static;transform:none;margin-bottom:4px;justify-self:start;font-size:.84rem;padding:9px 12px;min-width:auto}.jmv360-hero-visual{justify-items:start}.jmv360-hero-visual img{width:110px}.jmv360-hero-points{font-size:.82rem}
  .jmv360-section-head{align-items:flex-start;flex-direction:column}.jmv360-section-head h3{font-size:1rem}.jmv360-section-head p{font-size:.82rem}.jmv360-link-btn{min-height:42px;border-radius:14px;font-size:.82rem;padding:0 14px}
  .jmv360-metrics,.jmv360-priorities,.jmv360-access-grid{grid-template-columns:1fr 1fr;gap:9px}
  .jmv360-metric,.jmv360-priority,.jmv360-access{border-radius:16px;padding:12px}
  .jmv360-metric b{font-size:.85rem}.jmv360-metric strong{font-size:1.65rem}.jmv360-metric span{font-size:.76rem}
  .jmv360-priority b,.jmv360-access b{font-size:.92rem}.jmv360-priority p,.jmv360-access p{font-size:.80rem}
  .jmv360-bottom-banner{padding:14px;border-radius:18px;flex-direction:column;align-items:flex-start}.jmv360-bottom-banner h3{font-size:1.15rem}.jmv360-bottom-banner p{font-size:.84rem}.jmv360-bottom-banner .jmv360-link-btn{min-width:0;width:100%}
}
@media(max-width:420px){
  .jmv360-nav{grid-template-columns:repeat(2,minmax(0,1fr))}
  .jmv360-metrics,.jmv360-priorities,.jmv360-access-grid{grid-template-columns:1fr}
}
</style>
<script id="jmv360-admin-panel-script">
(()=>{
'use strict';
const D=document;
const oldRenderAdminV2 = (typeof renderAdminV2==='function') ? renderAdminV2 : null;
function esc360(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function fmtDateTime360(){
  const now=new Date();
  try{
    const date=now.toLocaleDateString('es-GT',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
    const time=now.toLocaleTimeString('es-GT',{hour:'numeric',minute:'2-digit'});
    return {date, time};
  }catch(e){return {date:'',time:''}}
}
function navIcon360(id){return ({home:'⌂',services:'◫',orders:'🛒',clients:'👥',availability:'◔',promotions:'🏷',messages:'🔔',settings:'⚙'})[id]||'•'}
function navBadge360(id){
  try{
    if(id==='orders') return pendingCount?.()||0;
    if(id==='messages') return (Array.isArray(state.notifications)?state.notifications.filter(n=>!n.read).length:0) || 0;
    return 0;
  }catch(e){return 0}
}
function buildNav360(){
  return NAV.filter(([id])=>['home','services','orders','clients','messages','settings'].includes(id)).map(([id,ic,label])=>{
    const badge=navBadge360(id);
    return `<button type="button" data-jmv2-section="${esc360(id)}"><i>${esc360(navIcon360(id))}</i><span>${esc360(label==='Atención'?'Notificaciones':label)}</span>${badge?`<b class="jmv360-badge">${badge>99?'99+':badge}</b>`:''}</button>`;
  }).join('');
}
function adminShell360(){
  if(!admin) return null;
  if(admin.dataset.jmv360Shell!=='1'){
    admin.dataset.jmv360Shell='1';
    admin.innerHTML=`<div class="jmv360-admin-shell"><header class="jmv360-topbar"><div class="jmv360-brand"><img src="${esc360(BRAND_LOGO)}" alt="CRULOX"><div><b>CRULOX</b><span>Operación 100% digital</span></div></div><div class="jmv360-top-actions"><button type="button" class="jmv360-action-btn primary" id="adminStoreBtn"><i>🏪</i><span>Tienda</span></button><button type="button" class="jmv360-action-btn" id="adminLogout"><i>⎋</i><span>Salir</span></button></div></header><nav class="jmv360-nav" id="adminNav">${buildNav360()}</nav><main class="jmv360-main"><section class="jmv360-page-head"><div><small>Centro de control digital</small><h1 id="adminTitle">Panel principal</h1><p id="jmv360PageLead">Gestiona tu tienda, pedidos y servicios desde un solo lugar.</p></div><div class="jmv360-date" id="jmv360Date"><i>🗓</i><div><b></b><span></span></div></div></section><section class="jmv360-home" id="adminContent"></section></main></div>`;
  } else {
    const nav = D.getElementById('adminNav'); if(nav) nav.innerHTML = buildNav360();
  }
  const nav=D.getElementById('adminNav');
  if(nav) nav.onclick=e=>{const b=e.target.closest('[data-jmv2-section]'); if(b) renderAdminV2(b.dataset.jmv2Section);};
  const store=D.getElementById('adminStoreBtn'); if(store) store.onclick=()=>{admin.classList.remove('open');D.body.classList.remove('lock')};
  const logout=D.getElementById('adminLogout'); if(logout) logout.onclick=()=>{state.session=null;safeWrite(KEYS.session,null);admin.classList.remove('open');D.body.classList.remove('lock');try{renderHeader()}catch(e){}notify('Sesión cerrada.','success')};
  refreshDateTime360();
  return D.getElementById('adminContent');
}
function refreshDateTime360(){
  const box=D.getElementById('jmv360Date'); if(!box) return;
  const {date,time}=fmtDateTime360();
  const b=box.querySelector('b'); const s=box.querySelector('span');
  if(b) b.textContent = date ? date.replace(/\.$/, '') : '';
  if(s) s.textContent = time ? `${time}` : '';
}
function setHead360(title,lead){
  const t=D.getElementById('adminTitle'); if(t) t.textContent=title;
  const p=D.getElementById('jmv360PageLead'); if(p) p.textContent=lead;
  refreshDateTime360();
}
function metricCard360(icon,title,value,note){
  return `<article class="jmv360-metric"><div class="jmv360-metric-top"><i>${esc360(icon)}</i><b>${esc360(title)}</b></div><strong>${esc360(value)}</strong><span>${esc360(note)}</span></article>`;
}
function priorityCard360(cls,icon,title,text,target){
  return `<button type="button" class="jmv360-priority ${esc360(cls)}" data-jmv360-go="${esc360(target)}"><div class="jmv360-top"><i>${esc360(icon)}</i><span class="go">›</span></div><b>${esc360(title)}</b><p>${esc360(text)}</p></button>`;
}
function accessCard360(cls,icon,title,text,target,mode='section'){
  return `<button type="button" class="jmv360-access ${esc360(cls)}" data-jmv360-go="${esc360(target)}" data-jmv360-mode="${esc360(mode)}"><div class="jmv360-top"><i>${esc360(icon)}</i><span class="go">›</span></div><b>${esc360(title)}</b><p>${esc360(text)}</p></button>`;
}
function homeAdmin360(){
  purgeExpiredReservations();
  const limited=state.products.filter(p=>(normalizeProductV2(p),p.availabilityMode==='limited'));
  const low=limited.filter(p=>Number(p.stock)>0&&Number(p.stock)<=Number(state.settings.lowStock||3)).length;
  const out=limited.filter(p=>Number(p.stock)<=0).length;
  const payPending=state.orders.filter(o=>o.status==='Pago pendiente').length;
  const prep=state.orders.filter(o=>['Pago confirmado','Preparando acceso','Listo para entregar'].includes(o.status)).length;
  const totalServices=state.products.length;
  const pending=pendingCount();
  const revenue=money2(paidRevenue());
  const reserves=reservationCount();
  const content=D.getElementById('adminContent'); if(!content) return;
  setHead360('Panel principal','Gestiona tu tienda, pedidos y servicios desde un solo lugar.');
  content.innerHTML = `
    <section class="jmv360-hero">
      <div class="jmv360-hero-copy">
        <h2>CRULOX</h2>
        <span class="accent">Operación 100% digital</span>
        <p>El flujo está optimizado para perfiles, cursos, diamantes/recargas, membresías, licencias y activaciones. No existe logística física.</p>
      </div>
      <span class="jmv360-hero-badge">V2.0<br>DIGITAL</span>
      <div class="jmv360-hero-visual">
        <img src="${esc360(BRAND_LOGO)}" alt="CRULOX">
        <div class="jmv360-hero-points"><span>MÁS VENTAS</span><span>MÁS PERSONAS</span><span>MÁS POSIBILIDADES</span></div>
        <div class="jmv360-hero-line"></div>
      </div>
    </section>
    <section>
      <div class="jmv360-section-head"><div><h3><i>▮▮▮</i><span>Métricas clave</span></h3><p>Resumen en tiempo real de tu operación.</p></div><button type="button" class="jmv360-link-btn" data-jmv360-go="orders"><span>Ver más</span><i>›</i></button></div>
      <div class="jmv360-metrics">
        ${metricCard360('◫','Servicios',String(totalServices),'en catálogo')}
        ${metricCard360('🧾','Pendientes',String(pending),'requieren acción')}
        ${metricCard360('💳','Pago pendiente',String(payPending),'por confirmar')}
        ${metricCard360('◔','Preparando',String(prep),'pagados / en proceso')}
        ${metricCard360('▮▮','Ingresos',String(revenue),'confirmados')}
        ${metricCard360('👥','Reservas',String(reserves),'cupos retenidos')}
        ${metricCard360('▣','Stock bajo',String(low),'servicios limitados')}
        ${metricCard360('⊘','Sin cupos',String(out),'requieren reposición')}
      </div>
    </section>
    <section>
      <div class="jmv360-section-head"><div><h3><i>⚡</i><span>Prioridades operativas</span></h3><p>Acciones que tienen impacto inmediato en ventas y entregas.</p></div><button type="button" class="jmv360-link-btn" data-jmv360-go="orders"><span>Ver todas</span><i>›</i></button></div>
      <div class="jmv360-priorities">
        ${priorityCard360('emerald','💳',`${payPending} pagos pendientes`,'Confirmar pagos y continuar pedidos.','orders')}
        ${priorityCard360('gold','🚚',`${prep} por entregar`,'Preparar accesos, recargas o cursos.','orders')}
        ${priorityCard360('blue','👥',`${out} sin cupos`,'Reponer perfiles o capacidad limitada.','availability')}
        ${priorityCard360('violet','＋','Nuevo servicio','Crear una venta digital correctamente tipificada.','create-service')}
      </div>
    </section>
    <section>
      <div class="jmv360-section-head"><div><h3><i>🚀</i><span>Accesos rápidos</span></h3><p>Tus funciones más utilizadas, siempre a la mano.</p></div></div>
      <div class="jmv360-access-grid">
        ${accessCard360('cyan','＋','Crear servicio','Agrega un nuevo producto o servicio.','create-service','action')}
        ${accessCard360('sky','🛒','Ver pedidos','Revisa estado, pagos y entregas.','orders')}
        ${accessCard360('purple','💳','Confirmar pagos','Entra directo a los pedidos por validar.','orders')}
        ${accessCard360('amber','▣','Gestionar stock','Controla cupos, perfiles y disponibilidad.','availability')}
        ${accessCard360('teal','💬','Mensajes Typebots','Administra accesos y enlaces de Typebot.','messages')}
      </div>
    </section>
    <section class="jmv360-bottom-banner">
      <div><h3><i>◈</i><span>Tu tienda, 100% digital</span></h3><p>Más rápida. Más simple. Más lejos.</p></div>
      <button type="button" class="jmv360-link-btn" id="jmv360OpenStore"><span>CRULOX</span><i>›</i></button>
    </section>`;
  bindHome360();
}
function bindHome360(){
  const root=D.getElementById('adminContent'); if(!root) return;
  root.querySelectorAll('[data-jmv360-go]').forEach(b=>b.onclick=()=>{
    const target=b.dataset.jmv360Go; const mode=b.dataset.jmv360Mode||'section';
    if(target==='create-service' || mode==='action') return openServiceEditorV2?.();
    return renderAdminV2(target);
  });
  const openStore=D.getElementById('jmv360OpenStore'); if(openStore) openStore.onclick=()=>{admin.classList.remove('open');D.body.classList.remove('lock')};
}
function renderAdminV360(section='home'){
  if(state.session?.role==='agent') return oldRenderAdminV2 ? oldRenderAdminV2(section) : false;
  if(state.session?.role!=='admin') return false;
  adminShell360();
  purgeExpiredReservations();
  const aliases={dashboard:'home',products:'services',inventory:'availability',users:'clients',bots:'messages',backup:'settings',activity:'home',categories:'services',faqs:'settings'};
  section=aliases[section]||section;
  if(!NAV.some(x=>x[0]===section)) section='home';
  state.adminSection=section;
  navActive(section);
  const titles={home:'Panel principal',services:'Servicios digitales',availability:'Disponibilidad',orders:'Pedidos digitales',clients:'Clientes',promotions:'Promociones',messages:'Atención y Typebots',settings:'Ajustes'};
  const leads={home:'Gestiona tu tienda, pedidos y servicios desde un solo lugar.',services:'Organiza y edita tu catálogo digital.',availability:'Controla cupos, stock y reservas de disponibilidad.',orders:'Supervisa pagos, comprobantes, entrega y estado operativo.',clients:'Consulta tus clientes y su actividad dentro del sistema.',promotions:'Administra promociones y beneficios comerciales.',messages:'Gestiona enlaces de Typebot y atención digital.',settings:'Ajusta parámetros clave de la operación.'};
  setHead360(titles[section]||'Panel digital', leads[section]||'Gestiona la operación de tu tienda.');
  if(section==='home') homeAdmin360();
  else if(section==='services') servicesAdminV2();
  else if(section==='availability') availabilityAdminV2();
  else if(section==='orders') ordersAdminV2();
  else if(section==='clients') clientsAdminV2();
  else if(section==='promotions') promotionsAdminV2();
  else if(section==='messages') messagesAdminV2();
  else if(section==='settings') settingsAdminV2();
  refreshDateTime360();
  const nav=D.getElementById('adminNav'); if(nav) nav.innerHTML=buildNav360();
  navActive(section);
  return true;
}
try{window.adminShell=adminShell360;adminShell=adminShell360}catch(e){}
try{window.homeAdminV2=homeAdmin360;homeAdminV2=homeAdmin360}catch(e){}
try{window.renderAdminV2=renderAdminV360;renderAdminV2=renderAdminV360}catch(e){}
try{window.openAdmin=(section='home')=>{if(state.session?.role==='agent' && typeof oldRenderAdminV2==='function') return oldRenderAdminV2(section); if(state.session?.role!=='admin') return false; admin.classList.add('open'); D.body.classList.add('lock'); return renderAdminV360(section);};}catch(e){}
setInterval(refreshDateTime360,60000);
window.JM_DIGITAL_STORE_V360={VERSION:'3.6.0',renderAdmin:renderAdminV360};
})();
</script>


<!-- JM V3.6.1 · Corrección de acceso a Perfil / Panel -->
<script id="jmv361-profile-access-fix">
(()=>{
'use strict';
const D=document;
const v2=window.JM_DIGITAL_STORE_V2||null;
const overlay=()=>D.getElementById('adminOverlay');
const account=()=>D.getElementById('accountModal');
const byId=id=>D.getElementById(id);
const safeWrite361=(key,val)=>{try{if(typeof write==='function')return write(key,val);localStorage.setItem(key,JSON.stringify(val));return true}catch(e){return false}};
const notify361=(m,t='info')=>{try{if(typeof toast==='function')toast(m,t)}catch(e){}};
const currentRole361=()=>state?.session?.role||null;
const isAdmin361=()=>currentRole361()==='admin';
const isAgent361=()=>currentRole361()==='agent';
const esc361=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money361=n=>`${String(state?.settings?.currency||'Q').trim()||'Q'}${Number(n||0).toFixed(2)}`;
const paidSet361=new Set(['Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado']);
const completeSet361=new Set(['Entregado digital','Completado']);
const canceledSet361=new Set(['Cancelado','Reserva vencida']);
function pendingCount361(){return (state?.orders||[]).filter(o=>!completeSet361.has(o.status)&&!canceledSet361.has(o.status)).length}
function paidRevenue361(){return (state?.orders||[]).filter(o=>o.payment?.status==='Confirmado'||paidSet361.has(o.status)).reduce((s,o)=>s+Number(o.total||0),0)}
function reservationCount361(){return (state?.orders||[]).filter(o=>o.inventory?.reservationStatus==='reserved').reduce((s,o)=>s+(o.inventory?.items||[]).reduce((x,i)=>x+Number(i.qty||0),0),0)}
function markNav361(section){D.querySelectorAll('#adminNav [data-jmv2-section]').forEach(b=>b.classList.toggle('active',b.dataset.jmv2Section===section))}
function dateTime361(){const n=new Date();try{return {date:n.toLocaleDateString('es-GT',{weekday:'short',day:'numeric',month:'short',year:'numeric'}),time:n.toLocaleTimeString('es-GT',{hour:'numeric',minute:'2-digit'})}}catch(e){return {date:'',time:''}}}
function refreshDate361(){const box=byId('jmv360Date');if(!box)return;const x=dateTime361();const b=box.querySelector('b'),s=box.querySelector('span');if(b)b.textContent=x.date;if(s)s.textContent=x.time}
function navBadge361(id){if(id==='orders')return pendingCount361();return 0}
function buildNav361(){const items=[['home','⌂','Inicio'],['services','◫','Servicios'],['orders','🛒','Pedidos'],['clients','👥','Clientes'],['messages','🔔','Notificaciones'],['settings','⚙','Ajustes']];return items.map(([id,ic,label])=>{const badge=navBadge361(id);return `<button type="button" data-jmv2-section="${id}"><i>${ic}</i><span>${label}</span>${badge?`<b class="jmv360-badge">${badge>99?'99+':badge}</b>`:''}</button>`}).join('')}
function ensureShell361(){
  const a=overlay();if(!a)return null;
  if(a.dataset.jmv361Shell!=='1'){
    a.dataset.jmv361Shell='1';
    a.dataset.jmv2Shell='1';
    a.innerHTML=`<div class="jmv360-admin-shell"><header class="jmv360-topbar"><div class="jmv360-brand"><img src="${esc361(BRAND_LOGO)}" alt="CRULOX"><div><b>CRULOX</b><span>Operación 100% digital</span></div></div><div class="jmv360-top-actions"><button type="button" class="jmv360-action-btn primary" id="adminStoreBtn"><i>🏪</i><span>Tienda</span></button><button type="button" class="jmv360-action-btn" id="adminLogout"><i>⎋</i><span>Salir</span></button></div></header><nav class="jmv360-nav" id="adminNav">${buildNav361()}</nav><main class="jmv360-main"><section class="jmv360-page-head"><div><small>Centro de control digital</small><h1 id="adminTitle">Panel principal</h1><p id="jmv360PageLead">Gestiona tu tienda, pedidos y servicios desde un solo lugar.</p></div><div class="jmv360-date" id="jmv360Date"><i>🗓</i><div><b></b><span></span></div></div></section><section class="jmv360-home" id="adminContent"></section></main></div>`;
  }
  const nav=byId('adminNav');if(nav){nav.innerHTML=buildNav361();nav.onclick=e=>{const b=e.target.closest('[data-jmv2-section]');if(b)renderAdmin361(b.dataset.jmv2Section)}}
  const store=byId('adminStoreBtn');if(store)store.onclick=()=>{a.classList.remove('open');D.body.classList.remove('lock');try{renderHeader()}catch(e){}};
  const logout=byId('adminLogout');if(logout)logout.onclick=()=>{state.session=null;safeWrite361(KEYS.session,null);a.classList.remove('open');D.body.classList.remove('lock');try{renderHeader()}catch(e){}notify361('Sesión cerrada correctamente.','success')};
  refreshDate361();return byId('adminContent');
}
function setHead361(title,lead){const t=byId('adminTitle'),p=byId('jmv360PageLead');if(t)t.textContent=title;if(p)p.textContent=lead;refreshDate361()}
function metric361(icon,title,value,note){return `<article class="jmv360-metric"><div class="jmv360-metric-top"><i>${icon}</i><b>${esc361(title)}</b></div><strong>${esc361(value)}</strong><span>${esc361(note)}</span></article>`}
function priority361(cls,icon,title,text,target){return `<button type="button" class="jmv360-priority ${cls}" data-jmv361-go="${target}"><div class="jmv360-top"><i>${icon}</i><span class="go">›</span></div><b>${esc361(title)}</b><p>${esc361(text)}</p></button>`}
function access361(cls,icon,title,text,target,action='section'){return `<button type="button" class="jmv360-access ${cls}" data-jmv361-go="${target}" data-jmv361-action="${action}"><div class="jmv360-top"><i>${icon}</i><span class="go">›</span></div><b>${esc361(title)}</b><p>${esc361(text)}</p></button>`}
function home361(){
  try{v2?.purgeExpiredReservations?.()}catch(e){}
  const products=state?.products||[],orders=state?.orders||[];
  const limited=products.filter(p=>String(p.availabilityMode||'limited')==='limited');
  const low=limited.filter(p=>Number(p.stock)>0&&Number(p.stock)<=Number(state?.settings?.lowStock||3)).length;
  const out=limited.filter(p=>Number(p.stock)<=0).length;
  const payPending=orders.filter(o=>o.status==='Pago pendiente').length;
  const prep=orders.filter(o=>['Pago confirmado','Preparando acceso','Listo para entregar'].includes(o.status)).length;
  const c=byId('adminContent');if(!c)return;
  setHead361('Panel principal','Gestiona tu tienda, pedidos y servicios desde un solo lugar.');
  c.innerHTML=`<section class="jmv360-hero"><div class="jmv360-hero-copy"><h2>CRULOX</h2><span class="accent">Operación 100% digital</span><p>El flujo está optimizado para perfiles, cursos, diamantes/recargas, membresías, licencias y activaciones. No existe logística física.</p></div><span class="jmv360-hero-badge">V2.0<br>DIGITAL</span><div class="jmv360-hero-visual"><img src="${esc361(BRAND_LOGO)}" alt="CRULOX"><div class="jmv360-hero-points"><span>MÁS VENTAS</span><span>MÁS PERSONAS</span><span>MÁS POSIBILIDADES</span></div><div class="jmv360-hero-line"></div></div></section><section><div class="jmv360-section-head"><div><h3><i>▮▮▮</i><span>Métricas clave</span></h3><p>Resumen en tiempo real de tu operación.</p></div><button type="button" class="jmv360-link-btn" data-jmv361-go="orders"><span>Ver más</span><i>›</i></button></div><div class="jmv360-metrics">${metric361('◫','Servicios',String(products.length),'en catálogo')}${metric361('🧾','Pendientes',String(pendingCount361()),'requieren acción')}${metric361('💳','Pago pendiente',String(payPending),'por confirmar')}${metric361('◔','Preparando',String(prep),'pagados / en proceso')}${metric361('▮▮','Ingresos',money361(paidRevenue361()),'confirmados')}${metric361('👥','Reservas',String(reservationCount361()),'cupos retenidos')}${metric361('▣','Stock bajo',String(low),'servicios limitados')}${metric361('⊘','Sin cupos',String(out),'requieren reposición')}</div></section><section><div class="jmv360-section-head"><div><h3><i>⚡</i><span>Prioridades operativas</span></h3><p>Acciones que tienen impacto inmediato en ventas y entregas.</p></div><button type="button" class="jmv360-link-btn" data-jmv361-go="orders"><span>Ver todas</span><i>›</i></button></div><div class="jmv360-priorities">${priority361('emerald','💳',`${payPending} pagos pendientes`,'Confirmar pagos y continuar pedidos.','orders')}${priority361('gold','🚚',`${prep} por entregar`,'Preparar accesos, recargas o cursos.','orders')}${priority361('blue','👥',`${out} sin cupos`,'Reponer perfiles o capacidad limitada.','availability')}${priority361('violet','＋','Nuevo servicio','Crear una venta digital correctamente tipificada.','create-service')}</div></section><section><div class="jmv360-section-head"><div><h3><i>🚀</i><span>Accesos rápidos</span></h3><p>Tus funciones más utilizadas, siempre a la mano.</p></div></div><div class="jmv360-access-grid">${access361('cyan','＋','Crear servicio','Agrega un nuevo producto o servicio.','create-service','action')}${access361('sky','🛒','Ver pedidos','Revisa estado, pagos y entregas.','orders')}${access361('purple','💳','Confirmar pagos','Entra directo a los pedidos por validar.','orders')}${access361('amber','▣','Gestionar stock','Controla cupos, perfiles y disponibilidad.','availability')}${access361('teal','💬','Mensajes Typebots','Administra accesos y enlaces de Typebot.','messages')}</div></section><section class="jmv360-bottom-banner"><div><h3><i>◈</i><span>Tu tienda, 100% digital</span></h3><p>Más rápida. Más simple. Más lejos.</p></div><button type="button" class="jmv360-link-btn" id="jmv361OpenStore"><span>CRULOX</span><i>›</i></button></section>`;
  c.querySelectorAll('[data-jmv361-go]').forEach(b=>b.onclick=()=>{const t=b.dataset.jmv361Go;if(t==='create-service')return v2?.openServiceEditor?.();renderAdmin361(t)});
  const s=byId('jmv361OpenStore');if(s)s.onclick=()=>{overlay()?.classList.remove('open');D.body.classList.remove('lock')};
}
function renderAdmin361(section='home'){
  if(!isAdmin361())return false;
  const alias={dashboard:'home',products:'services',inventory:'availability',users:'clients',bots:'messages',backup:'settings',activity:'home',categories:'services',faqs:'settings'};
  section=alias[section]||section;
  ensureShell361();
  if(section==='home'){state.adminSection='home';markNav361('home');home361();return true}
  const titles={services:'Servicios digitales',availability:'Disponibilidad',orders:'Pedidos digitales',clients:'Clientes',promotions:'Promociones',messages:'Atención y Typebots',settings:'Ajustes'};
  const leads={services:'Organiza y edita tu catálogo digital.',availability:'Controla cupos, stock y reservas de disponibilidad.',orders:'Supervisa pagos, comprobantes, entrega y estado operativo.',clients:'Consulta tus clientes y su actividad dentro del sistema.',promotions:'Administra promociones y beneficios comerciales.',messages:'Gestiona enlaces de Typebot y atención digital.',settings:'Ajusta parámetros clave de la operación.'};
  try{
    if(v2?.renderAdmin) v2.renderAdmin(section); else return false;
    if(section==='messages')setTimeout(()=>{try{window.JM_DIGITAL_STORE_V352?.injectBotManagement?.()}catch(e){}},30);
    setHead361(titles[section]||'Panel digital',leads[section]||'Gestiona la operación de tu tienda.');
    const nav=byId('adminNav');if(nav){nav.innerHTML=buildNav361();nav.onclick=e=>{const b=e.target.closest('[data-jmv2-section]');if(b)renderAdmin361(b.dataset.jmv2Section)}}
    markNav361(section);refreshDate361();return true;
  }catch(error){console.error('JM V3.6.1 admin render',error);notify361('No fue posible abrir esta sección.','error');return false}
}
function openAdmin361(section='home'){
  if(isAgent361()){
    const legacy=window.NP_TEAM_API_V105;
    try{if(legacy&&typeof legacy.applyNav==='function'&&typeof window.renderAdminSection==='function'){const a=overlay();a?.classList.add('open');D.body.classList.add('lock');window.renderAdminSection(section==='dashboard'?'home':section);setTimeout(()=>legacy.applyNav(),0);return true}}catch(e){}
    return false;
  }
  if(!isAdmin361())return false;
  const a=overlay();if(!a)return false;a.classList.add('open');D.body.classList.add('lock');return renderAdmin361(section);
}
function openProfile361(){
  if(isAdmin361()||isAgent361())return openAdmin361('home');
  try{if(typeof renderAccount==='function')renderAccount();if(typeof openModal==='function')openModal('accountModal');else{account()?.classList.add('open');D.body.classList.add('lock')}return true}catch(error){console.error('JM V3.6.1 profile',error);notify361('No fue posible abrir tu perfil.','error');return false}
}
function bindProfile361(){const p=byId('profileBtn'),d=byId('drawerProfile'),f=byId('footerProfile');if(p)p.onclick=openProfile361;if(d)d.onclick=()=>{try{if(typeof closeAllPanels==='function')closeAllPanels()}catch(e){}openProfile361()};if(f)f.onclick=openProfile361}
window.openAdmin=openAdmin361;
try{openAdmin=openAdmin361}catch(e){}
window.JM_DIGITAL_STORE_V361={VERSION:'3.6.1',openProfile:openProfile361,openAdmin:openAdmin361,renderAdmin:renderAdmin361};
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>{bindProfile361();refreshDate361()},{once:true});else{bindProfile361();refreshDate361()}
window.addEventListener('pageshow',bindProfile361);
})();
</script>


