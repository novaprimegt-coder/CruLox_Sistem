#adminOverlay .cc378-main{
  min-height:0;
  border:0;
  background:transparent;
  box-shadow:none;
  padding:0;
}
/* CRULOX V3.8.5 · Panel administrativo premium 37 módulos */
#adminOverlay{background:
  radial-gradient(circle at 12% 8%,rgba(0,224,255,.11),transparent 24%),
  radial-gradient(circle at 88% 18%,rgba(67,118,255,.10),transparent 22%),
  radial-gradient(circle at 55% 92%,rgba(0,255,184,.055),transparent 25%),
  linear-gradient(180deg,#020813 0%,#04121e 44%,#020812 100%)!important;
  color:#edfaff;overflow:auto;isolation:isolate}
#adminOverlay:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.20;
  background-image:linear-gradient(rgba(114,220,255,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(114,220,255,.028) 1px,transparent 1px);
  background-size:34px 34px;mask-image:linear-gradient(to bottom,black 0%,transparent 88%);}
#adminOverlay:after{content:"";position:absolute;inset:8% -10% auto -10%;height:280px;pointer-events:none;opacity:.22;
  background:radial-gradient(ellipse at center,rgba(0,220,255,.15),transparent 62%);filter:blur(24px);}
#adminOverlay .cc378-admin{position:relative;z-index:1;min-height:100dvh;padding:12px;display:flex;flex-direction:column;gap:11px}
#adminOverlay .cc378-bar{min-height:64px;padding:10px 12px;border-radius:18px;border:1px solid rgba(117,220,255,.12);
  background:linear-gradient(145deg,rgba(10,28,46,.92),rgba(4,16,28,.88));box-shadow:0 20px 55px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.04);
  display:flex;align-items:center;justify-content:space-between;gap:10px;backdrop-filter:blur(12px)}
#adminOverlay .cc378-brand{display:flex;align-items:center;gap:10px;min-width:0}
#adminOverlay .cc378-brand img{width:36px;height:36px;object-fit:contain;border-radius:9px;flex:0 0 36px;box-shadow:0 0 22px rgba(0,220,255,.10)}
#adminOverlay .cc378-brand b{display:block;font-size:.82rem;line-height:1.05;color:#fff;letter-spacing:-.02em}
#adminOverlay .cc378-brand span{display:block;margin-top:3px;font-size:.48rem;line-height:1.15;color:#7ccde8;letter-spacing:.10em;text-transform:uppercase}
#adminOverlay .cc378-actions{display:flex;align-items:center;gap:6px;flex:0 0 auto}
#adminOverlay .cc378-btn{min-height:34px;padding:0 11px;border-radius:11px;border:1px solid rgba(127,222,255,.14);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));color:#edfaff;font-size:.56rem;font-weight:900;cursor:pointer;touch-action:manipulation;transition:transform .08s ease,border-color .12s ease,background .12s ease}
#adminOverlay .cc378-btn.primary{border-color:rgba(0,225,255,.30);color:#7df2ff;background:linear-gradient(180deg,rgba(0,219,255,.10),rgba(0,219,255,.04))}
#adminOverlay .cc378-btn:active{transform:scale(.98)}
#adminOverlay .cc378-main{min-height:0;border:0;background:transparent;box-shadow:none;padding:0}
#adminOverlay .cc378-nav{width:min(100%,1040px);margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-content:start}
#adminOverlay .cc378-nav button{position:relative;overflow:hidden;width:100%;min-height:142px;padding:18px 15px;border-radius:20px;border:1px solid rgba(126,221,255,.12);
  background:linear-gradient(145deg,rgba(10,33,51,.94) 0%,rgba(4,18,30,.96) 72%);color:#edfaff;
  display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:11px;text-align:left;font-size:.68rem;font-weight:900;line-height:1.2;cursor:pointer;touch-action:manipulation;
  transition:transform .12s ease,border-color .12s ease,box-shadow .12s ease,background .12s ease;
  box-shadow:0 16px 38px rgba(0,0,0,.26),inset 0 1px 0 rgba(255,255,255,.03)}
#adminOverlay .cc378-nav button:before{content:"";position:absolute;inset:auto -18% -48% auto;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(0,221,255,.12),transparent 68%);pointer-events:none}
#adminOverlay .cc378-nav button:after{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,rgba(0,226,255,.45),transparent);opacity:.65}
#adminOverlay .cc378-nav button:hover{transform:translateY(-3px);border-color:rgba(0,224,255,.34);box-shadow:0 20px 44px rgba(0,0,0,.34),0 0 0 1px rgba(0,224,255,.05)}
#adminOverlay .cc378-nav button:active{transform:translateY(-1px) scale(.995)}
#adminOverlay .cc378-nav-icon{width:56px;height:56px;border-radius:17px;display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(0,224,255,.16),rgba(72,111,255,.08));border:1px solid rgba(0,224,255,.20);color:#78f1ff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 0 24px rgba(0,216,255,.08)}
#adminOverlay .cc378-nav-icon svg{width:30px;height:30px;display:block;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round}
#adminOverlay .cc378-nav-index{position:absolute;right:12px;top:11px;font-size:.44rem;letter-spacing:.10em;color:#6f90a0;font-weight:900}
#adminOverlay .cc378-nav-label{position:relative;z-index:1;font-size:.74rem;line-height:1.15;letter-spacing:-.01em}
#adminOverlay .cc378-nav-sub{position:relative;z-index:1;color:#7d9bab;font-size:.47rem;font-weight:700;line-height:1.35;max-width:92%}
#adminOverlay .cc378-nav button:nth-child(37){grid-column:1/-1;width:min(50%,500px);justify-self:center}
#adminOverlay .cc378-module-window{width:100%;min-height:calc(100dvh - 88px);box-sizing:border-box;padding:18px;border-radius:22px;border:1px solid rgba(126,221,255,.13);
  background:linear-gradient(145deg,rgba(8,29,47,.96),rgba(3,14,24,.99));box-shadow:0 24px 70px rgba(0,0,0,.36),inset 0 1px 0 rgba(255,255,255,.035)}
#adminOverlay .cc378-module-head{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid rgba(89,190,225,.10)}
#adminOverlay .cc378-back{width:42px;height:42px;flex:0 0 42px;border-radius:13px;border:1px solid rgba(89,190,225,.17);background:rgba(255,255,255,.025);color:#8feaf5;display:grid;place-items:center;font-size:1.05rem;font-weight:900;cursor:pointer;touch-action:manipulation}
#adminOverlay .cc378-module-id{display:flex;align-items:center;gap:10px;min-width:0}
#adminOverlay .cc378-module-icon{width:48px;height:48px;flex:0 0 48px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,rgba(0,224,255,.16),rgba(72,111,255,.08));border:1px solid rgba(0,224,255,.20);color:#78f1ff;box-shadow:0 0 26px rgba(0,216,255,.08)}
#adminOverlay .cc378-module-icon svg{width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round}
#adminOverlay .cc378-module-id h1{margin:0;color:#fff;font-size:1.02rem;line-height:1.12}
#adminOverlay .cc378-module-id p{margin:4px 0 0;color:#88a9b9;font-size:.52rem;line-height:1.4}
#adminOverlay .cc378-module-body{margin-top:14px;min-height:calc(100dvh - 182px);padding:16px;border-radius:16px;border:1px solid rgba(89,190,225,.09);background:linear-gradient(160deg,rgba(255,255,255,.020),rgba(255,255,255,.008));display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
#adminOverlay .cc378-module-body .cc378-module-placeholder{max-width:540px}
