<script id="jmv362-compact-internal-script">
(()=>{
'use strict';
const D=document;
const FOLLOW_CART_KEY='jm_digital_v362_cart_followup';
const INTERNAL_CHANNEL='Plataforma CRULOX';
const originalWindowOpen362=window.open.bind(window);
const esc362=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const read362=(k,f)=>{try{const r=localStorage.getItem(k);return r?JSON.parse(r):f}catch(e){return f}};
const write362=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v));return true}catch(e){return false}};
const notify362=(m,t='info')=>{try{if(typeof toast==='function')toast(m,t)}catch(e){}};
const user362=()=>{try{return typeof currentUser==='function'?currentUser():null}catch(e){return null}};
const phoneDigits362=v=>String(v||'').replace(/\D/g,'');
const isWaUrl362=url=>/^(?:https?:\/\/)?(?:wa\.me|api\.whatsapp\.com|web\.whatsapp\.com|whatsapp\.com)\b/i.test(String(url||'').replace(/^https?:\/\//i,''))||/wa\.me\//i.test(String(url||''));
function openFollowupWhatsapp362(phone,message){
  const digits=phoneDigits362(phone);if(!digits){notify362('Este cliente no tiene un teléfono válido para seguimiento.','warn');return false}
  const url=`https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
  const w=originalWindowOpen362(url,'_blank','noopener,noreferrer');if(w){try{w.opener=null}catch(e){}}return !!w;
}
/* Bloquea cualquier uso heredado de WhatsApp fuera del centro autorizado. */
window.open=function(url,...args){
  if(isWaUrl362(url)){notify362('WhatsApp está reservado únicamente para recordatorios de renovación y seguimiento comercial autorizado.','warn');return null}
  return originalWindowOpen362(url,...args);
};

function normalizeInternalOrders362(){
  let changed=false;
  for(const o of state?.orders||[]){
    o.fulfillment=o.fulfillment||{};
    if(o.fulfillment.channel!==INTERNAL_CHANNEL){o.fulfillment.channel=INTERNAL_CHANNEL;changed=true}
    if(o.digital&&o.digital.channel!==INTERNAL_CHANNEL){o.digital.channel=INTERNAL_CHANNEL;changed=true}
  }
  if(changed){try{if(typeof write==='function')write(KEYS.orders,state.orders);else write362((KEYS?.orders)||'jm_digital_orders',state.orders)}catch(e){}}
}
function patchPublic362(){
  const hero=D.getElementById('heroSupport');if(hero)hero.textContent='Abrir chat';
  const footer=D.getElementById('footerSupport');if(footer)footer.textContent='💬 Chat interno';
  const mail=D.getElementById('footerEmail');if(mail){mail.textContent='🔔 Atención dentro de la plataforma';mail.removeAttribute('href')}
  const float=D.getElementById('floatSupport');if(float)float.setAttribute('aria-label','Chat interno');
  D.querySelectorAll('[data-social-support]').forEach(el=>el.remove());
}
function patchAccountLabels362(){
  D.querySelectorAll('#accountModal label').forEach(l=>{if(/WhatsApp\s*\/\s*tel[eé]fono/i.test(l.textContent||''))l.childNodes.forEach?.(()=>{}),l.innerHTML=l.innerHTML.replace(/WhatsApp\s*\/\s*tel[eé]fono/ig,'Teléfono de contacto')});
  D.querySelectorAll('#accountModal .profile-info small').forEach(s=>{if(/WhatsApp/i.test(s.textContent||''))s.textContent='Teléfono de contacto'});
}
const previousAccountFields362=window.accountFields;
if(typeof previousAccountFields362==='function'){
  window.accountFields=function(){return previousAccountFields362().map(f=>f.key==='phone'?{...f,label:'Teléfono de contacto'}:f)};
  try{accountFields=window.accountFields}catch(e){}
}
const previousRenderAccount362=window.renderAccount;
if(typeof previousRenderAccount362==='function'){
  window.renderAccount=function(){const r=previousRenderAccount362.apply(this,arguments);setTimeout(patchAccountLabels362,0);return r};
  try{renderAccount=window.renderAccount}catch(e){}
}

function patchCheckout362(){
  const method=D.getElementById('jmv2PaymentMethod');
  if(method){
    [...method.options].filter(o=>/WhatsApp/i.test(o.textContent||o.value||'')).forEach(o=>o.remove());
    if(!method.options.length){const o=D.createElement('option');o.value='Pago registrado en plataforma';o.textContent='Pago registrado en plataforma';method.appendChild(o)}
    if(/WhatsApp/i.test(method.value||''))method.selectedIndex=0;
  }
  const channel=D.getElementById('jmv2DeliveryChannel');
  if(channel){channel.innerHTML=`<option>${INTERNAL_CHANNEL}</option>`;channel.value=INTERNAL_CHANNEL;const label=channel.closest('.field')?.querySelector('label');if(label)label.textContent='Entrega y seguimiento'}
  const old=D.getElementById('coDigitalChannel');
  if(old){old.innerHTML=`<option>${INTERNAL_CHANNEL}</option>`;old.value=INTERNAL_CHANNEL;const label=old.closest('.field')?.querySelector('label');if(label)label.textContent='Entrega y seguimiento'}
  const summary=D.querySelector('#checkoutModal .jmv2-checkout-summary p');if(summary)summary.textContent=summary.textContent.replace(/No solicitamos dirección física\.?/i,'Toda la gestión, confirmación y entrega se realiza dentro de la plataforma.');
}
const previousOpenCheckout362=window.openCheckout;
if(typeof previousOpenCheckout362==='function'){
  window.openCheckout=function(){const r=previousOpenCheckout362.apply(this,arguments);setTimeout(patchCheckout362,20);return r};
  try{openCheckout=window.openCheckout}catch(e){}
  const btn=D.getElementById('checkoutBtn');if(btn)btn.onclick=window.openCheckout;
}
D.addEventListener('submit',e=>{if(e.target?.id==='checkoutForm')setTimeout(()=>{normalizeInternalOrders362();syncCartFollowup362()},120)},true);

/* Registro local de carrito por usuario para seguimiento. En producción pasará a Supabase. */
function cartRegistry362(){const v=read362(FOLLOW_CART_KEY,{});return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}
function syncCartFollowup362(){
  const u=user362();if(!u?.id)return;
  const reg=cartRegistry362();const items=Array.isArray(state?.cart)?state.cart:[];
  if(!items.length){delete reg[String(u.id)];write362(FOLLOW_CART_KEY,reg);return}
  const names=items.map(ci=>{const p=(state.products||[]).find(x=>String(x.id)===String(ci.id));return p?`${p.name} ×${Number(ci.qty||1)}`:null}).filter(Boolean);
  reg[String(u.id)]={userId:u.id,name:u.fullName||u.username||'Cliente',phone:u.phone||'',items:names,updatedAt:new Date().toISOString()};write362(FOLLOW_CART_KEY,reg);
}
const previousAddToCart362=window.addToCart;
if(typeof previousAddToCart362==='function'){
  window.addToCart=function(){const r=previousAddToCart362.apply(this,arguments);setTimeout(syncCartFollowup362,20);return r};
  try{addToCart=window.addToCart}catch(e){}
}
D.addEventListener('click',e=>{if(e.target?.closest?.('[data-cart-dec],[data-cart-inc],[data-cart-remove],[data-add],#detailAdd,#checkoutBtn'))setTimeout(syncCartFollowup362,80)},true);
window.addEventListener('pagehide',syncCartFollowup362);

function userById362(id){return (state.users||[]).find(u=>String(u.id)===String(id))||null}
function expirationLeads362(){
  const now=new Date();now.setHours(0,0,0,0);const max=new Date(now);max.setDate(max.getDate()+7);const min=new Date(now);min.setDate(min.getDate()-2);
  const rows=[];
  for(const o of state.orders||[]){if(o?.customerDelivery?.confirmed!==true)continue;const items=Array.isArray(o.customerDelivery.items)?o.customerDelivery.items:[];(o.items||[]).forEach((item,i)=>{const cut=items[i]?.cutoffDate;if(!cut)return;const d=new Date(`${cut}T12:00:00`);if(Number.isNaN(d.getTime())||d<min||d>max)return;const days=Math.ceil((d-now)/86400000);rows.push({kind:'expiration',name:o.customer?.fullName||'Cliente',phone:o.customer?.phone||'',orderId:o.id,product:item.name||'Servicio',cutoff:cut,days})})}
  return rows.sort((a,b)=>a.days-b.days);
}
function cartLeads362(){return Object.values(cartRegistry362()).filter(x=>phoneDigits362(x.phone)).map(x=>({...x,kind:'cart'})).sort((a,b)=>Date.parse(b.updatedAt||0)-Date.parse(a.updatedAt||0))}
function registeredLeads362(){
  const hasOrders=new Set((state.orders||[]).map(o=>String(o.userId||'')));
  return (state.users||[]).filter(u=>!hasOrders.has(String(u.id))&&phoneDigits362(u.phone)).map(u=>({kind:'registered',name:u.fullName||u.username||'Cliente',phone:u.phone,userId:u.id,createdAt:u.createdAt}));
}
function unpaidLeads362(){
  return (state.orders||[]).filter(o=>{
    const receipt=!!o.payment?.receiptDataUrl;const paid=['Confirmado','Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(o.payment?.status)||['Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(o.status);
    return !paid&&!receipt&&(o.status==='Pago pendiente'||o.payment?.status==='Pendiente'||o.payment?.status==null);
  }).map(o=>({kind:'unpaid',name:o.customer?.fullName||'Cliente',phone:o.customer?.phone||'',orderId:o.id,total:o.total,createdAt:o.createdAt})).filter(x=>phoneDigits362(x.phone));
}
function followMessage362(x){
  if(x.kind==='expiration')return `Hola ${x.name}. Tu servicio ${x.product} ${x.days<0?'finalizó':x.days===0?'finaliza hoy':`finaliza el ${new Date(`${x.cutoff}T12:00:00`).toLocaleDateString('es-GT')}`}. Si deseas renovarlo, ingresa nuevamente a CRULOX y realiza tu compra desde la plataforma.`;
  if(x.kind==='cart')return `Hola ${x.name}. Tienes productos pendientes en tu carrito de CRULOX${x.items?.length?`: ${x.items.join(', ')}`:''}. Si aún te interesan, puedes regresar a la plataforma para completar la compra.`;
  if(x.kind==='registered')return `Hola ${x.name}. Tu cuenta de CRULOX ya está lista. Puedes ingresar a la plataforma y revisar los servicios disponibles cuando quieras.`;
  return `Hola ${x.name}. Tu pedido ${x.orderId} continúa pendiente de pago. Ingresa a CRULOX para completar el pago y subir tu comprobante dentro de la plataforma.`;
}
function followRows362(list){return list.length?`<div class="jmv362-follow-list">${list.slice(0,20).map((x,i)=>`<div class="jmv362-follow-row"><div><b>${esc362(x.name)}${x.product?` · ${esc362(x.product)}`:''}</b><span>${x.orderId?esc362(x.orderId):x.items?.length?esc362(x.items.join(' · ')):x.kind==='registered'?'Cuenta registrada sin compra':x.kind==='expiration'?esc362(x.cutoff):''}</span></div><button class="jmv362-wa-btn" type="button" data-jmv362-wa="${esc362(x.kind)}:${i}">Enviar recordatorio</button></div>`).join('')}</div>`:'<div class="jmv362-empty">No hay personas en este grupo.</div>'}
function renderFollowupCenter362(){
  const c=D.getElementById('adminContent');if(!c)return;
  const exp=expirationLeads362(),cart=cartLeads362(),reg=registeredLeads362(),unpaid=unpaidLeads362();
  window.JM_V362_FOLLOW_GROUPS={expiration:exp,cart,registered:reg,unpaid};
  c.innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Control interno y seguimientos</h2><p>Pedidos, pagos, comprobantes, accesos y entregas se gestionan únicamente dentro de CRULOX.</p></div></div><div class="jmv362-policy"><b>WhatsApp se reserva únicamente para cuatro seguimientos:</b> renovación por vencimiento, carrito pendiente, cuenta registrada sin compra y pedido pendiente de pago. No se usa para confirmar pedidos, entregar accesos, soporte normal ni administrar compras.</div><div class="jmv362-follow-grid"><article class="jmv362-follow-card"><h3>Renovaciones próximas</h3><strong>${exp.length}</strong><p>Servicios con fecha de corte dentro de los próximos 7 días.</p>${followRows362(exp)}</article><article class="jmv362-follow-card"><h3>Carritos pendientes</h3><strong>${cart.length}</strong><p>Usuarios registrados que dejaron productos en su carrito.</p>${followRows362(cart)}</article><article class="jmv362-follow-card"><h3>Registrados sin compra</h3><strong>${reg.length}</strong><p>Cuentas creadas que todavía no tienen pedidos.</p>${followRows362(reg)}</article><article class="jmv362-follow-card"><h3>Pedidos sin pago</h3><strong>${unpaid.length}</strong><p>Pedidos sin pago confirmado ni comprobante cargado.</p>${followRows362(unpaid)}</article></div></section>`;
  c.querySelectorAll('[data-jmv362-wa]').forEach(b=>b.onclick=()=>{const [kind,idx]=String(b.dataset.jmv362Wa).split(':');const x=window.JM_V362_FOLLOW_GROUPS?.[kind]?.[Number(idx)];if(x)openFollowupWhatsapp362(x.phone,followMessage362(x))});
  setTimeout(()=>{try{window.JM_DIGITAL_STORE_V352?.injectBotManagement?.()}catch(e){}},20);
}

function patchAdminSection362(section){
  const s=String(section||state.adminSection||'').toLowerCase();
  if(s==='messages'){renderFollowupCenter362();return}
  const c=D.getElementById('adminContent');if(!c)return;
  c.querySelectorAll('[data-v2waorder],[data-v2clientwa],#jmv2OpenWA').forEach(el=>el.remove());
  if(s==='clients'){
    c.querySelectorAll('th').forEach(th=>{if(/WhatsApp/i.test(th.textContent||''))th.textContent='Teléfono'});
  }
  if(s==='settings'){
    const phone=D.getElementById('jmv2SetPhone');if(phone){const label=phone.closest('.jmv2-field')?.querySelector('label');if(label)label.textContent='WhatsApp para recordatorios';const note=D.createElement('small');note.textContent='Solo renovaciones, carritos pendientes, registros sin compra y pedidos sin pago.';note.style.cssText='font-size:.40rem;color:var(--muted);line-height:1.25';if(!phone.parentElement.querySelector('[data-jmv362-phone-note]')){note.dataset.jmv362PhoneNote='1';phone.after(note)}}
    const form=D.getElementById('jmv2SettingsForm');if(form&&!form.dataset.jmv362Bound){form.dataset.jmv362Bound='1';form.addEventListener('submit',()=>setTimeout(()=>{state.settings.supportBotUrl='#';state.settings.orderBotUrl='#';try{if(typeof write==='function')write(KEYS.settings,state.settings)}catch(e){}},30))}
  }
}
const apiV2=window.JM_DIGITAL_STORE_V2;
if(apiV2?.renderAdmin){const old=apiV2.renderAdmin;apiV2.renderAdmin=function(section){const r=old.apply(this,arguments);setTimeout(()=>patchAdminSection362(section),15);return r}}
D.addEventListener('click',e=>{const b=e.target?.closest?.('[data-jmv2-section],[data-jmv361-go]');const s=b?.dataset?.jmv2Section||b?.dataset?.jmv361Go;if(s)setTimeout(()=>patchAdminSection362(s),70)},true);

function enforceNoWhatsApp362(){
  patchPublic362();patchAccountLabels362();normalizeInternalOrders362();
  state.settings.supportBotUrl='#';state.settings.orderBotUrl='#';
  try{if(typeof write==='function')write(KEYS.settings,state.settings)}catch(e){}
  D.querySelectorAll('a[href*="wa.me"],a[href*="whatsapp.com"]').forEach(a=>{a.removeAttribute('href');a.dataset.jmv362Blocked='1'});
}
function init362(){enforceNoWhatsApp362();syncCartFollowup362();setTimeout(()=>patchAdminSection362(state.adminSection),100)}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init362,{once:true});else init362();
window.addEventListener('pageshow',()=>{enforceNoWhatsApp362();syncCartFollowup362()});
window.JM_DIGITAL_STORE_V362={VERSION:'3.6.2',INTERNAL_CHANNEL,renderFollowupCenter:renderFollowupCenter362,syncCartFollowup:syncCartFollowup362};
})();
</script>
<style id="jmv363-style-refine-sections">
/* ================================================================
   CRUZCLICK · V3.6.3
   Refinamiento visual puntual: inicio, pedidos y clientes
   ================================================================ */
#adminOverlay.jmv363-ui .jmv360-topbar{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:8px!important;
  padding:8px 10px!important;
  border-radius:15px!important;
  min-height:auto!important;
}
#adminOverlay.jmv363-ui .jmv360-brand{min-width:0!important;gap:8px!important;align-items:center!important}
#adminOverlay.jmv363-ui .jmv360-brand img{width:31px!important;height:31px!important;flex:0 0 31px!important}
#adminOverlay.jmv363-ui .jmv360-brand b{font-size:.67rem!important;line-height:1.05!important}
#adminOverlay.jmv363-ui .jmv360-brand span{font-size:.49rem!important;line-height:1.15!important}
#adminOverlay.jmv363-ui .jmv360-top-actions{gap:6px!important;justify-self:end!important;display:flex!important;flex-wrap:wrap!important;justify-content:flex-end!important}
#adminOverlay.jmv363-ui .jmv360-action-btn{min-height:34px!important;padding:0 11px!important;border-radius:11px!important;font-size:.54rem!important;gap:5px!important}
#adminOverlay.jmv363-ui .jmv360-action-btn i{font-size:.76rem!important}
#adminOverlay.jmv363-ui .jmv360-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important;padding:6px!important;gap:6px!important;border-radius:14px!important}
#adminOverlay.jmv363-ui .jmv360-nav button{min-height:54px!important;padding:6px 5px!important;border-radius:12px!important;gap:4px!important;font-size:.50rem!important}
#adminOverlay.jmv363-ui .jmv360-nav button i{font-size:.86rem!important}
#adminOverlay.jmv363-ui .jmv360-page-head{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;align-items:center!important;gap:8px!important;padding:9px 10px!important;border-radius:15px!important}
#adminOverlay.jmv363-ui .jmv360-page-head small{font-size:.42rem!important;letter-spacing:.14em!important}
#adminOverlay.jmv363-ui .jmv360-page-head h1{font-size:1.05rem!important;line-height:1.03!important;margin:2px 0 1px!important}
#adminOverlay.jmv363-ui .jmv360-page-head p{font-size:.52rem!important;line-height:1.25!important;max-width:340px!important}
#adminOverlay.jmv363-ui .jmv360-date{min-width:126px!important;padding:7px 8px!important;border-radius:12px!important;gap:6px!important}
#adminOverlay.jmv363-ui .jmv360-date i{width:26px!important;height:26px!important;font-size:.72rem!important}
#adminOverlay.jmv363-ui .jmv360-date b{font-size:.54rem!important}
#adminOverlay.jmv363-ui .jmv360-date span{font-size:.47rem!important}
#adminOverlay.jmv363-ui .jmv360-main{gap:7px!important}
#adminOverlay.jmv363-ui .jmv360-hero,#adminOverlay.jmv363-ui .jmv363-hero{position:relative!important;overflow:hidden!important;display:grid!important;grid-template-columns:minmax(0,1fr) 96px!important;align-items:center!important;gap:10px!important;padding:12px!important;border-radius:16px!important;min-height:auto!important;background:radial-gradient(circle at 80% 32%, rgba(34,223,243,.16), transparent 34%),linear-gradient(145deg, rgba(9,27,42,.96), rgba(3,15,26,.96))!important}
#adminOverlay.jmv363-ui .jmv360-hero-copy h2{font-size:.78rem!important;line-height:1.08!important;margin:0!important}
#adminOverlay.jmv363-ui .jmv360-hero-copy .accent{font-size:1.15rem!important;line-height:1.02!important;margin-top:3px!important}
#adminOverlay.jmv363-ui .jmv360-hero-copy p{font-size:.53rem!important;line-height:1.34!important;margin-top:7px!important;max-width:none!important}
#adminOverlay.jmv363-ui .jmv360-hero-badge{top:10px!important;right:10px!important;left:auto!important;min-width:58px!important;padding:5px 7px!important;font-size:.42rem!important;border-radius:999px!important}
#adminOverlay.jmv363-ui .jmv360-hero-visual{gap:6px!important;justify-items:center!important}
#adminOverlay.jmv363-ui .jmv360-hero-visual img{width:68px!important}
#adminOverlay.jmv363-ui .jmv360-hero-points{font-size:.37rem!important;gap:1px!important;text-align:center!important;justify-items:center!important}
#adminOverlay.jmv363-ui .jmv360-hero-line{width:36px!important;height:4px!important}
#adminOverlay.jmv363-ui .jmv363-hero-mini{display:flex!important;flex-wrap:wrap!important;gap:5px!important;margin-top:8px!important}
#adminOverlay.jmv363-ui .jmv363-hero-mini span{display:inline-flex!important;align-items:center!important;min-height:22px!important;padding:0 8px!important;border-radius:999px!important;font-size:.46rem!important;font-weight:800!important;letter-spacing:.04em!important;color:#bff7ff!important;border:1px solid rgba(109,226,247,.18)!important;background:rgba(255,255,255,.03)!important}
#adminOverlay.jmv363-ui .jmv360-section-head{align-items:flex-end!important;gap:7px!important}
#adminOverlay.jmv363-ui .jmv360-section-head h3{font-size:.70rem!important;gap:5px!important}
#adminOverlay.jmv363-ui .jmv360-section-head p{font-size:.48rem!important;margin-top:2px!important}
#adminOverlay.jmv363-ui .jmv360-link-btn{min-height:30px!important;padding:0 11px!important;border-radius:10px!important;font-size:.49rem!important}
#adminOverlay.jmv363-ui .jmv2-admin-card{padding:9px!important;border-radius:13px!important;border-color:rgba(104,223,241,.11)!important;background:linear-gradient(180deg, rgba(6,24,37,.90), rgba(4,17,28,.92))!important;box-shadow:0 10px 24px rgba(0,0,0,.18)!important}
#adminOverlay.jmv363-ui .jmv2-card-head{gap:7px!important;margin-bottom:8px!important}
#adminOverlay.jmv363-ui .jmv2-card-head h2{font-size:.66rem!important;line-height:1.15!important}
#adminOverlay.jmv363-ui .jmv2-card-head p{font-size:.47rem!important;line-height:1.35!important;margin-top:2px!important;color:#8ea9ba!important}
#adminOverlay.jmv363-ui .jmv2-toolbar{display:grid!important;grid-template-columns:minmax(0,1fr) 110px!important;gap:6px!important;width:100%!important}
#adminOverlay.jmv363-ui .jmv2-toolbar input,#adminOverlay.jmv363-ui .jmv2-toolbar select,#adminOverlay.jmv363-ui .jmv2-admin-card input,#adminOverlay.jmv363-ui .jmv2-admin-card select,#adminOverlay.jmv363-ui .jmv2-admin-card textarea{min-height:30px!important;border-radius:10px!important;padding:5px 9px!important;font-size:.50rem!important;background:rgba(4,14,22,.95)!important;border-color:rgba(104,223,241,.12)!important}
#adminOverlay.jmv363-ui .jmv363-orders-panel .jmv2-records{gap:8px!important}
#adminOverlay.jmv363-ui .jmv363-order-card,#adminOverlay.jmv363-ui .jmv2-record{padding:9px!important;border-radius:13px!important;border:1px solid rgba(111,224,245,.12)!important;background:linear-gradient(180deg, rgba(9,29,43,.9), rgba(5,18,28,.92))!important;gap:8px!important}
#adminOverlay.jmv363-ui .jmv363-order-title,#adminOverlay.jmv363-ui .jmv2-record h3{font-size:.58rem!important;line-height:1.25!important;margin:0!important;color:#f4fbff!important}
#adminOverlay.jmv363-ui .jmv363-order-meta,#adminOverlay.jmv363-ui .jmv2-record p{font-size:.46rem!important;line-height:1.35!important;color:#93acbb!important;margin:2px 0 0!important}
#adminOverlay.jmv363-ui .jmv2-order-statusline{margin-top:6px!important;gap:5px!important}
#adminOverlay.jmv363-ui .jmv2-status{font-size:.43rem!important;padding:4px 7px!important;border-radius:999px!important}
#adminOverlay.jmv363-ui .jmv363-order-actions,#adminOverlay.jmv363-ui .jmv2-record aside{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important;align-self:stretch!important}
#adminOverlay.jmv363-ui .jmv2-record aside select{grid-column:1/-1!important}
#adminOverlay.jmv363-ui .jmv2-btn{min-height:30px!important;border-radius:10px!important;font-size:.48rem!important;padding:0 9px!important}
#adminOverlay.jmv363-ui .jmv2-note{font-size:.46rem!important;line-height:1.45!important;padding:8px 9px!important;border-radius:10px!important;background:rgba(255,255,255,.03)!important}
#adminOverlay.jmv363-ui .jmv363-empty-box{display:grid!important;justify-items:center!important;gap:6px!important;padding:16px 10px!important;border-radius:12px!important;border:1px dashed rgba(108,223,244,.18)!important;background:rgba(255,255,255,.018)!important;text-align:center!important}
#adminOverlay.jmv363-ui .jmv363-empty-icon{font-size:1rem!important;line-height:1!important;opacity:.9!important}
#adminOverlay.jmv363-ui .jmv363-empty-box b{font-size:.56rem!important;color:#eaf8ff!important}
#adminOverlay.jmv363-ui .jmv363-empty-box p{font-size:.47rem!important;color:#88a6b7!important;line-height:1.35!important;margin:0!important;max-width:280px!important}
#adminOverlay.jmv363-ui .jmv363-client-list{display:none;gap:7px;margin-top:8px}
#adminOverlay.jmv363-ui .jmv363-client-card{border:1px solid rgba(111,224,245,.12)!important;background:linear-gradient(180deg, rgba(9,28,42,.9), rgba(5,18,29,.92))!important;border-radius:13px!important;padding:9px!important;display:grid!important;gap:8px!important}
#adminOverlay.jmv363-ui .jmv363-client-top{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:8px!important}
#adminOverlay.jmv363-ui .jmv363-client-name{min-width:0!important;font-size:.56rem!important;line-height:1.2!important;color:#f4fbff!important}
#adminOverlay.jmv363-ui .jmv363-client-name b{display:block!important;font-size:.58rem!important;color:#f4fbff!important}
#adminOverlay.jmv363-ui .jmv363-client-name span{display:block!important;font-size:.44rem!important;color:#8eabbc!important;margin-top:2px!important}
#adminOverlay.jmv363-ui .jmv363-client-badge{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:22px!important;padding:0 8px!important;border-radius:999px!important;background:rgba(34,223,243,.11)!important;border:1px solid rgba(34,223,243,.18)!important;color:#aef7ff!important;font-size:.43rem!important;font-weight:900!important;white-space:nowrap!important}
#adminOverlay.jmv363-ui .jmv363-client-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px 8px!important}
#adminOverlay.jmv363-ui .jmv363-client-grid small{display:block!important;font-size:.40rem!important;text-transform:uppercase!important;letter-spacing:.08em!important;color:#7b98ab!important;margin-bottom:2px!important}
#adminOverlay.jmv363-ui .jmv363-client-grid b{display:block!important;font-size:.49rem!important;line-height:1.28!important;color:#ebf8ff!important;overflow-wrap:anywhere!important}
#adminOverlay.jmv363-ui .jmv363-clients-panel .jmv2-table-wrap{border-radius:11px!important;overflow:auto!important;background:rgba(0,0,0,.1)!important}
#adminOverlay.jmv363-ui .jmv363-clients-panel .jmv2-table th,#adminOverlay.jmv363-ui .jmv363-clients-panel .jmv2-table td{padding:6px 7px!important;font-size:.46rem!important}
#adminOverlay.jmv363-ui .jmv363-clients-panel .jmv2-table td b{font-size:.50rem!important}
@media(max-width:820px){#adminOverlay.jmv363-ui .jmv360-page-head{grid-template-columns:minmax(0,1fr) 126px!important}#adminOverlay.jmv363-ui .jmv360-hero{grid-template-columns:minmax(0,1fr) 82px!important;padding:11px!important}#adminOverlay.jmv363-ui .jmv360-hero-copy .accent{font-size:1.02rem!important}#adminOverlay.jmv363-ui .jmv360-hero-copy p{font-size:.50rem!important}#adminOverlay.jmv363-ui .jmv360-hero-visual img{width:60px!important}#adminOverlay.jmv363-ui .jmv2-toolbar{grid-template-columns:1fr!important}#adminOverlay.jmv363-ui .jmv363-client-list{display:grid!important}#adminOverlay.jmv363-ui .jmv363-clients-panel .jmv2-table-wrap{display:none!important}}
@media(max-width:560px){#adminOverlay.jmv363-ui .jmv360-page-head{grid-template-columns:minmax(0,1fr) 112px!important;padding:8px 9px!important}#adminOverlay.jmv363-ui .jmv360-page-head p{display:none!important}#adminOverlay.jmv363-ui .jmv360-date{min-width:112px!important;padding:6px 7px!important}#adminOverlay.jmv363-ui .jmv360-date i{display:none!important}#adminOverlay.jmv363-ui .jmv360-hero{grid-template-columns:minmax(0,1fr) 72px!important}#adminOverlay.jmv363-ui .jmv360-hero-copy h2{font-size:.70rem!important}#adminOverlay.jmv363-ui .jmv360-hero-copy .accent{font-size:.92rem!important}#adminOverlay.jmv363-ui .jmv360-hero-points{font-size:.34rem!important}#adminOverlay.jmv363-ui .jmv363-order-actions,#adminOverlay.jmv363-ui .jmv2-record aside{grid-template-columns:1fr 1fr!important}#adminOverlay.jmv363-ui .jmv363-client-grid{grid-template-columns:1fr 1fr!important}}
</style>
<script id="jmv363-script-refine-sections">
(function(){
  const D=document;let rafToken=null;
  function safe(v){return String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
  function overlay(){return D.getElementById('adminOverlay')}
  function addUiClass(){const ov=overlay();if(ov)ov.classList.add('jmv363-ui')}
  function enhanceEmpty(box,title,text,icon){if(!box||box.dataset.jmv363Empty==='1')return;box.dataset.jmv363Empty='1';box.innerHTML=`<div class="jmv363-empty-box"><span class="jmv363-empty-icon">${icon}</span><b>${title}</b><p>${text}</p></div>`}
  function enhanceHero(){const hero=D.querySelector('#adminContent .jmv360-hero');if(!hero)return;hero.classList.add('jmv363-hero');if(hero.dataset.jmv363Hero==='1')return;hero.dataset.jmv363Hero='1';const copy=hero.querySelector('.jmv360-hero-copy');if(copy&&!copy.querySelector('.jmv363-hero-mini')){const strip=D.createElement('div');strip.className='jmv363-hero-mini';strip.innerHTML='<span>Perfiles</span><span>Cursos</span><span>Diamantes</span><span>Licencias</span>';copy.appendChild(strip)}}
  function enhanceOrders(){const list=D.getElementById('jmv2OrderList');if(!list)return;const panel=list.closest('.jmv2-admin-card');if(panel)panel.classList.add('jmv363-orders-panel');const empty=list.querySelector('.jmv2-empty');if(empty)enhanceEmpty(empty,'No hay pedidos en este filtro','Ajusta la búsqueda o cambia el estado para localizar pedidos.','🧾');list.querySelectorAll('.jmv2-record').forEach(card=>{if(card.dataset.jmv363Order==='1')return;card.dataset.jmv363Order='1';card.classList.add('jmv363-order-card');const title=card.querySelector('h3');if(title)title.classList.add('jmv363-order-title');const meta=card.querySelector(':scope > div > p');if(meta){const div=D.createElement('div');div.className='jmv363-order-meta';div.textContent=(meta.textContent||'').trim();meta.replaceWith(div)}const aside=card.querySelector('aside');if(aside)aside.classList.add('jmv363-order-actions')})}
  function enhanceClients(){const panel=[...D.querySelectorAll('#adminContent .jmv2-admin-card')].find(el=>/Clientes digitales/i.test(el.querySelector('h2')?.textContent||''));if(!panel)return;panel.classList.add('jmv363-clients-panel');const empty=panel.querySelector('.jmv2-empty');if(empty)enhanceEmpty(empty,'No hay clientes registrados','Los clientes aparecerán aquí cuando se registren o realicen compras en la plataforma.','👥');const table=panel.querySelector('.jmv2-table');if(!table||panel.querySelector('.jmv363-client-list'))return;const rows=[...table.querySelectorAll('tbody tr')].filter(r=>!r.querySelector('.jmv2-empty'));const list=D.createElement('div');list.className='jmv363-client-list';if(!rows.length){list.innerHTML='<div class="jmv363-empty-box"><span class="jmv363-empty-icon">👥</span><b>No hay clientes registrados</b><p>Los clientes aparecerán aquí cuando se registren o realicen compras en la plataforma.</p></div>'}else{list.innerHTML=rows.map(row=>{const cells=row.querySelectorAll('td');if(cells.length<6)return '';const name=cells[0].innerHTML;const email=safe(cells[1].textContent.trim()||'—');const phone=safe(cells[2].textContent.trim()||'—');const orders=safe(cells[3].textContent.trim()||'0');const paid=safe(cells[4].textContent.trim()||'Q0.00');const last=safe(cells[5].textContent.trim()||'—');return `<article class="jmv363-client-card"><div class="jmv363-client-top"><div class="jmv363-client-name">${name}</div><span class="jmv363-client-badge">${orders} pedido${orders==='1'?'':'s'}</span></div><div class="jmv363-client-grid"><div><small>Correo</small><b>${email}</b></div><div><small>Teléfono</small><b>${phone}</b></div><div><small>Compras confirmadas</small><b>${paid}</b></div><div><small>Último pedido</small><b>${last}</b></div></div></article>`}).join('')}const wrap=panel.querySelector('.jmv2-table-wrap');if(wrap)wrap.after(list)}
  function apply(){addUiClass();enhanceHero();enhanceOrders();enhanceClients()}
  function queue(){if(rafToken)return;rafToken=requestAnimationFrame(()=>{rafToken=null;apply()})}
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',queue,{once:true});else queue();
  const queueIfAdmin363=()=>{if(overlay()?.classList.contains('open'))setTimeout(queue,0)};D.addEventListener('click',queueIfAdmin363,true);D.addEventListener('input',queueIfAdmin363,true);D.addEventListener('change',queueIfAdmin363,true);
  const mo=new MutationObserver(()=>queue());const adminWatchTarget=overlay()||D.getElementById('adminOverlay');if(adminWatchTarget)mo.observe(adminWatchTarget,{childList:true,subtree:true});window.addEventListener('pageshow',queue);
})();
</script>
<style id="jmv364-style-compact-total">
/* ================================================================
   CRUZCLICK · V3.6.4
   Compactación visual total y refinamiento de pedidos/clientes/typebots
   ================================================================ */
#adminOverlay .jmv360-admin-shell{padding:5px!important;gap:5px!important}
#adminOverlay .jmv360-topbar{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:8px!important;
  padding:7px 8px!important;
  border-radius:14px!important;
  min-height:auto!important;
}
#adminOverlay .jmv360-brand{gap:7px!important;min-width:0!important}
#adminOverlay .jmv360-brand img{width:28px!important;height:28px!important;flex:0 0 28px!important}
#adminOverlay .jmv360-brand b{font-size:.62rem!important;line-height:1.05!important}
#adminOverlay .jmv360-brand span{font-size:.44rem!important;line-height:1.15!important}
#adminOverlay .jmv360-top-actions{gap:6px!important;justify-self:end!important;display:flex!important;flex-wrap:wrap!important;justify-content:flex-end!important}
#adminOverlay .jmv360-action-btn{min-height:31px!important;padding:0 10px!important;border-radius:10px!important;font-size:.50rem!important;gap:5px!important;box-shadow:0 0 0 1px rgba(87,205,231,.1) inset!important}
#adminOverlay .jmv360-action-btn i{font-size:.70rem!important}
#adminOverlay .jmv360-nav{padding:5px!important;gap:5px!important;border-radius:13px!important;grid-template-columns:repeat(3,minmax(0,1fr))!important}
#adminOverlay .jmv360-nav button{min-height:50px!important;padding:5px 4px!important;border-radius:11px!important;gap:4px!important;font-size:.47rem!important}
#adminOverlay .jmv360-nav button i{font-size:.80rem!important}
#adminOverlay .jmv360-page-head{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:8px!important;
  padding:8px 9px!important;
  border-radius:14px!important;
  min-height:auto!important;
}
#adminOverlay .jmv360-page-head small{font-size:.40rem!important;letter-spacing:.15em!important}
#adminOverlay .jmv360-page-head h1{font-size:.94rem!important;line-height:1.02!important;margin:2px 0 1px!important}
#adminOverlay .jmv360-page-head p{font-size:.47rem!important;line-height:1.25!important;max-width:320px!important;margin-top:2px!important}
#adminOverlay .jmv360-date{min-width:116px!important;padding:6px 8px!important;border-radius:11px!important;gap:5px!important}
#adminOverlay .jmv360-date i{width:24px!important;height:24px!important;font-size:.66rem!important}
#adminOverlay .jmv360-date b{font-size:.50rem!important}
#adminOverlay .jmv360-date span{font-size:.44rem!important}
#adminOverlay .jmv360-main{gap:6px!important}
#adminOverlay .jmv360-hero{
  grid-template-columns:minmax(0,1fr) 84px!important;
  gap:9px!important;
  padding:10px!important;
  border-radius:15px!important;
  min-height:auto!important;
}
#adminOverlay .jmv360-hero-copy h2{font-size:.70rem!important;line-height:1.08!important;margin:0!important}
#adminOverlay .jmv360-hero-copy .accent{font-size:1.02rem!important;line-height:1.02!important;margin-top:3px!important}
#adminOverlay .jmv360-hero-copy p{font-size:.48rem!important;line-height:1.3!important;margin-top:6px!important}
#adminOverlay .jmv360-hero-badge{min-width:55px!important;padding:4px 6px!important;font-size:.40rem!important;top:9px!important;right:9px!important}
#adminOverlay .jmv360-hero-visual img{width:60px!important}
#adminOverlay .jmv360-hero-points{font-size:.34rem!important;gap:1px!important}
#adminOverlay .jmv360-hero-line{width:32px!important;height:4px!important}
#adminOverlay .jmv363-hero-mini{gap:4px!important;margin-top:7px!important}
#adminOverlay .jmv363-hero-mini span{min-height:20px!important;padding:0 7px!important;font-size:.42rem!important;border-radius:999px!important}
#adminOverlay .jmv360-section-head{align-items:flex-end!important;gap:6px!important}
#adminOverlay .jmv360-section-head h3{font-size:.66rem!important;gap:5px!important}
#adminOverlay .jmv360-section-head p{font-size:.45rem!important;margin-top:1px!important}
#adminOverlay .jmv360-link-btn{min-height:28px!important;padding:0 10px!important;border-radius:9px!important;font-size:.45rem!important}

#adminOverlay .jmv2-admin-content{padding:6px!important}
#adminOverlay .jmv2-admin-card{padding:8px!important;border-radius:12px!important;margin-top:6px!important;box-shadow:0 10px 22px rgba(0,0,0,.16)!important}
#adminOverlay .jmv2-card-head{gap:6px!important;margin-bottom:6px!important}
#adminOverlay .jmv2-card-head h2{font-size:.60rem!important;line-height:1.15!important}
#adminOverlay .jmv2-card-head p{font-size:.44rem!important;line-height:1.28!important;margin-top:2px!important}
#adminOverlay .jmv2-toolbar{display:grid!important;grid-template-columns:minmax(0,1fr) 96px!important;gap:5px!important}
#adminOverlay .jmv2-toolbar input,
#adminOverlay .jmv2-toolbar select,
#adminOverlay .jmv2-admin-card input,
#adminOverlay .jmv2-admin-card select,
#adminOverlay .jmv2-admin-card textarea{min-height:28px!important;border-radius:9px!important;padding:4px 8px!important;font-size:.46rem!important}
#adminOverlay .jmv2-field{gap:3px!important}
#adminOverlay .jmv2-field label{font-size:.42rem!important}
#adminOverlay .jmv2-field textarea{min-height:50px!important}
#adminOverlay .jmv2-form-grid{gap:5px!important}
#adminOverlay .jmv2-form-actions{gap:5px!important;margin-top:6px!important}
#adminOverlay .jmv2-btn{min-height:28px!important;padding:0 9px!important;border-radius:9px!important;font-size:.44rem!important;font-weight:800!important}
#adminOverlay .jmv2-note{font-size:.44rem!important;line-height:1.35!important;padding:7px 8px!important;border-radius:9px!important}
#adminOverlay .jmv2-empty{padding:8px!important;font-size:.41rem!important;border-radius:9px!important}

#adminOverlay .jmv363-orders-panel .jmv2-records{gap:7px!important}
#adminOverlay .jmv363-order-card,
#adminOverlay .jmv2-record{padding:8px!important;border-radius:12px!important;gap:7px!important}
#adminOverlay .jmv363-order-title,
#adminOverlay .jmv2-record h3{font-size:.54rem!important;line-height:1.22!important}
#adminOverlay .jmv363-order-meta,
#adminOverlay .jmv2-record p{font-size:.43rem!important;line-height:1.3!important;margin-top:1px!important}
#adminOverlay .jmv2-order-statusline{gap:4px!important;margin-top:4px!important}
#adminOverlay .jmv2-status{padding:3px 6px!important;font-size:.39rem!important;border-radius:999px!important}
#adminOverlay .jmv363-order-actions,
#adminOverlay .jmv2-record aside{gap:5px!important}
#adminOverlay .jmv2-record aside select{min-height:27px!important;padding:3px 6px!important;font-size:.42rem!important}
#adminOverlay .jmv363-empty-box{gap:5px!important;padding:13px 9px!important;border-radius:11px!important}
#adminOverlay .jmv363-empty-icon{font-size:.88rem!important}
#adminOverlay .jmv363-empty-box b{font-size:.52rem!important}
#adminOverlay .jmv363-empty-box p{font-size:.43rem!important;max-width:240px!important}

#adminOverlay .jmv363-client-list{gap:6px!important;margin-top:7px!important}
#adminOverlay .jmv363-client-card{padding:8px!important;border-radius:12px!important;gap:7px!important}
#adminOverlay .jmv363-client-top{gap:7px!important}
#adminOverlay .jmv363-client-name{font-size:.52rem!important;line-height:1.15!important}
#adminOverlay .jmv363-client-name b{font-size:.54rem!important}
#adminOverlay .jmv363-client-name span{font-size:.41rem!important;margin-top:1px!important}
#adminOverlay .jmv363-client-badge{min-height:21px!important;padding:0 7px!important;font-size:.40rem!important}
#adminOverlay .jmv363-client-grid{gap:6px 7px!important}
#adminOverlay .jmv363-client-grid small{font-size:.38rem!important;margin-bottom:1px!important}
#adminOverlay .jmv363-client-grid b{font-size:.46rem!important;line-height:1.24!important}
#adminOverlay .jmv363-clients-panel .jmv2-table th,
#adminOverlay .jmv363-clients-panel .jmv2-table td{padding:5px 6px!important;font-size:.43rem!important}
#adminOverlay .jmv363-clients-panel .jmv2-table td b{font-size:.46rem!important}

#adminOverlay .jmv352-bot-grid{gap:6px!important;margin-top:7px!important}
#adminOverlay .jmv352-bot-row{padding:8px!important;border-radius:10px!important;gap:7px!important}
#adminOverlay .jmv352-bot-row h3{font-size:.51rem!important;line-height:1.22!important}
#adminOverlay .jmv352-bot-row p{font-size:.40rem!important;line-height:1.28!important;margin-top:2px!important}
#adminOverlay .jmv352-bot-actions{gap:4px!important}
#adminOverlay .jmv352-bot-actions .jmv2-btn{min-height:27px!important;padding:0 8px!important;font-size:.42rem!important}
#adminOverlay .jmv352-bot-status{margin-top:4px!important;padding:2px 6px!important;font-size:.39rem!important}

#adminOverlay .jmv362-policy{padding:7px 8px!important;border-radius:10px!important;font-size:.42rem!important;line-height:1.32!important;margin-bottom:6px!important}
#adminOverlay .jmv362-follow-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
#adminOverlay .jmv362-follow-card{padding:7px!important;border-radius:10px!important}
#adminOverlay .jmv362-follow-card h3{font-size:.50rem!important;line-height:1.18!important}
