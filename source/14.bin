}
#adminOverlay .cc378-bar{
  min-height:52px;
  border-radius:14px;
  padding:8px 10px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  border:1px solid rgba(89,190,225,.13);
  background:linear-gradient(180deg,rgba(8,23,36,.94),rgba(5,16,27,.98));
  box-shadow:0 12px 30px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.025);
}
#adminOverlay .cc378-brand{display:flex;align-items:center;gap:8px;min-width:0}
#adminOverlay .cc378-brand img{width:30px;height:30px;object-fit:contain;border-radius:6px;flex:0 0 30px}
#adminOverlay .cc378-brand b{display:block;font-size:.72rem;line-height:1.05;color:#fff}
#adminOverlay .cc378-brand span{display:block;margin-top:1px;font-size:.45rem;line-height:1.15;color:#78cce9}
#adminOverlay .cc378-actions{display:flex;align-items:center;gap:5px;flex:0 0 auto}
#adminOverlay .cc378-btn{
  min-height:29px;
  padding:0 9px;
  border-radius:9px;
  border:1px solid rgba(89,190,225,.17);
  background:rgba(255,255,255,.022);
  color:#eef8ff;
  font-size:.53rem;
  font-weight:900;
  cursor:pointer;
  touch-action:manipulation;
}
