#adminOverlay .jmv352-bot-row p{font-size:.42rem!important}
#adminOverlay .jmv352-bot-status{font-size:.40rem!important}

/* Seguimiento WhatsApp: excepción controlada */
#adminOverlay .jmv362-policy{padding:8px 9px;border-radius:10px;border:1px solid rgba(34,223,243,.11);background:rgba(34,223,243,.035);font-size:.46rem;line-height:1.35;color:#a9bfcd;margin-bottom:7px}
#adminOverlay .jmv362-policy b{color:#e8f9ff}
#adminOverlay .jmv362-follow-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
