<style id="jmv365-style-ultra-compact-nav">
/* ================================================================
   CRUZCLICK · V3.6.5
   Reducción extra de botones, textos y navegación interna
   ================================================================ */
#adminOverlay .jmv360-admin-shell{padding:4px!important;gap:4px!important}
#adminOverlay .jmv360-topbar{padding:5px 6px!important;border-radius:13px!important;gap:7px!important}
#adminOverlay .jmv360-brand{gap:6px!important}
#adminOverlay .jmv360-brand img{width:24px!important;height:24px!important;flex:0 0 24px!important}
#adminOverlay .jmv360-brand b{font-size:.54rem!important;line-height:1.03!important}
