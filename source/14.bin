  #adminOverlay .jmv360-page-head p{display:none!important}
  #adminOverlay .jmv360-page-head h1{font-size:.82rem!important}
  #adminOverlay .jmv360-date{min-width:98px!important}
  #adminOverlay .jmv360-hero{grid-template-columns:minmax(0,1fr) 64px!important;gap:7px!important;padding:8px!important}
  #adminOverlay .jmv360-hero-copy h2{font-size:.64rem!important}
  #adminOverlay .jmv360-hero-copy .accent{font-size:.82rem!important}
  #adminOverlay .jmv360-hero-copy p{font-size:.42rem!important}
  #adminOverlay .jmv363-hero-mini span{font-size:.39rem!important;min-height:18px!important;padding:0 6px!important}
