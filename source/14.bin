.jmv2-form-grid{gap:6px!important}
.jmv2-field{gap:3px!important}
.jmv2-field label{font-size:.5rem!important}
.jmv2-field textarea{min-height:60px!important}
.jmv2-form-actions{gap:5px!important;margin-top:8px!important}

.jmv2-inline-stats{display:flex;flex-wrap:wrap;gap:4px;margin:2px 0 8px}
.jmv2-order-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.jmv2-order-topline strong{font-size:.66rem;color:var(--jmv2-cyan)}
.jmv2-order-details{margin-top:6px;border:1px solid rgba(128,211,237,.08);border-radius:9px;background:rgba(255,255,255,.018)}
.jmv2-order-details summary{list-style:none;cursor:pointer;padding:6px 8px;font-size:.52rem;font-weight:800;color:#c9d6dd}
.jmv2-order-details summary::-webkit-details-marker{display:none}
.jmv2-order-details[open] summary{border-bottom:1px solid rgba(128,211,237,.08)}
.jmv2-order-details .jmv2-order-details-body{padding:8px}
.jmv2-note{font-size:.5rem!important;line-height:1.3!important;padding:6px 7px!important;border-radius:8px!important;background:rgba(255,255,255,.024)}

.jmv2-client-grid{display:grid;gap:6px}
.jmv2-client-card{padding:8px;border:1px solid var(--jmv2-line);border-radius:11px;background:rgba(255,255,255,.018);display:grid;gap:7px}
.jmv2-client-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.jmv2-client-head h3{font-size:.62rem;line-height:1.2}
.jmv2-client-head p{font-size:.49rem;color:var(--muted);margin-top:2px}
.jmv2-client-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.jmv2-client-meta div{padding:6px 7px;border:1px solid rgba(128,211,237,.08);border-radius:9px;background:rgba(255,255,255,.014)}
.jmv2-client-meta small{display:block;font-size:.46rem;color:#87a0ad;text-transform:uppercase;letter-spacing:.04em}
.jmv2-client-meta b{display:block;font-size:.55rem;line-height:1.28;margin-top:2px}
.jmv2-client-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.jmv2-client-foot span{font-size:.49rem;color:var(--muted)}

.jmv2-settings-sections{display:grid;gap:8px}
.jmv2-settings-block{border:1px solid rgba(128,211,237,.09);border-radius:11px;background:rgba(255,255,255,.018);overflow:hidden}
.jmv2-settings-block summary{cursor:pointer;list-style:none;padding:9px 10px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-weight:900;font-size:.58rem;color:#ebf7ff}
.jmv2-settings-block summary::-webkit-details-marker{display:none}
.jmv2-settings-block summary span{display:block;font-size:.48rem;color:#8fa8b5;font-weight:700;margin-top:2px}
.jmv2-settings-body{padding:0 9px 9px}
.jmv2-settings-tip{padding:7px 8px;border:1px solid rgba(34,223,243,.1);border-radius:9px;background:rgba(34,223,243,.045);font-size:.5rem;line-height:1.35;color:#b8d7e5}

@media (max-width:980px){
  .jmv2-admin-shell{grid-template-columns:1fr!important}
  .jmv2-admin-side{padding:9px!important;border-right:0!important;border-bottom:1px solid var(--jmv2-line)!important}
  .jmv2-admin-brand{padding:4px 4px 8px!important;gap:7px!important}
  .jmv2-admin-nav{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin-top:8px!important}
  .jmv2-admin-nav button{padding:8px 6px!important;min-height:68px!important;font-size:.56rem!important;border-radius:12px!important;flex-direction:column!important;justify-content:center!important;gap:5px!important;text-align:center!important}
  .jmv2-admin-nav button i{width:auto!important;font-size:.95rem!important}
  .jmv2-admin-top{padding:7px 9px!important;min-height:48px!important}
  .jmv2-admin-top h1{font-size:.78rem!important}
  .jmv2-admin-actions button{padding:5px 9px!important;min-height:28px!important;font-size:.54rem!important}
  .jmv2-metrics{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .jmv2-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .jmv2-card-head{flex-direction:column!important;align-items:stretch!important}
  .jmv2-toolbar{width:100%!important}
  .jmv2-toolbar input,.jmv2-toolbar select{flex:1 1 140px!important;width:auto!important}
  .jmv2-record{grid-template-columns:1fr!important}
  .jmv2-record aside{max-width:none!important;justify-content:flex-start!important}
  .jmv2-client-meta{grid-template-columns:1fr 1fr!important}
  .jmv2-form-grid{grid-template-columns:1fr!important}
}
@media (max-width:640px){
  .jmv2-admin-content{padding:8px!important}
  .jmv2-admin-nav button{min-height:62px!important;font-size:.54rem!important}
  .jmv2-admin-nav button span{line-height:1.12!important}
  .jmv2-banner{padding:8px 9px!important}
  .jmv2-banner b{font-size:.58rem!important}
  .jmv2-banner p{font-size:.49rem!important}
  .jmv2-metric{padding:7px!important}
  .jmv2-card-head h2{font-size:.65rem!important}
  .jmv2-card-head p{font-size:.49rem!important}
  .jmv2-table{min-width:620px!important}
  .jmv2-client-meta{grid-template-columns:1fr!important}
}
</style>
<script id="cruzclick-v374-compact-admin-script">
(function(){
  const D=document;
  const byId=id=>D.getElementById(id);
  const qa=(s,r=D)=>Array.from(r.querySelectorAll(s));
  const say=(m,t='info')=>{try{if(typeof notify==='function')notify(m,t);else if(typeof toast==='function')toast(m,t);else console.log(m)}catch(e){console.log(m)}};
  const saveSettings374=()=>{try{if(typeof safeWrite==='function'&&window.KEYS?.settings)safeWrite(KEYS.settings,state.settings);else if(typeof write==='function'&&window.KEYS?.settings)write(KEYS.settings,state.settings);else localStorage.setItem((window.KEYS&&KEYS.settings)||'jm_digital_v1_settings',JSON.stringify(state.settings));}catch(e){console.warn('CRULOX V3.7.4 save settings',e)}};
  const num=(value,fallback,min=null,max=null)=>{let n=Number(value); if(!Number.isFinite(n)) n=Number(fallback); if(min!==null) n=Math.max(min,n); if(max!==null) n=Math.min(max,n); return n;};
  function ensureSettingDefaults374(){
    if(!window.state||!state.settings)return;
    Object.assign(state.settings,{
      storeName:String(state.settings.storeName||'CRULOX').trim()||'CRULOX',
      slogan:String(state.settings.slogan||'Plataformas Digitales').trim()||'Plataformas Digitales',
      subtitle:String(state.settings.subtitle||'Compra digital simple, segura y transparente.\nDe Guatemala al mundo: un marketplace confiable.').trim(),
      whatsappPhone:String(state.settings.whatsappPhone||'+502 30983655').trim()||'+502 30983655',
      socialHandle:String(state.settings.socialHandle||'crulox').trim()||'crulox',
      email:String(state.settings.email||'').trim(),
      currency:String(state.settings.currency||'Q').trim()||'Q',
      paymentMethods:String(state.settings.paymentMethods||'Banrural, Industrial, Azteca, PayPal, Remesas').trim()||'Banrural, Industrial, Azteca, PayPal, Remesas',
      paymentText:String(state.settings.paymentText||'').trim()||String(state.settings.paymentMethods||'').split(',').map(x=>x.trim()).filter(Boolean).join(' · '),
      lowStock:num(state.settings.lowStock,6,0),
      reservationHours:num(state.settings.reservationHours,6,1,72),
      defaultDeliveryEta:String(state.settings.defaultDeliveryEta||'20 - 30 min').trim()||'20 - 30 min',
      activationText:String(state.settings.activationText||'Activación o entrega digital coordinada').trim()||'Activación o entrega digital coordinada',
      digitalPolicy:String(state.settings.digitalPolicy||'No realizamos entregas físicas. Cada servicio indica sus datos requeridos, disponibilidad y forma de activación.').trim(),
      searchPlaceholder:String(state.settings.searchPlaceholder||'Buscar productos').trim()||'Buscar productos',
      supportButtonText:String(state.settings.supportButtonText||'Abrir chat').trim()||'Abrir chat',
      purchasesButtonText:String(state.settings.purchasesButtonText||'Mis compras').trim()||'Mis compras',
      renewalReminderDays:num(state.settings.renewalReminderDays,3,0,30),
      abandonedCartHours:num(state.settings.abandonedCartHours,12,0,168),
      noPurchaseReminderDays:num(state.settings.noPurchaseReminderDays,3,0,60),
      unpaidOrderHours:num(state.settings.unpaidOrderHours,6,0,168),
      shippingText:'Entrega 100% digital',
      returnText:'Condiciones según cada servicio digital'
    });
  }
  ensureSettingDefaults374();

  const previousApplySettings374=typeof window.applySettings==='function'?window.applySettings:null;
  window.applySettings=function(){
    if(previousApplySettings374){try{previousApplySettings374()}catch(e){console.warn('CRULOX V3.7.4 base applySettings',e)}}
    ensureSettingDefaults374();
    try{D.title=`${state.settings.storeName||'CRULOX'} · Tienda digital`}catch(e){}
    const subtitle=byId('heroSubtitle'); if(subtitle) subtitle.textContent=state.settings.subtitle||'';
    const support=byId('heroSupport'); if(support) support.textContent=state.settings.supportButtonText||'Abrir chat';
    const purchases=byId('jmMyPurchasesBtn'); if(purchases) purchases.textContent=state.settings.purchasesButtonText||'Mis compras';
    const search=byId('searchInput'); if(search) search.setAttribute('placeholder',state.settings.searchPlaceholder||'Buscar productos');
    qa('.hero-brand-slogan,.jm-brand-copy small').forEach(el=>{el.textContent=state.settings.slogan||'Plataformas Digitales'});
    qa('.jmv2-admin-brand b').forEach(el=>{el.textContent=state.settings.storeName||'CRULOX'});
    qa('.jmv2-admin-brand span').forEach(el=>{el.textContent=`Operación 100% digital · ${state.settings.slogan||'Plataformas Digitales'}`});
  };
  try{applySettings=window.applySettings}catch(e){}

  function refreshEverything374(section=null){
    try{if(typeof renderStore==='function')renderStore(); else if(typeof applySettings==='function')applySettings()}catch(e){console.warn('CRULOX V3.7.4 renderStore',e)}
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    try{if(state?.session?.role==='admin' && byId('adminContent') && typeof window.renderAdminSection==='function')window.renderAdminSection(section||state.adminSection||'settings')}catch(e){console.warn('CRULOX V3.7.4 renderAdminSection',e)}
  }

  window.ordersAdminV2=function(){
    purgeExpiredReservations();
    $('adminContent').innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Pedidos digitales</h2><p>Vista compacta para revisar y mover pedidos más rápido.</p></div><div class="jmv2-toolbar"><input id="jmv2OrderSearch" placeholder="Buscar pedido, cliente o servicio"><select id="jmv2OrderStatus"><option value="all">Todos</option>${ORDER_STATUSES.map(s=>`<option>${s}</option>`).join('')}</select></div></div><div class="jmv2-inline-stats" id="jmv2OrderStats"></div><div class="jmv2-records" id="jmv2OrderList"></div></section>`;
    const draw=()=>{
      const term=String($('jmv2OrderSearch').value||'').toLowerCase();
      const st=$('jmv2OrderStatus').value;
      const all=Array.isArray(state.orders)?state.orders:[];
      const list=all.filter(o=>(st==='all'||o.status===st)&&(!term||`${o.id} ${o.customer?.fullName||''} ${o.customer?.phone||''} ${(o.items||[]).map(i=>i.name).join(' ')}`.toLowerCase().includes(term)));
      $('jmv2OrderStats').innerHTML=`<span class="jmv2-status">Mostrando ${list.length}</span><span class="jmv2-status warn">Pendientes ${all.filter(o=>!COMPLETE.has(o.status)&&!CANCELED.has(o.status)).length}</span><span class="jmv2-status ok">Pagados ${all.filter(o=>PAID.has(o.status)).length}</span>`;
      $('jmv2OrderList').innerHTML=list.map(o=>{
        const statusClass=CANCELED.has(o.status)?'bad':COMPLETE.has(o.status)?'ok':PAID.has(o.status)?'ok':'warn';
        const details=orderDataMarkup(o) || '<div style="font-size:.5rem;color:var(--muted)">Sin datos adicionales.</div>';
        return `<article class="jmv2-record"><div><div class="jmv2-order-topline"><div><h3>${esc2(o.id)} · ${esc2(o.customer?.fullName||'Cliente')}</h3><p>${esc2(new Date(o.createdAt).toLocaleString('es-GT'))} · ${esc2(o.payment?.method||'Pago por coordinar')} · ${esc2(o.fulfillment?.channel||'Interno')}</p></div><strong>${money2(o.total)}</strong></div><div class="jmv2-order-statusline"><span class="jmv2-status ${statusClass}">${esc2(o.status)}</span><span class="jmv2-status ${o.payment?.status==='Confirmado'?'ok':'warn'}">Pago: ${esc2(o.payment?.status||'Pendiente')}</span><span class="jmv2-status">Reserva: ${esc2(o.inventory?.reservationStatus||'legacy')}</span></div><details class="jmv2-order-details"><summary>Ver datos del pedido</summary><div class="jmv2-order-details-body">${details}${o.fulfillment?.note?`<div class="jmv2-note" style="margin-top:7px">Nota entrega: ${esc2(o.fulfillment.note)}</div>`:''}${o.notes?`<div class="jmv2-note" style="margin-top:7px">Nota interna: ${esc2(o.notes)}</div>`:''}</div></details></div><aside><select data-v2orderstatus="${esc2(o.id)}">${ORDER_STATUSES.map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select><button class="jmv2-btn" data-v2copyorder="${esc2(o.id)}">Copiar</button><button class="jmv2-btn green" data-v2waorder="${esc2(o.id)}">WhatsApp</button><button class="jmv2-btn" data-v2deliver="${esc2(o.id)}">Entrega</button><button class="jmv2-btn red" data-v2deleteorder="${esc2(o.id)}">Eliminar</button></aside></article>`
      }).join('')||'<div class="jmv2-empty">No hay pedidos en este filtro.</div>';
      qa('[data-v2orderstatus]',$('jmv2OrderList')).forEach(s=>s.onchange=()=>{const o=state.orders.find(x=>String(x.id)===String(s.dataset.v2orderstatus));if(!o)return;setOrderStatus(o,s.value);try{renderStore()}catch(e){}draw()});
      qa('[data-v2copyorder]',$('jmv2OrderList')).forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>String(x.id)===String(b.dataset.v2copyorder));try{await navigator.clipboard.writeText(orderMessageV2(o));say('Pedido copiado.','success')}catch(e){say('No se pudo copiar automáticamente.','warn')}});
      qa('[data-v2waorder]',$('jmv2OrderList')).forEach(b=>b.onclick=()=>{const o=state.orders.find(x=>String(x.id)===String(b.dataset.v2waorder));if(!o)return;const ph=String(o.customer?.phone||'').replace(/\D/g,'');const msg=customerStatusMessage(o);window.open(`https://wa.me/${ph}?text=${encodeURIComponent(msg)}`,'_blank','noopener,noreferrer')});
      qa('[data-v2deliver]',$('jmv2OrderList')).forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>String(x.id)===String(b.dataset.v2deliver));if(!o)return;let val=null;try{val=typeof npPrompt==='function'?await npPrompt('Nota interna de entrega (no guardes contraseñas permanentes)',o.fulfillment?.note||''):prompt('Nota interna',o.fulfillment?.note||'')}catch(e){}if(val===null)return;o.fulfillment=o.fulfillment||{};o.fulfillment.note=String(val).slice(0,600);o.updatedAt=nowIso();safeWrite(KEYS.orders,state.orders);draw()});
      qa('[data-v2deleteorder]',$('jmv2OrderList')).forEach(b=>b.onclick=async()=>{const o=state.orders.find(x=>String(x.id)===String(b.dataset.v2deleteorder));if(!o)return;let ok=true;try{if(typeof npConfirm==='function')ok=await npConfirm(`¿Eliminar ${o.id}?`)}catch(e){}if(!ok)return;if(o.inventory?.reservationStatus==='reserved'&&o.payment?.status!=='Confirmado')restoreReservation(o,'order-deleted');state.orders=state.orders.filter(x=>String(x.id)!==String(o.id));safeWrite(KEYS.orders,state.orders);safeWrite(KEYS.products,state.products);try{renderStore()}catch(e){}draw()});
    };
    draw();$('jmv2OrderSearch').oninput=draw;$('jmv2OrderStatus').onchange=draw;
  };
  try{ordersAdminV2=window.ordersAdminV2}catch(e){}

  window.clientsAdminV2=function(){
    const paid={};
    state.orders.filter(o=>o.payment?.status==='Confirmado'||PAID.has(o.status)).forEach(o=>paid[o.userId]=(paid[o.userId]||0)+Number(o.total||0));
    $('adminContent').innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Clientes digitales</h2><p>Listado compacto con datos útiles para seguimiento y soporte.</p></div><div class="jmv2-toolbar"><input id="jmv2ClientSearch" placeholder="Buscar cliente, correo o teléfono"></div></div><div class="jmv2-inline-stats"><span class="jmv2-status">${state.users.length} clientes</span><span class="jmv2-status ok">${state.orders.filter(o=>o.payment?.status==='Confirmado'||PAID.has(o.status)).length} compras confirmadas</span></div><div class="jmv2-client-grid" id="jmv2ClientList"></div></section>`;
    const draw=()=>{
      const term=String($('jmv2ClientSearch').value||'').toLowerCase().trim();
      const users=(Array.isArray(state.users)?state.users:[]).filter(u=>!term||`${u.fullName||''} ${u.username||''} ${u.email||''} ${u.phone||''}`.toLowerCase().includes(term));
      $('jmv2ClientList').innerHTML=users.map(u=>{
        const orders=state.orders.filter(o=>o.userId===u.id);
        const last=orders.slice().sort((a,b)=>Date.parse(b.createdAt)-Date.parse(a.createdAt))[0];
        return `<article class="jmv2-client-card"><div class="jmv2-client-head"><div><h3>${esc2(u.fullName||u.username||'—')}</h3><p>${esc2(u.username||'Sin alias')}</p></div><span class="jmv2-status">${orders.length} pedidos</span></div><div class="jmv2-client-meta"><div><small>Correo</small><b>${esc2(u.email||'—')}</b></div><div><small>Teléfono</small><b>${esc2(u.phone||'—')}</b></div><div><small>Compras confirmadas</small><b>${money2(paid[u.id]||0)}</b></div><div><small>Último pedido</small><b>${last?esc2(`${last.status} · ${new Date(last.createdAt).toLocaleDateString('es-GT')}`):'—'}</b></div></div><div class="jmv2-client-foot"><span>ID cliente: ${esc2(u.id||'—')}</span><button class="jmv2-btn green" data-v2clientwa="${esc2(u.id)}">WhatsApp</button></div></article>`;
      }).join('')||'<div class="jmv2-empty">No hay clientes para mostrar.</div>';
      qa('[data-v2clientwa]',$('jmv2ClientList')).forEach(b=>b.onclick=()=>{const u=state.users.find(x=>String(x.id)===String(b.dataset.v2clientwa));const ph=String(u?.phone||'').replace(/\D/g,'');window.open(`https://wa.me/${ph}`,'_blank','noopener,noreferrer')});
    };
    draw(); $('jmv2ClientSearch').oninput=draw;
  };
  try{clientsAdminV2=window.clientsAdminV2}catch(e){}

  window.settingsAdminV2=function(){
    ensureSettingDefaults374();
    $('adminContent').innerHTML=`<form class="jmv2-admin-card" id="jmv2SettingsForm" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Ajustes del negocio digital</h2><p>Cambios compactos con reflejo directo en la tienda y en el panel.</p></div></div><div class="jmv2-settings-sections"><details class="jmv2-settings-block" open><summary><div>Identidad pública<span>Marca, contacto y textos visibles</span></div><span>▾</span></summary><div class="jmv2-settings-body"><div class="jmv2-form-grid"><div class="jmv2-field"><label>Marca</label><input id="jmv2SetName" value="${esc2(state.settings.storeName||'CRULOX')}"></div><div class="jmv2-field"><label>Eslogan</label><input id="jmv2SetSlogan" value="${esc2(state.settings.slogan||'Plataformas Digitales')}"></div><div class="jmv2-field"><label>WhatsApp para recordatorios</label><input id="jmv2SetPhone" value="${esc2(state.settings.whatsappPhone||'+502 30983655')}"></div><div class="jmv2-field"><label>Correo</label><input id="jmv2SetEmail" type="email" value="${esc2(state.settings.email||'')}"></div><div class="jmv2-field"><label>Usuario de redes</label><input id="jmv2SetHandle" value="${esc2(state.settings.socialHandle||'crulox')}"></div><div class="jmv2-field"><label>Moneda</label><input id="jmv2SetCurrency" value="${esc2(state.settings.currency||'Q')}"></div><div class="jmv2-field full"><label>Descripción pública</label><textarea id="jmv2SetSubtitle">${esc2(state.settings.subtitle||'')}</textarea></div></div></div></details><details class="jmv2-settings-block" open><summary><div>Operación digital<span>Pagos, reservas y tiempos</span></div><span>▾</span></summary><div class="jmv2-settings-body"><div class="jmv2-form-grid"><div class="jmv2-field full"><label>Métodos de pago separados por coma</label><input id="jmv2SetPayments" value="${esc2(state.settings.paymentMethods||'')}"></div><div class="jmv2-field"><label>Alerta de cupos bajos</label><input id="jmv2SetLow" type="number" min="0" value="${Number(state.settings.lowStock||6)}"></div><div class="jmv2-field"><label>Horas de reserva de cupos</label><input id="jmv2SetReserve" type="number" min="1" max="72" value="${Number(state.settings.reservationHours||6)}"></div><div class="jmv2-field"><label>Entrega estimada por defecto</label><input id="jmv2SetEta" value="${esc2(state.settings.defaultDeliveryEta||'20 - 30 min')}"></div><div class="jmv2-field full"><label>Texto de activación</label><input id="jmv2SetActivation" value="${esc2(state.settings.activationText||'Activación o entrega digital coordinada')}"></div><div class="jmv2-field full"><label>Política de venta digital</label><textarea id="jmv2SetPolicy">${esc2(state.settings.digitalPolicy||'')}</textarea></div></div></div></details><details class="jmv2-settings-block" open><summary><div>Tienda y experiencia<span>Campos que sí se reflejan en la vista pública</span></div><span>▾</span></summary><div class="jmv2-settings-body"><div class="jmv2-form-grid"><div class="jmv2-field"><label>Texto botón principal</label><input id="jmv2SetSupportBtn" value="${esc2(state.settings.supportButtonText||'Abrir chat')}"></div><div class="jmv2-field"><label>Texto botón compras</label><input id="jmv2SetPurchasesBtn" value="${esc2(state.settings.purchasesButtonText||'Mis compras')}"></div><div class="jmv2-field full"><label>Placeholder de búsqueda</label><input id="jmv2SetSearchPlaceholder" value="${esc2(state.settings.searchPlaceholder||'Buscar productos')}"></div></div><div class="jmv2-settings-tip" style="margin-top:8px">Estos campos se actualizan de inmediato en la tienda: marca, eslogan, descripción, moneda, búsqueda y textos principales.</div></div></details><details class="jmv2-settings-block"><summary><div>Seguimientos útiles<span>Valores operativos para recordatorios y control</span></div><span>▾</span></summary><div class="jmv2-settings-body"><div class="jmv2-form-grid"><div class="jmv2-field"><label>Días previos para renovación</label><input id="jmv2SetRenewalDays" type="number" min="0" max="30" value="${Number(state.settings.renewalReminderDays||3)}"></div><div class="jmv2-field"><label>Horas para carrito pendiente</label><input id="jmv2SetCartHours" type="number" min="0" max="168" value="${Number(state.settings.abandonedCartHours||12)}"></div><div class="jmv2-field"><label>Días para registrado sin compra</label><input id="jmv2SetNoPurchaseDays" type="number" min="0" max="60" value="${Number(state.settings.noPurchaseReminderDays||3)}"></div><div class="jmv2-field"><label>Horas para pedido sin pago</label><input id="jmv2SetUnpaidHours" type="number" min="0" max="168" value="${Number(state.settings.unpaidOrderHours||6)}"></div></div><div class="jmv2-settings-tip" style="margin-top:8px">No inventé automatizaciones falsas. Estos valores quedan guardados para que el sistema y tus procesos usen criterios claros de seguimiento.</div></div></details></div><div class="jmv2-form-actions"><button class="jmv2-btn primary" type="submit">Guardar ajustes</button><button class="jmv2-btn" type="button" id="jmv2Backup">Exportar respaldo</button></div></form>`;
    $('jmv2SettingsForm').onsubmit=e=>{
      e.preventDefault();
      const methods=String($('jmv2SetPayments').value||'').trim();
      const phone=String($('jmv2SetPhone').value||'').trim()||'+502 30983655';
      Object.assign(state.settings,{
        businessModel:'digital-only',
        storeName:String($('jmv2SetName').value||'').trim()||'CRULOX',
        slogan:String($('jmv2SetSlogan').value||'').trim()||'Plataformas Digitales',
        whatsappPhone:phone,
        socialHandle:String($('jmv2SetHandle').value||'').trim()||'crulox',
        email:String($('jmv2SetEmail').value||'').trim(),
        currency:String($('jmv2SetCurrency').value||'').trim()||'Q',
        subtitle:String($('jmv2SetSubtitle').value||'').trim(),
        paymentMethods:methods,
        paymentText:methods.split(',').map(x=>x.trim()).filter(Boolean).join(' · '),
        lowStock:num($('jmv2SetLow').value,6,0),
        reservationHours:num($('jmv2SetReserve').value,6,1,72),
        defaultDeliveryEta:String($('jmv2SetEta').value||'').trim()||'20 - 30 min',
        activationText:String($('jmv2SetActivation').value||'').trim()||'Activación o entrega digital coordinada',
        digitalPolicy:String($('jmv2SetPolicy').value||'').trim(),
        searchPlaceholder:String($('jmv2SetSearchPlaceholder').value||'').trim()||'Buscar productos',
        supportButtonText:String($('jmv2SetSupportBtn').value||'').trim()||'Abrir chat',
        purchasesButtonText:String($('jmv2SetPurchasesBtn').value||'').trim()||'Mis compras',
        renewalReminderDays:num($('jmv2SetRenewalDays').value,3,0,30),
        abandonedCartHours:num($('jmv2SetCartHours').value,12,0,168),
        noPurchaseReminderDays:num($('jmv2SetNoPurchaseDays').value,3,0,60),
        unpaidOrderHours:num($('jmv2SetUnpaidHours').value,6,0,168),
        shippingText:'Entrega 100% digital',
        returnText:'Condiciones según cada servicio digital',
        supportBotUrl:`https://wa.me/${phone.replace(/\D/g,'')}`,
        orderBotUrl:`https://wa.me/${phone.replace(/\D/g,'')}`
      });
      saveSettings374();
      refreshEverything374('settings');
      say('Ajustes guardados y sincronizados.','success');
    };
    $('jmv2Backup').onclick=()=>{try{if(typeof exportBackup==='function')exportBackup();else say('La función de respaldo no está disponible.','warn')}catch(e){say('No se pudo crear el respaldo.','error')}};
  };
  try{settingsAdminV2=window.settingsAdminV2}catch(e){}

  if(D.readyState==='loading'){
    D.addEventListener('DOMContentLoaded',()=>{try{ensureSettingDefaults374(); if(typeof applySettings==='function')applySettings()}catch(e){}},{once:true});
  }else{
    try{ensureSettingDefaults374(); if(typeof applySettings==='function')applySettings()}catch(e){}
  }
  console.info('CRULOX · V3.7.4 compacto + ajustes sincronizados');
})();
</script>



<!-- CRULOX V3.7.5 · Compacto total para todas las funciones visibles -->
<style id="cruzclick-v375-compact-all-style">
.jmv2-banner{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:8px!important;align-items:center!important}
.jmv2-banner b{font-size:.60rem!important}
.jmv2-banner p{max-width:66ch!important}
.jmv2-quick-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
.jmv2-quick{display:grid!important;align-content:start!important;gap:3px!important;min-height:unset!important}
.jmv2-quick i,.jmv2-quick em{font-style:normal!important}
.jmv375-headline{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.jmv375-list{display:grid;gap:6px}
.jmv375-service,.jmv375-availability{padding:8px;border:1px solid var(--jmv2-line);border-radius:11px;background:rgba(255,255,255,.018);display:grid;gap:7px}
.jmv375-service-top,.jmv375-availability-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.jmv375-service-top h3,.jmv375-availability-top h3{font-size:.62rem;line-height:1.2;margin:0}
.jmv375-service-top p,.jmv375-availability-top p{font-size:.49rem;line-height:1.3;color:var(--muted);margin:2px 0 0}
.jmv375-thumb{width:32px;height:32px;border-radius:8px;object-fit:cover;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03)}
.jmv375-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.jmv375-meta div{padding:6px 7px;border-radius:9px;border:1px solid rgba(128,211,237,.08);background:rgba(255,255,255,.014)}
.jmv375-meta small{display:block;font-size:.46rem;color:#87a0ad;text-transform:uppercase;letter-spacing:.04em}
.jmv375-meta b{display:block;font-size:.55rem;line-height:1.26;margin-top:2px;color:#eaf8ff}
.jmv375-actions{display:flex;flex-wrap:wrap;gap:5px;justify-content:flex-end}
.jmv375-actions .jmv2-btn{flex:0 0 auto}
.jmv375-note{font-size:.49rem;color:var(--muted);line-height:1.3}
.jmv375-top-actions{display:flex;flex-wrap:wrap;gap:5px}
.jmv375-inline{display:flex;flex-wrap:wrap;gap:4px}
.jmv375-inline .jmv2-status{margin:0}

.jmv362-policy{padding:8px 9px!important;border-radius:10px!important;font-size:.5rem!important;line-height:1.35!important;background:rgba(255,255,255,.024)!important;border:1px solid rgba(128,211,237,.08)!important}
.jmv362-follow-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important;margin-top:8px!important}
.jmv362-follow-card{padding:8px!important;border-radius:11px!important;background:rgba(255,255,255,.018)!important;border:1px solid var(--jmv2-line)!important}
.jmv362-follow-card h3{font-size:.60rem!important;margin:0 0 2px!important}
.jmv362-follow-card strong{font-size:.88rem!important;display:block!important;margin-top:2px!important;color:var(--jmv2-cyan)!important}
.jmv362-follow-card p{font-size:.49rem!important;line-height:1.3!important;margin-top:4px!important}
.jmv362-follow-card .jmv362-follow-row{padding:6px 7px!important;border-radius:9px!important;margin-top:6px!important}
.jmv362-follow-card .jmv362-follow-row b{font-size:.54rem!important}
.jmv362-follow-card .jmv362-follow-row small{font-size:.47rem!important;line-height:1.25!important}
.jmv362-follow-card .jmv2-btn{min-height:26px!important;padding:4px 8px!important;font-size:.5rem!important}

#crudModal #jmv2ServiceForm .jmv2-form-grid{gap:6px!important}
#crudModal #jmv2ServiceForm .jmv2-field label{font-size:.49rem!important}
#crudModal #jmv2ServiceForm input,
#crudModal #jmv2ServiceForm select,
#crudModal #jmv2ServiceForm textarea{min-height:28px!important;padding:5px 8px!important;font-size:.54rem!important;border-radius:8px!important}
#crudModal #jmv2ServiceForm textarea{min-height:62px!important}
#crudModal #jmv2ServiceForm small{font-size:.47rem!important;line-height:1.3!important}
#crudModal #jmv2ServiceForm .jmv2-form-actions{gap:5px!important;margin-top:8px!important}
#crudModal #jmv2ServiceForm .jmv2-btn{min-height:28px!important;padding:5px 9px!important;font-size:.54rem!important}

@media (max-width:760px){
  .jmv2-quick-grid,.jmv362-follow-grid{grid-template-columns:1fr!important}
  .jmv375-meta{grid-template-columns:1fr 1fr!important}
}
@media (max-width:560px){
  .jmv375-service-top,.jmv375-availability-top{gap:6px!important}
  .jmv375-meta{grid-template-columns:1fr!important}
  .jmv375-actions{justify-content:flex-start!important}
}
</style>
<script id="cruzclick-v375-compact-all-script">
(function(){
  const D=document;
  const $=id=>D.getElementById(id);
  const qa=(s,r=D)=>Array.from(r.querySelectorAll(s));
  const note=(m,t='info')=>{try{if(typeof notify==='function')notify(m,t);else if(typeof toast==='function')toast(m,t);else console.log(m)}catch(e){console.log(m)}};
  const saveAll=()=>{try{safeWrite(KEYS.products,state.products);safeWrite(KEYS.orders,state.orders);safeWrite(KEYS.settings,state.settings);safeWrite(KEYS.cart,state.cart);safeWrite(KEYS.favorites,state.favorites)}catch(e){console.warn('saveAll V375',e)}};
  const byType=(p)=>{try{return kindDef(p)}catch(e){return KINDS?.[p.digitalKind]||{label:p.digitalKind||'Servicio'}}};
  function compactServiceCard375(p){
    normalizeProductV2(p);
    const a=avail(p), k=byType(p), reqs=(p.digitalRequirements||[]).length;
    return `<article class="jmv375-service"><div class="jmv375-service-top"><div style="display:flex;gap:8px;align-items:flex-start"><img class="jmv375-thumb" src="${esc2(p.image||BRAND_LOGO)}" alt=""><div><h3>${esc2(p.name||'Servicio')}</h3><p>${esc2(p.category||'Sin categoría')} · ${esc2(p.platform||'Sin plataforma')}</p></div></div><div class="jmv375-inline"><span class="jmv2-status ${a.cls==='out'?'bad':a.cls==='low'?'warn':'ok'}">${esc2(a.admin)}</span>${p.featured!==false?'<span class="jmv2-status">Destacado</span>':''}</div></div><div class="jmv375-meta"><div><small>Tipo</small><b>${esc2(k.label||'Servicio digital')}</b></div><div><small>Precio</small><b>${money2(p.price)}</b></div><div><small>Entrega</small><b>${esc2(p.deliveryEta||state.settings.defaultDeliveryEta||'—')}</b></div><div><small>Datos requeridos</small><b>${reqs}</b></div></div><div class="jmv375-actions"><button class="jmv2-btn" data-v375edit="${esc2(p.id)}">Editar</button><button class="jmv2-btn" data-v375copy="${esc2(p.id)}">Duplicar</button><button class="jmv2-btn red" data-v375del="${esc2(p.id)}">Eliminar</button></div></article>`;
  }
  window.servicesAdminV2=function(){
    $('adminContent').innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Catálogo de servicios digitales</h2><p>Vista compacta para administrar productos sin desperdiciar espacio.</p></div><div class="jmv2-toolbar"><input id="jmv375ServiceSearch" placeholder="Buscar servicio"><select id="jmv375ServiceKind"><option value="all">Todos los tipos</option>${Object.entries(KINDS).map(([k,d])=>`<option value="${k}">${esc2(d.label)}</option>`).join('')}</select><button class="jmv2-btn primary" id="jmv375AddService">Nuevo</button></div></div><div class="jmv2-inline-stats"><span class="jmv2-status">${state.products.length} servicios</span><span class="jmv2-status warn">${state.products.filter(p=>{normalizeProductV2(p);return p.availabilityMode==='limited'&&Number(p.stock||0)<=Number(state.settings.lowStock||6)}).length} stock bajo</span></div><div class="jmv375-list" id="jmv375ServiceList"></div></section>`;
    const draw=()=>{
      const term=String($('jmv375ServiceSearch').value||'').toLowerCase().trim();
      const kind=$('jmv375ServiceKind').value;
      const list=(state.products||[]).filter(p=>{normalizeProductV2(p);return (kind==='all'||p.digitalKind===kind)&&(!term||`${p.name||''} ${p.category||''} ${p.platform||''}`.toLowerCase().includes(term))});
      $('jmv375ServiceList').innerHTML=list.map(compactServiceCard375).join('')||'<div class="jmv2-empty">No hay servicios para mostrar.</div>';
      qa('[data-v375edit]',$('jmv375ServiceList')).forEach(b=>b.onclick=()=>openServiceEditorV2(b.dataset.v375edit));
      qa('[data-v375copy]',$('jmv375ServiceList')).forEach(b=>b.onclick=()=>{const p=state.products.find(x=>String(x.id)===String(b.dataset.v375copy));if(!p)return;state.products.unshift({...JSON.parse(JSON.stringify(p)),id:typeof uid==='function'?uid('svc'):`svc-${Date.now()}`,name:`${p.name} copia`,createdAt:nowIso(),updatedAt:nowIso()});saveAll();try{renderStore()}catch(e){}draw()});
      qa('[data-v375del]',$('jmv375ServiceList')).forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>String(x.id)===String(b.dataset.v375del));if(!p)return;const reserved=(state.orders||[]).some(o=>o.inventory?.reservationStatus==='reserved'&&(o.inventory?.items||[]).some(i=>String(i.productId)===String(p.id)));if(reserved)return note('No puedes eliminar un servicio con cupos reservados en pedidos pendientes.','warn');let ok=true;try{if(typeof npConfirm==='function')ok=await npConfirm(`¿Eliminar ${p.name}?`)}catch(e){}if(!ok)return;state.products=state.products.filter(x=>String(x.id)!==String(p.id));state.cart=state.cart.filter(x=>String(x.id)!==String(p.id));state.favorites=state.favorites.filter(x=>String(x)!==String(p.id));saveAll();try{renderStore()}catch(e){}draw()});
    };
    draw();
    $('jmv375ServiceSearch').oninput=draw;
    $('jmv375ServiceKind').onchange=draw;
    $('jmv375AddService').onclick=()=>openServiceEditorV2();
  };
  try{servicesAdminV2=window.servicesAdminV2}catch(e){}

  window.availabilityAdminV2=function(){
    purgeExpiredReservations();
    $('adminContent').innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Disponibilidad digital</h2><p>Control compacto de cupos, reservas y tipo de disponibilidad.</p></div><div class="jmv375-top-actions"><button class="jmv2-btn" id="jmv375AvailRefresh">Actualizar</button><button class="jmv2-btn" id="jmv375AvailGoServices">Servicios</button></div></div><div class="jmv375-list" id="jmv375AvailList"></div></section>`;
    const draw=()=>{
      $('jmv375AvailList').innerHTML=(state.products||[]).map(p=>{normalizeProductV2(p);const a=avail(p),reserved=(state.orders||[]).filter(o=>o.inventory?.reservationStatus==='reserved').reduce((s,o)=>s+(o.inventory?.items||[]).filter(i=>String(i.productId)===String(p.id)).reduce((x,i)=>x+Number(i.qty||0),0),0);return `<article class="jmv375-availability"><div class="jmv375-availability-top"><div><h3>${esc2(p.name)}</h3><p>${esc2(byType(p).label||'Servicio digital')} · ${esc2(p.platform||'Sin plataforma')}</p></div><div class="jmv375-inline"><span class="jmv2-status ${a.cls==='out'?'bad':a.cls==='low'?'warn':'ok'}">${esc2(a.admin)}</span>${reserved?`<span class="jmv2-status warn">${reserved} reservado${reserved===1?'':'s'}</span>`:''}</div></div><div class="jmv375-meta"><div><small>Modo</small><b>${p.availabilityMode==='limited'?'Cupos controlados':p.availabilityMode==='unlimited'?'Ilimitado':'Bajo solicitud'}</b></div><div><small>Precio</small><b>${money2(p.price)}</b></div><div><small>Cupos cargados</small><b>${p.availabilityMode==='limited'?Number(p.stock||0):'—'}</b></div><div><small>Entrega</small><b>${esc2(p.deliveryEta||state.settings.defaultDeliveryEta||'—')}</b></div></div><div class="jmv375-actions"><select data-v375mode="${esc2(p.id)}"><option value="limited" ${p.availabilityMode==='limited'?'selected':''}>Limitado</option><option value="unlimited" ${p.availabilityMode==='unlimited'?'selected':''}>Ilimitado</option><option value="on_request" ${p.availabilityMode==='on_request'?'selected':''}>Bajo solicitud</option></select>${p.availabilityMode==='limited'?`<button class="jmv2-btn" data-v375stock="${esc2(p.id)}">Definir cupos</button>`:''}<button class="jmv2-btn" data-v375editavail="${esc2(p.id)}">Editar</button></div></article>`}).join('')||'<div class="jmv2-empty">No hay servicios.</div>';
      qa('[data-v375mode]',$('jmv375AvailList')).forEach(s=>s.onchange=()=>{const p=state.products.find(x=>String(x.id)===String(s.dataset.v375mode));if(!p)return;p.availabilityMode=s.value;if(s.value!=='limited')p.stock=9999;else if(Number(p.stock)>=9999)p.stock=0;saveAll();try{renderStore()}catch(e){}draw()});
      qa('[data-v375stock]',$('jmv375AvailList')).forEach(b=>b.onclick=async()=>{const p=state.products.find(x=>String(x.id)===String(b.dataset.v375stock));if(!p)return;let val=null;try{val=typeof npPrompt==='function'?await npPrompt(`Cupos vendibles para ${p.name}`,p.stock):prompt('Cupos',p.stock)}catch(e){}if(val===null||isNaN(Number(val)))return;p.stock=Math.max(0,Number(val));saveAll();try{renderStore()}catch(e){}draw()});
      qa('[data-v375editavail]',$('jmv375AvailList')).forEach(b=>b.onclick=()=>openServiceEditorV2(b.dataset.v375editavail));
    };
    draw();
    $('jmv375AvailRefresh').onclick=draw;
    $('jmv375AvailGoServices').onclick=()=>renderAdminV2('services');
  };
  try{availabilityAdminV2=window.availabilityAdminV2}catch(e){}

  window.messagesAdminV2=function(){
    if(window.JM_DIGITAL_STORE_V362?.renderFollowupCenter){
      window.JM_DIGITAL_STORE_V362.renderFollowupCenter();
      return;
    }
    $('adminContent').innerHTML=`<section class="jmv2-admin-card" style="margin-top:0"><div class="jmv2-card-head"><div><h2>Seguimientos</h2><p>Centro compacto para los contactos operativos permitidos.</p></div></div><div class="jmv2-note">No hay módulo avanzado cargado en esta ejecución.</div></section>`;
  };
  try{messagesAdminV2=window.messagesAdminV2}catch(e){}

  window.homeAdminV2=function(){
    purgeExpiredReservations();
    const limited=state.products.filter(p=>(normalizeProductV2(p),p.availabilityMode==='limited')),
          low=limited.filter(p=>Number(p.stock)>0&&Number(p.stock)<=Number(state.settings.lowStock||6)).length,
          out=limited.filter(p=>Number(p.stock)<=0).length,
          payPending=state.orders.filter(o=>o.status==='Pago pendiente').length,
          prep=state.orders.filter(o=>['Pago confirmado','Preparando acceso','Listo para entregar'].includes(o.status)).length;
    $('adminContent').innerHTML=`<section class="jmv2-banner"><div><b>${esc2(state.settings.storeName||'CRULOX')} · operación 100% digital</b><p>Panel compacto con prioridad en pedidos, clientes y cupos.</p></div><span class="jmv2-status ok">${esc2(state.settings.slogan||'DIGITAL')}</span></section><div class="jmv2-metrics">${metric('Servicios',state.products.length,'catálogo')}${metric('Pendientes',pendingCount(),'requieren acción')}${metric('Pago pendiente',payPending,'por confirmar')}${metric('Preparando',prep,'pagados / en proceso')}${metric('Ingresos',money2(paidRevenue()),'confirmados')}${metric('Stock bajo',low,'servicios limitados')}</div><section class="jmv2-admin-card"><div class="jmv2-card-head"><div><h2>Acciones rápidas</h2><p>Todo lo importante, sin bloques gigantes ni texto de relleno.</p></div></div><div class="jmv2-quick-grid"><button class="jmv2-quick" data-v375home="orders"><b>🧾 ${payPending} pagos pendientes</b><p>Revisar comprobantes y mover pedidos.</p></button><button class="jmv2-quick" data-v375home="clients"><b>👥 ${state.users.length} clientes</b><p>Consultar historial y contacto.</p></button><button class="jmv2-quick" data-v375home="services"><b>＋ Nuevo servicio</b><p>Crear o editar catálogo digital.</p></button><button class="jmv2-quick" data-v375home="messages"><b>🔔 Seguimientos</b><p>Renovaciones, carritos y no pagados.</p></button></div><div class="jmv375-note" style="margin-top:8px">Sin logística física. El control principal se mantiene dentro del sistema.</div></section>`;
    qa('[data-v375home]',$('adminContent')).forEach(b=>b.onclick=()=>b.dataset.v375home==='services'?openServiceEditorV2():renderAdminV2(b.dataset.v375home));
  };
  try{homeAdminV2=window.homeAdminV2}catch(e){}

  console.info('CRULOX · V3.7.5 compacto total admin');
})();
</script>


