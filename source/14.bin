<script id="cruzclick-v376-orders-clients-compact-script">
(function(){
  const D=document;
  function applyCompactContext(){
    const shell=D.querySelector('.jmv360-admin-shell');
    if(!shell) return;
    const sec=String((window.state&&state.adminSection)||'').toLowerCase();
    shell.classList.toggle('jmv376-orders-clients', sec==='orders' || sec==='clients');
  }
  const oldRender=(typeof window.renderAdminV2==='function')?window.renderAdminV2:null;
  if(oldRender && !oldRender.__v376Wrapped){
    const wrapped=function(section){
      const r=oldRender.apply(this,arguments);
      setTimeout(applyCompactContext,20);
      return r;
    };
    wrapped.__v376Wrapped=true;
    window.renderAdminV2=wrapped;
    try{renderAdminV2=wrapped}catch(e){}
  }
  D.addEventListener('click',e=>{
    const btn=e.target&&e.target.closest&&e.target.closest('[data-jmv2-section]');
    if(btn) setTimeout(applyCompactContext,40);
  },true);
  window.addEventListener('pageshow',applyCompactContext);
  if(D.readyState==='loading') D.addEventListener('DOMContentLoaded',applyCompactContext,{once:true});
  else applyCompactContext();
})();
</script>



<!-- CRULOX V3.7.7 · Panel administrativo básico. La tienda pública no se modifica. -->
<style id="cruzclick-v377-basic-admin-style">
#adminOverlay .cc377-admin{
  min-height:100dvh;
  box-sizing:border-box;
  padding:12px;
  display:grid;
  align-content:start;
  gap:10px;
  background:
    radial-gradient(circle at 82% 10%,rgba(34,223,243,.07),transparent 25%),
    linear-gradient(180deg,#031019 0%,#020b12 100%);
  color:#eef8ff;
}
#adminOverlay .cc377-top,
#adminOverlay .cc377-card{
  border:1px solid rgba(88,191,232,.14);
  background:linear-gradient(180deg,rgba(10,24,38,.92),rgba(6,18,30,.97));
  box-shadow:0 14px 34px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.025);
}
#adminOverlay .cc377-top{
  min-height:58px;
  border-radius:16px;
  padding:9px 11px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
#adminOverlay .cc377-brand{display:flex;align-items:center;gap:8px;min-width:0}
#adminOverlay .cc377-brand img{width:34px;height:34px;object-fit:contain;border-radius:7px}
#adminOverlay .cc377-brand b{display:block;font-size:.78rem;line-height:1.05;color:#fff}
#adminOverlay .cc377-brand span{display:block;margin-top:2px;font-size:.48rem;line-height:1.15;color:#78cce9}
#adminOverlay .cc377-actions{display:flex;align-items:center;gap:6px}
#adminOverlay .cc377-btn{
  min-height:32px;
  padding:0 10px;
  border-radius:10px;
  border:1px solid rgba(88,191,232,.18);
  background:rgba(255,255,255,.025);
  color:#eef8ff;
  font-size:.58rem;
  font-weight:900;
}
#adminOverlay .cc377-btn.primary{border-color:rgba(34,223,243,.28);color:#76eafa;background:rgba(34,223,243,.055)}
#adminOverlay .cc377-card{
  border-radius:16px;
  padding:15px 14px;
  display:grid;
  gap:5px;
}
#adminOverlay .cc377-kicker{font-size:.48rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:#849ead}
#adminOverlay .cc377-card h1{margin:0;font-size:1.12rem;line-height:1.05;color:#fff}
#adminOverlay .cc377-card p{margin:0;font-size:.56rem;line-height:1.4;color:#8fa8b6;max-width:54ch}
#adminOverlay .cc377-status{
  margin-top:5px;
  width:max-content;
  max-width:100%;
  padding:5px 8px;
  border-radius:999px;
  border:1px solid rgba(57,223,124,.13);
  background:rgba(57,223,124,.05);
  color:#7de9a8;
  font-size:.5rem;
  font-weight:900;
}
@media(max-width:560px){
  #adminOverlay .cc377-admin{padding:8px;gap:8px}
  #adminOverlay .cc377-top{padding:8px 9px;border-radius:14px;min-height:52px}
  #adminOverlay .cc377-brand img{width:30px;height:30px}
  #adminOverlay .cc377-brand b{font-size:.70rem}
  #adminOverlay .cc377-brand span{font-size:.44rem}
  #adminOverlay .cc377-btn{min-height:29px;padding:0 8px;font-size:.53rem}
  #adminOverlay .cc377-card{padding:12px;border-radius:14px}
  #adminOverlay .cc377-card h1{font-size:.98rem}
  #adminOverlay .cc377-card p{font-size:.52rem}
}
</style>
<script id="cruzclick-v377-basic-admin-script">
(function(){
  'use strict';
  const D=document;
  const overlay=()=>D.getElementById('adminOverlay');
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function brandLogo(){
    try{return window.BRAND_LOGO||BRAND_LOGO||''}catch(e){return ''}
  }
  function closeAdmin377(){
    const el=overlay(); if(!el)return;
    el.classList.remove('open');
    D.body.classList.remove('lock');
  }
  function logout377(){
    try{
      if(window.state) state.session=null;
      if(typeof safeWrite==='function'&&window.KEYS?.session)safeWrite(KEYS.session,null);
    }catch(e){}
    closeAdmin377();
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    try{if(typeof notify==='function')notify('Sesión cerrada.','success')}catch(e){}
  }
  function renderBasicAdmin377(){
    const el=overlay(); if(!el)return false;
    const name=(()=>{try{return String(state?.settings?.storeName||'CRULOX')}catch(e){return 'CRULOX'}})();
    el.innerHTML=`<div class="cc377-admin"><header class="cc377-top"><div class="cc377-brand"><img src="${esc(brandLogo())}" alt="${esc(name)}"><div><b>${esc(name)}</b><span>Administración</span></div></div><div class="cc377-actions"><button type="button" class="cc377-btn primary" id="cc377Store">Tienda</button><button type="button" class="cc377-btn" id="cc377Logout">Salir</button></div></header><main class="cc377-card"><span class="cc377-kicker">Panel de administración</span><h1>Acceso administrativo</h1><p>Panel básico activo. Las herramientas de gestión fueron retiradas de esta interfaz.</p><span class="cc377-status">Acceso habilitado</span></main></div>`;
    const store=D.getElementById('cc377Store'); if(store)store.onclick=closeAdmin377;
    const logout=D.getElementById('cc377Logout'); if(logout)logout.onclick=logout377;
    return true;
  }
  function openBasicAdmin377(){
    const el=overlay(); if(!el)return false;
    try{if(window.state&&state.session&&state.session.role!=='admin')return false}catch(e){}
    renderBasicAdmin377();
    el.classList.add('open');
    D.body.classList.add('lock');
    return true;
  }
  window.renderAdminV2=renderBasicAdmin377;
  window.renderAdminSection=renderBasicAdmin377;
  window.renderAdminNav=function(){return true};
  window.adminShell=renderBasicAdmin377;
  window.openAdmin=openBasicAdmin377;
  try{renderAdminV2=renderBasicAdmin377}catch(e){}
  try{renderAdminSection=renderBasicAdmin377}catch(e){}
  try{renderAdminNav=window.renderAdminNav}catch(e){}
  try{adminShell=renderBasicAdmin377}catch(e){}
  try{openAdmin=openBasicAdmin377}catch(e){}
  function init377(){
    const el=overlay();
    if(!el)return;
    renderBasicAdmin377();
  }
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',init377,{once:true});else init377();
  window.CRUZCLICK_ADMIN_V377={VERSION:'3.7.7',render:renderBasicAdmin377,open:openBasicAdmin377};
})();
</script>



<!-- CRULOX V3.7.8 · RESET REAL DEL PANEL ADMIN. La tienda pública no se toca. -->
<style id="cruzclick-v378-admin-reset-style">
#adminOverlay{
  position:fixed!important;
  inset:0!important;
  z-index:9999!important;
  display:none;
  overflow:auto!important;
  background:#020a11!important;
}
#adminOverlay.open{display:block!important}
#adminOverlay .cc378-admin{
  min-height:100dvh;
  box-sizing:border-box;
  padding:10px;
  display:grid;
  grid-template-rows:auto 1fr;
  align-content:start;
  gap:10px;
  background:
    radial-gradient(circle at 82% 8%,rgba(20,210,235,.055),transparent 24%),
    linear-gradient(180deg,#03101a 0%,#020a11 100%);
