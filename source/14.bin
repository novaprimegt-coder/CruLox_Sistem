}
@media(max-width:560px){
  #adminOverlay .jmv360-admin-shell{padding:4px!important;gap:4px!important}
  #adminOverlay .jmv360-topbar{grid-template-columns:minmax(0,1fr) auto!important}
  #adminOverlay .jmv360-nav{gap:4px!important;padding:4px!important}
