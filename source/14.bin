#adminOverlay .jmv2-record select{min-height:25px!important;padding:3px 5px!important;font-size:.44rem!important}
#adminOverlay .jmv2-status{padding:3px 5px!important;font-size:.40rem!important}
#adminOverlay .jmv2-order-statusline{gap:3px!important;margin-top:4px!important}
