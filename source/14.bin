#adminOverlay .jmv362-wa-btn{min-height:25px;padding:4px 7px;border-radius:7px;border:1px solid rgba(46,218,126,.17);background:rgba(46,218,126,.07);color:#7aeeaa;font-size:.42rem;font-weight:900;white-space:nowrap}
#adminOverlay .jmv362-empty{padding:9px;text-align:center;border:1px dashed rgba(110,194,222,.10);border-radius:8px;color:#6f8999;font-size:.43rem}

