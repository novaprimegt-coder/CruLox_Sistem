<style id="cruzclick-v386-responsive-premium">
/* V3.8.6 — Corrección estructural de ancho/overflow del panel administrativo */
html:has(#adminOverlay.open),
body:has(#adminOverlay.open){
  width:100%;max-width:100%;overflow-x:hidden!important;overscroll-behavior-x:none!important;
}
#adminOverlay,
#adminOverlay.open{
  position:fixed!important;inset:0!important;left:0!important;right:0!important;
  width:100vw!important;max-width:100vw!important;height:100dvh!important;
  box-sizing:border-box!important;overflow-x:hidden!important;overflow-y:auto!important;
  margin:0!important;padding:0!important;transform:none!important;direction:ltr!important;
  overscroll-behavior-x:none!important;-webkit-overflow-scrolling:touch!important;
}
#adminOverlay .cc378-admin{
  position:relative!important;width:100%!important;max-width:100%!important;min-width:0!important;
  box-sizing:border-box!important;margin:0!important;
  padding:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(16px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))!important;
  overflow-x:hidden!important;
}
#adminOverlay .cc378-bar{
  width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;
  margin:0!important;
}
#adminOverlay .cc378-brand,
#adminOverlay .cc378-actions{min-width:0!important;box-sizing:border-box!important}
#adminOverlay .cc378-brand{flex:1 1 auto!important;overflow:hidden!important}
#adminOverlay .cc378-brand>div{min-width:0!important;overflow:hidden!important}
#adminOverlay .cc378-brand b,#adminOverlay .cc378-brand span{overflow-wrap:anywhere!important}
#adminOverlay .cc378-actions{flex:0 0 auto!important}
#adminOverlay .cc378-main{
  width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;
  overflow:visible!important;
}
#adminOverlay .cc378-nav{
  width:min(100%,1120px)!important;max-width:1120px!important;min-width:0!important;
  box-sizing:border-box!important;margin:0 auto!important;padding:0!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  overflow:visible!important;
}
#adminOverlay .cc378-nav button{
  width:100%!important;min-width:0!important;max-width:100%!important;box-sizing:border-box!important;
  margin:0!important;overflow:hidden!important;contain:layout paint style!important;
  -webkit-tap-highlight-color:transparent!important;
}
#adminOverlay .cc378-nav-label,#adminOverlay .cc378-nav-sub{
  min-width:0!important;max-width:100%!important;overflow-wrap:anywhere!important;
}
#adminOverlay .cc378-module-window{
  width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;
  margin:0!important;overflow:hidden!important;
}
@media(max-width:760px){
  #adminOverlay .cc378-admin{padding-left:max(9px,env(safe-area-inset-left))!important;padding-right:max(9px,env(safe-area-inset-right))!important;padding-top:max(9px,env(safe-area-inset-top))!important}
  #adminOverlay .cc378-bar{min-height:58px!important;padding:9px!important;border-radius:16px!important}
  #adminOverlay .cc378-brand{gap:8px!important}
  #adminOverlay .cc378-brand img{width:32px!important;height:32px!important;flex-basis:32px!important}
  #adminOverlay .cc378-brand b{font-size:.78rem!important}
  #adminOverlay .cc378-brand span{font-size:.44rem!important}
  #adminOverlay .cc378-btn{min-height:32px!important;padding-inline:9px!important}
  #adminOverlay .cc378-nav{gap:9px!important}
  #adminOverlay .cc378-nav button{min-height:132px!important;padding:15px 13px!important;border-radius:18px!important;gap:9px!important}
  #adminOverlay .cc378-nav-icon{width:50px!important;height:50px!important;border-radius:15px!important;flex:0 0 50px!important}
  #adminOverlay .cc378-nav-icon svg{width:27px!important;height:27px!important}
  #adminOverlay .cc378-nav-label{font-size:.69rem!important}
  #adminOverlay .cc378-nav-sub{font-size:.45rem!important}
  #adminOverlay .cc378-nav-index{right:10px!important;top:9px!important}
}
@media(max-width:430px){
  #adminOverlay .cc378-admin{padding-left:max(7px,env(safe-area-inset-left))!important;padding-right:max(7px,env(safe-area-inset-right))!important}
  #adminOverlay .cc378-bar{gap:6px!important;padding:8px!important}
  #adminOverlay .cc378-brand img{width:29px!important;height:29px!important;flex-basis:29px!important}
  #adminOverlay .cc378-brand b{font-size:.72rem!important}
  #adminOverlay .cc378-brand span{font-size:.40rem!important;letter-spacing:.07em!important}
  #adminOverlay .cc378-actions{gap:4px!important}
  #adminOverlay .cc378-btn{min-height:30px!important;padding-inline:8px!important;font-size:.50rem!important}
  #adminOverlay .cc378-nav{gap:8px!important}
  #adminOverlay .cc378-nav button{min-height:116px!important;padding:13px 10px!important;border-radius:16px!important;gap:7px!important}
  #adminOverlay .cc378-nav-icon{width:44px!important;height:44px!important;flex-basis:44px!important;border-radius:13px!important}
  #adminOverlay .cc378-nav-icon svg{width:24px!important;height:24px!important}
  #adminOverlay .cc378-nav-label{font-size:.62rem!important}
  #adminOverlay .cc378-nav-sub{font-size:.40rem!important;line-height:1.3!important}
  #adminOverlay .cc378-nav-index{font-size:.39rem!important;right:8px!important;top:8px!important}
  #adminOverlay .cc378-nav button:nth-child(37){width:50%!important}
}
@media(max-width:340px){
  #adminOverlay .cc378-nav{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
  #adminOverlay .cc378-nav button{min-height:108px!important;padding:11px 8px!important}
  #adminOverlay .cc378-nav-icon{width:40px!important;height:40px!important;flex-basis:40px!important}
  #adminOverlay .cc378-nav-label{font-size:.57rem!important}
  #adminOverlay .cc378-nav-sub{font-size:.36rem!important}
}
</style>

<style id="cruzclick-v393-premium-compact">\n/* V3.9.3 — rediseño premium compacto del panel administrativo. Alcance: solo #adminOverlay. */\n#adminOverlay{--cc-bg:#06101a;--cc-surface:rgba(9,25,39,.82);--cc-surface2:rgba(12,34,51,.72);--cc-line:rgba(102,220,255,.13);--cc-glow:rgba(0,215,255,.12)}\n#adminOverlay .cc378-admin{padding:10px!important;max-width:1280px!important}\n#adminOverlay .cc378-bar{min-height:54px!important;padding:8px 10px!important;border-radius:17px!important;background:linear-gradient(135deg,rgba(10,29,44,.94),rgba(4,16,27,.96))!important;border-color:rgba(98,217,255,.13)!important;box-shadow:0 12px 30px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.045)!important}\n#adminOverlay .cc378-brand{gap:8px!important}\n#adminOverlay .cc378-brand img{width:31px!important;height:31px!important}\n#adminOverlay .cc378-brand b{font-size:.73rem!important}\n#adminOverlay .cc378-brand small{font-size:.42rem!important;letter-spacing:.08em!important}\n#adminOverlay .cc378-bar-actions{gap:6px!important}\n#adminOverlay .cc378-bar-actions button{min-height:34px!important;padding:7px 11px!important;border-radius:11px!important;font-size:.61rem!important}\n\n/* Navegación de módulos: compacta, limpia y sin numeración visible. */\n#adminOverlay .cc378-nav{gap:10px!important;padding:1px!important}\n#adminOverlay .cc378-nav button{min-height:132px!important;padding:15px 14px!important;border-radius:19px!important;gap:8px!important;background:radial-gradient(circle at 50% 8%,rgba(0,225,255,.085),transparent 35%),linear-gradient(145deg,rgba(10,35,53,.97),rgba(4,17,29,.99))!important;border:1px solid rgba(102,220,255,.12)!important;box-shadow:0 12px 28px rgba(0,0,0,.23),inset 0 1px 0 rgba(255,255,255,.045)!important}\n#adminOverlay .cc378-nav button:hover{transform:translateY(-2px)!important;border-color:rgba(0,224,255,.30)!important;box-shadow:0 17px 34px rgba(0,0,0,.30),0 0 22px rgba(0,215,255,.07)!important}\n#adminOverlay .cc378-nav-index{display:none!important}\n#adminOverlay .cc378-nav-icon{width:50px!important;height:50px!important;flex:0 0 50px!important;border-radius:15px!important;background:linear-gradient(145deg,rgba(0,222,255,.16),rgba(68,108,255,.07))!important;border:1px solid rgba(0,224,255,.22)!important;box-shadow:0 8px 22px rgba(0,190,255,.09),inset 0 1px 0 rgba(255,255,255,.06)!important;color:#6deaff!important}\n#adminOverlay .cc378-nav-icon svg{width:27px!important;height:27px!important;stroke:currentColor!important;fill:none!important;stroke-width:2.15!important;stroke-linecap:round!important;stroke-linejoin:round!important;display:block!important;visibility:visible!important;opacity:1!important}\n#adminOverlay .cc378-nav-label{font-size:.72rem!important;line-height:1.16!important;font-weight:900!important;letter-spacing:-.01em!important}\n#adminOverlay .cc378-nav-sub{font-size:.46rem!important;line-height:1.38!important;color:#7894a7!important;max-width:250px!important}\n\n/* Ventanas internas. */\n#adminOverlay .cc378-module-window{border-radius:22px!important;background:linear-gradient(145deg,rgba(8,27,42,.90),rgba(3,15,25,.96))!important;border:1px solid rgba(102,220,255,.10)!important;box-shadow:0 20px 55px rgba(0,0,0,.30),inset 0 1px 0 rgba(255,255,255,.035)!important;padding:16px!important}\n#adminOverlay .cc378-module-head{padding-bottom:11px!important;gap:9px!important;border-bottom-color:rgba(102,220,255,.09)!important}\n#adminOverlay .cc378-back{width:auto!important;min-width:92px!important;height:38px!important;flex:0 0 auto!important;padding:7px 12px!important;border-radius:11px!important;font-size:.62rem!important;font-weight:900!important;background:linear-gradient(145deg,rgba(0,218,255,.10),rgba(0,80,130,.07))!important;border-color:rgba(0,224,255,.17)!important;color:#75eaff!important}\n#adminOverlay .cc378-module-id{gap:9px!important}\n#adminOverlay .cc378-module-icon{width:45px!important;height:45px!important;flex:0 0 45px!important;border-radius:14px!important}\n#adminOverlay .cc378-module-icon svg{width:25px!important;height:25px!important;display:block!important;visibility:visible!important}\n#adminOverlay .cc378-module-id h1{font-size:.90rem!important;line-height:1.12!important;letter-spacing:-.015em!important}\n#adminOverlay .cc378-module-id p{font-size:.46rem!important;line-height:1.35!important;margin-top:3px!important}\n\n/* Renovaciones: menos texto, más jerarquía visual. */\n#adminOverlay .cc390-renewal-hero{grid-template-columns:minmax(0,1fr) auto!important;gap:10px!important;padding:13px!important;border-radius:17px!important;background:radial-gradient(circle at 90% 10%,rgba(0,218,255,.13),transparent 32%),linear-gradient(145deg,rgba(10,39,58,.95),rgba(4,17,28,.98))!important;box-shadow:0 14px 32px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.04)!important}\n#adminOverlay .cc390-renewal-hero h2{font-size:.86rem!important;margin:4px 0 3px!important}\n#adminOverlay .cc390-renewal-hero p{font-size:.45rem!important;line-height:1.45!important;max-width:620px!important}\n#adminOverlay .cc390-renewal-stats{grid-template-columns:repeat(3,minmax(62px,1fr))!important;gap:5px!important;min-width:205px!important}\n#adminOverlay .cc390-renewal-stats span{padding:6px 5px!important;border-radius:9px!important;font-size:.39rem!important}\n#adminOverlay .cc390-renewal-stats b{font-size:.68rem!important}\n#adminOverlay .cc390-renewal-grid{gap:8px!important}\n#adminOverlay .cc390-renewal-card{padding:11px!important;border-radius:15px!important;background:linear-gradient(145deg,rgba(8,27,42,.91),rgba(4,15,25,.98))!important}\n#adminOverlay .cc390-renewal-card-head h3{font-size:.55rem!important}\n#adminOverlay .cc390-renewal-card-head strong,#adminOverlay .cc390-renewal-card-head .cc390-count{font-size:.72rem!important}\n#adminOverlay .cc390-renewal-card p{font-size:.43rem!important;line-height:1.4!important}\n#adminOverlay .cc390-renewal-rule{padding:10px!important;border-radius:14px!important;gap:8px!important}\n#adminOverlay .cc390-rule-icon{width:30px!important;height:30px!important;border-radius:10px!important}\n#adminOverlay .cc390-renewal-rule b{font-size:.47rem!important}\n#adminOverlay .cc390-renewal-rule p{font-size:.41rem!important;line-height:1.42!important}\n\n/* Panel General y tarjetas de detalle: compactas, con lectura rápida. */\n#adminOverlay .cc388-dashboard{gap:10px!important}\n#adminOverlay .cc388-hero{padding:14px!important;border-radius:18px!important}\n#adminOverlay .cc388-hero h2{font-size:1rem!important}\n#adminOverlay .cc388-hero p{font-size:.51rem!important;line-height:1.48!important}\n#adminOverlay .cc388-kpis{gap:8px!important}\n#adminOverlay .cc388-card{padding:11px!important;border-radius:15px!important}\n#adminOverlay .cc388-card h4{font-size:.54rem!important}\n#adminOverlay .cc388-num{font-size:.82rem!important}\n#adminOverlay .cc388-card p{font-size:.42rem!important}\n#adminOverlay .cc388-row{padding:7px!important;border-radius:11px!important;grid-template-columns:32px minmax(0,1fr) auto!important}\n#adminOverlay .cc388-row-icon{width:32px!important;height:32px!important;border-radius:9px!important}\n#adminOverlay .cc388-row-icon svg{width:20px!important;height:20px!important;display:block!important;visibility:visible!important}\n#adminOverlay .cc388-row b{font-size:.52rem!important}\n#adminOverlay .cc388-row span{font-size:.42rem!important}\n#adminOverlay .cc388-badge{font-size:.39rem!important;padding:4px 6px!important}\n#adminOverlay .cc388-action{padding:9px!important;border-radius:12px!important}\n#adminOverlay .cc388-action b{font-size:.52rem!important}\n#adminOverlay .cc388-action span{font-size:.41rem!important}\n#adminOverlay .cc388-system{gap:7px!important}\n#adminOverlay .cc388-system>div{padding:8px!important;border-radius:10px!important}\n#adminOverlay .cc388-system small{font-size:.40rem!important}\n#adminOverlay .cc388-system b{font-size:.56rem!important}\n\n@media(max-width:620px){\n #adminOverlay .cc378-admin{padding:8px!important}\n #adminOverlay .cc378-nav{gap:8px!important}\n #adminOverlay .cc378-nav button{min-height:116px!important;padding:12px 9px!important;border-radius:16px!important}\n #adminOverlay .cc378-nav-icon{width:43px!important;height:43px!important;flex-basis:43px!important;border-radius:13px!important}\n #adminOverlay .cc378-nav-icon svg{width:24px!important;height:24px!important}\n #adminOverlay .cc378-nav-label{font-size:.64rem!important}\n #adminOverlay .cc378-nav-sub{font-size:.41rem!important;line-height:1.3!important}\n #adminOverlay .cc378-module-window{padding:11px!important;border-radius:18px!important}\n #adminOverlay .cc378-module-head{grid-template-columns:auto minmax(0,1fr)!important}\n #adminOverlay .cc378-back{min-width:82px!important;height:34px!important;padding:6px 9px!important;font-size:.55rem!important}\n #adminOverlay .cc378-module-icon{width:40px!important;height:40px!important;flex-basis:40px!important;border-radius:12px!important}\n #adminOverlay .cc378-module-icon svg{width:22px!important;height:22px!important}\n #adminOverlay .cc378-module-id h1{font-size:.78rem!important}\n #adminOverlay .cc378-module-id p{font-size:.41rem!important}\n #adminOverlay .cc390-renewal-hero{grid-template-columns:1fr!important;padding:11px!important}\n #adminOverlay .cc390-renewal-stats{min-width:0!important;width:100%!important}\n #adminOverlay .cc390-renewal-grid{grid-template-columns:1fr!important}\n}\n@media(max-width:390px){\n #adminOverlay .cc378-nav button{min-height:108px!important}\n #adminOverlay .cc378-nav-label{font-size:.60rem!important}\n #adminOverlay .cc378-nav-sub{font-size:.39rem!important}\n #adminOverlay .cc378-bar-actions button{padding:6px 8px!important;font-size:.55rem!important}\n}\n</style>
<style id="cruzclick-v394-complete-ops">
#adminOverlay .cc394-module-body{display:block!important;text-align:left!important;padding:18px!important}
#adminOverlay .cc394-module-hero{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px 18px;border-radius:18px;background:radial-gradient(circle at 90% 0,rgba(0,225,255,.12),transparent 40%),linear-gradient(145deg,rgba(11,40,59,.92),rgba(4,17,29,.97));border:1px solid rgba(92,230,255,.14)}
#adminOverlay .cc394-module-hero small,#adminOverlay .cc394-tool-hero small{font-size:.42rem;letter-spacing:.16em;font-weight:900;color:#54dff3}
#adminOverlay .cc394-module-hero h2{margin:4px 0 3px!important;font-size:1rem!important;text-align:left!important}
#adminOverlay .cc394-module-hero p{margin:0!important;font-size:.48rem!important;text-align:left!important;max-width:650px!important}
#adminOverlay .cc394-module-count{min-width:74px;text-align:center;padding:9px 11px;border-radius:14px;background:rgba(0,220,255,.06);border:1px solid rgba(0,220,255,.12)}
#adminOverlay .cc394-module-count b{display:block;font-size:1.05rem;color:#6deeff}#adminOverlay .cc394-module-count span{font-size:.38rem;color:#7898aa}
#adminOverlay .cc394-module-stat{display:flex;align-items:baseline;gap:7px;margin:10px 2px 2px}#adminOverlay .cc394-module-stat b{font-size:.66rem;color:#eafbff}#adminOverlay .cc394-module-stat span{font-size:.42rem;color:#6f8c9f}
#adminOverlay .cc394-tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:12px}
#adminOverlay .cc394-tool-card{min-width:0;display:grid;grid-template-columns:38px minmax(0,1fr) 18px;align-items:center;gap:10px;text-align:left;padding:11px;border-radius:14px;border:1px solid rgba(100,221,255,.10);background:linear-gradient(145deg,rgba(9,32,49,.90),rgba(4,17,28,.96));color:#eefaff;box-shadow:inset 0 1px rgba(255,255,255,.025)}
#adminOverlay .cc394-tool-card:hover{border-color:rgba(78,231,255,.28);transform:translateY(-1px)}
#adminOverlay .cc394-tool-symbol{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;color:#65ebff;font-size:.82rem;background:rgba(0,221,255,.07);border:1px solid rgba(0,221,255,.13)}
#adminOverlay .cc394-tool-card b{display:block;font-size:.55rem;line-height:1.25}#adminOverlay .cc394-tool-card small{display:block;margin-top:3px;color:#7693a5;font-size:.40rem;line-height:1.35}#adminOverlay .cc394-tool-card em{font-style:normal;color:#4bdff4;font-size:.9rem;text-align:right}
#adminOverlay .cc394-tool-view{display:block!important;text-align:left!important}.cc394-tool-hero{display:flex;align-items:center;gap:12px;padding:14px;border-radius:16px;background:linear-gradient(145deg,rgba(10,38,57,.94),rgba(4,17,28,.97));border:1px solid rgba(100,221,255,.12)}
#adminOverlay .cc394-tool-hero>span{width:46px;height:46px;flex:0 0 46px;display:grid;place-items:center;border-radius:14px;background:rgba(0,220,255,.08);border:1px solid rgba(0,220,255,.15);color:#65ebff;font-size:1rem}
#adminOverlay .cc394-tool-hero h2{margin:3px 0!important;font-size:.82rem!important;text-align:left!important}#adminOverlay .cc394-tool-hero p{margin:0!important;text-align:left!important;font-size:.46rem!important}
#adminOverlay .cc394-info{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:10px 0}.cc394-info>div{padding:9px;border-radius:11px;background:rgba(255,255,255,.018);border:1px solid rgba(100,221,255,.07)}#adminOverlay .cc394-info small{display:block;font-size:.38rem;color:#708da0}#adminOverlay .cc394-info b{display:block;margin-top:3px;font-size:.48rem;color:#e9faff}
#adminOverlay .cc394-table{display:grid;gap:6px}.cc394-tr{display:grid;grid-template-columns:1.2fr 1.2fr .8fr .7fr;gap:7px;padding:9px 10px;border-radius:11px;background:rgba(5,22,35,.72);border:1px solid rgba(99,216,255,.07)}#adminOverlay .cc394-tr span{min-width:0;overflow-wrap:anywhere;font-size:.42rem;color:#86a2b3}#adminOverlay .cc394-tr .c0{color:#eefaff;font-weight:800}
#adminOverlay .cc394-note{margin:12px 0 0!important;padding:10px 12px;border-radius:11px;background:rgba(255,184,71,.035);border:1px solid rgba(255,184,71,.10);color:#9aa9b2!important;font-size:.40rem!important;text-align:left!important;max-width:none!important}
@media(max-width:620px){#adminOverlay .cc394-tools-grid{grid-template-columns:1fr 1fr;gap:7px}#adminOverlay .cc394-tool-card{grid-template-columns:34px minmax(0,1fr) 12px;padding:9px 7px;gap:7px}#adminOverlay .cc394-tool-symbol{width:34px;height:34px}#adminOverlay .cc394-tool-card b{font-size:.49rem}#adminOverlay .cc394-tool-card small{font-size:.36rem}#adminOverlay .cc394-module-hero{padding:12px}#adminOverlay .cc394-module-hero h2{font-size:.82rem!important}#adminOverlay .cc394-module-count{min-width:62px}.cc394-tr{grid-template-columns:1fr 1fr}.cc394-tr .c2,.cc394-tr .c3{text-align:left}.cc394-info{grid-template-columns:1fr 1fr 1fr!important}}
</style>
<style id="crulox-orbit-v431-style">
/* CruLox · órbita de productos V4.3.1 — alcance exclusivo: hero central */
.hero-box.crulox-orbit-enabled{
  display:flex!important;flex-direction:column!important;justify-content:flex-start!important;
  align-items:center!important;grid-template-columns:1fr!important;min-height:0!important;
  overflow:hidden!important;isolation:isolate;
  background:radial-gradient(ellipse at 50% 28%,rgba(0,212,255,.095),transparent 52%),radial-gradient(ellipse at 50% 10%,rgba(49,104,225,.08),transparent 65%),linear-gradient(145deg,#081a2d,#06111f 60%,#071523)!important;
}
.hero-box.crulox-orbit-enabled .hero-copy{
  width:100%!important;max-width:100%!important;min-width:0!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;
  justify-content:center!important;text-align:center!important;
  padding:17px 24px 17px!important;
}
.hero-box.crulox-orbit-enabled .hero-copy > h1,
.hero-box.crulox-orbit-enabled .hero-copy > p{margin-left:auto!important;margin-right:auto!important;max-width:850px!important;text-align:center!important}
.hero-box.crulox-orbit-enabled .hero-title-line{margin:0 auto 12px!important}
.hero-box.crulox-orbit-enabled .hero-actions{justify-content:center!important;display:flex!important;width:min(100%,290px)!important;margin:17px auto 0!important}
.hero-box.crulox-orbit-enabled .hero-art{width:100%!important;padding:0 24px 22px!important;justify-content:center!important;align-items:center!important}
.hero-box.crulox-orbit-enabled .hero-mini{width:100%!important;max-width:740px!important;margin:0 auto!important;grid-template-columns:repeat(3,minmax(0,1fr))!important}
.crulox-orbit-stage{
  position:relative;isolation:isolate;width:min(100%,1090px);height:386px;
  flex:0 0 auto;margin:0 auto 5px;touch-action:pan-y;
  user-select:none;-webkit-user-select:none;
}
.crulox-orbit-stage::before{
  content:"";position:absolute;inset:15% 20%;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse at center,rgba(2,218,255,.10) 0%,rgba(2,148,255,.025) 44%,transparent 72%);
  filter:blur(14px);
}
.crulox-orbit-track{
  position:absolute;left:50%;top:50%;width:var(--cru-orbit-w,80%);height:var(--cru-orbit-h,54%);
  border:1px solid rgba(37,212,252,.20);border-radius:50%;z-index:9;pointer-events:none;
  transform:translate(-50%,-50%) rotate(-8deg);
  box-shadow:0 0 27px rgba(13,194,255,.045),inset 0 0 18px rgba(13,194,255,.035);
}
.crulox-orbit-track::before{
  content:"";position:absolute;inset:14px;border:1px dashed rgba(88,169,234,.095);
  border-radius:50%;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{
  position:absolute!important;left:50%!important;top:50%!important;z-index:205!important;
  width:146px!important;height:146px!important;max-width:none!important;
  transform:translate(-50%,-50%)!important;margin:0!important;padding:18px!important;
  display:flex!important;justify-content:center!important;align-items:center!important;
  border-radius:50%!important;
  background:radial-gradient(circle at 50% 42%,rgba(10,36,58,.95),rgba(5,17,31,.82) 72%)!important;
  box-shadow:0 0 0 1px rgba(81,217,251,.14),0 0 0 15px rgba(15,180,225,.025),0 20px 60px rgba(0,0,0,.36),inset 0 0 30px rgba(3,203,255,.045)!important;
  pointer-events:none;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top::before{
  content:"";position:absolute;inset:-11px;border:1px solid rgba(61,208,247,.18);
  border-radius:50%;pointer-events:none;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top > img{
  display:block!important;width:100%!important;height:100%!important;max-width:none!important;
  margin:0!important;object-fit:contain!important;position:relative;z-index:2;
  filter:drop-shadow(0 8px 20px rgba(0,190,255,.18))!important;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-copy{display:none!important}
.crulox-orbit-item{
  position:absolute;left:0;top:0;z-index:60;display:block;width:88px;height:88px;
  padding:0;border:1px solid rgba(133,214,250,.18);border-radius:18px;
  color:#f2faff;background:linear-gradient(145deg,rgba(18,43,66,.97),rgba(7,19,35,.97));
  box-shadow:0 15px 34px rgba(0,0,0,.36),inset 0 1px rgba(255,255,255,.08);
  cursor:pointer;outline:0;will-change:transform,opacity;
  overflow:visible;transition:border-color .2s,box-shadow .2s;
  -webkit-tap-highlight-color:transparent;
}
.crulox-orbit-item:hover,.crulox-orbit-item:focus-visible{
  border-color:rgba(34,225,255,.75);
  box-shadow:0 14px 38px rgba(0,0,0,.5),0 0 24px rgba(0,217,255,.20);
}
.crulox-orbit-item:focus-visible{outline:2px solid #5de8ff;outline-offset:4px}
.crulox-orbit-item-inner{position:absolute;inset:5px;overflow:hidden;border-radius:13px;background:rgba(7,21,37,.9);display:grid;place-items:center}
.hero-box.crulox-orbit-enabled .crulox-orbit-item img{
  width:100%!important;height:100%!important;max-width:none!important;
  display:block!important;object-fit:contain!important;object-position:center!important;
  background:transparent!important;border:0!important;border-radius:0!important;
  box-shadow:none!important;filter:none!important;pointer-events:none;
}
.crulox-orbit-item-name{
  position:absolute;top:calc(100% + 7px);left:50%;transform:translateX(-50%);
  max-width:154px;min-width:95px;padding:5px 8px;border-radius:8px;
  background:rgba(4,18,31,.94);border:1px solid rgba(130,211,250,.14);
  color:#e5f7ff;font-size:10px;font-weight:750;line-height:1.23;white-space:normal;
  text-align:center;pointer-events:none;
  opacity:0;transition:opacity .18s;
  box-shadow:0 8px 18px rgba(0,0,0,.35);
}
.crulox-orbit-item:hover .crulox-orbit-item-name,
.crulox-orbit-item:focus-visible .crulox-orbit-item-name{opacity:1}
.crulox-orbit-stage[data-dragging] .crulox-orbit-item{cursor:grabbing}
@media(max-width:760px){
 .crulox-orbit-stage{height:310px}
 .hero-box.crulox-orbit-enabled .hero-copy{padding:12px 15px 16px!important}
 .hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{width:118px!important;height:118px!important;padding:11px!important}
 .hero-box.crulox-orbit-enabled .hero-art{padding:0 14px 17px!important}
 .hero-box.crulox-orbit-enabled .hero-mini{max-width:100%!important}
}
@media(max-width:520px){
 .crulox-orbit-stage{height:267px;margin-bottom:0}
 .hero-box.crulox-orbit-enabled .hero-copy{padding:6px 10px 12px!important}
 .hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{width:90px!important;height:90px!important;padding:8px!important}
 .hero-box.crulox-orbit-enabled .hero-title-line{font-size:clamp(1.22rem,5.1vw,1.67rem)!important;margin:0 auto 9px!important}
 .hero-box.crulox-orbit-enabled .hero-copy>p{font-size:.71rem!important;white-space:pre-line!important}
 .hero-box.crulox-orbit-enabled .hero-actions{width:100%!important;max-width:360px!important;margin-top:12px!important}
 .hero-box.crulox-orbit-enabled .hero-actions .btn{width:100%!important}
 .hero-box.crulox-orbit-enabled .hero-art{padding:0 10px 14px!important}
 .hero-box.crulox-orbit-enabled .hero-mini div{padding:9px 5px!important}
 .hero-box.crulox-orbit-enabled .hero-mini b{font-size:.59rem!important}
 .hero-box.crulox-orbit-enabled .hero-mini span{font-size:.49rem!important}
 .crulox-orbit-item-name{display:none}
}
@media(max-width:360px){
 .crulox-orbit-stage{height:245px}
 .hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{width:80px!important;height:80px!important;padding:7px!important}
}
@media(prefers-reduced-motion:reduce){
 .crulox-orbit-item{will-change:auto;transition:none!important}
 .crulox-orbit-item-name{transition:none!important}
}
</style>
<style id="crulox-v440-cardnav-menu-only">
/* V4.4.0: sólo aspecto del menú lateral. Mantiene su posición, dimensiones,
   DOM, navegación y comportamiento de los demás módulos de CruLox. */
#drawer.cn440-cardnav{
  --cn-panel:rgba(5,19,33,.94);
  --cn-solid:#071726;
  --cn-edge:rgba(77,205,255,.16);
  --cn-highlight:rgba(189,244,255,.075);
  --cn-text:#effaff;
  --cn-muted:#94b4cc;
  --cn-hover:rgba(0,215,255,.085);
  --cn-ring:#59e9ff;
  --cn-tile:linear-gradient(170deg,#102a40 0%,#091b2d 100%);
  --cn-tile-rim:inset 0 0 0 1px rgba(68,201,255,.11),inset 0 1px 0 rgba(201,250,255,.085),0 4px 10px -4px rgba(0,0,0,.48);
  --cn-shadow:0 24px 48px -20px rgba(0,0,0,.78),0 6px 16px -8px rgba(0,0,0,.52);
  background:var(--cn-panel)!important;
  border-right-color:var(--cn-edge)!important;
  box-shadow:var(--cn-shadow)!important;
  backdrop-filter:blur(20px) saturate(1.6)!important;
  -webkit-backdrop-filter:blur(20px) saturate(1.6)!important;
  transition:none!important; /* la apertura/cierre la controla el resorte de CardNav */
  will-change:transform;
}
#drawer.cn440-cardnav .drawer-head.jmv24-drawer-head{
  background:linear-gradient(180deg,rgba(9,38,57,.96),rgba(5,22,37,.92))!important;
  border-bottom-color:var(--cn-edge)!important;
  box-shadow:inset 0 1px 0 var(--cn-highlight)!important;
}
#drawer.cn440-cardnav .jmv24-drawer-label{color:#6dddf4!important}
#drawer.cn440-cardnav nav .jmv24-nav-item{
  position:relative;
  background:var(--cn-tile)!important;
  border-color:var(--cn-edge)!important;
  box-shadow:var(--cn-tile-rim)!important;
  color:var(--cn-text)!important;
  backface-visibility:hidden;
  -webkit-backface-visibility:hidden;
  transition:background .2s ease,box-shadow .2s ease,border-color .2s ease!important;
}
/* Tres vínculos de la versión base son texto plano: conservarlos íntegros,
   pero no forzarles la columna de icono reservada para enlaces con dos spans. */
#drawer.cn440-cardnav nav .jmv24-nav-item:not(:has(.jmv24-nav-copy)){
  grid-template-columns:minmax(0,1fr)!important;
  overflow-wrap:normal!important;
  word-break:normal!important;
  white-space:normal!important;
}
#drawer.cn440-cardnav nav .jmv24-nav-item:hover,
#drawer.cn440-cardnav nav .jmv24-nav-item:focus-visible{
  background:linear-gradient(180deg,#13425e 0%,#0c2a40 100%)!important;
  border-color:rgba(72,224,255,.42)!important;
  box-shadow:inset 0 1px rgba(197,251,255,.13),0 11px 23px -9px rgba(0,0,0,.62),0 0 16px rgba(0,215,255,.07)!important;
}
#drawer.cn440-cardnav nav .jmv24-nav-item:focus-visible{
  outline:2px solid var(--cn-ring)!important;outline-offset:2px!important;
}
#drawer.cn440-cardnav .jmv24-nav-ico{
  background:var(--cn-tile)!important;
  color:#66eaff!important;
  border-color:var(--cn-edge)!important;
  box-shadow:var(--cn-tile-rim)!important;
}
#drawer.cn440-cardnav .jmv24-nav-copy b{color:var(--cn-text)!important}
#drawer.cn440-cardnav .jmv24-nav-copy small{color:var(--cn-muted)!important}
#drawer.cn440-cardnav .jmv24-drawer-brand-copy b,
#drawer.cn440-cardnav .jmv24-drawer-brand-copy strong{color:var(--cn-text)!important}
#drawer.cn440-cardnav .jmv24-drawer-brand-copy span{color:var(--cn-muted)!important}
#drawer.cn440-cardnav .jmv24-drawer-close{
  background:var(--cn-tile)!important;
  border:1px solid var(--cn-edge)!important;
  box-shadow:var(--cn-tile-rim)!important;
  color:var(--cn-text)!important;
  transition:filter .2s ease,box-shadow .2s ease!important;
}
#drawer.cn440-cardnav .jmv24-drawer-close:hover{filter:brightness(1.2)!important}
#drawer.cn440-cardnav #drawerSocial.jmv24-social-grid .social-pill{
  background:var(--cn-tile)!important;
  border-color:var(--cn-edge)!important;
  box-shadow:var(--cn-tile-rim)!important;
  color:var(--cn-text)!important;
  transition:filter .2s ease,border-color .2s ease!important;
}
#drawer.cn440-cardnav #drawerSocial.jmv24-social-grid .social-pill:hover{
  border-color:rgba(72,224,255,.42)!important;
  color:#aaf6ff!important;filter:brightness(1.15)!important;
}
#drawer.cn440-cardnav .jmv24-drawer-note{
  background:var(--cn-tile)!important;
  border-color:var(--cn-edge)!important;
  color:var(--cn-muted)!important;
  box-shadow:var(--cn-tile-rim)!important;
}
#drawer.cn440-cardnav .jmv24-drawer-note b{color:var(--cn-text)!important}
@media(prefers-reduced-motion:reduce){
 #drawer.cn440-cardnav{will-change:auto!important}
 #drawer.cn440-cardnav nav .jmv24-nav-item,
 #drawer.cn440-cardnav .jmv24-drawer-close,
 #drawer.cn440-cardnav #drawerSocial.jmv24-social-grid .social-pill{transition:none!important}
}
</style>
<!-- CruLox V4.4.3 · Únicamente buscador y estabilidad gráfica del anuncio. -->
<style id="cru443-search-and-stability">
/* Barra de búsqueda ligeramente más compacta, sin cambiar su lugar. */
.header .search-wrap{min-height:36px!important;height:36px!important;border-radius:14px!important}
.header .search-wrap > .search{height:36px!important;min-height:36px!important;border-radius:14px!important;padding-left:35px!important;font-size:.75rem!important;cursor:text!important}
.header .search-icon{left:12px!important;font-size:.75rem!important}
.header .search-clear{width:26px!important;height:26px!important}
#suggestions{display:none!important}
@media(max-width:760px){.header .search-wrap{height:35px!important;min-height:35px!important}.header .search-wrap > .search{height:35px!important;min-height:35px!important;font-size:.70rem!important}}
/* Buscador emergente: vista propia, sin modificar los modales de compra o administración. */
#cru443Search{position:fixed;inset:0;z-index:4900;display:none;align-items:flex-start;justify-content:center;overflow-y:auto;overscroll-behavior:contain;padding:clamp(14px,6vh,60px) 12px 24px;background:rgba(2,8,17,.92);color:#e8faff;font-family:inherit}
#cru443Search.cru443-open{display:flex}
body.cru443-search-active{overflow:hidden!important}
#cru443Search *{box-sizing:border-box}
.cru443-shell{width:min(770px,100%);max-height:min(89dvh,900px);display:flex;flex-direction:column;overflow:hidden;border-radius:23px;background:linear-gradient(150deg,#0c2337,#061321 75%);border:1px solid rgba(72,206,249,.34);box-shadow:0 32px 90px rgba(0,0,0,.63),inset 0 1px rgba(255,255,255,.07)}
.cru443-top{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:19px 20px 13px}
.cru443-title{font-size:1.03rem;font-weight:900;letter-spacing:-.025em;line-height:1.25;margin:0}
.cru443-sub{font-size:.66rem;color:#98b8cb;margin-top:4px}
.cru443-close{flex:0 0 39px;min-height:39px;border:1px solid rgba(142,219,249,.23);border-radius:12px;background:rgba(255,255,255,.045);color:#e3f9ff;font-size:1.22rem}
.cru443-input-row{display:flex;align-items:center;gap:10px;margin:0 20px 13px;padding:0 13px;border:1px solid rgba(80,217,255,.33);border-radius:15px;background:#081b2d;box-shadow:inset 0 1px rgba(255,255,255,.04)}
.cru443-input-row svg{flex:0 0 18px;color:#60dbf5}
#cru443Input{width:100%;min-width:0;height:51px;outline:0;border:0;background:transparent;color:white;font-size:.86rem}
#cru443Input::placeholder{color:#819daf}
.cru443-result-head{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:2px 20px 11px;color:#a4c9db;font-size:.66rem;font-weight:750}
.cru443-result-head strong{color:#82eefe}
#cru443Results{flex:1 1 auto;min-height:0;overflow:auto;overscroll-behavior:contain;padding:0 13px 11px;display:grid;align-content:start;gap:7px;scrollbar-color:#277a98 transparent;scrollbar-width:thin}
.cru443-result{width:100%;display:grid;grid-template-columns:66px minmax(0,1fr) auto;gap:13px;align-items:center;text-align:left;padding:9px;border:1px solid rgba(84,173,215,.13);border-radius:15px;background:linear-gradient(100deg,rgba(22,61,82,.52),rgba(8,25,41,.66));color:#e9f9ff;transition:border-color .15s ease,background .15s ease}
.cru443-result:hover,.cru443-result:focus-visible,.cru443-result.cru443-selected{border-color:rgba(46,222,255,.64);background:rgba(31,90,116,.49);outline:0}
.cru443-result img{width:66px;height:66px;object-fit:cover;border-radius:11px;background:#061322}
.cru443-info{min-width:0;display:flex;flex-direction:column;gap:4px}
.cru443-info b{font-size:.78rem;line-height:1.35;overflow-wrap:anywhere}
.cru443-info small{font-size:.62rem;color:#90b7c9;line-height:1.35}
.cru443-price{white-space:nowrap;color:#29defb;font-size:.79rem;font-weight:900}
.cru443-empty{padding:32px 15px;text-align:center;color:#acc4d3;font-size:.77rem;line-height:1.55}
.cru443-footer{flex:0 0 auto;display:flex;align-items:center;gap:9px;justify-content:space-between;padding:13px 20px 17px;border-top:1px solid rgba(100,200,245,.13)}
.cru443-footer small{font-size:.60rem;color:#779aad}
#cru443All{min-height:41px;padding:9px 16px;border-radius:12px;border:1px solid rgba(126,237,255,.55);background:linear-gradient(105deg,#70f0ff,#1dbaf4);color:#052034;font-weight:900;font-size:.72rem}
#cru443All:disabled{opacity:.38;cursor:default}
@media(max-width:600px){#cru443Search{padding:max(8px,env(safe-area-inset-top)) 8px 8px}.cru443-shell{border-radius:20px;max-height:calc(100dvh - 16px)}.cru443-top{padding:16px 15px 11px}.cru443-input-row{margin:0 14px 12px}#cru443Input{height:46px}.cru443-result-head{padding:0 15px 10px}#cru443Results{padding:0 9px 10px}.cru443-result{grid-template-columns:56px minmax(0,1fr) auto;gap:9px;padding:8px}.cru443-result img{width:56px;height:56px}.cru443-info b{font-size:.70rem}.cru443-info small{font-size:.56rem}.cru443-price{font-size:.68rem}.cru443-footer{padding:11px 14px 13px}.cru443-footer small{max-width:48%;line-height:1.3}}
/* Evitar artefactos de composición: sin blur a pantalla completa, giros 3D o capas animadas sobre el anuncio. */
#cru435Welcome{-webkit-backdrop-filter:none!important;backdrop-filter:none!important;transition:none!important}
#cru435Welcome .cru435-panel,#cru435Welcome.cru435-open .cru435-panel{transform:none!important;-webkit-transform:none!important;opacity:1!important;transition:none!important;isolation:auto!important;will-change:auto!important}
#cru435Welcome .cru438-shine,#cru435Welcome .cru435-art::after,#cru435Welcome .cru438-starlight,#cru435Welcome .cru438-product{animation:none!important;will-change:auto!important}
#cru435Welcome .cru438-shine{opacity:.45!important}
#cru435Welcome .cru438-ticket,#cru435Welcome .cru438-product,#cru435Welcome .cru435-close{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
#cru435Welcome .cru435-art{contain:none!important}
#cru435Welcome .cru435-copy,#cru435Welcome .cru435-copy > *{opacity:1!important;visibility:visible!important;filter:none!important;content-visibility:visible!important}
#cru435Welcome .cru435-explore::after{display:none!important}
@media(prefers-reduced-motion:reduce){.cru443-result{transition:none!important}}
</style>
<style id="cru445-first-paint-final-visual">
/* Inicialización visual de la versión vigente antes del primer render; sin overlay ni pantallas de carga. */

/* CruLox V4.3.2 | Ajustes exclusivamente visuales de tienda y botones del hero */
.hero-box.crulox-orbit-enabled{
  border-color:rgba(49,207,245,.23)!important;
  box-shadow:0 25px 76px rgba(0,0,0,.42),inset 0 1px 0 rgba(188,244,255,.06),0 0 42px rgba(0,181,250,.035)!important;
}
.hero-box.crulox-orbit-enabled::before{
  animation:cru432-ambient 13s ease-in-out infinite alternate;
  pointer-events:none;
}
.hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{
  animation:cru432-logo-halo 6s ease-in-out infinite alternate;
}
/* A los dos controles del hero se les asigna una fila coherente; ninguna acción cambia. */
.hero-box.crulox-orbit-enabled .hero-actions,
.hero-box.crulox-orbit-enabled .hero-actions.jmv356-hero-actions{
  position:relative!important;
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:12px!important;
  align-items:stretch!important;
  justify-content:center!important;
  width:min(100%,610px)!important;
  max-width:610px!important;
  margin:24px auto 0!important;
  padding:2px!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{
  box-sizing:border-box!important;
  position:relative!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  flex:1 1 auto!important;
  gap:10px!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  min-height:61px!important;
  padding:15px 16px!important;
  border-radius:18px!important;
  font-family:inherit!important;
  font-weight:850!important;
  font-size:clamp(.78rem,1.45vw,.94rem)!important;
  line-height:1.2!important;
  letter-spacing:-.01em!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:clip!important;
  cursor:pointer!important;
  -webkit-tap-highlight-color:transparent!important;
  transition:transform .25s cubic-bezier(.2,.75,.26,1),box-shadow .28s ease,border-color .28s ease,filter .28s ease!important;
  animation:cru432-button-intro .68s cubic-bezier(.2,.85,.22,1) backwards;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport{
  color:#e9f9ff!important;
  border:1px solid rgba(117,217,251,.25)!important;
  background:linear-gradient(125deg,rgba(24,54,77,.96),rgba(11,31,49,.96))!important;
  box-shadow:inset 0 1px 0 rgba(208,244,255,.065),0 11px 26px rgba(0,0,0,.18)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{
  color:#03202c!important;
  border:1px solid rgba(94,246,255,.88)!important;
  background:linear-gradient(120deg,#78f3ff 0%,#21dbf3 52%,#15aaf3 100%)!important;
  box-shadow:0 11px 31px rgba(0,198,244,.23),inset 0 1px rgba(255,255,255,.50),inset 0 -2px rgba(4,75,116,.12)!important;
  text-shadow:none!important;
  animation-delay:.11s;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::before,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::before{
  content:""!important;
  display:inline-block!important;
  flex:0 0 23px!important;
  width:23px!important;
  height:23px!important;
  background-size:contain!important;
  background-repeat:no-repeat!important;
  background-position:center!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::before{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2377edff%22%20stroke-width%3D%221.9%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M20%2011.5a8.1%208.1%200%200%201-8.1%208.1%208.3%208.3%200%200%201-3.5-.8L4%2020l1.2-4.2a8.1%208.1%200%201%201%2014.8-4.3Z%22%2F%3E%3Cpath%20d%3D%22M8.5%2011.5h7%22%2F%3E%3C%2Fsvg%3E")!important}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::before{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23032435%22%20stroke-width%3D%221.9%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%203.5h16V21l-3.4-2-3.1%202-3.1-2L7%2021l-3-2V3.5Z%22%2F%3E%3Cpath%20d%3D%22M8%208h8M8%2012h5%22%2F%3E%3Cpath%20d%3D%22m14.5%2015.5%201.4%201.4%202.4-2.5%22%2F%3E%3C%2Fsvg%3E")!important}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::after,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::after{content:none!important;display:none!important;margin-left:0!important;opacity:0!important;transition:none!important;}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover{
  transform:translate3d(0,-3px,0)!important;
  filter:brightness(1.07)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover{
  border-color:rgba(105,235,255,.54)!important;
  box-shadow:inset 0 1px rgba(225,255,255,.1),0 15px 34px rgba(0,0,0,.28),0 0 24px rgba(1,219,255,.08)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover{
  box-shadow:0 16px 39px rgba(0,202,251,.34),inset 0 1px rgba(255,255,255,.6)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:hover::after,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:hover::after{
  transform:translate(2px,-2px)!important;opacity:1!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:active,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:active{
  transform:translateY(1px) scale(.985)!important;
  filter:brightness(.98)!important;
}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport:focus-visible,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn:focus-visible{
  outline:3px solid #f6fcff!important;outline-offset:4px!important;
}
/* Mejoras visuales de la tienda pública; no afectan panel ni funcionalidad. */
body:not(:has(#adminOverlay.open)) .search-wrap .search:focus-visible{
  border-color:rgba(55,228,254,.7)!important;
  box-shadow:0 0 0 4px rgba(0,216,255,.085),0 12px 36px rgba(0,0,0,.14)!important;
  transition:box-shadow .25s ease,border-color .25s ease!important;
}
.benefits .benefit{
  position:relative;
  overflow:hidden;
  border-color:rgba(101,200,243,.12)!important;
  background:radial-gradient(circle at 4% 5%,rgba(17,211,249,.075),transparent 70%),linear-gradient(145deg,rgba(9,33,48,.95),rgba(5,20,33,.98))!important;
  box-shadow:inset 0 1px rgba(211,255,255,.04),0 13px 29px rgba(0,0,0,.17)!important;
  transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease!important;
}
.benefits .benefit:hover{
  transform:translateY(-3px)!important;
  border-color:rgba(55,215,255,.34)!important;
  box-shadow:0 17px 34px rgba(0,0,0,.26),0 0 20px rgba(0,191,250,.06)!important;
}
.benefits .benefit i{transition:transform .3s cubic-bezier(.2,.75,.3,1),background .3s ease!important}
.benefits .benefit:hover i{transform:translateY(-2px) scale(1.065)!important;background:rgba(0,203,255,.14)!important}
#catalog .product,#combos .combo,#how .step,#faq .faq{
  transition:transform .33s cubic-bezier(.2,.75,.2,1),box-shadow .33s ease,border-color .33s ease!important;
}
#catalog .product:hover,#catalog .product:focus-within{
  transform:translateY(-5px)!important;
  box-shadow:0 22px 48px rgba(0,0,0,.32),0 0 22px rgba(0,210,255,.055)!important;
}
#combos .combo:hover,#how .step:hover,#faq .faq:hover{
  transform:translateY(-3px)!important;
  border-color:rgba(63,206,251,.25)!important;
  box-shadow:0 20px 42px rgba(0,0,0,.26)!important;
}
.category-scroll .cat,.product-actions button,.float-btn{
  transition:transform .25s cubic-bezier(.2,.75,.3,1),background .25s ease,box-shadow .25s ease,border-color .25s ease!important;
}
.category-scroll .cat:hover,.product-actions button:hover:not(:disabled),.float-btn:hover{transform:translateY(-2px)!important}
.category-scroll .cat:focus-visible,.product-actions button:focus-visible,.float-btn:focus-visible{outline:2px solid var(--cyan)!important;outline-offset:3px!important}
/* Apariciones progresivas livianas; solo se activan si el navegador soporta observer. */
.cru432-animate .cru432-reveal{
  opacity:0;
  transform:translate3d(0,17px,0);
  transition:opacity .68s ease,transform .68s cubic-bezier(.18,.74,.2,1)!important;
  transition-delay:var(--cru432-delay,0ms)!important;
}
.cru432-animate .cru432-reveal.cru432-visible{opacity:1;transform:translate3d(0,0,0)}
@keyframes cru432-ambient{
  0%{opacity:.6;transform:translate3d(0,0,0) scale(1)}
  100%{opacity:.95;transform:translate3d(-15px,7px,0) scale(1.08)}
}
@keyframes cru432-logo-halo{
  0%{box-shadow:0 0 0 1px rgba(60,207,251,.11),0 0 0 15px rgba(15,180,225,.025),0 20px 55px rgba(0,0,0,.33),inset 0 0 25px rgba(3,203,255,.035)}
  100%{box-shadow:0 0 0 1px rgba(60,207,251,.23),0 0 0 19px rgba(15,180,225,.05),0 20px 60px rgba(0,0,0,.38),inset 0 0 36px rgba(3,203,255,.085)}
}
@keyframes cru432-button-intro{
  from{opacity:.15;transform:translate3d(0,15px,0) scale(.975)}
  to{opacity:1;transform:translate3d(0,0,0) scale(1)}
}
@media(max-width:620px){
  .hero-box.crulox-orbit-enabled .hero-actions,
  .hero-box.crulox-orbit-enabled .hero-actions.jmv356-hero-actions{
    width:100%!important;max-width:550px!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:8px!important;margin:16px auto 0!important;
  }
  .hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
  .hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{
    min-height:54px!important;padding:11px 9px!important;
    gap:6px!important;border-radius:15px!important;font-size:clamp(.66rem,3vw,.79rem)!important;
  }
  .hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::before,
  .hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::before{
    flex-basis:19px!important;width:19px!important;height:19px!important;
  }
  .hero-box.crulox-orbit-enabled .hero-actions > #heroSupport::after,
  .hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn::after{margin-left:0!important}
}
@media(max-width:350px){
  .hero-box.crulox-orbit-enabled .hero-actions,
  .hero-box.crulox-orbit-enabled .hero-actions.jmv356-hero-actions{grid-template-columns:1fr!important}
  .hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
  .hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{min-height:49px!important;font-size:.76rem!important}
}
@media(prefers-reduced-motion:reduce){
  .hero-box.crulox-orbit-enabled::before,
  .hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top,
  .hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
  .hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{animation:none!important}
  .cru432-animate .cru432-reveal{opacity:1!important;transform:none!important;transition:none!important}
  .benefits .benefit,.benefits .benefit i,#catalog .product,#combos .combo,#how .step,#faq .faq{transition:none!important}
}

</style>

<style id="crulox-v446-stability-first-paint">
/* V4.4.6: el contenido es visible desde el primer pintado, sin pantalla de carga. */
.cru432-animate .cru432-reveal{opacity:1!important;transform:none!important;transition:none!important;transition-delay:0ms!important}
.hero-box.crulox-orbit-enabled .hero-actions > #heroSupport,
.hero-box.crulox-orbit-enabled .hero-actions > #jmMyPurchasesBtn{animation:none!important}
/* Reducir trabajo gráfico móvil; mantener la órbita y los efectos al tocar. */
@media(max-width:800px){
 .hero-box.crulox-orbit-enabled::before{animation:none!important}
 .hero-box.crulox-orbit-enabled .crulox-orbit-stage .hero-brand-top{animation:none!important}
}
</style>

<style id="cru449-menu-information-style">
/* CruLox V4.4.9. Únicamente contenido informativo del menú lateral. */
#drawer .cru449-info[hidden],#drawer #drawerSocial[hidden]{display:none!important}
#drawer .cru449-info{
  display:block;max-width:100%;min-width:0;padding:14px 15px 16px;
  border-radius:16px;border:1px solid rgba(56,218,246,.31);
  background:linear-gradient(145deg,#09283c,#061b2d);
  color:#c4dce9;box-shadow:inset 0 1px rgba(174,248,255,.06),0 10px 24px rgba(0,0,0,.15)
}
#drawer .cru449-info-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
#drawer .cru449-info-head strong{color:#73e7fa;font-size:.8rem;font-weight:850}
#drawer #cru449InfoClose{width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;
  border-radius:10px;border:1px solid rgba(104,213,246,.25);background:rgba(6,42,65,.7);
  color:#effaff;cursor:pointer;font-size:1.18rem}
#drawer #cru449InfoBody{white-space:pre-line;font-size:.73rem;line-height:1.62;color:#b6d3e3;margin:10px 0 0}
#drawer.cn440-cardnav nav .jmv24-nav-item[aria-expanded="true"]{
  border-color:rgba(85,231,255,.65)!important;
  background:linear-gradient(170deg,#114361,#0a263e)!important;
  box-shadow:0 0 0 1px rgba(29,203,239,.10),inset 0 1px rgba(190,252,255,.13)!important;
}
#drawer #cru449InfoClose:focus-visible{outline:2px solid #7df3ff;outline-offset:3px}
</style>
</head>
<body>

<!-- Políticas accesibles y obligatorias. No son una pantalla de carga. -->
<section id="cru448PolicyGate" role="dialog" aria-modal="true" aria-labelledby="cru448Title" aria-describedby="cru448Intro">
 <div class="cru448-wrap">
  <header class="cru448-heading">
   <div class="cru448-symbol" aria-hidden="true">✦</div>
   <div class="cru448-brand">CRULOX · PLATAFORMAS DIGITALES</div>
   <h1 id="cru448Title" tabindex="-1">Políticas de uso y privacidad</h1>
   <p class="cru448-sub" id="cru448Intro">Lee las condiciones antes de entrar. El acceso a CruLox requiere tu aceptación expresa de ambos documentos.</p>
  </header>
  <div class="cru448-body">
   <div class="cru448-strip"><strong>Versión:</strong> 17 de noviembre de 2026 · Se solicitará una nueva aceptación cuando estas políticas se actualicen.</div>
   <div class="cru448-document">
    <h2 id="cru448Terms">I. Condiciones de uso de CruLox</h2>
    <h3>1. Alcance del servicio</h3>
    <p>CruLox es una tienda de productos y servicios digitales. Su catálogo puede incluir suscripciones, perfiles, invitaciones, recargas por identificador de jugador, accesos a cursos y otros servicios descritos en cada ficha. No se ofrece envío físico por el solo hecho de comprar un servicio digital.</p>
    <h3>2. Registro y veracidad de datos</h3>
    <p>Para crear una cuenta, el sistema puede solicitar nombre completo, nombre de usuario, correo electrónico, teléfono, departamento, municipio, dirección, referencia y contraseña. Aunque la operación comercial sea digital, algunas versiones de los formularios conservan campos de dirección y referencia. Debes proporcionar datos propios, exactos y actualizados; no debes suplantar identidades ni utilizar datos de terceros sin autorización.</p>
    <h3>3. Compras, reservas y activaciones</h3>
    <p>La información definitiva de cada servicio, incluidos su precio, vigencia, datos necesarios, disponibilidad, tiempo estimado y modalidad de entrega, se revisa en el producto y durante el pedido. Las solicitudes y reservas pueden quedar pendientes de verificación de pago y de disponibilidad. La confirmación de un pedido no equivale, por sí sola, a confirmar el pago o una entrega ya realizada.</p>
    <h3>4. Pagos y comprobantes</h3>
    <p>Utiliza únicamente los métodos y cuentas oficiales mostrados por CruLox en el momento de pagar. El sistema puede solicitar método de pago, referencia y comprobante de transferencia o depósito. Está prohibido presentar pagos falsos, comprobantes manipulados, usar identidades ajenas o intentar obtener servicios sin cumplir las condiciones de pago. CruLox puede revisar los datos aportados y suspender el trámite de un pedido ante inconsistencias, sin perjuicio de los derechos legales que correspondan.</p>
    <h3>5. Uso permitido y prohibiciones</h3>
    <ul>
     <li>Usa el catálogo, las promociones y el soporte solamente para consultas y operaciones legítimas.</li>
     <li>No manipules precios, códigos, inventarios, reservas, cuentas, sistemas de acceso o comprobantes.</li>
     <li>No introduzcas malware, envíes spam, extraigas datos ajenos ni intentes acceder al panel administrativo sin autorización.</li>
     <li>No compartas públicamente accesos digitales ni los revendas cuando las condiciones específicas del producto no lo permitan.</li>
     <li>Respeta las condiciones aplicables al servicio o plataforma de terceros que adquieras.</li>
    </ul>
    <h3>6. Promociones y devoluciones</h3>
    <p>Los descuentos están sujetos a su vigencia, límites, compra mínima, disponibilidad y demás reglas visibles en CruLox. Los anuncios señalados como “ejemplo” o “no canjeable” no constituyen una oferta real. Cualquier cancelación, reembolso o corrección se evaluará según el producto, su estado de entrega, las condiciones comunicadas y la legislación aplicable. Esta política no elimina derechos irrenunciables del consumidor.</p>
    <h3>7. Seguridad de la cuenta e incidencias</h3>
    <p>Protege tus credenciales y cierra sesión en equipos compartidos. Informa al canal de soporte de compras no reconocidas, accesos sospechosos o errores de entrega. El uso fraudulento puede generar restricciones proporcionadas de acceso o revisión, sujetas a las normas aplicables.</p>
    <h2 id="cru448Privacy">II. Política de privacidad y tratamiento de datos</h2>
    <h3>1. Datos que la tienda puede recopilar</h3>
    <ul>
     <li><strong>Cuenta e identificación:</strong> nombre, usuario, correo, teléfono, contraseña convertida a un valor hash, departamento, municipio, dirección y referencia cuando el formulario los solicite.</li>
     <li><strong>Actividad comercial:</strong> productos consultados o adquiridos, carrito, favoritos, promociones, pedidos, estados de pago, totales, fechas e historial.</li>
     <li><strong>Entrega del servicio:</strong> correo o usuario de activación, identificador de jugador y región/servidor, datos para invitaciones o cursos, según el producto específico.</li>
     <li><strong>Pagos:</strong> método seleccionado, referencia, archivos o imágenes de comprobantes y datos que aparezcan en ellos.</li>
     <li><strong>Soporte:</strong> mensajes, información de contacto y contexto de consultas. Si utilizas voluntariamente funciones de voz, cámara o archivos, sus contenidos pueden procesarse localmente o compartirse a través de la función elegida.</li>
    </ul>
    <h3>2. Para qué se utilizan</h3>
    <p>Para registrar y autenticar cuentas, procesar solicitudes, revisar pagos, gestionar reservas, entregar o activar servicios, comunicar el estado de pedidos, responder consultas, prevenir abusos y administrar la operación. El uso de datos para campañas publicitarias o comunicaciones comerciales no queda autorizado automáticamente por aceptar estas políticas; requerirá los controles o permisos que correspondan cuando se implemente.</p>
    <h3>3. Dónde se almacenan actualmente</h3>
    <p>La versión HTML actual utiliza almacenamiento del navegador, incluido <strong>localStorage</strong>, <strong>sessionStorage</strong> y, para ciertas funciones y comprobantes, <strong>IndexedDB</strong>. Algunos registros pueden conservarse en ese dispositivo hasta que se eliminen, se borren los datos del navegador o se apliquen las rutinas particulares disponibles. No se garantiza una sincronización central entre dispositivos en esta versión. Si en el futuro se incorpora un hosting y una base de datos, habrá que actualizar este aviso para describir ese tratamiento real.</p>
    <h3>4. Compartición y servicios externos</h3>
    <p>Las compras y consultas se gestionan dentro de CruLox. Cuando el usuario abre un enlace externo informativo, un servicio de pago o una función para compartir archivos, los datos enviados pasan a estar sujetos también a las políticas del destinatario. El sistema contempla integraciones de mensajería y servicios externos cuya configuración puede variar. No se debe asumir que todas están activadas. El personal que gestione pedidos y soporte puede visualizar información necesaria para atender esas operaciones en las funciones disponibles.</p>
    <h3>5. Seguridad y precauciones</h3>
    <p>El registro principal de cuentas transforma la contraseña en un hash; esto no sustituye controles de autenticación y autorización del lado del servidor. El almacenamiento en un navegador o archivo HTML, especialmente en dispositivos compartidos, no ofrece por sí solo protección equivalente a una infraestructura de producción. No envíes contraseñas bancarias, PIN, códigos de verificación ni imágenes con información financiera innecesaria. Oculta los datos ajenos a la operación en los comprobantes, cuando sea posible.</p>
    <h3>6. Conservación, acceso, corrección y solicitudes</h3>
    <p>La información puede seguir almacenada en el navegador o en copias de respaldo creadas mediante las funciones del sistema; no existe un borrado universal automático comprobado para todos los datos. Puedes consultar los datos visibles de tu cuenta y solicitar corrección o eliminación de información que no deba conservarse mediante el soporte disponible en la tienda, sujeto a verificaciones de identidad, requisitos operativos y obligaciones legales que correspondan. Borrar la caché o el almacenamiento local puede hacer que se pierdan datos no sincronizados.</p>
    <h3>7. Permisos del dispositivo y terceros</h3>
    <p>Las funciones opcionales que utilicen cámara, micrófono, archivos o herramientas de compartir requieren la acción del usuario y, cuando aplique, los permisos del navegador. Rechazar esos permisos puede impedir solo esa función. Los proveedores externos pueden tener sus propias reglas de privacidad y conservación.</p>
    <h3>8. Cambios en estas políticas</h3>
    <p>Al actualizar las condiciones de uso o privacidad de forma material, CruLox deberá informar el nuevo texto y solicitar nuevamente su aceptación antes de permitir el uso de esta interfaz.</p>
    <div class="cru448-important"><strong>Decisión de acceso:</strong> aceptar estas dos políticas habilita la navegación por esta tienda en este navegador. Rechazarlas mantiene la tienda bloqueada. Esta verificación del archivo HTML no reemplaza controles de acceso en un servidor cuando el sistema se publique en línea.</div>
   </div>
   <div class="cru448-consent">
    <label class="cru448-consent-line" for="cru448Check"><input type="checkbox" id="cru448Check"><span>He leído y <strong>acepto expresamente las Condiciones de uso y la Política de privacidad</strong> de CruLox.</span></label>
    <div class="cru448-actions"><button type="button" id="cru448Decline">No aceptar</button><button type="button" id="cru448Accept" disabled>Aceptar y entrar</button></div>
    <button type="button" id="cru448Back">Volver a la tienda (mantener aceptación)</button>
    <p class="cru448-notice" role="status" id="cru448Notice" aria-live="polite"></p>
   </div>
  </div>
  <p class="cru448-foot">CruLox · Documento mostrado antes de permitir el acceso a la tienda.</p>
 </div>
</section>
<div class="loader hide" id="loader" style="display:none;pointer-events:none" aria-hidden="true"><div class="loader-box"><img class="loader-logo" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="CRULOX"/><div class="loader-ring"></div><p>Preparando la tienda</p></div></div>
<header class="header"><div class="container header-row">
<button class="icon-btn menu-btn" id="menuBtn" aria-label="Abrir menú">☰</button>
<a class="brand" href="#top" aria-label="Inicio"><img src="data:image/webp;base64," alt="CRULOX" decoding="async"/></a>
<div class="search-wrap"><span class="search-icon">⌕</span><input class="search" id="searchInput" placeholder="Buscar productos..." autocomplete="off" role="combobox" aria-expanded="false"/><button class="search-clear" id="searchClear">✕</button><div class="suggestions" id="suggestions"></div></div>
<div class="header-actions"><button class="icon-btn" id="notificationBtn" type="button" aria-label="Notificaciones"><svg class="jmv23-bell" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 21h4"></path></svg><span class="count" id="notificationCount" hidden>0</span></button><button class="icon-btn" id="profileBtn" aria-label="Perfil"><span class="profile-dot" id="profileDot">P</span></button><button class="icon-btn" id="cartBtn" aria-label="Carrito">🛒<span class="count" id="cartCount">0</span></button><button class="icon-btn" id="favBtn" aria-label="Favoritos">♥<span class="count fav" id="favCount">0</span></button></div>
</div></header>
<div id="top"></div>
<div class="drawer-overlay" id="drawerOverlay"></div><aside class="drawer" id="drawer"><div class="drawer-head"><img class="drawer-logo" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="CRULOX"/><button class="close-btn" id="drawerClose">✕</button></div><nav><a href="#catalog">📦 Catálogo</a><a href="#combos">🔥 Combos</a><a href="#how">📖 Cómo comprar</a><a href="#faq">❓ Preguntas frecuentes</a><button id="drawerProfile">👤 Perfil</button><button id="drawerFavorites">♥ Favoritos</button><button id="drawerCart">🛒 Carrito</button></nav><div class="drawer-social" id="drawerSocial"></div></aside>
<main>
<section class="hero"><div class="container"><div class="hero-box crulox-orbit-enabled"><div class="hero-copy"><div class="crulox-orbit-stage" id="cruloxOrbitHero" aria-label="Productos CruLox en órbita alrededor del logotipo"><div class="crulox-orbit-track" aria-hidden="true"></div><div class="hero-brand-top"><img src="data:image/webp;base64," alt="CRULOX" decoding="async"/></div></div><h1 class="hero-title-line">Elige <span>·</span> Compra <span>·</span> <strong>Recibe digital.</strong></h1><p id="heroSubtitle">Compra digital simple, segura y transparente.
De Guatemala al mundo: un marketplace confiable.</p><div class="hero-actions jmv356-hero-actions"><button class="btn btn-secondary" id="heroSupport" type="button">Abrir chat</button><button type="button" id="jmMyPurchasesBtn">Mis compras</button></div></div><div class="hero-art"><div class="hero-mini"><div><b>100% DIGITAL</b><span>Sin envíos físicos</span></div><div><b>CHAT INTERNO</b><span>Atención dentro del sistema</span></div><div><b>5 MÉTODOS</b><span>Pagos disponibles</span></div></div></div></div></div></section>
<section class="benefits"><div class="container"><div class="benefit-grid"><div class="benefit"><i>⚡</i><div><b>Entrega digital</b><span>Recibes acceso, recarga o activación</span></div></div><div class="benefit"><i>✓</i><div><b>Datos claros</b><span>Solo pedimos lo necesario</span></div></div><div class="benefit"><i>🔒</i><div><b>Compra acompañada</b><span>Confirmación antes de completar</span></div></div><div class="benefit"><i>💬</i><div><b>Chat interno</b><span>Soporte desde tu cuenta</span></div></div></div></div></section>
<section class="section" id="catalog"><div class="container"><div class="section-head"><div><span class="section-kicker">Todo lo que vendemos es digital</span><h2 class="section-title">Servicios <span>disponibles</span></h2></div></div><div class="category-scroll" id="categoryChips"></div><div class="products" id="productsGrid"></div></div></section>
<section class="section" id="combos"><div class="container"><div class="section-head"><div><span class="section-kicker">Más valor en una sola compra</span><h2 class="section-title">Combos</h2></div></div><div class="combos" id="combosGrid"></div></div></section>
