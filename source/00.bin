<title>CRULOX · Plataformas Digitales</title>
<link rel="icon" type="image/png" href="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" />

<script id="crulox-storage-compat-v430">
(()=>{
  'use strict';
  function memoryStorage(){
    let data=Object.create(null);
    return {
      get length(){return Object.keys(data).length},
      key(index){const keys=Object.keys(data);return Number.isInteger(index)&&index>=0&&index<keys.length?keys[index]:null},
      getItem(key){key=String(key);return Object.prototype.hasOwnProperty.call(data,key)?data[key]:null},
      setItem(key,value){data[String(key)]=String(value)},
      removeItem(key){delete data[String(key)]},
      clear(){data=Object.create(null)}
    };
  }
  function ensureStorage(name){
    try{
      const storage=window[name];
      const probe='__crulox_storage_probe__';
      storage.setItem(probe,'1');
      storage.removeItem(probe);
      return {native:true,storage};
    }catch(error){
      const fallback=memoryStorage();
      try{
        Object.defineProperty(window,name,{configurable:true,enumerable:true,value:fallback});
        return {native:false,storage:fallback};
      }catch(defineError){
        return {native:false,storage:fallback,error:defineError};
      }
    }
  }
  const local=ensureStorage('localStorage');
  const session=ensureStorage('sessionStorage');
  window.CRULOX_STORAGE_COMPAT=Object.freeze({version:'4.3.0',localNative:local.native,sessionNative:session.native});
})();
</script>

<!-- CRULOX V4.4.8 | Consentimiento explícito y políticas. La interfaz se bloquea desde el primer dibujo. -->
<script id="cru448-policy-preflight">
(()=>{
  'use strict';
  const VERSION='CRULOX-POL-2026-11-17-v1';
  const KEY='crulox_policy_acceptance';
  let accepted=false;
  try {
    const stored=JSON.parse(localStorage.getItem(KEY)||'null');
    accepted=!!(stored && stored.version===VERSION && stored.terms===true && stored.privacy===true && stored.acceptedAt);
  }catch(_error){}
  document.documentElement.setAttribute('data-cru-policy',accepted?'accepted':'pending');
  window.CRULOX_POLICY_CONFIG=Object.freeze({version:VERSION,key:KEY,acceptedAtOpen:accepted});
})();
</script>
<style id="cru448-policy-styles">
/* La tienda NUNCA se muestra antes del consentimiento, tampoco durante el primer renderizado. */
html:not([data-cru-policy="accepted"]) body > :not(#cru448PolicyGate){display:none!important}
html:not([data-cru-policy="accepted"]) body{overflow:hidden!important;min-height:100dvh!important}
html[data-cru-policy="accepted"] #cru448PolicyGate{display:none!important}
#cru448PolicyGate,#cru448PolicyGate *{box-sizing:border-box}
#cru448PolicyGate{
  position:fixed;inset:0;z-index:2147483600;display:block;overflow-y:auto;
  padding:max(14px,env(safe-area-inset-top)) 12px max(24px,env(safe-area-inset-bottom));
  overscroll-behavior:contain;-webkit-overflow-scrolling:touch;color:#eafaff;
  background:radial-gradient(ellipse at 50% 5%,#0a3853 0,transparent 55%),linear-gradient(145deg,#020c18,#041524 55%,#02101e);
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;line-height:1.55;
}
#cru448PolicyGate .cru448-wrap{width:min(760px,100%);margin:0 auto}
#cru448PolicyGate .cru448-heading{text-align:center;margin:12px auto 20px}
#cru448PolicyGate .cru448-symbol{display:inline-grid;place-items:center;width:54px;height:54px;border-radius:17px;background:linear-gradient(135deg,#087b9e,#06233f);color:#78f2ff;border:1px solid rgba(97,227,255,.38);box-shadow:0 0 35px rgba(5,186,239,.13);font-size:1.8rem;font-weight:900}
#cru448PolicyGate .cru448-brand{margin:10px 0 0;color:#67e5ff;font-size:.69rem;letter-spacing:.27em;font-weight:900}
#cru448PolicyGate #cru448Title:focus{outline:none}
#cru448PolicyGate h1{margin:8px auto;font-size:clamp(1.32rem,4.3vw,1.85rem);font-weight:900;line-height:1.2}
#cru448PolicyGate .cru448-sub{color:#9bb8c8;font-size:.83rem;max-width:640px;margin:0 auto}
#cru448PolicyGate .cru448-body{border:1px solid rgba(87,195,231,.24);border-radius:22px;overflow:hidden;background:linear-gradient(160deg,rgba(7,27,43,.97),rgba(4,15,28,.98));box-shadow:0 15px 46px rgba(0,0,0,.27)}
#cru448PolicyGate .cru448-strip{padding:13px 18px;color:#bedff1;font-size:.75rem;border-bottom:1px solid rgba(94,198,235,.16);background:rgba(29,145,187,.065)}
#cru448PolicyGate .cru448-document{padding:10px 20px 18px}
#cru448PolicyGate h2{font-size:1.08rem;margin:22px 0 9px;color:#72edff;border-bottom:1px solid rgba(115,206,233,.13);padding-bottom:8px}
#cru448PolicyGate h3{font-size:.86rem;color:#effaff;margin:18px 0 4px}
#cru448PolicyGate p,#cru448PolicyGate li{font-size:.79rem;color:#b5ccd9;line-height:1.64}
#cru448PolicyGate ul{padding-left:19px;margin:7px 0}
#cru448PolicyGate li{margin:5px 0}
#cru448PolicyGate strong{color:#eefcff}
#cru448PolicyGate .cru448-important{border-left:3px solid #49d9f2;background:rgba(38,179,225,.055);border-radius:5px;padding:11px 13px;margin:12px 0;color:#d3e9f2;font-size:.78rem}
#cru448PolicyGate .cru448-consent{border-top:1px solid rgba(90,203,247,.2);background:#061c2b;padding:15px 19px 18px}
#cru448PolicyGate .cru448-consent-line{display:flex;gap:12px;align-items:flex-start;color:#e9f9ff;font-size:.82rem;font-weight:650;cursor:pointer}
#cru448PolicyGate #cru448Check{flex:0 0 20px;width:20px;height:20px;margin:2px 0 0;accent-color:#12d7f5;cursor:pointer}
#cru448PolicyGate .cru448-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:10px;margin-top:14px}
#cru448PolicyGate .cru448-actions button,#cru448PolicyGate #cru448Back{border:1px solid rgba(110,218,255,.24);border-radius:13px;min-height:47px;padding:10px;font-size:.83rem;font-weight:850;font-family:inherit;cursor:pointer;transition:filter .15s}
#cru448PolicyGate #cru448Decline{background:#102538;color:#bfd7e6}
#cru448PolicyGate #cru448Accept{background:linear-gradient(115deg,#67edff,#08bde9);color:#022032;border-color:#44dcfa}
#cru448PolicyGate #cru448Accept:disabled{cursor:not-allowed;opacity:.47;filter:grayscale(.35)}
#cru448PolicyGate .cru448-actions button:not(:disabled):hover{filter:brightness(1.10)}
#cru448PolicyGate #cru448Back{display:none;width:100%;margin-top:9px;color:#a8dced;background:#102538}
html[data-cru-policy="review"] #cru448PolicyGate #cru448Back{display:block}
#cru448PolicyGate .cru448-notice{min-height:1.6em;margin:9px 0 0;color:#ffd698;font-size:.74rem}
#cru448PolicyGate .cru448-foot{padding:12px;text-align:center;color:#779eb3;font-size:.69rem}
#cru448PolicyGate button:focus-visible,#cru448PolicyGate input:focus-visible{outline:3px solid #fff;outline-offset:3px}
@media(max-width:420px){#cru448PolicyGate .cru448-document{padding:9px 14px 16px}#cru448PolicyGate .cru448-consent{padding:12px 14px 15px}#cru448PolicyGate .cru448-actions{grid-template-columns:1fr}#cru448PolicyGate .cru448-symbol{width:44px;height:44px}#cru448PolicyGate p,#cru448PolicyGate li{font-size:.76rem}}
@media(prefers-reduced-motion:reduce){#cru448PolicyGate button{transition:none!important}}
</style>
<style>
:root{--bg:#050a12;--bg2:#091321;--panel:#0e1a2c;--card:#112036;--card2:#142842;--text:#f4f8ff;--sub:#b5c6e2;--muted:#7188aa;--cyan:#00d9ff;--cyan2:#00a8e8;--green:#22d374;--red:#ff5e78;--amber:#ffc44d;--line:rgba(255,255,255,.07);--shadow:0 18px 50px rgba(0,0,0,.46);--r:18px;--font:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth;background:var(--bg)}body{min-height:100vh;background:radial-gradient(circle at 10% 0%,rgba(0,217,255,.08),transparent 26%),radial-gradient(circle at 95% 35%,rgba(34,211,116,.035),transparent 25%),var(--bg);color:var(--text);font-family:var(--font);overflow-x:hidden}body.lock{overflow:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}img{display:block;max-width:100%}.hidden{display:none!important}.container{width:min(1240px,100%);margin:auto;padding:0 16px}.icon-btn{width:42px;height:42px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.035);color:var(--text);display:grid;place-items:center;position:relative;transition:.2s}.icon-btn:hover{border-color:rgba(0,217,255,.35);color:var(--cyan);transform:translateY(-1px)}.count{position:absolute;top:-6px;right:-5px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;display:grid;place-items:center;background:var(--cyan);color:#031019;font-size:.58rem;font-weight:900;border:2px solid var(--bg)}.count.fav{background:var(--red);color:white}.btn{border:0;border-radius:999px;min-height:40px;padding:9px 17px;font-weight:850;font-size:.78rem;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.2s}.btn:hover{transform:translateY(-2px)}.btn-primary{background:linear-gradient(135deg,var(--cyan),var(--cyan2));color:#031019;box-shadow:0 8px 25px rgba(0,217,255,.18)}.btn-secondary{background:rgba(255,255,255,.055);color:var(--text);border:1px solid var(--line)}.btn-green{background:var(--green);color:white}.btn-red{background:rgba(255,94,120,.14);color:var(--red);border:1px solid rgba(255,94,120,.22)}.btn-sm{min-height:32px;padding:6px 12px;font-size:.66rem}.btn-block{width:100%}.loader{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:var(--bg);transition:.4s}.loader.hide{opacity:0;visibility:hidden}.loader-box{text-align:center}.loader-logo{width:min(520px,86vw);height:auto}.loader-ring{width:42px;height:42px;border-radius:50%;border:3px solid rgba(255,255,255,.08);border-top-color:var(--cyan);animation:spin .8s linear infinite;margin:14px auto}.loader p{font-size:.74rem;color:var(--muted)}@keyframes spin{to{transform:rotate(360deg)}}
.header{position:sticky;top:0;z-index:900;background:rgba(5,10,18,.93);backdrop-filter:blur(18px);border-bottom:1px solid rgba(0,217,255,.08);box-shadow:0 10px 32px rgba(0,0,0,.32)}.header-row{min-height:70px;display:grid;grid-template-columns:auto 220px minmax(230px,1fr) auto;align-items:center;gap:12px}.brand{height:48px;display:flex;align-items:center}.brand img{width:100%;height:100%;object-fit:contain}.menu-btn{display:none}.search-wrap{position:relative}.search{width:100%;height:42px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--text);padding:0 42px 0 40px;outline:0}.search:focus{border-color:rgba(0,217,255,.48);box-shadow:0 0 0 3px rgba(0,217,255,.08)}.search-icon{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--muted)}.search-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);border:0;background:none;color:var(--muted);display:none}.search-clear.show{display:block}.suggestions{position:absolute;left:0;right:0;top:calc(100% + 8px);display:none;z-index:1100;padding:7px;border-radius:16px;background:rgba(10,20,35,.99);border:1px solid rgba(0,217,255,.16);box-shadow:var(--shadow);max-height:340px;overflow:auto}.suggestions.open{display:grid;gap:4px}.suggestion{border:0;background:transparent;color:var(--text);display:grid;grid-template-columns:38px minmax(0,1fr) auto;align-items:center;gap:9px;padding:8px;border-radius:11px;text-align:left}.suggestion:hover,.suggestion.active{background:rgba(0,217,255,.09)}.suggestion img{width:38px;height:38px;border-radius:9px;object-fit:cover}.suggestion b{font-size:.73rem;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.suggestion small{font-size:.6rem;color:var(--muted)}.suggestion strong{font-size:.68rem;color:var(--cyan)}.header-actions{display:flex;align-items:center;gap:7px}.profile-dot{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--cyan),#6d5cff);color:#031019;font-size:.62rem;font-weight:900}
.drawer-overlay,.panel-overlay{position:fixed;inset:0;z-index:1300;background:rgba(0,0,0,.62);opacity:0;visibility:hidden;transition:.25s}.drawer-overlay.open,.panel-overlay.open{opacity:1;visibility:visible}.drawer{position:fixed;left:0;top:0;z-index:1400;width:min(88vw,330px);height:100%;padding:18px;background:var(--bg2);border-right:1px solid var(--line);transform:translateX(-100%);transition:.28s;overflow:auto}.drawer.open{transform:none}.drawer-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid var(--line)}.drawer-logo{width:220px;max-width:78%;height:55px;object-fit:contain}.drawer nav{display:grid;gap:6px;margin:16px 0}.drawer nav button,.drawer nav a{border:0;background:transparent;color:var(--sub);padding:12px;border-radius:12px;text-align:left;font-weight:700}.drawer nav button:hover,.drawer nav a:hover{background:rgba(255,255,255,.045);color:var(--cyan)}.drawer-social{display:flex;flex-wrap:wrap;gap:7px}.social-pill{padding:7px 12px;border-radius:999px;border:1px solid var(--line);color:var(--sub);font-size:.68rem}
.hero{padding:18px 0 8px}.hero-box{position:relative;min-height:350px;overflow:hidden;border-radius:28px;border:1px solid rgba(0,217,255,.12);background:linear-gradient(135deg,#0c1a2f 0%,#07101d 56%,#10253a 100%);box-shadow:var(--shadow);display:grid;grid-template-columns:1.05fr .95fr;align-items:center}.hero-box:before,.hero-box:after{content:"";position:absolute;border-radius:50%;filter:blur(1px)}.hero-box:before{width:380px;height:380px;right:-110px;top:-160px;background:rgba(0,217,255,.11)}.hero-box:after{width:260px;height:260px;left:38%;bottom:-170px;background:rgba(34,211,116,.055)}.hero-copy{position:relative;z-index:1;padding:34px}.hero-tag{display:inline-flex;padding:5px 12px;border-radius:999px;background:rgba(0,217,255,.12);border:1px solid rgba(0,217,255,.2);color:var(--cyan);font-size:.65rem;font-weight:900;text-transform:uppercase}.hero h1{font-size:clamp(2rem,5vw,4.1rem);line-height:1.02;margin:13px 0 10px;letter-spacing:-2px}.hero h1 span{color:var(--cyan)}.hero p{max-width:580px;color:var(--sub);font-size:.92rem;line-height:1.65}#heroSubtitle{white-space:pre-line}.hero-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.hero-art{position:relative;z-index:1;padding:28px}.hero-art img{width:100%;filter:drop-shadow(0 24px 40px rgba(0,0,0,.42))}.hero-mini{margin-top:14px;display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.hero-mini div{padding:10px;border-radius:14px;background:rgba(255,255,255,.035);border:1px solid var(--line);text-align:center}.hero-mini b{display:block;color:var(--cyan);font-size:.9rem}.hero-mini span{font-size:.57rem;color:var(--muted)}
.benefits{padding:10px 0}.benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.benefit{padding:13px;border-radius:16px;background:rgba(14,26,44,.76);border:1px solid var(--line);display:flex;align-items:center;gap:10px}.benefit i{font-style:normal;font-size:1.25rem}.benefit b{display:block;font-size:.72rem}.benefit span{display:block;color:var(--muted);font-size:.58rem;margin-top:2px}.section{padding:16px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.section-title{font-size:1.35rem}.section-title span{color:var(--cyan)}.section-kicker{display:block;color:var(--muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.7px;margin-bottom:3px}.category-scroll{display:flex;gap:7px;overflow-x:auto;padding:4px 0 10px;scrollbar-width:none}.cat{flex:0 0 auto;border:1px solid var(--line);background:rgba(255,255,255,.035);color:var(--sub);border-radius:999px;padding:8px 14px;font-size:.69rem;font-weight:800}.cat.active{background:var(--cyan);color:#031019;border-color:var(--cyan)}.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}.product{overflow:hidden;border-radius:20px;background:linear-gradient(180deg,var(--card),#0f1b30);border:1px solid var(--line);box-shadow:0 13px 34px rgba(0,0,0,.3);display:flex;flex-direction:column;min-width:0;transition:.22s}.product:hover{transform:translateY(-4px);border-color:rgba(0,217,255,.2)}.product-image{height:170px;position:relative;overflow:hidden;background:#08101d}.product-image img{width:100%;height:100%;object-fit:cover;transition:.3s}.product:hover .product-image img{transform:scale(1.03)}.badge{position:absolute;top:9px;left:9px;padding:4px 9px;border-radius:999px;background:var(--cyan);color:#031019;font-size:.55rem;font-weight:900;text-transform:uppercase}.fav-btn{position:absolute;top:8px;right:8px;width:34px;height:34px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(5,10,18,.66);backdrop-filter:blur(8px);color:white}.fav-btn.active{color:var(--red);border-color:rgba(255,94,120,.4)}.product-body{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}.product-cat{color:var(--muted);font-size:.57rem;text-transform:uppercase;letter-spacing:.5px}.product h3{font-size:.92rem;line-height:1.3;min-height:2.4em}.rating{font-size:.64rem;color:var(--amber)}.rating span{color:var(--muted)}.price-row{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}.price{font-size:1.12rem;color:var(--cyan);font-weight:900}.old{font-size:.66rem;color:var(--muted);text-decoration:line-through}.discount{font-size:.6rem;color:var(--red);font-weight:900}.stock{font-size:.62rem;color:var(--green)}.stock.low{color:var(--amber)}.stock.out{color:var(--red)}.product-actions{display:grid;grid-template-columns:1fr 42px 1fr;gap:6px;margin-top:auto}.product-actions button{min-height:36px;border-radius:999px;border:0;font-size:.65rem;font-weight:900}.add{background:var(--cyan);color:#031019}.support{background:var(--green);color:white}.detail{background:rgba(255,255,255,.055);color:var(--text);border:1px solid var(--line)!important}.empty{grid-column:1/-1;padding:45px 18px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:18px}.combos{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.combo{padding:15px;border-radius:20px;background:linear-gradient(145deg,#12223a,#0b1627);border:1px solid var(--line);display:grid;grid-template-columns:120px 1fr;gap:14px;align-items:center}.combo-visual{height:120px;border-radius:16px;display:grid;place-items:center;background:radial-gradient(circle,rgba(0,217,255,.18),transparent 70%),#08101d;font-size:2.5rem}.combo h3{font-size:1rem}.combo p{font-size:.68rem;color:var(--sub);line-height:1.5;margin:5px 0}.combo-products{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0}.combo-products span{padding:4px 8px;border-radius:999px;background:rgba(255,255,255,.04);font-size:.56rem;color:var(--sub)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.step{padding:16px;border-radius:18px;background:var(--panel);border:1px solid var(--line);text-align:center}.step b{width:36px;height:36px;border-radius:12px;background:rgba(0,217,255,.12);color:var(--cyan);display:grid;place-items:center;margin:0 auto 8px}.step h3{font-size:.78rem}.step p{font-size:.61rem;color:var(--muted);margin-top:3px}.faq-list{display:grid;gap:8px;max-width:850px}.faq{border:1px solid var(--line);border-radius:15px;background:rgba(14,26,44,.72);overflow:hidden}.faq-q{width:100%;border:0;background:transparent;color:var(--text);display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;text-align:left;font-size:.78rem;font-weight:800}.faq-q i{font-style:normal;color:var(--cyan);transition:.2s}.faq.open .faq-q i{transform:rotate(180deg)}.faq-a{max-height:0;overflow:hidden;color:var(--sub);font-size:.7rem;line-height:1.55;padding:0 14px;transition:.25s}.faq.open .faq-a{padding:0 14px 22px}.footer{margin:18px 0 0;padding:26px 0 12px;background:linear-gradient(180deg,rgba(9,19,33,.8),#050a12);border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1.3fr .8fr .8fr;gap:30px}.footer-logo{width:min(360px,100%);height:auto}.footer p{color:var(--sub);font-size:.76rem;line-height:1.6}.footer h3{font-size:.82rem;margin-bottom:9px}.footer-links{display:grid;gap:8px}.footer-links a,.footer-links button{border:0;background:none;color:var(--sub);font-size:.72rem;text-align:left}.footer-links a:hover,.footer-links button:hover{color:var(--cyan)}.footer-social{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.copyright{margin-top:20px;padding-top:12px;border-top:1px solid var(--line);color:var(--muted);font-size:.62rem;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.float-stack{position:fixed;right:16px;bottom:16px;z-index:800;display:grid;gap:8px}.float-btn{width:48px;height:48px;border:0;border-radius:50%;display:grid;place-items:center;color:white;box-shadow:0 12px 28px rgba(0,0,0,.4)}.float-support{background:var(--green)}.float-top{background:rgba(17,32,54,.95);border:1px solid var(--line);opacity:0;visibility:hidden;transition:.2s}.float-top.show{opacity:1;visibility:visible}
.side-panel{position:fixed;right:0;top:0;z-index:1400;width:min(100%,450px);height:100%;padding:16px;background:var(--bg2);border-left:1px solid var(--line);box-shadow:-18px 0 50px rgba(0,0,0,.5);transform:translateX(100%);transition:.28s;display:flex;flex-direction:column}.side-panel.open{transform:none}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--line)}.panel-head h2{font-size:1rem}.panel-content{flex:1;overflow:auto;padding:12px 0}.panel-foot{padding-top:12px;border-top:1px solid var(--line)}.list-card{display:grid;grid-template-columns:70px minmax(0,1fr) auto;gap:10px;padding:9px;border-radius:14px;background:rgba(255,255,255,.035);border:1px solid var(--line);margin-bottom:8px}.list-card img{width:70px;height:70px;border-radius:11px;object-fit:cover}.list-card h3{font-size:.75rem}.list-card p{font-size:.61rem;color:var(--muted);margin-top:3px}.list-actions{display:flex;gap:5px;margin-top:7px;flex-wrap:wrap}.qty{display:flex;align-items:center;gap:6px}.qty button{width:27px;height:27px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.04);color:white}.total-row{display:flex;justify-content:space-between;font-weight:900;margin-bottom:10px}.total-row span:last-child{color:var(--cyan)}
.modal-overlay{position:fixed;inset:0;z-index:3100;background:rgba(0,0,0,.78);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:14px;opacity:0;visibility:hidden;transition:.22s}.modal-overlay.open{opacity:1;visibility:visible}.modal{width:min(760px,100%);max-height:94vh;overflow:auto;border-radius:22px;background:var(--bg2);border:1px solid var(--line);box-shadow:0 28px 80px rgba(0,0,0,.65);padding:17px}.modal.small{width:min(520px,100%)}.modal.large{width:min(1050px,100%)}.modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.modal-head h2{font-size:1.02rem}.close-btn{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--sub)}.product-detail{display:grid;grid-template-columns:.95fr 1.05fr;gap:17px}.product-detail img{width:100%;height:330px;object-fit:cover;border-radius:17px}.product-detail h2{font-size:1.35rem;margin:5px 0}.product-detail p{color:var(--sub);font-size:.78rem;line-height:1.65}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.65rem;color:var(--sub);font-weight:750}.field input,.field select,.field textarea{width:100%;min-height:42px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.045);color:var(--text);padding:9px 11px;outline:0}.field textarea{min-height:90px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:rgba(0,217,255,.5);box-shadow:0 0 0 3px rgba(0,217,255,.07)}.form-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.tabs{display:flex;gap:6px;padding:5px;border-radius:14px;background:rgba(255,255,255,.035);margin-bottom:13px}.tab{flex:1;border:0;border-radius:10px;background:transparent;color:var(--muted);padding:9px;font-weight:800;font-size:.7rem}.tab.active{background:rgba(0,217,255,.13);color:var(--cyan)}.profile-card{padding:14px;border-radius:17px;background:rgba(255,255,255,.035);border:1px solid var(--line)}.profile-card h3{font-size:1rem}.profile-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:12px}.profile-info{padding:9px;border-radius:11px;background:rgba(255,255,255,.025)}.profile-info small{display:block;color:var(--muted);font-size:.56rem}.profile-info b{font-size:.7rem;word-break:break-word}.notice{padding:11px;border-radius:13px;background:rgba(255,196,77,.09);border:1px solid rgba(255,196,77,.22);color:#ffe2a0;font-size:.67rem;line-height:1.55;margin-bottom:12px}
.admin-overlay{position:fixed;inset:0;z-index:2200;background:var(--bg);display:none}.admin-overlay.open{display:block}.admin-shell{height:100%;display:grid;grid-template-columns:250px minmax(0,1fr)}.admin-sidebar{padding:16px;background:#07111f;border-right:1px solid var(--line);overflow:auto}.admin-brand{width:210px;height:55px;object-fit:contain;margin-bottom:16px}.admin-nav{display:grid;gap:5px}.admin-nav button{border:0;border-radius:11px;background:transparent;color:var(--sub);padding:11px 12px;text-align:left;font-weight:800;font-size:.7rem}.admin-nav button.active,.admin-nav button:hover{background:rgba(0,217,255,.1);color:var(--cyan)}.admin-main{min-width:0;overflow:auto}.admin-top{position:sticky;top:0;z-index:5;min-height:70px;padding:12px 18px;background:rgba(5,10,18,.95);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.admin-top h1{font-size:1.15rem}.admin-content{padding:18px;max-width:1500px;margin:auto}.admin-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.metric{padding:14px;border-radius:17px;background:linear-gradient(145deg,var(--card),#0d192b);border:1px solid var(--line)}.metric small{color:var(--muted);font-size:.62rem}.metric strong{display:block;color:var(--cyan);font-size:1.55rem;margin-top:5px}.admin-card{margin-top:13px;padding:15px;border-radius:18px;background:var(--panel);border:1px solid var(--line)}.admin-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}.admin-card h2{font-size:.95rem}.toolbar{display:flex;gap:7px;flex-wrap:wrap}.toolbar input,.toolbar select{min-height:36px;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--text);padding:7px 10px;outline:0}.table-wrap{overflow:auto;border-radius:13px;border:1px solid var(--line)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{padding:10px;border-bottom:1px solid var(--line);text-align:left;font-size:.66rem}th{color:var(--muted);background:rgba(255,255,255,.025);position:sticky;top:0}td img{width:48px;height:40px;object-fit:cover;border-radius:8px}.status{display:inline-flex;padding:4px 8px;border-radius:999px;background:rgba(0,217,255,.1);color:var(--cyan);font-size:.57rem;font-weight:900}.status.warn{background:rgba(255,196,77,.1);color:var(--amber)}.status.bad{background:rgba(255,94,120,.1);color:var(--red)}.admin-list{display:grid;gap:8px}.admin-list-item{padding:11px;border-radius:13px;background:rgba(255,255,255,.03);border:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.admin-list-item h3{font-size:.73rem}.admin-list-item p{font-size:.61rem;color:var(--muted);margin-top:3px}.admin-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.activity{max-height:460px;overflow:auto}.activity-item{padding:9px 0;border-bottom:1px solid var(--line)}.activity-item b{font-size:.68rem}.activity-item span{display:block;font-size:.57rem;color:var(--muted);margin-top:2px}.danger-zone{border-color:rgba(255,94,120,.22);background:rgba(255,94,120,.035)}
.full-fallback{position:fixed;inset:0;z-index:2400;background:var(--bg);display:none}.full-fallback.open{display:block}.full-fallback iframe{width:100%;height:100%;border:0;background:var(--bg)}.toastbox{position:fixed;right:12px;top:84px;z-index:3000;width:min(340px,calc(100% - 24px));display:grid;gap:7px}.toast{padding:10px 12px;border-radius:13px;background:rgba(14,26,44,.98);border:1px solid var(--line);box-shadow:var(--shadow);font-size:.7rem;animation:toastIn .22s}.toast.success{border-left:3px solid var(--green)}.toast.error{border-left:3px solid var(--red)}.toast.warn{border-left:3px solid var(--amber)}@keyframes toastIn{from{opacity:0;transform:translateY(-8px)}}
@media(max-width:900px){.header-row{grid-template-columns:auto minmax(130px,1fr) auto;grid-template-areas:"menu brand actions" "search search search";padding:8px 0;gap:7px}.menu-btn{display:grid;grid-area:menu}.brand{grid-area:brand;width:190px;justify-self:center}.search-wrap{grid-area:search}.header-actions{grid-area:actions}.hero-box{grid-template-columns:1fr}.hero-copy{padding:27px 24px 8px}.hero-art{padding:8px 24px 24px}.hero-art img{max-height:180px;object-fit:contain}.benefit-grid{grid-template-columns:repeat(2,1fr)}.products{grid-template-columns:repeat(2,minmax(0,1fr))}.combos{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.admin-shell{grid-template-columns:1fr}.admin-sidebar{position:sticky;top:0;z-index:8;padding:8px;display:flex;align-items:center;gap:8px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line)}.admin-brand{width:130px;height:42px;margin:0;flex:0 0 auto}.admin-nav{display:flex;gap:5px}.admin-nav button{white-space:nowrap}.admin-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.container{padding:0 10px}.header-row{min-height:auto}.brand{width:145px;height:36px}.icon-btn{width:36px;height:36px;border-radius:12px}.header-actions{gap:4px}.hero{padding-top:10px}.hero-box{min-height:0;border-radius:21px}.hero-copy{padding:22px 18px 6px}.hero h1{font-size:2.15rem}.hero p{font-size:.77rem}.hero-art{padding:5px 16px 18px}.hero-mini div{padding:8px 4px}.benefit{padding:10px 8px}.benefit i{font-size:1rem}.benefit b{font-size:.63rem}.products{gap:9px}.product{border-radius:16px}.product-image{height:120px}.product-body{padding:9px;gap:4px}.product h3{font-size:.74rem}.product-actions{grid-template-columns:1fr 36px 1fr;gap:4px}.product-actions button{min-height:31px;font-size:.57rem}.price{font-size:.94rem}.old{font-size:.57rem}.rating,.stock{font-size:.56rem}.section-title{font-size:1.08rem}.combo{grid-template-columns:90px 1fr;padding:11px}.combo-visual{height:95px}.steps{grid-template-columns:1fr}.faq-q{font-size:.7rem;padding:10px 12px}.faq-a{font-size:.64rem;padding:0 12px}.faq.open .faq-a{padding:0 12px 10px}.footer{padding-bottom:8px}.footer-grid{grid-template-columns:1fr;gap:18px}.footer-grid>div:first-child{grid-column:auto}.copyright{font-size:.57rem}.float-stack{right:10px;bottom:10px}.float-btn{width:43px;height:43px}.product-detail{grid-template-columns:1fr}.product-detail img{height:220px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.profile-grid{grid-template-columns:1fr}.admin-content{padding:10px}.admin-top{padding:10px}.admin-top h1{font-size:.9rem}.admin-grid{grid-template-columns:repeat(2,1fr);gap:7px}.metric{padding:11px}.metric strong{font-size:1.2rem}.admin-two{grid-template-columns:1fr}.toastbox{top:72px}}

/* =====================================================================
   NOVAPRIME GT V6 · REFINAMIENTO RESPONSIVE, CENTRADO Y ANTI-DESBORDE
   ===================================================================== */
html,body{width:100%;max-width:100%;overflow-x:hidden;overflow-x:clip}
body{min-width:280px;padding:0;margin:0}
body>*{max-width:100%}
main,section,footer,header,aside,nav,article,div{min-width:0}
img,svg,video,canvas{max-width:100%;height:auto}
button,a,input,select,textarea{min-width:0;max-width:100%}
h1,h2,h3,h4,p,span,a,button,label,small,strong,b{overflow-wrap:anywhere}
.container{width:100%;max-width:1240px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right))}
.header .container,.footer .container{max-width:1240px}

/* Encabezado equilibrado */
.header-row{width:100%;grid-template-columns:auto minmax(170px,220px) minmax(260px,1fr) auto;gap:12px}
.brand{width:100%;min-width:0;justify-content:center}
.brand img{max-width:220px;margin-inline:auto}
.header-actions{min-width:0;justify-content:flex-end}
.count{top:2px;right:2px;transform:translate(35%,-35%);min-width:18px;height:18px;font-size:.54rem}
.search-wrap,.search{min-width:0}
.suggestions{max-width:100%;overscroll-behavior:contain}

/* Hero centrado y proporcional */
.hero-box{width:100%;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr)}
.hero-copy,.hero-art{min-width:0}
.hero-copy{display:flex;flex-direction:column;align-items:flex-start}
.hero h1{max-width:760px;text-wrap:balance}
.hero p{text-wrap:pretty}
.hero-art img{max-width:620px;margin-inline:auto}
.hero-mini{width:100%}
.hero-mini div,.benefit,.step,.product,.combo,.faq,.admin-card,.metric{min-width:0}

/* Beneficios y secciones */
.benefit-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.benefit>div{min-width:0}
.benefit b,.benefit span{white-space:normal}
.section-head{width:100%;align-items:center}
.section-head>div{min-width:0}
.category-scroll{width:100%;max-width:100%;overscroll-behavior-inline:contain;-webkit-overflow-scrolling:touch}
.category-scroll:after{content:"";flex:0 0 2px}
.products{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));align-items:stretch}
.product{width:100%;max-width:100%}
.product-image{aspect-ratio:1.28/1;height:auto;min-height:150px}
.product-body{min-width:0}
.product h3{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.product-actions>*{min-width:0;white-space:nowrap}
.combos,.steps,.footer-grid{width:100%}
.combo>*{min-width:0}

/* Footer compacto, alineado y sin espacio artificial */
.footer{margin:0;padding-bottom:max(10px,env(safe-area-inset-bottom))}
.footer-grid{align-items:start}
.footer-links,.footer-social{min-width:0}
.footer-links a,.footer-links button,.footer-social a{max-width:100%;white-space:normal}
.copyright{flex-wrap:wrap;gap:5px 14px}

/* Paneles, modales y formularios */
.side-panel{width:min(92vw,430px);max-width:100vw;padding-bottom:max(14px,env(safe-area-inset-bottom))}
.panel-content{min-width:0}
.cart-item,.favorite-item{grid-template-columns:minmax(0,1fr) auto}
.modal-overlay{padding:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))}
.modal,.modal.small,.modal.large{width:min(100%,calc(100vw - 24px));max-width:1050px}
.form-grid,.profile-grid,.product-detail{min-width:0}
.field,.profile-info{min-width:0}
.field input,.field select,.field textarea{min-width:0}
.float-stack{right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom))}
.toastbox{right:max(12px,env(safe-area-inset-right));left:auto;max-width:calc(100vw - 24px)}

/* Administración realmente adaptable */
.admin-overlay{width:100%;height:100dvh;max-width:100vw;overflow:hidden}
.admin-shell{width:100%;max-width:100vw;height:100dvh}
.admin-sidebar,.admin-main,.admin-content{min-width:0;max-width:100%}
.admin-content{width:100%;max-width:1500px;margin-inline:auto}
.admin-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.admin-two{grid-template-columns:repeat(2,minmax(0,1fr))}
.admin-card-head,.admin-top{min-width:0}
.toolbar{min-width:0}
.toolbar input,.toolbar select{max-width:100%}
.table-wrap{width:100%;max-width:100%;overscroll-behavior-inline:contain;-webkit-overflow-scrolling:touch}
.admin-list-item>div{min-width:0}

@media(max-width:1100px){
  .header-row{grid-template-columns:auto minmax(160px,200px) minmax(220px,1fr) auto}
  .admin-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}

@media(max-width:900px){
  .header-row{grid-template-columns:42px minmax(0,1fr) auto;grid-template-areas:"menu brand actions" "search search search";gap:8px;padding-block:8px}
  .menu-btn{grid-area:menu}
  .brand{grid-area:brand;width:min(210px,46vw);height:42px;justify-self:center}
  .brand img{max-width:100%}
  .search-wrap{grid-area:search;width:100%}
  .header-actions{grid-area:actions}
  .hero-box{grid-template-columns:1fr}
  .hero-copy{align-items:center;text-align:center;padding:30px 26px 8px}
  .hero h1,.hero p{margin-inline:auto}
  .hero-actions{justify-content:center}
  .hero-art{padding:8px 26px 26px;text-align:center}
  .hero-art img{width:min(620px,92%)}
  .hero-mini{max-width:620px;margin-inline:auto}
  .benefit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .products{grid-template-columns:repeat(2,minmax(0,1fr))}
  .admin-shell{display:flex;flex-direction:column}
  .admin-sidebar{position:relative;top:auto;width:100%;max-width:100vw;flex:0 0 auto;padding:8px max(10px,env(safe-area-inset-left));overflow-x:auto;overflow-y:hidden}
  .admin-brand{width:135px;min-width:135px}
  .admin-nav{width:max-content;min-width:max-content}
  .admin-main{flex:1;min-height:0}
  .admin-top{position:sticky;top:0;flex-wrap:wrap}
  .admin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media(max-width:640px){
  .container{padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right))}
  .header-row{grid-template-columns:38px minmax(105px,1fr) auto;gap:6px}
  .brand{width:min(180px,44vw);height:38px}
  .icon-btn{width:36px;height:36px;border-radius:12px}
  .header-actions{gap:4px}
  .profile-dot{width:21px;height:21px}
  .count{right:1px;top:1px;transform:translate(28%,-28%)}
  .search{height:44px;font-size:.9rem}
  .hero{padding-top:12px}
  .hero-box{border-radius:24px}
  .hero-copy{padding:25px 18px 6px}
  .hero-tag{font-size:.62rem}
  .hero h1{font-size:clamp(1.85rem,9vw,2.55rem);line-height:1.04;letter-spacing:-1.1px}
  .hero p{font-size:.8rem;line-height:1.58}
  .hero-actions{width:100%;display:grid;grid-template-columns:1fr;max-width:360px}
  .hero-actions .btn{width:100%}
  .hero-art{padding:8px 15px 20px}
  .hero-art img{width:min(560px,100%)}
  .hero-mini{gap:7px}
  .hero-mini div{padding:10px 5px}
  .hero-mini span{font-size:.58rem}
  .benefit{padding:11px 9px;gap:8px;align-items:flex-start}
  .benefit i{font-size:1.05rem;line-height:1}
  .benefit b{font-size:.68rem;line-height:1.25}
  .benefit span{font-size:.58rem;line-height:1.3}
  .section{padding:18px 0}
  .section-head{margin-bottom:11px}
  .section-title{font-size:1.2rem}
  .section-kicker{font-size:.58rem}
  .products{gap:10px}
  .product{border-radius:17px}
  .product-image{aspect-ratio:1.15/1;min-height:118px}
  .product-body{padding:10px 9px 9px;gap:5px}
  .product h3{font-size:.78rem;line-height:1.28;min-height:2.55em}
  .price{font-size:1rem}
  .product-actions{grid-template-columns:minmax(0,1fr) 34px minmax(0,1fr);gap:5px}
  .product-actions button{min-height:34px;padding-inline:5px;font-size:.58rem}
  .product-actions .wsp{width:34px;min-width:34px}
  .combo{max-width:100%}
  .footer-grid{text-align:center}
  .footer-logo{margin-inline:auto}
  .footer-social,.footer-links{justify-content:center;align-items:center}
  .footer-links{display:flex;flex-direction:column}
  .copyright{justify-content:center;text-align:center}
  .product-detail{text-align:center}
  .product-detail img{margin-inline:auto}
  .form-actions{justify-content:center}
  .admin-top{padding:10px 12px}
  .admin-top>div{min-width:0}
  .admin-top .toolbar{width:100%;display:grid;grid-template-columns:1fr 1fr}
  .admin-top .toolbar .btn{width:100%}
  .admin-content{padding:12px}
  .admin-card{padding:13px}
  .admin-card-head{align-items:flex-start;flex-direction:column}
  .admin-card-head .toolbar{width:100%}
  .admin-card-head .toolbar>*{flex:1 1 140px}
}

@media(max-width:420px){
  .container{padding-left:max(10px,env(safe-area-inset-left));padding-right:max(10px,env(safe-area-inset-right))}
  .header-row{grid-template-columns:36px minmax(92px,1fr) auto}
  .brand{width:min(165px,43vw);height:35px}
  .header-actions .icon-btn{width:34px;height:34px}
  .header-actions{gap:3px}
  .count{min-width:17px;height:17px;font-size:.5rem;right:2px;top:2px;transform:translate(20%,-20%)}
  .search{padding-left:39px;padding-right:38px}
  .hero-box{border-radius:21px}
  .hero-copy{padding:22px 14px 5px}
  .hero h1{font-size:clamp(1.7rem,8.7vw,2.15rem)}
  .hero p{font-size:.75rem}
  .hero-art{padding-inline:12px}
  .hero-mini div{padding:9px 3px}
  .hero-mini b{font-size:.86rem}
  .hero-mini span{font-size:.53rem}
  .section-head{gap:8px}
  .section-head .btn{flex:0 0 auto;padding-inline:13px}
  .category-scroll{margin-inline:0}
  .products{gap:8px}
  .product-image{min-height:108px}
  .product-body{padding:8px}
  .product-cat{font-size:.52rem}
  .product h3{font-size:.72rem}
  .rating,.stock,.old,.discount{font-size:.53rem}
  .price{font-size:.9rem}
  .product-actions{grid-template-columns:minmax(0,1fr) 31px minmax(0,1fr);gap:4px}
  .product-actions button{min-height:31px;font-size:.53rem;border-radius:12px}
  .product-actions .wsp{width:31px;min-width:31px}
  .combo{grid-template-columns:78px minmax(0,1fr);gap:9px;padding:10px}
  .combo-visual{height:90px}
  .steps{gap:8px}
  .faq-q{font-size:.72rem}
  .side-panel{width:100vw}
  .modal-overlay{padding:8px}
  .modal,.modal.small,.modal.large{width:calc(100vw - 16px);padding:13px;border-radius:17px}
  .admin-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .metric{padding:11px 9px}
  .metric strong{font-size:1.18rem}
}

@media(max-width:340px){
  .header-row{grid-template-columns:34px minmax(78px,1fr) auto}
  .brand{width:min(126px,38vw);height:31px}
  .header-actions .icon-btn{width:31px;height:31px;border-radius:10px}
  .profile-dot{width:19px;height:19px;font-size:.55rem}
  .menu-btn{width:34px;height:34px}
  .hero h1{font-size:1.62rem}
  .benefit-grid{gap:7px}
  .benefit{padding:9px 7px}
  .products{gap:7px}
  .product-image{min-height:98px}
  .product-body{padding:7px 6px}
  .product h3{font-size:.68rem}
  .product-actions{grid-template-columns:minmax(0,1fr) 29px minmax(0,1fr)}
  .product-actions button{font-size:.49rem;padding:3px}
  .product-actions .wsp{width:29px;min-width:29px}
  .admin-grid{grid-template-columns:1fr}
}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}


/* =====================================================================
   NOVAPRIME GT V7 · EXPERIENCIA DE COMPRA PREMIUM
   ===================================================================== */
:root{
  --bg:#030812;
  --bg2:#071322;
  --panel:#0b192b;
  --card:#0e1d32;
  --card2:#132640;
  --text:#f7fbff;
  --sub:#c1cfe4;
  --muted:#7489a8;
  --cyan:#00d7ff;
  --cyan2:#008ee8;
  --green:#20d878;
  --red:#ff617c;
  --amber:#ffc75b;
  --violet:#7b6cff;
  --line:rgba(170,211,255,.105);
  --shadow:0 24px 70px rgba(0,0,0,.5);
  --soft-shadow:0 14px 38px rgba(0,0,0,.3);
  --r:22px;
}
html{color-scheme:dark;scroll-padding-top:118px}
body{
  background:
    radial-gradient(circle at 12% -8%,rgba(0,215,255,.12),transparent 29%),
    radial-gradient(circle at 92% 20%,rgba(123,108,255,.075),transparent 23%),
    linear-gradient(180deg,#030812 0%,#04101b 48%,#030812 100%);
  background-attachment:fixed;
}
body:before{
  content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.22;
  background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
  background-size:34px 34px;
  mask-image:linear-gradient(to bottom,black,transparent 72%);
}
.container{max-width:1180px}
.btn{min-height:44px;padding:10px 20px;letter-spacing:-.01em;box-shadow:none}
.btn-primary{background:linear-gradient(135deg,#00e0ff 0%,#00a7f5 68%,#2675ff 100%);box-shadow:0 12px 30px rgba(0,188,255,.22)}
.btn-secondary{background:rgba(255,255,255,.055);border-color:rgba(166,211,255,.13);backdrop-filter:blur(12px)}
.btn-green{background:linear-gradient(135deg,#28dc80,#12bb65)}
.icon-btn{border-color:rgba(169,209,255,.11);background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.026));box-shadow:0 8px 22px rgba(0,0,0,.18)}
.icon-btn:active,.btn:active{transform:scale(.975)}

.header{background:rgba(3,8,18,.88);border-bottom-color:rgba(0,215,255,.09);box-shadow:0 12px 36px rgba(0,0,0,.34)}
.header-row{min-height:76px;grid-template-columns:auto minmax(190px,230px) minmax(280px,1fr) auto}
.brand{height:50px}
.search{height:46px;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.025));border-color:rgba(165,211,255,.12);font-size:.82rem;box-shadow:inset 0 1px rgba(255,255,255,.025)}
.search::placeholder{color:#8295b2}
.search-wrap:focus-within .search{background:rgba(8,22,38,.96)}
.suggestions{border-color:rgba(0,215,255,.22);border-radius:18px}

.hero{padding:22px 0 12px}
.hero-box{
  min-height:400px;
  grid-template-columns:1.08fr .92fr;
  border-radius:30px;
  background:
    radial-gradient(circle at 85% 18%,rgba(0,215,255,.18),transparent 30%),
    radial-gradient(circle at 68% 92%,rgba(123,108,255,.105),transparent 32%),
    linear-gradient(135deg,#0d2039 0%,#071423 55%,#0b1a2c 100%);
  border:1px solid rgba(59,194,255,.19);
  box-shadow:0 28px 80px rgba(0,0,0,.45),inset 0 1px rgba(255,255,255,.035);
}
.hero-box:before{right:-170px;top:-190px;background:rgba(0,215,255,.09)}
.hero-box:after{left:48%;bottom:-195px;background:rgba(123,108,255,.08)}
.hero-copy{padding:48px 22px 48px 46px}
.hero-tag{padding:7px 14px;background:rgba(0,215,255,.105);border-color:rgba(0,215,255,.28);font-size:.67rem;letter-spacing:.06em}
.hero h1{font-size:clamp(2.35rem,5vw,4.25rem);line-height:.99;letter-spacing:-.055em;max-width:690px;margin:18px 0 16px;text-wrap:balance}
.hero h1 span{background:linear-gradient(90deg,#00e6ff,#3ebcff 55%,#8a79ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{font-size:.98rem;line-height:1.7;max-width:620px;color:#c4d3e8}
.hero-actions{margin-top:25px;gap:10px}
.hero-actions .btn{min-width:190px}
.hero-art{padding:34px 36px 34px 12px;display:flex;flex-direction:column;justify-content:center}
.hero-art>img{width:min(100%,560px);max-height:190px;object-fit:contain;margin-inline:auto;filter:drop-shadow(0 30px 45px rgba(0,0,0,.55))}
.hero-mini{gap:9px;margin-top:26px}
.hero-mini div{padding:14px 8px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));border-color:rgba(160,210,255,.105);box-shadow:inset 0 1px rgba(255,255,255,.025)}
.hero-mini b{font-size:1.05rem}.hero-mini span{font-size:.6rem;color:#8da1bf}

.benefits{padding:13px 0 5px}
.benefit-grid{gap:11px}
.benefit{min-height:78px;padding:16px;border-radius:20px;background:linear-gradient(145deg,rgba(15,32,54,.9),rgba(8,19,34,.88));border-color:rgba(157,205,255,.1);box-shadow:0 12px 28px rgba(0,0,0,.2)}
.benefit i{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;background:rgba(0,215,255,.09);color:var(--cyan);font-size:1.12rem;flex:0 0 auto}
.benefit b{font-size:.76rem}.benefit span{font-size:.61rem;line-height:1.35}

.section{padding:28px 0 8px}
.section-head{margin-bottom:16px;align-items:center}
.section-kicker{font-size:.61rem;letter-spacing:.12em;color:#8194b2}
.section-title{font-size:clamp(1.35rem,2.5vw,1.85rem);letter-spacing:-.035em;text-wrap:balance}
.section-head>.btn{min-height:40px;padding-inline:17px}
.category-scroll{gap:8px;padding:3px 2px 14px;scroll-snap-type:x proximity}
.cat{scroll-snap-align:start;padding:9px 15px;font-size:.7rem;border-color:rgba(167,209,255,.11);background:rgba(255,255,255,.035)}
.cat.active{box-shadow:0 8px 22px rgba(0,215,255,.17)}

.products{grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
.product{border-radius:22px;background:linear-gradient(180deg,#0e2037 0%,#0b182b 100%);border-color:rgba(151,203,255,.105);box-shadow:0 16px 42px rgba(0,0,0,.28);isolation:isolate}
.product:before{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;background:linear-gradient(145deg,rgba(0,215,255,.025),transparent 38%);z-index:2}
.product{position:relative}
.product:hover{transform:translateY(-5px);border-color:rgba(0,215,255,.28);box-shadow:0 24px 55px rgba(0,0,0,.38)}
.product-image{height:auto;aspect-ratio:4/3;background:radial-gradient(circle at 50% 36%,rgba(0,215,255,.08),transparent 55%),#07111f;border-bottom:1px solid rgba(255,255,255,.04)}
.product-image img{object-fit:cover;object-position:center 38%;transform:scale(1.12);filter:saturate(1.08) contrast(1.02)}
.product:hover .product-image img{transform:scale(1.16)}
.badge{top:11px;left:11px;padding:5px 10px;background:linear-gradient(135deg,#00e3ff,#13a7ff);box-shadow:0 8px 20px rgba(0,195,255,.24)}
.fav-btn{top:10px;right:10px;width:38px;height:38px;background:rgba(3,8,18,.76);border-color:rgba(255,255,255,.13)}
.product-body{padding:14px 14px 13px;gap:7px}
.product-cat{font-size:.58rem;letter-spacing:.11em;color:#7f94b3}
.product h3{font-size:.94rem;min-height:2.55em;line-height:1.28;letter-spacing:-.02em}
.rating{font-size:.65rem}.price-row{gap:7px}.price{font-size:1.18rem}.old{font-size:.65rem}.discount{font-size:.6rem}.stock{font-size:.63rem}
.product-actions{grid-template-columns:minmax(0,1fr) 40px minmax(0,1fr);gap:7px;margin-top:4px}
.product-actions button{min-height:38px;border-radius:13px;font-size:.64rem;position:relative;z-index:3}
.product-actions .add{background:linear-gradient(135deg,#00e2ff,#00a8f5);box-shadow:0 8px 18px rgba(0,199,255,.17)}
.product-actions .support{background:linear-gradient(135deg,#2bdd83,#16b965)}
.product-actions .detail{background:rgba(255,255,255,.052)}

.combos{gap:15px}
.combo{padding:18px;border-radius:24px;grid-template-columns:128px minmax(0,1fr);background:radial-gradient(circle at 12% 18%,rgba(0,215,255,.095),transparent 32%),linear-gradient(145deg,#10233d,#091627);border-color:rgba(157,205,255,.11);box-shadow:var(--soft-shadow)}
.combo-visual{height:128px;border-radius:20px;background:radial-gradient(circle,rgba(0,215,255,.2),transparent 64%),linear-gradient(145deg,#07121f,#0c2036);border:1px solid rgba(0,215,255,.09)}
.combo h3{font-size:1.08rem;letter-spacing:-.025em}.combo p{font-size:.72rem}.combo-products span{font-size:.58rem;border:1px solid rgba(255,255,255,.035)}

.steps{gap:12px}
.step{padding:21px 17px;border-radius:22px;background:linear-gradient(145deg,#0e1f35,#091728);border-color:rgba(158,207,255,.105);box-shadow:0 13px 30px rgba(0,0,0,.2)}
.step b{width:42px;height:42px;border-radius:14px;margin-bottom:11px;background:linear-gradient(145deg,rgba(0,215,255,.18),rgba(58,125,255,.11));font-size:.92rem}
.step h3{font-size:.83rem}.step p{font-size:.65rem;line-height:1.5;margin-top:5px}

.faq-list{max-width:940px;gap:10px}
.faq{border-radius:18px;background:linear-gradient(145deg,rgba(14,31,52,.94),rgba(8,20,35,.94));border-color:rgba(158,207,255,.1);box-shadow:0 10px 26px rgba(0,0,0,.16)}
.faq-q{padding:14px 17px;font-size:.79rem}.faq-a{font-size:.72rem;line-height:1.65;padding-inline:17px}.faq.open .faq-a{padding:0 17px 15px}

.footer{margin-top:28px;padding:34px 0 14px;background:radial-gradient(circle at 12% 0%,rgba(0,215,255,.065),transparent 30%),linear-gradient(180deg,rgba(7,19,33,.96),#030812);border-top-color:rgba(0,215,255,.08)}
.footer-grid{gap:38px}.footer-logo{width:min(410px,100%)}.footer p{font-size:.78rem;max-width:610px}.footer h3{font-size:.85rem}.footer-links a,.footer-links button{font-size:.75rem}.social-pill{padding:8px 13px;background:rgba(255,255,255,.028)}
.copyright{padding-top:15px;font-size:.63rem}

.side-panel{background:linear-gradient(180deg,#071524,#050d18);border-left-color:rgba(0,215,255,.1)}
.panel-head{padding-bottom:14px}.panel-content{padding-top:13px}.cart-item,.favorite-item{border-radius:16px;background:rgba(255,255,255,.035)}
.modal{background:linear-gradient(160deg,#0a1a2d,#06111f);border-color:rgba(164,210,255,.12)}
.field input,.field select,.field textarea{background:rgba(255,255,255,.04);border-color:rgba(168,211,255,.11)}

.float-stack{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));gap:10px}
.float-btn{width:48px;height:48px;box-shadow:0 16px 34px rgba(0,0,0,.4)}
.float-support{background:linear-gradient(145deg,#25df7c,#10b75e);border:1px solid rgba(255,255,255,.15)}
.float-top{background:rgba(9,23,40,.94);backdrop-filter:blur(12px)}

/* Administración: más clara y usable */
.admin-overlay{background:#030812}
.admin-sidebar{background:linear-gradient(180deg,#071625,#040c16);border-right-color:rgba(0,215,255,.08)}
.admin-nav button{padding:12px 13px;border-radius:13px;font-size:.72rem}
.admin-nav button.active{background:linear-gradient(90deg,rgba(0,215,255,.15),rgba(0,215,255,.045));box-shadow:inset 3px 0 var(--cyan)}
.admin-top{background:rgba(3,8,18,.92);min-height:76px}
.admin-content{padding:22px;max-width:1420px}
.metric{padding:17px;border-radius:20px;background:radial-gradient(circle at 95% 10%,rgba(0,215,255,.07),transparent 36%),linear-gradient(145deg,#10223a,#0a1728);border-color:rgba(159,207,255,.1)}
.metric strong{font-size:1.7rem}
.admin-card{padding:18px;border-radius:22px;background:linear-gradient(145deg,#0d1e33,#081526);border-color:rgba(158,207,255,.1);box-shadow:0 14px 34px rgba(0,0,0,.18)}
.table-wrap{border-color:rgba(158,207,255,.09)}
th{background:#0a192b}.admin-list-item{border-radius:15px}

@media(max-width:1080px){
  .products{grid-template-columns:repeat(3,minmax(0,1fr))}
  .hero-copy{padding-left:34px}.hero-art{padding-right:24px}
}
@media(max-width:900px){
  html{scroll-padding-top:120px}
  .header-row{grid-template-columns:auto minmax(120px,1fr) auto;grid-template-areas:"menu brand actions" "search search search";min-height:auto;padding:9px 0}
  .brand{width:min(210px,42vw);height:44px}
  .hero-box{grid-template-columns:1fr;min-height:0}
  .hero-copy{text-align:center;padding:34px 26px 10px}
  .hero h1{max-width:720px;margin-inline:auto}.hero p{margin-inline:auto}.hero-actions{justify-content:center}
  .hero-art{padding:8px 24px 28px}.hero-art>img{max-height:150px}
  .hero-mini{max-width:650px;width:100%;margin:20px auto 0}
  .products{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  .container{padding-inline:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right))}
  .header-row{gap:8px}.brand{width:min(190px,45vw);height:40px}.icon-btn{width:39px;height:39px}.header-actions{gap:5px}
  .search{height:45px;font-size:.8rem}
  .hero{padding-top:12px}.hero-box{border-radius:24px}
  .hero-copy{padding:27px 17px 8px}.hero-tag{font-size:.59rem;padding:6px 11px}
  .hero h1{font-size:clamp(1.82rem,8.2vw,2.42rem);line-height:1.02;letter-spacing:-.045em;margin:14px auto 12px}
  .hero p{font-size:.76rem;line-height:1.62}
  .hero-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:18px}.hero-actions .btn{width:100%;min-width:0}
  .hero-art{padding:7px 12px 21px}.hero-art>img{max-height:120px;width:93%}.hero-mini{gap:7px;margin-top:16px}
  .hero-mini div{padding:10px 4px;border-radius:15px}.hero-mini b{font-size:.92rem}.hero-mini span{font-size:.53rem}
  .benefit-grid{gap:8px}.benefit{min-height:68px;padding:11px 9px;border-radius:17px}.benefit i{width:34px;height:34px;border-radius:11px;font-size:.95rem}.benefit b{font-size:.65rem}.benefit span{font-size:.54rem}
  .section{padding-top:24px}.section-head{margin-bottom:13px}.section-title{font-size:1.24rem}.section-kicker{font-size:.55rem}
  .section-head>.btn{min-height:38px;font-size:.68rem;padding:8px 14px}
  .products{gap:9px}.product{border-radius:18px}.product-image{aspect-ratio:1.12/1}.product-image img{transform:scale(1.17)}.product:hover .product-image img{transform:scale(1.19)}
  .product-body{padding:10px 9px 9px;gap:5px}.product-cat{font-size:.5rem}.product h3{font-size:.72rem;min-height:2.55em}.rating,.stock{font-size:.54rem}.price{font-size:.93rem}.old,.discount{font-size:.51rem}
  .product-actions{grid-template-columns:minmax(0,1fr) 32px minmax(0,1fr);gap:4px}.product-actions button{min-height:32px;font-size:.53rem;border-radius:11px;padding-inline:4px}
  .fav-btn{width:34px;height:34px}.badge{font-size:.49rem;padding:4px 8px}
  .combo{grid-template-columns:86px minmax(0,1fr);padding:12px;gap:10px;border-radius:20px}.combo-visual{height:96px;border-radius:16px}.combo h3{font-size:.91rem}.combo p{font-size:.62rem}.combo .form-actions{gap:6px}.combo .btn{min-height:34px;font-size:.58rem;padding:7px 10px}
  .steps{gap:9px}.step{display:grid;grid-template-columns:46px minmax(0,1fr);grid-template-areas:"num title" "num desc";text-align:left;align-items:center;padding:14px;border-radius:18px}.step b{grid-area:num;margin:0;width:38px;height:38px}.step h3{grid-area:title;font-size:.75rem}.step p{grid-area:desc;font-size:.59rem;margin-top:2px}
  .faq-q{font-size:.7rem;padding:12px 14px}.faq-a{font-size:.65rem;line-height:1.6}.faq.open .faq-a{padding-bottom:13px}
  .footer{padding-top:28px}.footer-grid{text-align:center;gap:20px}.footer p{margin-inline:auto;font-size:.7rem}.footer-social{justify-content:center}.footer-links{align-items:center}.copyright{justify-content:center;text-align:center;gap:5px}
  .float-stack{right:10px;bottom:10px}.float-btn{width:45px;height:45px}
  .admin-content{padding:11px}.admin-top{padding:10px 12px}.admin-card{padding:13px;border-radius:18px}.metric{padding:12px 10px}.metric strong{font-size:1.25rem}
}
@media(max-width:360px){
  .brand{width:min(154px,43vw)}.header-actions .icon-btn{width:34px;height:34px}.menu-btn{width:36px;height:36px}
  .hero h1{font-size:1.72rem}.hero-mini span{font-size:.49rem}
  .product-body{padding:8px 7px}.product h3{font-size:.67rem}.product-actions{grid-template-columns:minmax(0,1fr) 29px minmax(0,1fr)}.product-actions button{font-size:.47rem}
  .combo{grid-template-columns:72px minmax(0,1fr)}.combo-visual{height:83px}
}


/* v8 responsive and visual refinement */
.container{width:min(1180px,calc(100% - 24px));}
.section-head{align-items:center;gap:12px;flex-wrap:wrap}
.section-head .section-title{line-height:1.08}
.product-body{display:flex;flex-direction:column;gap:6px;min-width:0;flex:1;padding:12px}
.product-body h3{font-size:.94rem;line-height:1.3;min-height:2.45em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.product-cat{font-size:.62rem;letter-spacing:.08em}
.price-row{row-gap:4px}
.product-actions{margin-top:auto;display:grid;grid-template-columns:1fr auto 1fr;gap:8px}
.product-actions button{min-width:0}
.combo{align-items:center}
.combo p{line-height:1.55}
.faq-q{align-items:center}
.faq-q span{min-width:0}
@media (max-width:760px){
  .hero-box{grid-template-columns:1fr;min-height:auto}
  .hero-copy{padding:24px 20px 8px;text-align:center}
  .hero-actions{justify-content:center}
  .hero-stats{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .hero-brand{padding:8px 20px 24px;justify-content:center}
  .section-head{align-items:flex-start}
  .section-head .btn,.section-head button{width:100%}
  .combo{grid-template-columns:1fr;gap:16px}
  .combo-visual{width:92px;height:92px;margin:0 auto}
  .footer-grid{grid-template-columns:1fr;gap:20px;text-align:center}
  .footer-links a,.footer-links button{margin-inline:auto;text-align:center}
  .footer-social{justify-content:center}
}
@media (max-width:520px){
  .container{width:min(100% - 16px,100%)}
  .search-wrap{padding-inline:2px}
  .products{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .product-image{height:154px}
  .product-body{padding:10px}
  .product-body h3{font-size:.88rem}
  .product-actions{grid-template-columns:1fr auto 1fr;gap:6px}
  .product-actions .support{width:44px;padding-inline:0}
  .cat{font-size:.8rem}
}



/* v8.4 visual refinement: combos */
.combos{gap:18px}
.combo{padding:20px;border-radius:26px;grid-template-columns:148px minmax(0,1fr);gap:18px;align-items:center;background:radial-gradient(circle at 14% 18%,rgba(0,215,255,.12),transparent 30%),linear-gradient(145deg,#10243f,#091627);border-color:rgba(157,205,255,.12);box-shadow:0 24px 48px rgba(0,0,0,.28)}
.combo-visual{position:relative;height:152px;border-radius:22px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 30%,rgba(0,217,255,.22),transparent 56%),linear-gradient(160deg,#081221,#10263c);border:1px solid rgba(0,215,255,.12)}
.combo-visual img{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 12px 28px rgba(0,0,0,.28))}
.combo-visual .combo-secondary{position:absolute;right:10px;bottom:10px;width:38%;height:38%;padding:6px;border-radius:16px;background:rgba(5,15,28,.9);border:1px solid rgba(255,255,255,.08);box-shadow:0 12px 26px rgba(0,0,0,.26)}
.combo h3{font-size:1.16rem;letter-spacing:-.03em;margin-bottom:6px}
.combo p{font-size:.78rem;line-height:1.6;margin:6px 0 10px}
.combo-products{gap:7px;margin:10px 0}
.combo-products span{padding:6px 10px;font-size:.62rem;background:rgba(255,255,255,.06)}
.combo .form-actions{margin-top:14px}
@media(max-width:760px){.combo{grid-template-columns:1fr;gap:14px}.combo-visual{height:188px}}



/* v8.6 combos premium refinement */
.combos{display:grid;gap:22px}
.combo{position:relative;overflow:hidden;padding:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;align-items:stretch;border-radius:28px;background:linear-gradient(145deg,#0d1c31,#081220);border:1px solid rgba(64,187,255,.18);box-shadow:0 26px 52px rgba(0,0,0,.30)}
.combo::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 0%,rgba(255,255,255,.02) 48%,transparent 100%);pointer-events:none}
.combo-visual{position:relative;min-height:320px;height:100%;padding:18px;border-radius:28px 0 0 28px;border-right:1px solid rgba(64,187,255,.14);background:radial-gradient(circle at 22% 20%,rgba(0,217,255,.18),transparent 30%),radial-gradient(circle at 74% 76%,rgba(58,131,255,.16),transparent 32%),linear-gradient(160deg,#07111f,#0d2036 58%,#0a1728)}
.combo-stage{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center}
.combo-main{position:relative;z-index:1;width:80%;height:80%;object-fit:contain;filter:drop-shadow(0 18px 30px rgba(0,0,0,.34))}
.combo-secondary{position:absolute;right:8%;bottom:8%;z-index:2;width:38%;height:38%;object-fit:contain;padding:10px;border-radius:18px;background:rgba(6,17,30,.9);border:1px solid rgba(255,255,255,.08);box-shadow:0 16px 32px rgba(0,0,0,.34)}
.combo-copy{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:24px 24px 22px}
.combo-copy .section-kicker{align-self:flex-start;margin-bottom:10px;padding:8px 14px;font-size:.72rem;letter-spacing:.06em;border-radius:999px;background:rgba(4,17,33,.42);border:1px solid rgba(57,194,255,.18)}
.combo h3{font-size:clamp(1.48rem,2vw,2rem);line-height:1.05;letter-spacing:-.04em;margin:0 0 10px}
.combo p{margin:0 0 14px;color:var(--sub);font-size:.88rem;line-height:1.7}
.combo-products{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.combo-products span{display:inline-flex;align-items:center;gap:7px;max-width:100%;padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.06);font-size:.68rem;color:#d7e5f7}
.combo-products span i{font-style:normal;opacity:.8}
.combo .price-row{margin:2px 0 0;align-items:flex-end}
.combo .price{font-size:2rem}
.combo .old{font-size:1rem}
.combo-actions{display:grid;gap:10px;margin-top:18px}
.combo-main-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.combo-main-actions .btn,.combo-actions .btn-secondary{width:100%}
.combo-actions .btn{min-height:46px;font-size:.86rem}
.combo-actions .btn-secondary{background:rgba(255,255,255,.05);border:1px solid rgba(170,222,255,.14)}
.combo-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:start}
.combo-detail-visual{min-height:280px;padding:18px;border-radius:24px;background:radial-gradient(circle at 24% 18%,rgba(0,217,255,.16),transparent 34%),radial-gradient(circle at 76% 72%,rgba(58,131,255,.16),transparent 34%),linear-gradient(160deg,#07111f,#0d2036 58%,#0a1728);border:1px solid rgba(64,187,255,.12)}
.combo-detail-stage{position:relative;width:100%;height:100%;min-height:240px;display:flex;align-items:center;justify-content:center}
.combo-detail-main{width:78%;height:78%;object-fit:contain;filter:drop-shadow(0 18px 30px rgba(0,0,0,.34))}
.combo-detail-secondary{position:absolute;right:8%;bottom:8%;width:38%;height:38%;object-fit:contain;padding:10px;border-radius:18px;background:rgba(6,17,30,.9);border:1px solid rgba(255,255,255,.08);box-shadow:0 16px 32px rgba(0,0,0,.34)}
.combo-detail-items{display:grid;gap:12px;margin:14px 0 16px}
.combo-detail-item{display:grid;grid-template-columns:60px minmax(0,1fr);gap:12px;align-items:center;padding:10px;border-radius:16px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05)}
.combo-detail-item img{width:60px;height:60px;object-fit:contain;padding:8px;border-radius:14px;background:radial-gradient(circle at 45% 30%,rgba(0,217,255,.16),transparent 40%),#091221}
.combo-detail-item h4{margin:0;font-size:.9rem;line-height:1.3}
.combo-detail-item p{margin:2px 0 0;font-size:.72rem;line-height:1.5}
.combo-detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}
.combo-detail-actions .btn:last-child{grid-column:1/-1}
@media(max-width:760px){
  .combo{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .combo-visual{min-height:270px}
  .combo-copy{padding:18px 18px 16px}
  .combo h3{font-size:1.28rem}
  .combo p{font-size:.8rem}
  .combo .price{font-size:1.72rem}
  .combo-actions .btn{min-height:42px;font-size:.79rem}
  .combo-detail{grid-template-columns:1fr}
}
@media(max-width:560px){
  .combo-visual{min-height:238px;padding:14px}
  .combo-main{width:84%;height:84%}
  .combo-secondary{width:41%;height:41%;right:7px;bottom:7px;padding:8px}
  .combo-copy{padding:16px 14px 14px}
  .combo-copy .section-kicker{font-size:.62rem;padding:7px 11px;margin-bottom:8px}
  .combo h3{font-size:1.1rem}
  .combo p{font-size:.73rem;line-height:1.58;margin-bottom:12px}
  .combo-products{gap:7px;margin-bottom:12px}
  .combo-products span{font-size:.59rem;padding:7px 9px}
  .combo .price{font-size:1.52rem}
  .combo .old{font-size:.86rem}
  .combo-main-actions{grid-template-columns:1fr}
  .combo-actions{margin-top:14px}
  .combo-actions .btn{min-height:39px;font-size:.72rem}
  .combo-detail-item{grid-template-columns:52px minmax(0,1fr)}
  .combo-detail-item img{width:52px;height:52px}
  .combo-detail-actions{grid-template-columns:1fr}
  .combo-detail-actions .btn:last-child{grid-column:auto}
}



/* v8.7 combo visual repair */
.combo{grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr)!important;min-height:380px!important}
.combo-visual{display:grid!important;grid-template-rows:minmax(0,1fr) minmax(0,1fr)!important;gap:14px!important;padding:18px!important;min-height:100%!important;border-radius:28px 0 0 28px!important;background:radial-gradient(circle at 18% 22%,rgba(0,217,255,.16),transparent 28%),radial-gradient(circle at 82% 78%,rgba(58,131,255,.14),transparent 30%),linear-gradient(160deg,#081525,#0c1d33 58%,#0b1729)!important}
.combo-image-card{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:150px;border-radius:22px;border:1px solid rgba(67,197,255,.14);background:linear-gradient(180deg,rgba(7,19,35,.88),rgba(13,31,54,.98));box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 18px 30px rgba(0,0,0,.18)}
.combo-image-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 24% 20%,rgba(0,217,255,.18),transparent 28%),radial-gradient(circle at 78% 80%,rgba(58,131,255,.16),transparent 30%);pointer-events:none}
.combo-image-card img{position:relative;z-index:1;width:100%!important;height:100%!important;max-width:none!important;object-fit:contain!important;padding:18px!important;filter:drop-shadow(0 14px 24px rgba(0,0,0,.32))}
.combo-image-card.secondary img{padding:16px 26px!important}
.combo-image-label{position:absolute;left:12px;bottom:12px;z-index:2;max-width:calc(100% - 24px);padding:7px 10px;border-radius:999px;background:rgba(5,15,28,.78);border:1px solid rgba(255,255,255,.08);font-size:.62rem;line-height:1.25;color:#dce8f7;backdrop-filter:blur(12px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.combo-copy{padding:22px 22px 20px!important}
.combo h3{font-size:clamp(1.55rem,2vw,2.1rem)!important;line-height:1.04!important;margin:0 0 10px!important}
.combo p{font-size:.95rem!important;line-height:1.65!important;margin:0 0 16px!important}
.combo-products span{padding:9px 12px!important;font-size:.72rem!important}
.combo .price{font-size:2.2rem!important}
.combo .old{font-size:1.02rem!important}
.combo-actions{gap:12px!important;margin-top:18px!important}
.combo-actions .btn{min-height:48px!important;font-size:.92rem!important}
.combo-actions .btn-secondary{background:rgba(255,255,255,.06)!important}
.combo-detail-visual{padding:18px!important}
.combo-detail-stage{display:grid!important;grid-template-rows:1fr 1fr;gap:14px!important;min-height:280px!important}
.combo-detail-main,.combo-detail-secondary{position:static!important;width:100%!important;height:100%!important;max-width:none!important;object-fit:contain!important;padding:16px!important;border-radius:18px!important;background:linear-gradient(180deg,rgba(7,19,35,.88),rgba(13,31,54,.98));border:1px solid rgba(67,197,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 18px 30px rgba(0,0,0,.18)}
@media(max-width:760px){
  .combo{min-height:340px!important;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr)!important}
  .combo-visual{padding:14px!important;gap:12px!important}
  .combo-image-card{min-height:128px!important}
  .combo-image-card img{padding:14px!important}
  .combo-image-card.secondary img{padding:12px 20px!important}
  .combo-copy{padding:16px 14px 16px!important}
  .combo h3{font-size:1.22rem!important}
  .combo p{font-size:.79rem!important;line-height:1.55!important}
  .combo-products span{font-size:.62rem!important;padding:8px 10px!important}
  .combo .price{font-size:1.82rem!important}
  .combo .old{font-size:.92rem!important}
  .combo-actions .btn{min-height:42px!important;font-size:.78rem!important}
  .combo-main-actions{grid-template-columns:1fr!important}
}
@media(max-width:420px){
  .combo{grid-template-columns:minmax(0,.84fr) minmax(0,1.16fr)!important}
  .combo-image-card{min-height:118px!important;border-radius:18px!important}
  .combo-image-card img{padding:12px!important}
  .combo-image-label{left:9px;bottom:9px;font-size:.56rem;padding:6px 8px}
  .combo h3{font-size:1.08rem!important}
  .combo p{font-size:.73rem!important;margin-bottom:12px!important}
  .combo .price{font-size:1.6rem!important}
  .combo-actions .btn{font-size:.72rem!important;min-height:39px!important}
}


/* v8.23 · misión y visión en dos líneas reales */
#heroSubtitle{
  width:100%!important;
  max-width:none!important;
  white-space:pre!important;
  text-align:center!important;
  font-size:clamp(.58rem,2.2vw,.90rem)!important;
  line-height:1.65!important;
  letter-spacing:0!important;
}

.footer-social{flex-wrap:nowrap;justify-content:center;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-ms-overflow-style:none;padding-inline:2px}
.footer-social::-webkit-scrollbar{display:none}
