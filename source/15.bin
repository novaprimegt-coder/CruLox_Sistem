function cc394ToolIcon(i){const a=['◈','◎','◇','▣','↻','✓','⌁','⊙','△','≡','⇄','⊕'];return a[i%a.length]}
function cc394ModuleSummary(id){const os=orders(),ps=products(),us=users();const data={catalog:[ps.length,'productos'],products:[ps.length,'productos'],clients:[us.length,'clientes'],sales:[os.filter(paid).length,'ventas confirmadas'],orders:[os.length,'pedidos'],delivery:[os.filter(o=>String(o?.status||'')==='Listo para entregar').length,'por entregar'],subscriptions:[renewalRows().length,'suscripciones/perfiles'],profiles:[renewalRows().length,'asignaciones detectadas'],finance:[os.filter(paid).reduce((a,o)=>a+n(o?.total),0),'ingresos confirmados'],payments:[os.filter(o=>receipt(o)&&!paid(o)).length,'por verificar'],receipts:[os.filter(o=>receipt(o)&&!paid(o)).length,'comprobantes pendientes']};return data[id]||[0,'registros vinculados']}
function cc394OpenTool(moduleId,index){const info=MODULES[moduleId],tools=CC394_TOOLSETS[moduleId]||[],t=tools[index];if(!info||!t)return false;const x=ensureShell();if(!x?.stage)return false;const os=orders(),ps=products(),us=users();let rows=[];
 if(moduleId==='orders')rows=os.slice(-20).reverse().map(o=>[o?.id||'Pedido',o?.customer?.fullName||'Cliente',o?.status||o?.payment?.status||'Pendiente',money(o?.total)]);
 else if(moduleId==='clients')rows=us.slice(-20).reverse().map(u=>[u?.fullName||u?.username||'Cliente',u?.email||'Sin correo',u?.phone||'', '']);
 else if(['catalog','products'].includes(moduleId))rows=ps.slice(0,20).map(p=>[p?.name||'Producto',p?.category||p?.digitalKind||'Digital',p?.active===false?'Oculto':'Activo',money(p?.price)]);
 else if(['sales','payments','receipts','delivery'].includes(moduleId))rows=os.slice(-20).reverse().map(o=>[o?.id||'Pedido',o?.customer?.fullName||'Cliente',o?.payment?.status||o?.status||'Pendiente',money(o?.total)]);
 else if(['subscriptions','profiles'].includes(moduleId))rows=renewalRows().slice(0,20).map(r=>[r?.product||'Servicio',r?.days<0?'Vencido':`${r?.days} días`,r?.state||'',r?.orderId||'']);
 const table=rows.length?`<div class="cc394-table">${rows.map(r=>`<div class="cc394-tr">${r.map((c,j)=>`<span class="c${j}">${esc(c)}</span>`).join('')}</div>`).join('')}</div>`:`<div class="cc390-empty">No hay registros vinculados todavía. La herramienta queda disponible y mostrará información cuando el sistema tenga datos.</div>`;
 x.stage.innerHTML=`<section class="cc378-module-window"><header class="cc378-module-head"><button class="cc378-back" id="cc394ToolBack">← <span>Volver</span></button><div class="cc378-module-id"><span class="cc378-module-icon">${iconFor389(moduleId)}</span><div><h1>${esc(t[0])}</h1><p>${esc(info[1])} · ${esc(t[1])}</p></div></div></header><div class="cc378-module-body cc394-tool-view"><section class="cc394-tool-hero"><span>${cc394ToolIcon(index)}</span><div><small>HERRAMIENTA OPERATIVA</small><h2>${esc(t[0])}</h2><p>${esc(t[1])}</p></div></section><section class="cc394-info"><div><small>Módulo</small><b>${esc(info[1])}</b></div><div><small>Estado</small><b>Disponible</b></div><div><small>Fuente</small><b>Datos del sistema</b></div></section>${table}<p class="cc394-note">Esta vista no inventa datos. Cuando una automatización dependa de servicios externos (pagos, correo, WhatsApp o backend), requerirá su integración real para ejecutarse automáticamente.</p></div></section>`;
 D.getElementById('cc394ToolBack')?.addEventListener('click',()=>openModule(moduleId),{once:true});x.overlay.scrollTop=0;return true;
}
function openModule(id){if(id==='panel')return panelGeneral();if(id==='renewals')return renewalModule();const x=ensureShell();if(!x?.stage)return false;const info=MODULES[id];if(!info)return false;const ico=iconFor389(id),tools=CC394_TOOLSETS[id]||[];const summary=cc394ModuleSummary(id);x.stage.innerHTML=`<section class="cc378-module-window" data-cc378-window="${esc(id)}"><header class="cc378-module-head"><button type="button" class="cc378-back" id="cc388Back" aria-label="Volver a funciones">← <span>Funciones</span></button><div class="cc378-module-id"><span class="cc378-module-icon">${ico}</span><div><h1>${esc(info[1])}</h1><p>${esc(info[2])}</p></div></div></header><div class="cc378-module-body cc394-module-body"><section class="cc394-module-hero"><div><small>CENTRO OPERATIVO</small><h2>${esc(info[1])}</h2><p>${esc(info[2])}</p></div><div class="cc394-module-count"><b>${tools.length}</b><span>herramientas</span></div></section><div class="cc394-module-stat"><b>${typeof summary[0]==='number'&&id==='finance'?money(summary[0]):esc(summary[0])}</b><span>${esc(summary[1])}</span></div><div class="cc394-tools-grid">${tools.map((t,i)=>`<button type="button" class="cc394-tool-card" data-cc394-tool="${i}"><span class="cc394-tool-symbol">${cc394ToolIcon(i)}</span><span><b>${esc(t[0])}</b><small>${esc(t[1])}</small></span><em>›</em></button>`).join('')}</div></div></section>`;D.getElementById('cc388Back')?.addEventListener('click',renderFunctions,{once:true});x.stage.querySelectorAll('[data-cc394-tool]').forEach(b=>b.addEventListener('click',()=>cc394OpenTool(id,Number(b.dataset.cc394Tool)),{once:true}));x.overlay.scrollTop=0;x.overlay.scrollLeft=0;return true;}
function install(){if(!D.getElementById('adminOverlay'))return false;try{window.openAdmin=openAdmin;window.renderAdminSection=(id)=>id?openModule(id):renderFunctions;window.renderAdminV2=(id)=>openModule(id||'panel')}catch(e){}try{openAdmin=openAdmin;renderAdminSection=window.renderAdminSection;renderAdminV2=window.renderAdminV2}catch(e){}return true}
// Capture final admin navigation so no legacy layer can hijack module clicks.
D.addEventListener('click',e=>{const b=e.target?.closest?.('#cc378AdminNav [data-cc378-section]');if(!b)return;e.preventDefault();e.stopImmediatePropagation();openModule(b.dataset.cc378Section)},true);
D.addEventListener('click',e=>{const t=e.target?.closest?.('#cc378Store,#cc378Logout,#adminStoreBtn,#adminLogout');if(!t)return;e.preventDefault();e.stopImmediatePropagation();if(t.id==='cc378Logout'||t.id==='adminLogout')logout();else closeAdmin()},true);
D.addEventListener('click',e=>{const p=e.target?.closest?.('#profileBtn,#drawerProfile,#footerProfile');if(!p)return;let ok=false;try{ok=window.CRUZCLICK_V3718?.ownerSession?.()||false}catch(_){}if(!ok)return;e.preventDefault();e.stopImmediatePropagation();openAdmin()},true);
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(install,0),{once:true});else setTimeout(install,0);setTimeout(install,200);setTimeout(install,1000);
function bootLeakGuard389(){try{scrubRuntimeLeak389();}catch(e){}}
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>{bootLeakGuard389();setTimeout(bootLeakGuard389,250);setTimeout(bootLeakGuard389,1000)},{once:true});else{bootLeakGuard389();setTimeout(bootLeakGuard389,250);setTimeout(bootLeakGuard389,1000)}
new MutationObserver(()=>{try{scrubRuntimeLeak389()}catch(e){}}).observe(D.body,{childList:true,subtree:true});
window.CRUZCLICK_V388=Object.freeze({version:'3.8.9',openAdmin,closeAdmin,logout,renderFunctions,openModule,panelGeneral});
})();
</script>

<script id="cruzclick-v389-selftest">
(()=>{
  'use strict';
  function run(){
    const nav=document.getElementById('cc378AdminNav');
    const buttons=nav?[...nav.querySelectorAll('[data-cc378-section]')]:[];
    const iconOk=buttons.length===37&&buttons.every(b=>b.querySelector('svg'));
    const expected=['panel','catalog','products','clients','sales','orders','delivery','subscriptions','profiles','finance','payments','support','communication','marketing','promotions','loyalty','referrals','stats','reports','notifications','alerts','incidents','receipts','suppliers','commissions','profitability','history','audit','permissions','security','automation','integrations','content','files','importexport','backup','settings'];const orderOk=buttons.map(b=>b.dataset.cc378Section).join(',')===expected.join(',');
    const returnOk=!!document.getElementById('cc389PanelBack')||!!document.getElementById('cc388Back');
    const visibleLeak=!!document.body.innerText.match(/adminObs34|JM_DIGITAL_STORE_V34|w\.document\.write|window\.JM_DIGITAL_STORE_V34/);
    window.CRUZCLICK_V389_SELF_TEST={version:'3.8.9',iconOk,orderOk,returnOk,visibleLeak,ok:iconOk&&orderOk&&!visibleLeak};
    document.documentElement.dataset.ccV389=window.CRUZCLICK_V389_SELF_TEST.ok?'ok':'review';
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(run,250),{once:true});else setTimeout(run,250);
})();
</script>


<!-- CRULOX V3.9.0 · Capa de presentación profesional + aislamiento de errores -->
<style id="cruzclick-v390-premium-stability">
/* =========================================================
   V3.9.0 — SOLO PANEL ADMINISTRATIVO
   - Corrige el botón de retorno que se partía verticalmente.
   - Centra los iconos de las 37 funciones.
   - Mejora jerarquía visual, profundidad y legibilidad.
   - Evita overflow horizontal y textos comprimidos.
   ========================================================= */
#adminOverlay .cc378-admin,
#adminOverlay .cc378-admin *{box-sizing:border-box}

#adminOverlay .cc378-admin{
  --a-cyan:#55ecff;
  --a-blue:#668cff;
  --a-green:#2ff0a3;
  --a-red:#ff5e78;
  --a-text:#f4fbff;
  --a-soft:#9ab5c5;
  --a-line:rgba(111,222,255,.14);
  background:
    radial-gradient(900px 500px at 50% -10%,rgba(0,231,255,.12),transparent 68%),
    radial-gradient(600px 420px at 100% 30%,rgba(91,99,255,.10),transparent 68%),
    radial-gradient(650px 420px at 0% 80%,rgba(0,255,180,.06),transparent 68%),
    linear-gradient(180deg,#020812 0%,#03131f 46%,#020810 100%);
}

#adminOverlay .cc378-bar{
  min-height:72px!important;
  padding:12px 14px!important;
  border-radius:22px!important;
  border-color:rgba(119,229,255,.18)!important;
  background:
    linear-gradient(135deg,rgba(12,34,53,.94),rgba(4,16,28,.91))!important;
  box-shadow:
    0 22px 60px rgba(0,0,0,.36),
    inset 0 1px 0 rgba(255,255,255,.055),
    0 0 0 1px rgba(0,210,255,.025)!important;
}

#adminOverlay .cc378-brand{gap:11px!important}
#adminOverlay .cc378-brand img{
  width:42px!important;height:42px!important;flex-basis:42px!important;
  border-radius:13px!important;
  box-shadow:0 0 30px rgba(0,226,255,.14)!important;
}
#adminOverlay .cc378-brand b{font-size:.91rem!important;letter-spac