#adminOverlay .cc378-module-head{display:grid!important;grid-template-columns:auto minmax(0,1fr)!important;align-items:center!important;gap:10px!important}
#adminOverlay .cc378-module-id{min-width:0!important;display:flex!important;align-items:center!important;gap:10px!important}
#adminOverlay .cc378-module-id>div{min-width:0!important}
#adminOverlay .cc378-module-icon{display:grid!important;place-items:center!important}
#adminOverlay .cc378-module-icon svg,#adminOverlay .cc378-module-body .bigicon svg{display:block!important;stroke:currentColor!important;fill:none!important;stroke-width:2.15!important;stroke-linecap:round!important;stroke-linejoin:round!important}
#adminOverlay .cc378-module-body .bigicon{display:grid!important;place-items:center!important}
@media(max-width:600px){#adminOverlay .cc378-nav button{grid-template-columns:56px minmax(0,1fr)!important;column-gap:9px!important;min-height:118px!important;padding:13px!important}.cc389-back-label{display:inline!important}#adminOverlay .cc378-nav-icon{width:48px!important;height:48px!important;border-radius:14px!important}.cc378-nav-icon svg{width:28px!important;height:28px!important}}
@media(max-width:380px){#adminOverlay .cc378-nav button{grid-template-columns:48px minmax(0,1fr)!important;column-gap:8px!important;min-height:108px!important;padding:10px!important}#adminOverlay .cc378-nav-icon{width:42px!important;height:42px!important;border-radius:12px!important}#adminOverlay .cc378-nav-icon svg{width:25px!important;height:25px!important}}
</style>
<!-- CRULOX V3.8.8 · Estabilidad final, enrutamiento administrativo y protección contra fugas de código -->
<style id="cruzclick-v388-final-style">
#adminOverlay .cc388-dashboard{display:grid;gap:14px;min-width:0}
#adminOverlay .cc388-hero{position:relative;overflow:hidden;padding:18px;border-radius:22px;border:1px solid rgba(62,221,255,.16);background:radial-gradient(circle at 88% 12%,rgba(0,220,255,.14),transparent 30%),radial-gradient(circle at 14% 100%,rgba(72,98,255,.11),transparent 35%),linear-gradient(145deg,#0b2438,#06121f 68%);box-shadow:0 20px 52px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.04)}
#adminOverlay .cc388-hero h2{margin:6px 0 5px;color:#f5fbff;font-size:1.2rem;letter-spacing:-.02em}
#adminOverlay .cc388-hero p{margin:0;color:#89a5b7;font-size:.62rem;line-height:1.6;max-width:720px}
#adminOverlay .cc388-kicker{display:inline-flex;align-items:center;gap:7px;color:#66e8ff;font-size:.49rem;font-weight:950;letter-spacing:.13em;text-transform:uppercase}
#adminOverlay .cc388-kicker i{width:7px;height:7px;border-radius:50%;background:#29df83;box-shadow:0 0 12px rgba(41,223,131,.65)}
#adminOverlay .cc388-live{display:inline-flex;align-items:center;gap:6px;margin-top:9px;padding:7px 10px;border-radius:999px;border:1px solid rgba(41,223,131,.20);background:rgba(41,223,131,.06);color:#72f1a9;font-size:.47rem;font-weight:900}
#adminOverlay .cc388-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
#adminOverlay .cc388-kpi{position:relative;overflow:hidden;min-width:0;padding:14px;border-radius:17px;border:1px solid rgba(123,201,238,.10);background:linear-gradient(145deg,rgba(11,32,49,.97),rgba(5,17,29,.99));box-shadow:0 13px 30px rgba(0,0,0,.20)}
#adminOverlay .cc388-kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(#1fe4ff,rgba(31,228,255,0))}
#adminOverlay .cc388-kpi small{display:block;color:#7894aa;font-size:.49rem;font-weight:800}
#adminOverlay .cc388-kpi strong{display:block;margin-top:6px;color:#effaff;font-size:1.22rem;line-height:1}
#adminOverlay .cc388-kpi span{display:block;margin-top:6px;color:#45ddfa;font-size:.43rem;font-weight:800}
#adminOverlay .cc388-section{padding:14px;border-radius:18px;border:1px solid rgba(123,201,238,.08);background:linear-gradient(145deg,rgba(8,24,39,.95),rgba(4,14,24,.98));box-shadow:0 14px 34px rgba(0,0,0,.18)}
#adminOverlay .cc388-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-bottom:10px}
#adminOverlay .cc388-section-head h3{margin:0;color:#eef9ff;font-size:.75rem}
#adminOverlay .cc388-section-head p{margin:3px 0 0;color:#718ba1;font-size:.49rem;line-height:1.4}
#adminOverlay .cc388-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
#adminOverlay .cc388-card{min-width:0;padding:11px;border-radius:14px;border:1px solid rgba(123,201,238,.07);background:rgba(255,255,255,.018)}
#adminOverlay .cc388-card-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
#adminOverlay .cc388-card h4{margin:0;color:#e8f6ff;font-size:.59rem}
#adminOverlay .cc388-num{font-size:.95rem;color:#21ddff;font-weight:950}
#adminOverlay .cc388-card p{margin:5px 0 0;color:#71899f;font-size:.48rem;line-height:1.45}
#adminOverlay .cc388-bar{height:5px;margin-top:8px;border-radius:999px;background:rgba(255,255,255,.045);overflow:hidden}
#adminOverlay .cc388-bar b{display:block;height:100%;width:var(--w,0%);border-radius:inherit;background:linear-gradient(90deg,#16cce9,#5b8cff);box-shadow:0 0 12px rgba(20,210,255,.25)}
#adminOverlay .cc388-list{display:grid;gap:6px}
#adminOverlay .cc388-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto;align-items:center;gap:8px;padding:8px;border-radius:12px;background:rgba(255,255,255,.018);border:1px solid rgba(123,201,238,.055)}
#adminOverlay .cc388-row-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:rgba(0,215,255,.065);border:1px solid rgba(0,215,255,.08);color:#63eaff;font-size:.75rem}
#adminOverlay .cc388-row-icon svg{width:22px;height:22px;display:block;stroke:#63eaff;fill:none;stroke-width:2.35;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
#adminOverlay .cc388-row b{display:block;color:#dcecf5;font-size:.55rem}
#adminOverlay .cc388-row span{display:block;margin-top:2px;color:#6f879c;font-size:.46rem;line-height:1.35}
#adminOverlay .cc388-badge{padding:5px 7px;border-radius:999px;background:rgba(255,255,255,.035);color:#79dff1;font-size:.43rem;font-weight:900;white-space:nowrap}
#adminOverlay .cc388-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
#adminOverlay .cc388-action{min-width:0;padding:10px;border-radius:13px;border:1px solid rgba(123,201,238,.08);background:linear-gradient(145deg,rgba(12,35,53,.95),rgba(5,17,29,.98));color:#eefaff;text-align:left;cursor:pointer;touch-action:manipulation}
#adminOverlay .cc388-action b{display:block;font-size:.56rem}
#adminOverlay .cc388-action span{display:block;margin-top:4px;color:#758ea2;font-size:.44rem;line-height:1.4}
#adminOverlay .cc388-system{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
#adminOverlay .cc388-system>div{padding:10px;border-radius:12px;background:rgba(255,255,255,.018);border:1px solid rgba(123,201,238,.055)}
#adminOverlay .cc388-system small{display:block;color:#6e889e;font-size:.44rem}
#adminOverlay .cc388-system b{display:block;margin-top:4px;color:#ecfbff;font-size:.61rem}
#adminOverlay .cc388-empty{padding:14px;border-radius:13px;border:1px dashed rgba(123,201,238,.10);color:#70889c;font-size:.52rem;text-align:center}
#adminOverlay .cc388-module-tools{margin-top:14px;display:grid;gap:10px}
#adminOverlay .cc388-module-tool-card{padding:13px;border-radius:15px;border:1px solid rgba(123,201,238,.08);background:linear-gradient(145deg,rgba(11,31,48,.94),rgba(4,16,27,.98));text-align:left}
#adminOverlay .cc388-module-tool-card h3{margin:0;color:#effaff;font-size:.65rem}
#adminOverlay .cc388-module-tool-card p{margin:5px 0 0;color:#7892a6;font-size:.49rem;line-height:1.5}
@media(max-width:760px){#adminOverlay .cc388-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#adminOverlay .cc388-actions{grid-template-columns:repeat(2,minmax(0,1fr))}#adminOverlay .cc388-system{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:460px){#adminOverlay .cc388-hero{padding:14px}#adminOverlay .cc388-hero h2{font-size:1.05rem}#adminOverlay .cc388-hero p{font-size:.58rem}#adminOverlay .cc388-grid{grid-template-columns:1fr}#adminOverlay .cc388-actions{grid-template-columns:1fr}#adminOverlay .cc388-system{grid-template-columns:1fr 1fr}}
</style>
<script id="cruzclick-v388-final-stability">
(()=>{
'use strict';
const D=document;
const MODULES={
 panel:['01','Panel General','Vista central y control operativo del negocio.'],
 renewals:['02','Renovaciones y Vencimientos','Perfiles y cuentas por vencer, renovar o liberar.'],
 catalog:['03','Catálogo','Organización y administración del catálogo.'],
 products:['04','Productos y Servicios','Productos, servicios, precios, variantes y disponibilidad.'],
 clients:['05','Clientes','Gestión de clientes, datos y relación comercial.'],
