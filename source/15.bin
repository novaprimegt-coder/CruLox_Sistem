  communication:[["Centro de mensajes", "Comunicaciones salientes"], ["Plantillas", "Mensajes de compra, pago y entrega"], ["Avisos de vencimiento", "Mensajes 5 días antes"], ["Confirmación de pago", "Aviso automático al aprobar"], ["Confirmación de entrega", "Mensaje final por método"], ["Mensajes masivos", "Segmentos autorizados"], ["Canales", "Chat, correo, WhatsApp u otros"], ["Historial de envíos", "Qué se envió, cuándo y a quién"], ["Preferencias del cliente", "Canales y consentimiento"]],
  marketing:[["Panel de campañas", "Campañas activas y resultados"], ["Fuentes de clientes", "Origen de cada compra"], ["UTM/códigos de campaña", "Atribución comercial"], ["CAC", "Costo de adquisición de cliente"], ["Conversión", "Visitas o leads frente a compras"], ["Productos promocionados", "Rendimiento por producto"], ["Segmentos", "Audiencias por comportamiento"], ["Calendario comercial", "Planificación de campañas"], ["Presupuesto de marketing", "Inversión y retorno"], ["ROI de campaña", "Ingresos atribuibles vs gasto"]],
