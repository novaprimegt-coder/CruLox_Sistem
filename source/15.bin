odule-body .cc378-module-placeholder .bigicon{width:84px;height:84px;margin:0 auto 14px;border-radius:24px;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,rgba(0,225,255,.16),rgba(72,111,255,.06) 70%);border:1px solid rgba(0,225,255,.17);box-shadow:0 0 34px rgba(0,225,255,.07)}
#adminOverlay .cc378-module-body .bigicon svg{width:42px;height:42px;stroke:#79efff;fill:none;stroke-width:2.15;stroke-linecap:round;stroke-linejoin:round}
#adminOverlay .cc378-module-body h2{margin:0 0 7px;font-size:1rem;color:#f6fbff}
#adminOverlay .cc378-module-body p{margin:0;font-size:.58rem;line-height:1.6;color:#86a7b8;max-width:490px}
#adminOverlay .cc378-section-note{display:inline-flex;margin-top:12px;padding:7px 10px;border-radius:999px;border:1px solid rgba(34,223,243,.16);background:rgba(34,223,243,.045);color:#71ddea;font-size:.46rem;font-weight:900}
@media(max-width:640px){
  #adminOverlay .cc378-admin{padding:9px;gap:9px}
  #adminOverlay .cc378-bar{min-height:58px;padding:9px 10px;border-radius:16px}
  #adminOverlay .cc378-brand img{width:32px;height:32px;flex-basis:32px}
  #adminOverlay .cc378-brand b{font-size:.74rem}
  #adminOverlay .cc378-brand span{font-size:.43rem}
  #adminOverlay .cc378-btn{min-height:31px;padding:0 9px;font-size:.53rem}
  #adminOverlay .cc378-nav{gap:9px}
  #adminOverlay .cc378-nav button{min-height:126px;padding:15px 12px;border-radius:18px;gap:9px}
  #adminOverlay .cc378-nav-icon{width:48px;height:48px;border-radius:15px}
  #adminOverlay .cc378-nav-icon svg{width:26px;height:26px}
  #adminOverlay .cc378-nav-label{font-size:.66rem}
  #adminOverlay .cc378-nav-sub{font-size:.43rem}
  #adminOverlay .cc378-nav button:nth-child(37){width:calc(50% - 4.5px)}
  #adminOverlay .cc378-module-window{min-height:calc(100dvh - 78px);padding:13px;border-radius:18px}
  #adminOverlay .cc378-module-body{min-height:calc(100dvh - 178px);padding:14px}
}
@media(max-width:360px){
  #adminOverlay .cc378-nav{gap:7px}
  #adminOverlay .cc378-nav button{min-height:116px;padding:12px 9px}
  #adminOverlay .cc378-nav-icon{width:44px;height:44px;border-radius:14px}
  #adminOverlay .cc378-nav-index{right:9px;top:9px}
}
</style>
<script id="cruzclick-v385-admin-reset-script">
(function(){
  'use strict';
  const D=document;
  const overlay=()=>D.getElementById('adminOverlay');
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const getName=()=>{try{return String(state?.settings?.storeName||'CRULOX')}catch(e){return 'CRULOX'}};
  const getLogo=()=>{try{return typeof BRAND_LOGO!=='undefined'?BRAND_LOGO:''}catch(e){return ''}};
  function closeAdmin385(){const el=overlay();if(!el)return false;el.classList.remove('open');el.removeAttribute('data-cc-owner-auth');D.body.classList.remove('lock');return true}
  function logout385(){try{if(typeof state!=='undefined')state.session=null;if(typeof safeWrite==='function'&&typeof KEYS!=='undefined')safeWrite(KEYS.session,null);else if(typeof write==='function'&&typeof KEYS!=='undefined')write(KEYS.session,null)}catch(e){}closeAdmin385();try{if(typeof renderHeader==='function')renderHeader()}catch(e){}}
  const ADMIN_SECTIONS_385=Object.freeze({
    panel:{id:'panel',label:'Panel General',lead:'Vista central y control del negocio.',number:'01',icon:`<svg viewBox="0 0 48 48"><rect x="6" y="6" width="15" height="15" rx="3"/><rect x="27" y="6" width="15" height="10" rx="3"/><rect x="27" y="20" width="15" height="22" rx="3"/><rect x="6" y="25" width="15" height="17" rx="3"/><path d="M12 12h3M32 11h5M12 31h3M32 27h5M32 33h5"/></svg>`},
    catalog:{id:'catalog',label:'Catálogo',lead:'Organización y administración del catálogo.',number:'02',icon:`<svg viewBox="0 0 48 48"><path d="M7 11h34v8H7z"/><path d="M9 19h30v22H9z"/><path d="M15 25h18M15 31h14M15 37h10"/></svg>`},
    products:{id:'products',label:'Productos y Servicios',lead:'Productos, servicios, precios, variantes y disponibilidad.',number:'03',icon:`<svg viewBox="0 0 48 48"><path d="M8 16 24 8l16 8-16 8Z"/><path d="M8 16v17l16 7 16-7V16"/><path d="M24 24v16M16 12l16 8"/><path d="M35 8v10M30 13h10"/></svg>`},
    clients:{id:'clients',label:'Clientes',lead:'Gestión de clientes, datos y relación comercial.',number:'04',icon:`<svg viewBox="0 0 48 48"><circle cx="18" cy="16" r="6"/><path d="M7 37c0-8 5-12 11-12s11 4 11 12"/><circle cx="34" cy="19" r="4"/><path d="M29 37c.5-5 3.5-8 8-8 2 0 3.7.7 5 2"/></svg>`},
    sales:{id:'sales',label:'Ventas',lead:'Registro y seguimiento de las ventas.',number:'05',icon:`<svg viewBox="0 0 48 48"><path d="M8 9h6l3 21h20l4-15H16"/><circle cx="20" cy="38" r="3"/><circle cx="35" cy="38" r="3"/><path d="M28 7v10M23 12h10"/></svg>`},
    orders:{id:'orders',label:'Pedidos',lead:'Gestión y seguimiento de pedidos.',number:'06',icon:`<svg viewBox="0 0 48 48"><rect x="9" y="7" width="30" height="34" rx="4"/><path d="M16 15h16M16 22h16M16 29h8"/><path d="m29 31 3 3 6-7"/></svg>`},
    delivery:{id:'delivery',label:'Entregas Digitales',lead:'Control y seguimiento de entregas digitales.',number:'07',icon:`<svg viewBox="0 0 48 48"><rect x="7" y="10" width="23" height="25" rx="3"/><path d="M30 18h6l5 6v11H30z"/><path d="M14 22h10M24 18l-5 5 5 5"/><circle cx="15" cy="38" r="3"/><circle cx="36" cy="38" r="3"/></svg>`},
    subscriptions:{id:'subscriptions',label:'Suscripciones',lead:'Gestión de suscripciones y renovaciones.',number:'08',icon:`<svg viewBox="0 0 48 48"><path d="M16 11a15 15 0 0 1 22 9"/><path d="m36 9 2 11-10-3"/><path d="M32 37a15 15 0 0 1-22-9"/><path d="m12 39-2-11 10 3"/><rect x="18" y="18" width="12" height="12" rx="2"/></svg>`},
    profiles:{id:'profiles',label:'Cuentas y Perfiles',lead:'Control de cuentas, perfiles y accesos de clientes.',number:'09',icon:`<svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="7"/><path d="M10 39c1-8 6-12 14-12s13 4 14 12"/><rect x="31" y="29" width="10" height="10" rx="2"/><path d="M36 32v4M34 34h4"/></svg>`},
    finance:{id:'finance',label:'Finanzas',lead:'Control financiero general del negocio.',number:'10',icon:`<svg viewBox="0 0 48 48"><path d="M7 15h34v24H7z"/><path d="M7 19h34"/><path d="M13 29h8M13 34h13"/><circle cx="34" cy="30" r="4"/></svg>`},
    payments:{id:'payments',label:'Pagos',lead:'Registro y control de pagos y cobros.',number:'11',icon:`<svg viewBox="0 0 48 48"><rect x="6" y="11" width="36" height="25" rx="4"/><path d="M6 18h36"/><path d="m17 27 4 4 10-10"/></svg>`},
    support:{id:'support',label:'Atención al Cliente',lead:'Atención, seguimiento y resolución de consultas.',number:'12',icon:`<svg viewBox="0 0 48 48"><path d="M8 25a16 16 0 0 1 32 0"/><path d="M8 25v9h7v-9H8ZM33 25v9h7v-9h-7Z"/><path d="M15 36c2 4 8 5 12 2"/><circle cx="24" cy="39" r="2"/></svg>`},
    communication:{id:'communication',label:'Comunicación',lead:'Canales y comunicaciones con clientes.',number:'13',icon:`<svg viewBox="0 0 48 48"><path d="M7 10h24v18H16l-8 7v-7H7z"/><path d="M25 19h16v15H31l-6 5v-5"/><path d="M12 17h14M12 22h9"/></svg>`},
    marketing:{id:'marketing',label:'Marketing',lead:'Gestión de acciones y campañas de marketing.',number:'14',icon:`<svg viewBox="0 0 48 48"><path d="m9 24 23-10v20L9 24z"/><path d="M32 19h5a7 7 0 0 1 0 10h-5"/><path d="M13 28v11h7l3-8"/></svg>`},
    promotions:{id:'promotions',label:'Promociones',lead:'Promociones, descuentos y campañas comerciales.',number:'15',icon:`<svg viewBox="0 0 48 48"><path d="M7 17 17 7h22v22L29 39 7 17z"/><circle cx="28" cy="17" r="3"/><path d="M17 24l12-8M18 30h.01M28 25h.01"/></svg>`},
    loyalty:{id:'loyalty',label:'Fidelización',lead:'Programas para retención y fidelización.',number:'16',icon:`<svg viewBox="0 0 48 48"><path d="m24 7 5 10 11 1-8 7 3 11-11-6-11 6 3-11-8-7 11-1z"/><path d="M18 40h12"/></svg>`},
    referrals:{id:'referrals',label:'Referidos',lead:'Programa y seguimiento de referidos.',number:'17',icon:`<svg viewBox="0 0 48 48"><circle cx="12" cy="24" r="5"/><circle cx="36" cy="12" r="5"/><circle cx="36" cy="36" r="5"/><path d="m16 22 15-8M16 26l15 8"/></svg>`},
    stats:{id:'stats',label:'Estadística',lead:'Indicadores y métricas del negocio.',number:'18',icon:`<svg viewBox="0 0 48 48"><path d="M7 41V7M7 41h34"/><rect x="13" y="27" width="6" height="10" rx="1"/><rect x="23" y="21" width="6" height="16" rx="1"/><rect x="33" y="13" width="6" height="24" rx="1"/></svg>`},
    reports:{id:'reports',label:'Reportes',lead:'Generación y consulta de reportes.',number:'19',icon:`<svg viewBox="0 0 48 48"><path d="M12 6h18l7 7v29H12z"/><path d="M30 6v8h7M18 24h14M18 30h14M18 36h9"/></svg>`},
    notifications:{id:'notifications',label:'Notificaciones',lead:'Gestión de avisos y notificaciones.',number:'20',icon:`<svg viewBox="0 0 48 48"><path d="M12 33h24l-3-5V21a9 9 0 0 0-18 0v7z"/><path d="M20 38c1 2 3 3 4 3s3-1 4-3"/></svg>`},
    alerts:{id:'alerts',label:'Alertas',lead:'Alertas y avisos operativos.',number:'21',icon:`<svg viewBox="0 0 48 48"><path d="m24 7 18 32H6L24 7z"/><path d="M24 18v10M24 33h.01"/></svg>`},
    incidents:{id:'incidents',label:'Incidencias',lead:'Registro y seguimiento de incidencias.',number:'22',icon:`<svg viewBox="0 0 48 48"><path d="M24 6 39 11v11c0 10-6 17-15 20C15 39 9 32 9 22V11z"/><path d="M24 15v11M24 32h.01"/></svg>`},
    receipts:{id:'receipts',label:'Comprobantes',lead:'Gestión de comprobantes y constancias.',number:'23',icon:`<svg viewBox="0 0 48 48"><path d="M11 7h26v34l-5-3-4 3-4-3-4 3-4-3-5 3z"/><path d="M16 15h16M16 21h16M16 27h10M16 33h7"/></svg>`},
    suppliers:{id:'suppliers',label:'Proveedores',lead:'Gestión de proveedores y relaciones comerciales.',number:'24',icon:`<svg viewBox="0 0 48 48"><path d="M7 20h15v18H7zM26 28h9l6 6v4H26z"/><path d="M10 20V11h13v9M30 28v-7h7l4 7"/><circle cx="15" cy="41" r="3"/><circle cx="34" cy="41" r="3"/></svg>`},
    commissions:{id:'commissions',label:'Comisiones',lead:'Control de comisiones y repartos.',number:'25',icon:`<svg viewBox="0 0 48 48"><circle cx="17" cy="17" r="8"/><circle cx="31" cy="31" r="8"/><path d="M17 13v8M13 17h8M31 27v8M27 31h8"/><path d="m22 22 4 4"/></svg>`},
    profitability:{id:'profitability',label:'Rentabilidad',lead:'Análisis de rentabilidad por operación y servicio.',number:'26',icon:`<svg viewBox="0 0 48 48"><path d="M8 38V8M8 38h32"/><path d="m13 31 8-9 6 5 11-14"/><path d="M31 13h7v7"/></svg>`},
    history:{id:'history',label:'Historial de Actividad',lead:'Registro de actividad del sistema.',number:'27',icon:`<svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="16"/><path d="M24 15v10l7 5M8 24H4l4-4"/></svg>`},
    audit:{id:'audit',label:'Auditoría',lead:'Revisión y trazabilidad de acciones administrativas.',number:'28',icon:`<svg viewBox="0 0 48 48"><path d="M9 8h22l8 8v24H9z"/><path d="M31 8v9h8M16 24h11M16 30h9"/><circle cx="31" cy="31" r="6"/><path d="m35 35 5 5"/></svg>`},
    permissions:{id:'permissions',label:'Usuarios y Permisos',lead:'Usuarios administrativos y sus permisos.',number:'29',icon:`<svg viewBox="0 0 48 48"><circle cx="17" cy="17" r="6"/><path d="M7 37c1-7 5-11 10-11s9 4 10 11"/><circle cx="34" cy="20" r="4"/><path d="m33 34 6-6M39 34l-6-6"/></svg>`},
    security:{id:'security',label:'Seguridad',lead:'Controles de seguridad y protección administrativa.',number:'30',icon:`<svg viewBox="0 0 48 48"><path d="M24 6 40 12v10c0 10-6 17-16 20C14 39 8 32 8 22V12z"/><rect x="17" y="21" width="14" height="11" rx="2"/><path d="M20 21v-3a4 4 0 0 1 8 0v3"/></svg>`},
    automation:{id:'automation',label:'Automatización',lead:'Procesos automáticos y flujos operativos.',number:'31',icon:`<svg viewBox="0 0 48 48"><circle cx="14" cy="24" r="5"/><circle cx="34" cy="14" r="5"/><circle cx="34" cy="34" r="5"/><path d="m18 22 11-6M18 26l11 6"/><path d="m9 10 5 5 5-5-5-5z"/></svg>`},
    integrations:{id:'integrations',label:'Integraciones',lead:'Conexiones con servicios y sistemas externos.',number:'32',icon:`<svg viewBox="0 0 48 48"><path d="M19 13v8M29 27v8M15 17h-4a5 5 0 0 0 0 10h8M33 21h4a5 5 0 0 1 0 10h-8"/><path d="M19 21h10M19 27h10"/></svg>`},
    content:{id:'content',label:'Gestión de Contenido',lead:'Contenido informativo y comercial del sistema.',number:'33',icon:`<svg viewBox="0 0 48 48"><rect x="7" y="9" width="34" height="30" rx="4"/><circle cx="17" cy="18" r="3"/><path d="m11 33 9-9 7 6 5-5 5 8"/></svg>`},
    files:{id:'files',label:'Gestión de Archivos',lead:'Administración de recursos y archivos digitales.',number:'34',icon:`<svg viewBox="0 0 48 48"><path d="M6 12h14l4 5h18v22H6z"/><path d="M6 12V9h13l4 5"/></svg>`},
    importexport:{id:'importexport',label:'Importación y Exportación',lead:'Entrada y salida de datos del sistema.',number:'35',icon:`<svg viewBox="0 0 48 48"><path d="M10 8h28v32H10z"/><path d="M17 17h14M17 25h14M17 33h8"/><path d="m22 13 5 5-5 5M26 25l-5 5 5 5"/></svg>`},
    backup:{id:'backup',label:'Respaldo y Recuperación',lead:'Copias de seguridad y recuperación de información.',number:'36',icon:`<svg viewBox="0 0 48 48"><ellipse cx="24" cy="12" rx="14" ry="6"/><path d="M10 12v12c0 3 6 6 14 6s14-3 14-6V12M10 24v12c0 3 6 6 14 6s14-3 14-6V24"/><path d="M32 28h8v8M40 28l-8 8"/></svg>`},
    settings:{id:'settings',label:'Configuración',lead:'Configuración general del sistema.',number:'37',icon:`<svg viewBox="0 0 48 48"><path d="M8 14h32M8 24h32M8 34h32"/><circle cx="19" cy="14" r="4"/><circle cx="31" cy="24" r="4"/><circle cx="24" cy="34" r="4"/></svg>`}
  });
  let activeAdminSection385=null;
  function renderAdminHome385(){
    activeAdminSection385=null;
    const main=D.getElementById('cc378Stage');if(!main)return false;
    const nav=Object.values(ADMIN_SECTIONS_385).map(m=>`<button type="button" data-cc378-section="${esc(m.id)}" aria-label="Abrir ${esc(m.label)}"><span class="cc378-nav-index">${esc(m.number)}</span><span class="cc378-nav-icon">${m.icon}</span><span class="cc378-nav-label">${esc(m.label)}</span><span class="cc378-nav-sub">${esc(m.lead)}</span></button>`).join('');
    main.innerHTML=`<nav class="cc378-nav" id="cc378AdminNav" aria-label="Funciones administrativas">${nav}</nav>`;
    const adminNav=D.getElementById('cc378AdminNav');
    if(adminNav)adminNav.onclick=e=>{const b=e.target.closest('[data-cc378-section]');if(b)renderAdminSection385(b.dataset.cc378Section)};
    try{overlay()?.scrollTo({top:0,behavior:'auto'})}catch(e){try{overlay().scrollTop=0}catch(_){}}return true
  }
  function renderAdminSection385(section){
    const meta=ADMIN_SECTIONS_385[section];if(!meta)return renderAdminHome385();
    activeAdminSection385=section;
    const main=D.getElementById('cc378Stage');if(!main)return false;
    main.innerHTML=`<section class="cc378-module-window" data-cc378-window="${esc(section)}"><header class="cc378-module-head"><button type="button" class="cc378-back" id="cc378BackFunctions" aria-label="Volver a funciones">←</button><div class="cc378-module-id"><span class="cc378-module-icon">${meta.icon}</span><div><h1>${esc(meta.number)} · ${esc(meta.label)}</h1><p>${esc(meta.lead)}</p></div></div></header><div class="cc378-module-body"><div class="cc378-module-placeholder"><div class="bigicon">${meta.icon}</div><h2>${esc(meta.label)}</h2><p>Ventana independiente preparada para las herramientas específicas de este módulo.</p><span class="cc378-section-note">Módulo ${esc(meta.number)} · Herramientas por definir</span></div></div></section>`;
    const back=D.getElementById('cc378BackFunctions');if(back)back.onclick=renderAdminHome385;
    try{overlay()?.scrollTo({top:0,behavior:'auto'})}catch(e){try{overlay().scrollTop=0}catch(_){}}return true
  }
  function renderAdmin385(){
    const el=overlay();if(!el)return false;const name=getName();
    el.innerHTML=`<div class="cc378-admin"><header class="cc378-bar"><div class="cc378-brand"><img src="${esc(getLogo())}" alt="${esc(name)}"><div><b>${esc(name)}</b><span>Panel de Administración</span></div></div><div class="cc378-actions"><button type="button" class="cc378-btn primary" id="cc378Store">Tienda</button><button type="button" class="cc378-btn" id="cc378Logout">Salir</button></div></header><main class="cc378-main" id="cc378Stage"></main></div>`;
    const store=D.getElementById('cc378Store');if(store)store.onclick=closeAdmin385;
    const logout=D.getElementById('cc378Logout');if(logout)logout.onclick=logout385;
    renderAdminHome385();return true
  }
  function openAdmin385(){try{const session=typeof state!=='undefined'?state.session:null;if(!session||session.role!=='admin'||String(session.email||'').trim().toLowerCase()!=='admin-separado@crulox.invalid'||session.ownerAuthVersion!=='cruzclick-owner-v3718')return false}catch(e){return false}const el=overlay();if(!el)return false;renderAdmin385();el.setAttribute('data-cc-owner-auth','1');el.classList.add('open');D.body.classList.add('lock');return true}
  const noop=()=>false;let adminResetInstalled385=false;
  function installAdminReset385(){if(adminResetInstalled385)return;adminResetInstalled385=true;const names=['adminDashboard','adminProducts','adminInventory','adminCategories','adminFaqs','adminUsers','adminOrders','adminSettings','adminBots','adminBackup','adminActivity','homeAdminV2','servicesAdminV2','availabilityAdminV2','ordersAdminV2','clientsAdminV2','promotionsAdminV2','messagesAdminV2','settingsAdminV2','renderAdminNav','navActive','openServiceEditorV2','openProductEditor'];names.forEach(n=>{try{window[n]=noop}catch(e){}});window.renderAdminV2=renderAdmin385;window.renderAdminSection=renderAdmin385;window.adminShell=renderAdmin385;window.openAdmin=openAdmin385;try{renderAdminV2=renderAdmin385}catch(e){}try{renderAdminSection=renderAdmin385}catch(e){}try{adminShell=renderAdmin385}catch(e){}try{openAdmin=openAdmin385}catch(e){}}
  if(D.readyState==='complete')setTimeout(installAdminReset385,0);else window.addEventListener('load',()=>setTimeout(installAdminReset385,0),{once:true});setTimeout(installAdminReset385,1800);
  D.addEventListener('click',function(e){const target=e.target&&e.target.closest?e.target.closest('#profileBtn,#drawerProfile'):null;if(!target)return;let isAdmin=false;try{isAdmin=state?.session?.role==='admin'}catch(err){}if(!isAdmin)return;e.preventDefault();e.stopImmediatePropagation();try{if(typeof closeAllPanels==='function')closeAllPanels()}catch(err){}openAdmin385()},true);
  const obs=new MutationObserver(()=>{const el=overlay();if(!el||!el.classList.contains('open'))return;if(!el.querySelector('.cc378-admin'))renderAdmin385()});const boot=()=>{const el=overlay();if(!el)return;renderAdmin385();obs.observe(el,{childList:true,subtree:true})};if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  try{Object.defineProperty(window,'CRUZCLICK_ADMIN_V385',{value:Object.freeze({VERSION:'3.8.5',open:openAdmin385,render:renderAdmin385}),writable:false,configurable:false})}catch(e){window.CRUZCLICK_ADMIN_V385={VERSION:'3.8.5',open:openAdmin385,render:renderAdmin385}}
})();
</script>



<!-- CRULOX V3.7.9 · Arranque seguro: no modifica la tienda, solo evita loader permanente -->
<script id="cruzclick-v379-loader-failsafe">
(function(){
  'use strict';
  const D=document;
  let released=false;
  function releaseLoader379(){
    if(released)return;
    const loader=D.getElementById('loader');
    if(!loader)return;
    released=true;
    loader.classList.add('hide');
    loader.style.pointerEvents='none';
    setTimeout(()=>{try{loader.style.display='none'}catch(e){}},480);
  }
  // El arranque normal sigue teniendo prioridad. Esto solo es un seguro de salida.
  if(D.readyState==='complete')setTimeout(releaseLoader379,700);
  else window.addEventListener('load',()=>setTimeout(releaseLoader379,700),{once:true});
  setTimeout(releaseLoader379,2600);
  window.addEventListener('error',()=>setTimeout(releaseLoader379,120),{once:true});
  window.addEventListener('unhandledrejection',()=>setTimeout(releaseLoader379,120),{once:true});
})();
</script>



<!-- CRULOX V3.7.11 · Protección web contra captura/impresión (mejor esfuerzo) -->
<style id="cruzclick-v3711-capture-shield-style">
/* La protección se aplica a la tienda pública. El panel administrativo no se altera. */
#ccCaptureShield{
  position:fixed;
  inset:0;
  z-index:2147483646;
  display:none;
  align-items:center;
  justify-content:center;
  background:#020a12;
  color:#b9f8ff;
  text-align:center;
  padding:28px;
  font-family:inherit;
}
#ccCaptureShield.cc-show{display:flex!important}
#ccCaptureShield .cc-shield-card{
  max-width:320px;
  padding:18px 20px;
  border:1px solid rgba(47,226,247,.22);
  border-radius:18px;
  background:linear-gradient(180deg,rgba(7,27,40,.98),rgba(2,13,22,.99));
  box-shadow:0 18px 48px rgba(0,0,0,.42);
}
#ccCaptureShield .cc-shield-icon{font-size:2rem;line-height:1;margin-bottom:10px}
#ccCaptureShield b{display:block;font-size:.92rem;color:#ecfdff}
#ccCaptureShield p{margin:7px 0 0;font-size:.72rem;line-height:1.45;color:#87aab9}
html.cc-store-shielded body > *:not(#ccCaptureShield):not(#adminOverlay){
  filter:blur(22px)!important;
  opacity:.03!important;
  pointer-events:none!important;
}
@media print{
  body > *{display:none!important}
  #ccCaptureShield{display:flex!important;position:fixed!important;inset:0!important;background:#000!important;color:#fff!important}
  #ccCaptureShield .cc-shield-card{display:block!important}
}
</style>
<script id="cruzclick-v3711-capture-shield-script">
(()=>{
  'use strict';
  const D=document;
  const root=D.documentElement;
  let timer=null;
  function adminOpen(){
    const a=D.getElementById('adminOverlay');
    return !!(a && (a.classList.contains('open') || a.getAttribute('aria-hidden')==='false'));
  }
  function ensureShield(){
    let el=D.getElementById('ccCaptureShield');
    if(el) return el;
    el=D.createElement('div');
    el.id='ccCaptureShield';
    el.setAttribute('aria-hidden','true');
    el.innerHTML='<div class="cc-shield-card"><div class="cc-shield-icon">🔒</div><b>Contenido protegido</b><p>La tienda oculta temporalmente su contenido cuando detecta una acción de captura compatible con el navegador.</p></div>';
    D.body.appendChild(el);
    return el;
  }
  function shield(ms=900){
    if(adminOpen()) return;
    const el=ensureShield();
    clearTimeout(timer);
    root.classList.add('cc-store-shielded');
    el.classList.add('cc-show');
    el.setAttribute('aria-hidden','false');
    timer=setTimeout(unshield,ms);
  }
  function unshield(){
    const el=D.getElementById('ccCaptureShield');
    root.classList.remove('cc-store-shielded');
    if(el){el.classList.remove('cc-show');el.setAttribute('aria-hidden','true')}
  }
  // Print / print-to-PDF.
  window.addEventListener('beforeprint',()=>shield(3000));
  window.addEventListener('afterprint',unshield);
  // PrintScreen en navegadores que sí exponen la tecla.
  D.addEventListener('keydown',e=>{
    const key=String(e.key||'').toLowerCase();
    if(key==='printscreen' || e.code==='PrintScreen'){
      shield(1400);
      try{navigator.clipboard?.writeText('')}catch(err){}
      e.preventDefault?.();
      e.stopPropagation?.();
    }
    if((e.ctrlKey||e.metaKey) && key==='p'){
      shield(1600);
      e.preventDefault();
      e.stopPropagation();
    }
  },true);
  D.addEventListener('keyup',e=>{
    const key=String(e.key||'').toLowerCase();
    if(key==='printscreen' || e.code==='PrintScreen') shield(1000);
  },true);
  // Oculta la tienda cuando pierde foco o queda en segundo plano.
  window.addEventListener('blur',()=>{if(!adminOpen())shield(700)});
  window.addEventListener('focus',()=>setTimeout(unshield,120));
  D.addEventListener('visibilitychange',()=>{
    if(D.visibilityState!=='visible') shield(1500);
    else setTimeout(unshield,140);
  });
  window.addEventListener('pagehide',()=>shield(1800));
  // Evita que esta propia página inicie captura de pantalla/ventana mediante Screen Capture API.
  try{
    if(navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia){
      const blocked=()=>Promise.reject(new DOMException('Captura de pantalla deshabilitada por CRULOX.','NotAllowedError'));
      try{Object.defineProperty(navigator.mediaDevices,'getDisplayMedia',{configurable:true,writable:false,value:blocked})}
      catch(e){try{navigator.mediaDevices.getDisplayMedia=blocked}catch(_) {}}
    }
  }catch(e){}
  // Mantener fuera del bloqueo al abrir el panel administrativo.
  D.addEventListener('click',()=>{if(adminOpen())requestAnimationFrame(unshield)},true);
  ensureShield();
  window.CRUZCLICK_CAPTURE_SHIELD={shield,unshield,webOnly:true,version:'3.7.11'};
})();
</script>

<!-- CRULOX V3.7.13 · estado de tienda como marca de agua -->
<style id="cruzclick-v3713-stability-style">
/* El antiguo aviso de sesión administrativa deja de formar parte de la tienda pública. */
#npAdminSessionHint{display:none!important}

/* Estado real de atención, independiente de la sesión del administrador. */
#ccStoreScheduleStatus{
  position:fixed;top:50%;right:-45px;bottom:auto;z-index:30;display:flex;align-items:center;gap:7px;
  width:124px;min-height:24px;padding:0;border:0;border-radius:0;background:transparent;color:#dffbff;
  box-shadow:none;backdrop-filter:none;transform:translateY(-50%) rotate(-90deg);transform-origin:center;
  opacity:.34;font-size:.65rem;font-weight:850;letter-spacing:.055em;text-transform:uppercase;
  white-space:nowrap;pointer-events:none;user-select:none
}
#ccStoreScheduleStatus .cc-status-dot{
  width:6px;height:6px;border-radius:50%;flex:0 0 auto;
  background:#20ff8a;
  box-shadow:0 0 8px rgba(32,255,138,.62);
  animation:ccStatusDotGreenBlink 1.15s ease-in-out infinite
}
#ccStoreScheduleStatus.is-active{
  color:#55ff9f;
  animation:ccStatusGreenBlink 1.15s ease-in-out infinite
}
#ccStoreScheduleStatus.is-active .cc-status-dot{
  background:#20ff8a;
  box-shadow:0 0 8px rgba(32,255,138,.62);
  animation:ccStatusDotGreenBlink 1.15s ease-in-out infinite
}
#ccStoreScheduleStatus.is-inactive{
  color:#ff5e78;
  animation:ccStatusRedBlink 1.15s ease-in-out infinite
}
#ccStoreScheduleStatus.is-inactive .cc-status-dot{
  background:#ff355d;
  box-shadow:0 0 8px rgba(255,53,93,.68);
  animation:ccStatusDotRedBlink 1.15s ease-in-out infinite
}
@keyframes ccStatusGreenBlink{
  0%,100%{opacity:.28;text-shadow:0 0 4px rgba(32,255,138,.28)}
  50%{opacity:.92;text-shadow:0 0 12px rgba(32,255,138,.9),0 0 22px rgba(32,255,138,.38)}
}
@keyframes ccStatusDotGreenBlink{
  0%,100%{opacity:.35;box-shadow:0 0 5px rgba(32,255,138,.38)}
  50%{opacity:1;box-shadow:0 0 11px rgba(32,255,138,1),0 0 20px rgba(32,255,138,.55)}
}
@keyframes ccStatusRedBlink{
  0%,100%{opacity:.28;text-shadow:0 0 4px rgba(255,53,93,.28)}
  50%{opacity:.92;text-shadow:0 0 12px rgba(255,53,93,.92),0 0 22px rgba(255,53,93,.42)}
}
@keyframes ccStatusDotRedBlink{
  0%,100%{opacity:.35;box-shadow:0 0 5px rgba(255,53,93,.42)}
  50%{opacity:1;box-shadow:0 0 11px rgba(255,53,93,1),0 0 20px rgba(255,53,93,.58)}
}

/* El atributo hidden debe prevalecer sobre reglas visuales antiguas. */
[hidden]{display:none!important}

/* Bloque de código promocional: jerarquía clara y controles táctiles consistentes. */
#cartPanel .panel-foot{padding-top:14px!important}
#cartPanel .promo-box{
  display:grid!important;gap:10px!important;margin:0 0 14px!important;padding:14px!important;
  border:1px solid rgba(41,211,238,.18)!important;border-radius:17px!important;
  background:linear-gradient(145deg,rgba(11,38,52,.92),rgba(5,19,31,.96))!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.035),0 12px 30px rgba(0,0,0,.18)!important
}
#cartPanel .promo-box label{display:flex!important;align-items:center!important;gap:8px!important;margin:0!important;color:#f1fbff!important;font-size:.82rem!important;font-weight:850!important;line-height:1.25!important}
#cartPanel .promo-entry{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:8px!important;align-items:stretch!important}
#cartPanel #promoCodeInput{
  width:100%!important;min-width:0!important;height:46px!important;padding:0 13px!important;margin:0!important;
  border:1px solid rgba(139,211,228,.2)!important;border-radius:12px!important;background:#071723!important;
  color:#f5fdff!important;font:750 .86rem/1 inherit!important;letter-spacing:.035em!important;text-transform:uppercase!important;
  box-shadow:none!important;outline:none!important
}
#cartPanel #promoCodeInput::placeholder{color:#688697!important;text-transform:none!important;font-weight:650!important;letter-spacing:0!important}
#cartPanel #promoCodeInput:focus{border-color:#20d9f2!important;box-shadow:0 0 0 3px rgba(32,217,242,.12)!important}
#cartPanel #promoApplyBtn{
  min-width:92px!important;height:46px!important;padding:0 16px!important;border:1px solid rgba(34,211,238,.35)!important;
  border-radius:12px!important;background:linear-gradient(135deg,#11dced,#168bea)!important;color:#03121d!important;
  font:900 .78rem/1 inherit!important;cursor:pointer!important;box-shadow:0 8px 22px rgba(13,174,224,.2)!important
}
#cartPanel #promoApplyBtn:hover{filter:brightness(1.08)!important;transform:translateY(-1px)}
#cartPanel #promoApplyBtn:active{transform:translateY(0)}
#cartPanel .promo-feedback{margin:0!important;color:#8ba8b8!important;font-size:.69rem!important;line-height:1.45!important}
#cartPanel .promo-feedback.success{color:#63e6b0!important}
#cartPanel .list-card{align-items:start!important}
#cartPanel .list-card>strong{white-space:nowrap!important}
#cartPanel .list-actions{flex-wrap:wrap!important;gap:9px!important}
#cartPanel .np-cart-expiry{display:block!important;margin-top:4px!important;color:#82a5b8!important;font-size:.68rem!important;line-height:1.35!important}
#cartPanel .np-cart-expiry strong{color:#bceff7!important}
#cartPanel .total-row{min-height:34px!important}

@media(max-width:540px){
  #ccStoreScheduleStatus{top:51%;right:-47px;bottom:auto;z-index:30;width:122px;min-height:20px;padding:0;font-size:.58rem;opacity:.28}
  #cartPanel .panel-content{padding-bottom:8px!important}
  #cartPanel .panel-foot{padding:12px 12px max(14px,env(safe-area-inset-bottom))!important}
  #cartPanel .promo-box{padding:12px!important;border-radius:15px!important}
  #cartPanel .promo-entry{grid-template-columns:minmax(0,1fr) 88px!important}
  #cartPanel #promoApplyBtn{min-width:0!important;padding:0 12px!important}
}
@media(max-width:360px){
  #cartPanel .promo-entry{grid-template-columns:1fr!important}
  #cartPanel #promoApplyBtn{width:100%!important}
}
</style>
<script id="cruzclick-v3713-stability-script">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.7.13';
  const GT_TIME_ZONE='America/Guatemala';
  const CART_TTL_MS=5*24*60*60*1000;

  function finiteTimestamp(value,fallback){
    if(typeof value==='number'&&Number.isFinite(value)&&value>0)return value;
    if(typeof value==='string'&&value.trim()){
      const numeric=Number(value);
      if(Number.isFinite(numeric)&&numeric>0)return numeric;
      const parsed=Date.parse(value);
      if(Number.isFinite(parsed)&&parsed>0)return parsed;
    }
    return fallback;
  }
  function repairCartDates(){
    if(!window.state||!Array.isArray(state.cart))return false;
    let changed=false;
    const now=Date.now();
    state.cart=state.cart.map(item=>{
      if(!item||typeof item!=='object')return item;
      const added=finiteTimestamp(item.addedAt,now);
      let expires=finiteTimestamp(item.expiresAt,added+CART_TTL_MS);
      if(expires<=added)expires=added+CART_TTL_MS;
      if(item.addedAt!==added||item.expiresAt!==expires){changed=true;return {...item,addedAt:added,expiresAt:expires,cartSchema:2}}
      return item;
    });
    if(changed){try{write(KEYS.cart,state.cart)}catch(e){console.warn('CRULOX: no se pudieron normalizar las fechas del pedido.',e)}}
    return changed;
  }

  /* Protege la función vigente de carrito contra fechas heredadas o corruptas. */
  if(typeof window.renderCart==='function'){
    const renderCart3711=window.renderCart;
    window.renderCart=function(){
      repairCartDates();
      const result=renderCart3711.apply(this,arguments);
      const input=D.getElementById('promoCodeInput');
      const apply=D.getElementById('promoApplyBtn');
      if(input){input.setAttribute('aria-describedby','promoMessage');input.setAttribute('aria-label','Código promocional');input.setAttribute('maxlength','32');input.setAttribute('autocapitalize','characters');input.setAttribute('spellcheck','false')}
      if(apply)apply.setAttribute('aria-label','Aplicar código promocional');
      return result;
    };
  }

  function guatemalaMinutes(date=new Date()){
    try{
      const parts=new Intl.DateTimeFormat('en-CA',{timeZone:GT_TIME_ZONE,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(date);
      const hour=Number(parts.find(p=>p.type==='hour')?.value);
      const minute=Number(parts.find(p=>p.type==='minute')?.value);
      if(Number.isFinite(hour)&&Number.isFinite(minute))return hour*60+minute;
    }catch(e){console.warn('CRULOX: no se pudo consultar el horario de Guatemala.',e)}
    /* Guatemala usa UTC-6 todo el año; este respaldo evita depender de la zona del dispositivo. */
    const utc=date.getUTCHours()*60+date.getUTCMinutes();
    return (utc-360+1440)%1440;
  }
  function storeIsActive(date=new Date()){
    const minutes=guatemalaMinutes(date);
    return minutes>=7*60&&minutes<19*60;
  }
  function ensureScheduleStatus(){
    let el=D.getElementById('ccStoreScheduleStatus');
    if(!el){
      el=D.createElement('div');el.id='ccStoreScheduleStatus';el.setAttribute('role','status');el.setAttribute('aria-live','polite');
      el.innerHTML='<span class="cc-status-dot" aria-hidden="true"></span><span class="cc-status-label"></span>';
      D.body.appendChild(el);
    }
    return el;
  }
  function updateScheduleStatus(date=new Date()){
    const active=storeIsActive(date);const el=ensureScheduleStatus();
    el.classList.toggle('is-active',active);el.classList.toggle('is-inactive',!active);
    const label=el.querySelector('.cc-status-label');if(label)label.textContent=active?'Tienda Activa':'Tienda Fuera de horario';
    el.title=active?'Horario de atención: 7:00 AM a 7:00 PM (Guatemala)':'La tienda vuelve a estar activa a las 7:00 AM (Guatemala)';
    el.setAttribute('aria-label',`${active?'Tienda Activa':'Tienda Fuera de horario'}. Horario de Guatemala: 7:00 AM a 7:00 PM.`);
    return active;
  }

  function hardenStaticControls(){
    D.querySelectorAll('button:not([type])').forEach(button=>button.type='button');
    const closeNames={cartClose:'Cerrar pedido',drawerClose:'Cerrar menú',notificationClose:'Cerrar notificaciones'};
    Object.entries(closeNames).forEach(([id,name])=>{const el=D.getElementById(id);if(el&&!el.getAttribute('aria-label'))el.setAttribute('aria-label',name)});
    D.querySelectorAll('a[target="_blank"]').forEach(a=>{const rel=new Set(String(a.rel||'').split(/\s+/).filter(Boolean));rel.add('noopener');rel.add('noreferrer');a.rel=[...rel].join(' ')});
  }

  repairCartDates();
  hardenStaticControls();
  updateScheduleStatus();
  try{if(typeof renderCart==='function'&&D.getElementById('cartItems'))renderCart()}catch(e){console.error('CRULOX: no se pudo actualizar el pedido.',e)}
  setInterval(updateScheduleStatus,30000);
  D.addEventListener('visibilitychange',()=>{if(D.visibilityState==='visible')updateScheduleStatus()});
  window.addEventListener('pageshow',()=>{repairCartDates();updateScheduleStatus();hardenStaticControls()});

  window.CRUZCLICK_V3713={
    version:VERSION,timeZone:GT_TIME_ZONE,activeFrom:'07:00',inactiveFrom:'19:00',
    storeIsActive,guatemalaMinutes,repairCartDates,updateScheduleStatus,
    selfTest(){
      return {
        version:VERSION,
        boundary0659:storeIsActive(new Date('2026-09-13T12:59:00Z'))===false,
        boundary0700:storeIsActive(new Date('2026-09-13T13:00:00Z'))===true,
        boundary1859:storeIsActive(new Date('2026-09-14T00:59:00Z'))===true,
        boundary1900:storeIsActive(new Date('2026-09-14T01:00:00Z'))===false,
        oldPanelTextHidden:getComputedStyle(D.getElementById('npAdminSessionHint')||D.body).display==='none',
        promoControlsPresent:!!D.getElementById('promoCodeInput')&&!!D.getElementById('promoApplyBtn')
      };
    }
  };
})();
</script>



<!-- CRULOX V3.7.16 · Corrección exclusiva: botón Detalles + texto fuera de horario -->
<script id="cruzclick-v3716-detail-status-fix">
(()=>{
  'use strict';
  const D=document;
  const previousOpenDetail3716=window.openDetail;

  const html3716=value=>String(value??'').replace(/[&<>"']/g,ch=>({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[ch]));

  function product3716(id){
    try{return (state.products||[]).find(p=>String(p.id)===String(id))||null}catch(e){return null}
  }

  function money3716(value){
    const currency=String((window.state&&state.settings&&state.settings.currency)||'Q').trim()||'Q';
    return `${currency}${Number(value||0).toFixed(2)}`;
  }

  function fallbackDetail3716(product){
    const modal=D.getElementById('detailModal');
    const body=D.getElementById('detailBody');
    if(!modal||!body||!product)return false;

    const images=(Array.isArray(product.images)?product.images:[product.image]).filter(Boolean);
    const mainImage=images[0]||product.image||'';
    let stockText='Disponible',stockClass='';
    try{
      if(typeof window.stockInfo==='function'){
        const result=window.stockInfo(product);
        if(Array.isArray(result)){stockText=String(result[0]||stockText);stockClass=String(result[1]||'')}
      }
    }catch(e){}

    const facts=[
      ['Tipo',product.digitalType||product.category||'Servicio digital'],
      ['Plataforma',product.platform||product.category||'CRULOX'],
      ['Entrega estimada',product.deliveryEta||'Según servicio'],
      ['Forma de entrega',product.deliveryMode||'Entrega digital']
    ];
    if(product.duration)facts.push(['Duración / vigencia',product.duration]);
    facts.push(['Disponibilidad',stockText]);

    const requirements=Array.isArray(product.digitalRequirements)?product.digitalRequirements:[];
    const sellable=stockClass!=='out'&&(product.availabilityMode!=='limited'||Number(product.stock||0)>0);
    body.innerHTML=`<div class="product-detail"><div class="product-detail-gallery"><div class="product-detail-media"><img id="detailMainImage" src="${html3716(mainImage)}" alt="${html3716(product.name||'Servicio')}" loading="eager" decoding="async"></div></div><div class="product-detail-info"><span class="section-kicker">${html3716(product.category||'Servicio digital')}</span><h2>${html3716(product.name||'Servicio')}</h2><div class="rating">★ ${Number(product.rating||0).toFixed(1)} <span>(${Number(product.reviews||0)} reseñas)</span></div><div class="price-row price-row--focus" style="margin:14px 0 8px"><strong class="price">${money3716(product.price)}</strong>${product.oldPrice?`<span class="old">${money3716(product.oldPrice)}</span>`:''}</div><p>${html3716(product.description||'')}</p><p class="stock stock-detail ${html3716(stockClass)}">${html3716(stockText)}</p><div class="jmv2-digital-facts">${facts.map(([label,value])=>`<div class="jmv2-fact"><small>${html3716(label)}</small><b>${html3716(value)}</b></div>`).join('')}</div><div class="jmv2-requirements"><b>Datos necesarios para activar el servicio</b>${requirements.length?`<ul>${requirements.map(r=>`<li>${html3716(r.label||'Dato requerido')}${r.required===false?' (opcional)':''}</li>`).join('')}</ul>`:'<ul><li>No requiere datos adicionales además de los necesarios para gestionar el servicio.</li></ul>'}</div><div class="form-actions"><button class="btn btn-primary" id="detailAdd" ${sellable?'':'disabled'}>${sellable?'Agregar al pedido':'No disponible'}</button><button class="btn btn-green" id="detailSupport">Consultar bot</button><button class="btn btn-secondary" id="detailFav">${(state.favorites||[]).includes(product.id)?'Quitar favorito':'Guardar favorito'}</button></div></div></div>`;

    modal.classList.add('open');
    D.body.classList.add('lock');

    const add=D.getElementById('detailAdd');
    if(add) add.onclick=()=>{
      if(!sellable)return;
      try{if(typeof window.addToCart==='function')window.addToCart(product.id)}catch(e){console.error('CRULOX V3.7.16: no se pudo agregar el servicio.',e)}
      try{if(typeof window.closeModal==='function')window.closeModal('detailModal');else modal.classList.remove('open')}catch(e){modal.classList.remove('open')}
    };

    const support=D.getElementById('detailSupport');
    if(support) support.onclick=e=>{
      e?.preventDefault?.();
      try{
        if(window.JM_DIGITAL_STORE_V352?.openProductChat)return window.JM_DIGITAL_STORE_V352.openProductChat(product);
        if(typeof window.openBot==='function')return window.openBot('support',`Hola. Necesito información sobre ${product.name}.`,{Producto:product.name,Tipo:'Consulta'});
      }catch(error){console.error('CRULOX V3.7.16: no se pudo abrir la consulta del producto.',error)}
    };

    const fav=D.getElementById('detailFav');
    if(fav) fav.onclick=()=>{
      try{if(typeof window.toggleFavorite==='function')window.toggleFavorite(product.id)}catch(e){}
      window.setTimeout(()=>openDetail3716(product.id),0);
    };

    window.setTimeout(()=>{
      try{window.JM_DIGITAL_STORE_V27?.rebuildDetail?.(product.id)}catch(e){}
    },20);
    return true;
  }

  function openDetail3716(id){
    const product=product3716(id);
    if(!product)return false;

    let error=null;
    try{
      if(typeof previousOpenDetail3716==='function')previousOpenDetail3716(product.id);
    }catch(e){error=e;console.error('CRULOX V3.7.16: recuperación del detalle activada.',e)}

    const modal=D.getElementById('detailModal');
    const body=D.getElementById('detailBody');
    if(!error&&modal?.classList.contains('open')&&body?.children?.length)return true;
    return fallbackDetail3716(product);
  }

  window.openDetail=openDetail3716;
  try{openDetail=openDetail3716}catch(e){}

  /* Respaldo delegado: mantiene funcionales los botones aunque una tarjeta se regenere dinámicamente. */
  D.addEventListener('click',event=>{
    const button=event.target?.closest?.('.product-actions [data-detail]');
    if(!button)return;
    window.setTimeout(()=>{
      const modal=D.getElementById('detailModal');
      if(!modal?.classList.contains('open'))openDetail3716(button.dataset.detail);
    },0);
  },false);

  window.CRUZCLICK_V3716={version:'3.7.16',openDetail:openDetail3716};
})();
</script>



<!-- CRULOX V3.7.17 · Carrito disponible fuera de horario + envío de pedido solo con tienda activa -->
<script id="cruzclick-v3717-order-schedule-guard">
(()=>{
  'use strict';
  const D=document;
  const GT_TIME_ZONE='America/Guatemala';
  const OPEN_MINUTES=7*60;
  const CLOSE_MINUTES=19*60;

  function guatemalaMinutes3717(date=new Date()){
    try{
      const parts=new Intl.DateTimeFormat('en-CA',{timeZone:GT_TIME_ZONE,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(date);
      const hour=Number(parts.find(p=>p.type==='hour')?.value);
      const minute=Number(parts.find(p=>p.type==='minute')?.value);
      if(Number.isFinite(hour)&&Number.isFinite(minute))return hour*60+minute;
    }catch(e){}
    const utc=date.getUTCHours()*60+date.getUTCMinutes();
    return (utc-360+1440)%1440;
  }

  function storeIsActive3717(date=new Date()){
    try{
      const scheduleApi=window.CRUZCLICK_V3713;
      if(scheduleApi&&typeof scheduleApi.storeIsActive==='function')return !!scheduleApi.storeIsActive(date);
    }catch(e){}
    const minutes=guatemalaMinutes3717(date);
    return minutes>=OPEN_MINUTES&&minutes<CLOSE_MINUTES;
  }

  function closedMessage3717(){
    const message='La tienda está fuera de horario. Tus productos permanecerán en el carrito y podrás enviar el pedido cuando la tienda esté activa, de 7:00 AM a 7:00 PM (hora de Guatemala).';
    try{
      if(typeof window.toast==='function'){window.toast(message,'warn');return false}
      if(typeof toast==='function'){toast(message,'warn');return false}
    }catch(e){}
    try{window.alert(message)}catch(e){}
    return false;
  }

  function blockCheckoutSubmission3717(event){
    const form=event?.target;
    if(!form||form.id!=='checkoutForm'||storeIsActive3717())return;
    event.preventDefault?.();
    event.stopImmediatePropagation?.();
    event.stopPropagation?.();
    closedMessage3717();
  }

  D.addEventListener('submit',blockCheckoutSubmission3717,true);

  const previousSubmitOrder3717=window.submitOrder;
  if(typeof previousSubmitOrder3717==='function'){
    const guardedSubmitOrder3717=function(event){
      if(!storeIsActive3717()){
        event?.preventDefault?.();
        event?.stopImmediatePropagation?.();
        return closedMessage3717();
      }
      return previousSubmitOrder3717.apply(this,arguments);
    };
    window.submitOrder=guardedSubmitOrder3717;
    try{submitOrder=guardedSubmitOrder3717}catch(e){}
    const form=D.getElementById('checkoutForm');
    if(form)form.onsubmit=guardedSubmitOrder3717;
  }

  window.addEventListener('message',event=>{
    if(event?.data?.type!=='np-order'||storeIsActive3717())return;
    event.stopImmediatePropagation?.();
    event.stopPropagation?.();
    closedMessage3717();
  },true);

  window.CRUZCLICK_V3717={
    version:'3.7.17',
    storeIsActive:storeIsActive3717,
    canAddToCart:()=>true,
    canSubmitOrder:storeIsActive3717,
    selfTest(){
      return {
        boundary0659:storeIsActive3717(new Date('2026-09-13T12:59:00Z'))===false,
        boundary0700:storeIsActive3717(new Date('2026-09-13T13:00:00Z'))===true,
        boundary1859:storeIsActive3717(new Date('2026-09-14T00:59:00Z'))===true,
        boundary1900:storeIsActive3717(new Date('2026-09-14T01:00:00Z'))===false,
        cartRemainsAvailable:true,
        checkoutGuardBound:!!D.getElementById('checkoutForm')
      };
    }
  };
})();
</script>


