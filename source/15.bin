<!-- CRULOX V3.8.4 · Panel administrativo: cinco funciones en parejas; al inicio se muestran únicamente las funciones y cada módulo abre una pantalla administrativa independiente. -->

<style id="cruzclick-v385-admin-final-polish">
#adminOverlay{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif!important}
#adminOverlay .cc378-nav button:nth-child(odd){background-image:linear-gradient(145deg,rgba(9,35,54,.96),rgba(3,17,29,.98))}
#adminOverlay .cc378-nav button:nth-child(even){background-image:linear-gradient(145deg,rgba(8,29,50,.96),rgba(3,16,29,.98))}
#adminOverlay .cc378-nav button:focus-visible,#adminOverlay .cc378-btn:focus-visible,#adminOverlay .cc378-back:focus-visible{outline:2px solid rgba(0,230,255,.85);outline-offset:2px}
@media(prefers-reduced-motion:reduce){#adminOverlay .cc378-nav button,#adminOverlay .cc378-btn{transition:none!important}}
</style>
<!-- CRULOX V3.8.7 · Panel General operativo + aviso de protección de perfiles -->
<style id="cruzclick-v387-panel-general-style">
#adminOverlay .cc387-dashboard{display:grid;gap:14px;min-width:0}
#adminOverlay .cc387-hero{position:relative;overflow:hidden;padding:18px;border-radius:20px;border:1px solid rgba(62,221,255,.13);background:radial-gradient(circle at 88% 12%,rgba(0,220,255,.13),transparent 30%),radial-gradient(circle at 15% 100%,rgba(72,98,255,.10),transparent 35%),linear-gradient(145deg,#0a2134,#06121f 68%);box-shadow:0 18px 46px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.035)}
#adminOverlay .cc387-hero:after{content:"";position:absolute;inset:auto -15% -70% 30%;height:170px;background:radial-gradient(ellipse,rgba(0,217,255,.08),transparent 65%);pointer-events:none}
#adminOverlay .cc387-hero-top{position:relative;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
#adminOverlay .cc387-kicker{display:inline-flex;align-items:center;gap:6px;color:#5fe8ff;font-size:.48rem;font-weight:950;letter-spacing:.13em;text-transform:uppercase}
#adminOverlay .cc387-kicker i{width:7px;height:7px;border-radius:50%;background:#28df82;box-shadow:0 0 12px rgba(40,223,130,.6)}
#adminOverlay .cc387-hero h2{margin:6px 0 4px;font-size:1.08rem;color:#f5fbff}
#adminOverlay .cc387-hero p{margin:0;color:#7e9caf;font-size:.56rem;line-height:1.55;max-width:600px}
#adminOverlay .cc387-live{flex:0 0 auto;padding:7px 9px;border-radius:999px;border:1px solid rgba(40,223,130,.15);background:rgba(40,223,130,.055);color:#6af0a5;font-size:.46rem;font-weight:900;white-space:nowrap}
#adminOverlay .cc387-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
#adminOverlay .cc387-kpi{position:relative;overflow:hidden;min-width:0;padding:13px;border-radius:16px;border:1px solid rgba(123,201,238,.09);background:linear-gradient(145deg,rgba(11,32,49,.96),rgba(5,17,29,.98));box-shadow:0 12px 28px rgba(0,0,0,.17)}
#adminOverlay .cc387-kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(#1fe4ff,rgba(31,228,255,0))}
#adminOverlay .cc387-kpi small{display:block;color:#6f8da4;font-size:.48rem;font-weight:800}
#adminOverlay .cc387-kpi strong{display:block;margin-top:6px;color:#eaf8ff;font-size:1.18rem;line-height:1}
#adminOverlay .cc387-kpi span{display:block;margin-top:5px;color:#3fdfff;font-size:.43rem;font-weight:800}
#adminOverlay .cc387-section{padding:14px;border-radius:18px;border:1px solid rgba(123,201,238,.08);background:linear-gradient(145deg,rgba(8,24,39,.94),rgba(4,14,24,.97));box-shadow:0 14px 32px rgba(0,0,0,.17)}
#adminOverlay .cc387-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-bottom:10px}
#adminOverlay .cc387-section-head h3{margin:0;color:#eef9ff;font-size:.72rem}
#adminOverlay .cc387-section-head p{margin:3px 0 0;color:#718ba1;font-size:.49rem;line-height:1.4}
#adminOverlay .cc387-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
#adminOverlay .cc387-card{min-width:0;padding:11px;border-radius:14px;border:1px solid rgba(123,201,238,.07);background:rgba(255,255,255,.018)}
#adminOverlay .cc387-card-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
#adminOverlay .cc387-card h4{margin:0;color:#e8f6ff;font-size:.59rem}
#adminOverlay .cc387-card .cc387-num{font-size:.92rem;color:#21ddff;font-weight:950}
#adminOverlay .cc387-card p{margin:5px 0 0;color:#71899f;font-size:.48rem;line-height:1.45}
#adminOverlay .cc387-bar{height:5px;margin-top:8px;border-radius:999px;background:rgba(255,255,255,.045);overflow:hidden}
#adminOverlay .cc387-bar b{display:block;height:100%;width:var(--w,0%);border-radius:inherit;background:linear-gradient(90deg,#16cce9,#5b8cff);box-shadow:0 0 12px rgba(20,210,255,.25)}
#adminOverlay .cc387-list{display:grid;gap:6px}
#adminOverlay .cc387-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto;align-items:center;gap:8px;padding:8px;border-radius:12px;background:rgba(255,255,255,.018);border:1px solid rgba(123,201,238,.055)}
#adminOverlay .cc387-row-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:rgba(0,215,255,.065);border:1px solid rgba(0,215,255,.08);color:#63eaff;font-size:.75rem}
#adminOverlay .cc387-row b{display:block;color:#dcecf5;font-size:.55rem}
#adminOverlay .cc387-row span{display:block;margin-top:2px;color:#6f879c;font-size:.46rem;line-height:1.35}
#adminOverlay .cc387-badge{padding:5px 7px;border-radius:999px;background:rgba(255,255,255,.035);color:#79dff1;font-size:.43rem;font-weight:900;white-space:nowrap}
#adminOverlay .cc387-badge.warn{background:rgba(255,193,78,.07);color:#ffd27b}
#adminOverlay .cc387-badge.bad{background:rgba(255,83,116,.07);color:#ff86a1}
#adminOverlay .cc387-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
#adminOverlay .cc387-action{min-height:54px;padding:9px;border-radius:13px;border:1px solid rgba(123,201,238,.075);background:linear-gradient(145deg,rgba(10,31,48,.9),rgba(5,17,29,.95));color:#eaf7ff;text-align:left;cursor:pointer;transition:transform .12s ease,border-color .12s ease,background .12s ease}
#adminOverlay .cc387-action:hover{transform:translateY(-1px);border-color:rgba(0,220,255,.22);background:linear-gradient(145deg,rgba(12,39,59,.95),rgba(5,18,31,.98))}
#adminOverlay .cc387-action b{display:block;font-size:.53rem}.cc387-action span{display:block;margin-top:3px;color:#718ba2;font-size:.44rem;line-height:1.3}
#adminOverlay .cc387-empty{padding:12px;text-align:center;color:#678197;font-size:.5rem;border:1px dashed rgba(123,201,238,.08);border-radius:12px}
#adminOverlay .cc387-system{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
#adminOverlay .cc387-system div{padding:10px;border-radius:12px;background:rgba(255,255,255,.016);border:1px solid rgba(123,201,238,.055)}
#adminOverlay .cc387-system small{display:block;color:#6d879c;font-size:.45rem}.cc387-system b{display:block;margin-top:4px;color:#dcecf5;font-size:.55rem}
#detailModal .cc387-profile-warning{position:relative;margin:9px 0 0;padding:11px 12px 11px 13px;border-radius:13px;border:1px solid rgba(255,66,93,.30);background:linear-gradient(135deg,rgba(115,8,25,.18),rgba(255,51,78,.045));box-shadow:inset 3px 0 0 rgba(255,63,91,.85),0 8px 22px rgba(0,0,0,.13);overflow:hidden}
#detailModal .cc387-profile-warning:after{content:"";position:absolute;right:-28px;top:-32px;width:95px;height:95px;border-radius:50%;background:radial-gradient(circle,rgba(255,48,77,.09),transparent 68%);pointer-events:none}
#detailModal .cc387-profile-warning strong{display:flex;align-items:center;gap:7px;color:#ff6e83;font-size:.60rem;letter-spacing:.015em}
#detailModal .cc387-profile-warning strong i{font-style:normal;font-size:.72rem}
#detailModal .cc387-profile-warning p{margin:5px 0 0!important;color:#e5aab3!important;font-size:.53rem!important;line-height:1.5!important;max-width:none!important}
@media(max-width:700px){#adminOverlay .cc387-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#adminOverlay .cc387-actions{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:460px){#adminOverlay .cc387-hero-top{display:block}.cc387-live{display:inline-flex;margin-top:9px}#adminOverlay .cc387-grid{grid-template-columns:1fr}#adminOverlay .cc387-system{grid-template-columns:1fr 1fr}#adminOverlay .cc387-hero{padding:14px}}
@media(prefers-reduced-motion:reduce){#adminOverlay .cc387-action{transition:none!important}}
</style>
<script id="cruzclick-v387-panel-general-script">
(()=>{
'use strict';
const D=document;
const esc387=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const n387=v=>Number(v||0);
const money387=v=>{try{return `${String(state.settings?.currency||'Q').trim()||'Q'}${n387(v).toFixed(2)}`}catch(e){return `Q${n387(v).toFixed(2)}`}};
const orders387=()=>Array.isArray(state?.orders)?state.orders:[];
const products387=()=>Array.isArray(state?.products)?state.products:[];
const users387=()=>Array.isArray(state?.users)?state.users:[];
const paid387=o=>['Confirmado','Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(String(o?.payment?.status||''))||['Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(String(o?.status||''));
const receipt387=o=>!!o?.payment?.receiptDataUrl;
function pendingPayment387(){return orders387().filter(o=>!paid387(o)&&!receipt387(o)).length}
function receiptPending387(){return orders387().filter(o=>!paid387(o)&&receipt387(o)).length}
function preparing387(){return orders387().filter(o=>['Preparando acceso','Listo para entregar'].includes(String(o?.status||''))).length}
function deliveredPending387(){return orders387().filter(o=>String(o?.status||'')==='Listo para entregar').length}
function activeOrders387(){return orders387().filter(o=>!['Completado','Entregado digital','Cancelado','Reserva vencida'].includes(String(o?.status||''))).length}
function revenue387(){return orders387().filter(paid387).reduce((s,o)=>s+n387(o?.total),0)}
function profileProducts387(){return products387().filter(p=>{const raw=String(p?.digitalKind||p?.digitalType||p?.name||'').toLowerCase();return /profile|perfil|suscrip|netflix|crunchy|disney|max|prime|vix/.test(raw)})}
function digitalKinds387(){const c={recharge:0,profile:0,membership:0,course:0,license:0,service:0};products387().forEach(p=>{const raw=String(p?.digitalKind||p?.digitalType||p?.name||'').toLowerCase();let k='service';if(/diamant|recarga|free\s*fire|fc\s*point|robux|moneda/.test(raw))k='recharge';else if(/curso|clase|programa/.test(raw))k='course';else if(/licen|clave|key|software/.test(raw))k='license';else if(/perfil|suscrip|netflix|disney|max|prime|crunchy|vix|stream/.test(raw))k='profile';else if(/membres|invitaci|spotify|youtube/.test(raw))k='membership';c[k]=(c[k]||0)+1});return c}
function renewal387(){try{const rows=typeof expirationLeads362==='function'?expirationLeads362():[];return rows.filter(x=>n387(x.days)>=0&&n387(x.days)<=5).length}catch(e){return 0}}
function storage387(){let bytes=0;try{for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i)||'';const v=localStorage.getItem(k)||'';bytes+=(k.length+v.length)*2}}catch(e){}return bytes<1024?`${bytes} B`:bytes<1048576?`${(bytes/1024).toFixed(1)} KB`:`${(bytes/1048576).toFixed(2)} MB`}
function recent387(){return orders387().slice().sort((a,b)=>Date.parse(b?.updatedAt||b?.createdAt||0)-Date.parse(a?.updatedAt||a?.createdAt||0)).slice(0,5)}
function statusLabel387(o){return String(o?.status||o?.payment?.status||'Pendiente')}
function renderPanelGeneral387(){
 const host=D.getElementById('cc378Stage');if(!host)return false;
 const os=orders387(),ps=products387(),us=users387(),pp=pendingPayment387(),rp=receiptPending387(),pr=preparing387(),del=deliveredPending387(),ren=renewal387(),rev=revenue387(),k=digitalKinds387(),maxKind=Math.max(1,...Object.values(k));
 const recent=recent387();
 const pending=activeOrders387();
 host.innerHTML=`<section class="cc387-dashboard" aria-label="Panel General">
 <div class="cc387-hero"><div class="cc387-hero-top"><div><span class="cc387-kicker"><i></i>Panel General · control operativo</span><h2>Centro de control de CRULOX</h2><p>Vista rápida del negocio digital: pedidos, pagos, comprobantes, entregas, renovaciones y catálogo. Los indicadores se calculan con los datos guardados actualmente en el sistema.</p></div><span class="cc387-live">● Datos locales activos</span></div></div>
 <div class="cc387-kpis"><article class="cc387-kpi"><small>Ventas confirmadas</small><strong>${esc387(money387(rev))}</strong><span>Ingresos registrados</span></article><article class="cc387-kpi"><small>Pedidos activos</small><strong>${pending}</strong><span>Requieren seguimiento</span></article><article class="cc387-kpi"><small>Pagos por revisar</small><strong>${pp+rp}</strong><span>${pp} sin comprobante · ${rp} con comprobante</span></article><article class="cc387-kpi"><small>Clientes</small><strong>${us.length}</strong><span>Cuentas registradas</span></article></div>
 <section class="cc387-section"><div class="cc387-section-head"><div><h3>Estado operativo</h3><p>Lo que merece atención primero.</p></div></div><div class="cc387-grid">
 <article class="cc387-card"><div class="cc387-card-head"><h4>Pedidos pendientes</h4><span class="cc387-num">${os.filter(o=>!['Completado','Entregado digital','Cancelado','Reserva vencida'].includes(String(o?.status||''))).length}</span></div><p>Pedidos todavía abiertos en el flujo de compra.</p><div class="cc387-bar"><b style="--w:${Math.min(100,(pending/Math.max(1,os.length))*100)}%"></b></div></article>
 <article class="cc387-card"><div class="cc387-card-head"><h4>Comprobantes para verificar</h4><span class="cc387-num">${rp}</span></div><p>Comprobantes cargados que aún no tienen pago confirmado.</p><div class="cc387-bar"><b style="--w:${Math.min(100,(rp/Math.max(1,os.length))*100)}%"></b></div></article>
 <article class="cc387-card"><div class="cc387-card-head"><h4>Entregas pendientes</h4><span class="cc387-num">${del}</span></div><p>Pedidos marcados como listos para entregar digitalmente.</p><div class="cc387-bar"><b style="--w:${Math.min(100,(del/Math.max(1,os.length))*100)}%"></b></div></article>
 <article class="cc387-card"><div class="cc387-card-head"><h4>Renovaciones ≤ 5 días</h4><span class="cc387-num">${ren}</span></div><p>Registros con fecha de corte disponible dentro del período definido.</p><div class="cc387-bar"><b style="--w:${Math.min(100,(ren/Math.max(1,os.length))*100)}%"></b></div></article>
 </div></section>
 <section class="cc387-section"><div class="cc387-section-head"><div><h3>Composición del catálogo digital</h3><p>Tipos detectados en los productos actuales.</p></div><span class="cc387-badge">${ps.length} productos</span></div><div class="cc387-list">
 ${[['profile','👤','Perfiles / suscripciones'],['membership','✉','Invitaciones / membresías'],['recharge','◆','Diamantes / recargas'],['course','▤','Cursos digitales'],['license','⌘','Licencias / claves']].map(([key,ic,label])=>`<div class="cc387-row"><span class="cc387-row-icon">${ic}</span><div><b>${label}</b><span>${k[key]||0} producto${(k[key]||0)===1?'':'s'} configurado${(k[key]||0)===1?'':'s'}</span></div><span class="cc387-badge">${Math.round(((k[key]||0)/maxKind)*100)}%</span></div>`).join('')}
 </div></section>
 <section class="cc387-section"><div class="cc387-section-head"><div><h3>Actividad reciente</h3><p>Últimos pedidos registrados por fecha de actualización.</p></div><span class="cc387-badge">${os.length} total</span></div>${recent.length?`<div class="cc387-list">${recent.map(o=>`<div class="cc387-row"><span class="cc387-row-icon">🧾</span><div><b>${esc387(o?.id||'Pedido')}</b><span>${esc387(o?.customer?.fullName||'Cliente')} · ${esc387(statusLabel387(o))}</span></div><span class="cc387-badge">${esc387(money387(o?.total))}</span></div>`).join('')}</div>`:'<div class="cc387-empty">Todavía no hay pedidos registrados.</div>'}</section>
 <section class="cc387-section"><div class="cc387-section-head"><div><h3>Acciones rápidas</h3><p>Atajos hacia los módulos que concentran la operación diaria.</p></div></div><div class="cc387-actions"><button type="button" class="cc387-action" data-cc387-go="orders"><b>🧾 Pedidos</b><span>Revisar flujo y estados.</span></button><button type="button" class="cc387-action" data-cc387-go="payments"><b>✓ Pagos</b><span>Controlar pagos y comprobantes.</span></button><button type="button" class="cc387-action" data-cc387-go="delivery"><b>⚡ Entregas</b><span>Controlar entregas digitales.</span></button><button type="button" class="cc387-action" data-cc387-go="subscriptions"><b>↻ Renovaciones</b><span>Seguimiento de vencimientos.</span></button></div></section>
 <section class="cc387-section"><div class="cc387-section-head"><div><h3>Estado del sistema</h3><p>Información técnica básica, sin inventar servicios externos.</p></div></div><div class="cc387-system"><div><small>Productos</small><b>${ps.length}</b></div><div><small>Clientes</small><b>${us.length}</b></div><div><small>Pedidos</small><b>${os.length}</b></div><div><small>En preparación</small><b>${pr}</b></div><div><small>Almacenamiento local estimado</small><b>${storage387()}</b></div><div><small>Modelo comercial</small><b>100% digital</b></div></div></section>
 </section>`;
 host.querySelectorAll('[data-cc387-go]').forEach(b=>b.onclick=()=>{try{window.renderAdminSection(b.dataset.cc387Go)}catch(e){}});
 try{D.getElementById('adminOverlay')?.scrollTo({top:0,behavior:'auto'})}catch(e){}
 return true;
}
function install387(){
 if(typeof window.renderAdminSection!=='function')return false;
 const fn=renderPanelGeneral387;
 const wrapped=function(section){if(String(section||'')==='panel')return fn();return window.CRUZCLICK_ADMIN_V387_BASE?window.CRUZCLICK_ADMIN_V387_BASE(section):undefined};
 if(!window.CRUZCLICK_ADMIN_V387_BASE)window.CRUZCLICK_ADMIN_V387_BASE=window.renderAdminSection;
 window.renderAdminSection=wrapped;
 try{renderAdminSection=wrapped}catch(e){}
 const oldOpen=window.openAdmin;
 if(!window.CRUZCLICK_ADMIN_V387_OPEN)window.CRUZCLICK_ADMIN_V387_OPEN=oldOpen;
 return true;
}
function installWarning387(){
 const original=window.openDetail;if(typeof original!=='function'||original.__cc387Wrapped)return false;
 const wrapped=function(id){const r=original.apply(this,arguments);setTimeout(()=>{try{const p=(state.products||[]).find(x=>String(x.id)===String(id));if(!p)return;const raw=String(p.digitalKind||p.digitalType||p.name||p.category||'').toLowerCase();const isProfile=/^profile$|perfil|netflix|crunchy|disney|max|prime|vix/.test(raw);const info=D.querySelector('#detailModal .product-detail-info');if(!isProfile||!info)return;let box=info.querySelector('.cc387-profile-warning');if(box)box.remove();box=D.createElement('div');box.className='cc387-profile-warning';box.innerHTML='<strong><i>⚠</i> Protección del perfil</strong><p>Está prohibido alterar, cambiar o modificar los datos de esta cuenta o perfil. Cualquier modificación no autorizada podrá ocasionar la pérdida o suspensión del acceso y la aplicación de medidas contra el responsable.</p>';const actions=info.querySelector('.form-actions');if(actions)info.insertBefore(box,actions);else info.appendChild(box)}catch(e){console.warn('CRULOX V3.8.7 aviso de perfil',e)}},25);return r};wrapped.__cc387Wrapped=true;window.CRUZCLICK_OPENDETAIL_V387_BASE=original;window.openDetail=wrapped;try{openDetail=wrapped}catch(e){}return true;
}
let tries=0;const boot=()=>{tries++;install387();installWarning387();if(tries<20&&(typeof window.renderAdminSection!=='function'||typeof window.openDetail!=='function'))setTimeout(boot,250);else if(tries<20)setTimeout(()=>{install387();installWarning387()},900)};
if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',()=>setTimeout(boot,50),{once:true});else setTimeout(boot,50);
})();
</script>




<style id="cruzclick-v389-icon-back-style">
#adminOverlay .cc378-nav{align-items:stretch!important}
#adminOverlay .cc378-nav button{display:grid!important;grid-template-columns:68px minmax(0,1fr)!important;grid-template-rows:auto auto!important;column-gap:12px!important;row-gap:6px!important;align-items:center!important;text-align:left!important}
#adminOverlay .cc378-nav-icon{grid-column:1;grid-row:1 / span 2;width:54px!important;height:54px!important;display:grid!important;place-items:center!important;align-self:center!important;justify-self:center!important;flex:0 0 auto!important;margin:0!important;border-radius:16px!important;background:linear-gradient(145deg,rgba(0,225,255,.18),rgba(72,112,255,.08))!important;border:1px solid rgba(56,220,255,.24)!important;box-shadow:0 10px 28px rgba(0,0,0,.24),inset 0 1px rgba(255,255,255,.05)!important;color:#75efff!important}
#adminOverlay .cc378-nav-icon svg{width:31px!important;height:31px!important;display:block!important;stroke:currentColor!important;fill:none!important;stroke-width:2.2!important;stroke-linecap:round!important;stroke-linejoin:round!important;overflow:visible!important}
#adminOverlay .cc378-nav-label{grid-column:2;grid-row:1;align-self:end!important;margin:0!important;min-width:0!important}
#adminOverlay .cc378-nav-sub{grid-column:2;grid-row:2;align-self:start!important;margin:0!important;min-width:0!important}
#adminOverlay .cc378-nav-index{z-index:3!important}
#adminOverlay .cc389-return-row{display:flex;justify-content:flex-start;margin:0 0 10px}
#adminOverlay .cc389-back{display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:8px 13px;border-radius:12px;border:1px solid rgba(64,222,255,.20);background:linear-gradient(145deg,rgba(10,36,54,.96),rgba(4,16,27,.98));color:#9cefff;font-size:.62rem;font-weight:900;cursor:pointer;touch-action:manipulation;box-shadow:0 10px 24px rgba(0,0,0,.18)}
#adminOverlay .cc389-back:hover{border-color:rgba(64,222,255,.45);transform:translateY(-1px)}
