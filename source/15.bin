};
const arr=Object.entries(MODULES);
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));
const money=n=>{try{const cur=String(state?.settings?.currency||'Q').trim()||'Q';return cur+Number(n||0).toFixed(2)}catch(e){return 'Q0.00'}};
const n=v=>Number(v||0)||0;
const orders=()=>Array.isArray(window.state?.orders)?window.state.orders:[];
const products=()=>Array.isArray(window.state?.products)?window.state.products:[];
const users=()=>Array.isArray(window.state?.users)?window.state.users:[];
const paid=o=>['Confirmado','Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(String(o?.payment?.status||''))||['Pago confirmado','Preparando acceso','Listo para entregar','Entregado digital','Completado'].includes(String(o?.status||''));
const receipt=o=>!!o?.payment?.receiptDataUrl;
function renewalCount(){try{const f=window.expirationLeads362;const rows=typeof f==='function'?f():[];return rows.filter(x=>n(x.days)>=0&&n(x.days)<=5).length}catch(e){return 0}}
function storageInfo(){let bytes=0;try{for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i)||'',v=localStorage.getItem(k)||'';bytes+=(k.length+v.length)*2}}catch(e){}return bytes<1024?`${bytes} B`:bytes<1048576?`${(bytes/1024).toFixed(1)} KB`:`${(bytes/1048576).toFixed(2)} MB`}
function metaFromButton(id){const info=MODULES[id];return info?{num:info[0],icon:iconFor389(id),label:info[1],lead:info[2]}:null}
function ensureShell(){const overlay=D.getElementById('adminOverlay');if(!overlay)return null;let stage=D.getElementById('cc378Stage');if(!stage){try{if(typeof window.renderAdminSection==='function')window.renderAdminSection('home')}catch(e){}stage=D.getElementById('cc378Stage')}return {overlay,stage}}
function openAdmin(){const owner=window.CRUZCLICK_V3718?.ownerSession;let ok=false;try{ok=typeof owner==='function'?!!owner():window.state?.session?.role==='admin'}catch(e){}if(!ok)return false;const {overlay}=ensureShell()||{};if(!overlay)return false;overlay.classList.add('open');D.body.classList.add('lock');renderFunctions();return true}
function closeAdmin(){const o=D.getElementById('adminOverlay');if(!o)return false;o.classList.remove('open');D.body.classList.remove('lock');return true}
function logout(){try{window.CRUZCLICK_V3718?.logoutAdmin?.()}catch(e){try{if(window.state)window.state.session=null}catch(_){}closeAdmin()}}
