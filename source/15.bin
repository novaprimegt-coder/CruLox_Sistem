  border:1px solid rgba(255,92,119,.22)!important;
  border-left:1px solid rgba(255,92,119,.22)!important;
  background:linear-gradient(135deg,rgba(68,16,30,.88),rgba(38,11,22,.92))!important;
  color:#ffdce4!important;
  box-shadow:0 10px 24px rgba(0,0,0,.20)!important;
