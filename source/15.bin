  loyalty:[["Puntos o saldo", "Beneficios acumulados"], ["Niveles de cliente", "Segmentos por fidelidad"], ["Recompensas", "Beneficios canjeables"], ["Compras recurrentes", "Frecuencia y retención"], ["Clientes inactivos", "Campañas de recuperación"], ["Beneficios por antigüedad", "Premios por permanencia"], ["Historial de canjes", "Control de recompensas"], ["Costo de fidelización", "Impacto financiero del programa"]],
  referrals:[["Códigos de referido", "Identificador por cliente"], ["Referidos registrados", "Quién invitó a quién"], ["Compras por referido", "Conversión real"], ["Recompensas pendientes", "Beneficios por aprobar"], ["Recompensas pagadas", "Historial"], ["Fraude de referidos", "Duplicados o auto-referidos"], ["Ranking de referidores", "Mejores promotores"], ["Costo y retorno", "Rentabilidad del programa"]],
  stats:[["Ventas", "Tendencias y crecimiento"], ["Pedidos", "Volumen y estados"], ["Clientes", "Nuevos, recurrentes e inactivos"], ["Productos", "Más vendidos y desempeño"], ["Renovaciones", "Continuidad, vencimiento y recompra"], ["Entregas", "Tiempos y éxito"], ["Pagos", "Aprobación y rechazo"], ["Soporte", "Casos y tiempos de solución"], ["Conversión", "Compra iniciada vs completada"], ["Panel comparativo", "Hoy, semana, mes y periodo anterior"]],
  reports:[["Reporte de ventas", "Detalle por periodo"], ["Reporte financiero", "Ingresos, costos y utilidad"], ["Reporte de productos", "Rendimiento del catálogo"], ["Reporte de clientes", "Actividad y valor"], ["Reporte de suscripciones", "Activas, vencidas y reactivadas"], ["Reporte de cuentas/perfiles", "Ocupación y disponibilidad"], ["Reporte de pagos", "Aprobados, rechazados y pendientes"], ["Reporte de entregas", "Estado y tiempos"], ["Reporte de incidencias", "Casos y resolución"], ["Reporte de auditoría", "Acciones administrativas"], ["Exportar reportes", "CSV/JSON según compatibilidad"]],
