function iconFor389(id){return CC389_ICONS[id]||''}
function renderFunctions(){const x=ensureShell();if(!x?.stage)return false;const stage=x.stage;stage.innerHTML='<nav class="cc378-nav" id="cc378AdminNav" aria-label="Funciones administrativas"></nav>';const nav=stage.firstElementChild;nav.innerHTML=arr.map(([id,[num,label,lead]])=>{return `<button type="button" data-cc378-section="${esc(id)}" aria-label="Abrir ${esc(label)}"><span class="cc378-nav-icon">${iconFor389(id)}</span><span class="cc378-nav-label">${esc(label)}</span><span class="cc378-nav-sub">${esc(lead)}</span></button>`}).join('');nav.onclick=(e)=>{const b=e.target.closest('[data-cc378-section]');if(!b)return;e.preventDefault();e.stopPropagation();openModule(b.dataset.cc378Section)};x.overlay.scrollTop=0;x.overlay.scrollLeft=0;return true}

function classifyCatalogKind(p){
 const r=String(p?.digitalKind||p?.digitalType||p?.name||'').toLowerCase();
 if(/diamant|recarga|free\s*fire|fc\s*point|robux|moneda/.test(r))return 'recharge';
 if(/curso|clase|programa/.test(r))return 'course';
 if(/licen|clave|key|software/.test(r))return 'license';
 if(/perfil|suscrip|netflix|disney|max|prime|crunchy|vix|stream/.test(r))return 'profile';
 if(/membres|invitaci|spotify|youtube/.test(r))return 'membership';
 return 'other';
}
function catalogKindIcon(kind){
 const icons={
  profile:'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="15" r="7"/><path d="M11 38c1-8 6-12 13-12s12 4 13 12"/></svg>',
  membership:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="10" width="32" height="28" rx="5"/><path d="M13 17h22M16 25h7M16 30h12"/></svg>',
  recharge:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="m24 6 14 14-14 22L10 20 24 6Z"/><path d="M18 22h12M24 16v12"/></svg>',
  course:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="m8 16 16-7 16 7-16 7-16-7Z"/><path d="M12 20v13l12 6 12-6V20"/><path d="M40 18v12"/></svg>',
  license:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="10" width="32" height="28" rx="4"/><path d="M15 18h18M15 24h10M15 30h7"/><circle cx="34" cy="30" r="3"/></svg>'
 }; return icons[kind]||'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="15"/><path d="M24 15v18M15 24h18"/></svg>';
}
function renewalRows(){try{const raw=typeof expirationLeads362==='function'?expirationLeads362():[];const plist=products();const us=users();return raw.map(x=>{const ord=(state.orders||[]).find(o=>String(o?.id||'')===String(x?.orderId||''));const prod=plist.find(p=>String(p?.name||'').trim().toLowerCase()===String(x?.product||'').trim().toLowerCase());const k=prod?classifyCatalogKind(prod):( /perfil|suscrip|netflix|disney|max|prime|crunchy|vix|stream/i.test(String(x?.product||''))?'profile': /membres|invitaci|spotify|youtube/i.test(String(x?.product||''))?'membership':'other');let uid=ord?.userId||ord?.customer?.userId||null;if(!uid&&ord?.customer?.email)uid=us.find(u=>String(u?.email||'').toLowerCase()===String(ord.customer.email).toLowerCase())?.id||null;return {...x, userId:uid, days:n(x.days),kind:k,state:n(x.days)<0?'expired':n(x.days)<=5?'expiring':'upcoming'};}).filter(x=>x.kind==='profile'||x.kind==='membership');}catch(e){return []}}
function syncRenewalNotifications392(){try{const nowRows=renewalRows().filter(x=>x.days>=0&&x.days<=5&&x.userId);if(!nowRows.length)return;const key='jm_digital_v23_notifications';let list=[];try{const raw=localStorage.getItem(key);list=raw?JSON.parse(raw):[]}catch(e){}if(!Array.isArray(list))list=[];let changed=false;for(const r of nowRows){const marker=`renewal5:${r.orderId||''}:${r.product||''}:${r.cutoff||''}`;const exists=list.some(n=>String(n?.renewalMarker||'')===marker);if(exists)continue;list.push({id:`ren_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,7)}`,target:'user',userId:r.userId,type:'Renovación',renewalMarker:marker,title:r.days===0?'Tu perfil vence hoy':'Tu perfil está por vencer',message:r.days===0?`Tu perfil de ${r.product||'tu servicio'} vence hoy. Si deseas continuar usando el mismo perfil, realiza la renovación antes del vencimiento.`:`Tu perfil de ${r.product||'tu servicio'} vence en ${r.days} día${r.days===1?'':'s'}. Si deseas continuar usando el mismo perfil, indícalo antes de la fecha de vencimiento.`,createdAt:new Date().toISOString()});changed=true;}if(changed)localStorage.setItem(key,JSON.stringify(list.slice(-300)));}catch(e){}}
function renderDashboardDetail(title,subtitle,icon,body){
 const x=ensureShell(); if(!x?.stage)return false;
 x.stage.innerHTML=`<section class="cc390-detail-window" aria-label="${esc(title)}"><header class="cc390-detail-head"><button type="button" class="cc390-detail-back" id="cc390DetailBack">← <span>Panel General</span></button><div class="cc390-detail-title"><span class="cc390-detail-icon">${icon}</span><div><h1>${esc(title)}</h1><p>${esc(subtitle)}</p></div></div></header><div class="cc390-detail-body">${body}</div></section>`;
 x.stage.querySelector('#cc390DetailBack')?.addEventListener('click',panelGeneral,{once:true}); x.overlay.scrollTop=0;x.overlay.scrollLeft=0; return true;
}
function detailList(title,desc,rows,empty='No hay información disponible.'){
 return `<section class="cc390-info-section"><div class="cc390-info-section-head"><div><h2>${esc(title)}</h2><p>${esc(desc)}</p></div><span class="cc388-badge">${rows.length}</span></div>${rows.length?`<div class="cc390-info-list">${rows.map(r=>`<article class="cc390-info-row">${r}</article>`).join('')}</div>`:`<div class="cc390-empty">${esc(empty)}</div>`}</section>`;
}
function dashboardDetail(kind,key){
 const os=orders(),ps=products(),us=users();
 if(kind==='sales'){const rows=os.filter(paid);return renderDashboardDetail('Ventas confirmadas','Pedidos con pago confirmado o completados.',catalogKindIcon('membership'),detailList('Registro de ventas','Operaciones registradas.',rows.map(o=>`<div><b>${esc(o?.id||'Pedido')}</b><span>${esc(o?.customer?.fullName||'Cliente')} · ${esc(o?.status||o?.payment?.status||'Confirmado')}</span></div><strong>${esc(money(o?.total))}</strong>`),'Todavía no hay ventas confirmadas.'))}
 if(kind==='clients'){return renderDashboardDetail('Clientes','Cuentas registradas actualmente.',catalogKindIcon('profile'),detailList('Clientes registrados','Información tomada del registro local.',us.map(u=>`<div><b>${esc(u?.fullName||u?.username||'Cliente')}</b><span>${esc(u?.email||'Sin correo registrado')}</span></div><strong>${esc(u?.phone||'')}</strong>`),'No hay clientes registrados.'))}
 if(kind==='catalog'){const labels={profile:'Perfiles / suscripciones',membership:'Invitaciones / membresías',recharge:'Diamantes / recargas',course:'Cursos digitales',license:'Licencias / claves'};const list=key==='all'?ps:ps.filter(p=>classifyCatalogKind(p)===key);return renderDashboardDetail(labels[key]||'Catálogo digital','Productos de esta categoría.',catalogKindIcon(key),detailList(labels[key]||'Productos','Configuración actual del catálogo.',list.map(p=>`<div><b>${esc(p?.name||'Producto')}</b><span>${esc(p?.digitalKind||p?.digitalType||p?.category||'Producto digital')}</span></div><strong>${esc(money(p?.price))}</strong>`),'No hay productos configurados en esta categoría.'))}
 if(kind==='order'){const o=os.find(v=>String(v?.id||'')===String(key)); if(!o)return renderDashboardDetail('Pedido','Información del pedido.','<svg viewBox="0 0 48 48"><rect x="9" y="7" width="30" height="34" rx="4"/></svg>','<div class="cc390-empty">No se encontró el pedido.</div>'); const items=(Array.isArray(o?.items)?o.items:[]).map(i=>`<div><b>${esc(i?.name||'Producto')}</b><span>Cantidad: ${n(i?.qty)||1}</span></div><strong>${esc(money(n(i?.price||0)*(n(i?.qty)||1)))}</strong>`);return renderDashboardDetail(`Pedido ${o?.id||''}`,'Detalle del pedido seleccionado.','<svg viewBox="0 0 48 48"><rect x="9" y="7" width="30" height="34" rx="4"/><path d="M16 15h16M16 22h16M16 29h8"/><path d="m29 31 3 3 6-7"/></svg>',detailList('Productos','Contenido registrado en el pedido.',items,'El pedido no tiene productos registrados.')+`<section class="cc390-detail-summary"><div><span>Cliente</span><b>${esc(o?.customer?.fullName||'Cliente')}</b></div><div><span>Estado</span><b>${esc(o?.status||o?.payment?.status||'Pendiente')}</b></div><div><span>Total</span><b>${esc(money(o?.total))}</b></div></section>`)}
 if(kind==='storage')return renderDashboardDetail('Almacenamiento local','Espacio aproximado utilizado.','<svg viewBox="0 0 48 48"><rect x="8" y="10" width="32" height="28" rx="4"/><path d="M15 18h18M15 24h11M15 30h14"/></svg>',`<section class="cc390-detail-summary"><div><span>Estimación actual</span><b>${esc(storageInfo())}</b></div><div><span>Fuente</span><b>localStorage</b></div></section>`);
 if(kind==='digital')return renderDashboardDetail('Modelo comercial','Estructura de operación de CRULOX.','<svg viewBox="0 0 48 48"><rect x="7" y="9" width="34" height="22" rx="4"/><path d="M18 39h12M24 31v8"/></svg>','<section class="cc390-detail-summary"><div><span>Modelo</span><b>100% digital</b></div><div><span>Entrega física</span><b>No aplica</b></div><div><span>Operación</span><b>Activaciones, recargas, perfiles, invitaciones y cursos</b></div></section>');
 let rows=[];if(kind==='pending')rows=os.filter(o=>!['Completado','Entregado digital','Cancelado','Reserva vencida'].includes(String(o?.status||'')));else if(kind==='receipts')rows=os.filter(o=>!paid(o)&&receipt(o));else if(kind==='delivery')rows=os.filter(o=>String(o?.status||'')==='Listo para entregar');else if(kind==='renewals')rows=renewalRows().filter(x=>x.days>=0&&x.days<=5);else if(kind==='payments')rows=os.filter(o=>!paid(o));else if(kind==='preparing')rows=os.filter(o=>['Preparando acceso','Listo para entregar'].includes(String(o?.status||'')));
 const labels={pending:['Pedidos pendientes','Pedidos todavía abiertos.'],receipts:['Comprobantes para verificar','Comprobantes sin pago confirmado.'],delivery:['Entregas pendientes','Pedidos listos para entrega digital.'],renewals:['Renovaciones ≤ 5 días','Perfiles que requieren seguimiento.'],payments:['Pagos por revisar','Pedidos con pago sin confirmar.'],preparing:['En preparación','Pedidos en preparación o listos.']};const [ttl,ds]=labels[kind]||['Información','Detalle operativo.'];const list=rows.map(o=>o?.kind==='expiration'?`<div><b>${esc(o.product||'Perfil')}</b><span>${esc(o.name||'Cliente')} · ${o.days===0?'vence hoy':`vence en ${o.days} día${o.days===1?'':'s'}`}</span></div><strong>${esc(o.cutoff||'')}</strong>`:`<div><b>${esc(o?.id||'Pedido')}</b><span>${esc(o?.customer?.fullName||'Cliente')} · ${esc(o?.status||o?.payment?.status||'Pendiente')}</span></div><strong>${esc(money(o?.total))}</strong>`);return renderDashboardDetail(ttl,ds,'<svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="15"/><path d="M24 14v20M17 21h14M17 27h10"/></svg>',detailList(ttl,ds,list,'No hay registros que mostrar.'));
}
function rowsList(rows,stateName){if(!rows.length)return '<div class="cc390-empty">No hay registros en este grupo.</div>';return `<div class="cc390-renewal-list">${rows.slice(0,60).map(x=>`<button type="button" class="cc390-renewal-row" data-renewal-order="${esc(x.orderId||'')}"><span class="cc390-renewal-row-main"><b>${esc(x.product||'Perfil')}</b><small>${esc(x.name||'Cliente')} · ${esc(x.orderId||'')}</small></span><span class="cc390-renewal-row-status ${stateName}">${stateName==='expired'?'Vencido':x.days===0?'Hoy':`${x.days} d`}</span></button>`).join('')}</div>`;}
function renewalModule(){syncRenewalNotifications392();const rows=renewalRows(),expiring=rows.filter(x=>x.days>=0&&x.days<=5),expired=rows.filter(x=>x.days<0),upcoming=rows.filter(x=>x.days>5);const x=ensureShell();if(!x?.stage)return false;x.stage.innerHTML=`<section class="cc378-module-window cc390-renewal-module"><header class="cc378-module-head"><button type="button" class="cc378-back" id="cc390RenewBack" aria-label="Volver a funciones">← <span class="cc389-back-label">Funciones</span></button><div class="cc378-module-id"><span class="cc378-module-icon">${iconFor389('renewals')}</span><div><h1>Renovaciones y Vencimientos</h1><p>Perfiles y cuentas por vencer, renovar o liberar.</p></div></div></header><div class="cc378-module-body"><section class="cc390-renewal-hero"><div><span class="cc388-kicker"><i></i>Ciclo de renovación</span><h2>Seguimiento de 5 días</h2><p>Los perfiles con vencimiento dentro de los próximos cinco días requieren aviso y seguimiento. Cuando el plan vence sin reactivación ni cancelación, pasa a estado de nueva venta y el cliente debe realizar una nueva compra.</p></div><div class="cc390-renewal-stats"><span><b>${expiring.length}</b> por vencer</span><span><b>${expired.length}</b> vencidos</span><span><b>${upcoming.length}</b> próximos</span></div></section><section class="cc390-renewal-grid"><article class="cc390-renewal-card"><div class="cc390-renewal-card-head"><h3>Por vencer en ≤ 5 días</h3><b>${expiring.length}</b></div><p>Perfiles dentro del período de aviso y seguimiento.</p>${rowsList(expiring,'expiring')}</article><article class="cc390-renewal-card expired"><div class="cc390-renewal-card-head"><h3>Vencidos · disponibles para nueva compra</h3><b>${expired.length}</b></div><p>Sin reactivación ni cancelación; requieren una nueva compra.</p>${rowsList(expired,'expired')}</article></section><section class="cc390-renewal-rule"><div class="cc390-rule-icon">!</div><div><b>Regla operativa</b><p>Vencido el plan, no se renueva automáticamente. Para perfiles cuyo método de entrega sea cambio de código, se conserva correo y contraseña y solo se cambia el código del perfil. La vuelta del cliente exige una <strong>nueva compra</strong>.</p></div></section></div></section>`;x.stage.querySelector('#cc390RenewBack')?.addEventListener('click',renderFunctions,{once:true});x.overlay.scrollTop=0;x.overlay.scrollLeft=0;return true;}
function panelGeneral(){
 syncRenewalNotifications392();
 const x=ensureShell();if(!x?.stage)return false;const os=orders(),ps=products(),us=users();const pending=os.filter(o=>!['Completado','Entregado digital','Cancelado','Reserva vencida'].includes(String(o?.status||''))).length;const pp=os.filter(o=>!paid(o)&&!receipt(o)).length;const rp=os.filter(o=>!paid(o)&&receipt(o)).length;const del=os.filter(o=>String(o?.status||'')==='Listo para entregar').length;const prep=os.filter(o=>['Preparando acceso','Listo para entregar'].includes(String(o?.status||''))).length;const rev=os.filter(paid).reduce((s,o)=>s+n(o?.total),0);const ren=renewalRows().filter(r=>r.days>=0&&r.days<=5).length;const recent=os.slice().sort((a,b)=>Date.parse(b?.updatedAt||b?.createdAt||0)-Date.parse(a?.updatedAt||a?.createdAt||0)).slice(0,5);const kinds={recharge:0,profile:0,membership:0,course:0,license:0};ps.forEach(p=>{const k=classifyCatalogKind(p);if(kinds[k]!==undefined)kinds[k]++});const max=Math.max(1,...Object.values(kinds));const kpi=(k,t,v,sub)=>`<button type="button" class="cc388-kpi cc388-clickable" data-cc388-detail="${k}"><small>${t}</small><strong>${v}</strong><span>${sub}</span></button>`;const card=(k,t,num,desc,pct)=>`<button type="button" class="cc388-card cc388-clickable" data-cc388-detail="${k}"><div class="cc388-card-head"><h4>${t}</h4><span class="cc388-num">${num}</span></div><p>${desc}</p><div class="cc388-bar"><b style="--w:${pct}%"></b></div></button>`;const cats=[['profile','Perfiles / suscripciones'],['membership','Invitaciones / membresías'],['recharge','Diamantes / recargas'],['course','Cursos digitales'],['license','Licencias / claves']];x.stage.innerHTML=`<section class="cc388-dashboard"><div class="cc389-return-row"><button type="button" class="cc389-back" id="cc389PanelBack" aria-label="Regresar a las funciones">← <span>Funciones</span></button></div><section class="cc388-hero"><span class="cc388-kicker"><i></i>Panel General · control operativo</span><h2>Centro de control de CRULOX</h2><p>Vista central de pedidos, pagos, comprobantes, entregas, renovaciones y catálogo. Haz clic en cualquier indicador o registro para abrir su detalle.</p><span class="cc388-live">● Datos locales activos</span></section><section class="cc388-kpis">${kpi('sales','Ventas confirmadas',esc(money(rev)),'Ingresos registrados')}${kpi('pending','Pedidos activos',pending,'Requieren seguimiento')}${kpi('payments','Pagos por revisar',pp+rp,`${pp} sin comprobante · ${rp} con comprobante`)}${kpi('clients','Clientes',us.length,'Cuentas registradas')}</section><section class="cc388-section"><div class="cc388-section-head"><div><h3>Estado operativo</h3><p>Selecciona un bloque para consultar su información.</p></div></div><div class="cc388-grid">${card('pending','Pedidos pendientes',pending,'Pedidos todavía abiertos.',Math.min(100,(pending/Math.max(1,os.length))*100))}${card('receipts','Comprobantes para verificar',rp,'Comprobantes sin pago confirmado.',Math.min(100,(rp/Math.max(1,os.length))*100))}${card('delivery','Entregas pendientes',del,'Pedidos listos para entrega digital.',Math.min(100,(del/Math.max(1,os.length))*100))}${card('renewals','Renovaciones ≤ 5 días',ren,'Perfiles dentro del período de aviso.',Math.min(100,(ren/Math.max(1,os.length))*100))}</div></section><section class="cc388-section"><div class="cc388-section-head"><div><h3>Composición del catálogo digital</h3><p>Selecciona un tipo para ver los productos.</p></div><span class="cc388-badge">${ps.length} productos</span></div><div class="cc388-list">${cats.map(([k,l])=>`<button type="button" class="cc388-row cc388-clickable" data-cc388-detail="catalog:${k}"><span class="cc388-row-icon">${catalogKindIcon(k)}</span><div><b>${l}</b><span>${kinds[k]} producto${kinds[k]===1?'':'s'} configurado${kinds[k]===1?'':'s'}</span></div><span class="cc388-badge">${Math.round(kinds[k]/max*100)}%</span></button>`).join('')}</div></section><section class="cc388-section"><div class="cc388-section-head"><div><h3>Actividad reciente</h3><p>Selecciona un pedido para abrir su información.</p></div><span class="cc388-badge">${os.length} total</span></div>${recent.length?`<div class="cc388-list">${recent.map(o=>`<button type="button" class="cc388-row cc388-clickable" data-cc388-detail="order:${esc(o?.id||'')}"><span class="cc388-row-icon">${iconFor389('orders')}</span><div><b>${esc(o?.id||'Pedido')}</b><span>${esc(o?.customer?.fullName||'Cliente')} · ${esc(o?.status||o?.payment?.status||'Pendiente')}</span></div><span class="cc388-badge">${esc(money(o?.total))}</span></button>`).join('')}</div>`:'<div class="cc388-empty">Todavía no hay pedidos registrados.</div>'}</section><section class="cc388-section"><div class="cc388-section-head"><div><h3>Acciones rápidas</h3><p>Entrada directa a módulos operativos.</p></div></div><div class="cc388-actions"><button type="button" class="cc388-action" data-cc388-go="orders"><b>Pedidos</b><span>Revisar el flujo de pedidos.</span></button><button type="button" class="cc388-action" data-cc388-go="payments"><b>Pagos</b><span>Controlar pagos y comprobantes.</span></button><button type="button" class="cc388-action" data-cc388-go="delivery"><b>Entregas</b><span>Controlar entregas digitales.</span></button><button type="button" class="cc388-action" data-cc388-go="renewals"><b>Renovaciones</b><span>Ver vencimientos y nuevas compras.</span></button></div></section><section class="cc388-section"><div class="cc388-section-head"><div><h3>Estado del sistema</h3><p>Selecciona un indicador para consultar su información.</p></div></div><div class="cc388-system"><button type="button" data-cc388-detail="catalog:all"><small>Productos</small><b>${ps.length}</b></button><button type="button" data-cc388-detail="clients"><small>Clientes</small><b>${us.length}</b></button><button type="button" data-cc388-detail="pending"><small>Pedidos</small><b>${os.length}</b></button><button type="button" data-cc388-detail="preparing"><small>En preparación</small><b>${prep}</b></button><button type="button" data-cc388-detail="storage"><small>Almacenamiento local estimado</small><b>${esc(storageInfo())}</b></button><button type="button" data-cc388-detail="digital"><small>Modelo comercial</small><b>100% digital</b></button></div></section></section>`;x.stage.querySelectorAll('[data-cc388-go]').forEach(b=>b.addEventListener('click',()=>openModule(b.dataset.cc388Go),{once:true}));x.stage.querySelectorAll('[data-cc388-detail]').forEach(b=>b.addEventListener('click',()=>{const raw=b.dataset.cc388Detail||'';if(raw.startsWith('catalog:'))return dashboardDetail('catalog',raw.split(':')[1]);if(raw.startsWith('order:'))return dashboardDetail('order',raw.slice(6));return dashboardDetail(raw,'')},{once:true}));x.stage.querySelector('#cc389PanelBack')?.addEventListener('click',renderFunctions,{once:true});x.overlay.scrollTop=0;x.overlay.scrollLeft=0;return true;
}
const CC394_TOOLSETS=Object.freeze({
  catalog:[["Vista del catálogo", "Ver estructura, categorías y disponibilidad"], ["Categorías", "Organizar productos por plataforma y tipo"], ["Disponibilidad", "Ver qué está disponible, reservado o agotado"], ["Buscador administrativo", "Localizar productos y servicios"], ["Orden y visibilidad", "Controlar posición y publicación"], ["Auditoría de catálogo", "Detectar productos incompletos o inconsistentes"]],
  products:[["Crear producto o servicio", "Alta guiada con método de entrega"], ["Editar producto", "Precio, costo, descripción, imagen y reglas"], ["5 métodos de entrega", "ID de juego, correo, enlace, credenciales/perfil o curso"], ["Campos requeridos", "Definir ID, Gmail u otros datos obligatorios"], ["Precios y costos", "Precio de venta, costo y margen esperado"], ["Stock/cupos", "Controlar unidades, perfiles, invitaciones o plazas"], ["Variantes y planes", "Duraciones, paquetes y opciones"], ["Estado comercial", "Activo, oculto, agotado o suspendido"], ["Duplicar producto", "Crear variantes sin repetir configuración"], ["Validación previa", "Comprobar que el producto pueda venderse correctamente"]],
  clients:[["Directorio de clientes", "Datos, contacto y estado"], ["Ficha 360°", "Compras, pagos, perfiles, incidencias y actividad"], ["Historial de compras", "Pedidos y productos adquiridos"], ["Servicios activos", "Perfiles, cursos, invitaciones y recargas"], ["Vencimientos por cliente", "Planes próximos a finalizar"], ["Segmentación", "Nuevos, recurrentes, VIP, inactivos o riesgo"], ["Notas internas", "Observaciones administrativas"], ["Bloqueos y restricciones", "Controlar abuso, fraude o incumplimientos"], ["Valor del cliente", "Compras acumuladas, ticket y LTV"], ["Exportar clientes", "Salida controlada de información"]],
  sales:[["Ventas del día", "Operaciones confirmadas hoy"], ["Historial de ventas", "Consulta completa y filtros"], ["Venta por producto", "Rendimiento de cada servicio"], ["Venta por cliente", "Compras acumuladas por usuario"], ["Venta manual", "Registrar operación administrativa"], ["Reactivaciones", "Ventas originadas por recompra tras vencimiento"], ["Cancelaciones y devoluciones", "Control de operaciones revertidas"], ["Descuentos aplicados", "Impacto de promociones"], ["Canal de venta", "Tienda, admin, referido o campaña"], ["Cierre de ventas", "Resumen por día, semana y mes"]],
  orders:[["Bandeja de pedidos", "Todos los pedidos y su etapa"], ["Pendientes de pago", "Pedidos todavía sin pago válido"], ["Comprobante recibido", "Pedidos listos para verificar"], ["Verificación final", "Revisar productos y datos antes de procesar"], ["En preparación", "Pedidos pagados en proceso de entrega"], ["Listos para entregar", "Cola final de entrega digital"], ["Completados", "Historial de pedidos terminados"], ["Cancelados/rechazados", "Motivos y trazabilidad"], ["Datos requeridos", "ID de juego, Gmail y datos específicos"], ["Timeline del pedido", "Registro cronológico de cada cambio"], ["Búsqueda y filtros", "Cliente, estado, producto, fecha o ID"], ["Acciones masivas", "Cambios controlados sobre varios pedidos"]],
  delivery:[["Cola de entregas", "Pedidos listos para despacho digital"], ["Recarga por ID", "Entrega de diamantes u otros créditos"], ["Invitación por correo", "Servicios que requieren Gmail"], ["Enlace de invitación", "Spotify u otros servicios por enlace"], ["Credenciales y perfil", "Correo, contraseña y código asignado"], ["Curso digital", "Enlace y datos de acceso"], ["Plantillas de entrega", "Mensajes consistentes por tipo"], ["Confirmación de entrega", "Fecha, responsable y evidencia"], ["Reenvío controlado", "Volver a enviar sin duplicar la venta"], ["Entregas fallidas", "Errores, causa y reintento"], ["SLA de entrega", "Tiempo desde pago hasta entrega"]],
