}
</style>

<script id="cruzclick-v3718-account-admin-menu-script">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.7.18';
  const OWNER_EMAIL='admin-separado@crulox.invalid';
  const OWNER_PASSWORD_SHA256='9c3b83eb1b39297606a1d599f17c6900f2e9f3df65fee429b5537edbaa91a52b';
  const OWNER_AUTH_VERSION='cruzclick-owner-v3718';
  const PANEL_OPEN_KEY='cc_admin_panel_open_v3718';
  const OLD_ADMIN_PERSIST_KEY='np_admin_persist_v106';
  const LAST_IDENTITY_KEY='np_last_login_identity_v106';

  const norm3718=value=>{
    try{return typeof norm==='function'?norm(String(value||'').trim()):String(value||'').trim().toLowerCase()}
    catch(e){return String(value||'').trim().toLowerCase()}
  };
  const getJSON3718=(key,fallback=null)=>{
    try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):fallback}catch(e){return fallback}
  };
  const setJSON3718=(key,value)=>{
    try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){return false}
  };
  const remove3718=key=>{try{localStorage.removeItem(key)}catch(e){}};
  const writeSession3718=()=>{
    try{if(typeof write==='function'&&typeof KEYS!=='undefined')write(KEYS.session,state.session)}catch(e){}
  };
  const ownerSession3718=()=>{
    try{
      return !!state?.session &&
        state.session.role==='admin' &&
        norm3718(state.session.email)===norm3718(OWNER_EMAIL) &&
        state.session.ownerAuthVersion===OWNER_AUTH_VERSION;
    }catch(e){return false}
  };

  /* Elimina persistencias administrativas heredadas para que solo exista el nuevo acceso propietario. */
  remove3718(OLD_ADMIN_PERSIST_KEY);
  try{
    if(state?.session?.role==='admin'&&!ownerSession3718()){
      state.session=null;
      writeSession3718();
    }
  }catch(e){}

  function panelOpenStored3718(){
    try{return localStorage.getItem(PANEL_OPEN_KEY)==='1'}catch(e){return false}
  }
  function setPanelOpenStored3718(open){
    try{localStorage.setItem(PANEL_OPEN_KEY,open?'1':'0')}catch(e){}
  }
  function overlay3718(){return D.getElementById('adminOverlay')}

  function markOverlay3718(){
    const overlay=overlay3718();
    if(!overlay)return;
    if(ownerSession3718())overlay.setAttribute('data-cc-owner-auth','1');
    else overlay.removeAttribute('data-cc-owner-auth');
  }

  function closePanelOnly3718(){
    const overlay=overlay3718();
    setPanelOpenStored3718(false);
    if(overlay){
      overlay.classList.remove('open');
      overlay.removeAttribute('data-cc-owner-auth');
    }
    D.body.classList.remove('lock');
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    return true;
  }

  function logoutOwner3718(){
    try{state.session=null}catch(e){}
    writeSession3718();
    remove3718(OLD_ADMIN_PERSIST_KEY);
    setPanelOpenStored3718(false);
    const overlay=overlay3718();
    if(overlay){
      overlay.classList.remove('open');
      overlay.removeAttribute('data-cc-owner-auth');
    }
    D.body.classList.remove('lock');
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    try{
      if(typeof toast==='function')toast('Sesión administrativa cerrada.','success');
      else if(typeof notify==='function')notify('Sesión administrativa cerrada.','success');
    }catch(e){}
    return true;
  }

  const legacyOpenAdmin3718=typeof window.openAdmin==='function'?window.openAdmin:null;

  function secureOpenAdmin3718(section='home'){
    if(!ownerSession3718()){
      const overlay=overlay3718();
      if(overlay){
        overlay.classList.remove('open');
        overlay.removeAttribute('data-cc-owner-auth');
      }
      D.body.classList.remove('lock');
      try{
        if(typeof renderAccount==='function')renderAccount();
        if(typeof openModal==='function')openModal('accountModal');
      }catch(e){}
      return false;
    }

    const overlay=overlay3718();
    if(!overlay)return false;
    overlay.setAttribute('data-cc-owner-auth','1');
    setPanelOpenStored3718(true);

    let opened=false;
    try{
      const finalReset=window.CRUZCLICK_ADMIN_V378?.open;
      if(typeof finalReset==='function'){
        finalReset();
        opened=true;
      }else if(legacyOpenAdmin3718&&legacyOpenAdmin3718!==secureOpenAdmin3718){
        opened=legacyOpenAdmin3718(section)!==false;
      }
    }catch(error){console.error('CRULOX V3.7.18 admin open',error)}

    if(!opened){
      overlay.classList.add('open');
      D.body.classList.add('lock');
      opened=true;
    }
    markOverlay3718();
    bindAdminActions3718();
    return opened;
  }

  function bindAdminActions3718(){
    const storeButtons=[
      D.getElementById('cc378Store'),
      D.getElementById('adminStoreBtn')
    ].filter(Boolean);
    storeButtons.forEach(button=>{
      if(button.dataset.cc3718Store==='1')return;
      button.dataset.cc3718Store='1';
      button.onclick=()=>{
        closePanelOnly3718();
        try{
          if(typeof toast==='function')toast('Tienda abierta. Tu sesión administrativa continúa activa.','success');
          else if(typeof notify==='function')notify('Tienda abierta. Tu sesión administrativa continúa activa.','success');
        }catch(e){}
      };
    });

    const logoutButtons=[
      D.getElementById('cc378Logout'),
      D.getElementById('adminLogout')
    ].filter(Boolean);
    logoutButtons.forEach(button=>{
      if(button.dataset.cc3718Logout==='1')return;
      button.dataset.cc3718Logout='1';
      button.onclick=logoutOwner3718;
    });
  }

  function guardOverlay3718(){
    const overlay=overlay3718();
    if(!overlay)return;
    if(overlay.classList.contains('open')){
      if(!ownerSession3718()){
        overlay.classList.remove('open');
        overlay.removeAttribute('data-cc-owner-auth');
        D.body.classList.remove('lock');
        setPanelOpenStored3718(false);
      }else{
        overlay.setAttribute('data-cc-owner-auth','1');
        setPanelOpenStored3718(true);
      }
    }else if(!ownerSession3718()){
      overlay.removeAttribute('data-cc-owner-auth');
    }
    bindAdminActions3718();
  }

  /* Refuerzo contra aperturas heredadas o directas sin autenticación válida. */
  const adminObserver3718=new MutationObserver(guardOverlay3718);
  const startAdminGuard3718=()=>{
    const overlay=overlay3718();
    if(!overlay)return;
    markOverlay3718();
    adminObserver3718.observe(overlay,{attributes:true,attributeFilter:['class'],childList:true,subtree:true});
    guardOverlay3718();
  };
  if(D.readyState==='loading')D.addEventListener('DOMContentLoaded',startAdminGuard3718,{once:true});
  else startAdminGuard3718();

  function passButtonMarkup3718(id){
    return `<button class="password-toggle" type="button" data-password-toggle="${id}" aria-label="Mostrar contraseña"><span class="cc-pass-emoji" aria-hidden="true">👁️</span><span class="cc-pass-label">Ver</span></button>`;
  }

  function bindPasswordToggles3718(root=D){
    root.querySelectorAll('[data-password-toggle]').forEach(button=>{
      if(button.dataset.cc3718Bound==='1')return;
      button.dataset.cc3718Bound='1';
      const targetId=button.dataset.passwordToggle;
      if(!button.querySelector('.cc-pass-emoji'))button.innerHTML='<span class="cc-pass-emoji" aria-hidden="true">👁️</span><span class="cc-pass-label">Ver</span>';
      button.onclick=()=>{
        const input=D.getElementById(targetId);
        if(!input)return;
        const willShow=input.type==='password';
        input.type=willShow?'text':'password';
        button.classList.toggle('active',willShow);
        const emoji=button.querySelector('.cc-pass-emoji');
        const label=button.querySelector('.cc-pass-label');
        if(emoji)emoji.textContent=willShow?'🙈':'👁️';
        if(label)label.textContent=willShow?'Ocultar':'Ver';
        button.setAttribute('aria-label',willShow?'Ocultar contraseña':'Mostrar contraseña');
        button.classList.remove('cc-pass-pop');
        void button.offsetWidth;
        button.classList.add('cc-pass-pop');
        window.setTimeout(()=>button.classList.remove('cc-pass-pop'),360);
      };
    });
  }

  /* Mantiene compatibilidad con renderizados posteriores del perfil/cuenta. */
  try{window.bindPasswordToggles=bindPasswordToggles3718}catch(e){}
  try{bindPasswordToggles=bindPasswordToggles3718}catch(e){}

  function rememberedIdentity3718(){
    const saved=getJSON3718(LAST_IDENTITY_KEY,{identity:''})||{identity:''};
    return String(saved.identity||'');
  }

  function renderLogin3718(){
    const auth=D.getElementById('authContent');
    if(!auth)return;
    const identity=rememberedIdentity3718();
    const safeIdentity=typeof esc==='function'?esc(identity):identity.replace(/[&<>"']/g,'');
    auth.innerHTML=`
      <div class="cc-auth-intro">
        <b>Accede a tu cuenta</b>
        <span>Usa tu usuario o correo y tu contraseña para continuar de forma segura.</span>
      </div>
      <form id="loginForm" novalidate>
        <div class="form-grid">
          <div class="field full">
            <label>Usuario o correo</label>
            <input id="loginIdentity" value="${safeIdentity}" placeholder="Escribe tu usuario o correo" required autocomplete="username" autocapitalize="none" spellcheck="false"/>
          </div>
          <div class="field full">
            <label>Contraseña</label>
            <div class="password-input-wrap">
              <input id="loginPassword" type="password" placeholder="Escribe tu contraseña" required autocomplete="current-password"/>
              ${passButtonMarkup3718('loginPassword')}
            </div>
          </div>
          <div class="field full">
            <label class="cc-remember"><input id="npRememberAccess" type="checkbox" checked/> Mantener mi sesión abierta en este dispositivo</label>
          </div>
        </div>
        <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Acceder</button></div>
      </form>`;
    bindPasswordToggles3718(auth);
    const form=D.getElementById('loginForm');
    if(form)form.onsubmit=handleLogin3718;
  }

  function passwordField3718(id,label,required=true){
    return `<div class="field"><label>${label}</label><div class="password-input-wrap"><input id="${id}" type="password" minlength="8" ${required?'required':''} autocomplete="new-password" placeholder="${label}"/>${passButtonMarkup3718(id)}</div></div>`;
  }

  function renderRegister3718(){
    const auth=D.getElementById('authContent');
    if(!auth)return;
    let fields='';
    try{fields=accountFields().map(field=>fieldHtml(field,'reg')).join('')}catch(e){}
    auth.innerHTML=`
      <div class="cc-auth-intro">
        <b>Crea tu cuenta CRULOX</b>
        <span>Registra tus datos una sola vez para agilizar tus pedidos y consultar su seguimiento.</span>
      </div>
      <form id="registerForm" novalidate>
        <div class="form-grid">
          ${fields}
          ${passwordField3718('regPassword','Contraseña',true)}
          ${passwordField3718('regConfirm','Confirmar contraseña',true)}
          <div class="field full">
            <label class="cc-consent"><input id="regConsent" type="checkbox"/> <span>Acepto que mis datos se utilicen para gestionar pedidos, accesos y entregas digitales.</span></label>
          </div>
        </div>
        <div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Crear cuenta</button></div>
      </form>`;
    bindPasswordToggles3718(auth);
    const form=D.getElementById('registerForm');
    if(form&&typeof handleRegister==='function')form.onsubmit=handleRegister;
  }

  function loginError3718(input,message='No pudimos iniciar sesión. Verifica tu usuario o correo y tu contraseña e inténtalo de nuevo.'){
    try{
      if(input){
        input.classList.add('input-error');
        input.addEventListener('input',()=>input.classList.remove('input-error'),{once:true});
        input.focus({preventScroll:true});
      }
      if(typeof showModalNotice==='function')showModalNotice(message,'error','accountModal');
      else if(typeof toast==='function')toast(message,'error');
    }catch(e){}
    return false;
  }

  async function handleLogin3718(event){
    event?.preventDefault?.();
    try{if(typeof clearModalNotice==='function')clearModalNotice('accountModal')}catch(e){}
    const identity=D.getElementById('loginIdentity')?.value.trim()||'';
    const password=D.getElementById('loginPassword')?.value||'';
    const remember=D.getElementById('npRememberAccess')?.checked!==false;

    if(!identity)return loginError3718(D.getElementById('loginIdentity'),'Escribe tu usuario o correo electrónico para continuar.');
    if(!password)return loginError3718(D.getElementById('loginPassword'),'Escribe tu contraseña para continuar.');

    const normalized=norm3718(identity);

    /* Único acceso al panel: propietario + contraseña exacta. */
    if(normalized===norm3718(OWNER_EMAIL)){
      let hash='';
      try{hash=await sha256(password)}catch(e){}
      if(hash!==OWNER_PASSWORD_SHA256){
        return loginError3718(D.getElementById('loginPassword'));
      }

      state.session={
        role:'admin',
        email:OWNER_EMAIL,
        ownerAuthVersion:OWNER_AUTH_VERSION,
        persistent:true,
        createdAt:new Date().toISOString()
      };
      writeSession3718();
      remove3718(OLD_ADMIN_PERSIST_KEY);
      setJSON3718(LAST_IDENTITY_KEY,{identity:OWNER_EMAIL,role:'admin',updatedAt:new Date().toISOString()});
      setPanelOpenStored3718(true);
      try{if(typeof closeModal==='function')closeModal('accountModal')}catch(e){}
      try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
      try{if(typeof logActivity==='function')logActivity('Inicio administrativo',OWNER_EMAIL)}catch(e){}
      secureOpenAdmin3718('home');
      try{if(typeof toast==='function')toast('Acceso administrativo correcto.','success')}catch(e){}
      return true;
    }

    /* Las demás credenciales solo pueden iniciar como cliente. Nunca abren administración. */
    try{
      const user=(state.users||[]).find(u=>norm3718(u.username)===normalized||norm3718(u.email)===normalized);
      let valid=false;
      if(user){
        if(typeof npVerifyUserPassword==='function')valid=await npVerifyUserPassword(user,password);
        else valid=(await sha256(password))===user.passwordHash;
      }
      if(!user||!valid)return loginError3718(D.getElementById('loginPassword'));

      state.session={role:'client',userId:user.id,persistent:remember,createdAt:new Date().toISOString()};
      writeSession3718();
      setJSON3718(LAST_IDENTITY_KEY,{identity:user.email||user.username,role:'client',updatedAt:new Date().toISOString()});
      try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
      try{if(typeof renderAccount==='function')renderAccount()}catch(e){}
      try{if(typeof toast==='function')toast('Sesión iniciada correctamente.','success')}catch(e){}
      return true;
    }catch(error){
      console.error('CRULOX V3.7.18 login',error);
      return loginError3718(D.getElementById('loginPassword'),'No fue posible validar el acceso en este momento. Intenta nuevamente.');
    }
  }

  try{window.renderLogin=renderLogin3718}catch(e){}
  try{window.renderRegister=renderRegister3718}catch(e){}
  try{window.handleLogin=handleLogin3718}catch(e){}
  try{renderLogin=renderLogin3718}catch(e){}
  try{renderRegister=renderRegister3718}catch(e){}
  try{handleLogin=handleLogin3718}catch(e){}

  /* Cambia las pestañas sin depender de manejadores antiguos. */
  function refreshAccountTabs3718(){
    const body=D.getElementById('accountBody');
    if(!body)return;
    body.querySelectorAll('[data-auth-tab]').forEach(tab=>{
      tab.onclick=()=>{
        body.querySelectorAll('.tab').forEach(item=>item.classList.toggle('active',item===tab));
        if(tab.dataset.authTab==='register')renderRegister3718();
        else renderLogin3718();
      };
    });
  }

  const accountObserver3718=new MutationObserver(()=>{
    refreshAccountTabs3718();
    bindPasswordToggles3718(D.getElementById('accountModal')||D);
  });
  const accountBody3718=D.getElementById('accountBody');
  if(accountBody3718)accountObserver3718.observe(accountBody3718,{childList:true,subtree:true});
  refreshAccountTabs3718();

  /* Reinstala el guard después del reset administrativo heredado (se instala tras load). */
  function installSecureAdmin3718(){
    window.openAdmin=secureOpenAdmin3718;
    try{openAdmin=secureOpenAdmin3718}catch(e){}
    guardOverlay3718();
    if(ownerSession3718()&&panelOpenStored3718()){
      window.setTimeout(()=>secureOpenAdmin3718('home'),60);
    }
  }
  installSecureAdmin3718();
  window.addEventListener('load',()=>{
    window.setTimeout(installSecureAdmin3718,80);
    window.setTimeout(installSecureAdmin3718,2050);
  },{once:true});
  window.setTimeout(installSecureAdmin3718,2300);

  /* Si un código heredado intenta abrir administración sin sesión propietaria, se cierra de inmediato. */
  D.addEventListener('click',event=>{
    const target=event.target?.closest?.('#profileBtn,#drawerProfile');
    if(!target)return;
    if(ownerSession3718())return;
    const overlay=overlay3718();
    if(overlay?.classList.contains('open')){
      overlay.classList.remove('open');
      overlay.removeAttribute('data-cc-owner-auth');
      D.body.classList.remove('lock');
    }
  },false);

  /* V3.7.22: no se instala el observador vacío del menú lateral. */

  window.CRUZCLICK_V3718=Object.freeze({
    version:VERSION,
    ownerSession:ownerSession3718,
    openAdmin:secureOpenAdmin3718,
    logoutAdmin:logoutOwner3718,
    closeAdmin:closePanelOnly3718,
    selfTest(){
      return {
        version:VERSION,
        ownerEmailConfigured:norm3718(OWNER_EMAIL)==='admin-separado@crulox.invalid',
        passwordStoredAsHashOnly:OWNER_PASSWORD_SHA256.length===64,
        legacyAdminPersistenceRemoved:getJSON3718(OLD_ADMIN_PERSIST_KEY,null)===null,
        panelRequiresOwnerAttribute:true,
        menuItems:D.querySelectorAll('.jmv24-nav-item').length
      };
    }
  });
})();
</script>


<!-- CRULOX V3.7.21 · Corrección exclusiva: eliminar artículos del carrito + título Pedidos -->
<script id="cruzclick-v3721-cart-delete-fix">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.7.21';
  const cartRoot=D.getElementById('cartItems');

  function cartIdentity3721(key){
    const raw=String(key??'');
    try{
      if(typeof parseCartKey==='function'){
        const parsed=parseCartKey(raw);
        if(parsed&&parsed.id!==undefined&&parsed.id!==null){
          return {type:parsed.type==='combo'?'combo':'product',id:String(parsed.id)};
        }
      }
    }catch(e){}
    const marker=raw.indexOf('::');
    return marker>=0
      ? {type:raw.slice(0,marker)==='combo'?'combo':'product',id:raw.slice(marker+2)}
      : {type:'product',id:raw};
  }

  function removeCartItem3721(key){
    /* `state` es una constante léxica del sistema base y no necesariamente una propiedad de window. */
    if(typeof state==='undefined'||!Array.isArray(state.cart))return false;
    const target=cartIdentity3721(key);
    const before=state.cart.length;

    state.cart=state.cart.filter(item=>{
      const itemType=item?.type==='combo'?'combo':'product';
      return !(itemType===target.type&&String(item?.id??'')===target.id);
    });

    /* Respaldo para registros antiguos cuyo campo type no seguía el esquema product/combo. */
    if(state.cart.length===before&&target.id){
      state.cart=state.cart.filter(item=>String(item?.id??'')!==target.id);
    }

    if(state.cart.length===before)return false;
    try{write(KEYS.cart,state.cart)}catch(e){console.error('CRULOX: no se pudo guardar el carrito después de eliminar.',e)}
    try{if(typeof scheduleExpiry==='function')scheduleExpiry()}catch(e){}
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    try{if(typeof renderCart==='function')renderCart()}catch(e){console.error('CRULOX: no se pudo redibujar el carrito.',e)}
    try{
      if(window.CRUZCLICK_V3724?.syncProductCards)window.CRUZCLICK_V3724.syncProductCards();
      else if(typeof renderProducts==='function')renderProducts();
    }catch(e){}
    try{if(target.type==='combo'&&typeof renderCombos==='function')renderCombos()}catch(e){}
    return true;
  }

  /* Delegación en captura: el botón funciona aunque renderCart reemplace sus nodos internos. */
  if(cartRoot&&!cartRoot.dataset.ccDeleteFix3721){
    cartRoot.dataset.ccDeleteFix3721='1';
    cartRoot.addEventListener('click',event=>{
      const button=event.target?.closest?.('[data-remove-cart]');
      if(!button||!cartRoot.contains(button))return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const removed=removeCartItem3721(button.getAttribute('data-remove-cart'));
      if(removed){
        try{if(typeof toast==='function')toast('Producto eliminado del pedido.','success')}catch(e){}
      }
    },true);
  }

  function enforceTitle3721(){
    const title=D.querySelector('#cartPanel .panel-head h2');
    if(title&&title.textContent.trim()!=='🛒 Pedidos')title.textContent='🛒 Pedidos';
  }
  enforceTitle3721();
  const cartPanel=D.getElementById('cartPanel');
  if(cartPanel){
    new MutationObserver(enforceTitle3721).observe(cartPanel,{childList:true,subtree:true});
  }

  window.CRUZCLICK_V3721=Object.freeze({
    version:VERSION,
    removeCartItem:removeCartItem3721,
    selfTest(){
      return {
        version:VERSION,
        cartRootPresent:!!D.getElementById('cartItems'),
        deleteDelegationInstalled:D.getElementById('cartItems')?.dataset.ccDeleteFix3721==='1',
        title:D.querySelector('#cartPanel .panel-head h2')?.textContent||''
      };
    }
  });
})();
</script>



<!-- CRULOX V3.7.23 · Arranque inmediato y reducción de carga -->
<style id="cruzclick-v3723-performance-style">
#loader{display:none!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important}
</style>
<script id="cruzclick-v3723-performance-marker">
window.CRUZCLICK_V3723=Object.freeze({
  version:'3.7.23',
  focus:'instant-startup',
  blockingLoader:false,
  embeddedMedia:'recompressed-and-deduplicated',
  repeatedMigrations:'guarded',
  heavyMediaMigration:'idle'
});
</script>


<!-- CRULOX V3.7.24 · Interacción inmediata y fluidez táctil -->
<style id="cruzclick-v3724-instant-interaction-style">
/* Respuesta táctil inmediata sin cambiar el diseño aprobado. */
html{scroll-behavior:auto!important}
button,a,[role="button"],label[for],.cat,.tab,.icon-btn,.fav-btn,.float-btn,.suggestion,.social-pill{
  touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;
}
button,.btn,.icon-btn,.cat,.tab,.fav-btn,.float-btn,.suggestion,.social-pill{
  transition-duration:.08s!important;
  transition-delay:0s!important;
}
.drawer-overlay,.panel-overlay,.modal-overlay{transition:opacity .08s linear!important}
.drawer,.side-panel{transition:transform .10s cubic-bezier(.2,.8,.2,1)!important}
.suggestions{animation-duration:.08s!important}

/* El panel aparece de inmediato y la animación queda solo como acabado visual breve. */
.drawer.open,.side-panel.open,.modal-overlay.open,.admin-overlay.open{transition-delay:0s!important}

@media (hover:none),(pointer:coarse){
  body{background-attachment:scroll!important}
  .header,.drawer-overlay,.panel-overlay,.modal-overlay,.suggestions,.side-panel{
    -webkit-backdrop-filter:none!important;
    backdrop-filter:none!important;
  }
  .btn:hover,.icon-btn:hover,.product:hover,.fav-btn:hover,.cat:hover,.tab:hover{transform:none!important}
  .product:hover .product-image img{transform:scale(1.12)!important}
}
</style>
<script id="cruzclick-v3724-instant-interaction-script">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.7.24';
  const byId=id=>D.getElementById(id);
  const nextPaint=fn=>requestAnimationFrame(()=>{try{fn()}catch(error){console.error('CRULOX V3.7.24',error)}});

  /* Actualiza solo el estado visual que realmente cambia al reservar unidades.
     Evita reconstruir toda la cuadrícula de productos por cada toque. */
  function syncProductCards3724(){
    const cards=D.querySelectorAll('#productsGrid .product[data-product]');
    cards.forEach(card=>{
      const id=String(card.dataset.product||'');
      const product=(state?.products||[]).find(p=>String(p.id)===id);
      if(!product)return;
      const physical=Math.max(0,Number(product.stock||0));
      let effective=physical;
      try{if(typeof availableStock==='function')effective=Math.max(0,Number(availableStock(product.id)||0))}catch(e){}
      let info=['Disponible',''];
      try{if(typeof stockInfo==='function'){const result=stockInfo(product);if(Array.isArray(result))info=result}}catch(e){}
      const unavailable=effective<=0;
      card.classList.toggle('np-physical-out',physical<=0);
      card.classList.toggle('np-reserved-out',physical>0&&unavailable);

      const stock=card.querySelector('.stock');
      if(stock){stock.textContent=String(info[0]||'Disponible');stock.className=`stock ${String(info[1]||'')}`.trim()}

      const add=card.querySelector('[data-add]');
      if(add){add.disabled=unavailable;add.textContent=unavailable?'No disponible':'Añadir'}

      const autoBadge=physical<=0?'SIN STOCK':unavailable?'FUERA DE STOCK':'';
      let badge=card.querySelector('.badge');
      if(autoBadge){
        if(!badge){badge=D.createElement('span');card.querySelector('.product-image')?.prepend(badge)}
        badge.className=`badge np-stock-badge${physical<=0?' physical':''}`;
        badge.textContent=autoBadge;
      }else if(product.badgeText){
        if(!badge){badge=D.createElement('span');card.querySelector('.product-image')?.prepend(badge)}
        badge.className='badge';badge.textContent=String(product.badgeText);
      }else if(badge){badge.remove()}
    });
  }

  /* Sustituye el refresco pesado del comercio: cabecera + tarjetas afectadas + carrito.
     Las funciones de carrito existentes siguen siendo las mismas. */
  const baseRefreshCommerce3724=typeof window.refreshCommerceViews==='function'?window.refreshCommerceViews:null;
  function fastRefreshCommerce3724(){
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    syncProductCards3724();
    try{if(typeof renderCart==='function'&&byId('cartItems'))renderCart()}catch(e){
      if(baseRefreshCommerce3724)baseRefreshCommerce3724();
    }
  }
  try{window.refreshCommerceViews=fastRefreshCommerce3724;refreshCommerceViews=fastRefreshCommerce3724}catch(e){}

  /* Favoritos: cambia solo el corazón tocado, en vez de redibujar todo el catálogo. */
  const baseToggleFavorite3724=typeof window.toggleFavorite==='function'?window.toggleFavorite:null;
  function fastToggleFavorite3724(id){
    try{
      const key=String(id);
      const current=Array.isArray(state.favorites)?state.favorites:[];
      const exists=current.some(x=>String(x)===key);
      state.favorites=exists?current.filter(x=>String(x)!==key):[...current,id];
      if(typeof write==='function')write(KEYS.favorites,state.favorites);
      if(typeof renderHeader==='function')renderHeader();
      const active=!exists;
      D.querySelectorAll('[data-fav]').forEach(btn=>{
        if(String(btn.dataset.fav)!==key)return;
        btn.classList.toggle('active',active);
        btn.textContent=active?'♥':'♡';
      });
      const detailFav=byId('detailFav');
      if(detailFav&&byId('detailModal')?.classList.contains('open'))detailFav.textContent=active?'Quitar favorito':'Guardar favorito';
      if(byId('favPanel')?.classList.contains('open')&&typeof renderFavorites==='function')nextPaint(renderFavorites);
      return active;
    }catch(error){
      console.error('CRULOX V3.7.24 favoritos',error);
      return baseToggleFavorite3724?baseToggleFavorite3724(id):false;
    }
  }
  if(baseToggleFavorite3724){try{window.toggleFavorite=fastToggleFavorite3724;toggleFavorite=fastToggleFavorite3724}catch(e){}}

  /* Los paneles visibles se abren primero; su contenido se refresca en el frame siguiente.
     Esto hace que el toque tenga respuesta visual inmediata incluso en teléfonos modestos. */
  function wireInstantPanel3724(buttonId,panelId,overlayId,renderer){
    const button=byId(buttonId);if(!button)return;
    button.onclick=()=>{
      try{if(typeof openPanel==='function')openPanel(panelId,overlayId)}catch(e){}
      if(typeof renderer==='function')nextPaint(renderer);
    };
  }
  wireInstantPanel3724('cartBtn','cartPanel','cartOverlay',()=>typeof renderCart==='function'&&renderCart());
  wireInstantPanel3724('favBtn','favPanel','favOverlay',()=>typeof renderFavorites==='function'&&renderFavorites());
  wireInstantPanel3724('drawerCart','cartPanel','cartOverlay',()=>typeof renderCart==='function'&&renderCart());
  wireInstantPanel3724('drawerFavorites','favPanel','favOverlay',()=>typeof renderFavorites==='function'&&renderFavorites());

  /* El menú ya no espera trabajo secundario antes de mostrarse. */
  const menu=byId('menuBtn');
  if(menu)menu.onclick=()=>{try{openPanel('drawer','drawerOverlay')}catch(e){}};

  /* Evita el trabajo de búsqueda mientras el usuario sigue escribiendo sin volverla lenta. */
  const search=byId('searchInput');
  if(search){
    let timer=0;
    search.oninput=()=>{
      state.query=search.value.trim();
      byId('searchClear')?.classList.toggle('show',!!state.query);
      clearTimeout(timer);
      timer=setTimeout(()=>{
        try{if(typeof renderProducts==='function')renderProducts()}catch(e){}
        try{if(typeof renderSuggestions==='function')renderSuggestions()}catch(e){}
      },35);
    };
  }

  /* Precalienta las capas visuales cuando el navegador está libre, sin bloquear el arranque. */
  const warm=()=>{
    ['drawer','cartPanel','favPanel','accountModal','detailModal','checkoutModal'].forEach(id=>{
      const el=byId(id);if(el)el.style.willChange=id.includes('Modal')?'opacity':'transform';
    });
  };
  if('requestIdleCallback' in window)requestIdleCallback(warm,{timeout:1200});else setTimeout(warm,350);

  window.CRUZCLICK_V3724=Object.freeze({
    version:VERSION,
    focus:'instant-interaction',
    syncProductCards:syncProductCards3724,
    syncStore:fastRefreshCommerce3724,
    selfTest(){return{
      version:VERSION,
      touchManipulation:true,
      fastCommerceRefresh:window.refreshCommerceViews===fastRefreshCommerce3724,
      fastFavorites:window.toggleFavorite===fastToggleFavorite3724,
      cartButton:!!byId('cartBtn'),
      menuButton:!!byId('menuBtn')
    }}
  });
})();
</script>


<!-- CRULOX V3.8.0 · Auditoría integral de interacción, estabilidad y fluidez -->
<style id="cruzclick-v380-stability-performance-style">
/* Render diferido de contenido fuera de pantalla: conserva el diseño, reduce trabajo inicial. */
#catalog,#combos,#how,#faq,.footer{
  content-visibility:auto;
  contain-intrinsic-size:auto 720px;
}
.product,.combo,.step,.faq,.benefit{contain:layout paint style;}

/* No mantener capas GPU permanentemente. Se promocionan solo mientras están visibles. */
.drawer,.side-panel,.modal-overlay{will-change:auto!important;}
.drawer.open,.side-panel.open{will-change:transform!important;}
.modal-overlay.open{will-change:opacity!important;}

/* Scroll y toque directos. */
html,body{scroll-behavior:auto!important;}
body{-webkit-overflow-scrolling:touch;}
button,a,[role="button"],input,select,textarea{touch-action:manipulation;}

/* Respuesta visual inmediata al toque sin animaciones largas. */
button:active,.btn:active,.icon-btn:active,.cat:active,.tab:active{transition:none!important;}
@media (hover:none),(pointer:coarse){
  .product,.combo,.benefit,.step,.faq{box-shadow:none!important;}
}
</style>
<script id="cruzclick-v380-stability-performance-script">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.8.0';
  const $=id=>D.getElementById(id);
  const frame=fn=>requestAnimationFrame(()=>{try{fn()}catch(error){console.error('CRULOX V3.8.0',error)}});

  /* Perfil: abrir primero, renderizar después. El panel admin autenticado conserva su guard existente. */
  function fastAccount(button){
    if(!button||button.dataset.cc380FastAccount==='1')return;
    button.dataset.cc380FastAccount='1';
    button.onclick=(event)=>{
      let isAdmin=false;
      try{isAdmin=state?.session?.role==='admin'}catch(e){}
      if(isAdmin){try{if(typeof openAdmin==='function')return openAdmin('home')}catch(e){} }
      try{if(typeof closeAllPanels==='function')closeAllPanels()}catch(e){}
      try{if(typeof openModal==='function')openModal('accountModal');else $('accountModal')?.classList.add('open')}catch(e){}
      frame(()=>{try{if(typeof renderAccount==='function')renderAccount()}catch(e){}});
    };
  }
  fastAccount($('profileBtn'));
  fastAccount($('drawerProfile'));
  const footerProfile=$('footerProfile');
  if(footerProfile)fastAccount(footerProfile);

  /* Notificaciones: mostrar el panel antes del refresco secundario. */
  const notification=$('notificationBtn');
  if(notification){
    const oldNotification=notification.onclick;
    notification.onclick=(event)=>{
      const panel=$('notificationPanel'),overlay=$('notificationOverlay');
      if(overlay)overlay.classList.add('open');
      if(panel)panel.classList.add('open');
      if(panel||overlay)D.body.classList.add('lock');
      if(typeof oldNotification==='function')frame(()=>oldNotification.call(notification,event));
    };
  }

  /* Mis compras: respuesta visual inmediata; el contenido se compone en el siguiente frame. */
  function wirePurchases(){
    const button=$('jmMyPurchasesBtn');if(!button||button.dataset.cc380FastPurchases==='1')return;
    button.dataset.cc380FastPurchases='1';
    button.onclick=()=>{
      let user=null;try{if(typeof currentUser==='function')user=currentUser()}catch(e){}
      if(!user){
        try{if(typeof openModal==='function')openModal('accountModal')}catch(e){}
        frame(()=>{try{if(typeof renderAccount==='function')renderAccount()}catch(e){};try{if(typeof toast==='function')toast('Inicia sesión para ver tus compras confirmadas.','warn')}catch(e){}});
        return;
      }
      try{if(typeof ensurePublicPurchasesUi356==='function')ensurePublicPurchasesUi356()}catch(e){}
      const overlay=$('jmMyPurchasesOverlay');if(overlay)overlay.classList.add('open');D.body.classList.add('lock');
      frame(()=>{try{if(typeof renderMyPurchases356==='function')renderMyPurchases356();else if(typeof openMyPurchases356==='function')openMyPurchases356()}catch(e){}});
    };
  }
  wirePurchases();

  /* Elementos que se crean dinámicamente quedan enlazados una sola vez y de forma agrupada. */
  let bindFrame=0;
  const bindDynamic=()=>{
    if(bindFrame)return;
    bindFrame=requestAnimationFrame(()=>{bindFrame=0;wirePurchases();fastAccount($('profileBtn'));fastAccount($('drawerProfile'));});
  };
  const bindObserver=new MutationObserver(records=>{
    if(records.some(r=>r.addedNodes&&r.addedNodes.length))bindDynamic();
  });
  if(D.body)bindObserver.observe(D.body,{childList:true,subtree:false});

  /* Imágenes no críticas: decodificación asíncrona y lazy loading, sin tocar marca/hero visible. */
  function tuneImages(root=D){
    root.querySelectorAll?.('img').forEach(img=>{
      img.decoding='async';
      if(!img.closest('.header,.hero')&&!img.classList.contains('loader-logo'))img.loading='lazy';
    });
  }
  if('requestIdleCallback' in window)requestIdleCallback(()=>tuneImages(),{timeout:900});else setTimeout(()=>tuneImages(),180);

  /* Limpia la promoción GPU introducida por versiones anteriores cuando el control vuelve a reposo. */
  setTimeout(()=>{['drawer','cartPanel','favPanel','accountModal','detailModal','checkoutModal'].forEach(id=>{const el=$(id);if(el&&!el.classList.contains('open'))el.style.willChange='auto'})},1400);

  window.CRUZCLICK_V380=Object.freeze({
    version:VERSION,
    focus:'integral-stability-and-fluidity',
    selfTest(){
      const result={version:VERSION};
      result.menu=!!$('menuBtn');
      result.profile=!!$('profileBtn');
      result.cart=!!$('cartBtn');
      result.favorites=!!$('favBtn');
      result.notifications=!!$('notificationBtn');
      result.search=!!$('searchInput');
      result.products=D.querySelectorAll('#productsGrid .product').length;
      result.nonBlockingTouchMove=true;
      result.dynamicPurchases=!!$('jmMyPurchasesBtn');
      return result;
    }
  });
})();
</script>



<!-- CRULOX V3.8.1 · Auditoría funcional final: clic único, Free Fire y carrito -->
<style id="cruzclick-v381-final-audit-style">
/* Mantiene la respuesta al toque en el camino crítico sin alterar el diseño aprobado. */
#productsGrid button,#cartItems button,.header button,.drawer button,.drawer a,
#detailModal button,#accountModal button,#checkoutModal button,#jmv21VariantModal button{
  touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;
}
</style>
<script id="cruzclick-v381-final-audit-script">
(()=>{
  'use strict';
  const D=document;
  const VERSION='3.8.1';
  const byId=id=>D.getElementById(id);
  const norm=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();

  /*
   * Free Fire: cualquier botón Agregar de un producto de diamantes abre el selector
   * unificado que ya contiene el ID obligatorio y las cantidades. Se usa captura para
   * impedir que una capa heredada agregue una unidad directamente al carrito.
   */
  function isFreeFireProduct381(product){
    if(!product)return false;
    const text=norm([product.id,product.name,product.category,product.platform,product.digitalType,product.digitalKind].join(' '));
    return text.includes('free fire')&&(text.includes('diamante')||text.includes('recarga')||String(product.id||'').toLowerCase().startsWith('ff-'));
  }
  function product381(id){
    try{return (state.products||[]).find(p=>String(p.id)===String(id))||null}catch(e){return null}
  }
  function openFreeFire381(){
    try{
      const api=window.JM_DIGITAL_STORE_V22;
      if(api&&typeof api.openVariantChooser==='function'){
        api.openVariantChooser('recharge:free fire');
        return !!byId('jmv21VariantModal')?.classList.contains('open');
      }
    }catch(error){console.error('CRULOX V3.8.1 Free Fire',error)}
    return false;
  }
  /* Navegación lateral: el panel se retira en el mismo toque; el ancla conserva su salto nativo. */
  D.addEventListener('click',event=>{
    const link=event.target?.closest?.('#drawer a[href^="#"]');
    if(!link)return;
    try{
      byId('drawer')?.classList.remove('open');
      byId('drawerOverlay')?.classList.remove('open');
      D.body.classList.remove('lock');
    }catch(e){}
  },true);

  D.addEventListener('click',event=>{
    const button=event.target?.closest?.('#productsGrid [data-add]');
    if(!button)return;
    const p=product381(button.dataset.add);
    if(!isFreeFireProduct381(p))return;
    event.preventDefault();
    event.stopImmediatePropagation();
    openFreeFire381();
  },true);

  /*
   * Eliminación robusta del carrito. La capa V3.7.21 es la fuente de verdad y aquí se
   * comprueba que esté disponible; si no, se aplica un respaldo que entiende claves
   * product::id, combo::id y registros heredados con id directo.
   */
  function splitCartKey381(key){
    const raw=String(key??'');
    const marker=raw.indexOf('::');
    if(marker>=0)return {type:raw.slice(0,marker)==='combo'?'combo':'product',id:raw.slice(marker+2)};
    return {type:'product',id:raw};
  }
  function removeFallback381(key){
    if(typeof state==='undefined'||!Array.isArray(state.cart))return false;
    const target=splitCartKey381(key),before=state.cart.length;
    state.cart=state.cart.filter(item=>{
      const type=item?.type==='combo'?'combo':'product';
      return !(type===target.type&&String(item?.id??'')===target.id);
    });
    if(state.cart.length===before&&target.id){
      state.cart=state.cart.filter(item=>String(item?.id??'')!==target.id);
    }
    if(state.cart.length===before)return false;
    try{if(typeof write==='function')write(KEYS.cart,state.cart)}catch(e){}
    try{if(typeof scheduleExpiry==='function')scheduleExpiry()}catch(e){}
    try{if(typeof renderHeader==='function')renderHeader()}catch(e){}
    try{if(typeof renderCart==='function')renderCart()}catch(e){}
    try{window.CRUZCLICK_V3724?.syncProductCards?.()}catch(e){}
    return true;
  }
  function remove381(key){
    try{
      if(window.CRUZCLICK_V3721&&typeof window.CRUZCLICK_V3721.removeCartItem==='function'){
        const ok=window.CRUZCLICK_V3721.removeCartItem(key);
        if(ok)return true;
      }
    }catch(error){console.error('CRULOX V3.8.1 carrito',error)}
    return removeFallback381(key);
  }
  const cartItems=byId('cartItems');
  if(cartItems&&!cartItems.dataset.cc381DeleteGuard){
    cartItems.dataset.cc381DeleteGuard='1';
    cartItems.addEventListener('click',event=>{
      const button=event.target?.closest?.('[data-remove-cart]');
      if(!button||!cartItems.contains(button))return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const removed=remove381(button.getAttribute('data-remove-cart'));
      if(removed){try{typeof toast==='function'&&toast('Producto eliminado del pedido.','success')}catch(e){}}
    },true);
  }

  /*
   * Administración: delegación en captura para que "Tienda" y "Salir" conserven
   * exactamente la semántica aprobada aunque una capa visual reconstruya el panel.
   * Tienda cierra solo el panel; Salir termina la sesión propietaria.
   */
  /* Perfil propietario: reabre siempre por la ruta segura V3.7.18, conservando la sesión. */
  function secureProfile381(button){
    if(!button)return;
    button.onclick=()=>{
      let owner=false;
      try{owner=typeof window.CRUZCLICK_V3718?.ownerSession==='function'&&window.CRUZCLICK_V3718.ownerSession()}catch(e){}
      if(owner){
        try{return window.CRUZCLICK_V3718.openAdmin('home')}catch(error){console.error('CRULOX V3.8.1 perfil propietario',error)}
      }
      try{if(typeof closeAllPanels==='function')closeAllPanels()}catch(e){}
      try{if(typeof renderAccount==='function')renderAccount()}catch(e){}
      try{if(typeof openModal==='function')openModal('accountModal');else byId('accountModal')?.classList.add('open')}catch(e){}
    };
  }
  secureProfile381(byId('profileBtn'));
  secureProfile381(byId('drawerProfile'));
  secureProfile381(byId('footerProfile'));
  /* Capacidad de último recurso: las capas heredadas pueden reasignar onclick después de cargar.
     En captura, una sesión propietaria siempre toma la ruta autenticada antes que esos manejadores. */
  D.addEventListener('click',event=>{
    const target=event.target?.closest?.('#profileBtn,#drawerProfile,#footerProfile');
    if(!target)return;
    let owner=false;
    try{owner=typeof window.CRUZCLICK_V3718?.ownerSession==='function'&&window.CRUZCLICK_V3718.ownerSession()}catch(e){}
    if(!owner)return;
    event.preventDefault();
    event.stopImmediatePropagation();
    try{window.CRUZCLICK_V3718.openAdmin('home')}catch(error){console.error('CRULOX V3.8.1 apertura administrativa',error)}
  },true);

  const adminOverlay381=byId('adminOverlay');
  if(adminOverlay381&&!adminOverlay381.dataset.cc381OwnerControls){
    adminOverlay381.dataset.cc381OwnerControls='1';
    adminOverlay381.addEventListener('click',event=>{
      const target=event.target?.closest?.('#adminStoreBtn,#cc378Store,#adminLogout,#cc378Logout');
      if(!target||!adminOverlay381.contains(target))return;
      const isLogout=target.matches('#adminLogout,#cc378Logout');
      event.preventDefault();
      event.stopImmediatePropagation();
      try{
        if(isLogout&&typeof window.CRUZCLICK_V3718?.logoutAdmin==='function')window.CRUZCLICK_V3718.logoutAdmin();
        else if(!isLogout&&typeof window.CRUZCLICK_V3718?.closeAdmin==='function')window.CRUZCLICK_V3718.closeAdmin();
        else {
          if(isLogout&&typeof state!=='undefined')state.session=null;
          adminOverlay381.classList.remove('open');
          D.body.classList.remove('lock');
          if(isLogout&&typeof write==='function'&&typeof KEYS!=='undefined')write(KEYS.session,null);
          if(typeof renderHeader==='function')renderHeader();
        }
      }catch(error){console.error('CRULOX V3.8.1 controles administrativos',error)}
    },true);
  }

  /* Autodiagnóstico no invasivo para verificar que las rutas esenciales siguen disponibles. */
  function selfTest381(){
    const result={version:VERSION};
    result.runtime={
      state:typeof state!=='undefined',
      products:Array.isArray(typeof state!=='undefined'?state.products:null),
      cart:Array.isArray(typeof state!=='undefined'?state.cart:null)
    };
    result.controls={
      menu:!!byId('menuBtn'),profile:!!byId('profileBtn'),notifications:!!byId('notificationBtn'),
      cart:!!byId('cartBtn'),favorites:!!byId('favBtn'),search:!!byId('searchInput')
    };
    result.modals={account:!!byId('accountModal'),detail:!!byId('detailModal'),checkout:!!byId('checkoutModal')};
    result.freeFire={
      products:(typeof state!=='undefined'&&Array.isArray(state.products))?state.products.filter(isFreeFireProduct381).length:0,
      selectorApi:typeof window.JM_DIGITAL_STORE_V22?.openVariantChooser==='function'
    };
    result.cartDelete=!!byId('cartItems')?.dataset.cc381DeleteGuard;
    result.adminControls=!!byId('adminOverlay')?.dataset.cc381OwnerControls;
    result.touchMoveBlocking=false;
    return result;
  }
  window.CRUZCLICK_V381=Object.freeze({version:VERSION,selfTest:selfTest381,openFreeFire:openFreeFire381,removeCartItem:remove381});
})();
</script>


<!-- CRULOX V3.8.2 · Disponibilidad junto a la etiqueta de categoría -->
<style id="cruzclick-v382-detail-badges-inline">
