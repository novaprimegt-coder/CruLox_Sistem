}
#adminOverlay #npV122MessagesQuick:hover{
  border-color:rgba(30,218,255,.38)!important;
  background:linear-gradient(135deg,rgba(18,214,244,.2),rgba(31,133,255,.18))!important;
}
#adminOverlay #npV122MessagesQuick.active{
  color:#04111d!important;
