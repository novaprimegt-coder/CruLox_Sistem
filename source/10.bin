#adminOverlay .np-v123-message{max-width:82%;padding:8px 10px;border-radius:13px}.np-v123-message.client{align-self:flex-start;background:#0a2032;border:1px solid rgba(126,203,255,.08)}.np-v123-message.staff{align-self:flex-end;background:linear-gradient(135deg,#12cfea,#168ff4);color:#03111c}.np-v123-message.system{align-self:center;max-width:92%;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.045);color:#839bb1;text-align:center}.np-v123-message b{display:block;font-size:.43rem;margin-bottom:3px}.np-v123-message p{margin:0!important;font-size:.54rem!important;line-height:1.42!important;white-space:pre-wrap;overflow-wrap:anywhere}.np-v123-message time{display:block;margin-top:4px;text-align:right;font-size:.38rem;opacity:.62}
#adminOverlay .np-v123-compose{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;padding:8px;border-top:1px solid rgba(126,203,255,.07);background:#071725}.np-v123-compose textarea{min-height:42px;max-height:110px;resize:none;border:1px solid rgba(126,203,255,.1);border-radius:11px;background:#081a29;color:#e9f6ff;padding:8px 9px;font-size:.53rem;outline:none}.np-v123-compose button{min-width:64px;border:0;border-radius:11px;background:linear-gradient(135deg,#16daf4,#198ff8);color:#04111d;font-size:.5rem;font-weight:950}.np-v123-compose.locked{grid-template-columns:1fr}.np-v123-compose.locked div{padding:9px;border-radius:10px;background:rgba(255,170,55,.045);border:1px solid rgba(255,180,70,.1);color:#d4b372;font-size:.49rem;text-align:center}
#adminOverlay .np-v123-status{display:inline-flex;margin-left:5px;padding:3px 6px;border-radius:999px;font-size:.38rem;font-weight:900;background:#0a2032;color:#82dfff}.np-v123-status.wait{color:#ffd16a}.np-v123-status.closed{color:#a0afbd}
@media(max-width:760px){#adminOverlay .np-v123-layout{grid-template-columns:1fr;min-height:0}#adminOverlay .np-v123-list{max-height:300px}#adminOverlay .np-v123-chat-pane{min-height:480px}#adminOverlay .np-v123-context{grid-template-columns:1fr 1fr}#adminOverlay .np-v123-kpis{grid-template-columns:1fr 1fr}}
@media(max-width:480px){#adminOverlay .np-v123-head{padding:10px}.np-v123-head p{display:none}#adminOverlay .np-v123-chat-head{grid-template-columns:1fr}.np-v123-actions{justify-content:flex-start}#adminOverlay .np-v123-filter-row{grid-template-columns:1fr 1fr}#adminOverlay .np-v123-chat-row{grid-template-columns:31px minmax(0,1fr) auto;padding:7px}.np-v123-row-icon{width:31px;height:31px}.np-v123-context{grid-template-columns:1fr 1fr!important}}
</style>
<script id="np-v123-attention-safe-script">
(function(){
  const VERSION='11.15';
  const CHAT_KEY='jm_digital_v1_support_chats';
  const INACTIVITY_MS=10*60*1000;
  const LIFETIME_MS=24*60*60*1000;
  const POLL_MS=6500;
  const team=window.NP_TEAM_API_V105||null;
  const $=id=>document.getElementById(id);
  const escHtml=v=>typeof window.esc==='function'?window.esc(String(v??'')):String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const norm=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const isoNow=()=>new Date().toISOString();
  const uid=(p='id')=>`${p}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
  let selectedId='';
  let poll=0;
  let filterState={q:'',status:'open',priority:'all'};

  function readRaw(){try{const raw=localStorage.getItem(CHAT_KEY)||'[]';const arr=JSON.parse(raw);return Array.isArray(arr)?arr:[]}catch(e){console.warn('NovaPrime Atención: almacenamiento inválido',e);return[]}}
  function saveRaw(arr){try{localStorage.setItem(CHAT_KEY,JSON.stringify(arr));return true}catch(e){console.warn('NovaPrime Atención: no se pudo guardar',e);return false}}
  function parseMs(v,f=0){const n=Date.parse(v||'');return Number.isFinite(n)?n:f}
  function agentList(){try{return Array.isArray(team?.agents?.())?team.agents().filter(a=>a&&a.active!==false):[]}catch(e){return[]}}
  function supportAgents(){const all=agentList(),preferred=all.filter(a=>a.preset==='support'||/(atencion|soporte|cliente|servicio)/.test(norm(a.area)));return preferred.length?preferred:all.filter(a=>a.preset==='supervisor')}
  function agentById(id){if(String(id)==='owner')return{id:'owner',name:'Administrador CRULOX',area:'Administración',active:true};try{return team?.agentById?.(id)||agentList().find(a=>String(a.id)===String(id))||null}catch(e){return null}}
  function currentStaff(){if(state?.session?.role==='agent'){try{return team?.sessionAgent?.()||null}catch(e){return null}}if(state?.session?.role==='admin')return{id:'owner',name:'Administrador CRULOX',area:'Administración',active:true};return null}
  function isAdmin(){return state?.session?.role==='admin'}
  function isAgent(){if(state?.session?.role!=='agent')return false;const me=currentStaff();if(!me||me.active===false)return false;try{return !!team?.canUseSection?.('bots')}catch(e){return false}}
  function createdMs(c){return parseMs(c?.createdAt,parseMs(c?.updatedAt,Date.now()))}
  function lastActivityMs(c){let last=Math.max(createdMs(c),parseMs(c?.updatedAt,0));for(const m of Array.isArray(c?.messages)?c.messages:[])last=Math.max(last,parseMs(m?.at,0));return last||Date.now()}
  function addSystem(c,text,kind){c.messages=Array.isArray(c.messages)?c.messages:[];if(kind&&c.messages.some(m=>m?.consistencyKind===kind||m?.lifecycleKind===kind))return;c.messages.push({id:uid('sys'),role:'system',senderId:'system',senderName:'CRULOX',text,at:isoNow(),readByClient:false,readByStaff:true,consistencyKind:kind||''})}
  function profileForClientId(clientId){if(!String(clientId).startsWith('user:')||!Array.isArray(state?.users))return null;const id=String(clientId).slice(5);return state.users.find(u=>String(u.id)===id)||null}

  function normalizeChats({persist=true}={}){
    try{window.NP_V120_CHAT_LIFECYCLE?.runLifecycle?.()}catch(e){}
    const original=readRaw(),now=Date.now(),activeAgents=new Set(agentList().map(a=>String(a.id))),next=[];
    for(const source of original){
      if(!source||typeof source!=='object')continue;
      const c={...source};
      c.id=String(c.id||uid('chat'));
      c.clientId=String(c.clientId||`unknown:${c.id}`);
      c.createdAt=Number.isFinite(parseMs(c.createdAt,NaN))?c.createdAt:(c.updatedAt||isoNow());
      c.updatedAt=Number.isFinite(parseMs(c.updatedAt,NaN))?c.updatedAt:c.createdAt;
      if(now-createdMs(c)>=LIFETIME_MS)continue;
      c.messages=(Array.isArray(c.messages)?c.messages:[]).filter(m=>m&&typeof m==='object').map(m=>({...m,id:String(m.id||uid('msg')),role:['client','staff','system'].includes(m.role)?m.role:'system',senderName:String(m.senderName||''),text:String(m.text||''),at:Number.isFinite(parseMs(m.at,NaN))?m.at:c.createdAt})).sort((a,b)=>parseMs(a.at,0)-parseMs(b.at,0));
      const profile=profileForClientId(c.clientId);
      if(profile){c.customerName=profile.fullName||profile.username||c.customerName||'Cliente';c.customerEmail=profile.email||c.customerEmail||'';c.customerPhone=profile.phone||c.customerPhone||''}
      c.customerName=String(c.customerName||'Cliente');c.customerEmail=String(c.customerEmail||'');c.customerPhone=String(c.customerPhone||'');c.subject=String(c.subject||'Consulta general');c.context=(c.context&&typeof c.context==='object')?c.context:{};c.priority=c.priority==='high'?'high':'normal';c.assignedAgentId=String(c.assignedAgentId||'');
      if(c.assignedAgentId&&c.assignedAgentId!=='owner'&&!activeAgents.has(c.assignedAgentId)){c.assignedAgentId='';if(c.status!=='closed')addSystem(c,'El agente anterior ya no está disponible. La conversación volvió a la bandeja de espera.','agent-unavailable')}
      if(c.lifecycleLocked)c.status='closed';
      if(c.status!=='closed')c.status=c.assignedAgentId?'active':'waiting';
      if(c.status!=='closed'&&now-lastActivityMs(c)>=INACTIVITY_MS){c.status='closed';c.autoClosed=true;c.closedReason='inactive';c.closedAt=isoNow();c.lifecycleLocked=true;addSystem(c,'Conversación cerrada por 10 min de inactividad.','inactive-close')}
      next.push(c);
    }
    const byClient=new Map();
    for(const c of next.filter(x=>x.status!=='closed').sort((a,b)=>lastActivityMs(b)-lastActivityMs(a))){if(!byClient.has(c.clientId)){byClient.set(c.clientId,c.id);continue}c.status='closed';c.closedReason='duplicate-open';c.closedAt=isoNow();c.lifecycleLocked=true;addSystem(c,'Conversación cerrada porque ya existe una conversación más reciente activa.','duplicate-open')}
    next.sort((a,b)=>lastActivityMs(b)-lastActivityMs(a));
    if(persist&&JSON.stringify(original)!==JSON.stringify(next))saveRaw(next);
    return next;
  }

  function canSee(c){if(isAdmin())return true;const me=currentStaff();if(!me)return false;if(c.status!=='closed'&&!c.assignedAgentId)return true;return String(c.assignedAgentId)===String(me.id)}
  function canHandle(c){if(!c||c.status==='closed')return false;if(isAdmin())return true;const me=currentStaff();return !!me&&(!c.assignedAgentId||String(c.assignedAgentId)===String(me.id))}
  function visibleChats(){return normalizeChats().filter(canSee)}
  function getChat(id){return normalizeChats().find(c=>String(c.id)===String(id))||null}
  function unread(c){return (c.messages||[]).filter(m=>m.role==='client'&&!m.readByStaff).length}
  function markRead(id){const all=normalizeChats(),i=all.findIndex(c=>c.id===id);if(i<0||!canSee(all[i]))return false;let changed=false;for(const m of all[i].messages||[]){if(m.role==='client'&&!m.readByStaff){m.readByStaff=true;changed=true}}if(changed)saveRaw(all);return changed}
  function mutate(id,fn,{requireHandle=false,allowClosed=false}={}){const all=normalizeChats(),i=all.findIndex(c=>c.id===id);if(i<0)return null;const c=all[i];if(!canSee(c))return null;if(requireHandle&&!canHandle(c))return null;if(c.lifecycleLocked&&!allowClosed)return null;fn(c,all);c.updatedAt=isoNow();saveRaw(all);return c}
  function timeText(v){try{return new Date(v).toLocaleTimeString('es-GT',{hour:'2-digit',minute:'2-digit'})}catch(e){return''}}
  function dateText(v){try{return new Date(v).toLocaleString('es-GT',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}catch(e){return''}}
  function contextLabel(c){return String(c.context?.Producto||c.context?.Combo||c.context?.Tipo||c.subject||'Consulta general')}
  function messageSearchText(c){return (c.messages||[]).map(m=>`${m.senderName||''} ${m.text||''}`).join(' ')}
  function statusText(c){if(c.status==='closed')return c.lifecycleLocked?'Cerrado automático':'Finalizado';if(c.assignedAgentId)return'En atención';return'En espera'}
  function statusClass(c){if(c.status==='closed')return'closed';if(c.assignedAgentId)return'active';return'wait'}
  function closeReason(c){if(c.lifecycleLocked&&c.closedReason==='inactive')return'Cerrado automáticamente por 10 minutos de inactividad.';if(c.lifecycleLocked)return'Chat cerrado definitivamente por regla del sistema.';return'Conversación finalizada manualmente por el equipo.'}

  function filtered(){
    let list=visibleChats();const q=norm(filterState.q),me=currentStaff();
    if(q)list=list.filter(c=>norm(`${c.id} ${c.customerName} ${c.customerEmail} ${c.customerPhone} ${c.subject} ${contextLabel(c)} ${agentById(c.assignedAgentId)?.name||''} ${messageSearchText(c)}`).includes(q));
    if(filterState.status==='open')list=list.filter(c=>c.status!=='closed');
    else if(filterState.status==='waiting')list=list.filter(c=>c.status==='waiting'&&!c.assignedAgentId);
    else if(filterState.status==='assigned')list=list.filter(c=>c.status==='active'&&!!c.assignedAgentId);
    else if(filterState.status==='unread')list=list.filter(c=>c.status!=='closed'&&unread(c)>0);
    else if(filterState.status==='mine')list=list.filter(c=>c.status!=='closed'&&String(c.assignedAgentId)===String(me?.id));
    else if(filterState.status==='closed')list=list.filter(c=>c.status==='closed');
    if(filterState.priority!=='all')list=list.filter(c=>c.priority===filterState.priority);
    return list.sort((a,b)=>lastActivityMs(b)-lastActivityMs(a));
  }
  function counts(list=visibleChats()){return{waiting:list.filter(c=>c.status==='waiting'&&!c.assignedAgentId).length,active:list.filter(c=>c.status==='active'&&!!c.assignedAgentId).length,unread:list.filter(c=>c.status!=='closed').reduce((n,c)=>n+unread(c),0),closed:list.filter(c=>c.status==='closed').length}}
  function emptyPanel(){return '<div class="np-v124-empty-panel"><div class="np-v124-empty-icon">💬</div><h3>Selecciona una conversación</h3><p>Abre un chat para revisar el contexto, asignar responsable y responder sin mezclar historiales.</p><div class="np-v124-empty-steps"><span><b>1</b> Revisar</span><span><b>2</b> Asignar</span><span><b>3</b> Responder</span><span><b>4</b> Finalizar</span></div></div>'}
  function listEmptyMarkup(){const all=visibleChats(),closed=all.filter(c=>c.status==='closed').length;if(filterState.status==='open'&&closed>0)return `<div class="np-v124-list-empty"><span>✓</span><b>No hay conversaciones abiertas</b><p>La bandeja operativa está al día.</p><button type="button" data-v124-show-closed>Ver historial (${closed})</button></div>`;return '<div class="np-v124-list-empty"><span>✓</span><b>Sin conversaciones</b><p>No hay chats que coincidan con este filtro.</p></div>'}
  function listMarkup(){const list=filtered();if(!list.length)return listEmptyMarkup();return list.map(c=>{const a=agentById(c.assignedAgentId),last=(c.messages||[]).slice(-1)[0],n=unread(c),ctx=contextLabel(c);return `<button type="button" class="np-v124-chat-row ${selectedId===c.id?'active':''}" data-v124-chat="${escHtml(c.id)}"><span class="np-v124-row-icon ${statusClass(c)}">${c.status==='closed'?'✓':c.assignedAgentId?'💬':'⏳'}</span><span class="np-v124-row-main"><span class="np-v124-row-title"><b>${escHtml(c.customerName)}</b>${c.priority==='high'?'<em>ALTA</em>':''}</span><small>${escHtml(ctx)}</small><p>${escHtml(last?.text||c.subject)}</p></span><aside><time>${escHtml(timeText(c.updatedAt))}</time><span class="np-v124-row-state ${statusClass(c)}">${escHtml(a?.name||statusText(c))}</span>${n?`<i>${n}</i>`:''}</aside></button>`}).join('')}
  function threadMarkup(c){return (c.messages||[]).map(m=>`<article class="np-v124-message ${m.role==='client'?'client':m.role==='staff'?'staff':'system'}"><b>${escHtml(m.senderName|| (m.role==='client'?c.customerName:'CRULOX'))}</b><p>${escHtml(m.text)}</p><time>${escHtml(timeText(m.at))}</time></article>`).join('')||'<div class="np-v124-thread-empty">Sin mensajes todavía.</div>'}
  const QUICK=['Hola, estoy revisando tu consulta.','Permíteme verificar la información y te confirmo.','Gracias. ¿Hay algo más en lo que pueda ayudarte?'];

  function panelMarkup(c){
    const assigned=agentById(c.assignedAgentId),agents=supportAgents(),closed=c.status==='closed',locked=!!c.lifecycleLocked,ctx=contextLabel(c),last=dateText(new Date(lastActivityMs(c)).toISOString()),contact=c.customerPhone||c.customerEmail||'—';
    let actions='';
    if(!closed){const assignment=isAdmin()?`<label><span>Responsable</span><select id="npV124Assign"><option value="">Sin asignar</option>${agents.map(a=>`<option value="${escHtml(a.id)}" ${String(c.assignedAgentId)===String(a.id)?'selected':''}>${escHtml(a.name)} · ${escHtml(a.area||'Atención')}</option>`).join('')}</select></label>`:(!c.assignedAgentId?'<button type="button" class="primary" id="npV124Take">Tomar chat</button>':'');actions=`${assignment}<label><span>Prioridad</span><select id="npV124Priority"><option value="normal" ${c.priority!=='high'?'selected':''}>Normal</option><option value="high" ${c.priority==='high'?'selected':''}>Alta</option></select></label><button type="button" class="danger" id="npV124Resolve">Finalizar</button>`}
    else if(!locked)actions='<button type="button" class="secondary" id="npV124Resolve">Reabrir conversación</button>';
    return `<header class="np-v124-chat-head"><div><div class="np-v124-title-line"><h3>${escHtml(c.customerName)}</h3><span class="np-v124-status ${statusClass(c)}">${escHtml(statusText(c))}</span>${c.priority==='high'?'<span class="np-v124-priority-high">Prioridad alta</span>':''}</div><p>${escHtml(ctx)}${assigned?` · Responsable: ${escHtml(assigned.name)}`:' · Sin responsable'}</p></div>${actions?`<div class="np-v124-actions">${actions}</div>`:''}</header><section class="np-v124-case-grid"><article><small>Cliente</small><b>${escHtml(c.customerName)}</b></article><article><small>Contacto</small><b title="${escHtml(contact)}">${escHtml(contact)}</b></article><article><small>Contexto</small><b title="${escHtml(ctx)}">${escHtml(ctx)}</b></article><article><small>Responsable</small><b>${escHtml(assigned?.name||'Sin asignar')}</b></article><article><small>Creado</small><b>${escHtml(dateText(c.createdAt))}</b></article><article><small>Última actividad</small><b>${escHtml(last)}</b></article></section><div class="np-v124-thread" id="npV124Thread">${threadMarkup(c)}</div>${closed?`<footer class="np-v124-closed-note ${locked?'locked':''}"><b>${locked?'🔒 Solo lectura':'✓ Conversación finalizada'}</b><span>${escHtml(closeReason(c))} El historial se elimina automáticamente al cumplir 24 horas desde su creación.</span></footer>`:`<footer class="np-v124-compose"><div class="np-v124-quick">${QUICK.map((x,i)=>`<button type="button" data-v124-quick="${i}">${escHtml(x)}</button>`).join('')}</div><div class="np-v124-compose-row"><textarea id="npV124Reply" maxlength="2000" placeholder="Responder al cliente…"></textarea><button type="button" id="npV124Send">Enviar</button></div></footer>`}`;
  }

  function validateSelection(){if(!selectedId)return null;const c=getChat(selectedId);if(!c||!canSee(c)){selectedId='';return null}const list=filtered();if(!list.some(x=>x.id===selectedId)){selectedId='';return null}return c}
  function renderList(){const root=$('npV124List');if(!root)return;validateSelection();root.innerHTML=listMarkup();root.querySelectorAll('[data-v124-chat]').forEach(b=>b.onclick=()=>selectChat(b.dataset.v124Chat));const history=root.querySelector('[data-v124-show-closed]');if(history)history.onclick=()=>{filterState.status='closed';syncFilterControls();renderList();renderPanel();updateResultCount()}}
  function renderPanel({stick=false,focus=false}={}){const root=$('npV124Panel');if(!root)return;const c=validateSelection();if(!c){root.innerHTML=emptyPanel();return}root.innerHTML=panelMarkup(c);bindPanel(c.id);if(stick)requestAnimationFrame(()=>{const t=$('npV124Thread');if(t)t.scrollTop=t.scrollHeight});if(focus&&matchMedia('(max-width:760px)').matches)requestAnimationFrame(()=>root.scrollIntoView({behavior:'smooth',block:'start'}))}
  function renderCounts(){const k=counts();for(const [key,val] of Object.entries(k)){const el=$(`npV124Kpi-${key}`);if(el)el.textContent=String(val)}try{window.NP_V122_MESSAGES_PRIMARY?.refresh?.()}catch(e){}try{window.NP_V117_SUPPORT?.updateBadges?.()}catch(e){}}
  function syncFilterControls(){const s=$('npV124Status'),p=$('npV124Priority');if(s)s.value=filterState.status;if(p)p.value=filterState.priority;document.querySelectorAll('[data-v124-kpi-filter]').forEach(b=>b.classList.toggle('active',b.dataset.v124KpiFilter===filterState.status))}
  function updateResultCount(){const el=$('npV124ResultCount');if(el)el.textContent=`${filtered().length} visibles`}
  function refresh({stick=false}={}){if(state?.adminSection!=='bots'||!$('adminOverlay')?.classList.contains('open'))return;normalizeChats();renderCounts();renderList();renderPanel({stick});syncFilterControls();updateResultCount()}
  function selectChat(id){const c=getChat(id);if(!c||!canSee(c)){selectedId='';refresh();return}selectedId=c.id;markRead(c.id);renderList();renderPanel({stick:true,focus:true});renderCounts();updateResultCount()}

  function bindPanel(chatId){
    const assign=$('npV124Assign');if(assign)assign.onchange=()=>{const current=getChat(chatId);if(!current||current.status==='closed'){refresh();return}const id=assign.value;const changed=mutate(chatId,c=>{c.assignedAgentId=id;c.status=id?'active':'waiting';addSystem(c,id?`Conversación asignada a ${agentById(id)?.name||'agente'}.`:'Conversación devuelta a la bandeja de espera.','')},{requireHandle:false});if(!changed){refresh();return}refresh({stick:true})};
    const take=$('npV124Take');if(take)take.onclick=()=>{const me=currentStaff(),current=getChat(chatId);if(!me||!current||current.status==='closed'){refresh();return}const changed=mutate(chatId,c=>{if(c.assignedAgentId&&String(c.assignedAgentId)!==String(me.id))return;c.assignedAgentId=String(me.id);c.status='active';addSystem(c,`${me.name||'Un agente'} tomó la conversación.`,'')},{requireHandle:true});if(!changed){selectedId='';refresh();return}refresh({stick:true})};
    const priority=$('npV124Priority');if(priority)priority.onchange=()=>{const current=getChat(chatId);if(!current||current.status==='closed'){refresh();return}const changed=mutate(chatId,c=>{c.priority=priority.value==='high'?'high':'normal'},{requireHandle:false});if(!changed){refresh();return}refresh()};
    const resolve=$('npV124Resolve');if(resolve)resolve.onclick=()=>{const current=getChat(chatId);if(!current||!canSee(current)){selectedId='';refresh();return}if(current.lifecycleLocked){refresh();return}const changed=mutate(chatId,c=>{if(c.status==='closed'){c.status=c.assignedAgentId?'active':'waiting';c.closedAt='';c.closedReason='';addSystem(c,'La conversación fue reabierta.','')}else{c.status='closed';c.closedAt=isoNow();c.closedReason='manual';addSystem(c,'El equipo marcó esta conversación como finalizada.','')}},{allowClosed:true});if(!changed){refresh();return}filterState.status=changed.status==='closed'?'closed':(isAgent()?'mine':'open');syncFilterControls();refresh({stick:true})};
    const text=$('npV124Reply'),send=$('npV124Send');document.querySelectorAll('[data-v124-quick]').forEach(b=>b.onclick=()=>{if(text){text.value=QUICK[Number(b.dataset.v124Quick)]||'';text.focus()}});
    const submit=()=>{const value=String(text?.value||'').trim(),me=currentStaff();if(!value||!me)return;const current=getChat(chatId);if(!current||!canHandle(current)){selectedId='';refresh();if(typeof window.toast==='function')window.toast('Este chat ya no te corresponde o ya está cerrado.','warn');return}const changed=mutate(chatId,c=>{if(!c.assignedAgentId){c.assignedAgentId=String(me.id);c.status='active'}c.messages.push({id:uid('msg'),role:'staff',senderId:String(me.id),senderName:me.name||'Equipo CRULOX',text:value.slice(0,2000),at:isoNow(),readByClient:false,readByStaff:true})},{requireHandle:true});if(!changed){selectedId='';refresh();return}refresh({stick:true});if(typeof window.toast==='function')window.toast('Respuesta enviada.','success')};
    if(send)send.onclick=submit;if(text)text.onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}};
  }

  function renderInbox(){
    if(!isAdmin()&&!isAgent()){if(typeof window.toast==='function')window.toast('Necesitas acceso de equipo para abrir Mensajes.','warn');return false}
    const entering=state?.adminSection!=='bots';normalizeChats();state.adminSection='bots';if(entering){selectedId='';filterState={q:'',status:'open',priority:'all'}}
    if($('adminTitle'))$('adminTitle').textContent='Mensajes y atención';
    try{if(typeof renderAdminNav==='function')renderAdminNav();else window.renderAdminNav?.()}catch(e){}
    const breadcrumb=$('adminBreadcrumb');if(breadcrumb)breadcrumb.innerHTML='<span>Administración</span><span>›</span><b>Mensajes y atención</b>';
    const sub=$('adminSubnavWrap');if(sub){sub.innerHTML=`<nav class="np-admin-subnav"><button class="active">💬 Conversaciones</button><button type="button" data-v124-sub="agents">👥 Agentes</button>${isAdmin()?'<button type="button" data-v124-sub="permissions">🔐 Roles y permisos</button>':''}<button type="button" data-v124-sub="orders">📦 Seguimiento pedidos</button></nav>`;sub.onclick=e=>{const b=e.target.closest('[data-v124-sub]');if(!b)return;if(b.dataset.v124Sub==='agents')return team?.renderAgents?.();if(b.dataset.v124Sub==='permissions')return window.renderAdminSection?.('np-permissions');if(b.dataset.v124Sub==='orders')return team?.renderOrderChat?.()}}
    const k=counts();
    $('adminContent').innerHTML=`<section class="np-v124-attention"><header class="np-v124-hero"><div><small>Herramienta #1 · Operación esencial</small><h2>Mensajes y atención al cliente</h2><p>Recibe consultas, identifica el contexto, asigna un responsable, responde y cierra cada caso. Los chats inactivos se bloquean a los 10 minutos y el historial se depura a las 24 horas.</p></div><span class="np-v124-live"><i></i> Operativo</span></header><div class="np-v124-kpis"><button type="button" class="np-v124-kpi wait" data-v124-kpi-filter="waiting"><small>En espera</small><b id="npV124Kpi-waiting">${k.waiting}</b><span>Sin responsable</span></button><button type="button" class="np-v124-kpi active" data-v124-kpi-filter="assigned"><small>En atención</small><b id="npV124Kpi-active">${k.active}</b><span>Con responsable</span></button><button type="button" class="np-v124-kpi unread" data-v124-kpi-filter="unread"><small>Sin leer</small><b id="npV124Kpi-unread">${k.unread}</b><span>Requieren revisión</span></button><button type="button" class="np-v124-kpi" data-v124-kpi-filter="closed"><small>Historial</small><b id="npV124Kpi-closed">${k.closed}</b><span>Solo lectura</span></button></div><div class="np-v124-workspace"><aside class="np-v124-list-pane"><div class="np-v124-toolbar"><div class="np-v124-search"><span>⌕</span><input id="npV124Search" type="search" placeholder="Buscar cliente, producto, agente o mensaje…" value="${escHtml(filterState.q)}"></div><div class="np-v124-filter-row"><select id="npV124Status"><option value="open">Abiertos</option><option value="waiting">En espera</option><option value="assigned">En atención</option><option value="unread">Sin leer</option>${isAgent()?'<option value="mine">Mis chats</option>':''}<option value="closed">Historial</option><option value="all">Todos</option></select><select id="npV124Priority"><option value="all">Toda prioridad</option><option value="high">Alta</option><option value="normal">Normal</option></select></div></div><div class="np-v124-list-head"><b>Conversaciones</b><span id="npV124ResultCount"></span></div><div class="np-v124-list" id="npV124List"></div></aside><main class="np-v124-chat-pane" id="npV124Panel">${emptyPanel()}</main></div></section>`;
    syncFilterControls();
    let timer=0;$('npV124Search').oninput=e=>{filterState.q=e.target.value;clearTimeout(timer);timer=setTimeout(()=>{renderList();renderPanel();updateResultCount()},100)};
    $('npV124Status').onchange=e=>{filterState.status=e.target.value;renderList();renderPanel();syncFilterControls();updateResultCount()};
    $('npV124Priority').onchange=e=>{filterState.priority=e.target.value;renderList();renderPanel();updateResultCount()};
    document.querySelectorAll('[data-v124-kpi-filter]').forEach(b=>b.onclick=()=>{filterState.status=b.dataset.v124KpiFilter;syncFilterControls();renderList();renderPanel();updateResultCount()});
    renderList();renderPanel();renderCounts();updateResultCount();clearInterval(poll);poll=setInterval(()=>refresh(),POLL_MS);try{$('adminOverlay')?.scrollTo?.({top:0,behavior:'auto'})}catch(e){}return true;
  }

  const baseRender=window.renderAdminSection;
  window.renderAdminSection=function(section){if(section==='bots')return renderInbox();return baseRender(section)};
  if(window.NP_V117_SUPPORT)window.NP_V117_SUPPORT.renderInbox=renderInbox;
  window.addEventListener('storage',e=>{if(e.key===CHAT_KEY)refresh({stick:false})});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)clearInterval(poll);else if(state?.adminSection==='bots'&&$('adminOverlay')?.classList.contains('open')){refresh();clearInterval(poll);poll=setInterval(()=>refresh(),POLL_MS)}});
  window.NP_V123_ATTENTION_SAFE={VERSION,renderInbox,refresh,normalizeChats,visibleChats,getChat,canSee,canHandle,counts,accessCheck:()=>({role:state?.session?.role||'',admin:isAdmin(),agent:isAgent()})};
  window.NP_V124_ATTENTION_PRO=window.NP_V123_ATTENTION_SAFE;
})();
</script>


<style id="np-v124-attention-pro-style">
#adminOverlay .np-v124-attention{display:grid;gap:11px;max-width:1480px;margin:0 auto}
#adminOverlay .np-v124-hero{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:13px 14px;border:1px solid rgba(33,218,255,.12);border-radius:18px;background:linear-gradient(145deg,#082033,#061522);box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}
#adminOverlay .np-v124-hero small{display:block;color:#2fddff;font-size:.46rem;font-weight:950;letter-spacing:.1em;text-transform:uppercase}
#adminOverlay .np-v124-hero h2{margin:4px 0 4px;font-size:.9rem;letter-spacing:-.02em}
#adminOverlay .np-v124-hero p{max-width:820px;color:#8ea7be;font-size:.53rem;line-height:1.5;margin:0}
#adminOverlay .np-v124-live{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:7px 9px;border-radius:999px;background:rgba(45,225,143,.055);border:1px solid rgba(45,225,143,.13);color:#53e99b;font-size:.47rem;font-weight:900}
#adminOverlay .np-v124-live i{width:7px;height:7px;border-radius:50%;background:#45e695;box-shadow:0 0 0 4px rgba(69,230,149,.08)}
#adminOverlay .np-v124-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
#adminOverlay .np-v124-kpi{appearance:none;text-align:left;padding:10px 11px;border-radius:15px;border:1px solid rgba(126,203,255,.08);background:#071827;color:#e8f5ff;min-height:72px;transition:.15s ease}
#adminOverlay .np-v124-kpi:hover,#adminOverlay .np-v124-kpi.active{transform:translateY(-1px);border-color:rgba(34,215,255,.28);background:#082033}
#adminOverlay .np-v124-kpi small{display:block;color:#7893ad;font-size:.46rem}
#adminOverlay .np-v124-kpi b{display:block;margin:3px 0 2px;font-size:1rem;color:#e9f8ff}
#adminOverlay .np-v124-kpi span{display:block;color:#69839b;font-size:.42rem}
#adminOverlay .np-v124-kpi.wait b{color:#ffc55e}#adminOverlay .np-v124-kpi.active b{color:#27dcff}#adminOverlay .np-v124-kpi.unread b{color:#ff6d8a}
#adminOverlay .np-v124-workspace{display:grid;grid-template-columns:minmax(270px,33%) minmax(0,1fr);min-height:600px;border-radius:18px;overflow:hidden;border:1px solid rgba(126,203,255,.08);background:#06131f}
#adminOverlay .np-v124-list-pane{min-width:0;border-right:1px solid rgba(126,203,255,.07);background:#071522;display:flex;flex-direction:column}
#adminOverlay .np-v124-toolbar{padding:9px;border-bottom:1px solid rgba(126,203,255,.06);display:grid;gap:7px}
#adminOverlay .np-v124-search{display:grid;grid-template-columns:28px minmax(0,1fr);align-items:center;border:1px solid rgba(126,203,255,.09);border-radius:11px;background:#081a29;overflow:hidden}
#adminOverlay .np-v124-search span{display:grid;place-items:center;color:#3adfff;font-size:.7rem}
#adminOverlay .np-v124-search input{min-height:36px!important;border:0!important;background:transparent!important;color:#eaf6ff!important;padding:7px 8px 7px 0!important;font-size:.51rem!important;outline:0!important}
#adminOverlay .np-v124-filter-row{display:grid;grid-template-columns:1fr 1fr;gap:6px}
#adminOverlay .np-v124-filter-row select{min-height:34px!important;border-radius:10px!important;font-size:.49rem!important;padding:6px 8px!important}
#adminOverlay .np-v124-list-head{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;border-bottom:1px solid rgba(126,203,255,.05)}
#adminOverlay .np-v124-list-head b{font-size:.48rem}#adminOverlay .np-v124-list-head span{font-size:.42rem;color:#6f89a2}
#adminOverlay .np-v124-list{display:grid;align-content:start;gap:5px;padding:7px;overflow:auto;max-height:690px}
#adminOverlay .np-v124-chat-row{width:100%;display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:8px;align-items:center;padding:8px;border:1px solid transparent;border-radius:12px;background:#081827;color:#dcebf7;text-align:left;transition:.14s ease}
#adminOverlay .np-v124-chat-row:hover{background:#091c2c;border-color:rgba(126,203,255,.09)}
#adminOverlay .np-v124-chat-row.active{background:#092136;border-color:rgba(29,218,255,.25);box-shadow:inset 3px 0 0 #22d9ff}
#adminOverlay .np-v124-row-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#0b2032;font-size:.72rem}
#adminOverlay .np-v124-row-icon.wait{color:#ffd06c}#adminOverlay .np-v124-row-icon.active{color:#2bdfff}#adminOverlay .np-v124-row-icon.closed{color:#91a4b7}
#adminOverlay .np-v124-row-main{min-width:0}#adminOverlay .np-v124-row-title{display:flex;align-items:center;gap:5px;min-width:0}
#adminOverlay .np-v124-row-title b{font-size:.55rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .np-v124-row-title em{font-style:normal;padding:2px 5px;border-radius:999px;background:rgba(255,82,112,.08);color:#ff7b92;font-size:.34rem;font-weight:950}
#adminOverlay .np-v124-row-main small{display:block;margin-top:2px;color:#4adfff;font-size:.4rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .np-v124-row-main p{margin:2px 0 0!important;color:#728ca5!important;font-size:.43rem!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .np-v124-chat-row aside{display:grid;justify-items:end;gap:3px;min-width:67px}
#adminOverlay .np-v124-chat-row time{font-size:.38rem;color:#6d879f}
#adminOverlay .np-v124-row-state{max-width:96px;font-size:.37rem;color:#8099b0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .np-v124-row-state.wait{color:#d7ad56}#adminOverlay .np-v124-row-state.active{color:#45dfff}#adminOverlay .np-v124-row-state.closed{color:#8d9cab}
#adminOverlay .np-v124-chat-row aside i{min-width:17px;height:17px;padding:0 4px;border-radius:999px;display:grid;place-items:center;background:#ff5877;color:white;font-size:.34rem;font-style:normal;font-weight:950}
#adminOverlay .np-v124-list-empty{min-height:220px;display:grid;place-items:center;align-content:center;text-align:center;padding:18px;color:#7891a8}
#adminOverlay .np-v124-list-empty>span{font-size:1.25rem}#adminOverlay .np-v124-list-empty b{margin-top:6px;color:#d7e9f7;font-size:.57rem}
#adminOverlay .np-v124-list-empty p{margin:3px 0 0!important;font-size:.44rem!important}
#adminOverlay .np-v124-list-empty button{margin-top:9px;min-height:30px;padding:6px 10px;border-radius:9px;border:1px solid rgba(35,215,255,.14);background:#082033;color:#38ddff;font-size:.43rem;font-weight:900}
#adminOverlay .np-v124-chat-pane{min-width:0;display:flex;flex-direction:column;background:#05111c;scroll-margin-top:70px}
#adminOverlay .np-v124-empty-panel{min-height:500px;display:grid;place-items:center;align-content:center;text-align:center;padding:24px;color:#7f98af}
#adminOverlay .np-v124-empty-icon{font-size:1.8rem}#adminOverlay .np-v124-empty-panel h3{margin-top:8px;font-size:.72rem;color:#e4f2fc}
#adminOverlay .np-v124-empty-panel p{max-width:390px;margin:5px 0 0!important;font-size:.49rem!important;line-height:1.5!important}
#adminOverlay .np-v124-empty-steps{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:12px}
#adminOverlay .np-v124-empty-steps span{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:999px;background:#071c2c;border:1px solid rgba(126,203,255,.06);font-size:.4rem}
#adminOverlay .np-v124-empty-steps b{width:17px;height:17px;border-radius:50%;display:grid;place-items:center;background:#0a2a40;color:#32dcff;font-size:.36rem}
#adminOverlay .np-v124-chat-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:10px 11px;border-bottom:1px solid rgba(126,203,255,.07);background:#071725}
#adminOverlay .np-v124-title-line{display:flex;align-items:center;gap:6px;flex-wrap:wrap}#adminOverlay .np-v124-title-line h3{font-size:.72rem;margin:0}
#adminOverlay .np-v124-chat-head p{margin:3px 0 0!important;color:#7892aa!important;font-size:.46rem!important}
#adminOverlay .np-v124-status,#adminOverlay .np-v124-priority-high{display:inline-flex;padding:3px 6px;border-radius:999px;font-size:.36rem;font-weight:950}
#adminOverlay .np-v124-status{background:#0a2032;color:#79dbff}#adminOverlay .np-v124-status.wait{color:#ffd06c}#adminOverlay .np-v124-status.closed{color:#9aaab9}#adminOverlay .np-v124-status.active{color:#52e3a0}
#adminOverlay .np-v124-priority-high{background:rgba(255,79,112,.075);color:#ff7c92}
#adminOverlay .np-v124-actions{display:flex;align-items:end;flex-wrap:wrap;justify-content:flex-end;gap:5px}
#adminOverlay .np-v124-actions label{display:grid;gap:2px}#adminOverlay .np-v124-actions label>span{font-size:.34rem;color:#6b849c;text-transform:uppercase}
#adminOverlay .np-v124-actions select,#adminOverlay .np-v124-actions button{min-height:31px;border-radius:9px;padding:5px 8px;border:1px solid rgba(126,203,255,.1);background:#091b2b;color:#dcecf8;font-size:.46rem;font-weight:850}
#adminOverlay .np-v124-actions button.danger{color:#ff9caf;border-color:rgba(255,83,116,.15);background:rgba(255,83,116,.05)}
#adminOverlay .np-v124-actions button.primary{color:#05131e;background:linear-gradient(135deg,#16d9f3,#198ff8);border:0}#adminOverlay .np-v124-actions button.secondary{color:#3edfff}
#adminOverlay .np-v124-case-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;padding:7px 10px;border-bottom:1px solid rgba(126,203,255,.06);background:#061522}
#adminOverlay .np-v124-case-grid article{min-width:0;padding:7px 8px;border-radius:9px;background:#081a29;border:1px solid rgba(126,203,255,.05)}
#adminOverlay .np-v124-case-grid small{display:block;font-size:.36rem;color:#658099;text-transform:uppercase}
#adminOverlay .np-v124-case-grid b{display:block;margin-top:2px;font-size:.45rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .np-v124-thread{display:flex;flex:1 1 auto;flex-direction:column;gap:7px;padding:11px;overflow:auto;min-height:280px;max-height:520px}
#adminOverlay .np-v124-message{max-width:82%;padding:8px 10px;border-radius:13px}
#adminOverlay .np-v124-message.client{align-self:flex-start;background:#0a2032;border:1px solid rgba(126,203,255,.08)}
#adminOverlay .np-v124-message.staff{align-self:flex-end;background:linear-gradient(135deg,#12cfea,#168ff4);color:#03111c}
#adminOverlay .np-v124-message.system{align-self:center;max-width:92%;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.045);color:#839bb1;text-align:center}
#adminOverlay .np-v124-message b{display:block;font-size:.41rem;margin-bottom:3px}#adminOverlay .np-v124-message p{margin:0!important;font-size:.52rem!important;line-height:1.42!important;white-space:pre-wrap;overflow-wrap:anywhere}
#adminOverlay .np-v124-message time{display:block;margin-top:4px;text-align:right;font-size:.36rem;opacity:.62}#adminOverlay .np-v124-thread-empty{margin:auto;color:#71899f;font-size:.48rem}
#adminOverlay .np-v124-compose{padding:8px;border-top:1px solid rgba(126,203,255,.07);background:#071725}
#adminOverlay .np-v124-quick{display:flex;gap:5px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}#adminOverlay .np-v124-quick::-webkit-scrollbar{display:none}
#adminOverlay .np-v124-quick button{flex:0 0 auto;max-width:240px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:27px;padding:5px 8px;border-radius:999px;border:1px solid rgba(126,203,255,.08);background:#081b2a;color:#91abc2;font-size:.4rem}
#adminOverlay .np-v124-compose-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px}
#adminOverlay .np-v124-compose textarea{min-height:43px;max-height:120px;resize:none;border:1px solid rgba(126,203,255,.1);border-radius:11px;background:#081a29;color:#e9f6ff;padding:8px 9px;font-size:.51rem;outline:none}
#adminOverlay .np-v124-compose-row>button{min-width:66px;border:0;border-radius:11px;background:linear-gradient(135deg,#16daf4,#198ff8);color:#04111d;font-size:.48rem;font-weight:950}
#adminOverlay .np-v124-closed-note{display:grid;gap:3px;padding:10px 11px;border-top:1px solid rgba(126,203,255,.06);background:#071725}
#adminOverlay .np-v124-closed-note b{font-size:.48rem;color:#9fb2c3}#adminOverlay .np-v124-closed-note span{font-size:.42rem;line-height:1.45;color:#71889e}
#adminOverlay .np-v124-closed-note.locked{background:rgba(255,174,65,.025)}#adminOverlay .np-v124-closed-note.locked b{color:#d9b56e}
@media(max-width:900px){#adminOverlay .np-v124-workspace{grid-template-columns:minmax(230px,38%) minmax(0,1fr)}#adminOverlay .np-v124-case-grid{grid-template-columns:1fr 1fr}}
@media(max-width:760px){#adminOverlay .np-v124-hero{padding:11px}#adminOverlay .np-v124-hero p{font-size:.49rem}#adminOverlay .np-v124-kpis{grid-template-columns:1fr 1fr}#adminOverlay .np-v124-workspace{grid-template-columns:1fr;overflow:visible;min-height:0}#adminOverlay .np-v124-list-pane{border-right:0;border-bottom:1px solid rgba(126,203,255,.07)}#adminOverlay .np-v124-list{max-height:330px}#adminOverlay .np-v124-chat-pane{min-height:500px}#adminOverlay .np-v124-chat-head{flex-direction:column}#adminOverlay .np-v124-actions{justify-content:flex-start;width:100%}#adminOverlay .np-v124-actions label{flex:1;min-width:125px}#adminOverlay .np-v124-actions select{width:100%}#adminOverlay .np-v124-thread{max-height:520px}#adminOverlay .np-v124-empty-panel{min-height:420px}}
@media(max-width:480px){#adminOverlay .np-v124-live{font-size:.4rem;padding:6px 8px}#adminOverlay .np-v124-chat-row{grid-template-columns:31px minmax(0,1fr) auto;padding:7px}#adminOverlay .np-v124-row-icon{width:31px;height:31px}#adminOverlay .np-v124-case-grid{grid-template-columns:1fr 1fr!important}#adminOverlay .np-v124-compose-row{grid-template-columns:minmax(0,1fr) 58px}#adminOverlay .np-v124-actions button{flex:1}#adminOverlay .np-v124-kpi{min-height:66px!important;padding:9px!important}}
</style>

<style id="np-v126-admin-redesign-style">
/* CRULOX v11.16 · panel administrativo rediseñado + modo herramienta */
:root{--np126-bg:#030a12;--np126-panel:#07131f;--np126-card:#091927;--np126-card2:#0b1d2d;--np126-line:rgba(128,202,255,.09);--np126-line2:rgba(44,220,255,.2);--np126-text:#edf8ff;--np126-muted:#7892a9;--np126-cyan:#25dcff;--np126-blue:#178ef5;--np126-green:#36e199;--np126-red:#ff6c86}
#adminOverlay{background:var(--np126-bg)!important;color:var(--np126-text)!important}
#adminOverlay .admin-shell{display:grid!important;grid-template-columns:208px minmax(0,1fr)!important;min-height:100dvh!important;height:auto!important;background:var(--np126-bg)!important}
#adminOverlay .admin-sidebar{position:sticky!important;top:0!important;align-self:start!important;height:100dvh!important;display:flex!important;flex-direction:column!important;gap:8px!important;padding:12px 10px!important;background:#050f19!important;border:0!important;border-right:1px solid var(--np126-line)!important;overflow:hidden auto!important;box-shadow:none!important}
#adminOverlay .admin-brand-row{display:flex!important;justify-content:flex-start!important;align-items:center!important;min-height:48px!important;margin:0!important;padding:2px 5px 8px!important;border-bottom:1px solid rgba(128,202,255,.055)!important}
#adminOverlay .admin-brand{width:166px!important;height:38px!important;margin:0!important;object-fit:contain!important}
#adminOverlay .admin-brand-meta{display:none!important}
#adminOverlay .np-v126-side-primary{display:grid;gap:6px;padding:2px 0 5px}
#adminOverlay .np-v126-side-primary button{position:relative;width:100%;min-height:39px;padding:8px 10px;border-radius:11px;border:1px solid var(--np126-line);background:#081724;color:#cfe1f0;display:flex;align-items:center;gap:8px;text-align:left;font-size:.53rem;font-weight:900}
#adminOverlay .np-v126-side-primary button:first-child{background:linear-gradient(135deg,rgba(0,210,255,.16),rgba(20,129,242,.09));border-color:rgba(39,220,255,.2);color:#eaffff}
#adminOverlay .np-v126-side-primary i{font-style:normal;width:25px;height:25px;display:grid;place-items:center;border-radius:8px;background:rgba(39,220,255,.07);font-size:.61rem}
#adminOverlay .np-v126-side-count{margin-left:auto;min-width:20px;height:20px;padding:0 5px;border-radius:999px;display:none;place-items:center;background:#ff5d79;color:#fff;font-size:.39rem;font-weight:950}
#adminOverlay .np-v126-side-count.show{display:grid}
#adminOverlay .admin-nav{display:flex!important;flex:1 0 auto!important;flex-direction:column!important;gap:3px!important;width:100%!important;padding:3px 0!important;margin:0!important;overflow:visible!important}
#adminOverlay .admin-nav button{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;width:100%!important;min-height:36px!important;padding:7px 9px!important;border-radius:10px!important;border:1px solid transparent!important;background:transparent!important;color:#849eb5!important;font-size:.50rem!important;line-height:1.1!important;text-align:left!important;white-space:normal!important;box-shadow:none!important;overflow:visible!important}
#adminOverlay .admin-nav button:hover{background:#081725!important;color:#dcecf9!important}
#adminOverlay .admin-nav button.active{background:#0a1e2e!important;color:#f0fbff!important;border-color:rgba(37,220,255,.14)!important;box-shadow:inset 3px 0 0 var(--np126-cyan)!important}
#adminOverlay .admin-nav .np-admin-menu-icon{width:26px;height:26px;display:grid;place-items:center;border-radius:8px;background:#091a29;font-size:.62rem!important;flex:0 0 auto}
#adminOverlay .admin-main{min-width:0!important;overflow:visible!important;background:var(--np126-bg)!important}
#adminOverlay .admin-top{position:sticky!important;top:0!important;z-index:80!important;min-height:56px!important;padding:7px 14px!important;background:rgba(3,10,18,.97)!important;border:0!important;border-bottom:1px solid var(--np126-line)!important;backdrop-filter:none!important;display:flex!important;align-items:center!important;gap:10px!important}
#adminOverlay .admin-top>div:first-child{min-width:0}
#adminOverlay .admin-top .section-kicker{display:none!important}
#adminOverlay .admin-top h1{font-size:.86rem!important;line-height:1.12!important;letter-spacing:-.02em!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#adminOverlay .admin-top .toolbar{margin-left:auto!important;display:flex!important;align-items:center!important;flex-wrap:nowrap!important;gap:5px!important}
#adminOverlay .admin-top .toolbar .btn,#adminOverlay .admin-top .toolbar>button{min-height:34px!important;padding:6px 10px!important;border-radius:10px!important;font-size:.48rem!important;box-shadow:none!important}
#adminOverlay .np-admin-breadcrumb{max-width:1540px!important;margin:0 auto!important;padding:8px 14px 0!important;font-size:.45rem!important;color:#617b94!important}
#adminOverlay .np-admin-subnav-wrap{max-width:1540px!important;margin:0 auto!important;padding:5px 14px 0!important}
#adminOverlay .np-admin-subnav{gap:4px!important;margin:0!important;padding:3px 0 5px!important;overflow-x:auto!important;scrollbar-width:none!important}
#adminOverlay .np-admin-subnav button{min-height:29px!important;padding:5px 9px!important;border-radius:9px!important;background:#071522!important;border:1px solid rgba(128,202,255,.065)!important;color:#849db4!important;font-size:.43rem!important;box-shadow:none!important}
#adminOverlay .np-admin-subnav button.active{background:#0a2032!important;color:#30ddff!important;border-color:rgba(39,220,255,.16)!important}
#adminOverlay .admin-content{width:100%!important;max-width:1540px!important;margin:0 auto!important;padding:12px 14px 76px!important}
#adminOverlay .admin-content>*+*{margin-top:12px!important}
/* Inicio / navegación */
#adminOverlay .np-v126-home-launcher{display:grid;grid-template-columns:minmax(0,1.55fr) repeat(3,minmax(120px,.55fr));gap:8px;margin-bottom:11px}
#adminOverlay .np-v126-home-main,#adminOverlay .np-v126-stat{min-height:88px;border-radius:16px;border:1px solid var(--np126-line);background:linear-gradient(145deg,#0a1d2d,#071420);padding:12px;box-shadow:none}
#adminOverlay .np-v126-home-main{position:relative;overflow:hi