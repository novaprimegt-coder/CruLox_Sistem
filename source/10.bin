gar respaldo completo · privado';fullMobile._np110BaseTitle=fullMobile.title;fullMobile.desc='Descarga el respaldo restaurable completo. Puede incluir hashes de acceso: no lo compartas públicamente.';fullMobile.group='system';fullMobile.icon='🔒';fullMobile.action=()=>typeof exportBackup==='function'?exportBackup():notify('El respaldo completo no está disponible.','warn');fullMobile._np116Wrapped=false}
}

function rerankTools(){const forced=['go-orders','go-inventory','go-products','v105-team-chat','go-users','v105-team-assign','v105-team-agents','v105-team-permissions','go-combos','go-promos','price-at-least-10','price-at-least-20','price-at-least-75','price-at-least-50','price-at-least-40','reviews-at-least-100','v111-order-value-5','v111-order-value-3','v111-order-value-2','v111-order-value-1','system-backup','v111-inventory-value-4','v111-inventory-value-5','v111-inventory-value-6','go-backup','go-activity','go-dashboard','go-categories','go-store','go-faq'];const fm=new Map(forced.map((id,i)=>[id,100000-i*1000]));const gs={operations:9000,catalog:8200,team:7900,customers:7100,growth:6100,system:5600,analytics:4800,home:4000};tools.forEach((t,i)=>{if(t._np116Origin==null)t._np116Origin=i;t._np110BaseTitle=String(t.title||'').replace(/^\s*#?\d+\s*[·.\-:]\s*/,'').trim()});const score=t=>{if(fm.has(t.id))return fm.get(t.id);let v=gs[t.group]||3000,s=normx(`${t.title} ${t.desc} ${t.id}`);if(/alerta|sin responsable|agotad|stock bajo|integridad|diagnostico/.test(s))v+=1200;if(/compartir|imprimir|exportar|respaldo/.test(s))v+=420;if(/rango|exacto|≥|≤|q\d+|control .* \d+$/.test(s))v-=1300;if(/^v105-qa-/.test(t.id))v-=3000;return v-(t._np116Origin||0)/1000};tools.sort((a,b)=>score(b)-score(a)||(a._np116Origin-b._np116Origin));tools.forEach((t,i)=>{t.rank=i+1;t.title=t._np110BaseTitle})}

const ROLE_PRESETS={packing:{label:'Empaque',groups:['operations'],sections:['orders','np-fulfillment','inventory','np-order-chat','np-assignments']},support:{label:'Atención',groups:['customers','operations'],sections:['users','orders','np-customer-notes','np-order-chat','np-assignments']},catalog:{label:'Catálogo',groups:['catalog'],sections:['products','combos','categories','inventory','np-media']},sales:{label:'Ventas',groups:['operations','growth','analytics'],sections:['orders','promotions','np-sales','np-order-analytics','np-customer-analytics','np-order-chat']},supervisor:{label:'Supervisor',groups:['catalog','operations','customers','growth','analytics','team'],sections:['products','combos','categories','inventory','orders','users','promotions','faqs','settings','np-order-chat','np-assignments','np-team-load']},custom:{label:'Personalizado',groups:[],sections:[]}};
function renderPermissionsCenter(){if(state.session?.role!=='admin')return notify('Solo el administrador puede modificar permisos.','warn');state.adminSection='np-permissions';if(byId('adminTitle'))byId('adminTitle').textContent='Roles y permisos';const agents=currentAgents(),active=agents.filter(a=>a.active!==false),toolGrants=agents.reduce((s,a)=>s+arr(a.permissions?.tools).length,0),sectionGrants=agents.reduce((s,a)=>s+arr(a.permissions?.sections).length,0);byId('adminContent').innerHTML=`<section class="np-v116-perm-shell"><header class="np-v116-report-head"><div><h2>Control real de acceso</h2><p>Configura exactamente qué módulos y herramientas puede utilizar cada agente. Los permisos se convierten a acceso explícito para que una cuenta no vea funciones no autorizadas.</p></div><button class="btn btn-primary btn-sm" id="npV116AddAgent">+ Agente</button></header><div class="np-v116-perm-summary"><div><small>Agentes</small><b>${agents.length}</b></div><div><small>Activos</small><b>${active.length}</b></div><div><small>Herramientas concedidas</small><b>${toolGrants}</b></div><div><small>Módulos concedidos</small><b>${sectionGrants}</b></div></div><div class="np-v116-agent-perm-list">${agents.length?agents.map(a=>`<article class="np-v116-agent-perm"><div><h3>${h(a.name||a.username||'Agente')}</h3><p>${h(a.email||'')} · ${h(ROLE_PRESETS[a.preset]?.label||a.area||'Personalizado')} · ${a.active===false?'Suspendido':'Activo'}</p><div class="np-v116-agent-perm-tags"><span>${arr(a.permissions?.tools).length} herramientas</span><span>${arr(a.permissions?.sections).length} módulos</span><span>${a.permissions?.strictV110?'Acceso estricto':'Requiere normalización'}</span></div></div><button class="btn btn-secondary btn-sm" data-v116-perm-agent="${h(a.id)}">Administrar</button></article>`).join(''):`<div class="np-v116-empty"><b>No hay agentes creados.</b><span>Crea una cuenta interna antes de configurar permisos.</span></div>`}</div></section>`;byId('npV116AddAgent').onclick=()=>team?.renderAgents?.();qsa('[data-v116-perm-agent]',byId('adminContent')).forEach(b=>b.onclick=()=>openPermissionEditor(b.dataset.v116PermAgent));scrollAdminTop();}
function openPermissionEditor(agentId){const agent=team?.agentById?.(agentId);if(!agent||!byId('crudModal'))return;const modules=[];Object.entries(team.modules||{}).forEach(([group,items])=>arr(items).forEach(item=>{const [section,icon,label,desc]=item;if(['np-agents','np-permissions'].includes(section))return;modules.push({section,group,icon,label,desc})}));const selectedTools=new Set(arr(agent.permissions?.tools)),selectedSections=new Set(arr(agent.permissions?.sections));byId('crudTitle').textContent=`Permisos · ${agent.name||agent.username}`;byId('crudBody').innerHTML=`<form id="npV116PermForm" class="np-v116-perm-editor"><div class="np-v116-perm-toolbar"><input id="npV116PermSearch" type="search" placeholder="Buscar #, herramienta o función…"><select id="npV116PermPreset">${Object.entries(ROLE_PRESETS).map(([k,v])=>`<option value="${k}" ${agent.preset===k?'selected':''}>${h(v.label)}</option>`).join('')}</select><button type="button" class="btn btn-secondary btn-sm" id="npV116ApplyPreset">Aplicar plantilla</button></div><div class="np-v116-perm-count"><span>Selecciona módulos o herramientas concretas.</span><b id="npV116PermCount">${selectedTools.size} herramientas · ${selectedSections.size} módulos</b></div><div><div class="np-v116-report-head"><div><h2>Módulos</h2><p>Permiten entrar a una sección administrativa concreta.</p></div></div><div class="np-v116-module-grid" id="npV116ModuleGrid">${modules.map(m=>`<label class="np-v116-module-item"><input type="checkbox" data-v116-section="${h(m.section)}" ${selectedSections.has(m.section)?'checked':''}><span><b>${m.icon||'•'} ${h(m.label)}</b><small>${h(m.desc||m.group)}</small></span><em>${h(m.group)}</em></label>`).join('')}</div></div><div><div class="np-v116-report-head"><div><h2>Herramientas</h2><p>El agente solo verá herramientas incluidas explícitamente en su acceso.</p></div><div class="np-ac24-inline"><button type="button" class="np-ac24-mini" id="npV116SelectVisible">Seleccionar visibles</button><button type="button" class="np-ac24-mini" id="npV116ClearTools">Limpiar</button></div></div><div class="np-v116-tool-list" id="npV116PermTools">${tools.map(t=>`<label class="np-v116-tool-item" data-v116-tool-row><input type="checkbox" data-v116-tool="${h(t.id)}" ${selectedTools.has(t.id)?'checked':''}><span><b>#${t.rank} · ${h(t.title)}</b><small>${h(t.desc||'')}</small></span><em>${h(t.group)}</em></label>`).join('')}</div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar acceso estricto</button><button class="btn btn-secondary" type="button" data-close="crudModal">Cancelar</button></div></form>`;openModal('crudModal');const form=byId('npV116PermForm'),search=byId('npV116PermSearch'),count=byId('npV116PermCount'),list=byId('npV116PermTools');const repaint=()=>{count.textContent=`${qsa('[data-v116-tool]:checked',form).length} herramientas · ${qsa('[data-v116-section]:checked',form).length} módulos`};let npPermSearchTimer=0;search.oninput=()=>{clearTimeout(npPermSearchTimer);npPermSearchTimer=setTimeout(()=>{const q=normx(search.value);qsa('[data-v116-tool-row]',list).forEach(row=>{row.hidden=!!q&&!normx(row.textContent).includes(q)&&!normx(row.querySelector('[data-v116-tool]')?.dataset.v116Tool).includes(q)})},110)};byId('npV116SelectVisible').onclick=()=>{qsa('[data-v116-tool-row]:not([hidden]) input',list).forEach(x=>x.checked=true);repaint()};byId('npV116ClearTools').onclick=()=>{qsa('[data-v116-tool]',form).forEach(x=>x.checked=false);repaint()};form.onchange=repaint;byId('npV116ApplyPreset').onclick=()=>{const key=byId('npV116PermPreset').value,p=ROLE_PRESETS[key]||ROLE_PRESETS.custom;qsa('[data-v116-section]',form).forEach(x=>x.checked=p.sections.includes(x.dataset.v116Section));qsa('[data-v116-tool]',form).forEach(x=>{const t=toolById.get(x.dataset.v116Tool);x.checked=!!t&&(p.groups.includes(t.group)||(t.section&&p.sections.includes(t.section)))});repaint()};form.onsubmit=e=>{e.preventDefault();const sections=qsa('[data-v116-section]:checked',form).map(x=>x.dataset.v116Section);const selected=qsa('[data-v116-tool]:checked',form).map(x=>x.dataset.v116Tool);const expanded=new Set(selected);tools.forEach(t=>{if(t.section&&sections.includes(t.section))expanded.add(t.id)});agent.preset=byId('npV116PermPreset').value;agent.permissions={tools:[...expanded].filter(id=>tools.some(t=>t.id===id)),sections:[...new Set([...sections,...[...expanded].map(id=>toolById.get(id)?.section).filter(Boolean)])],groups:[],strictV110:true};agent.updatedAt=new Date().toISOString();team.saveAgents?.();closeModal('crudModal');notify('Permisos guardados y normalizados.','success');renderPermissionsCenter()};}

document.addEventListener('click',e=>{const b=e.target.closest?.('[data-agent-perms]');if(!b||state.session?.role!=='admin')return;e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();openPermissionEditor(b.dataset.agentPerms)},true);

function saveAssignments(){try{localStorage.setItem('jm_digital_v1_assignments',JSON.stringify(currentAssignments()));return true}catch(e){recordIssue('assignments-save',e);notify('No fue posible guardar la asignación.','error');return false}}
function renderAssignmentsCenter(){if(state.session?.role==='agent'&&!team?.canUseSection?.('np-assignments')&&!team?.canUseSection?.('orders'))return notify('Esta cuenta no tiene permiso para asignaciones.','warn');state.adminSection='np-assignments';if(byId('adminTitle'))byId('adminTitle').textContent='Asignaciones';const orders=state.orders,agents=currentAgents().filter(a=>a.active!==false),as=currentAssignments(),assigned=orders.filter(o=>as[o.id]).length;byId('adminContent').innerHTML=`<section class="np-v116-report"><header class="np-v116-report-head"><div><h2>Responsables por pedido</h2><p>Asigna cada pedido a una persona concreta y detecta inmediatamente qué pedidos siguen sin responsable.</p></div></header><div class="np-v116-home-strip"><div class="np-v116-now"><small>Pedidos</small><strong>${orders.length}</strong></div><div class="np-v116-now ok"><small>Asignados</small><strong>${assigned}</strong></div><div class="np-v116-now ${orders.length-assigned?'warn':'ok'}"><small>Sin asignar</small><strong>${orders.length-assigned}</strong></div><div class="np-v116-now"><small>Agentes activos</small><strong>${agents.length}</strong></div></div><div class="np-v116-assign-toolbar"><input id="npV116AssignSearch" type="search" placeholder="Buscar pedido o cliente…"><select id="npV116AssignFilter"><option value="all">Todos</option><option value="unassigned">Sin asignar</option><option value="active">Activos</option><option value="closed">Cerrados</option></select></div><div class="np-v116-assignment-list" id="npV116AssignmentList"></div></section>`;const draw=()=>{const q=normx(byId('npV116AssignSearch').value),f=byId('npV116AssignFilter').value;let list=orders.filter(o=>!q||normx(`${o.id} ${o.customer?.fullName} ${o.customer?.email} ${o.status}`).includes(q));if(f==='unassigned')list=list.filter(o=>!as[o.id]);if(f==='active')list=list.filter(o=>!['entregado','cancelado'].includes(normx(o.status)));if(f==='closed')list=list.filter(o=>['entregado','cancelado'].includes(normx(o.status)));byId('npV116AssignmentList').innerHTML=list.length?list.map(o=>`<article class="np-v116-assignment"><div><b>${h(o.id)} · ${h(o.customer?.fullName||'Cliente')}</b><small>${h(o.status||'Nuevo')} · ${h(cash(o.total))}</small></div><select data-v116-assign-select="${h(o.id)}"><option value="">Sin asignar</option>${agents.map(a=>`<option value="${h(a.id)}" ${as[o.id]===a.id?'selected':''}>${h(a.name)} · ${h(a.area||'')}</option>`).join('')}</select><button class="btn btn-secondary btn-sm" data-v116-open-order="${h(o.id)}">Seguimiento</button></article>`).join(''):`<div class="np-v116-empty"><b>No hay pedidos con este filtro.</b><span>Cambia el filtro o espera a que existan pedidos reales.</span></div>`;qsa('[data-v116-assign-select]',byId('npV116AssignmentList')).forEach(s=>s.onchange=()=>{if(s.value)as[s.dataset.v116AssignSelect]=s.value;else delete as[s.dataset.v116AssignSelect];if(saveAssignments())notify('Responsable actualizado.','success')});qsa('[data-v116-open-order]',byId('npV116AssignmentList')).forEach(b=>b.onclick=()=>team?.renderOrderConversation?.(b.dataset.v116OpenOrder))};let npAssignSearchTimer=0;byId('npV116AssignSearch').oninput=()=>{clearTimeout(npAssignSearchTimer);npAssignSearchTimer=setTimeout(draw,110)};byId('npV116AssignFilter').onchange=draw;draw();scrollAdminTop();}

function renderMobileCenter(){state.adminSection='np-mobile-center';if(byId('adminTitle'))byId('adminTitle').textContent='AppCreator24';const cap=ac?.capabilityData?.()||{};const cards=[['Compartir Android','Envía texto o archivos con navigator.share().',()=>ac?.shareOperationalSummary?.()],['Imprimir','Abre la impresión nativa con window.print().',()=>ac?.printOperationalSummary?.()],['Cámara','Captura una foto desde el dispositivo.',()=>ac?.capturePhotoStandalone?.()],['Micrófono','Graba una nota temporal de hasta 60 segundos.',()=>ac?.openVoiceRecorder?.('Nota operativa CRULOX')],['Descarga dinámica','Prueba Blob con fallback Data URL.',()=>ac?.dynamicDownload?.(`prueba-${Date.now()}.txt`,'CRULOX','text/plain')],['Diagnóstico','Comprueba las APIs expuestas por la WebView.',()=>ac?.openCompatibilityCenter?.()]];byId('adminContent').innerHTML=`<section class="np-v116-mobile-center"><header class="np-v116-report-head"><div><h2>Centro móvil AppCreator24</h2><p>Accesos prácticos para las capacidades nuevas de la sección HTML/Web. Compartir e imprimir también deben estar activados en la configuración de AppCreator24.</p></div></header><div class="np-v116-home-strip"><div class="np-v116-now ${cap.blob?'ok':'bad'}"><small>Blob</small><strong>${cap.blob?'Sí':'No'}</strong></div><div class="np-v116-now ${cap.share?'ok':'warn'}"><small>Compartir</small><strong>${cap.share?'Sí':'No'}</strong></div><div class="np-v116-now ${cap.print?'ok':'warn'}"><small>Imprimir</small><strong>${cap.print?'Sí':'No'}</strong></div><div class="np-v116-now ${cap.cameraApi?'ok':'warn'}"><small>Cámara/mic.</small><strong>${cap.cameraApi?'Sí':'No'}</strong></div></div><div class="np-v116-mobile-grid">${cards.map((c,i)=>`<article class="np-v116-mobile-card"><b>${h(c[0])}</b><p>${h(c[1])}</p><button data-v116-mobile="${i}">Abrir</button></article>`).join('')}</div></section>`;qsa('[data-v116-mobile]',byId('adminContent')).forEach(b=>b.onclick=()=>cards[n(b.dataset.v116Mobile)]?.[2]?.());scrollAdminTop();}
function renderMediaCaptureCenter(){if(!byId('crudModal'))return;byId('crudTitle').textContent='Captura multimedia';byId('crudBody').innerHTML=`<div class="np-v116-mobile-grid"><article class="np-v116-mobile-card"><b>📷 Cámara</b><p>Captura una imagen y decide si compartirla o descargarla.</p><button id="npV116Camera">Abrir cámara</button></article><article class="np-v116-mobile-card"><b>🎙 Nota de voz</b><p>Graba audio temporal sin guardarlo en localStorage.</p><button id="npV116Voice">Grabar voz</button></article></div><div class="form-actions"><button class="btn btn-secondary" data-close="crudModal">Cerrar</button></div>`;openModal('crudModal');byId('npV116Camera').onclick=()=>ac?.capturePhotoStandalone?.();byId('npV116Voice').onclick=()=>ac?.openVoiceRecorder?.('Nota operativa CRULOX')}

function enhanceHome(){if(state.session?.role!=='admin'||state.adminSection!=='home')return;const content=byId('adminContent');if(!content||content.querySelector('.np-v116-home-wrap'))return;const as=currentAssignments(),open=activeOrders().length,unassigned=activeOrders().filter(o=>!as[o.id]).length,low=state.products.filter(p=>n(p.stock)>0&&n(p.stock)<=lowLimit()).length,out=state.products.filter(p=>n(p.stock)<=0).length,issues=invalidDataRows().length;const wrap=document.createElement('section');wrap.className='np-v116-home-wrap';wrap.innerHTML=`<div class="np-v116-home-strip"><div class="np-v116-now ${open?'warn':'ok'}"><small>Pedidos abiertos</small><strong>${open}</strong></div><div class="np-v116-now ${unassigned?'bad':'ok'}"><small>Sin responsable</small><strong>${unassigned}</strong></div><div class="np-v116-now ${low?'warn':'ok'}"><small>Stock bajo</small><strong>${low}</strong></div><div class="np-v116-now ${out||issues?'bad':'ok'}"><small>Agotados / datos</small><strong>${out} / ${issues}</strong></div></div><div class="np-v116-actions"><button class="primary" data-v116-home="orders">Pedidos</button><button data-v116-home="assign">Asignaciones</button><button data-v116-home="stock">Inventario crítico</button><button data-v116-home="permissions">Permisos</button><button data-v116-home="mobile">AppCreator24</button><button data-v116-home="diagnostic">Diagnóstico</button></div>`;content.prepend(wrap);wrap.querySelector('[data-v116-home="orders"]').onclick=()=>renderAdminSection('orders');wrap.querySelector('[data-v116-home="assign"]').onclick=renderAssignmentsCenter;wrap.querySelector('[data-v116-home="stock"]').onclick=()=>report('Inventario crítico','Agotados y productos bajo el límite configurado.',productRows(state.products.filter(p=>n(p.stock)<=lowLimit())));wrap.querySelector('[data-v116-home="permissions"]').onclick=renderPermissionsCenter;wrap.querySelector('[data-v116-home="mobile"]').onclick=renderMobileCenter;wrap.querySelector('[data-v116-home="diagnostic"]').onclick=openDiagnostics;setTimeout(()=>{const strip=content.querySelector('.np-v110-priority-strip');if(strip){qsa('.np-v110-priority-item',strip).slice(8).forEach(x=>x.remove());const p=strip.querySelector('.np-v110-priority-head p');if(p)p.textContent='Los accesos de mayor impacto se muestran aquí; el resto está disponible en Herramientas.'}},30)}

function scrollAdminTop(){const o=byId('adminOverlay');if(!o)return;try{o.scrollTo({top:0,behavior:'auto'})}catch(e){o.scrollTop=0}}
function ensureScroll(){const o=byId('adminOverlay');if(!o||!o.classList.contains('open'))return;o.style.overflowY='auto';o.style.overflowX='hidden';o.style.webkitOverflowScrolling='touch';o.style.touchAction='pan-y pinch-zoom';const sh=o.querySelector('.admin-shell');if(sh){sh.style.height='auto';sh.style.minHeight='100dvh'}}
function ensureScrollTopButton(){let b=byId('npV116ScrollTop');if(!b){b=document.createElement('button');b.id='npV116ScrollTop';b.className='np-v116-scrolltop';b.type='button';b.textContent='↑';b.setAttribute('aria-label','Volver arriba');document.body.appendChild(b);b.onclick=scrollAdminTop}const o=byId('adminOverlay');if(o&&!o.dataset.v116Scroll){o.dataset.v116Scroll='1';o.addEventListener('scroll',()=>b.classList.toggle('show',o.classList.contains('open')&&o.scrollTop>550),{passive:true})}}

function addMobileModule(){const mods=team?.modules?.system;if(Array.isArray(mods)&&!mods.some(x=>x[0]==='np-mobile-center'))mods.splice(1,0,['np-mobile-center','📱','AppCreator24','Compartir, imprimir, descargas, cámara y micrófono.'])}
function ensureToolModel(){const safe=tools.find(t=>t.id==='v111-order-value-3'),full=tools.find(t=>t.id==='v111-order-value-4');if(!safe||safe.title!=='Compartir exportación segura'||!full||full.title!=='Descargar respaldo completo · privado'){repurposeLowValueTools();rerankTools();wrapToolActions()}}
function refreshEnhancements(){ensureToolModel();ensureScroll();ensureScrollTopButton();enhanceToolCards(byId('adminOverlay')||document);enhanceHome()}

repurposeLowValueTools();rerankTools();wrapToolActions();addMobileModule();
const baseRender=window.renderAdminSection;
window.renderAdminSection=function(section){
 if(section==='np-permissions')return renderPermissionsCenter();
 if(section==='np-assignments')return renderAssignmentsCenter();
 if(section==='np-mobile-center')return renderMobileCenter();
 const r=baseRender(section);requestAnimationFrame(()=>{ensureScroll();enhanceToolCards(byId('adminOverlay')||document);if(section==='home'||state.adminSection==='home')enhanceHome();if(section!=='home'&&section!=='dashboard')scrollAdminTop()});return r;
};
const baseOpen=window.openAdmin;
window.openAdmin=function(section='home'){const r=baseOpen(section);requestAnimationFrame(refreshEnhancements);setTimeout(refreshEnhancements,50);return r};
/* v11.8: sin observador global; renderAdminSection/openAdmin actualizan solo cuando corresponde. */
refreshEnhancements();

function runSelfTest(){const ids=tools.map(t=>t.id),dups=qsa('[id]').map(x=>x.id).filter((id,i,a)=>a.indexOf(id)!==i);const result={version:VERSION,toolCount:tools.length,uniqueToolIds:new Set(ids).size,callableTools:tools.filter(t=>typeof t.action==='function').length,ranksComplete:tools.length===400&&tools.every((t,i)=>t.rank===i+1),duplicateDomIds:[...new Set(dups)],teamApi:!!team,appCreatorApi:!!ac,permissionRouter:typeof window.renderAdminSection==='function',runtimeIssues:runtimeIssues.length};result.ok=result.toolCount===400&&result.uniqueToolIds===400&&result.callableTools===400&&result.ranksComplete&&!result.duplicateDomIds.length&&result.teamApi;window.NP_V116_SELF_TEST=result;document.documentElement.dataset.npV116=result.ok?'ok':'review';if(!result.ok)console.warn('CRULOX v11.6 self-test',result);else console.info('CRULOX v11.6 self-test OK',result);return result}
setTimeout(runSelfTest,80);window.NP_V116={VERSION,report,diagnostics,openDiagnostics,renderPermissionsCenter,openPermissionEditor,renderAssignmentsCenter,renderMobileCenter,renderMediaCaptureCenter,downloadSafeExport,shareSafeExport,optimizeStoredImages,runSelfTest,enhanceToolCards,refreshEnhancements};
})();
</script>

<style id="np-v117-style">
/* =====================================================================
   CRULOX v11.7 · Panel premium + Centro de atención conversacional
   ===================================================================== */
:root{--np117-cyan:#18dcff;--np117-blue:#2288ff;--np117-violet:#7d65ff;--np117-green:#2be48b;--np117-orange:#ffb650;--np117-red:#ff6682;--np117-panel:#071522;--np117-panel2:#091c2d;--np117-line:rgba(122,203,255,.11)}
#adminOverlay{background:radial-gradient(circle at 10% -8%,rgba(24,220,255,.08),transparent 26%),radial-gradient(circle at 95% 12%,rgba(125,101,255,.06),transparent 22%),#020812!important}
#adminOverlay .admin-sidebar{background:linear-gradient(180deg,#061522 0%,#04101a 100%)!important;border-bottom:1px solid rgba(126,203,255,.09)!important;box-shadow:0 10px 30px rgba(0,0,0,.18)!important}
#adminOverlay .admin-brand{filter:drop-shadow(0 8px 16px rgba(0,211,255,.18))!important}
#adminOverlay .admin-nav button{position:relative!important;overflow:hidden!important;background:linear-gradient(180deg,rgba(255,255,255,.032),rgba(255,255,255,.014))!important;border:1px solid rgba(126,203,255,.075)!important;color:#a9c1d9!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.018)!important;transition:transform .16s ease,border-color .16s ease,background .16s ease!important}
#adminOverlay .admin-nav button:hover{border-color:rgba(24,220,255,.22)!important;color:#e8f7ff!important;transform:translateY(-1px)!important}
#adminOverlay .admin-nav button.active{color:#03101b!important;background:linear-gradient(135deg,#17e2ff 0%,#22a1ff 58%,#6976ff 100%)!important;border-color:rgba(255,255,255,.16)!important;box-shadow:0 12px 26px rgba(0,171,255,.17),inset 0 1px 0 rgba(255,255,255,.3)!important}
#adminOverlay .admin-top{background:linear-gradient(180deg,rgba(3,10,18,.97),rgba(3,10,18,.89))!important;border-bottom:1px solid rgba(126,203,255,.075)!important;backdrop-filter:blur(18px)!important}
#adminOverlay .admin-top h1{letter-spacing:-.035em!important}
#adminOverlay .admin-content{background:linear-gradient(180deg,rgba(5,15,25,.24),transparent 260px)!important}
#adminOverlay .admin-card,#adminOverlay .np-v10-tool,#adminOverlay .np-v10-kpi,#adminOverlay .np-v105-agent-card,#adminOverlay .np-v116-report,#adminOverlay .np-v116-now,#adminOverlay .np-v116-mobile-card{background:linear-gradient(155deg,rgba(9,27,44,.94),rgba(5,18,30,.94))!important;border-color:rgba(126,203,255,.09)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.024),0 12px 30px rgba(0,0,0,.13)!important}
#adminOverlay .np-v110-priority-strip{background:linear-gradient(150deg,rgba(8,29,47,.96),rgba(5,18,31,.96))!important;border-color:rgba(24,220,255,.12)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 16px 36px rgba(0,0,0,.15)!important}
#adminOverlay .np-v110-priority-item{background:linear-gradient(150deg,#081b2b,#061522)!important;border-color:rgba(126,203,255,.075)!important;transition:.16s ease!important}
#adminOverlay .np-v110-priority-item:hover{transform:translateY(-1px)!important;border-color:rgba(24,220,255,.2)!important}
#adminOverlay .btn-primary{background:linear-gradient(135deg,#17e2ff,#1ba6ff 68%,#6978ff)!important;box-shadow:0 10px 22px rgba(0,183,255,.15)!important}
#adminOverlay .btn-secondary{background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.02))!important;border-color:rgba(126,203,255,.1)!important}
.np-v117-nav-badge{position:absolute;right:5px;top:4px;min-width:17px;height:17px;padding:0 4px;border-radius:999px;display:grid;place-items:center;background:#ff5577;color:white;font-size:.42rem;font-weight:950;border:2px solid #071522;box-shadow:0 4px 12px rgba(255,85,119,.26)}

/* Atención pública */
.np-v117-support{position:fixed;inset:0;z-index:4200;display:none;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.68);backdrop-filter:blur(10px);padding:12px}
.np-v117-support.open{display:flex}
.np-v117-support-card{width:min(760px,100%);height:min(780px,92dvh);display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;border-radius:25px;background:linear-gradient(180deg,#071827,#040d17);border:1px solid rgba(91,201,255,.18);box-shadow:0 32px 100px rgba(0,0,0,.72),inset 0 1px 0 rgba(255,255,255,.035)}
.np-v117-support-head{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:10px;align-items:center;padding:13px 14px;border-bottom:1px solid rgba(126,203,255,.08);background:linear-gradient(180deg,rgba(11,32,51,.96),rgba(7,24,39,.96))}
.np-v117-support-avatar{width:44px;height:44px;border-radius:15px;display:grid;place-items:center;font-size:1.15rem;background:linear-gradient(145deg,rgba(24,220,255,.15),rgba(90,103,255,.13));border:1px solid rgba(24,220,255,.18);box-shadow:0 8px 20px rgba(0,183,255,.1)}
.np-v117-support-head h2{font-size:.88rem;margin:0;letter-spacing:-.025em}.np-v117-support-head p{font-size:.55rem;color:#8ea8c0;margin-top:3px;line-height:1.3}
.np-v117-support-close{width:36px;height:36px;border-radius:12px;border:1px solid rgba(126,203,255,.1);background:rgba(255,255,255,.035);color:#cfe2f4;font-size:1rem}
.np-v117-support-status{display:inline-flex;align-items:center;gap:5px;margin-top:4px;padding:4px 8px;border-radius:999px;background:rgba(43,228,139,.07);border:1px solid rgba(43,228,139,.12);color:#38e995;font-size:.47rem;font-weight:850}.np-v117-support-status.wait{color:#ffc56f;background:rgba(255,182,80,.07);border-color:rgba(255,182,80,.13)}.np-v117-support-status.closed{color:#9cb0c5;background:rgba(255,255,255,.035);border-color:rgba(255,255,255,.07)}
.np-v117-support-body{min-height:0;overflow:auto;padding:14px 12px 18px;display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth;-webkit-overflow-scrolling:touch}
.np-v117-welcome{align-self:center;max-width:92%;padding:10px 12px;border-radius:14px;text-align:center;background:rgba(24,220,255,.045);border:1px solid rgba(24,220,255,.08);color:#8eabc4;font-size:.54rem;line-height:1.5;margin-bottom:4px}
.np-v117-msg{max-width:84%;padding:9px 11px;border-radius:15px;box-shadow:0 8px 20px rgba(0,0,0,.12)}.np-v117-msg.client{align-self:flex-end;border-bottom-right-radius:5px;background:linear-gradient(135deg,#15d9f5,#168cf4);color:#03101b}.np-v117-msg.staff{align-self:flex-start;border-bottom-left-radius:5px;background:#0b2134;border:1px solid rgba(126,203,255,.09);color:#e7f5ff}.np-v117-msg.system{align-self:center;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.055);color:#91a8bf;text-align:center;max-width:92%}
.np-v117-msg b{display:block;font-size:.48rem;margin-bottom:3px;opacity:.82}.np-v117-msg p{font-size:.61rem;line-height:1.46;white-space:pre-wrap;overflow-wrap:anywhere}.np-v117-msg time{display:block;font-size:.41rem;margin-top:4px;opacity:.62;text-align:right}
.np-v117-support-compose{padding:10px 12px max(10px,env(safe-area-inset-bottom));border-top:1px solid rgba(126,203,255,.08);background:rgba(4,14,24,.98)}
.np-v117-guest-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:7px}.np-v117-guest-row input,.np-v117-compose-row textarea{width:100%;border:1px solid rgba(126,203,255,.1);background:#081a2a;color:#eef8ff;outline:none}.np-v117-guest-row input{min-height:34px;border-radius:10px;padding:7px 9px;font-size:.55rem}.np-v117-compose-row{display:grid;grid-template-columns:minmax(0,1fr) 42px;gap:7px;align-items:end}.np-v117-compose-row textarea{min-height:43px;max-height:110px;resize:none;border-radius:14px;padding:10px 11px;font-size:.61rem;line-height:1.35}.np-v117-compose-row textarea:focus,.np-v117-guest-row input:focus{border-color:rgba(24,220,255,.35);box-shadow:0 0 0 3px rgba(24,220,255,.055)}
.np-v117-send{width:42px;height:42px;border:0;border-radius:14px;background:linear-gradient(135deg,#16e0f8,#1b8fff);color:#04111d;font-weight:950;box-shadow:0 9px 20px rgba(0,180,255,.16)}
.np-v117-closed-actions{display:grid;grid-template-columns:1fr;gap:7px}.np-v117-closed-actions button{min-height:38px;border-radius:12px;border:1px solid rgba(24,220,255,.14);background:rgba(24,220,255,.07);color:#30ddff;font-size:.57rem;font-weight:850}
.np-v117-support-unread{position:absolute;right:-5px;top:-5px;min-width:19px;height:19px;padding:0 5px;border-radius:999px;background:#ff5577;color:white;border:2px solid #071522;display:none;place-items:center;font-size:.48rem;font-weight:950}.np-v117-support-unread.show{display:grid}
#floatSupport{position:relative;background:linear-gradient(145deg,#16dff5,#168bf4)!important;box-shadow:0 14px 30px rgba(0,178,255,.22)!important}

/* Bandeja interna de atención */
.np-v117-service-shell{display:grid;gap:11px}.np-v117-service-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:15px;border-radius:19px;background:radial-gradient(circle at 88% 16%,rgba(24,220,255,.13),transparent 28%),radial-gradient(circle at 55% 120%,rgba(125,101,255,.09),transparent 35%),linear-gradient(145deg,#0a2237,#071727);border:1px solid rgba(24,220,255,.12);box-shadow:0 15px 36px rgba(0,0,0,.16),inset 0 1px 0 rgba(255,255,255,.025)}
.np-v117-service-hero small{display:block;color:#2ddfff;font-size:.45rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.np-v117-service-hero h2{font-size:.9rem;margin:4px 0 5px;letter-spacing:-.03em}.np-v117-service-hero p{font-size:.54rem;line-height:1.48;color:#93abc1;max-width:720px}.np-v117-service-live{display:flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:rgba(43,228,139,.07);border:1px solid rgba(43,228,139,.13);color:#37e891;font-size:.5rem;font-weight:850}.np-v117-service-live i{width:7px;height:7px;border-radius:50%;background:#31e58e;box-shadow:0 0 0 5px rgba(49,229,142,.07)}
.np-v117-service-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.np-v117-service-kpi{padding:10px 11px;border-radius:14px;background:linear-gradient(150deg,#091c2c,#061522);border:1px solid rgba(126,203,255,.08)}.np-v117-service-kpi small{display:block;color:#718ca5;font-size:.45rem}.np-v117-service-kpi b{display:block;font-size:.95rem;margin-top:3px;color:#eff9ff}.np-v117-service-kpi.wait b{color:#ffc46b}.np-v117-service-kpi.active b{color:#36e994}.np-v117-service-kpi.unread b{color:#2bdfff}
.np-v117-inbox{display:grid;grid-template-columns:minmax(235px,.72fr) minmax(0,1.55fr);gap:8px;min-height:520px}
.np-v117-inbox-side,.np-v117-chat-panel{min-width:0;border-radius:17px;background:linear-gradient(180deg,#071825,#05111d);border:1px solid rgba(126,203,255,.08);overflow:hidden}
.np-v117-inbox-tools{padding:8px;border-bottom:1px solid rgba(126,203,255,.07);display:grid;gap:6px}.np-v117-inbox-tools input,.np-v117-inbox-tools select{width:100%;min-height:34px;border-radius:10px;border:1px solid rgba(126,203,255,.09);background:#091a2a;color:#e9f5ff;padding:6px 8px;font-size:.52rem;outline:none}.np-v117-inbox-filter-row{display:grid;grid-template-columns:1fr 1fr;gap:5px}.np-v117-chat-list{max-height:575px;overflow:auto;padding:5px;display:grid;align-content:start;gap:4px;-webkit-overflow-scrolling:touch}
.np-v117-chat-item{width:100%;display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:7px;align-items:center;padding:8px;border-radius:11px;border:1px solid transparent;background:transparent;color:#dcebf8;text-align:left;transition:.14s}.np-v117-chat-item:hover,.np-v117-chat-item.active{background:#092034;border-color:rgba(24,220,255,.11)}.np-v117-chat-icon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(145deg,rgba(24,220,255,.09),rgba(125,101,255,.06));font-size:.72rem}.np-v117-chat-item b{display:block;font-size:.55rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.np-v117-chat-item p{font-size:.43rem;color:#718ba3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}.np-v117-chat-item aside{display:grid;justify-items:end;gap:3px}.np-v117-chat-item time{font-size:.37rem;color:#61798f}.np-v117-chat-item .dot{min-width:17px;height:17px;padding:0 4px;border-radius:999px;display:grid;place-items:center;background:#19cffa;color:#03111d;font-size:.4rem;font-weight:950}.np-v117-chat-item .priority{font-size:.36rem;color:#ffbd61}
.np-v117-chat-panel{display:grid;grid-template-rows:auto 1fr auto}.np-v117-chat-empty{display:grid;place-items:center;text-align:center;padding:25px;color:#7892aa}.np-v117-chat-empty span{font-size:2rem;opacity:.5}.np-v117-chat-empty b{font-size:.72rem;color:#cfe2f3;margin-top:8px}.np-v117-chat-empty p{font-size:.5rem;line-height:1.45;margin-top:4px;max-width:330px}
.np-v117-chat-head{padding:9px 10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;border-bottom:1px solid rgba(126,203,255,.07);background:#071a2a}.np-v117-chat-head h3{font-size:.65rem}.np-v117-chat-head p{font-size:.45rem;color:#7892aa;margin-top:2px}.np-v117-chat-actions{display:flex;gap:5px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.np-v117-chat-actions select,.np-v117-chat-actions button{min-height:30px;border-radius:9px;border:1px solid rgba(126,203,255,.09);background:#0a2134;color:#cfe1f1;padding:5px 7px;font-size:.44rem;font-weight:800}.np-v117-chat-actions .resolve{color:#37e890;border-color:rgba(43,228,139,.15);background:rgba(43,228,139,.06)}
.np-v117-admin-thread{min-height:0;overflow:auto;padding:10px;display:flex;flex-direction:column;gap:6px;-webkit-overflow-scrolling:touch}.np-v117-admin-compose{padding:8px;border-top:1px solid rgba(126,203,255,.07);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;background:#061522}.np-v117-admin-compose textarea{min-height:39px;max-height:100px;resize:none;border-radius:11px;border:1px solid rgba(126,203,255,.1);background:#091e30;color:#eef8ff;padding:8px 9px;font-size:.53rem;outline:none}.np-v117-admin-compose button{min-width:72px;border:0;border-radius:11px;background:linear-gradient(135deg,#17e1fa,#1b91f8);color:#04111d;font-size:.51rem;font-weight:900;padding:7px 10px}
.np-v117-local-note{padding:8px 10px;border-radius:12px;background:rgba(255,182,80,.055);border:1px solid rgba(255,182,80,.1);color:#d9b77e;font-size:.47rem;line-height:1.45}

@media(max-width:920px){
 #adminOverlay .admin-nav{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:5px!important}
 #adminOverlay .admin-nav button{min-height:36px!important;font-size:.47rem!important;padding:5px 3px!important;border-radius:10px!important}
 .np-v117-inbox{grid-template-columns:1fr;min-height:0}.np-v117-chat-list{max-height:280px}.np-v117-chat-panel{min-height:470px}.np-v117-service-hero{grid-template-columns:1fr}.np-v117-service-live{justify-self:start}.np-v117-service-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}
}
@media(max-width:560px){
 .np-v117-support{padding:0;align-items:stretch}.np-v117-support-card{width:100%;height:100dvh;border-radius:0;border:0}.np-v117-support-head{padding-top:max(11px,env(safe-area-inset-top))}
 .np-v117-service-kpis{grid-template-columns:1fr 1fr}.np-v117-service-kpi{padding:9px}.np-v117-chat-panel{min-height:430px}.np-v117-chat-head{grid-template-columns:1fr}.np-v117-chat-actions{justify-content:flex-start}.np-v117-admin-compose{grid-template-columns:1fr}.np-v117-admin-compose button{min-height:36px}.np-v117-guest-row{grid-template-columns:1fr}.np-v117-inbox-filter-row{grid-template-columns:1fr 1fr}
}
@media(max-width:360px){#adminOverlay .admin-nav{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(prefers-reduced-motion:reduce){#adminOverlay .admin-nav button,.np-v117-chat-item{transition:none!important}.np-v117-support-body{scroll-behavior:auto}}
</style>
<script id="np-v117-script">
(function(){
  const VERSION='11.7';
  const CHAT_KEY='jm_digital_v1_support_chats';
  const GUEST_KEY='np_support_guest_v117';
  const team=window.NP_TEAM_API_V105||null;
  const $id=id=>document.getElementById(id);
  const qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
  const normText=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const escapeHtml=v=>typeof esc==='function'?esc(String(v??'')):String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const now=()=>new Date().toISOString();
  const id=(p='id')=>`${p}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,9)}`;
  const read=(key,fallback)=>{try{const x=localStorage.getItem(key);return x?JSON.parse(x):fallback}catch(e){return fallback}};
  const save=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){console.warn('NovaPrime chat storage',e);return false}};
  let chatCache=null,chatCacheRaw=null;
  const chats=()=>{let raw='[]';try{raw=localStorage.getItem(CHAT_KEY)||'[]'}catch(e){}if(chatCacheRaw===raw&&Array.isArray(chatCache))return chatCache;let x=[];try{x=JSON.parse(raw)}catch(e){x=[]}chatCache=Array.isArray(x)?x:[];chatCacheRaw=raw;return chatCache};
  const saveChats=value=>{try{const raw=JSON.stringify(value);localStorage.setItem(CHAT_KEY,raw);chatCache=value;chatCacheRaw=raw;return true}catch(e){console.warn('NovaPrime chat storage',e);return false}};
  const activeStaff=()=>Array.isArray(team?.agents?.())?team.agents().filter(a=>a&&a.active!==false):[];
  const supportAgents=()=>{const all=activeStaff(),preferred=all.filter(a=>a.preset==='support'||/(atencion|soporte|cliente|servicio)/.test(normText(a.area)));return preferred.length?preferred:all.filter(a=>a.preset==='supervisor')};
  const agentById=agentId=>String(agentId)==='owner'?{id:'owner',name:'Administrador CRULOX',area:'Administración',active:true}:team?.agentById?.(agentId)||activeStaff().find(a=>String(a.id)===String(agentId))||null;
  const isStaff=()=>state?.session?.role==='admin'||state?.session?.role==='agent';
  const currentStaff=()=>state?.session?.role==='agent'?team?.sessionAgent?.():state?.session?.role==='admin'?{id:'owner',name:'Administrador CRULOX',area:'Administración',active:true}:null;
  const formatTime=iso=>{try{return new Date(iso).toLocaleTimeString('es-GT',{hour:'2-digit',minute:'2-digit'})}catch(e){return''}};
  const formatShort=iso=>{try{const d=new Date(iso),today=new Date();return d.toDateString()===today.toDateString()?formatTime(iso):d.toLocaleDateString('es-GT',{day:'2-digit',month:'2-digit'})}catch(e){return''}};

  function clientIdentity(){
    if(state?.session?.role==='client'){
      const u=state.users.find(x=>String(x.id)===String(state.session.userId));
      if(u)return {id:`user:${u.id}`,name:u.fullName||u.username||'Cliente',email:u.email||'',phone:u.phone||'',registered:true};
    }
    let g=read(GUEST_KEY,null);
    if(!g||!g.id){g={id:`guest:${id('g')}`,name:'',email:'',createdAt:now()};save(GUEST_KEY,g)}
    return {...g,registered:false};
  }
  function updateGuest(name,email){const g=clientIdentity();if(g.registered)return g;const next={...g,name:String(name||'').trim().slice(0,80),email:String(email||'').trim().slice(0,120),updatedAt:now()};save(GUEST_KEY,next);return next}
  function chatForClient(clientId){return chats().filter(c=>c.clientId===clientId&&c.status!=='closed').sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt)))[0]||null}
  function chooseAgent(allChats){const agents=supportAgents();if(!agents.length)return null;const loads=new Map(agents.map(a=>[String(a.id),0]));allChats.filter(c=>c.status!=='closed'&&c.assignedAgentId).forEach(c=>loads.set(String(c.assignedAgentId),(loads.get(String(c.assignedAgentId))||0)+1));return agents.slice().sort((a,b)=>(loads.get(String(a.id))||0)-(loads.get(String(b.id))||0))[0]||null}
  function subjectFrom(extra,message){return String(extra?.Producto||extra?.Combo||extra?.Tipo||message||'Consulta general').replace(/^Hola\.\s*/i,'').slice(0,90)}
  function newChat(identity,context={}){const all=chats(),assigned=chooseAgent(all),c={id:id('chat'),clientId:identity.id,customerName:identity.name||'Cliente',customerEmail:identity.email||'',customerPhone:identity.phone||'',subject:subjectFrom(context.extra,context.message),context:context.extra||{},status:assigned?'active':'waiting',priority:'normal',assignedAgentId:assigned?String(assigned.id):'',createdAt:now(),updatedAt:now(),messages:[]};c.messages.push({id:id('msg'),role:'system',senderId:'system',senderName:'CRULOX',text:assigned?`Tu conversación fue asignada a ${assigned.name||'un agente de atención'}.`:'Tu consulta fue recibida. Un agente de atención podrá tomarla.',at:now(),readByClient:true,readByStaff:false});all.unshift(c);saveChats(all);return c}
  function getChat(chatId){return chats().find(c=>String(c.id)===String(chatId))||null}
  function mutateChat(chatId,fn,{touch=true}={}){const all=chats(),i=all.findIndex(c=>String(c.id)===String(chatId));if(i<0)return null;fn(all[i],all);if(touch)all[i].updatedAt=now();saveChats(all);return all[i]}
  function appendMessage(chatId,{role,senderId,senderName,text}){text=String(text||'').trim();if(!text)return null;return mutateChat(chatId,c=>{c.messages=Array.isArray(c.messages)?c.messages:[];c.messages.push({id:id('msg'),role,senderId:String(senderId||''),senderName:String(senderName||''),text:text.slice(0,2000),at:now(),readByClient:role==='client',readByStaff:role!=='client'});if(role==='client'&&c.status==='closed')c.status=c.assignedAgentId?'active':'waiting'})}
  function unreadForClient(c){return (c.messages||[]).filter(m=>m.role==='staff'&&!m.readByClient).length}
  function unreadForStaff(c){return (c.messages||[]).filter(m=>m.role==='client'&&!m.readByStaff).length}
  function markClientRead(chatId){const c=getChat(chatId);if(!c||(c.messages||[]).every(m=>m.role!=='staff'||m.readByClient))return;mutateChat(chatId,x=>(x.messages||[]).forEach(m=>{if(m.role==='staff')m.readByClient=true}),{touch:false})}
  function markStaffRead(chatId){const c=getChat(chatId);if(!c||(c.messages||[]).every(m=>m.role!=='client'||m.readByStaff))return;mutateChat(chatId,x=>(x.messages||[]).forEach(m=>{if(m.role==='client')m.readByStaff=true}),{touch:false})}

  function ensurePublicSupport(){
    let root=$id('npV117Support');if(root)return root;
    root=document.createElement('div');root.id='npV117Support';root.className='np-v117-support';root.innerHTML=`<section class="np-v117-support-card" role="dialog" aria-modal="true" aria-label="Atención CRULOX"><header class="np-v117-support-head"><div class="np-v117-support-avatar">💬</div><div><h2>Atención CRULOX</h2><p id="npV117SupportSubtitle">Conversa directamente con nuestro equipo.</p><span id="npV117SupportStatus" class="np-v117-support-status wait">En espera</span></div><button class="np-v117-support-close" id="npV117SupportClose" type="button" aria-label="Cerrar">×</button></header><div class="np-v117-support-body" id="npV117SupportBody"></div><footer class="np-v117-support-compose" id="npV117SupportCompose"></footer></section>`;document.body.appendChild(root);$id('npV117SupportClose').onclick=closePublicSupport;root.onclick=e=>{if(e.target===root)closePublicSupport()};return root
  }
  let publicChatId='';let publicDraft='';let publicContext={message:'',extra:{}};let publicPoll=0;
  function publicMessageMarkup(m){const cls=m.role==='client'?'client':m.role==='staff'?'staff':'system';return `<article class="np-v117-msg ${cls}"><b>${escapeHtml(m.senderName|| (m.role==='client'?'Tú':'CRULOX'))}</b><p>${escapeHtml(m.text)}</p><time>${escapeHtml(formatTime(m.at))}</time></article>`}
  function renderPublicSupport({stickBottom=false}={}){
    const root=ensurePublicSupport(),identity=clientIdentity();let c=getChat(publicChatId);if(!c){c=chatForClient(identity.id);if(c)publicChatId=c.id}
    const body=$id('npV117SupportBody'),compose=$id('npV117SupportCompose'),status=$id('npV117SupportStatus'),subtitle=$id('npV117SupportSubtitle');
    if(!c){body.innerHTML='<div class="np-v117-welcome">Escribe tu consulta y la enviaremos al equipo de atención. Si hay un agente disponible, la conversación se asignará automáticamente.</div>';status.className='np-v117-support-status wait';status.textContent='Nueva consulta';subtitle.textContent='Conversa directamente con nuestro equipo.'}
    else{const agent=agentById(c.assignedAgentId);body.innerHTML=`<div class="np-v117-welcome">${c.context?.Producto?`Consulta sobre <b>${escapeHtml(c.context.Producto)}</b>. `:''}Historial de esta conversación.</div>${(c.messages||[]).map(publicMessageMarkup).join('')}`;if(c.status==='closed'){status.className='np-v117-support-status closed';status.textContent='Conversación finalizada';subtitle.textContent='Puedes iniciar una nueva consulta cuando lo necesites.'}else if(agent){status.className='np-v117-support-status';status.textContent=`Atendido por ${agent.name||'Agente'}`;subtitle.textContent=`${agent.area||'Equipo de atención'} · CRULOX`}else{status.className='np-v117-support-status wait';status.textContent='Esperando agente';subtitle.textContent='Tu consulta está en la bandeja de atención.'};markClientRead(c.id)}
    if(c?.status==='closed')compose.innerHTML=`<div class="np-v117-closed-actions"><button type="button" id="npV117NewChat">Iniciar nueva conversación</button></div>`;
    else compose.innerHTML=`${identity.registered?'':`<div class="np-v117-guest-row"><input id="npV117GuestName" placeholder="Tu nombre" value="${escapeHtml(identity.name||'')}"><input id="npV117GuestEmail" type="email" placeholder="Correo (opcional)" value="${escapeHtml(identity.email||'')}"></div>`}<div class="np-v117-compose-row"><textarea id="npV117ClientText" maxlength="2000" placeholder="Escribe tu mensaje…">${escapeHtml(publicDraft)}</textarea><button class="np-v117-send" id="npV117ClientSend" type="button" aria-label="Enviar">➤</button></div>`;
    if($id('npV117NewChat'))$id('npV117NewChat').onclick=()=>{publicChatId='';publicDraft='';renderPublicSupport({stickBottom:true});setTimeout(()=>$id('npV117ClientText')?.focus(),30)};
    if($id('npV117ClientSend')){$id('npV117ClientSend').onclick=sendClientMessage;$id('npV117ClientText').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendClientMessage()}}}
    updatePublicUnread();if(stickBottom)requestAnimationFrame(()=>{body.scrollTop=body.scrollHeight})
  }
  function sendClientMessage(){const text=String($id('npV117ClientText')?.value||'').trim();if(!text)return;let identity=clientIdentity();if(!identity.registered){const name=String($id('npV117GuestName')?.value||'').trim();const email=String($id('npV117GuestEmail')?.value||'').trim();if(name.length<2){toast('Escribe tu nombre para que el equipo pueda atenderte.','warn');$id('npV117GuestName')?.focus();return}identity=updateGuest(name,email)}let c=getChat(publicChatId)||chatForClient(identity.id);if(!c){c=newChat(identity,{message:publicContext.message||text,extra:Object.keys(publicContext.extra||{}).length?publicContext.extra:{Tipo:'Consulta general'}});publicChatId=c.id}else mutateChat(c.id,x=>{x.customerName=identity.name||x.customerName;x.customerEmail=identity.email||x.customerEmail});appendMessage(c.id,{role:'client',senderId:identity.id,senderName:identity.name||'Cliente',text});publicDraft='';renderPublicSupport({stickBottom:true});toast('Mensaje enviado al equipo de atención.','success')}
  function openPublicSupport(message='',extra={}){const identity=clientIdentity();let c=chatForClient(identity.id);publicChatId=c?.id||'';publicContext={message:String(message||''),extra:{...(extra||{})}};publicDraft=String(message||'').replace(/^Hola\.\s*/i,'').slice(0,1200);const root=ensurePublicSupport();root.classList.add('open');document.body.classList.add('lock');renderPublicSupport({stickBottom:true});setTimeout(()=>{$id('npV117ClientText')?.focus()},40);clearInterval(publicPoll);publicPoll=setInterval(()=>{if(root.classList.contains('open'))renderPublicSupport()},6500);return true}
  function closePublicSupport(){const root=$id('npV117Support');if(root)root.classList.remove('open');document.body.classList.remove('lock');clearInterval(publicPoll);publicPoll=0;updatePublicUnread()}
  function updatePublicUnread(){const identity=clientIdentity(),c=chatForClient(identity.id),count=c?unreadForClient(c):0;let b=$id('npV117SupportUnread');const float=$id('floatSupport');if(float&&!b){b=document.createElement('span');b.id='npV117SupportUnread';b.className='np-v117-support-unread';float.appendChild(b)}if(b){b.textContent=String(Math.min(count,99));b.classList.toggle('show',count>0)}}

  /* Sustituye soporte externo por conversación interna. Los pedidos conservan el fallback anterior. */
  const legacyOpenBot=typeof openBot==='function'?openBot:null;
  openBot=function(kind,message,extra={}){if(kind==='support')return openPublicSupport(message,extra);return legacyOpenBot?legacyOpenBot(kind,message,extra):false};
  window.openBot=openBot;

  function visibleChatsForStaff(){const all=chats();if(state.session?.role!=='agent')return all;const me=currentStaff();return all.filter(c=>!c.assignedAgentId||String(c.assignedAgentId)===String(me?.id))}
  function staffCanHandle(c){if(state.session?.role==='admin')return true;const me=currentStaff();return !!me&&(!c.assignedAgentId||String(c.assignedAgentId)===String(me.id))}
  let adminSelectedChat='';let adminPoll=0;
  function adminThreadMarkup(c){return (c.messages||[]).map(m=>`<article class="np-v117-msg ${m.role==='client'?'client':m.role==='staff'?'staff':'system'}"><b>${escapeHtml(m.senderName||'')}</b><p>${escapeHtml(m.text)}</p><time>${escapeHtml(formatTime(m.at))}</time></article>`).join('')}
  function serviceCounts(list){return {waiting:list.filter(c=>c.status==='waiting'||!c.assignedAgentId).length,active:list.filter(c=>c.status==='active'&&c.assignedAgentId).length,closed:list.filter(c=>c.status==='closed').length,unread:list.reduce((n,c)=>n+unreadForStaff(c),0)}}
  function renderServiceInbox(){
    if(!isStaff()){toast('Necesitas acceso de equipo para abrir Atención.','warn');return false}
    state.adminSection='bots';if($id('adminTitle'))$id('adminTitle').textContent='Atención al cliente';if(typeof renderAdminNav==='function')renderAdminNav();const breadcrumb=$id('adminBreadcrumb');if(breadcrumb)breadcrumb.innerHTML='<span>Administración</span><span>›</span><span>Atención</span><span>›</span><b>Conversaciones</b>';const sub=$id('adminSubnavWrap');if(sub){sub.innerHTML=`<nav class="np-admin-subnav"><button class="active" data-v117-sub="chats">💬 Conversaciones</button><button data-v117-sub="agents">👥 Agentes</button>${state.session?.role==='admin'?'<button data-v117-sub="permissions">🔐 Roles y permisos</button>':''}<button data-v117-sub="orders">📦 Seguimiento pedidos</button></nav>`;sub.onclick=e=>{const b=e.target.closest('[data-v117-sub]');if(!b)return;if(b.dataset.v117Sub==='chats')return renderServiceInbox();if(b.dataset.v117Sub==='agents')return team?.renderAgents?.();if(b.dataset.v117Sub==='permissions')return renderAdminSection('np-permissions');if(b.dataset.v117Sub==='orders')return team?.renderOrderChat?.()}};const overlay=$id('adminOverlay');if(overlay){try{overlay.scrollTo({top:0,behavior:'auto'})}catch(e){overlay.scrollTop=0}}
    const allowed=visibleChatsForStaff(),k=serviceCounts(allowed);$id('adminContent').innerHTML=`<section class="np-v117-service-shell"><header class="np-v117-service-hero"><div><small>Centro de atención</small><h2>Conversaciones con clientes</h2><p>Recibe consultas desde el botón 💬 de la tienda, asígnalas al equipo y conserva el contexto de cada conversación.</p></div><span class="np-v117-service-live"><i></i> Atención activa</span></header><div class="np-v117-service-kpis"><article class="np-v117-service-kpi wait"><small>En espera</small><b>${k.waiting}</b></article><article class="np-v117-service-kpi active"><small>Asignados</small><b>${k.active}</b></article><article class="np-v117-service-kpi unread"><small>Sin leer</small><b>${k.unread}</b></article><article class="np-v117-service-kpi"><small>Finalizados</small><b>${k.closed}</b></article></div><div class="np-v117-inbox"><aside class="np-v117-inbox-side"><div class="np-v117-inbox-tools"><input id="npV117ChatSearch" type="search" placeholder="Buscar cliente o consulta…"><div class="np-v117-inbox-filter-row"><select id="npV117ChatFilter"><option value="open">Abiertos</option><option value="waiting">En espera</option><option value="mine">Mis chats</option><option value="closed">Finalizados</option><option value="all">Todos</option></select><select id="npV117PriorityFilter"><option value="all">Toda prioridad</option><option value="high">Alta</option><option value="normal">Normal</option></select></div></div><div class="np-v117-chat-list" id="npV117ChatList"></div></aside><main class="np-v117-chat-panel" id="npV117ChatPanel"><div class="np-v117-chat-empty"><div><span>💬</span><b>Selecciona una conversación</b><p>Las consultas nuevas aparecerán aquí y podrán asignarse a un agente de atención.</p></div></div></main></div><div class="np-v117-local-note"><b>Importante:</b> esta versión guarda las conversaciones localmente en esta instalación. Para que clientes y agentes conversen desde teléfonos diferentes en producción, esta misma interfaz debe conectarse a un backend o base de datos compartida.</div></section>`;
    const refresh=()=>drawChatList();let npChatSearchTimer=0;$id('npV117ChatSearch').oninput=()=>{clearTimeout(npChatSearchTimer);npChatSearchTimer=setTimeout(refresh,100)};$id('npV117ChatFilter').onchange=refresh;$id('npV117PriorityFilter').onchange=refresh;drawChatList();if(adminSelectedChat&&allowed.some(c=>c.id===adminSelectedChat))openAdminChat(adminSelectedChat,false);updateAdminBadge();clearInterval(adminPoll);adminPoll=setInterval(()=>{if($id('adminOverlay')?.classList.contains('open')&&state.adminSection==='bots'){drawChatList(false);if(adminSelectedChat)refreshAdminChat(adminSelectedChat)}},6500);return true
  }
  function filteredAdminChats(){let list=visibleChatsForStaff();const q=normText($id('npV117ChatSearch')?.value||''),f=$id('npV117ChatFilter')?.value||'open',p=$id('npV117PriorityFilter')?.value||'all',me=currentStaff();if(q)list=list.filter(c=>normText(`${c.customerName} ${c.customerEmail} ${c.subject} ${c.context?.Producto||''}`).includes(q));if(f==='open')list=list.filter(c=>c.status!=='closed');if(f==='waiting')list=list.filter(c=>c.status!=='closed'&&!c.assignedAgentId);if(f==='mine')list=list.filter(c=>c.status!=='closed'&&String(c.assignedAgentId)===String(me?.id));if(f==='closed')list=list.filter(c=>c.status==='closed');if(p!=='all')list=list.filter(c=>(c.priority||'normal')===p);return list.sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt)))}
  function drawChatList(keepSelection=true){const root=$id('npV117ChatList');if(!root)return;const list=filteredAdminChats();root.innerHTML=list.length?list.map(c=>{const unread=unreadForStaff(c),agent=agentById(c.assignedAgentId),last=(c.messages||[]).slice(-1)[0];return `<button class="np-v117-chat-item ${adminSelectedChat===c.id?'active':''}" data-v117-chat="${escapeHtml(c.id)}"><span class="np-v117-chat-icon">${c.status==='closed'?'✓':c.assignedAgentId?'💬':'⏳'}</span><span><b>${escapeHtml(c.customerName||'Cliente')}</b><p>${escapeHtml(last?.text||c.subject||'Nueva conversación')}</p></span><aside><time>${escapeHtml(formatShort(c.updatedAt))}</time>${unread?`<span class="dot">${unread}</span>`:''}${c.priority==='high'?'<span class="priority">ALTA</span>':''}</aside></button>`}).join(''):'<div class="np-v117-chat-empty"><div><span>✓</span><b>Sin conversaciones</b><p>No hay chats que coincidan con este filtro.</p></div></div>';qa('[data-v117-chat]',root).forEach(b=>b.onclick=()=>openAdminChat(b.dataset.v117Chat));if(!keepSelection&&adminSelectedChat&&!list.some(c=>c.id===adminSelectedChat))adminSelectedChat=''}
  function openAdminChat(chatId,redraw=true){const c=getChat(chatId);if(!c||!staffCanHandle(c))return;adminSelectedChat=c.id;markStaffRead(c.id);if(redraw)drawChatList();refreshAdminChat(c.id,true)}
  function refreshAdminChat(chatId,stick=false){const panel=$id('npV117ChatPanel'),c=getChat(chatId);if(!panel||!c)return;const me=currentStaff(),agents=supportAgents(),assigned=agentById(c.assignedAgentId),can=staffCanHandle(c);panel.innerHTML=`<header class="np-v117-chat-head"><div><h3>${escapeHtml(c.customerName||'Cliente')}</h3><p>${escapeHtml(c.customerEmail||'Sin correo')} · ${escapeHtml(c.subject||'Consulta general')} ${assigned?`· ${escapeHtml(assigned.name)}`:'· Sin asignar'}</p></div><div class="np-v117-chat-actions">${state.session?.role==='admin'?`<select id="npV117AssignAgent"><option value="">Sin asignar</option>${agents.map(a=>`<option value="${escapeHtml(a.id)}" ${String(c.assignedAgentId)===String(a.id)?'selected':''}>${escapeHtml(a.name)} · ${escapeHtml(a.area||'Atención')}</option>`).join('')}</select>`:(!c.assignedAgentId?'<button id="npV117TakeChat">Tomar chat</button>':'')}<select id="npV117Priority"><option value="normal" ${c.priority!=='high'?'selected':''}>Prioridad normal</option><option value="high" ${c.priority==='high'?'selected':''}>Prioridad alta</option></select><button class="resolve" id="npV117Resolve">${c.status==='closed'?'Reabrir':'Finalizar'}</button></div></header><div class="np-v117-admin-thread" id="npV117AdminThread">${adminThreadMarkup(c)}</div>${c.status==='closed'?'<div class="np-v117-admin-compose"><textarea disabled>Conversación finalizada.</textarea><button id="npV117ReopenBottom">Reabrir</button></div>':`<div class="np-v117-admin-compose"><textarea id="npV117StaffText" maxlength="2000" placeholder="Responder al cliente…"></textarea><button id="npV117StaffSend">Enviar</button></div>`}`;
    if($id('npV117AssignAgent'))$id('npV117AssignAgent').onchange=e=>{mutateChat(c.id,x=>{x.assignedAgentId=e.target.value;x.status=e.target.value?'active':'waiting';x.messages.push({id:id('msg'),role:'system',senderId:'system',senderName:'CRULOX',text:e.target.value?`Conversación asignada a ${agentById(e.target.value)?.name||'agente'}.`:'Conversación devuelta a la bandeja de espera.',at:now(),readByClient:false,readByStaff:true})});refreshAdminChat(c.id,true);drawChatList()};
    if($id('npV117TakeChat'))$id('npV117TakeChat').onclick=()=>{if(!me)return;mutateChat(c.id,x=>{x.assignedAgentId=String(me.id);x.status='active';x.messages.push({id:id('msg'),role:'system',senderId:'system',senderName:'CRULOX',text:`${me.name||'Un agente'} tomó la conversación.`,at:now(),readByClient:false,readByStaff:true})});refreshAdminChat(c.id,true);drawChatList()};
    if($id('npV117Priority'))$id('npV117Priority').onchange=e=>{mutateChat(c.id,x=>x.priority=e.target.value);drawChatList()};
    const toggle=()=>{const current=getChat(c.id);if(current?.lifecycleLocked&&current.status==='closed'){toast('Chat expirado. El cliente debe iniciar uno nuevo.','warn');return}mutateChat(c.id,x=>{x.status=x.status==='closed'?(x.assignedAgentId?'active':'waiting'):'closed';x.messages.push({id:id('msg'),role:'system',senderId:'system',senderName:'CRULOX',text:x.status==='closed'?'El equipo marcó esta conversación como finalizada.':'La conversación fue reabierta.',at:now(),readByClient:false,readByStaff:true})});refreshAdminChat(c.id,true);drawChatList()};if($id('npV117Resolve'))$id('npV117Resolve').onclick=toggle;if($id('npV117ReopenBottom'))$id('npV117ReopenBottom').onclick=toggle;
    const sendStaff=()=>{const text=String($id('npV117StaffText')?.value||'').trim();if(!text||!me)return;if(!c.assignedAgentId)mutateChat(c.id,x=>{x.assignedAgentId=String(me.id);x.status='active'});appendMessage(c.id,{role:'staff',senderId:me.id,senderName:me.name||'Equipo CRULOX',text});refreshAdminChat(c.id,true);drawChatList();toast('Respuesta enviada.','success')};if($id('npV117StaffSend')){$id('npV117StaffSend').onclick=sendStaff;$id('npV117StaffText').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendStaff()}}}
    if(stick)requestAnimationFrame(()=>{const t=$id('npV117AdminThread');if(t)t.scrollTop=t.scrollHeight});updateAdminBadge()
  }
  function updateAdminBadge(){const visible=visibleChatsForStaff(),unread=visible.reduce((n,c)=>n+unreadForStaff(c),0),waiting=visible.filter(c=>c.status!=='closed'&&!c.assignedAgentId).length,count=unread||waiting;const nav=qa('#adminNav button').find(b=>/atencion/i.test(normText(b.textContent))||b.dataset.admin==='bots'||b.dataset.v10Group==='growth');let badge=nav?.querySelector('.np-v117-nav-badge');if(nav&&!badge){badge=document.createElement('span');badge.className='np-v117-nav-badge';nav.appendChild(badge)}if(badge){badge.textContent=String(Math.min(count,99));badge.style.display=count?'grid':'none'}}

  function migrateSupportPermissions(){if(!team)return;const tool=Array.isArray(team.tools)?team.tools.find(t=>t.id==='go-attention'):null;let changed=false;for(const a of team.agents()){if(a?.preset!=='support')continue;a.permissions=a.permissions||{tools:[],sections:[],groups:[],strictV110:true};a.permissions.tools=Array.isArray(a.permissions.tools)?a.permissions.tools:[];a.permissions.sections=Array.isArray(a.permissions.sections)?a.permissions.sections:[];if(tool&&!a.permissions.tools.includes('go-attention')){a.permissions.tools.push('go-attention');changed=true}if(!a.permissions.sections.includes('bots')){a.permissions.sections.push('bots');changed=true}a.permissions.strictV110=true}if(changed)team.saveAgents?.()}
  function enhanceAttentionTool(){const tools=window.NP_ADMIN_TOOLS_V105;if(!Array.isArray(tools))return;const t=tools.find(x=>x.id==='go-attention');if(t){t.title='Bandeja de atención';t._np110BaseTitle=t.title;t.desc='Conversaciones de clientes asignables al equipo de atención, con historial, prioridad y cierre.';t.group='operations';t.section='bots';t.icon='💬';t.action=()=>renderAdminSection('bots');const current=tools.indexOf(t);if(current>5){tools.splice(current,1);tools.splice(4,0,t);tools.forEach((x,i)=>x.rank=i+1)}}}
  function decorateMessageButtons(){const hero=$id('heroSupport');if(hero)hero.textContent='💬 Enviar mensaje';const foot=$id('footerSupport');if(foot)foot.textContent='💬 Mensajes';const fl=$id('floatSupport');if(fl)fl.setAttribute('aria-label','Mensajes');qa('[data-support]').forEach(b=>b.setAttribute('aria-label','Enviar mensaje'));qa('[data-combo-support]').forEach(b=>{if(/whatsapp/i.test(b.textContent))b.textContent='💬 Mensaje'});qa('[data-social-support]').forEach(b=>b.textContent='Mensajes')}

  const baseRender=window.renderAdminSection;
  window.renderAdminSection=function(section){if(section==='bots')return renderServiceInbox();const r=baseRender(section);requestAnimationFrame(()=>{decorateMessageButtons();updateAdminBadge()});return r};
  const baseOpen=window.openAdmin;
  window.openAdmin=function(section='home'){if($id('npV117Support')?.classList.contains('open'))closePublicSupport();migrateSupportPermissions();const r=baseOpen(section);requestAnimationFrame(()=>{decorateMessageButtons();updateAdminBadge()});return r};
  document.addEventListener('submit',e=>{if(e.target?.id==='npAgentForm'||e.target?.id==='npV116PermForm'){setTimeout(migrateSupportPermissions,250);setTimeout(migrateSupportPermissions,900)}},true);
  window.addEventListener('storage',e=>{if(e.key===CHAT_KEY){chatCache=null;chatCacheRaw=null;if($id('npV117Support')?.classList.contains('open'))renderPublicSupport();if(state?.adminSection==='bots'&&$id('adminOverlay')?.classList.contains('open')){drawChatList(false);if(adminSelectedChat)refreshAdminChat(adminSelectedChat)}updatePublicUnread();updateAdminBadge()}});
  document.addEventListener('visibilitychange',()=>{if(document.hidden){clearInterval(publicPoll);clearInterval(adminPoll)}else{updatePublicUnread();updateAdminBadge();if($id('npV117Support')?.classList.contains('open'))publicPoll=setInterval(()=>renderPublicSupport(),6500);if(state?.adminSection==='bots'&&$id('adminOverlay')?.classList.contains('open'))adminPoll=setInterval(()=>{drawChatList(false);if(adminSelectedChat)refreshAdminChat(adminSelectedChat)},6500)}});
  /* v11.8: botones de mensaje se decoran en los renders, sin observar todo el documento. */
  enhanceAttentionTool();migrateSupportPermissions();decorateMessageButtons();updatePublicUnread();updateAdminBadge();
  window.NP_V117_SUPPORT={VERSION,chats,getChat,open:openPublicSupport,renderInbox:renderServiceInbox,appendMessage,supportAgents,updateBadges:()=>{updatePublicUnread();updateAdminBadge()}};
})();
</script>


<style id="np-v118-performance-style">
/* v11.8 · rendimiento WebView sin alterar identidad visual */
.product,.combo,.np-v10-tool,.np-v10-module,.np-v116-row,.np-v116-assignment,.np-v117-chat-item,.np-v105-agent-card{
  content-visibility:auto;
  contain-intrinsic-size:auto 150px;
}
.np-v118-tool-progress{display:flex;justify-content:flex-end;min-height:22px;margin:2px 0 7px;color:#7894ad;font-size:.49rem;font-weight:800}
.np-v118-tool-sentinel{display:flex;justify-content:center;padding:10px 0 2px}
.np-v118-tool-sentinel[hidden]{display:none!important}
.np-v118-tool-sentinel button{min-height:32px;padding:6px 13px;border-radius:10px;border:1px solid rgba(77,213,255,.13);background:#081927;color:#59ddff;font-size:.52rem;font-weight:900}
@media(max-width:920px){
  body{background-attachment:scroll!important}
  .header,#adminOverlay .admin-top,.fav-btn,.np-v10-palette,.np-v117-support{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
  .header{background:rgba(5,10,18,.985)!important}
  #adminOverlay .admin-top{background:rgba(3,10,18,.985)!important}
  .np-v117-support{background:rgba(0,0,0,.76)!important}
  .product .stock,.np-combo-stock,.product-actions .add:disabled{animation:none!important}
  .product,.combo,.np-v10-tool,.np-v10-module,.np-v116-row,.np-v116-assignment,.np-v117-chat-item{contain:layout paint style}
}
</style>
<script id="np-v118-performance-script">
(function(){
'use strict';
const VERSION='11.8-VELOCIDAD-PRO';
const idle=window.requestIdleCallback||((fn)=>setTimeout(()=>fn({didTimeout:false,timeRemaining:()=>0}),120));
function lazyImageHints(root=document){root.querySelectorAll?.('img:not([fetchpriority])').forEach(img=>{if(!img.closest('.hero-brand-top,.admin-brand-row'))img.setAttribute('fetchpriority','low');if(!img.hasAttribute('decoding'))img.setAttribute('decoding','async')})}
function trimTransientMedia(){document.querySelectorAll('video:not([controls])').forEach(v=>{if(document.hidden)try{v.pause()}catch(e){}})}
idle(()=>lazyImageHints(document));
document.addEventListener('visibilitychange',()=>{if(document.hidden)trimTransientMedia()},{passive:true});
const tools=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
window.NP_V118_PERF={VERSION,toolCount:tools.length,progressiveTools:true,chatPollMs:6500,globalObserversRemoved:3,createdAt:new Date().toISOString()};
const ok=tools.length===400&&new Set(tools.map(t=>t.id)).size===400&&tools.every(t=>typeof t.action==='function');
window.NP_V118_PERF.ok=ok;document.documentElement.dataset.npV118=ok?'ok':'review';
})();
</script>


<style id="np-v119-chat-identity-style">
#npV117Support .np-v119-support-avatar-img{width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block}
#npV117Support .np-v117-support-avatar{padding:0;overflow:hidden;background:linear-gradient(145deg,rgba(24,220,255,.12),rgba(90,103,255,.12));border:1px solid rgba(24,220,255,.24)}
#npV117Support .np-v119-support-meta{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:4px}
#npV117Support .np-v119-profile-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:rgba(17,34,51,.88);border:1px solid rgba(126,203,255,.12);font-size:.5rem;color:#a9bfd6;line-height:1.2;max-width:100%;overflow:hidden}
#npV117Support .np-v119-profile-chip b{color:#ecf8ff;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
#npV117Support .np-v119-profile-chip span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
#npV117Support .np-v117-support-head h2{font-size:.92rem}
#npV117Support .np-v117-support-head p{font-size:.56rem}
</style>
<script id="np-v119-chat-identity-script">
(function(){
  const CHAT_KEY='jm_digital_v1_support_chats';
  const GUEST_KEY='np_support_guest_v117';
  const MASCOT_SRC='data:image/webp;base64,';
  const team=window.NP_TEAM_API_V105||null;
  const $=id=>document.getElementById(id);
  const escHtml=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const norm=v=>String(v??'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().trim();
  const now=()=>new Date().toISOString();
  const uid=(p='id')=>`${p}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
  const read=(k,f)=>{try{const v=localStorage.getItem(k);return v?JSON.parse(v):f}catch(e){return f}};
  const write=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v));return true}catch(e){console.warn('NovaPrime support write',e);return false}};
  const getState=()=>state||{};
  function allChats(){const arr=read(CHAT_KEY,[]);return Array.isArray(arr)?arr:[];}
  function saveChats(arr){return write(CHAT_KEY,arr);}
  function openChatForClient(clientId){return allChats().filter(c=>String(c.clientId)===String(clientId)&&c.status!=='closed').sort((a,b)=>String(b.updatedAt||'').localeCompare(String(a.updatedAt||'')))[0]||null;}
  function getChat(chatId){return allChats().find(c=>String(c.id)===String(chatId))||null;}
  function mutateChat(chatId,fn,{touch=true}={}){const arr=allChats();const i=arr.findIndex(c=>String(c.id)===String(chatId));if(i<0)return null;fn(arr[i],arr);if(touch)arr[i].updatedAt=now();saveChats(arr);return arr[i];}
  function supportAgents(){
    if(window.NP_V117_SUPPORT?.supportAgents){
      try{return window.NP_V117_SUPPORT.supportAgents()||[]}catch(e){}
    }
    const all=Array.isArray(team?.agents?.())?team.agents().filter(a=>a&&a.active!==false):[];
    const preferred=all.filter(a=>a.preset==='support'||/(atencion|soporte|cliente|servicio)/.test(norm(a.area)));
    return preferred.length?preferred:all.filter(a=>a.preset==='supervisor');
  }
  function agentById(id){
    if(String(id)==='owner')return {id:'owner',name:'Administrador CRULOX',area:'Administración',active:true};
    return team?.agentById?.(id)||supportAgents().find(a=>String(a.id)===String(id))||null;
  }
  function chooseAgent(chats){
    const agents=supportAgents();
    if(!agents.length)return null;
    const loads=new Map(agents.map(a=>[String(a.id),0]));
    chats.filter(c=>c.status!=='closed'&&c.assignedAgentId).forEach(c=>loads.set(String(c.assignedAgentId),(loads.get(String(c.assignedAgentId))||0)+1));
    return agents.slice().sort((a,b)=>(loads.get(String(a.id))||0)-(loads.get(String(b.id))||0))[0]||null;
  }
  function resolveClientIdentity(){
    const state=getState();
    if(state?.session?.role==='client' && Array.isArray(state.users)){
      const u=state.users.find(x=>String(x.id)===String(state.session.userId));
      if(u)return {id:`user:${u.id}`,name:u.fullName||u.username||'Cliente',email:u.email||'',phone:u.phone||'',registered:true};
    }
    const guest=read(GUEST_KEY,null);
    if(guest && guest.id) return {...guest, name:guest.name||'Cliente CRULOX', email:guest.email||'', registered:false};
    const fresh={id:`guest:${uid('g')}`,name:'Cliente CRULOX',email:'',createdAt:now(),registered:false};
    write(GUEST_KEY,fresh);
    return fresh;
  }
  function syncIdentityCache(identity){
    if(identity?.registered)return identity;
    const current=read(GUEST_KEY,{})||{};
    const next={...current,...identity,registered:false,updatedAt:now()};
    if(!next.id)next.id=`guest:${uid('g')}`;
    if(!next.name)next.name='Cliente CRULOX';
    if(!('email' in next))next.email='';
    write(GUEST_KEY,next);
    return next;
  }
  function subjectFrom(extra,message){return String(extra?.Producto||extra?.Combo||extra?.Tipo||message||'Consulta general').replace(/^Hola\.\s*/i,'').slice(0,90);}
  function newChat(identity,context={}){
    const arr=allChats();
    const assigned=chooseAgent(arr);
    const c={id:uid('chat'),clientId:identity.id,customerName:identity.name||'Cliente CRULOX',customerEmail:identity.email||'',customerPhone:identity.phone||'',subject:subjectFrom(context.extra,context.message),context:context.extra||{},status:assigned?'active':'waiting',priority:'normal',assignedAgentId:assigned?String(assigned.id):'',createdAt:now(),updatedAt:now(),messages:[]};
    c.messages.push({id:uid('msg'),role:'system',senderId:'system',senderName:'CRULOX',text:assigned?`Tu conversación fue asignada a ${assigned.name||'un agente de atención'}.`:'Tu consulta fue recibida. Un agente de atención podrá tomarla.',at:now(),readByClient:true,readByStaff:false});
    arr.unshift(c);saveChats(arr);return c;
  }
  function appendClientMessage(chatId,identity,text){
    text=String(text||'').trim();
    if(!text)return null;
    return mutateChat(chatId,c=>{
      c.customerName=identity.name||c.customerName||'Cliente CRULOX';
      c.customerEmail=identity.email||c.customerEmail||'';
      c.customerPhone=identity.phone||c.customerPhone||'';
      c.messages=Array.isArray(c.messages)?c.messages:[];
      c.messages.push({id:uid('msg'),role:'client',senderId:identity.id,senderName:identity.name||'Cliente CRULOX',text:text.slice(0,2000),at:now(),readByClient:true,readByStaff:false});
      if(c.status==='closed')c.status=c.assignedAgentId?'active':'waiting';
    });
  }
  function unreadForClient(c){return (c.messages||[]).filter(m=>m.role==='staff'&&!m.readByClient).length;}
  function markClientRead(chatId){const c=getChat(chatId);if(!c)return;mutateChat(chatId,x=>{(x.messages||[]).forEach(m=>{if(m.role==='staff')m.readByClient=true})},{touch:false});}
  function renderMsg(m){const cls=m.role==='client'?'client':m.role==='staff'?'staff':'system';const author=m.senderName || (m.role==='client'?'Tú':'CRULOX');let tm='';try{tm=new Date(m.at).toLocaleTimeString('es-GT',{hour:'2-digit',minute:'2-digit'})}catch(e){}return `<article class="np-v117-msg ${cls}"><b>${escHtml(author)}</b><p>${escHtml(m.text||'')}</p><time>${escHtml(tm)}</time></article>`;}
  let chatId='';
  let draft='';
  let context={message:'',extra:{}};
  let poll=0;
  function clearPoll(){clearInterval(poll);poll=0;}
  function updateUnreadBadge(){const identity=resolveClientIdentity();const c=openChatForClient(identity.id);const count=c?unreadForClient(c):0;let badge=$('npV117SupportUnread');const float=$('floatSupport');if(float&&!badge){badge=document.createElement('span');badge.id='npV117SupportUnread';badge.className='np-v117-support-unread';float.appendChild(badge)}if(badge){badge.textContent=String(Math.min(count,99));badge.classList.toggle('show',count>0)}}
  function ensureRoot(){
    let root=$('npV117Support');
    if(!root){root=document.createElement('div');root.id='npV117Support';root.className='np-v117-support';document.body.appendChild(root);}
    root.innerHTML=`<section class="np-v117-support-card" role="dialog" aria-modal="true" aria-label="Atención CRULOX"><header class="np-v117-support-head"><div class="np-v117-support-avatar"><img class="np-v119-support-avatar-img" src="${MASCOT_SRC}" alt="Mascota CRULOX"></div><div><h2 id="npV119SupportTitle">CRULOX</h2><p id="npV117SupportSubtitle">Conversa directamente con nuestro equipo.</p><div class="np-v119-support-meta"><span id="npV117SupportStatus" class="np-v117-support-status wait">En espera</span><span class="np-v119-profile-chip" id="npV119ProfileChip"></span></div></div><button class="np-v117-support-close" id="npV117SupportClose" type="button" aria-label="Cerrar">×</button></header><div class="np-v117-support-body" id="npV117SupportBody"></div><footer class="np-v117-support-compose" id="npV117SupportCompose"></footer></section>`;
    $('npV117SupportClose').onclick=closeSupport;
    root.onclick=e=>{if(e.target===root)closeSupport()};
    return root;
  }
  function renderSupport({stickBottom=false}={}){
    const root=ensureRoot();
    const identity=syncIdentityCache(resolveClientIdentity());
    let c=getChat(chatId); if(!c){c=openChatForClient(identity.id); if(c)chatId=c.id;}
    const body=$('npV117SupportBody'), compose=$('npV117SupportCompose'), title=$('npV119SupportTitle'), subtitle=$('npV117SupportSubtitle'), status=$('npV117SupportStatus'), chip=$('npV119ProfileChip');
    if(chip){
      const emailText=identity.email?` · <span>${escHtml(identity.email)}</span>`:'';
      chip.innerHTML=`<b>${escHtml(identity.name||'Cliente CRULOX')}</b>${emailText}`;
      chip.title=(identity.name||'Cliente CRULOX')+(identity.email?` · ${identity.email}`:'');
    }
    if(!c){
      title.textContent='CRULOX';
      subtitle.textContent='Conversa directamente con nuestro equipo.';
      status.className='np-v117-support-status wait';
      status.textContent='Nueva consulta';
      body.innerHTML='<div class="np-v117-welcome">Escribe tu consulta y la enviaremos al equipo de atención. Si hay un agente disponible, la conversación se asignará automáticamente.</div>';
    } else {
      const agent=agentById(c.assignedAgentId);
      title.textContent=agent?.name || 'CRULOX';
      body.innerHTML=`<div class="np-v117-welcome">${c.context?.Producto?`Consulta sobre <b>${escHtml(c.context.Producto)}</b>. `:''}Historial de esta conversación.</div>${(c.messages||[]).map(renderMsg).join('')}`;
      if(c.status==='closed'){
        subtitle.textContent='Puedes iniciar una nueva consulta cuando lo necesites.';
        status.className='np-v117-support-status closed';
        status.textContent='Conversación finalizada';
      } else if(agent) {
        subtitle.textContent=`${agent.area||'Equipo de atención'} · CRULOX`;
        status.className='np-v117-support-status';
        status.textContent=`Atendido por ${agent.name||'Agente'}`;
      } else {
        subtitle.textContent='Tu consulta está en la bandeja de atención.';
        status.className='np-v117-support-status wait';
        status.textContent='Esperando agente';
      }
      markClientRead(c.id);
    }
    if(c?.status==='closed'){
      compose.innerHTML='<div class="np-v117-closed-actions"><button type="button" id="npV119NewChat">Iniciar nueva conversación</button></div>';
      $('npV119NewChat').onclick=()=>{chatId='';draft='';renderSupport({stickBottom:true});setTimeout(()=>$('npV117ClientText')?.focus(),30)};
    } else {
      compose.innerHTML=`<div class="np-v117-compose-row"><textarea id="npV117ClientText" maxlength="2000" placeholder="Escribe tu mensaje…">${escHtml(draft)}</textarea><button class="np-v117-send" id="npV117ClientSend" type="button" aria-label="Enviar">➤</button></div>`;
      $('npV117ClientSend').onclick=sendClient;
      $('npV117ClientText').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendClient();}};
    }
    updateUnreadBadge();
    if(stickBottom)requestAnimationFrame(()=>{body.scrollTop=body.scrollHeight});
  }
  function sendClient(){
    const txt=String($('npV117ClientText')?.value||'').trim();
    if(!txt)return;
    const identity=syncIdentityCache(resolveClientIdentity());
    let c=getChat(chatId)||openChatForClient(identity.id);
    if(!c){
      c=newChat(identity,{message:context.message||txt,extra:Object.keys(context.extra||{}).length?context.extra:{Tipo:'Consulta general'}});
      chatId=c.id;
    } else {
      mutateChat(c.id,x=>{x.customerName=identity.name||x.customerName||'Cliente CRULOX';x.customerEmail=identity.email||x.customerEmail||'';x.customerPhone=identity.phone||x.customerPhone||'';});
    }
    appendClientMessage(c.id,identity,txt);
    draft='';
    renderSupport({stickBottom:true});
    if(typeof toast==='function')toast('Mensaje enviado al equipo de atención.','success');
  }
  function openSupport(message='',extra={}){
    const identity=syncIdentityCache(resolveClientIdentity());
    const openChat=openChatForClient(identity.id);
    chatId=openChat?.id||'';
    context={message:String(message||''),extra:{...(extra||{})}};
    draft=String(message||'').replace(/^Hola\.\s*/i,'').slice(0,1200);
    const root=ensureRoot();
    root.classList.add('open');
    document.body.classList.add('lock');
    renderSupport({stickBottom:true});
    setTimeout(()=>$('npV117ClientText')?.focus(),40);
    clearPoll();
    poll=setInterval(()=>{if(root.classList.contains('open'))renderSupport();},6500);
    return true;
  }
  function closeSupport(){const root=$('npV117Support'); if(root)root.classList.remove('open'); document.body.classList.remove('lock'); clearPoll(); updateUnreadBadge();}
  const previousOpenBot=window.openBot;
  window.openBot=function(kind,message,extra={}){if(kind==='support')return openSupport(message,extra); return typeof previousOpenBot==='function'?previousOpenBot(kind,message,extra):false;};
  if(window.NP_V117_SUPPORT)window.NP_V117_SUPPORT.open=openSupport;
  window.addEventListener('storage',e=>{if(e.key===CHAT_KEY){if($('npV117Support')?.classList.contains('open'))renderSupport();updateUnreadBadge();}});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)clearPoll(); else if($('npV117Support')?.classList.contains('open')){clearPoll();poll=setInterval(()=>renderSupport(),6500);renderSupport();}});
  updateUnreadBadge();
})();
</script>


<style id="np-v120-chat-lifecycle-style">
#npV117Support .np-v120-time-chip{display:inline-flex;align-items:center;gap:4px;min-height:25px;padding:5px 8px;border-radius:999px;border:1px solid rgba(126,203,255,.1);background:rgba(7,25,40,.82);color:#a8c0d8;font-size:.46rem;font-weight:800;white-space:nowrap}
#npV117Support .np-v120-time-chip.idle{color:#ffd27b;border-color:rgba(255,194,80,.14);background:rgba(255,177,48,.055)}
#npV117Support .np-v120-time-chip.life{color:#76e7ff;border-color:rgba(34,213,255,.13);background:rgba(20,202,255,.05)}
#npV117Support .np-v119-support-avatar-img{image-rendering:auto!important;object-fit:cover!important;object-position:center 44%!important;transform:none!important;filter:none!important}
@media(max-width:520px){#npV117Support .np-v120-time-chip{font-size:.43rem;padding:4px 7px;min-height:23px}#npV117Support .np-v119-support-meta{gap:5px}}
</style>
<script id="np-v120-chat-lifecycle-script">
(function(){
  const VERSION='11.10';
  const CHAT_KEY='jm_digital_v1_support_chats';
  const GUEST_KEY='np_support_guest_v117';
  const INACTIVITY_MS=10*60*1000;
  const LIFETIME_MS=24*60*60*1000;
  const $=id=>document.getElementById(id);
  let lifecycleTimer=0;
  let displayTimer=0;
  let lastLifecycleSignature='';

  function parseTime(value,fallback=0){const n=Date.parse(value||'');return Number.isFinite(n)?n:fallback}
  function readChats(){try{const raw=localStorage.getItem(CHAT_KEY)||'[]';const value=JSON.parse(raw);return Array.isArray(value)?value:[]}catch(e){return[]}}
  function saveChats(chats){try{localStorage.setItem(CHAT_KEY,JSON.stringify(chats));return true}catch(e){console.warn('NovaPrime chat lifecycle',e);return false}}
  function currentClientId(){
    try{
      if(state?.session?.role==='client')return `user:${state.session.userId}`;
      const guest=JSON.parse(localStorage.getItem(GUEST_KEY)||'null');
      return guest?.id||'';
    }catch(e){return''}
  }
  function createdMs(chat){return parseTime(chat?.createdAt,parseTime(chat?.updatedAt,Date.now()))}
  function lastActivityMs(chat){
    let last=Math.max(createdMs(chat),parseTime(chat?.updatedAt,0));
    const messages=Array.isArray(chat?.messages)?chat.messages:[];
    if(messages.length)last=Math.max(last,parseTime(messages[messages.length-1]?.at,0));
    return last||Date.now();
  }
  function isOpen(chat){return chat&&chat.status!=='closed'}
  function activeChatFor(clientId,chats=readChats()){
    return chats.filter(c=>String(c.clientId)===String(clientId)&&isOpen(c)).sort((a,b)=>lastActivityMs(b)-lastActivityMs(a))[0]||null;
  }
  function systemMessageExists(chat,kind){return (chat.messages||[]).some(m=>m?.lifecycleKind===kind)}
  function lifecycleMessage(chat,kind,text,at){
    chat.messages=Array.isArray(chat.messages)?chat.messages:[];
    if(systemMessageExists(chat,kind))return;
    chat.messages.push({id:`life_${kind}_${Date.now().toString(36)}`,role:'system',senderId:'system',senderName:'CRULOX',text,lifecycleKind:kind,at,readByClient:false,readByStaff:true});
  }
  function closePublicWindow(message='Chat cerrado por inactividad.'){
    const root=$('npV117Support');
    if(root?.classList.contains('open')){
      root.classList.remove('open');
      document.body.classList.remove('lock');
      if(typeof window.toast==='function')window.toast(message,'info');
    }
  }
  function refreshRelatedUI(){
    try{window.NP_V117_SUPPORT?.updateBadges?.()}catch(e){}
    if(state?.adminSection==='bots'&&$('adminOverlay')?.classList.contains('open')){
      try{window.NP_V117_SUPPORT?.renderInbox?.()}catch(e){}
    }
  }
  function runLifecycle(){
    const now=Date.now(),clientId=currentClientId();
    const chats=readChats();
    let changed=false,currentClosed=false,currentPurged=false;
    const next=[];
    for(const chat of chats){
      const born=createdMs(chat);
      if(now-born>=LIFETIME_MS){
        changed=true;
        if(clientId&&String(chat.clientId)===String(clientId))currentPurged=true;
        continue;
      }
      if(isOpen(chat)&&now-lastActivityMs(chat)>=INACTIVITY_MS){
        const closedAt=new Date(now).toISOString();
        chat.status='closed';
        chat.autoClosed=true;
        chat.closedReason='inactive';
        chat.closedAt=closedAt;
        chat.lifecycleLocked=true;
        lifecycleMessage(chat,'inactive-close','Conversación cerrada por 10 min de inactividad.',closedAt);
        changed=true;
        if(clientId&&String(chat.clientId)===String(clientId))currentClosed=true;
      }
      next.push(chat);
    }
    if(changed){
      saveChats(next);
      if(currentClosed)closePublicWindow('Chat cerrado por inactividad.');else if(currentPurged)closePublicWindow('Chat eliminado al cumplir 24 h.');
      refreshRelatedUI();
    }
    scheduleLifecycle(next);
    updateVisibleTimers(next);
    return {changed,closed:chats.length-next.filter(c=>!c.autoClosed).length,purged:chats.length-next.length,total:next.length};
  }
  function nextDeadline(chats){
    const now=Date.now();let min=Infinity;
    for(const c of chats){
      min=Math.min(min,createdMs(c)+LIFETIME_MS);
      if(isOpen(c))min=Math.min(min,lastActivityMs(c)+INACTIVITY_MS);
    }
    return Number.isFinite(min)?Math.max(250,min-now+30):60000;
  }
  function scheduleLifecycle(chats=readChats()){
    clearTimeout(lifecycleTimer);
    lifecycleTimer=setTimeout(runLifecycle,Math.min(nextDeadline(chats),60000));
  }
  function formatIdle(ms){
    const total=Math.max(0,Math.ceil(ms/1000));
    const m=Math.floor(total/60),s=total%60;
    return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }
  function formatLife(ms){
    const total=Math.max(0,Math.ceil(ms/1000));
    const h=Math.floor(total/3600),m=Math.floor((total%3600)/60);
    return h>0?`${h}h ${String(m).padStart(2,'0')}m`:`${m}m ${String(total%60).padStart(2,'0')}s`;
  }
  function ensureTimerChips(){
    const meta=document.querySelector('#npV117Support .np-v119-support-meta');
    if(!meta)return null;
    let idle=$('npV120IdleTimer'),life=$('npV120LifeTimer');
    if(!idle){idle=document.createElement('span');idle.id='npV120IdleTimer';idle.className='np-v120-time-chip idle';meta.appendChild(idle)}
    if(!life){life=document.createElement('span');life.id='npV120LifeTimer';life.className='np-v120-time-chip life';meta.appendChild(life)}
    return {idle,life};
  }
  function updateVisibleTimers(chats=readChats()){
    const root=$('npV117Support');
    if(!root?.classList.contains('open'))return;
    const chat=activeChatFor(currentClientId(),chats),chips=ensureTimerChips();
    if(!chips)return;
    if(!chat){chips.idle.style.display='none';chips.life.style.display='none';return}
    const now=Date.now();
    chips.idle.style.display='inline-flex';chips.life.style.display='inline-flex';
    chips.idle.textContent=`Inactividad ${formatIdle(lastActivityMs(chat)+INACTIVITY_MS-now)}`;
    chips.life.textContent=`Elimina ${formatLife(createdMs(chat)+LIFETIME_MS-now)}`;
  }
  function startDisplayTimer(){
    clearInterval(displayTimer);
    displayTimer=setInterval(()=>{
      if(document.hidden)return;
      updateVisibleTimers();
      const root=$('npV117Support');
      if(root?.classList.contains('open')){
        const chat=activeChatFor(currentClientId());
        if(chat&&Date.now()-lastActivityMs(chat)>=INACTIVITY_MS)runLifecycle();
      }
    },1000);
  }
  function activityChanged(){setTimeout(()=>{runLifecycle();},0)}

  document.addEventListener('click',e=>{
    const id=e.target?.closest?.('button')?.id||'';
    if(['npV117ClientSend','npV117StaffSend','npV117TakeChat','npV117Resolve','npV117ReopenBottom'].includes(id))activityChanged();
  });
  document.addEventListener('change',e=>{
    if(['npV117AssignAgent','npV117Priority'].includes(e.target?.id||''))activityChanged();
  });
  document.addEventListener('keydown',e=>{
    if(e.key==='Enter'&&!e.shiftKey&&['npV117ClientText','npV117StaffText'].includes(e.target?.id||''))activityChanged();
  });
  window.addEventListener('storage',e=>{if(e.key===CHAT_KEY){runLifecycle();}});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden){runLifecycle();updateVisibleTimers();}});

  runLifecycle();
  startDisplayTimer();
  window.NP_V120_CHAT_LIFECYCLE={VERSION,INACTIVITY_MS,LIFETIME_MS,runLifecycle,readChats,activeChatFor,lastActivityMs,createdMs};
})();
</script>


<style id="np-v121-chat-header-clean-style">
#npV117Support #npV119ProfileChip,
#npV117Support #npV120IdleTimer,
#npV117Support #npV120LifeTimer{
  display:none !important;
}
#npV117Support .np-v119-support-meta{
  gap:8px !important;
}
</style>
<script id="np-v121-chat-header-clean-script">
(function(){
  function pruneSupportHeader(){
    const root=document.getElementById('npV117Support');
    if(!root) return;
    ['npV119ProfileChip','npV120IdleTimer','npV120LifeTimer'].forEach(id=>{
      const el=document.getElementById(id);
      if(el) el.remove();
    });
  }
  const baseOpenBot=window.openBot;
  if(typeof baseOpenBot==='function'){
    window.openBot=function(kind,message,extra={}){
      const result=baseOpenBot(kind,message,extra);
      if(kind==='support') requestAnimationFrame(pruneSupportHeader);
      return result;
    };
  }
  if(window.NP_V117_SUPPORT && typeof window.NP_V117_SUPPORT.open==='function'){
    const baseOpenSupport=window.NP_V117_SUPPORT.open;
    window.NP_V117_SUPPORT.open=function(message='',extra={}){
      const result=baseOpenSupport(message,extra);
      requestAnimationFrame(pruneSupportHeader);
      return result;
    };
  }
  let observer=null;
  function attachObserver(){
    const root=document.getElementById('npV117Support');
    if(!root)return false;
    observer?.disconnect();
    observer=new MutationObserver(()=>pruneSupportHeader());
    observer.observe(root,{childList:true,subtree:true});
    pruneSupportHeader();
    return true;
  }
  if(!attachObserver()){
    observer=new MutationObserver(()=>{if(attachObserver())return});
    observer.observe(document.body,{childList:true,subtree:false});
  }
  pruneSupportHeader();
})();
</script>


<style id="np-v122-messages-primary-style">
#adminOverlay #npV122MessagesQuick{
  position:relative;
  min-height:34px!important;
