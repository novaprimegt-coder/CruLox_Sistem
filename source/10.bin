#adminOverlay .np-v123-chat-row:hover{background:#081b2b;border-color:rgba(56,214,255,.12)}#adminOverlay .np-v123-chat-row.active{background:linear-gradient(135deg,rgba(20,214,244,.11),rgba(30,131,255,.08));border-color:rgba(31,215,255,.2)}
