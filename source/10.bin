  #adminOverlay #npV122MessagesQuick{padding:6px 8px!important;font-size:.5rem!important}
  #adminOverlay #npV122MessagesQuick .np-v122-label{display:none}
}
</style>
<script id="np-v122-messages-primary-script">
(function(){
  const CHAT_KEY='jm_digital_v1_support_chats';
  const TOOLS=Array.isArray(window.NP_ADMIN_TOOLS_V105)?window.NP_ADMIN_TOOLS_V105:[];
  function escText(v){return String(v??'')}
  function promoteMessages(){
    if(!TOOLS.length)return;
    const t=TOOLS.find(x=>x&&x.id==='go-attention');
    if(!t)return;
    t.title='Mensajes y atención';
    t._np110BaseTitle=t.title;
    t.desc='Herramienta principal para mensajes, chat, atención, soporte y conversaciones con clientes. Abre la bandeja, asigna agentes, responde consultas y gestiona seguimiento.';
    t.aliases='mensaje mensajes chat chats conversación conversaciones atencion atención soporte ayuda cliente clientes bandeja responder respuesta agente agentes servicio';
    t.icon='💬';
    t.group='operations';
    t.section='bots';
    t.action=()=>window.renderAdminSection?.('bots');
    const idx=TOOLS.indexOf(t);
    if(idx>0)TOOLS.splice(idx,1);
    if(TOOLS[0]!==t)TOOLS.unshift(t);
    TOOLS.forEach((x,i)=>{x.rank=i+1});
  }
  function chatCounts(){
    let arr=[];
    try{const raw=localStorage.getItem(CHAT_KEY);arr=raw?JSON.parse(raw):[]}catch(e){arr=[]}
    if(!Array.isArray(arr))arr=[];
    const open=arr.filter(c=>c&&c.status!=='closed');
    const waiting=open.filter(c=>!c.assignedAgentId||c.status==='waiting').length;
    const unread=open.reduce((n,c)=>n+(Array.isArray(c.messages)?c.messages.filter(m=>m?.role==='client'&&!m.readByStaff).length:0),0);
    return {waiting,unread,total:waiting+unread};
  }
  function ensureQuickButton(){
    const overlay=document.getElementById('adminOverlay');
    const toolbar=overlay?.querySelector('.admin-top .toolbar');
    if(!toolbar)return null;
    let btn=document.getElementById('npV122MessagesQuick');
    if(!btn){
      btn=document.createElement('button');
      btn.type='button';
      btn.id='npV122MessagesQuick';
      btn.className='btn btn-secondary btn-sm';
      btn.innerHTML='<span aria-hidden="true">💬</span><span class="np-v122-label">Mensajes</span><span class="np-v122-msg-count" id="npV122MessagesCount">0</span>';
      const store=document.getElementById('adminStoreBtn');
      toolbar.insertBefore(btn,store||toolbar.firstChild);
      btn.onclick=()=>window.renderAdminSection?.('bots');
    }
    return btn;
  }
  function updateQuickButton(){
    const btn=ensureQuickButton();
    if(!btn)return;
    const c=chatCounts();
    const badge=document.getElementById('npV122MessagesCount');
    if(badge){badge.textContent=String(Math.min(c.total,99));badge.classList.toggle('show',c.total>0)}
    btn.classList.toggle('active',state?.adminSection==='bots');
    btn.title=c.total?`Mensajes · ${c.unread} sin leer · ${c.waiting} en espera`:'Abrir mensajes y atención al cliente';
  }
  function reinforcePrimaryNav(){
    const nav=document.getElementById('adminNav');
    if(!nav)return;
    const buttons=[...nav.querySelectorAll('button')];
    const attention=buttons.find(b=>b.dataset.admin==='bots'||/atenci[oó]n|mensajes/i.test(b.textContent||''));
    if(!attention)return;
    const first=nav.querySelector('button');
    if(first&&attention!==first&&first.nextSibling!==attention)nav.insertBefore(attention,first.nextSibling);
  }
  function refresh(){promoteMessages();ensureQuickButton();updateQuickButton();reinforcePrimaryNav()}
  promoteMessages();
  const baseOpen=window.openAdmin;
  if(typeof baseOpen==='function')window.openAdmin=function(section='home'){promoteMessages();const r=baseOpen(section);requestAnimationFrame(refresh);return r};
  const baseRender=window.renderAdminSection;
  if(typeof baseRender==='function')window.renderAdminSection=function(section){promoteMessages();const r=baseRender(section);requestAnimationFrame(refresh);return r};
  window.addEventListener('storage',e=>{if(e.key===CHAT_KEY)updateQuickButton()});
  document.addEventListener('click',e=>{if(e.target.closest?.('[data-v117-chat],#npV117StaffSend,#npV117Resolve,#npV117ClientSend'))setTimeout(updateQuickButton,50)},true);
  setInterval(()=>{if(!document.hidden&&document.getElementById('adminOverlay')?.classList.contains('open'))updateQuickButton()},7000);
  requestAnimationFrame(refresh);
  window.NP_V122_MESSAGES_PRIMARY={promote:promoteMessages,refresh,counts:chatCounts};
})();
</script>


