#adminOverlay .np-v123-chat-row aside{display:grid;justify-items:end;gap:3px}.np-v123-chat-row time{font-size:.42rem;color:#6f89a3}.np-v123-chat-row em{font-style:normal;font-size:.4rem;color:#63ddff}.np-v123-chat-row .np-v123-dot{min-width:16px;height:16px;padding:0 4px;display:grid;place-items:center;border-radius:999px;background:#ff5475;color:white;font-size:.39rem;font-weight:900}
